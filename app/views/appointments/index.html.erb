<%
months_pt    = ['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez']
weekdays_pt  = ['dom','seg','ter','qua','qui','sex','sáb']
current_time = Time.current.in_time_zone("America/Sao_Paulo")

is_last_minute = lambda { |appt| appt.appointment_type == 'disponivel' }

is_today_date = lambda do |appt|
  appt.scheduled_at.in_time_zone("America/Sao_Paulo").to_date == current_time.to_date &&
    appt.scheduled_at >= current_time
end

can_cancel = lambda do |appt|
  next false unless appt.status == 'confirmed'
  next false if appt.appointment_type == 'disponivel'
  ((appt.scheduled_at - current_time) / 60.0) > 120
end
%>

<style>
  .appts-page { max-width: 760px; margin: 0 auto; padding: 24px 20px 80px; }

  .appts-header {
    padding: 8px 0 20px;
  }
  .appts-eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; letter-spacing: 1.4px;
    color: var(--ash); text-transform: uppercase;
  }
  .appts-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(28px, 5vw, 40px);
    color: var(--ink); letter-spacing: -0.8px;
    margin-top: 4px; font-weight: 700;
  }

  /* ── Tabs (sand pill container) ─────────────────────── */
  .appts-tabs {
    display: flex; gap: 4px;
    background: var(--sand); padding: 4px;
    border-radius: 14px;
    margin-bottom: 22px;
  }
  .appts-tab-btn {
    flex: 1; height: 40px; border-radius: 10px;
    background: transparent; border: none;
    color: var(--ink); cursor: pointer;
    font-family: 'Inter', sans-serif;
    font-size: 13.5px; font-weight: 600;
    transition: background .15s, box-shadow .15s;
  }
  .appts-tab-btn.active {
    background: var(--paper);
    box-shadow: 0 2px 6px rgba(40,35,28,0.06);
  }

  /* ── Flash ──────────────────────────────────────────── */
  .flash-msg {
    display: flex; align-items: center; gap: 10px;
    padding: 12px 16px; border-radius: 14px;
    margin-bottom: 14px; font-size: 13.5px;
  }
  .flash-msg.flash-error   { background: #fdecec; border: 1px solid #f5cccc; color: #7a3838; }
  .flash-msg.flash-success { background: #d6ecde; border: 1px solid #b5d8c1; color: #2d6b42; }

  /* ── Card ──────────────────────────────────────────── */
  .appt-list { display: flex; flex-direction: column; gap: 12px; }

  .appt-card {
    padding: 16px; border-radius: 18px;
    background: var(--paper);
    border: 1px solid var(--stone);
    position: relative; overflow: hidden;
  }
  .appt-card.today {
    background: var(--ink); border-color: var(--ink); color: var(--cream);
  }
  .appt-card-blob {
    position: absolute; top: -30px; right: -30px;
    width: 120px; height: 120px; border-radius: 50%;
    background: var(--coral-500); opacity: .2; pointer-events: none;
  }

  .appt-inner {
    display: flex; gap: 14px; position: relative;
  }
  .date-col {
    width: 56px; flex-shrink: 0;
    padding-right: 14px; border-right: 1px solid var(--stone);
    display: flex; flex-direction: column; align-items: center;
  }
  .appt-card.today .date-col { border-right-color: rgba(255,255,255,0.15); }
  .date-dow, .date-mon {
    font-size: 10px; text-transform: uppercase;
    color: var(--graphite); opacity: .65;
    font-family: 'JetBrains Mono', monospace; letter-spacing: 0.3px;
  }
  .date-day {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 30px; font-weight: 700;
    line-height: 32px; color: var(--ink);
    letter-spacing: -1px;
  }
  .date-mon { margin-top: 2px; }
  .appt-card.today .date-dow,
  .appt-card.today .date-day,
  .appt-card.today .date-mon { color: var(--cream); }

  .appt-body { flex: 1; min-width: 0; }

  .appt-id {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px; letter-spacing: 0.5px;
    color: var(--ash); margin-bottom: 4px;
  }
  .appt-card.today .appt-id { color: #b5ae9f; }

  .shop-name {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 16px; font-weight: 600;
    color: var(--ink); margin-top: 8px;
    letter-spacing: -0.2px;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .appt-card.today .shop-name { color: var(--cream); }
  .service-name {
    font-size: 12px; color: var(--graphite);
    margin-top: 2px;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .appt-card.today .service-name { color: #c9c4ba; }

  .time-price {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 20px; font-weight: 700;
    color: var(--ink); margin-top: 12px;
    letter-spacing: -0.4px;
  }
  .appt-card.today .time-price { color: var(--coral-500); }

  /* ── Code block (pill + hint) ───────────────────────── */
  .code-block {
    display: flex; align-items: center; gap: 10px;
    margin-top: 12px;
    padding: 10px 12px;
    border-radius: 12px;
  }
  .code-block.light {
    background: var(--coral-50);
    border: 1px solid var(--coral-100);
  }
  .code-block.ink {
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.14);
  }
  .code-pill {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 5px 10px; border-radius: 100px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px; font-weight: 600; letter-spacing: 1px;
    flex-shrink: 0;
  }
  .code-pill.light { background: var(--coral-500); color: var(--cream); }
  .code-pill.ink   { background: var(--cream);     color: var(--ink); }
  .code-hint {
    flex: 1; font-size: 11px; line-height: 15px;
  }
  .code-hint.light { color: var(--coral-700); }
  .code-hint.ink   { color: var(--cream); }

  /* ── Stars rows ────────────────────────────────────── */
  .stars-row-result {
    display: flex; align-items: center; gap: 3px;
    margin-top: 10px;
  }
  .stars-row-result i { font-size: 12px; }
  .stars-hint {
    color: var(--ash); font-size: 11px; margin-left: 6px;
  }

  .rate-row {
    display: flex; align-items: center; gap: 10px;
    margin-top: 14px; padding-top: 12px;
    border-top: 1px solid var(--stone);
  }
  .rate-row-label {
    font-family: 'Inter', sans-serif;
    font-size: 12.5px; font-weight: 600; color: var(--graphite);
  }
  .rate-row-stars {
    display: flex; gap: 8px;
  }
  .rate-row-star-btn {
    background: none; border: none; cursor: pointer;
    padding: 2px;
    color: var(--coral-500);
    transition: transform .12s ease;
  }
  .rate-row-star-btn:hover { transform: scale(1.18); }
  .rate-row-star-btn i { font-size: 16px; }

  /* ── Actions (today card) ──────────────────────────── */
  .card-actions {
    display: flex; gap: 8px;
    margin-top: 14px; position: relative;
  }
  .action-primary {
    flex: 1; background: var(--coral-500);
    color: var(--cream); border: none;
    padding: 10px; border-radius: 100px;
    text-align: center; cursor: pointer;
    font-family: 'Inter', sans-serif;
    font-size: 13px; font-weight: 600;
    text-decoration: none;
    transition: background .15s;
  }
  .action-primary:hover { background: var(--coral-700); color: var(--cream); }
  .action-ghost {
    flex: 1; background: transparent;
    border: 1px solid rgba(255,255,255,0.25);
    color: var(--cream);
    padding: 10px; border-radius: 100px;
    text-align: center; cursor: pointer;
    font-family: 'Inter', sans-serif;
    font-size: 13px; font-weight: 600;
  }
  .action-ghost:hover { background: rgba(255,255,255,0.08); }

  /* Cancel link no rodapé pra cards futuros não-hoje */
  .cancel-link {
    display: inline-flex; align-items: center; gap: 5px;
    margin-top: 12px; padding: 4px 0;
    background: none; border: none; cursor: pointer;
    color: var(--ash); font-size: 11.5px;
    font-family: 'Inter', sans-serif;
  }
  .cancel-link:hover { color: var(--rose-500); }

  /* ── Empty state ───────────────────────────────────── */
  .appts-empty {
    text-align: center; padding: 60px 24px;
    border: 1px solid var(--stone); border-radius: 20px;
    background: var(--paper);
  }
  .appts-empty-icon {
    width: 56px; height: 56px; border-radius: 50%;
    background: var(--coral-50); border: 1px solid var(--coral-100);
    color: var(--coral-700);
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 14px; font-size: 22px;
  }
  .appts-empty-title {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700; font-size: 20px;
    color: var(--ink); margin-bottom: 6px;
    letter-spacing: -0.3px;
  }
  .appts-empty-text {
    font-size: 13.5px; color: var(--graphite);
    margin-bottom: 18px; line-height: 1.55;
  }

  /* ── Review modal ──────────────────────────────────── */
  .review-overlay {
    position: fixed; inset: 0; z-index: 300;
    background: rgba(40,35,28,0.55); backdrop-filter: blur(8px);
    display: none; align-items: center; justify-content: center;
    padding: 1rem; opacity: 0; transition: opacity .25s ease;
  }
  .review-overlay.open { display: flex; opacity: 1; }
  .review-modal {
    background: var(--paper); border: 1px solid var(--stone);
    border-radius: 22px; padding: 32px; width: 100%; max-width: 480px;
    transform: translateY(20px); transition: transform .25s cubic-bezier(.16,1,.3,1);
    box-shadow: 0 24px 60px rgba(40,35,28,0.18);
  }
  .review-overlay.open .review-modal { transform: translateY(0); }
  .review-modal-title {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700; font-size: 22px;
    color: var(--ink); margin-bottom: 4px;
    letter-spacing: -0.4px;
  }
  .review-modal-sub {
    font-size: 13.5px; color: var(--graphite); margin-bottom: 22px;
  }
  .stars-input-row { display: flex; gap: 6px; margin-bottom: 16px; justify-content: center; }
  .star-btn {
    background: none; border: none; cursor: pointer;
    color: var(--stone); font-size: 28px; padding: 6px;
    transition: color .15s, transform .12s;
  }
  .star-btn.active { color: var(--coral-500); }
  .star-btn:hover { transform: scale(1.15); }

  .tags-input-row {
    display: flex; flex-wrap: wrap; gap: 6px;
    margin-bottom: 14px;
  }
  .tag-btn {
    padding: 6px 12px; border-radius: 100px;
    background: var(--paper); border: 1px solid var(--stone);
    color: var(--graphite); font-size: 12px;
    cursor: pointer; transition: all .15s;
  }
  .tag-btn:hover { border-color: var(--coral-300); }
  .tag-btn.selected {
    background: var(--coral-50); border-color: var(--coral-500);
    color: var(--coral-700); font-weight: 600;
  }

  .review-textarea {
    width: 100%; padding: 12px 14px; border-radius: 12px;
    background: var(--cream); border: 1px solid var(--stone);
    color: var(--ink); font-family: 'Inter', sans-serif;
    font-size: 14px; resize: vertical; outline: none;
    margin-bottom: 18px; min-height: 80px;
  }
  .review-textarea:focus { border-color: var(--coral-500); }

  .review-actions { display: flex; gap: 10px; }
  .btn-modal-cancel {
    flex: 1; padding: 12px; border-radius: 100px;
    background: var(--paper); color: var(--graphite);
    border: 1px solid var(--stone);
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; font-weight: 600; letter-spacing: 1.4px; text-transform: uppercase;
    cursor: pointer; transition: all .2s ease;
  }
  .btn-modal-cancel:hover { border-color: var(--coral-500); color: var(--coral-700); }
  .btn-modal-submit {
    flex: 2; padding: 12px; border-radius: 100px;
    background: var(--coral-500); color: var(--cream); border: none;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; font-weight: 600; letter-spacing: 1.4px; text-transform: uppercase;
    cursor: pointer; transition: background .2s ease;
  }
  .btn-modal-submit:hover:not(:disabled) { background: var(--coral-700); }
  .btn-modal-submit:disabled { opacity: .45; cursor: not-allowed; }

  /* ── Cancel modal ──────────────────────────────────── */
  .cancel-overlay {
    position: fixed; inset: 0; z-index: 310;
    background: rgba(40,35,28,0.55); backdrop-filter: blur(8px);
    display: none; align-items: flex-end; justify-content: center;
    padding: 0;
  }
  .cancel-overlay.open { display: flex; }
  .cancel-sheet {
    background: var(--paper);
    width: 100%; max-width: 480px;
    border-radius: 22px 22px 0 0;
    padding: 14px 22px 28px;
    box-shadow: 0 -10px 30px rgba(40,35,28,0.18);
    text-align: center;
  }
  @media (min-width: 600px) {
    .cancel-overlay { align-items: center; padding: 1rem; }
    .cancel-sheet   { border-radius: 22px; padding: 28px 26px 22px; }
  }
  .cancel-handle {
    width: 36px; height: 4px;
    background: var(--stone); border-radius: 99px;
    margin: 0 auto 14px;
  }
  .cancel-icon-circle {
    width: 56px; height: 56px; border-radius: 50%;
    background: #fdecec; border: 1px solid #f5cccc;
    color: #c85050;
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 14px; font-size: 22px;
  }
  .cancel-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 19px; font-weight: 700;
    color: var(--ink); letter-spacing: -0.3px;
    margin-bottom: 14px;
  }
  .cancel-summary {
    background: var(--cream); border: 1px solid var(--stone);
    border-radius: 14px; padding: 14px 16px;
    margin-bottom: 14px;
  }
  .cancel-shop {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 15px; font-weight: 600; color: var(--ink);
  }
  .cancel-when {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px; color: var(--graphite);
    margin-top: 4px;
  }
  .cancel-desc {
    font-size: 13px; color: var(--graphite);
    line-height: 1.55; margin-bottom: 16px;
  }
  .btn-cancel-confirm {
    width: 100%; padding: 14px;
    background: var(--rose-500); color: var(--cream);
    border: none; border-radius: 100px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px; font-weight: 700; letter-spacing: 1.4px; text-transform: uppercase;
    cursor: pointer; margin-bottom: 8px;
    transition: background .15s;
  }
  .btn-cancel-confirm:hover { background: #a83a3a; }
  .btn-cancel-back {
    width: 100%; padding: 13px;
    background: transparent; color: var(--graphite);
    border: none; cursor: pointer;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; font-weight: 600; letter-spacing: 1.4px; text-transform: uppercase;
  }
  .btn-cancel-back:hover { color: var(--ink); }
</style>

<%# Review modal %>
<div class="review-overlay" id="review-overlay">
  <div class="review-modal">
    <div class="review-modal-title">Avaliar <span id="modal-car-wash-name" style="color:var(--coral-500);"></span></div>
    <div class="review-modal-sub">Como foi sua experiência?</div>
    <%= form_with url: client_reviews_path, method: :post, data: { turbo: false }, id: "review-form" do |f| %>
      <%= f.hidden_field :appointment_id, id: "review-appointment-id" %>
      <div class="stars-input-row" id="stars-row">
        <% (1..5).each do |i| %>
          <button type="button" class="star-btn" data-value="<%= i %>" onclick="setStar(<%= i %>)">
            <i class="fas fa-star"></i>
          </button>
        <% end %>
      </div>
      <%= f.hidden_field :rating, id: "review-rating", value: "" %>
      <div class="tags-input-row" id="tags-row">
        <% Review::TAGS.each do |tag| %>
          <button type="button" class="tag-btn" data-tag="<%= tag %>" onclick="toggleTag(this)"><%= tag %></button>
        <% end %>
      </div>
      <%= f.hidden_field :tags, id: "review-tags", value: "" %>
      <%= f.text_area :comment, class: "review-textarea", rows: 3, placeholder: "Comentário opcional..." %>
      <div class="review-actions">
        <button type="button" class="btn-modal-cancel" onclick="closeReviewModal()">Cancelar</button>
        <%= f.submit "Enviar Avaliação", class: "btn-modal-submit", id: "review-submit", disabled: true %>
      </div>
    <% end %>
  </div>
</div>

<%# Cancel modal %>
<div class="cancel-overlay" id="cancel-overlay">
  <div class="cancel-sheet">
    <div class="cancel-handle"></div>
    <div class="cancel-icon-circle"><i class="fas fa-circle-xmark"></i></div>
    <div class="cancel-title">Cancelar agendamento?</div>
    <div class="cancel-summary">
      <div class="cancel-shop" id="cancel-shop">—</div>
      <div class="cancel-when" id="cancel-when">—</div>
    </div>
    <div class="cancel-desc">O horário será liberado e esta ação não pode ser desfeita.</div>
    <%= form_with url: "#", method: :delete, local: true, data: { turbo: false }, id: "cancel-form" do %>
      <button type="submit" class="btn-cancel-confirm">Cancelar agendamento</button>
    <% end %>
    <button type="button" class="btn-cancel-back" onclick="closeCancelModal()">Voltar</button>
  </div>
</div>

<div class="appts-page">

  <div class="appts-header">
    <div class="appts-eyebrow">HISTÓRICO</div>
    <h1 class="appts-title">Meus agendamentos</h1>
  </div>

  <% if flash[:alert] %>
    <div class="flash-msg flash-error" id="flash-error"><i class="fas fa-circle-exclamation"></i><span><%= flash[:alert] %></span></div>
  <% end %>
  <% if flash[:notice] %>
    <div class="flash-msg flash-success" id="flash-notice"><i class="fas fa-circle-check"></i><span><%= flash[:notice] %></span></div>
  <% end %>

  <div class="appts-tabs">
    <button class="appts-tab-btn active" data-tab="proximos">Próximos</button>
    <button class="appts-tab-btn" data-tab="passados">Anteriores</button>
  </div>

  <%# ── Tab Próximos ─────────────────────────────────── %>
  <div id="tab-proximos">
    <% if @upcoming_appointments.any? %>
      <div class="appt-list">
        <% @upcoming_appointments.each do |appt| %>
          <% sched_sp   = appt.scheduled_at.in_time_zone("America/Sao_Paulo") %>
          <% is_lm     = is_last_minute.call(appt) %>
          <% is_today  = is_today_date.call(appt) %>
          <% is_ongoing = @ongoing_appointments.include?(appt.id) %>
          <% mins_until = ((appt.scheduled_at - current_time) / 60.0).to_i %>
          <% show_code  = @client_code.present? && (is_ongoing || mins_until <= 30) && appt.status == 'confirmed' %>
          <% can_can    = can_cancel.call(appt) %>
          <% dow_label  = is_today ? 'hoje' : weekdays_pt[sched_sp.wday] %>

          <div class="appt-card <%= 'today' if is_lm %>">
            <% if is_lm %><div class="appt-card-blob"></div><% end %>

            <div class="appt-inner">
              <div class="date-col">
                <span class="date-dow"><%= dow_label %></span>
                <span class="date-day"><%= sched_sp.day %></span>
                <span class="date-mon"><%= months_pt[sched_sp.month - 1] %></span>
              </div>

              <div class="appt-body">
                <div class="appt-id">#LV-<%= sprintf('%04d', appt.id) %></div>
                <div class="shop-name"><%= appt.car_wash.name %></div>
                <div class="service-name">
                  <%= appt.service.title %><% if appt.service.duration.present? %> · <%= appt.service.duration %>min<% end %>
                </div>
                <div class="time-price">
                  <%= sched_sp.strftime("%H:%M") %> · R$ <%= sprintf('%.2f', appt.service.price.to_f).gsub('.', ',') %>
                </div>

                <% if show_code %>
                  <div class="code-block <%= is_lm ? 'ink' : 'light' %>">
                    <span class="code-pill <%= is_lm ? 'ink' : 'light' %>">
                      <i class="fas fa-shield"></i><%= @client_code %>
                    </span>
                    <span class="code-hint <%= is_lm ? 'ink' : 'light' %>">
                      Passe esse código pro lava-rápido na chegada
                    </span>
                  </div>
                <% end %>
              </div>
            </div>

            <% if is_lm && is_today %>
              <div class="card-actions">
                <% if appt.car_wash.try(:address).present? %>
                  <% map_q = ERB::Util.url_encode(appt.car_wash.address) %>
                  <a href="https://www.google.com/maps/search/?api=1&query=<%= map_q %>" target="_blank" rel="noopener" class="action-primary">Ver rota</a>
                <% end %>
                <% if can_can %>
                  <button type="button" class="action-ghost"
                          onclick="openCancelModal(<%= appt.id %>, '<%= j appt.car_wash.name %>', '<%= dow_label %> <%= sched_sp.day %> <%= months_pt[sched_sp.month - 1] %> · <%= sched_sp.strftime("%H:%M") %>', '<%= cancel_appointment_path(appt) %>')">
                    Cancelar
                  </button>
                <% end %>
              </div>
            <% else %>
              <% if can_can %>
                <button type="button" class="cancel-link"
                        onclick="openCancelModal(<%= appt.id %>, '<%= j appt.car_wash.name %>', '<%= dow_label %> <%= sched_sp.day %> <%= months_pt[sched_sp.month - 1] %> · <%= sched_sp.strftime("%H:%M") %>', '<%= cancel_appointment_path(appt) %>')">
                  <i class="fas fa-xmark"></i> Cancelar agendamento
                </button>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="appts-empty">
        <div class="appts-empty-icon"><i class="fas fa-calendar-xmark"></i></div>
        <div class="appts-empty-title">Nenhum agendamento próximo</div>
        <p class="appts-empty-text">Suas reservas confirmadas aparecem aqui.</p>
        <%= link_to "Explorar lava-rápidos", car_washes_path, class: "loov-btn-primary" %>
      </div>
    <% end %>
  </div>

  <%# ── Tab Anteriores ───────────────────────────────── %>
  <div id="tab-passados" style="display: none;">
    <% if @past_appointments.any? %>
      <div class="appt-list">
        <% @past_appointments.each do |appt| %>
          <% sched_sp = appt.scheduled_at.in_time_zone("America/Sao_Paulo") %>
          <% reviewed = appt.review.present? %>
          <% rating   = appt.review&.rating.to_i %>

          <div class="appt-card">
            <div class="appt-inner">
              <div class="date-col">
                <span class="date-dow"><%= weekdays_pt[sched_sp.wday] %></span>
                <span class="date-day"><%= sched_sp.day %></span>
                <span class="date-mon"><%= months_pt[sched_sp.month - 1] %></span>
              </div>

              <div class="appt-body">
                <div class="appt-id">#LV-<%= sprintf('%04d', appt.id) %></div>
                <div class="shop-name"><%= appt.car_wash.name %></div>
                <div class="service-name">
                  <%= appt.service.title %><% if appt.service.duration.present? %> · <%= appt.service.duration %>min<% end %>
                </div>
                <div class="time-price">
                  <%= sched_sp.strftime("%H:%M") %> · R$ <%= sprintf('%.2f', appt.service.price.to_f).gsub('.', ',') %>
                </div>

                <% if appt.status == 'attended' && reviewed && rating > 0 %>
                  <div class="stars-row-result">
                    <% 5.times do |n| %>
                      <i class="fas fa-star" style="color: <%= n < rating ? 'var(--coral-500)' : 'var(--stone)' %>;"></i>
                    <% end %>
                    <span class="stars-hint">sua avaliação</span>
                  </div>
                <% end %>
              </div>
            </div>

            <% if appt.status == 'attended' && !reviewed %>
              <div class="rate-row">
                <span class="rate-row-label">Avalie</span>
                <div class="rate-row-stars">
                  <% (1..5).each do |n| %>
                    <button type="button" class="rate-row-star-btn"
                            onclick="openReviewModal(<%= appt.id %>, '<%= j appt.car_wash.name %>', <%= n %>)">
                      <i class="fas fa-star"></i>
                    </button>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="appts-empty">
        <div class="appts-empty-icon"><i class="fas fa-clock-rotate-left"></i></div>
        <div class="appts-empty-title">Sem anteriores</div>
        <p class="appts-empty-text">Atendimentos concluídos aparecem nesta aba.</p>
      </div>
    <% end %>
  </div>

</div>

<script>
(function() {
  // ── Tabs ────────────────────────────────────────────
  document.querySelectorAll('.appts-tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const t = btn.dataset.tab;
      document.querySelectorAll('.appts-tab-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById('tab-proximos').style.display = (t === 'proximos') ? '' : 'none';
      document.getElementById('tab-passados').style.display = (t === 'passados') ? '' : 'none';
    });
  });

  // ── Review modal ────────────────────────────────────
  window.openReviewModal = function(id, name, prefillRating) {
    document.getElementById('review-appointment-id').value = id;
    document.getElementById('modal-car-wash-name').textContent = name;
    const ratingVal = prefillRating ? Number(prefillRating) : '';
    document.getElementById('review-rating').value = ratingVal || '';
    document.getElementById('review-tags').value = '';
    document.getElementById('review-submit').disabled = !ratingVal;
    document.querySelectorAll('.star-btn').forEach(b => {
      b.classList.toggle('active', ratingVal && parseInt(b.dataset.value) <= ratingVal);
    });
    document.querySelectorAll('.tag-btn').forEach(b => b.classList.remove('selected'));
    const ta = document.querySelector('.review-textarea');
    if (ta) ta.value = '';
    document.getElementById('review-overlay').classList.add('open');
  };

  window.closeReviewModal = function() {
    document.getElementById('review-overlay').classList.remove('open');
  };

  document.getElementById('review-overlay').addEventListener('click', function(e) {
    if (e.target === this) window.closeReviewModal();
  });

  window.setStar = function(val) {
    document.getElementById('review-rating').value = val;
    document.getElementById('review-submit').disabled = false;
    document.querySelectorAll('.star-btn').forEach(b => {
      b.classList.toggle('active', parseInt(b.dataset.value) <= val);
    });
  };

  window.toggleTag = function(btn) {
    btn.classList.toggle('selected');
    const sel = Array.from(document.querySelectorAll('.tag-btn.selected')).map(b => b.dataset.tag);
    document.getElementById('review-tags').value = sel.join(',');
  };

  // ── Cancel modal ────────────────────────────────────
  window.openCancelModal = function(id, shopName, whenStr, cancelUrl) {
    document.getElementById('cancel-shop').textContent = shopName;
    document.getElementById('cancel-when').textContent = whenStr;
    document.getElementById('cancel-form').action = cancelUrl;
    document.getElementById('cancel-overlay').classList.add('open');
  };

  window.closeCancelModal = function() {
    document.getElementById('cancel-overlay').classList.remove('open');
  };

  document.getElementById('cancel-overlay').addEventListener('click', function(e) {
    if (e.target === this) window.closeCancelModal();
  });

  // ── Auto-dismiss flash ──────────────────────────────
  document.addEventListener('DOMContentLoaded', function() {
    ['flash-notice', 'flash-error'].forEach(function(id) {
      const el = document.getElementById(id); if (!el) return;
      setTimeout(() => {
        el.style.transition = 'opacity .5s ease';
        el.style.opacity = '0';
        setTimeout(() => el.style.display = 'none', 500);
      }, 6000);
    });
  });

  // ── Auto-refresh ticker ──────────────────────────────
  // Re-renderiza cards quando a hora atual cruza a fronteira de "hoje"
  // pra que o card siga a regra do app (today→ink, past→reload).
  setTimeout(() => { window.location.reload(); }, 1000 * 60 * 5);
})();
</script>
