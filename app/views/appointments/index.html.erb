<% Rails.logger.info("Renderizando appointments/index.html.erb") %>

<style>
  .flash-msg { display:flex; align-items:center; gap:10px; padding:13px 18px; border-radius:12px; font-size:13.5px; margin-bottom:20px; }
  .flash-error   { background:#fdecec; border:1px solid #f5cccc; color:var(--rose-500); }
  .flash-success { background:var(--coral-50); border:1px solid var(--coral-100); color:var(--coral-700); }

  .next-card {
    border:1px solid var(--coral-100);
    background:var(--paper);
    border-radius:20px;
    overflow:hidden;
    margin-bottom:18px;
    position:relative;
    box-shadow: 0 6px 20px rgba(220,120,82,0.06);
  }
  .next-card::before { content:''; position:absolute; left:0; top:0; bottom:0; width:3px; background:var(--coral-500); }
  .next-card-top { padding:24px 24px 18px 28px; display:flex; align-items:flex-start; justify-content:space-between; gap:20px; flex-wrap:wrap; }
  .next-card-eyebrow {
    font-family:'JetBrains Mono', monospace;
    font-size:10.5px; font-weight:600; letter-spacing:1.6px; text-transform:uppercase;
    color:var(--coral-500); margin-bottom:8px;
    display:inline-flex; align-items:center; gap:6px;
  }
  .next-card-eyebrow::before { content:''; display:block; width:18px; height:1px; background:var(--coral-500); }
  .next-card-name { font-family:'Space Grotesk', sans-serif; font-weight:700; font-size:clamp(24px, 4vw, 34px); line-height:1.05; letter-spacing:-0.5px; color:var(--ink); margin-bottom:6px; }
  .next-card-address { font-size:13px; color:var(--graphite); display:flex; align-items:center; gap:6px; }
  .next-card-address i { color:var(--coral-500); font-size:11px; }
  .next-card-datetime { text-align:right; flex-shrink:0; }
  .next-card-time { font-family:'Space Grotesk', sans-serif; font-weight:700; font-size:42px; color:var(--coral-500); line-height:1; letter-spacing:-0.5px; }
  .next-card-date { font-size:12.5px; color:var(--ash); margin-top:4px; font-family:'JetBrains Mono', monospace; letter-spacing:0.5px; }
  .next-card-bottom { border-top:1px solid var(--stone); padding:16px 24px 16px 28px; display:flex; align-items:center; justify-content:space-between; gap:14px; flex-wrap:wrap; }
  .next-card-service { display:flex; align-items:center; gap:12px; }
  .next-card-service-icon { width:42px; height:42px; border-radius:12px; background:var(--coral-50); border:1px solid var(--coral-100); display:flex; align-items:center; justify-content:center; color:var(--coral-700); font-size:13px; flex-shrink:0; }
  .next-card-service-name { font-size:14.5px; font-weight:600; color:var(--ink); }
  .next-card-service-meta { font-size:12.5px; color:var(--graphite); margin-top:2px; }
  .next-card-actions { display:flex; align-items:center; gap:14px; flex-wrap:wrap; }
  .cancel-deadline { font-size:12px; color:var(--ash); display:inline-flex; align-items:center; gap:6px; font-family:'JetBrains Mono', monospace; letter-spacing:0.5px; }
  .cancel-deadline i { font-size:11px; color:var(--graphite); }

  .code-inline {
    display:inline-flex; align-items:center; gap:6px;
    background:var(--coral-50); border:1px solid var(--coral-100); border-radius:10px;
    padding:6px 11px; font-family:'JetBrains Mono', monospace; font-size:11.5px; font-weight:700;
    color:var(--coral-700); letter-spacing:1.4px; margin-top:10px;
  }
  .code-inline i { font-size:10px; }

  .upcoming-list { display:flex; flex-direction:column; gap:8px; margin-bottom:40px; }
  .upcoming-item {
    background:var(--paper); border:1px solid var(--stone);
    border-radius:14px; overflow:hidden; transition:border-color .2s ease, box-shadow .2s ease;
    position:relative;
  }
  .upcoming-item::before { content:''; position:absolute; left:0; top:0; bottom:0; width:3px; background:var(--coral-500); transform:scaleY(0); transform-origin:bottom; transition:transform .3s ease; }
  .upcoming-item:hover { border-color:var(--coral-100); }
  .upcoming-item:hover::before, .upcoming-item.expanded::before { transform:scaleY(1); }
  .upcoming-item.expanded { border-color:var(--coral-100); box-shadow: 0 8px 18px rgba(25,20,15,0.04); }
  .upcoming-item-header { display:flex; align-items:center; justify-content:space-between; padding:14px 18px 14px 20px; gap:14px; user-select:none; cursor:pointer; }
  .upcoming-item-left { flex:1; min-width:0; }
  .upcoming-item-name { font-family:'Space Grotesk', sans-serif; font-weight:600; font-size:17px; color:var(--ink); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; letter-spacing:-0.2px; }
  .upcoming-item-meta { font-size:12.5px; color:var(--graphite); margin-top:4px; display:flex; align-items:center; gap:6px; flex-wrap:wrap; }
  .upcoming-item-meta i { color:var(--coral-500); font-size:10.5px; }
  .upcoming-item-right { display:flex; align-items:center; gap:14px; flex-shrink:0; }
  .upcoming-item-time { font-family:'Space Grotesk', sans-serif; font-weight:700; font-size:20px; color:var(--ink); text-align:right; letter-spacing:-0.3px; }
  .upcoming-item-date { font-size:11.5px; color:var(--ash); text-align:right; margin-top:2px; font-family:'JetBrains Mono', monospace; letter-spacing:0.5px; }
  .upcoming-item-chevron { color:var(--ash); font-size:11px; transition:transform .25s ease; flex-shrink:0; }
  .upcoming-item.expanded .upcoming-item-chevron { transform:rotate(180deg); color:var(--coral-500); }
  .upcoming-item-details { max-height:0; overflow:hidden; transition:max-height .35s ease; }
  .upcoming-item-details.open { max-height:600px; }
  .upcoming-item-details-inner { border-top:1px solid var(--stone); padding:18px 18px 18px 20px; display:flex; flex-direction:column; gap:10px; }
  .detail-row { display:flex; align-items:center; justify-content:space-between; gap:14px; }
  .detail-label { color:var(--ash); font-family:'JetBrains Mono', monospace; font-size:10.5px; letter-spacing:1.4px; text-transform:uppercase; }
  .detail-value { color:var(--ink); text-align:right; font-size:13.5px; font-weight:500; }
  .upcoming-item-actions { display:flex; align-items:center; justify-content:flex-end; gap:14px; padding-top:12px; border-top:1px solid var(--stone); margin-top:6px; flex-wrap:wrap; }

  .history-list { display:flex; flex-direction:column; border:1px solid var(--stone); border-radius:16px; overflow:hidden; background:var(--paper); }
  .history-item { display:flex; align-items:center; justify-content:space-between; padding:14px 18px; border-bottom:1px solid var(--stone); gap:14px; transition:background .15s ease; }
  .history-item:last-child { border-bottom:none; }
  .history-item:hover { background:var(--cream); }
  .history-item-left { flex:1; min-width:0; }
  .history-item-name { font-family:'Space Grotesk', sans-serif; font-weight:600; font-size:15px; color:var(--ink); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .history-item-meta { font-size:12px; color:var(--graphite); margin-top:3px; display:flex; align-items:center; gap:6px; flex-wrap:wrap; }
  .history-item-meta i { color:var(--coral-500); font-size:10px; }
  .history-item-right { display:flex; align-items:center; gap:12px; flex-shrink:0; }
  .history-item-date-main { font-size:13px; color:var(--graphite); text-align:right; font-family:'JetBrains Mono', monospace; letter-spacing:0.5px; }
  .history-item-date-time { font-size:11px; color:var(--ash); text-align:right; font-family:'JetBrains Mono', monospace; letter-spacing:0.5px; }

  .btn-review {
    display:inline-flex; align-items:center; gap:6px;
    padding:6px 14px; border-radius:100px;
    font-family:'JetBrains Mono', monospace; font-size:10.5px; font-weight:600; letter-spacing:1.4px; text-transform:uppercase;
    cursor:pointer; background:#fef3c7; color:#7a4814; border:1px solid #fbe2c0; transition:all .2s ease; white-space:nowrap;
  }
  .btn-review:hover { background:#fbe2c0; }
  .reviewed-badge { display:inline-flex; align-items:center; gap:3px; font-size:11.5px; color:var(--ash); }
  .reviewed-badge i { color:#d6b14a; }

  .loyalty-strip {
    display:inline-flex; align-items:center; gap:8px;
    margin-top:10px;
    background:var(--cream); border:1px solid var(--stone);
    border-radius:100px; padding:5px 12px;
  }
  .loy-dots { display:flex; align-items:center; gap:3px; }
  .loy-dot { width:7px; height:7px; border-radius:50%; background:var(--stone); border:1px solid var(--stone); flex-shrink:0; transition:background .2s; }
  .loy-dot.filled { background:var(--coral-500); border-color:var(--coral-500); box-shadow:0 0 4px rgba(220,120,82,.4); }
  .loy-label { font-family:'JetBrains Mono', monospace; font-size:10px; color:var(--graphite); white-space:nowrap; letter-spacing:0.6px; }
  .loyalty-strip.milestone { background:#fef3c7; border-color:#fbe2c0; }
  .loyalty-strip.milestone .loy-dot { background:#d6b14a; border-color:#d6b14a; box-shadow:0 0 4px rgba(214,177,74,.4); }
  .loyalty-strip.milestone .loy-label { color:#7a4814; font-weight:700; }

  .review-overlay { position:fixed; inset:0; background:rgba(40,35,28,0.55); z-index:1000; display:flex; align-items:center; justify-content:center; padding:18px; opacity:0; pointer-events:none; transition:opacity .25s ease; backdrop-filter:blur(8px); }
  .review-overlay.open { opacity:1; pointer-events:all; }
  .review-modal { background:var(--paper); border:1px solid var(--stone); border-radius:20px; padding:32px; width:100%; max-width:480px; transform:translateY(20px); transition:transform .25s cubic-bezier(.16,1,.3,1); box-shadow: 0 24px 60px rgba(40,35,28,0.18); }
  .review-overlay.open .review-modal { transform:translateY(0); }
  .review-modal-title { font-family:'Space Grotesk', sans-serif; font-weight:700; font-size:24px; color:var(--ink); margin-bottom:4px; letter-spacing:-0.4px; }
  .review-modal-sub { font-size:13.5px; color:var(--graphite); margin-bottom:24px; }
  .stars-row { display:flex; gap:8px; margin-bottom:22px; }
  .star-btn { background:none; border:none; cursor:pointer; font-size:28px; color:var(--stone); transition:color .15s ease, transform .15s ease; padding:0; }
  .star-btn.active { color:#d6b14a; }
  .star-btn:hover { transform:scale(1.15); }
  .tags-row { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:18px; }
  .tag-btn { padding:6px 14px; border-radius:100px; font-size:12.5px; cursor:pointer; background:var(--cream); color:var(--graphite); border:1px solid var(--stone); transition:all .15s ease; }
  .tag-btn.selected { background:var(--coral-50); color:var(--coral-700); border-color:var(--coral-100); }
  .review-textarea { width:100%; background:var(--paper); border:1px solid var(--stone); border-radius:12px; padding:12px 14px; font-size:14px; color:var(--ink); font-family:'Inter', sans-serif; resize:none; box-sizing:border-box; margin-bottom:20px; transition:border-color .2s ease; }
  .review-textarea:focus { outline:none; border-color:var(--coral-500); }
  .review-textarea::placeholder { color:var(--ash); }
  .review-modal-actions { display:flex; gap:10px; }
  .btn-modal-cancel { flex:1; padding:12px; border-radius:100px; background:var(--paper); color:var(--graphite); border:1px solid var(--stone); font-family:'JetBrains Mono', monospace; font-size:11.5px; font-weight:600; letter-spacing:1.4px; text-transform:uppercase; cursor:pointer; transition:all .2s ease; }
  .btn-modal-cancel:hover { border-color:var(--coral-500); color:var(--coral-700); }
  .btn-modal-submit { flex:2; padding:12px; border-radius:100px; background:var(--coral-500); color:var(--cream); border:none; font-family:'JetBrains Mono', monospace; font-size:11.5px; font-weight:600; letter-spacing:1.4px; text-transform:uppercase; cursor:pointer; transition:background .2s ease; }
  .btn-modal-submit:hover:not(:disabled) { background:var(--coral-700); }
  .btn-modal-submit:disabled { opacity:.45; cursor:not-allowed; }

  .btn-cancel-appt {
    display:inline-flex; align-items:center; gap:6px;
    padding:8px 16px; border-radius:100px;
    font-family:'JetBrains Mono', monospace; font-size:10.5px; font-weight:600; letter-spacing:1.4px; text-transform:uppercase;
    background:var(--paper); color:var(--rose-500); border:1px solid #f5cccc; transition:all .15s ease; cursor:pointer;
  }
  .btn-cancel-appt:hover { background:#fdecec; }

  .empty-state { text-align:center; padding:60px 24px; border:1px solid var(--stone); border-radius:20px; background:var(--paper); }
  .empty-icon { font-size:36px; color:var(--stone); margin-bottom:14px; }
  .empty-title { font-family:'Space Grotesk', sans-serif; font-weight:700; font-size:24px; color:var(--ink); margin-bottom:8px; letter-spacing:-0.3px; }
  .empty-text { font-size:14px; color:var(--graphite); margin-bottom:22px; line-height:1.6; }

  @media (max-width:640px) {
    .next-card-top { flex-direction:column; }
    .next-card-datetime { text-align:left; }
  }
</style>

<div class="review-overlay" id="review-overlay">
  <div class="review-modal">
    <div class="review-modal-title">Avaliar <span id="modal-car-wash-name" style="color:var(--coral-500);"></span></div>
    <div class="review-modal-sub">Como foi sua experiência?</div>
    <%= form_with url: client_reviews_path, method: :post, data: { turbo: false }, id: "review-form" do |f| %>
      <%= f.hidden_field :appointment_id, id: "review-appointment-id" %>
      <div class="stars-row" id="stars-row">
        <% (1..5).each do |i| %>
          <button type="button" class="star-btn" data-value="<%= i %>" onclick="setStar(<%= i %>)">
            <i class="fas fa-star"></i>
          </button>
        <% end %>
      </div>
      <%= f.hidden_field :rating, id: "review-rating", value: "" %>
      <div class="tags-row" id="tags-row">
        <% Review::TAGS.each do |tag| %>
          <button type="button" class="tag-btn" data-tag="<%= tag %>" onclick="toggleTag(this)"><%= tag %></button>
        <% end %>
      </div>
      <%= f.hidden_field :tags, id: "review-tags", value: "" %>
      <%= f.text_area :comment, class: "review-textarea", rows: 3, placeholder: "Comentário opcional..." %>
      <div class="review-modal-actions">
        <button type="button" class="btn-modal-cancel" onclick="closeReviewModal()">Cancelar</button>
        <%= f.submit "Enviar Avaliação", class: "btn-modal-submit", id: "review-submit", disabled: true %>
      </div>
    <% end %>
  </div>
</div>

<div class="loov-page">

  <div class="loov-hero">
    <div class="loov-eyebrow"><span class="dot"></span>SUA AGENDA</div>
    <h1 class="loov-h1">Meus <span class="accent">agendamentos</span>.</h1>
    <p class="loov-lead">Acompanhe sua próxima reserva, gerencie cancelamentos e revise o histórico.</p>
    <div class="loov-cta-row">
      <%= link_to car_washes_path, class: "loov-btn-primary" do %>
        <i class="fas fa-plus"></i> Novo agendamento
      <% end %>
    </div>
  </div>

  <% if flash[:alert] %>
    <div class="flash-msg flash-error" id="flash-error"><i class="fas fa-circle-exclamation"></i><span><%= flash[:alert] %></span></div>
  <% end %>
  <% if flash[:notice] %>
    <div class="flash-msg flash-success" id="flash-notice"><i class="fas fa-circle-check"></i><span><%= flash[:notice] %></span></div>
  <% end %>

  <% current_time = Time.current.in_time_zone("America/Sao_Paulo") %>

  <% if @upcoming_appointments.empty? && @past_appointments.empty? %>
    <div class="empty-state">
      <div class="empty-icon"><i class="fas fa-calendar-xmark"></i></div>
      <div class="empty-title">Tudo limpo por aqui</div>
      <p class="empty-text">Você ainda não fez nenhum agendamento.<br>Que tal marcar o primeiro?</p>
      <%= link_to "Explorar lava-rápidos", car_washes_path, class: "loov-btn-primary" %>
    </div>

  <% else %>

    <% if @upcoming_appointments.any? %>
      <% next_appt          = @upcoming_appointments.first %>
      <% next_is_ongoing    = @ongoing_appointments.include?(next_appt.id) %>
      <% next_minutes_until = ((next_appt.scheduled_at - current_time) / 60).to_i %>
      <% next_can_cancel    = !next_is_ongoing && next_appt.regular? && next_minutes_until > 120 %>
      <% next_cancel_deadline = next_appt.scheduled_at.in_time_zone("America/Sao_Paulo") - 2.hours %>
      <% next_show_code     = @client_code.present? && (next_is_ongoing || next_minutes_until <= 30) %>

      <div class="next-card">
        <div class="next-card-top">
          <div>
            <div class="next-card-eyebrow">
              <%= next_is_ongoing ? "Em andamento agora" : "Próximo agendamento" %>
            </div>
            <div class="next-card-name"><%= next_appt.car_wash.name %></div>
            <div class="next-card-address">
              <i class="fas fa-location-dot"></i>
              <%= next_appt.car_wash.address %>
            </div>
            <% if next_show_code %>
              <div class="code-inline">
                <i class="fas fa-hashtag"></i>
                Código: <strong style="margin-left:2px;"><%= @client_code %></strong>
              </div>
            <% end %>
            <% if (loy = @loyalty_by_car_wash[next_appt.car_wash_id]) %>
              <% proj = loy[:visits] + 1 %>
              <% proj_cycle = proj % loy[:goal] %>
              <% proj_milestone = proj_cycle == 0 %>
              <% proj_filled = proj_milestone ? loy[:goal] : proj_cycle %>
              <div class="loyalty-strip <%= proj_milestone ? 'milestone' : '' %>">
                <div class="loy-dots">
                  <% loy[:goal].times do |i| %>
                    <span class="loy-dot <%= i < proj_filled ? 'filled' : '' %>"></span>
                  <% end %>
                </div>
                <span class="loy-label">
                  <% if proj_milestone %>
                    <i class="fas fa-trophy" style="font-size:9px;margin-right:2px;"></i> <%= loy[:reward] %> desbloqueado!
                  <% else %>
                    <%= proj_filled %>/<%= loy[:goal] %> visitas · <%= loy[:reward] %>
                  <% end %>
                </span>
              </div>
            <% end %>
          </div>
          <div class="next-card-datetime">
            <div class="next-card-time"><%= next_appt.scheduled_at.in_time_zone("America/Sao_Paulo").strftime("%H:%M") %></div>
            <div class="next-card-date"><%= next_appt.scheduled_at.in_time_zone("America/Sao_Paulo").strftime("%d/%m/%Y") %></div>
          </div>
        </div>
        <div class="next-card-bottom">
          <div class="next-card-service">
            <div class="next-card-service-icon"><i class="fas fa-wrench"></i></div>
            <div>
              <div class="next-card-service-name"><%= next_appt.service.title %></div>
              <div class="next-card-service-meta"><%= next_appt.service.duration %> min · R$ <%= number_with_precision(next_appt.service.price, precision: 2, separator: ',') %></div>
            </div>
          </div>
          <div class="next-card-actions">
            <% if next_can_cancel %>
              <div class="cancel-deadline">
                <i class="fas fa-clock"></i>
                Cancele até <%= next_cancel_deadline.strftime("%H:%M") %> de <%= next_cancel_deadline.strftime("%d/%m") %>
              </div>
              <%= form_with url: cancel_appointment_path(next_appt), method: :delete, local: true, data: { turbo: false, confirm: "Tem certeza que deseja cancelar?" } do %>
                <%= submit_tag "Cancelar", class: "btn-cancel-appt" %>
              <% end %>
            <% elsif !next_is_ongoing && next_appt.regular? && next_minutes_until <= 120 %>
              <span class="cancel-deadline"><i class="fas fa-lock"></i> Cancelamento encerrado</span>
            <% end %>
          </div>
        </div>
      </div>

      <% other_upcoming = @upcoming_appointments[1..] %>
      <% if other_upcoming.any? %>
        <div class="upcoming-list">
          <% other_upcoming.each do |appt| %>
            <% is_ongoing      = @ongoing_appointments.include?(appt.id) %>
            <% minutes_until   = ((appt.scheduled_at - current_time) / 60).to_i %>
            <% can_cancel      = !is_ongoing && appt.regular? && minutes_until > 120 %>
            <% cancel_deadline = appt.scheduled_at.in_time_zone("America/Sao_Paulo") - 2.hours %>
            <% show_code_item  = @client_code.present? && (is_ongoing || minutes_until <= 30) %>
            <div class="upcoming-item" data-appt-id="<%= appt.id %>">
              <div class="upcoming-item-header" onclick="toggleUpcoming(<%= appt.id %>)">
                <div class="upcoming-item-left">
                  <div class="upcoming-item-name"><%= appt.car_wash.name %></div>
                  <div class="upcoming-item-meta">
                    <i class="fas fa-wrench"></i> <%= appt.service.title %>
                    &middot;
                    <i class="fas fa-location-dot"></i> <%= appt.car_wash.address.truncate(35) %>
                  </div>
                  <% if show_code_item %>
                    <div class="code-inline" style="margin-top:8px;">
                      <i class="fas fa-hashtag"></i> Código: <strong style="margin-left:2px;"><%= @client_code %></strong>
                    </div>
                  <% end %>
                  <% if (loy = @loyalty_by_car_wash[appt.car_wash_id]) %>
                    <% proj = loy[:visits] + 1 %>
                    <% proj_cycle = proj % loy[:goal] %>
                    <% proj_milestone = proj_cycle == 0 %>
                    <% proj_filled = proj_milestone ? loy[:goal] : proj_cycle %>
                    <div class="loyalty-strip <%= proj_milestone ? 'milestone' : '' %>">
                      <div class="loy-dots">
                        <% loy[:goal].times do |i| %>
                          <span class="loy-dot <%= i < proj_filled ? 'filled' : '' %>"></span>
                        <% end %>
                      </div>
                      <span class="loy-label">
                        <% if proj_milestone %>
                          <i class="fas fa-trophy" style="font-size:9px;margin-right:2px;"></i> <%= loy[:reward] %> desbloqueado!
                        <% else %>
                          <%= proj_filled %>/<%= loy[:goal] %> visitas · <%= loy[:reward] %>
                        <% end %>
                      </span>
                    </div>
                  <% end %>
                </div>
                <div class="upcoming-item-right">
                  <div>
                    <div class="upcoming-item-time"><%= appt.scheduled_at.in_time_zone("America/Sao_Paulo").strftime("%H:%M") %></div>
                    <div class="upcoming-item-date"><%= appt.scheduled_at.in_time_zone("America/Sao_Paulo").strftime("%d/%m/%Y") %></div>
                  </div>
                  <i class="fas fa-chevron-down upcoming-item-chevron"></i>
                </div>
              </div>
              <div class="upcoming-item-details" id="details-<%= appt.id %>">
                <div class="upcoming-item-details-inner">
                  <div class="detail-row"><span class="detail-label">Serviço</span><span class="detail-value"><%= appt.service.title %></span></div>
                  <div class="detail-row"><span class="detail-label">Duração</span><span class="detail-value"><%= appt.service.duration %> min</span></div>
                  <div class="detail-row"><span class="detail-label">Endereço</span><span class="detail-value"><%= appt.car_wash.address %></span></div>
                  <div class="detail-row">
                    <span class="detail-label">Valor</span>
                    <span class="detail-value" style="color:var(--coral-500); font-family:'Space Grotesk',sans-serif; font-size:18px; font-weight:700;">R$ <%= number_with_precision(appt.service.price, precision: 2, separator: ',') %></span>
                  </div>
                  <div class="upcoming-item-actions">
                    <% if can_cancel %>
                      <span class="cancel-deadline"><i class="fas fa-clock"></i> Cancele até <%= cancel_deadline.strftime("%H:%M") %> de <%= cancel_deadline.strftime("%d/%m") %></span>
                      <%= form_with url: cancel_appointment_path(appt), method: :delete, local: true, data: { turbo: false, confirm: "Tem certeza que deseja cancelar?" } do %>
                        <%= submit_tag "Cancelar agendamento", class: "btn-cancel-appt" %>
                      <% end %>
                    <% elsif !is_ongoing && appt.regular? %>
                      <span class="cancel-deadline"><i class="fas fa-lock"></i> Cancelamento encerrado</span>
                    <% else %>
                      <span style="font-size:12.5px;color:var(--ash);">Cancelamento indisponível</span>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>

    <% else %>
      <div class="empty-state" style="margin-bottom:32px;">
        <div class="empty-icon"><i class="fas fa-calendar-check"></i></div>
        <div class="empty-title">Nenhum agendamento futuro</div>
        <p class="empty-text">Seu carro merece atenção. Agende agora.</p>
        <%= link_to "Explorar lava-rápidos", car_washes_path, class: "loov-btn-primary" %>
      </div>
    <% end %>

    <% if @past_appointments.any? %>
      <div class="loov-section">
        <div class="loov-section-header">
          <div>
            <div class="loov-section-label">HISTÓRICO</div>
            <h2 class="loov-h2">Atendimentos anteriores</h2>
          </div>
          <span class="loov-pill loov-pill--neutral"><%= @past_appointments.count %> agendamento<%= @past_appointments.count == 1 ? '' : 's' %></span>
        </div>
        <div class="history-list">
          <% @past_appointments.each do |appt| %>
            <div class="history-item">
              <div class="history-item-left">
                <div class="history-item-name"><%= appt.car_wash.name %></div>
                <div class="history-item-meta">
                  <i class="fas fa-wrench"></i> <%= appt.service.title %>
                  &middot;
                  <i class="fas fa-clock"></i> <%= appt.service.duration %> min
                </div>
              </div>
              <div class="history-item-right">
                <div>
                  <div class="history-item-date-main"><%= appt.scheduled_at.in_time_zone("America/Sao_Paulo").strftime("%d/%m/%Y") %></div>
                  <div class="history-item-date-time"><%= appt.scheduled_at.in_time_zone("America/Sao_Paulo").strftime("%H:%M") %></div>
                </div>
                <% if appt.review.present? %>
                  <div class="reviewed-badge">
                    <% appt.review.rating.times do %><i class="fas fa-star"></i><% end %>
                  </div>
                <% elsif appt.status == 'attended' %>
                  <button class="btn-review" onclick="openReviewModal(<%= appt.id %>, '<%= j appt.car_wash.name %>')">
                    <i class="fas fa-star"></i> Avaliar
                  </button>
                <% elsif appt.status == 'no_show' %>
                <% else %>
                  <span class="loov-pill loov-pill--neutral">Pendente</span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

  <% end %>
</div>

<script>
(function() {
  window.toggleUpcoming=function(id){var item=document.querySelector('[data-appt-id="'+id+'"]'),details=document.getElementById('details-'+id),isOpen=item.classList.contains('expanded');document.querySelectorAll('.upcoming-item').forEach(function(el){el.classList.remove('expanded');var d=el.querySelector('.upcoming-item-details');if(d)d.classList.remove('open');});if(!isOpen){item.classList.add('expanded');details.classList.add('open');}};

  window.openReviewModal=function(id,name){document.getElementById('review-appointment-id').value=id;document.getElementById('modal-car-wash-name').textContent=name;document.getElementById('review-rating').value='';document.getElementById('review-tags').value='';document.getElementById('review-submit').disabled=true;document.querySelectorAll('.star-btn').forEach(b=>b.classList.remove('active'));document.querySelectorAll('.tag-btn').forEach(b=>b.classList.remove('selected'));var ta=document.querySelector('.review-textarea');if(ta)ta.value='';document.getElementById('review-overlay').classList.add('open');};
  window.closeReviewModal=function(){document.getElementById('review-overlay').classList.remove('open');};
  document.getElementById('review-overlay').addEventListener('click',function(e){if(e.target===this)window.closeReviewModal();});
  window.setStar=function(val){document.getElementById('review-rating').value=val;document.getElementById('review-submit').disabled=false;document.querySelectorAll('.star-btn').forEach(b=>b.classList.toggle('active',parseInt(b.dataset.value)<=val));};
  window.toggleTag=function(btn){btn.classList.toggle('selected');var sel=Array.from(document.querySelectorAll('.tag-btn.selected')).map(b=>b.dataset.tag);document.getElementById('review-tags').value=sel.join(',');};

  document.addEventListener('DOMContentLoaded',function(){
    ['flash-notice','flash-error'].forEach(function(id){var el=document.getElementById(id);if(!el)return;setTimeout(function(){el.style.transition='opacity .5s ease';el.style.opacity='0';setTimeout(function(){el.style.display='none';},500);},6000);});
  });
})();
</script>
