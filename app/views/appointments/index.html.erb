<%#
  Meus agendamentos — porte da aba Agenda do app
  (LoovApp/src/screens/AppointmentsScreen.js + ReviewScreen.js), lendo o
  mesmo JSON (AppointmentsController#appointments_payload), embutido aqui e
  atualizado a cada 20 s, com recuo se o servidor recusar — o dono pode marcar
  "compareceu" enquanto o cliente olha, e a avaliação aparece sozinha.

    · Próximos / Anteriores, agrupados por dia (HOJE, AMANHÃ, QUI · 14 AGO):
      a data vira cabeçalho em vez de se repetir em cada cartão.
    · Cartão escuro = é HOJE (iminência, não tipo de reserva); Last Minute
      é selo.
    · Código de chegada + Rota; cancelar só com mais de 2 h de antecedência,
      numa folha de confirmação; avaliar tocando nas estrelas abre a tela
      de avaliação já com a nota (#avaliar-ID).

  Tela grande: título, abas e resumo ficam numa coluna fixa à esquerda e os
  cartões usam o resto da largura em grade.
%>
<script src="/vendor/feather-4.29.2.min.js"></script>

<style>
  .loov-nav { background: var(--cream) !important; }
  html, body { overflow-x: clip !important; }
  .ag { background: var(--cream); color: var(--ink); min-height: 100vh; padding-top: 60px; }
  .ag *, .ag *::before, .ag *::after { box-sizing: border-box; }
  .ag button { font-family: inherit; line-height: normal; cursor: pointer; }
  .ag svg.feather { display: block; }
  .ag a { text-decoration: none; }
  .ag-wrap { width: 100%; max-width: 1240px; margin: 0 auto; }
  .ag-view { display: none; }
  .ag-view.is-on { display: block; }

  .ag-head { padding: 24px 20px 20px; }
  .ag-eyebrow { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 1px; color: var(--ash); text-transform: uppercase; }
  .ag-title { margin: 4px 0 0 !important; font-family: 'Space Grotesk', sans-serif !important; font-weight: 700; font-size: 32px; line-height: 1.1; letter-spacing: -0.8px; color: var(--ink) !important; }
  .ag-tabs { display: flex; gap: 4px; margin: 0 20px 20px; padding: 4px; background: var(--sand); border-radius: 14px; }
  .ag-tabs button { flex: 1; height: 40px; border: 0; border-radius: 10px; background: transparent; color: var(--ink); font-size: 13px; font-weight: 600; transition: background .15s, box-shadow .15s; }
  .ag-tabs button[aria-selected="true"] { background: var(--paper); box-shadow: 0 1px 3px rgba(40,35,28,.12); }
  .ag-tabs small { margin-left: 4px; color: var(--ash); font-weight: 500; }
  .ag-side-extra { display: none; }

  .ag-list { padding: 4px 20px 48px; }
  .ag-day { margin: 18px 0 10px; font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 1.3px; color: var(--ash); text-transform: uppercase; }
  .ag-day:first-child { margin-top: 0; }
  .ag-cards { display: grid; grid-template-columns: minmax(0, 1fr); gap: 10px; align-items: start; }

  /* Cartão — o tom vem de variáveis: claro por padrão, escuro quando é hoje. */
  .ag-card { --t: var(--ink); --b: var(--graphite); --q: var(--ash); --l: var(--stone);
    padding: 14px 16px 4px; border-radius: 18px; background: var(--paper); border: 1px solid var(--stone); }
  .ag-card.is-today { --t: var(--cream); --b: #c9c4ba; --q: #9e9688; --l: rgba(255,255,255,.12); background: var(--ink); border-color: var(--ink); }
  .ag-top { display: flex; align-items: flex-start; gap: 14px; padding-bottom: 10px; }
  .ag-time { flex: 0 0 72px; }
  .ag-time b { display: block; font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 24px; line-height: 27px; letter-spacing: -0.8px; color: var(--t); }
  .ag-time small { display: block; margin-top: 3px; font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: .8px; color: var(--q); }
  .ag-mid { flex: 1; min-width: 0; }
  .ag-shoprow { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 7px; min-width: 0; }
  /* Nome tem prioridade: sem espaço, o selo Last Minute desce pra linha de baixo. */
  .ag-shoprow .ag-shop { max-width: 100%; }
  .ag-shop { min-width: 0; font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 16px; letter-spacing: -0.2px; color: var(--t) !important; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  a.ag-shop:hover { text-decoration: underline; text-underline-offset: 3px; }
  .ag-lm { flex-shrink: 0; display: inline-flex; align-items: center; gap: 3px; padding: 3px 7px; border-radius: 100px; background: var(--coral-50); color: var(--coral-700); font-family: 'JetBrains Mono', monospace; font-size: 8.5px; font-weight: 500; letter-spacing: .6px; }
  .ag-card.is-today .ag-lm { background: var(--coral-300); color: var(--ink); }
  .ag-svc { margin-top: 3px; font-size: 12.5px; color: var(--b); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ag-money { text-align: right; }
  .ag-price { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 15px; letter-spacing: -0.3px; color: var(--t); white-space: nowrap; }
  .ag-id { margin-top: 4px; font-family: 'JetBrains Mono', monospace; font-size: 9.5px; letter-spacing: .5px; color: var(--q); }
  .ag-foot { display: flex; align-items: center; gap: 10px; margin-top: 4px; padding: 12px 0 10px; border-top: 1px solid var(--l); }
  .ag-code { display: inline-flex; align-items: center; gap: 5px; padding: 5px 10px; border-radius: 100px; background: var(--coral-500); color: var(--cream); font-family: 'JetBrains Mono', monospace; font-size: 13px; font-weight: 500; letter-spacing: 1px; }
  .ag-card.is-today .ag-code { background: var(--cream); color: var(--ink); }
  .ag-hint { flex: 1; min-width: 0; font-size: 11.5px; color: var(--b); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ag-hint.is-quiet { color: var(--q); }
  .ag-route { display: inline-flex; align-items: center; gap: 5px; padding: 11px 13px; border-radius: 100px; border: 1px solid var(--l); color: var(--coral-700) !important; font-size: 11.5px; font-weight: 600; transition: background .15s; }
  .ag-route:hover { background: var(--coral-50); }
  .ag-card.is-today .ag-route { color: var(--cream) !important; }
  .ag-card.is-today .ag-route:hover { background: rgba(255,255,255,.08); }
  .ag-stars { display: flex; align-items: center; gap: 4px; }
  .ag-rate-l { flex: 1; font-size: 12.5px; font-weight: 500; color: var(--b); }
  .ag-star { border: 0; background: transparent; padding: 4px; margin: -4px 0; color: var(--coral-500); border-radius: 8px; transition: transform .15s, background .15s; }
  .ag-star:hover { transform: scale(1.15); background: var(--coral-50); }
  .ag-cancel { display: block; width: 100%; margin-top: 2px; padding: 13px 0; border: 0; border-top: 1px solid var(--l); background: transparent; color: var(--q); font-size: 11.5px; font-weight: 600; letter-spacing: .2px; transition: color .15s; }
  .ag-cancel:hover { color: var(--rose-500, #c0392b); }

  .ag-empty { display: flex; flex-direction: column; align-items: center; padding: 48px 32px 60px; text-align: center; }
  .ag-empty img { width: min(84%, 340px); height: auto; margin-bottom: 18px; }
  .ag-empty h2 { margin: 0 0 8px !important; font-family: 'Space Grotesk', sans-serif !important; font-weight: 600; font-size: 18px; letter-spacing: -0.3px; color: var(--ink) !important; }
  .ag-empty p { margin: 0; max-width: 36ch; font-size: 13px; line-height: 20px; color: var(--graphite); }
  .ag-empty a { margin-top: 20px; padding: 13px 22px; border-radius: 100px; background: var(--coral-500); color: var(--cream) !important; font-size: 14px; font-weight: 600; }

  /* Folha de cancelar */
  .ag-sheet-bg { position: fixed; inset: 0; z-index: 60; display: flex; align-items: flex-end; justify-content: center; background: rgba(20,14,9,.55); opacity: 0; pointer-events: none; transition: opacity .2s; }
  .ag-sheet-bg.is-on { opacity: 1; pointer-events: auto; }
  .ag-sheet { width: 100%; max-width: 440px; display: flex; flex-direction: column; align-items: center; padding: 10px 22px calc(30px + env(safe-area-inset-bottom, 0px)); background: var(--cream); border-radius: 24px 24px 0 0; transform: translateY(24px); transition: transform .25s; }
  .ag-sheet-bg.is-on .ag-sheet { transform: none; }
  .ag-handle { width: 42px; height: 4px; border-radius: 2px; background: var(--stone); margin-bottom: 20px; }
  .ag-sheet-ic { width: 52px; height: 52px; margin-bottom: 14px; border-radius: 50%; background: rgba(200,80,80,.12); border: 1px solid rgba(200,80,80,.25); color: var(--rose-500, #c0392b); display: flex; align-items: center; justify-content: center; }
  .ag-sheet h2 { margin: 0 !important; font-family: 'Space Grotesk', sans-serif !important; font-weight: 600; font-size: 19px; letter-spacing: -0.3px; color: var(--ink) !important; text-align: center; }
  .ag-sum { align-self: stretch; margin-top: 14px; padding: 12px 14px; background: var(--paper); border: 1px solid var(--stone); border-radius: 12px; }
  .ag-sum b { display: block; font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ag-sum small { display: block; margin-top: 3px; font-size: 12px; letter-spacing: .2px; color: var(--graphite); }
  .ag-desc { margin: 14px 0 0; padding: 0 12px; font-size: 12px; line-height: 17px; color: var(--graphite); text-align: center; }
  .ag-err { align-self: stretch; display: flex; align-items: center; gap: 8px; margin-top: 14px; padding: 9px 12px; border-radius: 10px; background: rgba(200,80,80,.10); border: 1px solid rgba(200,80,80,.25); color: var(--rose-500, #c0392b); font-size: 12px; font-weight: 600; line-height: 16px; }
  .ag-err.is-off { display: none; }
  .ag-btn-danger { align-self: stretch; min-height: 46px; margin-top: 20px; border: 0; border-radius: 100px; background: var(--rose-500, #c0392b); color: var(--cream); font-size: 14px; font-weight: 600; display: flex; align-items: center; justify-content: center; }
  .ag-btn-danger[disabled] { opacity: .6; }
  .ag-btn-ghost { align-self: stretch; margin-top: 8px; padding: 12px; border: 0; border-radius: 100px; background: transparent; color: var(--graphite); font-size: 13px; font-weight: 600; }
  .ag-btn-ghost:hover { background: var(--sand); }
  .ag-spin { width: 18px; height: 18px; border-radius: 50%; border: 2.5px solid rgba(250,250,246,.35); border-top-color: var(--cream); animation: agspin .8s linear infinite; }
  @keyframes agspin { to { transform: rotate(360deg); } }

  /* Avaliar (porte da ReviewScreen) */
  .rv { max-width: 560px; margin: 0 auto; padding-bottom: 48px; }
  .rv-head { display: flex; align-items: center; padding: 8px 16px; }
  .rv-back { flex: 0 0 40px; height: 40px; border: 0; border-radius: 50%; background: var(--sand); color: var(--ink); display: flex; align-items: center; justify-content: center; }
  .rv-back:hover { background: var(--stone); }
  .rv-hc { flex: 1; text-align: center; }
  .rv-hc small { display: block; font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 2px; color: var(--coral-500); }
  .rv-hc h1 { margin: 2px 0 0 !important; font-family: 'Space Grotesk', sans-serif !important; font-weight: 700; font-size: 18px; letter-spacing: -0.3px; color: var(--ink) !important; }
  .rv-body { padding: 18px; }
  .rv-card { margin-bottom: 24px; padding: 16px; background: var(--paper); border: 1px solid var(--stone); border-radius: 16px; box-shadow: 0 6px 18px -14px rgba(40,35,28,.4); }
  .rv-lab { margin-bottom: 6px; font-family: 'JetBrains Mono', monospace; font-size: 9px; letter-spacing: 1.5px; color: var(--ash); }
  .rv-name { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 18px; letter-spacing: -0.3px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .rv-div { height: 1px; background: var(--stone); margin: 14px 0; }
  .rv-row { display: flex; align-items: center; }
  .rv-item { flex: 1; min-width: 0; }
  .rv-item b { display: block; font-size: 13px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .rv-sep { width: 1px; height: 28px; background: var(--stone); margin: 0 12px; }
  .rv-sec { margin-bottom: 8px; font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 1.8px; color: var(--ash); }
  .rv-help { margin: -2px 0 12px; font-size: 11px; color: var(--graphite); }
  .rv-stars { display: flex; justify-content: center; gap: 6px; padding: 10px 0; margin-bottom: 6px; }
  .rv-star { border: 0; background: transparent; padding: 6px; color: var(--stone); transition: transform .15s, color .15s; }
  .rv-star:hover { transform: scale(1.12); }
  .rv-star.is-on { color: var(--coral-500); }
  .rv-star.is-on svg { fill: currentColor; }
  .rv-rlab { min-height: 18px; text-align: center; font-size: 14px; font-weight: 600; letter-spacing: .5px; color: var(--coral-700); }
  .rv-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 4px; }
  .rv-tag { display: inline-flex; align-items: center; gap: 5px; padding: 9px 14px; border-radius: 100px; background: var(--paper); border: 1px solid var(--stone); color: var(--graphite); font-size: 12px; font-weight: 600; transition: background .15s, border-color .15s; }
  .rv-tag:hover { border-color: var(--ink); }
  .rv-tag.is-on { background: var(--coral-500); border-color: var(--coral-500); color: var(--cream); }
  .rv-comment { padding: 14px; background: var(--paper); border: 1px solid var(--stone); border-radius: 14px; transition: border-color .15s, box-shadow .15s; }
  .rv-comment:focus-within { border-color: var(--coral-500); box-shadow: 0 0 0 4px rgba(221,120,82,.14); }
  .rv-comment textarea { display: block; width: 100%; min-height: 90px; padding: 0; border: 0 !important; outline: none; resize: vertical; background: transparent !important; box-shadow: none !important; font: inherit; font-size: 14px; line-height: 20px; color: var(--ink); }
  .rv-count { margin-top: 8px; text-align: right; font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--ash); }
  .rv-count.is-warn { color: var(--amber-500, #c98a1a); }
  .rv-send { width: 100%; display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 28px; padding: 15px; border: 0; border-radius: 100px; background: var(--coral-500); color: var(--cream); font-size: 14px; font-weight: 600; transition: opacity .15s; }
  .rv-send[disabled] { opacity: .4; cursor: default; }
  .rv-note { margin: 16px 0 0; padding: 0 12px; text-align: center; font-size: 11px; line-height: 16px; color: var(--ash); }

  .ag-toast { position: fixed; left: 16px; right: 16px; bottom: calc(24px + env(safe-area-inset-bottom, 0px)); z-index: 70; max-width: 440px; margin: 0 auto; display: flex; align-items: center; gap: 10px; padding: 13px; border-radius: 14px; border: 1px solid var(--coral-100); background: var(--coral-50); color: var(--coral-700); font-size: 12.5px; font-weight: 600; box-shadow: 0 14px 36px -16px rgba(40,35,28,.45); transform: translateY(16px); opacity: 0; pointer-events: none; transition: opacity .2s, transform .2s; }
  .ag-toast.is-on { opacity: 1; transform: none; }
  .ag-toast.is-err { background: #fdecec; border-color: #f5cccc; color: var(--rose-500, #c0392b); }

  @media (min-width: 720px) {
    .ag-head { padding: 36px 32px 24px; }
    .ag-title { font-size: 44px; letter-spacing: -1.4px; }
    .ag-tabs { margin: 0 32px 24px; max-width: 420px; }
    .ag-list { padding: 4px 32px 64px; }
    .ag-cards { grid-template-columns: repeat(auto-fill, minmax(min(380px, 100%), 1fr)); gap: 14px; }
    .ag-sheet-bg { align-items: center; }
    .ag-sheet { border-radius: 24px; padding-top: 22px; }
    .ag-handle { display: none; }
  }
  @media (min-width: 1100px) {
    .ag-split { display: grid; grid-template-columns: 340px minmax(0, 1fr); gap: 24px; align-items: start; padding: 0 32px; }
    .ag-side { position: sticky; top: 84px; padding-top: 24px; }
    .ag-side .ag-head { padding: 0 0 24px; }
    .ag-side .ag-tabs { margin: 0; }
    .ag-side-extra { display: block; margin-top: 20px; padding: 18px; background: var(--paper); border: 1px solid var(--stone); border-radius: 18px; }
    .ag-side-extra .ag-eyebrow { margin-bottom: 8px; }
    .ag-next b { display: block; font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 22px; letter-spacing: -0.5px; }
    .ag-next small { display: block; margin-top: 2px; font-size: 13px; color: var(--graphite); }
    .ag-new { display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 16px; padding: 13px; border-radius: 100px; background: var(--coral-500); color: var(--cream) !important; font-size: 14px; font-weight: 600; }
    .ag-list { padding: 24px 0 64px; }
  }
</style>

<div class="ag" id="ag">
  <section class="ag-view is-on" id="ag-main">
    <div class="ag-wrap ag-split">
      <div class="ag-side">
        <div class="ag-head">
          <div class="ag-eyebrow">Histórico</div>
          <h1 class="ag-title">Meus agendamentos</h1>
        </div>
        <div class="ag-tabs" role="tablist">
          <button type="button" role="tab" data-tab="proximos" aria-selected="true">Próximos<small id="ag-n-up"></small></button>
          <button type="button" role="tab" data-tab="passados" aria-selected="false">Anteriores<small id="ag-n-past"></small></button>
        </div>
        <div class="ag-side-extra" id="ag-side-extra"></div>
      </div>
      <div class="ag-list" id="ag-list"></div>
    </div>
    <%= render "shared/site_footer", audience: :client %>
  </section>

  <section class="ag-view" id="ag-review"></section>

  <div class="ag-sheet-bg" id="ag-cancel" aria-hidden="true">
    <div class="ag-sheet" role="dialog" aria-modal="true" aria-labelledby="ag-cancel-t">
      <div class="ag-handle"></div>
      <div class="ag-sheet-ic"><i data-feather="x-circle" style="width:22px;height:22px"></i></div>
      <h2 id="ag-cancel-t">Cancelar agendamento?</h2>
      <div class="ag-sum"><b id="ag-cancel-shop"></b><small id="ag-cancel-when"></small></div>
      <p class="ag-desc">O horário será liberado e esta ação não pode ser desfeita.</p>
      <div class="ag-err is-off" id="ag-cancel-err"></div>
      <button type="button" class="ag-btn-danger" id="ag-cancel-go">Cancelar agendamento</button>
      <button type="button" class="ag-btn-ghost" id="ag-cancel-back">Voltar</button>
    </div>
  </div>

  <div class="ag-toast" id="ag-toast" role="status" aria-live="polite"></div>
</div>

<script>
(function () {
  var DATA  = <%= raw json_escape(@payload.to_json) %>;
  var FLASH = <%= raw json_escape({ notice: flash[:notice], alert: flash[:alert] }.to_json) %>;
  var CSRF  = (document.querySelector('meta[name="csrf-token"]') || {}).content;
  var HOME  = '/' + location.search;

  var MONTHS = ['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];
  var WD = ['dom','seg','ter','qua','qui','sex','sáb'];
  var WD_CAP = ['Dom','Seg','Ter','Qua','Qui','Sex','Sáb'];
  // Próximos = confirmados; Anteriores = só os que o dono marcou "compareceu".
  // cancelled/no_show/rejected/expired ficam de fora, como no app.
  var ACTIVE = ['confirmed'], HISTORY = ['attended'];
  var TAGS_BY_RATING = {
    1: ['Demorou muito', 'Serviço ruim', 'Atendimento ruim'],
    2: ['Demorou muito', 'Serviço ruim', 'Atendimento ruim'],
    3: ['Podia ser melhor', 'OK mas não voltaria'],
    4: ['Rápido', 'Bem atendido', 'Ótimo serviço', 'Recomendaria'],
    5: ['Rápido', 'Bem atendido', 'Ótimo serviço', 'Recomendaria']
  };
  var RATING_LABELS = { 1: 'Péssimo', 2: 'Ruim', 3: 'Regular', 4: 'Bom', 5: 'Excelente' };
  var MAX_TAGS = 3, MAX_COMMENT = 500;

  function $(id) { return document.getElementById(id); }
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
  function icon(n, size, extra) { return window.feather && feather.icons[n] ? feather.icons[n].toSvg(Object.assign({ width: size, height: size }, extra || {})) : ''; }
  function hm(iso) { var d = new Date(iso); return String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0'); }
  function sameDay(a, b) { return a.getFullYear() === b.getFullYear() && a.getMonth() === b.getMonth() && a.getDate() === b.getDate(); }
  function sectionTitle(d) {
    var now = new Date(), tm = new Date(now); tm.setDate(now.getDate() + 1);
    if (sameDay(d, now)) return 'Hoje';
    if (sameDay(d, tm)) return 'Amanhã';
    return WD[d.getDay()] + ' · ' + d.getDate() + ' ' + MONTHS[d.getMonth()];
  }
  // Horário + duração + 15 min de tolerância passou → sai de Próximos.
  function isPast(a) {
    var t = new Date(a.scheduled_at).getTime();
    if (!isFinite(t)) return false;
    return t + ((Number(a.service && a.service.duration) || 30) + 15) * 60000 < Date.now();
  }
  // Cancelar: só confirmado, não Last Minute, com mais de 2 h de antecedência.
  function canCancel(a) {
    if (!a || a.status !== 'confirmed' || a.appointment_type === 'disponivel') return false;
    var t = new Date(a.scheduled_at).getTime();
    return isFinite(t) && (t - Date.now()) / 60000 > 120;
  }
  function hasCoords(cw) { var la = Number(cw && cw.latitude), lo = Number(cw && cw.longitude); return isFinite(la) && isFinite(lo) && la !== 0 && lo !== 0; }
  function routeUrl(cw) {
    var dest = hasCoords(cw) ? cw.latitude + ',' + cw.longitude : (cw && cw.address ? encodeURIComponent(cw.address) : null);
    return dest ? 'https://www.google.com/maps/dir/?api=1&destination=' + dest : null;
  }
  function money2(v) { return 'R$ ' + (Number(v) || 0).toFixed(2).replace('.', ','); }

  var state = { tab: 'proximos', pending: null, cancelling: false, review: null };

  function lists() {
    var up = DATA.filter(function (a) { return ACTIVE.indexOf(a.status) !== -1 && !isPast(a); })
      .sort(function (a, b) { return new Date(a.scheduled_at) - new Date(b.scheduled_at); });
    var past = DATA.filter(function (a) { return HISTORY.indexOf(a.status) !== -1 || (ACTIVE.indexOf(a.status) !== -1 && isPast(a)); })
      .sort(function (a, b) { return new Date(b.scheduled_at) - new Date(a.scheduled_at); });
    return { up: up, past: past };
  }

  function card(a) {
    var d = new Date(a.scheduled_at), cw = a.car_wash || {}, s = a.service || {};
    var lm = a.appointment_type === 'disponivel';
    var today = sameDay(d, new Date()) && !isPast(a);
    var active = a.status === 'confirmed' && !isPast(a);
    var route = routeUrl(cw), out = '';
    out += '<article class="ag-card' + (today ? ' is-today' : '') + '">' +
      '<div class="ag-top">' +
        '<div class="ag-time"><b>' + hm(a.scheduled_at) + '</b>' + (s.duration ? '<small>' + s.duration + 'MIN</small>' : '') + '</div>' +
        '<div class="ag-mid"><div class="ag-shoprow"><a class="ag-shop" href="/car_washes/' + cw.id + location.search + '">' + esc(cw.name || 'Lava-rápido') + '</a>' +
          (lm ? '<span class="ag-lm">' + icon('zap', 9) + 'LAST MINUTE</span>' : '') + '</div>' +
          '<div class="ag-svc">' + esc(s.title || 'Serviço') + '</div></div>' +
        '<div class="ag-money"><div class="ag-price">' + money2(s.price) + '</div><div class="ag-id">LV-' + String(a.id).padStart(4, '0') + '</div></div>' +
      '</div>';
    // Código de chegada: a frase de instrução só quando é hoje (é quando age).
    if (active && a.phone_last4) {
      out += '<div class="ag-foot"><span class="ag-code">' + icon('shield', 12) + esc(a.phone_last4) + '</span>' +
        '<span class="ag-hint">' + (today ? 'Passe na chegada' : 'Código de chegada') + '</span>' +
        (route ? '<a class="ag-route" target="_blank" rel="noopener" href="' + route + '">' + icon('navigation', 12) + 'Rota</a>' : '') + '</div>';
    }
    if (a.status === 'attended' && a.reviewed && a.review && a.review.rating) {
      var st = '';
      for (var n = 1; n <= 5; n++) st += icon('star', 13, { color: n <= a.review.rating ? 'var(--coral-500)' : 'var(--stone)', fill: n <= a.review.rating ? 'var(--coral-500)' : 'none' });
      out += '<div class="ag-foot"><span class="ag-stars">' + st + '</span><span class="ag-hint is-quiet">sua avaliação</span></div>';
    }
    if (a.status === 'attended' && !a.reviewed) {
      var bt = '';
      for (var k = 1; k <= 5; k++) bt += '<button type="button" class="ag-star" data-rate="' + a.id + '" data-n="' + k + '" aria-label="' + k + (k === 1 ? ' estrela' : ' estrelas') + '">' + icon('star', 18) + '</button>';
      out += '<div class="ag-foot"><span class="ag-rate-l">Como foi?</span><span class="ag-stars">' + bt + '</span></div>';
    }
    if (canCancel(a)) out += '<button type="button" class="ag-cancel" data-cancel="' + a.id + '">Cancelar agendamento</button>';
    return out + '</article>';
  }

  function render() {
    var L = lists(), list = state.tab === 'proximos' ? L.up : L.past;
    $('ag-n-up').textContent = L.up.length ? L.up.length : '';
    $('ag-n-past').textContent = L.past.length ? L.past.length : '';
    document.querySelectorAll('.ag-tabs button').forEach(function (b) { b.setAttribute('aria-selected', b.dataset.tab === state.tab ? 'true' : 'false'); });

    var nx = L.up[0];
    $('ag-side-extra').innerHTML = nx
      ? '<div class="ag-eyebrow">Próximo</div><div class="ag-next"><b>' + sectionTitle(new Date(nx.scheduled_at)).replace(/^./, function (c) { return c.toUpperCase(); }) + ', ' + hm(nx.scheduled_at) + '</b><small>' + esc(nx.car_wash && nx.car_wash.name) + '</small></div>' +
        '<a class="ag-new" href="' + HOME + '">' + icon('plus', 16) + 'Agendar outra lavagem</a>'
      : '<div class="ag-eyebrow">Nada marcado</div><div class="ag-next"><small>Escolha um lava-rápido perto de você e reserve em poucos toques.</small></div>' +
        '<a class="ag-new" href="' + HOME + '">' + icon('search', 16) + 'Encontrar lava-rápido</a>';

    if (!list.length) {
      $('ag-list').innerHTML = state.tab === 'proximos'
        ? '<div class="ag-empty"><img src="/illustrations/agenda-vazia.svg" alt="Ilustração de um calendário vazio com um dia marcado e um passarinho pousado"><h2>Nenhum agendamento próximo</h2><p>Quando você reservar uma lavagem, ela aparece aqui com dia, hora e lava-rápido.</p><a href="' + HOME + '">Encontrar lava-rápido</a></div>'
        : '<div class="ag-empty"><h2>Sem anteriores</h2><p>Atendimentos concluídos aparecem nesta aba.</p></div>';
      return;
    }
    var groups = [];
    list.forEach(function (a) {
      var d = new Date(a.scheduled_at), key = d.toDateString(), last = groups[groups.length - 1];
      if (last && last.key === key) last.items.push(a); else groups.push({ key: key, title: sectionTitle(d), items: [a] });
    });
    $('ag-list').innerHTML = groups.map(function (g) {
      return '<h2 class="ag-day">' + esc(g.title) + '</h2><div class="ag-cards">' + g.items.map(card).join('') + '</div>';
    }).join('');
  }

  // ── Dados: polling de 20 s com recuo (até 2 min) se falhar ───────────────
  var wait = 20000, timer = null;
  function poll() {
    fetch('/appointments.json', { credentials: 'same-origin', headers: { Accept: 'application/json' } })
      .then(function (r) { if (!r.ok) throw 0; return r.json(); })
      .then(function (d) { if (Array.isArray(d)) { DATA = d; if (!state.review) render(); } wait = 20000; })
      .catch(function () { wait = Math.min(120000, wait * 2); })
      .then(function () { timer = setTimeout(poll, wait); });
  }
  // Re-render a cada 30 s: um horário que passa do limite muda de aba sozinho.
  setInterval(function () { if (!state.review) render(); }, 30000);

  // ── Toast ────────────────────────────────────────────────────────────────
  var toastT = null;
  function toast(text, err) {
    var t = $('ag-toast');
    t.className = 'ag-toast is-on' + (err ? ' is-err' : '');
    t.innerHTML = icon(err ? 'x-circle' : 'check-circle', 14) + '<span>' + esc(text) + '</span>';
    clearTimeout(toastT); toastT = setTimeout(function () { t.className = 'ag-toast' + (err ? ' is-err' : ''); }, 3500);
  }

  // ── Cancelar ─────────────────────────────────────────────────────────────
  function openCancel(id) {
    var a = DATA.filter(function (x) { return x.id === id; })[0]; if (!a) return;
    state.pending = a; state.cancelling = false;
    var d = new Date(a.scheduled_at);
    $('ag-cancel-shop').textContent = (a.car_wash && a.car_wash.name) || 'Lava-rápido';
    $('ag-cancel-when').textContent = WD[d.getDay()] + ' ' + d.getDate() + ' ' + MONTHS[d.getMonth()] + ' · ' + hm(a.scheduled_at);
    setCancelErr(null); setCancelBusy(false);
    var s = $('ag-cancel'); s.classList.add('is-on'); s.setAttribute('aria-hidden', 'false');
    $('ag-cancel-back').focus();
  }
  function closeCancel() {
    if (state.cancelling) return;
    state.pending = null;
    var s = $('ag-cancel'); s.classList.remove('is-on'); s.setAttribute('aria-hidden', 'true');
  }
  function setCancelErr(msg) { var e = $('ag-cancel-err'); e.classList.toggle('is-off', !msg); e.innerHTML = msg ? icon('alert-circle', 13) + '<span>' + esc(msg) + '</span>' : ''; }
  function setCancelBusy(b) { var g = $('ag-cancel-go'); g.disabled = b; g.innerHTML = b ? '<span class="ag-spin"></span>' : 'Cancelar agendamento'; $('ag-cancel-back').disabled = b; }
  function confirmCancel() {
    var a = state.pending; if (!a || state.cancelling) return;
    state.cancelling = true; setCancelBusy(true); setCancelErr(null);
    fetch('/appointments/' + a.id + '/cancel', { method: 'DELETE', credentials: 'same-origin', headers: { Accept: 'application/json', 'X-CSRF-Token': CSRF } })
      .then(function (r) { return r.text().then(function (t) { var d = {}; try { d = JSON.parse(t); } catch (e) {} return { ok: r.ok, status: r.status, data: d }; }); })
      .then(function (res) {
        state.cancelling = false; setCancelBusy(false);
        if (!res.ok) { setCancelErr(res.data.error || 'Não foi possível cancelar (erro ' + res.status + ').'); return; }
        a.status = 'cancelled'; closeCancel(); render(); toast('Agendamento cancelado. O horário foi liberado.');
      })
      .catch(function () { state.cancelling = false; setCancelBusy(false); setCancelErr('Erro de conexão. Tente novamente.'); });
  }

  // ── Avaliar (tela própria, com o voltar do navegador) ────────────────────
  function openReview(id, n, push) {
    var a = DATA.filter(function (x) { return x.id === id; })[0];
    if (!a || a.status !== 'attended' || a.reviewed) return;
    state.review = { a: a, rating: n || 0, tags: [], comment: '', sending: false };
    if (push) history.pushState({ v: 'review', id: id, n: n }, '', '#avaliar-' + id);
    $('ag-main').classList.remove('is-on'); $('ag-review').classList.add('is-on');
    window.scrollTo(0, 0);
    renderReview();
  }
  function closeReview() {
    state.review = null;
    $('ag-review').classList.remove('is-on'); $('ag-main').classList.add('is-on');
    render();
  }
  function renderReview() {
    var r = state.review, a = r.a, d = new Date(a.scheduled_at);
    var stars = '';
    for (var n = 1; n <= 5; n++) stars += '<button type="button" class="rv-star' + (n <= r.rating ? ' is-on' : '') + '" data-rv-star="' + n + '" aria-label="' + n + (n === 1 ? ' estrela' : ' estrelas') + '">' + icon('star', 36) + '</button>';
    var tags = (TAGS_BY_RATING[r.rating] || []).map(function (t) {
      var on = r.tags.indexOf(t) !== -1;
      return '<button type="button" class="rv-tag' + (on ? ' is-on' : '') + '" data-rv-tag="' + esc(t) + '" aria-pressed="' + on + '">' + (on ? icon('check', 11) : '') + esc(t) + '</button>';
    }).join('');
    $('ag-review').innerHTML = '<div class="rv">' +
      '<div class="rv-head"><button type="button" class="rv-back" data-rv-back aria-label="Voltar">' + icon('chevron-left', 18) + '</button>' +
        '<div class="rv-hc"><small>FEEDBACK</small><h1>Avaliar atendimento</h1></div><span style="width:40px"></span></div>' +
      '<div class="rv-body">' +
        '<div class="rv-card"><div class="rv-lab">VOCÊ FOI ATENDIDO EM</div><div class="rv-name">' + esc(a.car_wash && a.car_wash.name || 'Lava-rápido') + '</div>' +
          '<div class="rv-div"></div><div class="rv-row">' +
            '<div class="rv-item"><div class="rv-lab">SERVIÇO</div><b>' + esc(a.service && a.service.title || 'Serviço') + '</b></div><div class="rv-sep"></div>' +
            '<div class="rv-item"><div class="rv-lab">DATA</div><b>' + WD_CAP[d.getDay()] + ', ' + d.getDate() + ' de ' + MONTHS[d.getMonth()] + '</b></div>' +
          '</div></div>' +
        '<div class="rv-sec">SUA AVALIAÇÃO</div>' +
        '<div class="rv-stars">' + stars + '</div>' +
        '<div class="rv-rlab">' + (r.rating ? RATING_LABELS[r.rating] : 'Toque nas estrelas') + '</div>' +
        (r.rating ? '<div class="rv-sec" style="margin-top:28px">COMO FOI O ATENDIMENTO?</div><div class="rv-help">Selecione até ' + MAX_TAGS + ' opções</div><div class="rv-tags">' + tags + '</div>' +
          '<div class="rv-sec" style="margin-top:24px">COMENTÁRIO (OPCIONAL)</div>' +
          '<div class="rv-comment"><textarea id="rv-text" maxlength="' + MAX_COMMENT + '" placeholder="Conte mais sobre sua experiência…">' + esc(r.comment) + '</textarea>' +
          '<div class="rv-count' + (r.comment.length > MAX_COMMENT * 0.9 ? ' is-warn' : '') + '" id="rv-count">' + r.comment.length + '/' + MAX_COMMENT + '</div></div>' : '') +
        '<button type="button" class="rv-send" data-rv-send' + (!r.rating || r.sending ? ' disabled' : '') + '>' + (r.sending ? '<span class="ag-spin"></span>' : icon('send', 14) + 'Enviar avaliação') + '</button>' +
        '<p class="rv-note">Sua avaliação ajuda outros clientes e o lava-rápido a melhorar.</p>' +
      '</div></div>';
  }
  function sendReview() {
    var r = state.review; if (!r || !r.rating || r.sending) return;
    r.sending = true; renderReview();
    fetch('/client/reviews', {
      method: 'POST', credentials: 'same-origin',
      headers: { Accept: 'application/json', 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
      body: JSON.stringify({ appointment_id: r.a.id, rating: r.rating, tags: r.tags, comment: r.comment.trim() || null })
    }).then(function (res) { return res.json().catch(function () { return {}; }); })
      .then(function (data) {
        if (data.ok) {
          r.a.reviewed = true; r.a.review = { rating: r.rating, tags: r.tags };
          history.back(); // fecha a tela de avaliação pelo próprio histórico
          toast('Avaliação enviada! Obrigado pelo feedback.');
          return;
        }
        r.sending = false; renderReview(); toast(data.error || 'Erro ao enviar avaliação.', true);
      })
      .catch(function () { r.sending = false; renderReview(); toast('Erro de conexão. Tente novamente.', true); });
  }

  window.addEventListener('popstate', function (e) {
    var st = e.state || {};
    if (st.v === 'review') openReview(st.id, st.n, false);
    else if (state.review) closeReview();
  });

  document.addEventListener('click', function (e) {
    var t;
    if ((t = e.target.closest('.ag-tabs button'))) { state.tab = t.dataset.tab; render(); return; }
    if ((t = e.target.closest('[data-cancel]'))) { openCancel(Number(t.dataset.cancel)); return; }
    if ((t = e.target.closest('[data-rate]'))) { openReview(Number(t.dataset.rate), Number(t.dataset.n), true); return; }
    if (e.target.closest('#ag-cancel-go')) { confirmCancel(); return; }
    if (e.target.closest('#ag-cancel-back') || e.target.id === 'ag-cancel') { closeCancel(); return; }
    if (!state.review) return;
    if (e.target.closest('[data-rv-back]')) { history.back(); return; }
    if ((t = e.target.closest('[data-rv-star]'))) { state.review.rating = Number(t.dataset.rvStar); state.review.tags = []; renderReview(); return; }
    if ((t = e.target.closest('[data-rv-tag]'))) {
      var tag = t.dataset.rvTag, tags = state.review.tags, i = tags.indexOf(tag);
      if (i !== -1) tags.splice(i, 1); else if (tags.length < MAX_TAGS) tags.push(tag);
      renderReview(); return;
    }
    if (e.target.closest('[data-rv-send]')) { sendReview(); return; }
  });
  document.addEventListener('input', function (e) {
    if (e.target.id !== 'rv-text' || !state.review) return;
    state.review.comment = e.target.value.slice(0, MAX_COMMENT);
    var c = $('rv-count'); c.textContent = state.review.comment.length + '/' + MAX_COMMENT;
    c.classList.toggle('is-warn', state.review.comment.length > MAX_COMMENT * 0.9);
  });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeCancel(); });

  function boot() {
    if (window.feather) feather.replace();
    render();
    if (FLASH.notice) toast(FLASH.notice); else if (FLASH.alert) toast(FLASH.alert, true);
    var m = location.hash.match(/^#avaliar-(\d+)/);
    history.replaceState({ v: 'list' }, '', location.pathname + location.search);
    if (m) openReview(Number(m[1]), 0, true);
    timer = setTimeout(poll, 20000);
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot); else boot();
})();
</script>
