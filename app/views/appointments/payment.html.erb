<% Rails.logger.info("Iniciando renderização do template payment.html.erb") %>

<style>
  .pay-card-stripe {
    background: var(--paper);
    border: 1px solid var(--stone);
    border-radius: 12px;
    padding: 14px 16px;
    transition: border-color .15s ease;
  }
  .pay-card-stripe:focus-within { border-color: var(--coral-500); }
  #card-errors { color: var(--rose-500); font-size: 12.5px; margin-top: 8px; min-height: 16px; }
  .pay-summary-row { display:flex; align-items:center; gap:12px; padding:12px 0; border-bottom:1px solid var(--stone); }
  .pay-summary-row:last-child { border-bottom:none; }
  .pay-summary-row i { color: var(--coral-500); width: 18px; text-align:center; }
  .pay-summary-label { font-family:'JetBrains Mono', monospace; font-size:11px; letter-spacing:1.4px; color:var(--graphite); text-transform:uppercase; min-width: 110px; }
  .pay-summary-value { color: var(--ink); font-weight: 500; font-size: 14.5px; }
</style>

<div class="loov-page loov-page--narrow">

  <div class="loov-hero">
    <div class="loov-eyebrow"><span class="dot"></span>PAGAMENTO SEGURO</div>
    <h1 class="loov-h1">Finalizar <span class="accent">agendamento</span>.</h1>
    <p class="loov-lead">Confirme os detalhes e pague para garantir seu horário.</p>
  </div>

  <div class="loov-card loov-card--lg" style="margin-bottom:20px;">
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:18px;">
      <div class="loov-card-icon"><i class="fas fa-receipt"></i></div>
      <h2 class="loov-h2" style="font-size:22px;">Detalhes</h2>
    </div>

    <div class="pay-summary-row">
      <i class="fas fa-car-wash"></i>
      <span class="pay-summary-label">Lava-rápido</span>
      <span class="pay-summary-value"><%= @appointment.car_wash.name %></span>
    </div>
    <div class="pay-summary-row">
      <i class="fas fa-tools"></i>
      <span class="pay-summary-label">Serviço</span>
      <span class="pay-summary-value"><%= @appointment.service.title %></span>
    </div>
    <div class="pay-summary-row">
      <i class="fas fa-clock"></i>
      <span class="pay-summary-label">Data</span>
      <span class="pay-summary-value"><%= @appointment.scheduled_at.strftime("%d/%m/%Y às %H:%M") %></span>
    </div>
    <div class="pay-summary-row">
      <i class="fas fa-money-bill-wave"></i>
      <span class="pay-summary-label">Preço</span>
      <span class="pay-summary-value" style="color:var(--coral-700);font-weight:700;">R$ <%= @appointment.service.price.to_f.round(2) %></span>
    </div>
  </div>

  <div class="loov-card loov-card--lg">
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:18px;">
      <div class="loov-card-icon"><i class="fas fa-credit-card"></i></div>
      <h2 class="loov-h2" style="font-size:22px;">Pagamento</h2>
    </div>

    <%= form_with url: process_payment_appointment_path(id: 'new'), method: :post, local: true, id: "payment-form" do %>
      <div class="loov-field">
        <label class="loov-label">Detalhes do cartão</label>
        <div id="card-element" class="pay-card-stripe"></div>
        <div id="card-errors" role="alert"></div>
      </div>
      <%= submit_tag "Pagar e Confirmar", class: "loov-btn-primary loov-btn-block loov-btn-lg", id: "submit-payment", data: { disable_with: "Processando..." } %>
    <% end %>
  </div>
</div>

<script src="https://js.stripe.com/v3/"></script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const stripePublishableKey = '<%= Rails.application.credentials.stripe[:publishable_key] %>';
    if (!stripePublishableKey) {
      console.error("Chave de publicação do Stripe não encontrada.");
      document.getElementById('card-errors').textContent = 'Erro: Chave de publicação do Stripe não configurada.';
      return;
    }
    const stripe = Stripe(stripePublishableKey);
    const elements = stripe.elements();
    const card = elements.create('card', {
      style: {
        base: {
          color: '#28231c',
          fontFamily: 'Inter, sans-serif',
          fontSize: '15px',
          '::placeholder': {
            color: '#ada699',
          },
        },
        invalid: {
          color: '#c85050',
        },
      },
      hidePostalCode: true
    });
    const cardElement = document.getElementById('card-element');
    if (cardElement) {
      card.mount('#card-element');
    } else {
      console.error("Elemento #card-element não encontrado na página.");
      return;
    }

    const form = document.getElementById('payment-form');
    const submitButton = document.getElementById('submit-payment');
    const cardErrors = document.getElementById('card-errors');

    if (!form || !submitButton || !cardErrors) {
      console.error("Elementos do formulário não encontrados:", { form, submitButton, cardErrors });
      return;
    }

    cardErrors.textContent = '';

    const clientSecret = '<%= @appointment.payment_intent_client_secret %>';
    if (!clientSecret) {
      console.error("Client Secret não encontrado.");
      cardErrors.textContent = 'Erro: Client Secret não disponível. Tente novamente.';
      submitButton.disabled = true;
      return;
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      submitButton.disabled = true;
      cardErrors.textContent = '';

      try {
        const { paymentIntent, error } = await stripe.confirmCardPayment(clientSecret, {
          payment_method: {
            card: card,
            billing_details: {
              address: {
                postal_code: null
              }
            }
          }
        });

        if (error) {
          console.error("Erro no Stripe:", error);
          cardErrors.textContent = error.message || 'Erro ao processar o pagamento. Tente novamente.';
          submitButton.disabled = false;
        } else if (paymentIntent.status === 'succeeded') {
          form.submit();
        } else {
          cardErrors.textContent = 'Pagamento não foi concluído. Status: ' + paymentIntent.status;
          submitButton.disabled = false;
        }
      } catch (e) {
        console.error("Exceção capturada:", e);
        cardErrors.textContent = e.message || 'Erro ao processar o pagamento. Tente novamente.';
        submitButton.disabled = false;
      }
    });
  });
</script>
<% Rails.logger.info("Template payment.html.erb renderizado com sucesso") %>
