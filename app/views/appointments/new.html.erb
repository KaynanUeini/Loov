<% Rails.logger.info("Renderizando appointments/new.html.erb: @car_wash=#{@car_wash.inspect}") %>
<script>
  window.carWashId = <%= @car_wash.id %>;
  window.operatingHours = <%= @car_wash.operating_hours.map { |oh| { day_of_week: oh.day_of_week, opens_at: (oh.opens_at.hour * 60 + oh.opens_at.min), closes_at: (oh.closes_at.hour * 60 + oh.closes_at.min) } }.to_json.html_safe %>;
  window.capacityPerSlot = <%= @car_wash.capacity_per_slot %>;
  window.carWashName = "<%= @car_wash.name %>";
  window.carWashAddress = "<%= @car_wash.address %>";
</script>

<style>
  .appt-back { margin-bottom:14px; }
  .appt-back a {
    display:inline-flex; align-items:center; gap:8px;
    font-family:'JetBrains Mono', monospace; font-size:11.5px; letter-spacing:1.4px; text-transform:uppercase;
    color:var(--graphite); text-decoration:none; transition:color .15s ease;
  }
  .appt-back a:hover { color:var(--coral-700); }

  .appt-flash { margin-bottom:18px; }
  .appt-flash-msg { display:flex; align-items:center; gap:10px; padding:13px 18px; border-radius:12px; font-size:13.5px; margin-bottom:10px; }
  .appt-flash-msg.error   { background:#fdecec; border:1px solid #f5cccc; color:var(--rose-500); }
  .appt-flash-msg.success { background:var(--coral-50); border:1px solid var(--coral-100); color:var(--coral-700); }

  .appt-screen { transition: opacity .35s ease, transform .35s ease; }
  .appt-screen.hidden { display:none; }

  .appt-steps { display:flex; align-items:center; gap:10px; margin-bottom:32px; }
  .appt-step { display:flex; align-items:center; gap:8px; font-family:'JetBrains Mono', monospace; font-size:11px; font-weight:600; letter-spacing:1.4px; text-transform:uppercase; color:var(--ash); transition:color .2s ease; }
  .appt-step-num { width:24px; height:24px; border-radius:50%; border:1px solid var(--stone); display:flex; align-items:center; justify-content:center; font-size:11px; font-weight:700; flex-shrink:0; transition:all .2s ease; background:var(--paper); }
  .appt-step.active { color:var(--ink); }
  .appt-step.active .appt-step-num { background:var(--coral-500); color:var(--cream); border-color:var(--coral-500); }
  .appt-step.done { color:var(--coral-700); }
  .appt-step.done .appt-step-num { background:transparent; color:var(--coral-500); border-color:var(--coral-500); }
  .appt-step-divider { flex:1; height:1px; background:var(--stone); }

  .appt-field { margin-bottom:24px; }
  .appt-field-label { display:flex; align-items:center; gap:8px; font-family:'JetBrains Mono', monospace; font-size:11px; font-weight:600; letter-spacing:1.4px; color:var(--graphite); margin-bottom:10px; text-transform:uppercase; }
  .appt-field-label i { color:var(--coral-500); font-size:11px; }

  .field-locked-wrap { opacity:.4; pointer-events:none; transition:opacity .25s ease; }
  .field-locked-wrap.unlocked { opacity:1; pointer-events:auto; }

  .field-hint { display:none; align-items:center; gap:8px; font-size:12.5px; color:var(--graphite); margin-top:8px; padding:10px 14px; background:var(--cream); border:1px dashed var(--stone); border-radius:10px; }
  .appt-field.locked .field-hint { display:flex; }

  .appt-input {
    width:100%; background:var(--paper); border:1px solid var(--stone);
    border-radius:12px; padding:14px 16px;
    font-family:'Inter', sans-serif; font-size:14.5px; color:var(--ink);
    transition:all .2s ease; outline:none; appearance:none;
  }
  .appt-input::placeholder { color:var(--ash); }
  .appt-input:focus { border-color:var(--coral-500); box-shadow:0 0 0 3px rgba(220,120,82,.08); }

  .service-cards { display:flex; flex-direction:column; gap:10px; }
  .service-card {
    display:flex; align-items:center; justify-content:space-between;
    padding:16px 18px; background:var(--paper);
    border:1px solid var(--stone); border-radius:14px;
    cursor:pointer; transition:all .2s ease; gap:14px;
    position:relative; overflow:hidden;
  }
  .service-card::before { content:''; position:absolute; left:0; top:0; bottom:0; width:3px; background:var(--coral-500); transform:scaleY(0); transform-origin:bottom; transition:transform .3s cubic-bezier(.16,1,.3,1); }
  .service-card:hover { border-color:var(--coral-100); }
  .service-card:hover::before { transform:scaleY(1); }
  .service-card.selected { border-color:var(--coral-500); background:var(--coral-50); }
  .service-card.selected::before { transform:scaleY(1); }

  .service-card-left { flex:1; }
  .service-card-name { font-size:14.5px; font-weight:600; color:var(--ink); margin-bottom:3px; }
  .service-card-meta { font-size:12.5px; color:var(--graphite); display:flex; align-items:center; gap:6px; }
  .service-card-meta i { color:var(--coral-500); font-size:10.5px; }
  .service-card-price { font-family:'Space Grotesk', sans-serif; font-weight:700; font-size:20px; color:var(--coral-500); letter-spacing:-0.3px; flex-shrink:0; }
  .service-card-check { width:22px; height:22px; border-radius:50%; border:1px solid var(--stone); flex-shrink:0; display:flex; align-items:center; justify-content:center; transition:all .2s ease; font-size:10px; color:transparent; background:var(--paper); }
  .service-card.selected .service-card-check { background:var(--coral-500); border-color:var(--coral-500); color:var(--cream); }

  .time-slots-container { display:flex; flex-wrap:wrap; gap:8px; }
  .time-slot {
    padding:10px 16px; border-radius:10px;
    border:1px solid var(--stone); background:var(--paper);
    color:var(--graphite); font-size:14px; font-weight:500;
    cursor:pointer; transition:all .15s ease;
    font-variant-numeric:tabular-nums;
  }
  .time-slot:hover { border-color:var(--coral-500); color:var(--coral-700); }
  .time-slot.selected { background:var(--coral-500); color:var(--cream); border-color:var(--coral-500); font-weight:700; }

  #loading-indicator { font-size:13px; color:var(--coral-700); display:flex; align-items:center; gap:8px; padding:8px 0; }
  #time-error { font-size:13px; color:var(--rose-500); display:flex; align-items:center; gap:8px; }

  .summary-card {
    background:var(--paper); border:1px solid var(--stone);
    border-radius:20px; overflow:hidden; margin-bottom:18px;
    position:relative;
  }
  .summary-card::before { content:''; position:absolute; left:0; top:0; bottom:0; width:3px; background:var(--coral-500); }

  .summary-card-header {
    padding:20px 22px 20px 26px;
    border-bottom:1px solid var(--stone);
    display:flex; align-items:center; gap:14px;
  }
  .summary-avatar {
    width:52px; height:52px; border-radius:14px;
    background:var(--coral-50);
    border:1px solid var(--coral-100);
    display:flex; align-items:center; justify-content:center;
    font-family:'Space Grotesk', sans-serif; font-weight:700; font-size:17px; color:var(--coral-700); flex-shrink:0;
  }
  .summary-car-wash-name { font-family:'Space Grotesk', sans-serif; font-weight:700; font-size:20px; color:var(--ink); letter-spacing:-0.3px; }
  .summary-car-wash-address { font-size:13px; color:var(--graphite); margin-top:3px; }

  .summary-rows { padding:6px 0; }
  .summary-row { display:flex; align-items:center; justify-content:space-between; padding:12px 22px 12px 26px; border-bottom:1px solid var(--stone); gap:14px; }
  .summary-row:last-child { border-bottom:none; }
  .summary-row-label { font-family:'JetBrains Mono', monospace; font-size:11px; letter-spacing:1.4px; text-transform:uppercase; color:var(--ash); flex-shrink:0; }
  .summary-row-value { font-size:14px; color:var(--ink); text-align:right; font-weight:500; }
  .summary-row-value.highlight { font-family:'Space Grotesk', sans-serif; font-weight:700; font-size:24px; color:var(--coral-500); letter-spacing:-0.4px; }

  .email-notice {
    display:flex; align-items:center; gap:12px;
    padding:14px 16px;
    background:var(--coral-50); border:1px solid var(--coral-100);
    border-radius:12px; margin-bottom:18px;
    font-size:13px; color:var(--graphite); line-height:1.5;
  }
  .email-notice i { color:var(--coral-500); font-size:14px; flex-shrink:0; }
  .email-notice strong { color:var(--ink); }

  .appt-actions { display:flex; gap:10px; flex-wrap:wrap; }
  .appt-actions .btn-grow { flex:1; }

  @keyframes spin { to { transform:rotate(360deg); } }
  .spin { animation:spin .8s linear infinite; display:inline-block; }

  .flatpickr-calendar { background:var(--paper) !important; border:1px solid var(--stone) !important; border-radius:14px !important; box-shadow:0 14px 40px rgba(40,35,28,0.1) !important; }
  .flatpickr-day { color:var(--ink) !important; border-radius:10px !important; }
  .flatpickr-day:hover { background:var(--coral-50) !important; border-color:var(--coral-100) !important; }
  .flatpickr-day.selected, .flatpickr-day.selected:hover { background:var(--coral-500) !important; color:var(--cream) !important; border-color:var(--coral-500) !important; font-weight:700 !important; }
  .flatpickr-day.disabled, .flatpickr-day.disabled:hover { color:var(--stone) !important; cursor:not-allowed !important; }
  .flatpickr-day.nextMonthDay, .flatpickr-day.prevMonthDay { color:var(--stone) !important; pointer-events:none !important; }
  .flatpickr-month { color:var(--ink) !important; }
  .flatpickr-current-month, .flatpickr-current-month span, .flatpickr-current-month input { color:var(--ink) !important; font-family:'Space Grotesk', sans-serif !important; font-size:15px !important; }
  .flatpickr-weekday { color:var(--coral-500) !important; font-size:11px !important; font-weight:600 !important; font-family:'JetBrains Mono', monospace !important; }
  .flatpickr-prev-month svg, .flatpickr-next-month svg { fill:var(--graphite) !important; }
  .flatpickr-prev-month:hover svg, .flatpickr-next-month:hover svg { fill:var(--coral-500) !important; }
</style>

<div class="loov-page loov-page--narrow">

  <div class="appt-back">
    <a href="#" id="back-btn">
      <i class="fas fa-arrow-left"></i> <span id="back-label">Voltar</span>
    </a>
  </div>

  <div class="loov-hero loov-hero--left">
    <div class="loov-eyebrow"><span class="dot"></span>NOVO AGENDAMENTO</div>
    <h1 class="loov-h1">Agendar em <span class="accent"><%= @car_wash&.name || "Lava-rápido" %></span>.</h1>
    <p class="loov-lead"><%= @car_wash&.address %></p>
  </div>

  <% if flash[:alert] || flash[:notice] %>
  <div class="appt-flash">
    <% if flash[:alert] %>
      <div class="appt-flash-msg error"><i class="fas fa-circle-exclamation"></i><span><%= flash[:alert] %></span></div>
    <% end %>
    <% if flash[:notice] %>
      <div class="appt-flash-msg success"><i class="fas fa-circle-check"></i><span><%= flash[:notice] %></span></div>
    <% end %>
  </div>
  <% end %>

  <div class="appt-screen" id="screen-selection">

    <div class="appt-steps">
      <div class="appt-step active" id="step-1"><div class="appt-step-num">1</div><span>Data</span></div>
      <div class="appt-step-divider"></div>
      <div class="appt-step" id="step-2"><div class="appt-step-num">2</div><span>Serviço</span></div>
      <div class="appt-step-divider"></div>
      <div class="appt-step" id="step-3"><div class="appt-step-num">3</div><span>Horário</span></div>
    </div>

    <div class="loov-card" style="margin-bottom:18px;">
      <div class="appt-field">
        <label class="appt-field-label"><i class="fas fa-calendar"></i> Data *</label>
        <input type="text" id="appointment-date" class="appt-input" placeholder="Selecione uma data" readonly>
      </div>
    </div>

    <div class="loov-card" style="margin-bottom:18px;">
      <div class="appt-field locked" id="field-service">
        <label class="appt-field-label"><i class="fas fa-wrench"></i> Serviço *</label>
        <div class="field-locked-wrap" id="wrap-service">
          <div class="service-cards" id="service-cards">
            <% @car_wash.services.each do |service| %>
              <div class="service-card"
                data-id="<%= service.id %>"
                data-price="<%= service.price.to_f %>"
                data-duration="<%= service.duration %>"
                data-title="<%= service.title %>">
                <div class="service-card-left">
                  <div class="service-card-name"><%= service.title %></div>
                  <div class="service-card-meta">
                    <i class="fas fa-clock"></i> <%= service.duration %> min
                    <% if service.description.present? %>
                      · <%= service.description.truncate(40) %>
                    <% end %>
                  </div>
                </div>
                <div class="service-card-price">R$&nbsp;<%= number_with_precision(service.price, precision: 2, separator: ',') %></div>
                <div class="service-card-check"><i class="fas fa-check"></i></div>
              </div>
            <% end %>
          </div>
        </div>
        <div class="field-hint">
          <i class="fas fa-arrow-up"></i>
          <span>Selecione uma data primeiro para liberar este campo.</span>
        </div>
      </div>
    </div>

    <div class="loov-card">
      <div class="appt-field locked" id="field-time" style="margin-bottom:0;">
        <label class="appt-field-label"><i class="fas fa-clock"></i> Horário *</label>
        <div class="field-locked-wrap" id="wrap-time">
          <div id="loading-indicator" style="display:none;">
            <i class="fas fa-spinner fa-spin"></i> Carregando horários...
          </div>
          <div id="time-error" style="display:none;">
            <i class="fas fa-circle-exclamation"></i>&nbsp;<span id="time-error-msg">Nenhum horário disponível.</span>
          </div>
          <div id="time-slots" class="time-slots-container"></div>
        </div>
        <div class="field-hint">
          <i class="fas fa-arrow-up"></i>
          <span>Escolha um serviço primeiro para ver os horários disponíveis.</span>
        </div>
      </div>
    </div>

  </div>

  <div id="screen-summary" class="appt-screen hidden">

    <%= form_with(model: @appointment, local: true, id: "appointment-form") do |form| %>
      <%= form.hidden_field :car_wash_id, value: @car_wash.id %>
      <%= form.hidden_field :service_id, id: "hidden-service-id" %>
      <%= form.hidden_field :date, id: "hidden-date" %>
      <%= form.hidden_field :time, id: "hidden-time" %>

      <div class="summary-card">
        <div class="summary-card-header">
          <div class="summary-avatar"><%= @car_wash.name.first(2).upcase %></div>
          <div>
            <div class="summary-car-wash-name"><%= @car_wash.name %></div>
            <div class="summary-car-wash-address"><%= @car_wash.address %></div>
          </div>
        </div>
        <div class="summary-rows">
          <div class="summary-row"><span class="summary-row-label">Data</span><span class="summary-row-value" id="sum-date">—</span></div>
          <div class="summary-row"><span class="summary-row-label">Horário</span><span class="summary-row-value" id="sum-time">—</span></div>
          <div class="summary-row"><span class="summary-row-label">Serviço</span><span class="summary-row-value" id="sum-service">—</span></div>
          <div class="summary-row"><span class="summary-row-label">Duração</span><span class="summary-row-value" id="sum-duration">—</span></div>
          <div class="summary-row"><span class="summary-row-label">Valor</span><span class="summary-row-value highlight" id="sum-price">—</span></div>
        </div>
      </div>

      <div class="email-notice">
        <i class="fas fa-envelope"></i>
        <span>Após confirmar, você receberá um <strong>e-mail de confirmação</strong> com todos os detalhes.</span>
      </div>

      <div class="appt-actions">
        <button type="button" class="loov-btn-secondary" id="btn-back-selection">
          <i class="fas fa-arrow-left"></i> Corrigir
        </button>
        <%= form.submit "Confirmar Agendamento",
            class: "loov-btn-primary loov-btn-lg btn-grow",
            id: "submit-button",
            data: { disable_with: "Confirmando..." } %>
      </div>

    <% end %>
  </div>

</div>

<script>
  var selectedDate = null;
  var selectedDateStr = null;
  var selectedDuration = null;
  var selectedServiceId = null;
  var selectedServiceTitle = null;
  var selectedServicePrice = null;

  function setStep(step) {
    for (var i = 1; i <= 3; i++) {
      var el = document.getElementById('step-' + i);
      el.classList.remove('active', 'done');
      if (i < step) el.classList.add('done');
      else if (i === step) el.classList.add('active');
    }
  }

  function unlockField(fieldId, wrapId) {
    var f = document.getElementById(fieldId);
    var w = document.getElementById(wrapId);
    if (f) f.classList.remove('locked');
    if (w) w.classList.add('unlocked');
  }

  function lockField(fieldId, wrapId) {
    var f = document.getElementById(fieldId);
    var w = document.getElementById(wrapId);
    if (f) f.classList.add('locked');
    if (w) w.classList.remove('unlocked');
  }

  function showScreen(id) {
    document.querySelectorAll('.appt-screen').forEach(function(s) { s.classList.add('hidden'); });
    var screen = document.getElementById(id);
    screen.classList.remove('hidden');
  }

  function showSummary() {
    var date = selectedDate;
    document.getElementById('sum-date').textContent =
      date.toLocaleDateString('pt-BR', { weekday: 'long', day: '2-digit', month: 'long', year: 'numeric' });
    document.getElementById('sum-time').textContent = document.getElementById('hidden-time').value;
    document.getElementById('sum-service').textContent = selectedServiceTitle;
    document.getElementById('sum-duration').textContent = selectedDuration + ' min';
    document.getElementById('sum-price').textContent = 'R$ ' + parseFloat(selectedServicePrice).toFixed(2).replace('.', ',');
    showScreen('screen-summary');
    document.getElementById('back-label').textContent = 'Voltar';
  }

  document.getElementById('back-btn').addEventListener('click', function(e) {
    e.preventDefault();
    var summaryVisible = !document.getElementById('screen-summary').classList.contains('hidden');
    if (summaryVisible) {
      showScreen('screen-selection');
      document.getElementById('back-label').textContent = 'Voltar';
    } else {
      window.location.href = '<%= car_wash_path(@car_wash) %>';
    }
  });

  document.getElementById('btn-back-selection').addEventListener('click', function() {
    showScreen('screen-selection');
  });

  document.querySelectorAll('.service-card').forEach(function(card) {
    card.addEventListener('click', function() {
      document.querySelectorAll('.service-card').forEach(function(c) { c.classList.remove('selected'); });
      card.classList.add('selected');
      selectedServiceId    = card.dataset.id;
      selectedServiceTitle = card.dataset.title;
      selectedServicePrice = card.dataset.price;
      selectedDuration     = parseInt(card.dataset.duration);
      document.getElementById('hidden-service-id').value = selectedServiceId;
      document.getElementById('time-slots').innerHTML = '';
      document.getElementById('time-error').style.display = 'none';
      document.getElementById('hidden-time').value = '';
      lockField('field-time', 'wrap-time');
      setStep(3);
      if (selectedDateStr) loadTimeSlots();
    });
  });

  async function loadTimeSlots() {
    if (!selectedDateStr || !selectedDuration) return;
    var dayOfWeek = selectedDate.getDay();
    var oh = (window.operatingHours || []).find(function(o) { return o.day_of_week === dayOfWeek; });
    if (!oh) {
      document.getElementById('time-error-msg').textContent = 'Lava-rápido fechado neste dia.';
      document.getElementById('time-error').style.display = 'flex';
      unlockField('field-time', 'wrap-time');
      return;
    }
    document.getElementById('loading-indicator').style.display = 'flex';
    document.getElementById('time-slots').innerHTML = '';
    document.getElementById('time-error').style.display = 'none';
    var appointments = [];
    try {
      var r = await fetch('/appointments.json?car_wash_id=' + window.carWashId + '&date=' + selectedDateStr, {
        headers: { 'Accept': 'application/json', 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content }
      });
      var data = await r.json();
      appointments = data.appointments || [];
    } catch(e) { console.error(e); }
    document.getElementById('loading-indicator').style.display = 'none';
    var slots = [];
    var cur = oh.opens_at;
    var now = new Date();
    var isToday = selectedDate.toDateString() === now.toDateString();
    var nowMin  = now.getHours() * 60 + now.getMinutes();
    while (cur + selectedDuration <= oh.closes_at) {
      if (!isToday || cur > nowMin) {
        var used = appointments.filter(function(a) {
          var t = a.start_time ? a.start_time.match(/T(\d{2}):(\d{2})/) : null;
          if (!t) return false;
          var m = parseInt(t[1]) * 60 + parseInt(t[2]);
          return m < cur + selectedDuration && m + selectedDuration > cur;
        }).length;
        if ((window.capacityPerSlot || 1) - used > 0) {
          var h = String(Math.floor(cur/60)).padStart(2,'0');
          var m = String(cur%60).padStart(2,'0');
          slots.push({ time: h + ':' + m });
        }
      }
      cur += selectedDuration;
    }
    var container = document.getElementById('time-slots');
    if (!slots.length) {
      document.getElementById('time-error-msg').textContent = 'Nenhum horário disponível para este dia.';
      document.getElementById('time-error').style.display = 'flex';
      unlockField('field-time', 'wrap-time');
      return;
    }
    slots.forEach(function(s) {
      var slotEl = document.createElement('div');
      slotEl.className = 'time-slot';
      slotEl.textContent = s.time;
      slotEl.dataset.time = s.time;
      slotEl.addEventListener('click', function() {
        document.querySelectorAll('.time-slot').forEach(function(t) { t.classList.remove('selected'); });
        slotEl.classList.add('selected');
        document.getElementById('hidden-time').value = s.time;
        document.getElementById('hidden-date').value = selectedDateStr;
        setTimeout(showSummary, 250);
      });
      container.appendChild(slotEl);
    });
    unlockField('field-time', 'wrap-time');
  }

  document.getElementById('appointment-form')?.addEventListener('submit', function() {
    var btn = document.getElementById('submit-button');
    if (btn) {
      btn.disabled = true;
      btn.style.opacity = '0.5';
      btn.value = 'Confirmando...';
    }
  });

  function initFlatpickr() {
    var el = document.getElementById('appointment-date');
    if (!el || typeof flatpickr === 'undefined') { setTimeout(initFlatpickr, 50); return; }
    var today = new Date(); today.setHours(0,0,0,0);
    var maxDate = new Date(today); maxDate.setMonth(maxDate.getMonth() + 1);
    flatpickr(el, {
      dateFormat: "Y-m-d",
      altInput: true,
      altFormat: "d/m/Y",
      minDate: today,
      maxDate: maxDate,
      showMonths: 1,
      disableMobile: true,
      locale: {
        firstDayOfWeek: 0,
        weekdays: {
          shorthand: ["Dom","Seg","Ter","Qua","Qui","Sex","Sab"],
          longhand:  ["Domingo","Segunda","Terça","Quarta","Quinta","Sexta","Sábado"]
        },
        months: {
          shorthand: ["Jan","Fev","Mar","Abr","Mai","Jun","Jul","Ago","Set","Out","Nov","Dez"],
          longhand:  ["Janeiro","Fevereiro","Março","Abril","Maio","Junho","Julho","Agosto","Setembro","Outubro","Novembro","Dezembro"]
        }
      },
      onChange: function(selectedDates, dateStr) {
        if (!selectedDates.length) return;
        selectedDate    = selectedDates[0];
        selectedDateStr = dateStr;
        document.getElementById('hidden-date').value = dateStr;
        var dayOfWeek = selectedDate.getDay();
        var oh = (window.operatingHours || []).find(function(o) { return o.day_of_week === dayOfWeek; });
        document.querySelectorAll('.service-card').forEach(function(c) { c.classList.remove('selected'); });
        selectedServiceId = null; selectedDuration = null;
        document.getElementById('time-slots').innerHTML = '';
        document.getElementById('time-error').style.display = 'none';
        document.getElementById('hidden-time').value = '';
        lockField('field-time', 'wrap-time');
        if (!oh) {
          lockField('field-service', 'wrap-service');
          document.getElementById('time-error-msg').textContent = 'Lava-rápido fechado neste dia.';
          document.getElementById('time-error').style.display = 'flex';
          unlockField('field-time', 'wrap-time');
          setStep(1);
          return;
        }
        unlockField('field-service', 'wrap-service');
        setStep(2);
      }
    });
  }

  initFlatpickr();
</script>
