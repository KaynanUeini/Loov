<div class="loov-page loov-page--narrow">
  <div class="loov-hero">
    <div class="loov-eyebrow"><span class="dot"></span>AGENDAMENTO #<%= @appointment.id %></div>
    <h1 class="loov-h1">
      Detalhes do <span class="accent">agendamento</span>.
    </h1>
    <p class="loov-lead">
      Confira os detalhes da sua reserva.
    </p>
  </div>

  <div class="loov-card loov-card--lg">
    <% status_pill_class = case @appointment.status
        when 'confirmed'              then 'loov-pill--success'
        when 'cancelled'              then 'loov-pill--danger'
        when 'pending_acceptance'     then 'loov-pill--warn'
        else 'loov-pill--neutral' end %>
    <% status_label = case @appointment.status
        when 'confirmed'           then 'Confirmado'
        when 'cancelled'           then 'Cancelado'
        when 'pending_acceptance'  then 'Aguardando aceite'
        when 'rejected'            then 'Recusado'
        when 'completed'           then 'Concluído'
        else @appointment.status.to_s.humanize end %>

    <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:14px;flex-wrap:wrap;margin-bottom:18px;">
      <h2 class="loov-card-title" style="font-size:20px;">
        <%= @appointment.car_wash.name %>
      </h2>
      <span class="loov-pill <%= status_pill_class %>"><%= status_label %></span>
    </div>

    <div style="display:flex;flex-direction:column;gap:14px;">
      <div style="display:flex;align-items:center;gap:12px;padding:12px 14px;background:var(--cream);border:1px solid var(--stone);border-radius:12px;">
        <div class="loov-card-icon" style="width:36px;height:36px;border-radius:10px;margin:0;font-size:13px;"><i class="fas fa-screwdriver-wrench"></i></div>
        <div>
          <div style="font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:1.4px;color:var(--ash);text-transform:uppercase;">Serviço</div>
          <div style="font-size:14.5px;font-weight:600;color:var(--ink);"><%= @appointment.service.title %></div>
        </div>
      </div>

      <div style="display:flex;align-items:center;gap:12px;padding:12px 14px;background:var(--cream);border:1px solid var(--stone);border-radius:12px;">
        <div class="loov-card-icon" style="width:36px;height:36px;border-radius:10px;margin:0;font-size:13px;"><i class="fas fa-clock"></i></div>
        <div>
          <div style="font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:1.4px;color:var(--ash);text-transform:uppercase;">Data e hora</div>
          <div style="font-size:14.5px;font-weight:600;color:var(--ink);"><%= @appointment.scheduled_at.in_time_zone("America/Sao_Paulo").strftime("%d/%m/%Y às %H:%M") %></div>
        </div>
      </div>

      <div style="display:flex;align-items:center;gap:12px;padding:12px 14px;background:var(--cream);border:1px solid var(--stone);border-radius:12px;">
        <div class="loov-card-icon" style="width:36px;height:36px;border-radius:10px;margin:0;font-size:13px;"><i class="fas fa-tag"></i></div>
        <div>
          <div style="font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:1.4px;color:var(--ash);text-transform:uppercase;">Valor</div>
          <div style="font-size:14.5px;font-weight:600;color:var(--ink);">R$ <%= sprintf('%.2f', @appointment.service.price.to_f) %></div>
        </div>
      </div>
    </div>

    <% if @appointment.status != 'cancelled' && @appointment.scheduled_at > DateTime.now %>
      <hr class="loov-divider">
      <%= button_to 'CANCELAR AGENDAMENTO', cancel_appointment_path(@appointment),
          method: :delete,
          data: { confirm: 'Tem certeza que deseja cancelar este agendamento?' },
          class: 'loov-btn-secondary loov-btn-block loov-btn-lg',
          style: 'border-color:rgba(200,80,80,0.3);color:#c85050;' %>
    <% end %>
  </div>
</div>
