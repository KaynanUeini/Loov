<% content_for :preheader, "Aceite o convite para atender pela Loov no #{@car_wash.name}." %>
<% content_for :footer, "Você recebeu este e-mail porque #{@invitation.email} foi convidado para a equipe do #{@car_wash.name}." %>

<%= render "emails/heading", eyebrow: "Convite para a equipe", title: "Você foi convidado para a equipe do #{@car_wash.name}." %>
<%= render "emails/paragraph", text: "Oi! #{@inviter_name || "O dono do lava-rápido"} adicionou você como atendente na Loov." %>
<%= render "emails/paragraph", text: "Como atendente, você vai poder:", muted: true %>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 8px;">
  <% ["Ver e organizar os agendamentos do dia",
      "Registrar clientes que chegam no balcão",
      "Marcar os atendimentos como concluídos"].each do |item| %>
    <tr>
      <td valign="top" style="padding:3px 10px 3px 0;font-size:15px;line-height:22px;color:#dd7852;font-weight:700;">&#10003;</td>
      <td style="padding:3px 0;font-size:15px;line-height:22px;color:#28231c;"><%= item %></td>
    </tr>
  <% end %>
</table>

<%= render "emails/button", url: @accept_url, label: "Aceitar convite", top: 20 %>
<%= render "emails/note", text: "Atendentes não veem o financeiro nem as configurações do lava-rápido." %>
<%= render "emails/callout", title: (@inviter_name ? "Não conhece #{@inviter_name}?" : "Não esperava este convite?"), text: "É só ignorar este e-mail. Nada muda sem o seu aceite." %>
