<%# Eyebrow + título. tone: :coral (padrão) ou :rose (cancelamento). %>
<p style="margin:0 0 10px;font-size:12px;font-weight:700;letter-spacing:1.6px;text-transform:uppercase;color:<%= local_assigns[:tone] == :rose ? "#c85050" : "#dd7852" %>;">
  <%= eyebrow %>
</p>
<h1 style="margin:0 0 20px;font-size:28px;line-height:34px;font-weight:700;letter-spacing:-0.6px;color:#28231c;">
  <%= title %>
</h1>
