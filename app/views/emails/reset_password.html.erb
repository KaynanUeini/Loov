<%# Redefinição de senha — o mesmo pros dois fluxos (app: PasswordsController;
    site: Devise::Mailer). Locais: first_name, email, url, hours. %>
<% content_for :preheader, "Toque no link para criar uma nova senha. Ele vale por #{hours} horas." %>
<% content_for :footer, "Você recebeu este e-mail porque existe uma conta Loov com #{email}." %>

<%= render "emails/heading", eyebrow: "Redefinir senha", title: "Vamos criar uma nova senha." %>
<%= render "emails/paragraph", text: "#{first_name.present? ? "Oi, #{first_name}." : "Oi!"} Recebemos um pedido para redefinir a senha da sua conta na Loov." %>
<%= render "emails/paragraph", text: "É só tocar no botão e escolher a nova senha. Leva menos de um minuto.", muted: true %>
<%= render "emails/button", url: url, label: "Criar nova senha" %>
<%= render "emails/note", text: "O link vale por #{hours} horas e funciona uma vez só." %>
<%= render "emails/callout", title: "Não foi você?", text: "Pode ignorar este e-mail. Sua senha atual continua valendo, e ninguém consegue trocá-la sem este link." %>

<p style="margin:28px 0 0;font-size:12px;line-height:18px;color:#ada699;">
  O botão não abriu? Copie e cole este endereço no navegador:<br>
  <a href="<%= url %>" style="color:#9c4930;word-break:break-all;"><%= url %></a>
</p>
