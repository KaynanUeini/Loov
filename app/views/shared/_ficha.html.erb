      var url = reduzir(img, 1600, 0.6);
      var q = qualidade(img);
      if (!q.ok) { falhou(label); st.aviso = { label: label, motivo: q.motivo, url: url, img: img, origem: 'local' }; renderFotos(); return; }
      st.aviso = null;
      if (label === 'detail') { st.pendente = { url: url, img: img }; renderFotos(); return; }
      aceitar(label, url, img, null, true);
    }).catch(function (e) { toast(e.message); });
  });

  // Guarda a guiada; a IA confere em segundo plano enquanto a próxima é tirada.
  function aceitar(label, url, img, flag, ia) {
    st.fotos = st.fotos.filter(function (f) { return f.label !== label; });
    st.fotos.push({ label: label, url: url, img: img, flag: flag || null, conf: ia ? 'conferindo' : 'ok' });
    st.fotos.sort(function (a, b) { var o = function (f) { var i = FOTOS.map(function (g) { return g.label; }).indexOf(f.label); return i < 0 ? 9 : i; }; return o(a) - o(b); });
    st.refazer = null;
    renderFotos();
    if (!ia) return;
    var alvoSt = st;
    conferirIA(st.appt.id, label, img).then(function (r) {
      if (st !== alvoSt) return;
      st.fotos.forEach(function (f) { if (f.label === label && f.url === url) { f.conf = r.ok ? 'ok' : 'ruim'; f.motivo = r.motivo; f.visto = r.visto; } });
      if (!r.ok) { falhou(label); st.aviso = { label: label, motivo: r.motivo, visto: r.visto, url: url, origem: 'ia' }; }
      if ($('lf-fotos').classList.contains('is-on')) renderFotos();
    });
  }
  function usarMesmoAssim() {
    var a = st.aviso; st.aviso = null;
    if (!a) return;
    if (a.label === 'detail') { st.pendente = { url: a.url, img: a.img, flag: a.motivo }; renderFotos(); return; }
    if (a.origem === 'local') { aceitar(a.label, a.url, a.img, a.motivo, false); return; }
    st.fotos.forEach(function (f) { if (f.label === a.label && f.url === a.url) { f.conf = 'ok'; f.flag = a.motivo; } });
    renderFotos();
  }

  // ── Desenho ─────────────────────────────────────────────────────────────
  function renderDesenho() {
    var atual = st.sel != null ? st.marks[st.sel] : null;
    $('lf-desenho').innerHTML = '<div class="lf-wrap">' +
      '<div class="lf-top"><button type="button" class="lf-back" id="lf-dv" aria-label="Voltar">' + ic('chevron-left', 18) + '</button><span class="lf-placa-top">' + esc(fmtPlaca(st.placa)) + '</span><span style="width:40px"></span></div>' +
      '<h2 class="lf-title">Onde tem avaria?</h2><p class="lf-lead">Clique no ponto do carro. A frente fica em cima.</p>' +
      '<div style="margin-top:20px">' + desenhoHtml(Math.min(220, window.innerWidth - 80), st.marks, st.sel, true) + '</div>' +
      '<div class="lf-painel">' +
        (atual
          ? '<div class="lf-painel-t">Ponto ' + (st.sel + 1) + ' · ' + esc(areaPara(atual.x, atual.y)) + '</div><div class="lf-tipos">' +
            TIPOS.map(function (t) { return '<button type="button" class="lf-tipo' + (atual.kind === t.kind ? ' is-on' : '') + '" data-tipo="' + t.kind + '" aria-pressed="' + (atual.kind === t.kind) + '">' + t.nome + '</button>'; }).join('') + '</div>'
          : '<div class="lf-painel-v">' + (st.marks.length ? 'Clique num ponto pra mudar o tipo.' : 'Nenhuma avaria marcada ainda.') + '</div>') +
        (st.marks.length ? '<div style="margin-top:12px">' + st.marks.map(function (m, i) {
          return '<div class="lf-linha"><span class="lf-bol">' + (i + 1) + '</span><span>' + esc(nomeAvaria(m.kind)) + ' · ' + esc(areaPara(m.x, m.y)) + '</span><button type="button" class="lf-rm" data-rm="' + i + '" aria-label="Remover ponto ' + (i + 1) + '">' + ic('x', 18) + '</button></div>';
        }).join('') + '</div>' : '') +
      '</div></div>' +
      '<div class="lf-foot"><button type="button" class="lf-cta" id="lf-dok">' + (st.marks.length ? 'Continuar · ' + st.marks.length + (st.marks.length === 1 ? ' ponto' : ' pontos') : 'Carro sem avarias') + '</button></div>';
    $('lf-dv').addEventListener('click', function () { renderSheet(); mostrar('lf-sheet'); });
    $('lf-tap').addEventListener('click', function (e) {
      var p = e.target.closest('[data-ponto]');
      if (p) { st.sel = +p.dataset.ponto; renderDesenho(); return; }
      var r = this.getBoundingClientRect();
      st.marks.push({ x: Math.min(Math.max((e.clientX - r.left) / r.width, 0), 1), y: Math.min(Math.max((e.clientY - r.top) / r.height, 0), 1), kind: 'risco' });
      st.sel = st.marks.length - 1; renderDesenho();
    });
    $('lf-desenho').querySelectorAll('[data-tipo]').forEach(function (b) { b.addEventListener('click', function () { st.marks[st.sel].kind = b.dataset.tipo; renderDesenho(); }); });
    $('lf-desenho').querySelectorAll('[data-rm]').forEach(function (b) { b.addEventListener('click', function () { st.marks.splice(+b.dataset.rm, 1); st.sel = null; renderDesenho(); }); });
    $('lf-dok').addEventListener('click', function () { renderRevisar(); mostrar('lf-revisar'); });
  }

  // ── Conferir e salvar ───────────────────────────────────────────────────
  function renderRevisar() {
    var a = st.appt, carro = [a.vehicle_model, a.client].filter(Boolean).join(' · ');
    var corpo = st.modo === 'photos'
      ? '<div class="lf-grade">' + st.fotos.map(function (f) {
          return '<div class="lf-gi"><img src="' + f.url + '" alt=""><span class="lf-gi-tags">' +
            (f.kind ? '<span class="lf-selo">' + esc(nomeAvaria(f.kind)) + '</span>' : '') +
            (f.flag ? '<span class="lf-selo is-flag">' + esc(nomeFlag(f.flag)) + '</span>' : '') +
            '</span><span class="lf-gi-n">' + esc(nomeFoto(f.label)) + '</span></div>';
        }).join('') + '</div>'
      : '<div class="lf-cardd">' + desenhoHtml(110, st.marks, null, false) +
          (st.marks.length ? '<ol>' + st.marks.map(function (m, i) { return '<li>' + (i + 1) + '. ' + esc(nomeAvaria(m.kind)) + ' · ' + esc(areaPara(m.x, m.y)) + '</li>'; }).join('') + '</ol>' : '<p>Sem avarias.</p>') + '</div>';
    $('lf-revisar').innerHTML = '<div class="lf-wrap">' +
      '<button type="button" class="lf-back" id="lf-rv" aria-label="Voltar"' + (st.salvando ? ' disabled' : '') + '>' + ic('chevron-left', 18) + '</button>' +
      '<h2 class="lf-title">Confira a ficha</h2>' +
      '<div class="lf-carro">' + placaHtml(st.placa) + '<span>' + esc(carro) + '</span></div>' + corpo +
      '<label class="lf-label" for="lf-notas">Observação (opcional)</label>' +
      '<textarea id="lf-notas" class="lf-input" maxlength="500" placeholder="Ex.: cliente avisou do risco na porta"' + (st.salvando ? ' disabled' : '') + '>' + esc(st.notas) + '</textarea>' +
      '<div class="lf-aviso"><div>' + ic('clock', 16) + '<span>A data e a hora são registradas pela Loov ao salvar.</span></div>' +
        '<div>' + ic('lock', 16) + '<span>Depois de salva, ninguém altera nem apaga. Fica guardada por 5 anos.</span></div></div>' +
    '</div>' +
    '<div class="lf-foot"><button type="button" class="lf-cta" id="lf-salvar"' + (st.salvando ? ' disabled' : '') + '>' +
      (st.salvando ? '<i class="lf-spin"></i>' + esc(st.salvando) : 'Salvar ficha') + '</button></div>';
    $('lf-notas').addEventListener('input', function () { st.notas = this.value; });
    $('lf-rv').addEventListener('click', function () { if (st.modo === 'photos') { renderFotos(); mostrar('lf-fotos'); } else { renderDesenho(); mostrar('lf-desenho'); } });
    $('lf-salvar').addEventListener('click', salvar);
  }

  function progresso(txt) { st.salvando = txt; var b = $('lf-salvar'); if (b) { b.disabled = true; b.innerHTML = '<i class="lf-spin"></i>' + esc(txt); } }

  function salvar() {
    if (st.salvando) return;
    var a = st.appt, cb = st.onSalva, photos = [], cadeia = Promise.resolve();
    if (st.modo === 'photos') {
      st.fotos.forEach(function (f, i) {
        cadeia = cadeia.then(function () {
          progresso('Enviando foto ' + (i + 1) + ' de ' + st.fotos.length + '…');
          return api('POST', '/owner/checkins/' + a.id + '/vehicle_check/photo', { label: f.label, image: b64(f.url) })
            .then(function (r) { photos.push({ label: r.label, key: r.key, kind: f.kind || null, flag: f.flag || null }); });
        });
      });
    }
    cadeia.then(function () {
      progresso('Salvando a ficha…');
      return api('POST', '/owner/checkins/' + a.id + '/vehicle_check', { mode: st.modo, plate: st.placa, notes: st.notas, photos: photos, marks: st.modo === 'sketch' ? st.marks : [] });
    }).then(function (d) {
      st = null; pilha = [];
      cb && cb(d.vehicle_check);
      empilhar(function () { renderDetalhe(d.vehicle_check, true); });
    }).catch(function (e) {
      st.salvando = null; renderRevisar(); toast('Ficha não salva. ' + (e.message || 'Falha de conexão.'));
    });
  }

  // ── Ficha salva (só leitura) ────────────────────────────────────────────
  function ver(id) { pilha = []; empilhar(function () { carregarDetalhe(id); }); }
  function carregarDetalhe(id) {
    $('lf-detalhe').innerHTML = '<div class="lf-center"><i class="lf-spin is-dark"></i></div>'; mostrar('lf-detalhe');
    api('GET', '/owner/vehicle_checks/' + id)
      .then(function (d) { renderDetalhe(d.vehicle_check, false); })
      .catch(function (e) { $('lf-detalhe').innerHTML = '<div class="lf-wrap"><button type="button" class="lf-back" data-voltar aria-label="Voltar">' + ic('chevron-left', 18) + '</button><div class="lf-center">' + esc(e.message || 'Não foi possível abrir a ficha.') + '</div></div>'; ligarVoltar('lf-detalhe'); });
  }
  function ligarVoltar(v) { $(v).querySelectorAll('[data-voltar]').forEach(function (b) { b.addEventListener('click', voltar); }); }
  function renderDetalhe(f, recem) {
    var corpo = f.mode === 'photos'
      ? '<div class="lf-grade">' + f.photos.map(function (p, i) {
          return '<button type="button" class="lf-gi" data-foto="' + i + '" aria-label="Abrir foto ' + esc(nomeFoto(p.label)) + '">' + (p.url ? '<img src="' + esc(p.url) + '" alt="">' : '') + '<span class="lf-gi-tags">' +
            (p.kind ? '<span class="lf-selo">' + esc(nomeAvaria(p.kind)) + '</span>' : '') +
            (p.flag ? '<span class="lf-selo is-flag">' + esc(nomeFlag(p.flag)) + '</span>' : '') +
            '</span><span class="lf-gi-n">' + esc(nomeFoto(p.label)) + '</span></button>';
        }).join('') + '</div>'
      : '<div class="lf-cardd">' + desenhoHtml(110, f.marks || [], null, false) +
          ((f.marks || []).length ? '<ol>' + f.marks.map(function (m) { return '<li>' + m.n + '. ' + esc(nomeAvaria(m.kind)) + ' · ' + esc(m.area) + '</li>'; }).join('') + '</ol>' : '<p>Sem avarias.</p>') + '</div>';
    $('lf-detalhe').innerHTML = '<div class="lf-wrap">' +
      '<button type="button" class="lf-back" data-voltar aria-label="' + (recem ? 'Fechar' : 'Voltar') + '">' + ic(recem ? 'x' : 'chevron-left', 18) + '</button>' +
      '<h2 class="lf-title">' + (recem ? 'Ficha salva' : 'Ficha de entrada') + '</h2>' +
      '<p class="lf-lead">' + esc(fmtQuando(f.recorded_at)) + (f.recorded_by ? ' · por ' + esc(f.recorded_by) : '') + '</p>' +
      '<div class="lf-carro">' + placaHtml(f.plate) + (f.vehicle_model ? '<span>' + esc(f.vehicle_model) + '</span>' : '') + '</div>' + corpo +
      (f.notes ? '<span class="lf-label">Observação</span><p class="lf-notas">' + esc(f.notes) + '</p>' : '') +
      '<div class="lf-aviso"><div>' + ic('lock', 16) + '<span>Ninguém altera nem apaga esta ficha. Fica guardada até ' + esc(fmtQuando(f.expires_at).split(' às ')[0]) + '.</span></div></div>' +
      (f.plate ? '<button type="button" class="lf-row" id="lf-hist"><span class="lf-row-ic">' + ic('clock', 18) + '</span><span>Histórico desta placa</span>' + ic('chevron-right', 18) + '</button>' : '') +
    '</div>' +
    (recem ? '<div class="lf-foot"><button type="button" class="lf-cta is-ink" data-voltar>Voltar ao painel</button></div>' : '');
    mostrar('lf-detalhe');
    ligarVoltar('lf-detalhe');
    if ($('lf-hist')) $('lf-hist').addEventListener('click', function () { empilhar(function () { carregarHistorico(f.plate); }); });
    $('lf-detalhe').querySelectorAll('[data-foto]').forEach(function (b) { b.addEventListener('click', function () {
      var p = f.photos[+b.dataset.foto]; if (!p.url) return;
      $('lf-lightbox').innerHTML = '<img src="' + esc(p.url) + '" alt=""><span>' + esc(nomeFoto(p.label)) + (p.kind ? ' · ' + esc(nomeAvaria(p.kind)) : '') + '</span>';
      $('lf-lightbox').classList.add('is-on');
    }); });
  }
  $('lf-lightbox').addEventListener('click', function () { this.classList.remove('is-on'); });

  // ── Histórico da placa ──────────────────────────────────────────────────
  function historico(placa) { pilha = []; empilhar(function () { carregarHistorico(placa); }); }
  function cap(s) { return s ? s[0].toUpperCase() + s.slice(1) : s; }
  function carregarHistorico(placa) {
    $('lf-historico').innerHTML = '<div class="lf-center"><i class="lf-spin is-dark"></i></div>'; mostrar('lf-historico');
    api('GET', '/owner/vehicle_checks?plate=' + encodeURIComponent(placa)).then(function (d) {
      var desde = d.since ? new Date(d.since) : null;
      $('lf-historico').innerHTML = '<div class="lf-wrap">' +
        '<button type="button" class="lf-back" data-voltar aria-label="Voltar">' + ic('chevron-left', 18) + '</button>' +
        '<div style="margin-top:18px">' + placaHtml(d.plate, true) + '</div>' +
        (d.vehicle_model ? '<p class="lf-lead">' + esc(d.vehicle_model) + '</p>' : '') +
        // Número grande em destaque, como a wiemer: "quanto eu sei desse carro?"
        '<div class="lf-num"><b>' + d.count + '</b><span>' + (d.count === 1 ? 'ficha' : 'fichas') + (desde ? ' desde ' + MESES[desde.getMonth()] + '/' + desde.getFullYear() : '') + '</span></div>' +
        (d.recurring || []).map(function (r) {
          return '<div class="lf-rec"><i></i><div><b>' + esc(nomeAvaria(r.kind)) + ' ' + (String(r.area).indexOf('porta ') === 0 ? 'na' : 'no') + ' ' + esc(r.area) + '</b>' +
            '<small>Já estava lá em ' + r.count + ' fichas, a primeira em ' + esc(fmtQuando(r.first_at).split(' às ')[0]) + '.</small></div></div>';
        }).join('') +
        '<h3 class="lf-secao">Fichas</h3>' +
        (d.checks.length ? d.checks.map(function (c) {
          return '<button type="button" class="lf-row" data-ficha="' + c.id + '" style="margin-top:10px"><span class="lf-row-ic">' + ic(c.mode === 'photos' ? 'camera' : 'edit-3', 20) + '</span>' +
            '<span>' + esc(fmtQuando(c.recorded_at)) + '<small>' + esc(cap([
              c.mode === 'photos' ? c.photos_count + ' fotos' : 'desenho',
              c.damage_count ? c.damage_count + (c.damage_count === 1 ? ' avaria' : ' avarias') : 'sem avarias',
              c.recorded_by
            ].filter(Boolean).join(' · '))) + '</small></span>' + ic('chevron-right', 18) + '</button>';
        }).join('') : '<p class="lf-lead">Nenhuma ficha deste carro ainda.</p>') +
      '</div>';
      ligarVoltar('lf-historico');
      $('lf-historico').querySelectorAll('[data-ficha]').forEach(function (b) { b.addEventListener('click', function () { var id = b.dataset.ficha; empilhar(function () { carregarDetalhe(id); }); }); });
    }).catch(function (e) {
      $('lf-historico').innerHTML = '<div class="lf-wrap"><button type="button" class="lf-back" data-voltar aria-label="Voltar">' + ic('chevron-left', 18) + '</button><div class="lf-center">' + esc(e.message || 'Não foi possível abrir o histórico.') + '</div></div>';
      ligarVoltar('lf-historico');
    });
  }

  window.LoovFicha = {
    configurar: function (s) { settings = s || null; },
    abrir: abrir, ver: ver, historico: historico,
    placaValida: placaValida, limparPlaca: limparPlaca
  };
})();
</script>
