  .lf-pg { background: var(--cream); color: var(--ink); min-height: 100vh; padding-top: 60px; font-family: 'Inter', sans-serif; }
  .loov-nav { background: var(--cream) !important; }
  .lf-pg *, .lf-pg *::before, .lf-pg *::after { box-sizing: border-box; }
  .lf-pg button { font-family: inherit; line-height: normal; cursor: pointer; }
  .lf-pg svg.feather { display: block; flex-shrink: 0; }
