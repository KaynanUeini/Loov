      if (!r.ok) { var e = new Error(d.error || 'Falha de conexão.'); e.status = r.status; throw e; }
      return d;
    }); });
  }

  // ── Camadas ─────────────────────────────────────────────────────────────
  var pilha = [];
  function mostrar(id) {
