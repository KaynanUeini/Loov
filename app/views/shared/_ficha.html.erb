  var CARRO = '<svg viewBox="0 0 170 330" aria-hidden="true">' +
    '<rect x="14" y="40" width="10" height="40" rx="4" fill="#28231c"/><rect x="146" y="40" width="10" height="40" rx="4" fill="#28231c"/>' +
    '<rect x="14" y="238" width="10" height="40" rx="4" fill="#28231c"/><rect x="146" y="238" width="10" height="40" rx="4" fill="#28231c"/>' +
    '<path d="M45 8 Q85 0 125 8 Q148 14 150 40 L150 290 Q148 318 125 322 Q85 328 45 322 Q22 318 20 290 L20 40 Q22 14 45 8 Z" fill="#fefefd" stroke="#28231c" stroke-width="2"/>' +
    '<path d="M38 92 Q85 74 132 92 L124 132 Q85 122 46 132 Z" fill="#f1eee6" stroke="#28231c" stroke-width="2"/>' +
    '<path d="M46 132 Q85 122 124 132 L124 222 Q85 230 46 222 Z" fill="none" stroke="#28231c" stroke-width="2"/>' +
