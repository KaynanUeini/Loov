  var toastT;
  function toast(msg) { var t = $('lf-toast'); t.textContent = msg; t.classList.add('is-on'); clearTimeout(toastT); toastT = setTimeout(function () { t.classList.remove('is-on'); }, 3200); }

  // Onde fica um ponto no desenho (x, y de 0 a 1), frente em cima, lado
  // esquerdo do desenho = lado do motorista. Espelho de VehicleCheck.area_para.
  function areaPara(x, y) {
    var porta = x < 0.5 ? 'esquerda' : 'direita', lado = x < 0.5 ? 'esquerdo' : 'direito', borda = x < 0.27 || x > 0.73;
    if (y < 0.09) return 'para-choque dianteiro';
    if (y < 0.29) return borda ? 'para-lama dianteiro ' + lado : 'capô';
    if (y < 0.40) return borda ? 'porta dianteira ' + porta : 'para-brisa';
    if (y < 0.55) return borda ? 'porta dianteira ' + porta : 'teto';
    if (y < 0.69) return borda ? 'porta traseira ' + porta : 'teto';
    if (y < 0.79) return borda ? 'para-lama traseiro ' + lado : 'vidro traseiro';
    if (y < 0.91) return borda ? 'para-lama traseiro ' + lado : 'porta-malas';
    return 'para-choque traseiro';
  }

  function mensagem(motivo, label, visto) {
    var VISTO = { front: 'a frente', rear: 'a traseira', side: 'a lateral' };
    var PEDIDO = { front: 'a frente', rear: 'a traseira', left: 'o lado esquerdo', right: 'o lado direito' };
    switch (motivo) {
      case 'escura':      return 'A foto ficou escura. Acenda uma luz e tire de novo.';
      case 'estourada':   return 'A foto ficou clara demais, com reflexo. Mude um pouco o ângulo e tire de novo.';
      case 'tremida':     return 'A foto ficou tremida. Segure firme e tire de novo.';
      case 'sem_carro':   return 'Não encontramos o carro nesta foto. Enquadre o carro inteiro e tire de novo.';
      case 'outro_lado':  return 'Esta foto parece mostrar ' + (VISTO[visto] || 'outra parte do carro') + ', e o pedido era ' + (PEDIDO[label] || 'outra') + '.';
      case 'sem_nitidez': return 'Não dá pra ver bem a lataria nesta foto. Chegue um pouco mais perto e tire de novo.';
      default:            return 'Esta foto não passou na conferência. Tire de novo.';
    }
  }

  function api(method, url, body) {
    return fetch(url, {
