  // Contornos das fotos guiadas (os do app, que lá vão por cima da câmera).
  var DASH = 'fill="none" stroke="#fafaf6" stroke-opacity=".85" stroke-width="2.5" stroke-dasharray="8 7" stroke-linecap="round" stroke-linejoin="round"';
  function contorno(label) {
    if (label === 'left' || label === 'right') {
      return '<svg width="300" height="155" viewBox="0 0 330 170"' + (label === 'right' ? ' style="transform:scaleX(-1)"' : '') + ' aria-hidden="true"><path ' + DASH + ' d="M20 118 L20 96 Q22 84 40 80 L92 72 L128 40 Q136 34 150 34 L228 34 Q242 34 252 44 L282 74 L304 80 Q314 84 314 96 L314 118 M20 118 L52 118 M118 118 L222 118 M288 118 L314 118 M104 72 L134 44 L186 44 L186 72 Z M196 44 L234 44 L264 72 L196 72 Z"/><circle cx="85" cy="118" r="26" ' + DASH + '/><circle cx="255" cy="118" r="26" ' + DASH + '/></svg>';
    }
    return '<svg width="250" height="185" viewBox="0 0 260 190" aria-hidden="true"><path ' + DASH + ' d="M30 150 L30 98 Q32 82 50 78 L72 40 Q78 30 92 30 L168 30 Q182 30 188 40 L210 78 Q228 82 230 98 L230 150 Z M80 76 L94 44 L166 44 L180 76 Z M44 116 L76 116 M184 116 L216 116 M96 132 L164 132 M34 150 L34 172 L64 172 L64 150 M196 150 L196 172 L226 172 L226 150"/></svg>';
  }

  // ── Imagem: reduzir, medir e base64 ─────────────────────────────────────
  // Lida como data: (a CSP do site libera data: e https: em img-src, não blob:).
  function carregar(file) {
    return new Promise(function (ok, falha) {
      var leitor = new FileReader(), erro = function () { falha(new Error('Não deu pra abrir a foto.')); };
      leitor.onerror = erro;
      leitor.onload = function () { var img = new Image(); img.onload = function () { ok(img); }; img.onerror = erro; img.src = leitor.result; };
      leitor.readAsDataURL(file);
    });
  }
  function reduzir(img, largura, q) {
    var k = Math.min(1, largura / img.naturalWidth), c = document.createElement('canvas');
    c.width = Math.round(img.naturalWidth * k); c.height = Math.round(img.naturalHeight * k);
    c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
    return c.toDataURL('image/jpeg', q);
  }
  function b64(dataUrl) { return dataUrl.slice(dataUrl.indexOf(',') + 1); }
  // 1ª camada, no aparelho e de graça: o mesmo cálculo e os mesmos limites de
  // public/ficha/qualidade.html (a janela escondida do app). Mudar lá, mudar aqui.
  function qualidade(img) {
    try {
      var LADO = 256, k = LADO / img.naturalWidth, w = LADO, h = Math.max(1, Math.round(img.naturalHeight * k));
      var c = document.createElement('canvas'); c.width = w; c.height = h;
      var x = c.getContext('2d'); x.drawImage(img, 0, 0, w, h);
      var d = x.getImageData(0, 0, w, h).data, n = w * h, g = new Float32Array(n), soma = 0, claros = 0;
      for (var i = 0; i < n; i++) { var v = 0.299 * d[i * 4] + 0.587 * d[i * 4 + 1] + 0.114 * d[i * 4 + 2]; g[i] = v; soma += v; if (v > 245) claros++; }
      var m = 0, m2 = 0, cont = 0;
      for (var yy = 1; yy < h - 1; yy++) for (var xx = 1; xx < w - 1; xx++) {
        var p = yy * w + xx, l = 4 * g[p] - g[p - 1] - g[p + 1] - g[p - w] - g[p + w]; m += l; m2 += l * l; cont++;
      }
      m /= cont;
      var brilho = soma / n, nitidez = m2 / cont - m * m;
      if (brilho < 28) return { ok: false, motivo: 'escura' };
      if (claros / n > 0.35) return { ok: false, motivo: 'estourada' };
      if (nitidez < 250) return { ok: false, motivo: 'tremida' };
      return { ok: true };
    } catch (e) { return { ok: true }; }
  }
  // 2ª camada: a IA, só nas 4 guiadas. Sem resposta em 15 s, a foto passa.
  function conferirIA(apptId, label, img) {
    var ctl = window.AbortController ? new AbortController() : null;
    var relogio = setTimeout(function () { ctl && ctl.abort(); }, 15000);
    return fetch('/owner/checkins/' + apptId + '/vehicle_check/conferir', {
      method: 'POST', credentials: 'same-origin', signal: ctl ? ctl.signal : undefined,
      headers: { Accept: 'application/json', 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
      body: JSON.stringify({ label: label, image: b64(reduzir(img, 512, 0.6)) })
    }).then(function (r) { return r.json().catch(function () { return {}; }).then(function (d) {
      if (!r.ok) return { ok: true };
      return { ok: d.ok !== false, motivo: d.motivo || null, visto: d.visto || null };
    }); }).catch(function () { return { ok: true }; }).finally(function () { clearTimeout(relogio); });
  }

  // ── Estado da ficha em andamento ────────────────────────────────────────
  var settings = null, st = null;

  function modosDisponiveis() {
    if (!settings) return [];
    if (!settings.photos_available) return ['sketch'];
    if (settings.mode === 'photos') return ['photos'];
    if (settings.mode === 'sketch') return ['sketch'];
    return ['photos', 'sketch'];
  }

  // ── Folha: placa e modo ─────────────────────────────────────────────────
  function abrir(appt, opts) {
    opts = opts || {};
    st = { appt: appt, motivo: opts.motivo || null, onSalva: opts.onSalva, placa: limparPlaca(appt.plate),
           fotos: [], marks: [], sel: null, notas: '', tentativas: {}, refazer: null, detalhe: false, pendente: null, aviso: null, salvando: null };
    renderSheet();
    mostrar('lf-sheet');
    var inp = $('lf-placa-in'); if (inp) setTimeout(function () { inp.focus(); }, 50);
  }
  function renderSheet() {
    var a = st.appt, modos = modosDisponiveis(), temPlaca = placaValida(st.placa), ultimo = lsGet(ULTIMO) || 'photos';
    var OP = {
      photos: { icon: 'camera', t: 'Tirar 4 fotos', s: 'Cerca de 1 minuto. Vale mais como prova.' },
      sketch: { icon: 'edit-3', t: 'Marcar no desenho', s: 'Clique onde tem risco ou amassado.' }
    };
    var carro = [a.vehicle_model, a.client].filter(Boolean).join(' · ');
    $('lf-sheet').innerHTML = '<div class="lf-sheet" role="dialog" aria-modal="true" aria-labelledby="lf-sheet-t"><div class="lf-grip"></div>' +
      '<h2 class="lf-title" id="lf-sheet-t">Ficha de entrada</h2>' +
      (st.motivo === 'finalizar' ? '<div class="lf-motivo">' + ic('lock', 15) + '<div><b>Ficha obrigatória para finalizar</b><small>Este lava-rápido pede ficha em todo carro. Faça a ficha e depois clique em Finalizado.</small></div></div>' : '') +
      '<div class="lf-carro">' + (a.plate ? placaHtml(st.placa) : '<input id="lf-placa-in" class="lf-placa-in' + (st.placa && !temPlaca ? ' is-err' : '') + '" value="' + esc(st.placa) + '" placeholder="Placa" maxlength="8" autocomplete="off" aria-label="Placa do carro">') +
        '<span>' + esc(carro) + '</span></div>' +
      (!a.plate && !temPlaca ? '<p class="lf-dica">Digite a placa pra abrir a ficha. Ela guarda o histórico do carro.</p>' : '') +
      '<div class="lf-opcoes">' + modos.map(function (m) {
        var o = OP[m], dest = modos.length === 1 || m === ultimo;
        return '<button type="button" class="lf-opcao' + (dest ? ' is-dest' : '') + '" data-modo="' + m + '"' + (temPlaca ? '' : ' disabled') + '>' +
          '<span class="lf-opcao-ic">' + ic(o.icon, 22) + '</span><span class="lf-opcao-t"><b>' + o.t + '</b><small>' + o.s + '</small></span>' +
          (dest && modos.length > 1 ? '<span class="lf-ultimo">ÚLTIMO</span>' : '') + '</button>';
      }).join('') + '</div>' +
      (settings && !settings.photos_available && settings.mode !== 'sketch' ? '<p class="lf-dica">As fotos ainda não estão ativas na Loov. Por enquanto, use o desenho.</p>' : '') +
      // Pular é o caminho alternativo explícito: contorno, não link.
      (settings && settings.skippable ? '<button type="button" class="lf-out" id="lf-pular">Pular a ficha deste carro</button>' : '') +
    '</div>';
    var inp = $('lf-placa-in');
    if (inp) inp.addEventListener('input', function () {
      var pos = inp.selectionStart; st.placa = limparPlaca(inp.value); renderSheet();
      var n = $('lf-placa-in'); n.focus(); try { n.setSelectionRange(pos, pos); } catch (e) {}
    });
    $('lf-sheet').querySelectorAll('[data-modo]').forEach(function (b) { b.addEventListener('click', function () { escolher(b.dataset.modo); }); });
    if ($('lf-pular')) $('lf-pular').addEventListener('click', pular);
  }
  $('lf-sheet').addEventListener('click', function (e) { if (e.target === $('lf-sheet')) fechar(); });

  function escolher(modo) {
    if (!placaValida(st.placa)) return;
    lsSet(ULTIMO, modo);
    st.modo = modo;
    if (modo === 'photos') { renderFotos(); mostrar('lf-fotos'); } else { renderDesenho(); mostrar('lf-desenho'); }
  }
  function pular() {
    var a = st.appt, cb = st.onSalva;
