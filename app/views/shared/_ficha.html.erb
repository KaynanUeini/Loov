  .lf-input { width: 100%; min-height: 72px; margin-top: 6px; padding: 12px; border: 1px solid var(--stone); border-radius: 14px; background: var(--paper); color: var(--ink); font: inherit; font-size: 15px; resize: vertical; outline: none; }
  .lf-input:focus { border-color: var(--ink); }
  .lf-notas { margin: 6px 0 0 !important; font-size: 15px !important; line-height: 22px !important; color: var(--ink) !important; }
  .lf-aviso { display: grid; gap: 10px; margin-top: 16px; padding: 14px; border-radius: 14px; background: var(--sand); }
  .lf-aviso div { display: flex; gap: 10px; align-items: flex-start; font-size: 14px; line-height: 20px; }
  .lf-row { display: flex; align-items: center; gap: 12px; width: 100%; margin-top: 18px; padding: 16px; border: 1px solid var(--stone); border-radius: 18px; background: var(--paper); color: var(--ink); text-align: left; font-size: 15px; font-weight: 600; transition: border-color .15s; }
  .lf-row:hover { border-color: var(--ink); }
  .lf-row span { flex: 1; min-width: 0; }
  .lf-row small { display: block; margin-top: 3px; font-size: 13px; font-weight: 400; color: var(--graphite); }
  .lf-row .lf-row-ic { flex: 0 0 44px; height: 44px; border-radius: 12px; background: var(--sand); display: flex; align-items: center; justify-content: center; }
  .lf-row > svg:last-child { color: var(--graphite); }
  .lf-num { display: flex; align-items: baseline; gap: 10px; margin-top: 22px; }
  .lf-num b { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 56px; line-height: 1; letter-spacing: -2px; }
  .lf-num span { font-size: 15px; color: var(--graphite); }
