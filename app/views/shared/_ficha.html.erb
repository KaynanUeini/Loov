    ['lf-sheet', 'lf-fotos', 'lf-desenho', 'lf-revisar', 'lf-detalhe', 'lf-historico'].forEach(function (v) { $(v).classList.toggle('is-on', v === id); });
    $(id).scrollTop = 0;
  }
  function fechar() {
