      .then(function () { toast('Ficha pulada.'); cb && cb(null); })
      .catch(function (e) { toast(e.message); });
  }

  // ── Fotos ───────────────────────────────────────────────────────────────
  function proxima() {
    if (st.refazer) return FOTOS.filter(function (g) { return g.label === st.refazer; })[0];
    var tem = function (l) { return st.fotos.some(function (f) { return f.label === l; }); };
    return FOTOS.filter(function (g) { return !tem(g.label); })[0] ||
      FOTOS.filter(function (g) { return st.fotos.some(function (f) { return f.label === g.label && f.conf === 'ruim'; }); })[0];
  }
  function renderFotos() {
    var alvo = st.detalhe ? null : proxima(), ok = !proxima(), detalhes = st.fotos.filter(function (f) { return f.label === 'detail'; });
    var conferindo = st.fotos.some(function (f) { return f.conf === 'conferindo'; });
    var titulo = st.detalhe ? 'Detalhe da avaria' : ok ? 'Fotos prontas' : alvo.nome;
    var passo = st.detalhe ? 'FOTO DE PERTO' : ok ? st.fotos.length + ' FOTOS' : 'FOTO ' + (FOTOS.indexOf(alvo) + 1) + ' DE 4';
    var cam;
    if (st.pendente) cam = '<div class="lf-cam"><img src="' + st.pendente.url + '" alt=""></div>';
    else if (ok && !st.detalhe) cam = '<div class="lf-cam is-pronto">' + ic('check-circle', 40, { color: '#5dc39f' }) + '<b>As 4 fotos estão feitas.</b></div>';
    else if (st.detalhe) cam = '<div class="lf-cam">' + ic('zoom-in', 40, { color: '#fafaf6', opacity: .85 }) + '<span class="lf-cam-dica">Chegue perto do risco ou amassado</span></div>';
    else cam = '<div class="lf-cam">' + contorno(alvo.label) + '<span class="lf-cam-dica">Enquadre o carro como no contorno</span></div>';

    var foot;
    if (st.pendente) {
      foot = '<div class="lf-pergunta">O que tem aqui?</div><div class="lf-tipos-d">' +
        TIPOS.map(function (t) { return '<button type="button" data-tipo="' + t.kind + '">' + t.nome + '</button>'; }).join('') + '</div>';
    } else {
      var av = st.aviso;
      foot = (av ? '<div class="lf-aviso-d"><div style="display:flex;gap:10px;align-items:flex-start">' + ic('alert-circle', 18, { color: '#dd7852' }) +
          '<div><b>' + esc(nomeFoto(av.label)) + '</b><small>' + esc(mensagem(av.motivo, av.label, av.visto)) + '</small></div></div>' +
          '<div class="lf-aviso-bt">' + ((st.tentativas[av.label] || 0) >= 2 ? '<button type="button" class="lf-dghost" id="lf-mesmo">Usar mesmo assim</button>' : '') +
          '<button type="button" class="lf-dbtn" id="lf-denovo">Tirar de novo</button></div></div>' : '') +
        (st.fotos.length ? '<div class="lf-thumbs">' + st.fotos.map(function (f, i) {
          var ruim = st.refazer === f.label || f.conf === 'ruim';
          return '<button type="button" class="lf-thumb" data-thumb="' + i + '" aria-label="' + (f.label === 'detail' ? 'Remover detalhe' : 'Refazer foto ' + esc(nomeFoto(f.label))) + '">' +
            '<span class="' + (ruim ? 'is-ruim' : '') + '"><img src="' + f.url + '" alt="">' +
            (f.conf === 'conferindo' ? '<em><i class="lf-spin"></i></em>' : f.conf === 'ruim' ? '<em>' + ic('alert-circle', 18, { color: '#fafaf6' }) + '</em>' : '') +
            '</span>' + esc(f.label === 'detail' ? nomeAvaria(f.kind) : nomeFoto(f.label)) + '</button>';
        }).join('') + '</div>' : '') +
        '<div class="lf-cambt">' +
          '<button type="button" class="lf-pill" id="lf-det"' + (detalhes.length >= MAX_DETALHES ? ' disabled' : '') + '>' + (st.detalhe ? 'Cancelar' : '+ Detalhe') + '</button>' +
          (ok && !st.detalhe
            ? '<button type="button" class="lf-revisar" id="lf-rev"' + (conferindo ? ' disabled' : '') + '>' + (conferindo ? '<i class="lf-spin is-dark"></i>Conferindo' : 'Revisar') + '</button>'
            : '<button type="button" class="lf-shutter" id="lf-shot" aria-label="Tirar foto"><i>' + ic('camera', 24) + '</i></button>') +
          '<span style="min-width:104px"></span>' +
        '</div>';
    }

    $('lf-fotos').innerHTML = '<div class="lf-wrap" style="padding-bottom:32px">' +
      '<div class="lf-top"><button type="button" class="lf-dround" id="lf-fx" aria-label="Fechar">' + ic('x', 20) + '</button><span class="lf-placa-top">' + esc(fmtPlaca(st.placa)) + '</span><span style="width:44px"></span></div>' +
      '<div class="lf-prog">' + FOTOS.map(function (g) {
        var feita = st.fotos.some(function (f) { return f.label === g.label; }), atual = alvo && alvo.label === g.label;
