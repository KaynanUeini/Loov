  .lf-pg-corpo { max-width: 720px; padding-top: 4px; }
  .lf-pg .lf-center { justify-content: flex-start; min-height: 30vh; padding: 20px 0; }
  a.lf-row { text-decoration: none; color: var(--ink); }
