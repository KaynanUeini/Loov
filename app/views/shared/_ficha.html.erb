  // Voltar dentro da ficha salva / histórico: uma camada de cada vez.
  function empilhar(fn) { pilha.push(fn); fn(); }
  function voltar() { pilha.pop(); if (pilha.length) pilha[pilha.length - 1](); else fechar(); }
  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Escape' || !$('lf').classList.contains('is-on')) return;
    if ($('lf-lightbox').classList.contains('is-on')) { $('lf-lightbox').classList.remove('is-on'); return; }
    if (st && st.salvando) return;
    if ($('lf-sheet').classList.contains('is-on')) fechar();
  });

