  .lf-shutter i { width: 58px; height: 58px; border-radius: 50%; background: var(--cream); display: flex; align-items: center; justify-content: center; color: var(--ink); }
  .lf-revisar { height: 56px; padding: 0 28px; border-radius: 28px; border: 0; background: var(--cream); color: var(--ink); font-size: 16px; font-weight: 600; display: flex; align-items: center; gap: 8px; }
  .lf-revisar[disabled] { opacity: .6; }
  .lf-pergunta { margin-top: 18px; font-size: 16px; font-weight: 600; }
  .lf-tipos-d { display: flex; gap: 8px; margin-top: 12px; }
  .lf-tipos-d button { flex: 1; height: 44px; border-radius: 14px; border: 0; background: rgba(250,250,246,.14); color: var(--cream); font-size: 14px; font-weight: 600; }
  .lf-file { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }

  /* Revisar e ficha salva */
