  .lf button { font-family: inherit; line-height: normal; cursor: pointer; }
  .lf svg.feather { display: block; flex-shrink: 0; }
  .lf-v { position: absolute; inset: 0; display: none; overflow-y: auto; background: var(--cream); }
  .lf-v.is-on { display: block; }
  .lf-wrap { max-width: 560px; margin: 0 auto; padding: 16px 20px 120px; }
