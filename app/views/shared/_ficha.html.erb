<%#
  Ficha do carro no site — porte das telas do app (FichaSheet, OwnerFichaScreen,
  OwnerFichaDetalheScreen, OwnerFichaHistoricoScreen), numa camada por cima da
  página. Usada pelo painel (home/index) e pela página "Ficha do carro"
  (owner/vehicle_checks/page).

    LoovFicha.configurar(settings)          settings = vehicle_check do /owner/checkins/today
    LoovFicha.abrir(appt, { motivo, onSalva })   folha: placa e fotos ou desenho
    LoovFicha.ver(id)                       ficha salva, só leitura
    LoovFicha.historico(placa)              fichas da placa e avarias que se repetem

  O que muda do app, por ser navegador:
    · Fotos pela câmera do celular (input com capture) ou por arquivo no
      computador, em vez da câmera dentro do app. O contorno do carro vira a
      ilustração da foto pedida, antes de abrir a câmera.
    · Cada foto vai pro servidor (POST …/vehicle_check/photo), que guarda no
      R2: o navegador não manda direto pro R2 sem CORS no bucket.
    · A conferência é a mesma: qualidade no aparelho (o mesmo cálculo de
      public/ficha/qualidade.html) e a IA nas 4 guiadas (…/conferir).
      As duas falham abertas: sem resposta, a foto passa.
%>
<style>
  .lf { position: fixed; inset: 0; z-index: 1500; display: none; font-family: 'Inter', sans-serif; color: var(--ink); }
  .lf.is-on { display: block; }
  .lf *, .lf *::before, .lf *::after { box-sizing: border-box; }
  .lf button { font-family: inherit; line-height: normal; cursor: pointer; }
  .lf svg.feather { display: block; flex-shrink: 0; }
  .lf-v { position: absolute; inset: 0; display: none; overflow-y: auto; background: var(--cream); }
  .lf-v.is-on { display: block; }
  .lf-wrap { max-width: 560px; margin: 0 auto; padding: 16px 20px 120px; }

  /* Folha (bottom sheet), como as do painel */
  .lf-v.lf-sheetv { background: rgba(26,22,18,.45); display: none; align-items: flex-end; justify-content: center; }
  .lf-v.lf-sheetv.is-on { display: flex; }
  .lf-sheet { width: 100%; max-width: 520px; background: var(--paper); border-radius: 28px 28px 0 0; padding: 12px 20px calc(28px + env(safe-area-inset-bottom, 0px)); animation: lfIn .25s ease-out; }
  @keyframes lfIn { from { transform: translateY(40px); opacity: 0; } }
  @media (min-width: 720px) { .lf-v.lf-sheetv { align-items: center; } .lf-sheet { border-radius: 28px; } }
  .lf-grip { width: 40px; height: 5px; border-radius: 3px; background: var(--stone); margin: 0 auto 6px; }

  .lf-back { width: 40px; height: 40px; border-radius: 50%; border: 0; background: var(--sand); color: var(--ink); display: inline-flex; align-items: center; justify-content: center; }
  .lf-back:hover { background: var(--stone); }
  .lf-top { display: flex; align-items: center; justify-content: space-between; }
  .lf-placa-top { font-family: 'JetBrains Mono', monospace; font-weight: 500; font-size: 14px; color: var(--graphite); }
  .lf-title { margin: 18px 0 0; font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 38px; line-height: 40px; letter-spacing: -1.5px; color: var(--ink); }
  .lf-sheet .lf-title { margin-top: 12px; font-size: 30px; line-height: 34px; letter-spacing: -1px; }
  .lf-lead { margin: 10px 0 0 !important; font-size: 15px !important; line-height: 22px !important; color: var(--graphite) !important; }
  .lf-dica { margin: 10px 0 0; font-size: 13px; line-height: 18px; color: var(--graphite); }

  /* Placa desenhada como a de verdade (faixa azul do Mercosul) */
  .lf-placa { display: inline-flex; flex-direction: column; width: 108px; border: 1.5px solid var(--ink); border-radius: 6px; overflow: hidden; background: #fff; flex-shrink: 0; }
  .lf-placa i { display: block; height: 8px; background: #1f4fa0; }
  .lf-placa b { padding: 4px 0; text-align: center; font-family: 'JetBrains Mono', monospace; font-weight: 500; font-size: 16px; letter-spacing: 1px; color: var(--ink); }
  .lf-placa.is-big { width: 156px; border-width: 2px; border-radius: 8px; }
  .lf-placa.is-big i { height: 12px; }
  .lf-placa.is-big b { font-size: 24px; padding: 6px 0; }
  .lf-carro { display: flex; align-items: center; gap: 10px; margin-top: 14px; }
  .lf-carro span { flex: 1; min-width: 0; color: var(--graphite); font-size: 15px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lf-placa-in { width: 130px; height: 44px; border: 1.5px solid var(--ink); border-radius: 8px; background: #fff; text-align: center; font-family: 'JetBrains Mono', monospace; font-weight: 500; font-size: 18px; letter-spacing: 1px; color: var(--ink); text-transform: uppercase; outline: none; }
  .lf-placa-in.is-err { border-color: var(--rose-500, #c85050); }

  .lf-motivo { display: flex; gap: 10px; align-items: flex-start; margin-top: 14px; padding: 14px; border-radius: 16px; background: var(--coral-50); border: 1px solid var(--coral-100); color: var(--coral-700); }
  .lf-motivo b { display: block; font-size: 14px; }
  .lf-motivo small { display: block; margin-top: 2px; font-size: 12.5px; line-height: 17px; color: var(--graphite); }

  .lf-opcoes { display: grid; gap: 10px; margin-top: 18px; }
  .lf-opcao { display: flex; align-items: center; gap: 14px; width: 100%; padding: 16px; border-radius: 18px; border: 1px solid var(--stone); background: var(--paper); color: var(--ink); text-align: left; transition: border-color .15s; }
  .lf-opcao:hover:not([disabled]) { border-color: var(--ink); }
  .lf-opcao.is-dest { border: 2px solid var(--ink); padding: 15px; }
  .lf-opcao[disabled] { opacity: .45; cursor: not-allowed; }
  .lf-opcao-ic { flex: 0 0 48px; height: 48px; border-radius: 14px; background: var(--sand); color: var(--ink); display: flex; align-items: center; justify-content: center; }
  .lf-opcao.is-dest .lf-opcao-ic { background: var(--ink); color: var(--cream); }
  .lf-opcao-t { flex: 1; min-width: 0; }
  .lf-opcao-t b { display: block; font-size: 16px; font-weight: 600; }
  .lf-opcao-t small { display: block; margin-top: 3px; font-size: 13px; color: var(--graphite); }
  .lf-ultimo { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 1px; color: var(--graphite); }

  /* Botões no padrão: coral efetiva, contorno abre ou é alternativo, tinta navega */
  .lf-cta { display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; height: 52px; border: 0; border-radius: 999px; background: var(--coral-500); color: var(--cream); font-size: 16px; font-weight: 600; transition: opacity .15s; }
  .lf-cta[disabled] { opacity: .7; cursor: default; }
  .lf-cta.is-ink { background: var(--ink); }
  .lf-out { display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; min-height: 48px; margin-top: 14px; border: 1.5px solid var(--ink); border-radius: 999px; background: transparent; color: var(--ink); font-size: 15px; font-weight: 600; transition: background .15s; }
  .lf-out:hover { background: var(--sand); }
  .lf-foot { position: fixed; left: 0; right: 0; bottom: 0; padding: 12px 20px calc(16px + env(safe-area-inset-bottom, 0px)); background: linear-gradient(to top, var(--cream) 70%, rgba(250,250,246,0)); }
  .lf-foot > * { max-width: 520px; margin: 0 auto; }
  .lf-spin { width: 18px; height: 18px; border-radius: 50%; border: 2.5px solid rgba(250,250,246,.35); border-top-color: var(--cream); animation: lfSpin .8s linear infinite; }
  .lf-spin.is-dark { border-color: rgba(40,35,28,.2); border-top-color: var(--ink); }
  @keyframes lfSpin { to { transform: rotate(360deg); } }

  /* Desenho do carro visto de cima */
  .lf-desenho { position: relative; margin: 0 auto; touch-action: manipulation; }
  .lf-desenho svg { display: block; width: 100%; height: auto; }
  .lf-desenho.is-tap { cursor: crosshair; }
  .lf-ponto { position: absolute; width: 30px; height: 30px; margin: -15px 0 0 -15px; border-radius: 50%; border: 3px solid var(--cream); background: var(--coral-600, #c65f3a); color: #fff; font-size: 13px; font-weight: 600; display: flex; align-items: center; justify-content: center; padding: 0; }
  .lf-ponto.is-sel { transform: scale(1.12); box-shadow: 0 0 0 4px rgba(198,95,58,.3); }
  .lf-painel { margin-top: 18px; padding: 18px 20px; background: var(--paper); border: 1px solid var(--stone); border-radius: 24px; }
  .lf-painel-t { font-size: 15px; font-weight: 600; }
  .lf-painel-v { font-size: 14px; color: var(--graphite); }
  .lf-tipos { display: flex; gap: 8px; margin-top: 12px; }
  .lf-tipo { flex: 1; height: 44px; border-radius: 14px; border: 1px solid var(--stone); background: var(--paper); color: var(--ink); font-size: 14px; font-weight: 500; }
  .lf-tipo.is-on { background: var(--ink); border-color: var(--ink); color: var(--cream); font-weight: 600; }
  .lf-linha { display: flex; align-items: center; gap: 10px; border-top: 1px solid var(--sand); }
  .lf-linha span { flex: 1; min-width: 0; font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lf-linha .lf-bol { flex: 0 0 22px; height: 22px; border-radius: 50%; background: var(--coral-600, #c65f3a); color: #fff; font-size: 12px; font-weight: 600; display: flex; align-items: center; justify-content: center; }
  .lf-rm { width: 44px; height: 44px; border: 0; background: none; color: var(--graphite); display: flex; align-items: center; justify-content: center; }

  /* Fotos (fundo escuro: a foto é o foco, como na câmera) */
  .lf-v.lf-dark { background: #1a1612; color: var(--cream); }
  .lf-dround { width: 44px; height: 44px; border-radius: 50%; border: 0; background: rgba(250,250,246,.12); color: var(--cream); display: inline-flex; align-items: center; justify-content: center; }
  .lf-dark .lf-placa-top { color: var(--stone); }
  .lf-prog { display: flex; gap: 6px; margin-top: 14px; }
  .lf-prog i { flex: 1; height: 4px; border-radius: 2px; background: rgba(250,250,246,.25); }
  .lf-prog i.is-feita { background: var(--cream); }
  .lf-prog i.is-atual { background: var(--coral-500); }
  .lf-passo { margin-top: 12px; font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 1px; color: var(--stone); }
  .lf-dtitle { margin: 2px 0 0; font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 28px; letter-spacing: -.5px; color: var(--cream); }
  .lf-cam { position: relative; margin-top: 14px; aspect-ratio: 4 / 3; border-radius: 20px; background: #3a342c; overflow: hidden; display: flex; align-items: center; justify-content: center; }
  .lf-cam svg { max-width: 82%; height: auto; }
  .lf-cam-dica { position: absolute; bottom: 14px; left: 0; right: 0; text-align: center; font-size: 14px; color: var(--cream); }
  .lf-cam.is-pronto { flex-direction: column; gap: 10px; }
  .lf-cam.is-pronto b { font-size: 16px; }
  .lf-cam img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .lf-aviso-d { margin-top: 16px; padding: 14px; border-radius: 16px; background: rgba(250,250,246,.08); border: 1px solid rgba(221,120,82,.45); }
  .lf-aviso-d b { display: block; font-size: 14px; }
  .lf-aviso-d small { display: block; margin-top: 2px; font-size: 13px; line-height: 18px; color: var(--stone); }
  .lf-aviso-bt { display: flex; justify-content: flex-end; gap: 8px; margin-top: 12px; }
  .lf-dbtn { height: 40px; padding: 0 18px; border-radius: 999px; border: 0; background: var(--cream); color: var(--ink); font-size: 13.5px; font-weight: 600; }
  .lf-dghost { height: 40px; padding: 0 16px; border-radius: 999px; border: 1px solid rgba(250,250,246,.3); background: transparent; color: var(--cream); font-size: 13.5px; font-weight: 500; }
  .lf-thumbs { display: flex; gap: 8px; margin-top: 16px; overflow-x: auto; scrollbar-width: none; }
  .lf-thumbs::-webkit-scrollbar { display: none; }
  .lf-thumb { flex: 0 0 auto; width: 58px; padding: 0; border: 0; background: none; color: var(--stone); text-align: center; font-size: 10px; }
  .lf-thumb span { position: relative; display: block; width: 54px; height: 54px; margin: 0 auto 3px; border-radius: 10px; border: 2px solid var(--mint-500, #5dc39f); overflow: hidden; }
  .lf-thumb span.is-ruim { border-color: var(--coral-500); }
  .lf-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .lf-thumb em { position: absolute; inset: 0; background: rgba(26,22,18,.45); display: flex; align-items: center; justify-content: center; }
  .lf-thumb span.is-ruim em { background: rgba(221,120,82,.55); }
  .lf-cambt { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 18px; }
  .lf-pill { min-width: 104px; height: 44px; padding: 0 14px; border-radius: 22px; border: 0; background: rgba(250,250,246,.12); color: var(--cream); font-size: 13px; font-weight: 500; }
  .lf-pill[disabled] { opacity: .4; cursor: default; }
  .lf-shutter { width: 76px; height: 76px; border-radius: 50%; border: 4px solid var(--cream); background: transparent; display: flex; align-items: center; justify-content: center; padding: 0; }
  .lf-shutter i { width: 58px; height: 58px; border-radius: 50%; background: var(--cream); display: flex; align-items: center; justify-content: center; color: var(--ink); }
  .lf-revisar { height: 56px; padding: 0 28px; border-radius: 28px; border: 0; background: var(--cream); color: var(--ink); font-size: 16px; font-weight: 600; display: flex; align-items: center; gap: 8px; }
  .lf-revisar[disabled] { opacity: .6; }
  .lf-pergunta { margin-top: 18px; font-size: 16px; font-weight: 600; }
  .lf-tipos-d { display: flex; gap: 8px; margin-top: 12px; }
  .lf-tipos-d button { flex: 1; height: 44px; border-radius: 14px; border: 0; background: rgba(250,250,246,.14); color: var(--cream); font-size: 14px; font-weight: 600; }
  .lf-file { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }

  /* Revisar e ficha salva */
  .lf-grade { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 18px; }
  .lf-gi { position: relative; aspect-ratio: 1; border-radius: 14px; overflow: hidden; background: var(--stone); border: 0; padding: 0; display: block; }
  .lf-gi img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .lf-gi-tags { position: absolute; left: 6px; top: 6px; right: 6px; display: flex; flex-direction: column; align-items: flex-start; gap: 4px; }
  .lf-selo { padding: 2px 8px; border-radius: 999px; background: var(--coral-600, #c65f3a); color: #fff; font-size: 11px; font-weight: 600; }
  .lf-selo.is-flag { background: rgba(26,22,18,.7); color: var(--cream); font-size: 10.5px; }
  .lf-gi-n { position: absolute; left: 6px; bottom: 6px; padding: 2px 6px; border-radius: 6px; background: rgba(26,22,18,.6); color: var(--cream); font-size: 11px; font-weight: 500; }
  .lf-cardd { display: flex; gap: 16px; align-items: center; margin-top: 18px; padding: 16px; background: var(--paper); border: 1px solid var(--stone); border-radius: 18px; box-shadow: 0 1px 2px rgba(40,35,28,.04), 0 6px 18px -12px rgba(40,35,28,.25); }
  .lf-cardd ol, .lf-cardd p { flex: 1; margin: 0; padding: 0; list-style: none; display: grid; gap: 8px; font-size: 14px; }
  .lf-label { display: block; margin-top: 20px; font-size: 14px; font-weight: 600; }
  .lf-input { width: 100%; min-height: 72px; margin-top: 6px; padding: 12px; border: 1px solid var(--stone); border-radius: 14px; background: var(--paper); color: var(--ink); font: inherit; font-size: 15px; resize: vertical; outline: none; }
  .lf-input:focus { border-color: var(--ink); }
  .lf-notas { margin: 6px 0 0 !important; font-size: 15px !important; line-height: 22px !important; color: var(--ink) !important; }
  .lf-aviso { display: grid; gap: 10px; margin-top: 16px; padding: 14px; border-radius: 14px; background: var(--sand); }
  .lf-aviso div { display: flex; gap: 10px; align-items: flex-start; font-size: 14px; line-height: 20px; }
  .lf-row { display: flex; align-items: center; gap: 12px; width: 100%; margin-top: 18px; padding: 16px; border: 1px solid var(--stone); border-radius: 18px; background: var(--paper); color: var(--ink); text-align: left; font-size: 15px; font-weight: 600; transition: border-color .15s; }
  .lf-row:hover { border-color: var(--ink); }
  .lf-row span { flex: 1; min-width: 0; }
  .lf-row small { display: block; margin-top: 3px; font-size: 13px; font-weight: 400; color: var(--graphite); }
  .lf-row .lf-row-ic { flex: 0 0 44px; height: 44px; border-radius: 12px; background: var(--sand); display: flex; align-items: center; justify-content: center; }
  .lf-row > svg:last-child { color: var(--graphite); }
  .lf-num { display: flex; align-items: baseline; gap: 10px; margin-top: 22px; }
  .lf-num b { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 56px; line-height: 1; letter-spacing: -2px; }
  .lf-num span { font-size: 15px; color: var(--graphite); }
  .lf-rec { display: flex; gap: 12px; align-items: flex-start; margin-top: 14px; padding: 14px 16px; border: 1px solid var(--stone); border-radius: 16px; background: var(--paper); }
  .lf-rec i { flex: 0 0 8px; height: 8px; margin-top: 6px; border-radius: 50%; background: var(--rose-500, #c85050); }
  .lf-rec b { display: block; font-size: 14.5px; }
  .lf-rec small { display: block; margin-top: 2px; font-size: 13px; line-height: 18px; color: var(--graphite); }
  .lf-secao { margin: 28px 0 0; font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 18px; }
  .lf-center { display: flex; align-items: center; justify-content: center; min-height: 60vh; color: var(--graphite); font-size: 15px; text-align: center; padding: 20px; }
  .lf-lightbox { position: fixed; inset: 0; z-index: 1600; background: rgba(26,22,18,.92); display: none; flex-direction: column; align-items: center; justify-content: center; gap: 12px; padding: 20px; cursor: zoom-out; }
  .lf-lightbox.is-on { display: flex; }
  .lf-lightbox img { max-width: 100%; max-height: 80vh; border-radius: 12px; }
  .lf-lightbox span { color: var(--cream); font-size: 14px; }
  .lf-toast { position: fixed; left: 50%; bottom: 28px; z-index: 1700; transform: translate(-50%, 12px); max-width: calc(100vw - 32px); padding: 13px 18px; border-radius: 14px; background: var(--ink); color: var(--cream); font-size: 13.5px; opacity: 0; pointer-events: none; transition: opacity .2s, transform .2s; }
  .lf-toast.is-on { opacity: 1; transform: translate(-50%, 0); }
  @media (prefers-reduced-motion: reduce) { .lf-sheet { animation: none; } }
</style>

<div class="lf" id="lf" aria-hidden="true">
  <div class="lf-v lf-sheetv" id="lf-sheet"></div>
  <div class="lf-v lf-dark" id="lf-fotos"></div>
  <div class="lf-v" id="lf-desenho"></div>
  <div class="lf-v" id="lf-revisar"></div>
  <div class="lf-v" id="lf-detalhe"></div>
  <div class="lf-v" id="lf-historico"></div>
  <input type="file" accept="image/*" capture="environment" class="lf-file" id="lf-file" tabindex="-1" aria-hidden="true">
</div>
<div class="lf-lightbox" id="lf-lightbox" role="dialog" aria-label="Foto da ficha"></div>
<div class="lf-toast" id="lf-toast" role="status"></div>

<script>
(function () {
  var CSRF = (document.querySelector('meta[name="csrf-token"]') || {}).content;
  var FOTOS = [
    { label: 'front', nome: 'Frente' }, { label: 'rear', nome: 'Traseira' },
    { label: 'left', nome: 'Lado esquerdo' }, { label: 'right', nome: 'Lado direito' }
  ];
  var MAX_DETALHES = 4;
  var TIPOS = [
    { kind: 'risco', nome: 'Risco' }, { kind: 'amassado', nome: 'Amassado' },
    { kind: 'trincado', nome: 'Trincado' }, { kind: 'outro', nome: 'Outro' }
  ];
  var FLAGS = {
    escura: 'Foto escura', estourada: 'Foto com reflexo', tremida: 'Foto tremida',
    sem_carro: 'Sem carro na foto', outro_lado: 'Outro lado do carro', sem_nitidez: 'Pouco nítida'
  };
  var MESES = ['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];
  var ULTIMO = 'ficha_ultimo_modo';

  function $(id) { return document.getElementById(id); }
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
  function ic(n, size, extra) { return window.feather && feather.icons[n] ? feather.icons[n].toSvg(Object.assign({ width: size || 18, height: size || 18 }, extra || {})) : ''; }
  function nomeAvaria(k) { var t = TIPOS.filter(function (x) { return x.kind === k; })[0]; return t ? t.nome : 'Avaria'; }
  function nomeFoto(l) { if (l === 'detail') return 'Detalhe'; var f = FOTOS.filter(function (x) { return x.label === l; })[0]; return f ? f.nome : l; }
  function nomeFlag(f) { return FLAGS[f] || 'Fora do padrão'; }
  function limparPlaca(p) { return String(p || '').toUpperCase().replace(/[^A-Z0-9]/g, '').slice(0, 7); }
  function placaValida(p) { return /^[A-Z]{3}[0-9][A-Z0-9][0-9]{2}$/.test(limparPlaca(p)); }
  function fmtPlaca(p) { p = String(p || '').toUpperCase().trim(); return /^[A-Z]{3}[0-9]{4}$/.test(p) ? p.slice(0, 3) + '-' + p.slice(3) : p; }
  function placaHtml(p, big) { return '<span class="lf-placa' + (big ? ' is-big' : '') + '" aria-label="Placa ' + esc(fmtPlaca(p) || 'não informada') + '"><i></i><b>' + esc(fmtPlaca(p) || '———') + '</b></span>'; }
  function fmtQuando(iso) {
    var d = new Date(iso), z = function (n) { return String(n).padStart(2, '0'); };
    return z(d.getDate()) + '/' + z(d.getMonth() + 1) + '/' + d.getFullYear() + ' às ' + z(d.getHours()) + ':' + z(d.getMinutes());
