      marks.map(function (m, i) {
        return '<button type="button" class="lf-ponto' + (i === sel ? ' is-sel' : '') + '" data-ponto="' + i + '" style="left:' + (m.x * 100) + '%;top:' + (m.y * 100) + '%"' + (tap ? '' : ' tabindex="-1" disabled') + ' aria-label="Ponto ' + (i + 1) + '">' + (m.n || i + 1) + '</button>';
