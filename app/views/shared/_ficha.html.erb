  .lf-cam.is-flash::after { content: ''; position: absolute; inset: 0; z-index: 2; background: #fff; animation: lf-flash .25s ease-out forwards; }
  @keyframes lf-flash { from { opacity: .8; } to { opacity: 0; } }
  .lf-cam.is-pronto { flex-direction: column; gap: 10px; }
