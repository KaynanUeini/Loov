<%#
  Tela de "Agendado": a do agendamento comum (página do lava-rápido) e a do
  Last Minute aceito (espera em /disponivel). Uma só, pra reserva confirmada
  ter a mesma cara venha de onde vier — no app é o ConfirmacaoAgendamento.
  O Last Minute acrescenta o selo, o que já saiu do cartão e o aviso de que
  esse valor não volta se o cliente não for.

  window.LoovConfirmacao.html(o)
    quando, cw, servico ({ title, duration })
    cancelaAte    "17:00": até quando cancelar sem custo (agendamento comum)
    lastMinute    selo da aba ao lado de QUANDO
    pagoCartao    o que já saiu do cartão (sinal ou os 35%); pagoLabel
    aPagar        o que falta pagar no lava-rápido; comVale; valeTxt
    aviso         regra que o cliente precisa levar
    homeUrl
  Precisa do feather e do shared/loov_logos na página.

  window.LoovConfirmacao.montar(raiz, origem)
    Depois de pôr o html na página: monta o mapa do cartão "Como vai ser"
    (só no computador, com o Leaflet carregado). Com `origem` ({ lat, lng },
    de onde o cliente veio) ou a localização já liberada no navegador,
    desenha a rota de carro até o lava-rápido e diz o tempo (GET /rota).
%>
<style>
  /* Tudo tem que caber na tela sem rolar, botões inclusive. */
  .ok { max-width: 480px; margin: 0 auto; padding: 20px 20px 24px; }
  .ok-head { text-align: center; }
  .ok-check { width: 64px; height: 64px; margin: 0 auto 12px; border-radius: 50%; background: var(--coral-500); color: var(--cream); display: flex; align-items: center; justify-content: center; animation: okpop .5s cubic-bezier(.2,1.4,.4,1) both; }
  @keyframes okpop { from { transform: scale(.4); opacity: 0; } }
  .ok-title { margin: 0 !important; font-family: 'Space Grotesk', sans-serif !important; font-weight: 700; font-size: 32px; line-height: 36px; letter-spacing: -1px; color: var(--ink) !important; }
  /* Um acento só por tela: o coral fica no check; a frase de apoio é graphite. */
  .ok-title em { display: block; margin-top: 2px; font-style: normal; font-size: 17px; line-height: 22px; letter-spacing: -0.3px; color: var(--graphite); }
  .ok-card { margin-top: 18px; padding: 16px; background: var(--paper); border: 1px solid var(--stone); border-radius: 20px; }
  .ok-lab-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .ok-lab { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 1px; color: var(--ash); }
  .ok-when { margin-top: 2px; font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 22px; letter-spacing: -0.5px; }
  /* Ações de apoio no cartão, lado a lado: pílulas de contorno tinta (padrão Loov). */
  .ok-pills { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
  .ok-pill { display: inline-flex; align-items: center; gap: 6px; height: 36px; padding: 0 14px; border-radius: 999px; border: 1.5px solid var(--ink); color: var(--ink) !important; font-size: 13px; font-weight: 600; text-decoration: none; transition: background .15s; }
  .ok-pill:hover { background: var(--sand); }
  .ok-pills { align-items: center; }
  .ok-tempo-m { font-size: 13px; color: var(--graphite); }
  .ok-addr { margin-top: 8px; font-size: 12.5px; line-height: 17px; color: var(--graphite); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .ok-pay { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; font-size: 14px; color: var(--graphite); }
  .ok-pay + .ok-pay { margin-top: 6px; }
  .ok-pay b { display: inline-flex; align-items: center; gap: 6px; font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 20px; letter-spacing: -0.5px; color: var(--ink); white-space: nowrap; }
  .ok-pay.is-sub b { font-size: 15px; font-weight: 600; letter-spacing: 0; }
  .ok-vale { margin: 4px 0 0; font-size: 12px; color: var(--graphite); }
  .ok-div { height: 1px; background: var(--stone); margin: 12px 0; }
  .ok-shop { display: flex; align-items: center; gap: 10px; }
  .ok-logo { flex: 0 0 40px; height: 40px; }
  .ok-logo svg { width: 100%; height: 100%; display: block; }
  .ok-shop-t { flex: 1; min-width: 0; }
  .ok-shop-t b, .ok-shop-t small { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ok-shop-t b { font-size: 14px; font-weight: 600; }
  .ok-shop-t small { margin-top: 2px; font-size: 12px; color: var(--graphite); }
  .ok-actions { display: grid; gap: 8px; margin-top: 16px; }
  /* Nada a efetivar aqui, só caminhos: o principal em tinta cheia (o preto da
     Nike), o outro em contorno. Coral fica pra quem confirma. */
  .ok-primary { display: block; padding: 15px; border-radius: 28px; background: var(--ink); color: var(--cream) !important; text-align: center; font-size: 16px; font-weight: 600; text-decoration: none; transition: transform .15s; }
  .ok-primary:hover { transform: translateY(-1px); }
  .ok-ghost { display: block; padding: 13.5px; border-radius: 28px; border: 1.5px solid var(--ink); text-align: center; color: var(--ink) !important; font-size: 16px; font-weight: 600; text-decoration: none; transition: background .15s; }
  .ok-ghost:hover { background: var(--sand); }
  /* Last Minute: o selo da aba, no tamanho do rótulo. */
  .ok-lm { display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 100px; background: var(--coral-500); color: var(--cream); font-size: 11px; font-weight: 600; }
  .ok-lm svg { display: block; }
  .ok-aviso { margin: 8px 0 0; font-size: 12px; line-height: 16px; color: var(--graphite); }
  /* Tela baixa: o check vai pro lado do título em vez de ficar em cima. */
  @media (max-height: 740px) {
    .ok { padding-top: 14px; }
    .ok-head { display: flex; align-items: center; gap: 14px; text-align: left; }
    .ok-check { flex: 0 0 48px; width: 48px; height: 48px; margin: 0; }
    .ok-check svg { width: 24px; height: 24px; }
    .ok-card { margin-top: 14px; }
  }
  /* Bem baixa: aperta os respiros e os botões. */
  @media (max-height: 680px) {
    .ok { padding-top: 10px; padding-bottom: 14px; }
    .ok-check { flex-basis: 40px; width: 40px; height: 40px; }
    .ok-title { font-size: 28px; line-height: 32px; }
    .ok-title em { font-size: 15px; line-height: 19px; }
    .ok-card { margin-top: 10px; padding: 12px 14px; }
    .ok-div { margin: 9px 0; }
    .ok-when { font-size: 20px; }
    .ok-pills { margin-top: 8px; }
    .ok-pill { height: 32px; }
    .ok-actions { margin-top: 10px; }
    .ok-primary { padding: 12px; }
    .ok-ghost { padding: 10.5px; }
  }
  @media (max-width: 360px) {
    .ok { padding-left: 16px; padding-right: 16px; }
    .ok-card { padding-left: 12px; padding-right: 12px; }
    .ok-pills { gap: 6px; }
    .ok-pill { padding: 0 11px; font-size: 12.5px; }
  }
  /* Cartão "Como vai ser": só no computador (abaixo). */
  .ok-lado { display: none; }
  /* Computador com mouse: a coluna de sempre à esquerda, e o espaço que
     sobrava responde "e agora?": mapa, rota e como vai ser a chegada, o
     pagamento e o cancelamento. Celular igual, cabendo sem rolar. */
  @media (min-width: 1024px) and (hover: hover) and (pointer: fine) {
    .ok { max-width: 1000px; display: grid; grid-template-columns: 440px 520px; grid-template-rows: auto auto auto 1fr; column-gap: 40px; justify-content: center; align-content: start; align-items: start; padding-top: 40px; }
    .ok-head, .ok-card, .ok-actions { grid-column: 1; }
    .ok-head { display: flex; align-items: center; gap: 14px; text-align: left; }
    .ok-check { flex: 0 0 56px; width: 56px; height: 56px; margin: 0; }
    .ok-check svg { width: 28px; height: 28px; }
    .ok .ok-addr, .ok .ok-pills, .ok .ok-aviso { display: none; }
    .ok-lado { display: block; grid-column: 2; grid-row: 1 / span 4; align-self: start; overflow: hidden; background: var(--paper); border: 1px solid var(--stone); border-radius: 24px; }
    /* isolation: as camadas do Leaflet (z-index 400 a 1000) ficam dentro
       do mapa; sem isto o mapa passava por cima do menu ao rolar. */
    .ok-mapa { position: relative; z-index: 0; isolation: isolate; height: 250px; background: var(--sand); }
    .ok-mapa .leaflet-bar { border: 1px solid var(--stone); box-shadow: 0 2px 8px rgba(40,35,28,.12); border-radius: 10px; overflow: hidden; }
    .ok-mapa .leaflet-bar a { width: 32px; height: 32px; line-height: 32px; color: var(--ink); display: flex; align-items: center; justify-content: center; }
    .ok-mapa .leaflet-bar a:hover { background: var(--sand); }
    .ok-mapa-dica { position: absolute; inset: 0; z-index: 1000; display: flex; align-items: center; justify-content: center; background: rgba(26,22,18,.45); color: var(--cream); font-size: 14px; font-weight: 600; opacity: 0; pointer-events: none; transition: opacity .2s; }
    .ok-mapa-dica.is-on { opacity: 1; }
    .ok-mapa .leaflet-tile-pane { filter: grayscale(1) sepia(.18) contrast(.92) brightness(1.03); }
    .ok-mapa .leaflet-control-attribution { font-size: 9px; background: rgba(250,250,246,.8); }
    /* Você: o ponto azul de "você está aqui", o mesmo do mapa da lista. */
    .ok-voce { width: 16px; height: 16px; border-radius: 50%; background: var(--pool-500, #4b8ec0); border: 3px solid #fff; box-shadow: 0 0 0 7px rgba(75,142,192,.25); }
    .ok-tempo { color: var(--ink); font-weight: 600; }
    /* Lava-rápido: pino em gota com o ícone de lava-rápido (carro e gotas),
       pra não confundir com o ponto de quem vai. A ponta marca o lugar. */
    .ok-pino { position: relative; width: 38px; height: 38px; border-radius: 50% 50% 50% 0; transform: rotate(-45deg); background: var(--coral-500); border: 3px solid #fff; box-shadow: 0 3px 10px rgba(0,0,0,.35); }
    .ok-pino svg { position: absolute; left: 50%; top: 50%; width: 20px; height: 20px; margin: -10px 0 0 -10px; transform: rotate(45deg); color: #fff; }
    .ok-lado-in { padding: 18px 22px 22px; }
    .ok-end { display: flex; align-items: center; justify-content: space-between; gap: 14px; }
    .ok-end b { display: block; font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 16px; }
    .ok-end small { display: block; margin-top: 2px; font-size: 13px; color: var(--graphite); }
    .ok-rota { flex-shrink: 0; display: inline-flex; align-items: center; gap: 6px; height: 38px; padding: 0 16px; border-radius: 999px; background: var(--ink); color: var(--cream) !important; font-size: 13.5px; font-weight: 600; text-decoration: none; }
    .ok-rota:hover { background: #3a342b; }
    .ok-como { margin: 16px 0 10px !important; padding-top: 14px; border-top: 2px solid var(--ink); font-family: 'Space Grotesk', sans-serif !important; font-weight: 700; font-size: 18px; color: var(--ink) !important; }
    .ok-passos { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
    .ok-passos li { display: grid; grid-template-columns: 10px 1fr; gap: 12px; font-size: 14.5px; line-height: 1.5; color: var(--graphite); }
    .ok-passos li::before { content: ''; width: 10px; height: 10px; margin-top: 6px; border-radius: 50%; background: var(--coral-500); }
    .ok-passos b { color: var(--ink); font-weight: 600; }
  }
  @media (prefers-reduced-motion: reduce) { .ok-check { animation: none; } }
</style>
<script>
(function () {
  if (window.LoovConfirmacao) return;
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
  function icon(n, size, extra) { return window.feather && feather.icons[n] ? feather.icons[n].toSvg(Object.assign({ width: size, height: size }, extra || {})) : ''; }
  function money(v, d) { var n = Number(v); return isFinite(n) ? n.toFixed(d || 0).replace('.', ',') : '—'; }
  function rota(cw) {
    // Com número, o endereço completo leva ao número exato (a coordenada é do meio da rua).
    var lat = cw.lat != null ? cw.lat : cw.latitude, lng = cw.lng != null ? cw.lng : cw.longitude;
    var q = cw.route_address || (lat != null && lng != null ? lat + ',' + lng : [cw.logradouro || cw.address, cw.bairro, cw.cidade].filter(Boolean).join(', '));
    return q ? 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(q) : null;
  }
  function html(o) {
    var cw = o.cw, s = o.servico;
    var endereco = cw.route_address || (cw.logradouro ? cw.logradouro + (cw.numero ? ', ' + cw.numero : '') + (cw.bairro ? ' · ' + cw.bairro : '') : cw.address);
    var presente = o.comVale ? icon('gift', 15) : '';
    var mapa = rota(cw);
    // Como pagar fica sempre dito: sem isso o cliente fica com o "já paguei?".
    var pagamento = (o.pagoCartao ? '<div class="ok-pay is-sub"><span>' + esc(o.pagoLabel || 'Sinal pago no cartão') + '</span><b>R$ ' + money(o.pagoCartao, 2) + '</b></div>' : '') +
      '<div class="ok-pay"><span>' + (o.aPagar > 0 ? 'Você paga no lava-rápido' : o.comVale ? 'Pago com o vale' : 'Nada a pagar na chegada') + '</span><b>' + presente + 'R$ ' + money(o.aPagar, 2) + '</b></div>';
    return '<div class="ok">' +
      '<div class="ok-head"><div class="ok-check">' + icon('check', 32, { 'stroke-width': 3 }) + '</div>' +
      '<h1 class="ok-title">Agendado<em>Seu carro te agradece</em></h1></div>' +
      '<div class="ok-card">' +
        '<div class="ok-lab-row"><div class="ok-lab">QUANDO</div>' + (o.lastMinute ? '<span class="ok-lm">' + icon('zap', 11) + 'last minute</span>' : '') + '</div>' +
        '<div class="ok-when">' + esc(o.quando) + '</div>' +
        '<div class="ok-div"></div>' +
        '<div class="ok-shop"><div class="ok-logo">' + (window.LoovLogos ? LoovLogos.logoOf(cw) : '') + '</div>' +
          '<div class="ok-shop-t"><b>' + esc(cw.name) + '</b><small>' + esc(s.title) + ' · ' + (s.duration || 30) + ' min</small></div></div>' +
        // O próximo passo do cliente é ir até lá.
        (endereco ? '<div class="ok-addr">' + esc(endereco) + '</div>' : '') +
        // Sem "Adicionar à agenda": o .ics abria como texto no navegador.
        // No celular não há mapa: o tempo de carro vem ao lado do Ver rota.
        (mapa ? '<div class="ok-pills"><a class="ok-pill" target="_blank" rel="noopener" href="' + mapa + '">' + icon('navigation', 14) + 'Ver rota</a><span class="ok-tempo-m" hidden></span></div>' : '') +
        '<div class="ok-div"></div>' + pagamento +
        (o.valeTxt ? '<p class="ok-vale">' + esc(o.valeTxt) + '</p>' : '') +
        (o.aviso ? '<p class="ok-aviso">' + esc(o.aviso) + '</p>' : '') +
      '</div>' +
      '<div class="ok-actions"><a class="ok-primary" href="/appointments">Ver meus agendamentos</a><a class="ok-ghost" href="' + esc(o.homeUrl || '/') + '">Voltar pra home</a></div>' +
      ladoHtml(o, mapa) +
    '</div>';
  }
  function coords(cw) {
    var lat = cw.lat != null ? cw.lat : cw.latitude, lng = cw.lng != null ? cw.lng : cw.longitude;
    return lat != null && lng != null ? [Number(lat), Number(lng)] : null;
  }
  // O que o cliente precisa saber depois de agendar, que antes estava
  // espalhado: o código de conferência (só em Meus agendamentos), o que paga
  // lá e até quando cancelar (só antes de confirmar).
  function ladoHtml(o, mapa) {
    var cw = o.cw, c = coords(cw);
    var rua = cw.logradouro ? cw.logradouro + (cw.numero ? ', ' + cw.numero : '') : (cw.address || '');
    var sub = [cw.bairro, cw.cidade].filter(Boolean).join(' · ') + (cw.distance_km != null ? ' · a ' + Number(cw.distance_km).toFixed(1).replace('.', ',') + ' km de você' : '');
    var pagar = o.aPagar > 0
      ? '<b>Pague R$ ' + money(o.aPagar, 2) + ' lá:</b> dinheiro, PIX ou cartão.' + (o.pagoCartao ? ' Os R$ ' + money(o.pagoCartao, 2) + ' do cartão já foram pagos.' : '')
      : '<b>Nada a pagar na chegada.</b>' + (o.pagoCartao ? ' Os R$ ' + money(o.pagoCartao, 2) + ' já foram pagos no cartão.' : '');
    var cancelar = o.lastMinute
      ? (o.aviso ? esc(o.aviso).replace(/^([^.]*\.)/, '<b>$1</b>') : '')
      : o.cancelaAte ? '<b>Cancelamento grátis até ' + esc(o.cancelaAte) + '</b> (2 h antes). Falta sem cancelar conta contra você.' : '';
    return '<div class="ok-lado">' +
      (c ? '<div class="ok-mapa" data-lat="' + c[0] + '" data-lng="' + c[1] + '" data-cw="' + esc(cw.id) + '"></div>' : '') +
      '<div class="ok-lado-in">' +
        '<div class="ok-end"><span><b>' + esc(rua) + '</b>' + (sub ? '<small>' + esc(sub) + '</small>' : '') + '</span>' +
          (mapa ? '<a class="ok-rota" target="_blank" rel="noopener" href="' + mapa + '">' + icon('navigation', 14) + 'Ver rota</a>' : '') + '</div>' +
        '<h2 class="ok-como">Como vai ser</h2><ul class="ok-passos">' +
          '<li><span><b>Na chegada, confirme o código.</b> São os 4 últimos dígitos do seu celular; ele aparece em Meus agendamentos 15 min antes.</span></li>' +
          '<li><span>' + pagar + '</span></li>' +
          (cancelar ? '<li><span>' + cancelar + '</span></li>' : '') +
        '</ul></div></div>';
  }
  // Ícone de lava-rápido: um carro de frente com gotas em cima.
  var LAVA_IC = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' +
    '<path d="M4 17v-3.2l1.6-3.6A2 2 0 0 1 7.4 9h9.2a2 2 0 0 1 1.8 1.2L20 13.8V17"/><path d="M3 17h18v2.2a.8.8 0 0 1-.8.8h-1.4a.8.8 0 0 1-.8-.8V19H6v.2a.8.8 0 0 1-.8.8H3.8a.8.8 0 0 1-.8-.8z"/>' +
    '<circle cx="7.5" cy="15" r=".6" fill="currentColor"/><circle cx="16.5" cy="15" r=".6" fill="currentColor"/>' +
    '<path d="M8 2.5s-1.4 1.6-1.4 2.5a1.4 1.4 0 0 0 2.8 0C9.4 4.1 8 2.5 8 2.5z"/><path d="M16 2.5s-1.4 1.6-1.4 2.5a1.4 1.4 0 0 0 2.8 0c0-.9-1.4-2.5-1.4-2.5z"/><path d="M12 1.5s-1.2 1.4-1.2 2.2a1.2 1.2 0 0 0 2.4 0c0-.8-1.2-2.2-1.2-2.2z"/></svg>';
  // De onde o cliente sai: a origem da página (a lista manda a localização)
  // ou a do navegador, só se já estiver liberada. Pedir permissão aqui seria
  // um susto logo depois de agendar.
  function comOrigem(origem, vai) {
    if (origem && origem.lat != null) { vai({ lat: Number(origem.lat), lng: Number(origem.lng) }); return; }
    if (!navigator.permissions || !navigator.geolocation) return;
    navigator.permissions.query({ name: 'geolocation' }).then(function (p) {
      if (p.state !== 'granted') return;
      navigator.geolocation.getCurrentPosition(function (pos) { vai({ lat: pos.coords.latitude, lng: pos.coords.longitude }); }, function () {}, { maximumAge: 300000, timeout: 8000 });
    }).catch(function () {});
  }
  // O tempo total, com o trânsito já dentro (o TomTom devolve assim):
  // "14 min de carro". Sem dado de trânsito (a reserva, OpenRouteService),
  // é estimativa: "≈ 12 min de carro".
  function tempoTxt(d) {
    var min = Math.max(1, Math.round(d.duracao_s / 60));
    return (d.transito ? '' : '≈ ') + min + ' min de carro';
  }
  function buscaRota(cw, o) {
    return fetch('/rota?car_wash_id=' + encodeURIComponent(cw) + '&lat=' + o.lat + '&lng=' + o.lng, { credentials: 'same-origin', headers: { Accept: 'application/json' } })
      .then(function (r) { return r.status === 200 ? r.json() : null; });
  }
  function montar(raiz, origem) {
    var r = raiz || document, el = r.querySelector('.ok-mapa');
    if (!el) return;
    // Celular e tablet: sem mapa, só o tempo de carro ao lado do Ver rota.
    if (!window.L || el.offsetParent === null) {
      var t = r.querySelector('.ok-tempo-m');
      if (!t || el._tempo) return;
      el._tempo = true;
      comOrigem(origem, function (o) {
        if (!isFinite(o.lat) || !isFinite(o.lng)) return;
        buscaRota(el.dataset.cw, o).then(function (d) {
          if (!d || !d.duracao_s) return;
          t.textContent = tempoTxt(d);
          t.hidden = false;
        }).catch(function () {});
      });
      return;
    }
    if (el._mapa) return;
    var c = [Number(el.dataset.lat), Number(el.dataset.lng)];
    // Dá pra olhar a rota de perto: botões + e −, arrastar e duplo clique.
    // A rodinha só com Ctrl (⌘ no Mac), senão quem rola a página por cima
    // do mapa dava zoom sem querer; sem a tecla, aparece a dica.
    var m = L.map(el, { zoomControl: false, dragging: true, scrollWheelZoom: false, doubleClickZoom: true, boxZoom: false, keyboard: true, touchZoom: true }).setView(c, 15);
    m.attributionControl.setPrefix(false);
    L.control.zoom({ position: 'topright', zoomInTitle: 'Aproximar', zoomOutTitle: 'Afastar' }).addTo(m);
    el._vista = function () { m.setView(c, 15); };
    var Centro = L.Control.extend({ options: { position: 'topright' }, onAdd: function () {
      var b = L.DomUtil.create('div', 'leaflet-bar ok-centro');
      b.innerHTML = '<a href="#" role="button" title="Ver a rota inteira" aria-label="Ver a rota inteira">' + icon('maximize', 14) + '</a>';
      L.DomEvent.on(b, 'click', function (e) { L.DomEvent.preventDefault(e); L.DomEvent.stopPropagation(e); el._vista(); });
      return b;
    } });
    new Centro().addTo(m);
    var mac = /Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent);
    var dica = L.DomUtil.create('div', 'ok-mapa-dica', el);
    dica.textContent = 'Use ' + (mac ? '⌘' : 'Ctrl') + ' + rolagem para dar zoom';
    var dicaT = null;
    el.addEventListener('wheel', function (e) {
      if (e.ctrlKey || e.metaKey) {
        e.preventDefault();
        m.setZoomAround(m.mouseEventToContainerPoint(e), m.getZoom() + (e.deltaY < 0 ? 1 : -1));
        return;
      }
      dica.classList.add('is-on');
      clearTimeout(dicaT); dicaT = setTimeout(function () { dica.classList.remove('is-on'); }, 1400);
    }, { passive: false });
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19, attribution: '© OpenStreetMap' }).addTo(m);
    L.marker(c, { title: 'Lava-rápido', zIndexOffset: 1000, icon: L.divIcon({ className: '', html: '<div class="ok-pino">' + LAVA_IC + '</div>', iconSize: [38, 38], iconAnchor: [19, 46] }) }).addTo(m);
    el._mapa = m;
    // A tela pode mudar de tamanho logo depois (a cortina do Last Minute):
    // sem isto parte do mapa ficava sem desenhar.
    try { new ResizeObserver(function () { m.invalidateSize(); }).observe(el); } catch (e) { setTimeout(function () { m.invalidateSize(); }, 900); }
    comOrigem(origem, function (o) { if (o && isFinite(o.lat) && isFinite(o.lng)) desenhaRota(m, el, r, o); });
  }
  // A rota se desenha da sua posição até o pino, e o tempo de carro entra ao
  // lado do endereço. Sem rota (serviço fora, cota), fica o mapa com o pino.
  function desenhaRota(m, el, raiz, o) {
    buscaRota(el.dataset.cw, o)
      .then(function (d) {
        if (!d || !d.pontos || d.pontos.length < 2) return;
        var p = d.pontos;
        m.fitBounds(p, { padding: [34, 34] });
        el._vista = function () { m.fitBounds(p, { padding: [34, 34] }); };
        L.marker(p[0], { title: 'Você', icon: L.divIcon({ className: '', html: '<div class="ok-voce"></div>', iconSize: [16, 16], iconAnchor: [8, 8] }) }).addTo(m);
        var linha = L.polyline([], { color: '#dd7852', weight: 5, opacity: .95, lineCap: 'round', lineJoin: 'round' }).addTo(m);
        var t = raiz.querySelector('.ok-end small');
        if (t && d.duracao_s) t.insertAdjacentHTML('beforeend', ' · <b class="ok-tempo">' + esc(tempoTxt(d)) + '</b>');
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { linha.setLatLngs(p); return; }
        var t0 = null, dur = 1400;
        var passo = function (agora) {
          if (t0 == null) t0 = agora;
          var f = Math.min(1, (agora - t0) / dur), e = f < .5 ? 2 * f * f : 1 - Math.pow(-2 * f + 2, 2) / 2;
          linha.setLatLngs(p.slice(0, Math.max(2, Math.ceil(e * p.length))));
          if (f < 1) requestAnimationFrame(passo);
        };
        setTimeout(function () { requestAnimationFrame(passo); }, 350);
      })
      .catch(function () {});
  }
  window.LoovConfirmacao = { html: html, montar: montar };
})();
</script>
