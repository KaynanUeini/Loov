<div class="loov-center-page">
  <div class="loov-center-card">
    <div class="loov-eyebrow"><span class="dot"></span>DESBLOQUEAR CONTA</div>
    <h1 class="loov-h1" style="font-size:clamp(28px,4.5vw,38px);">
      Reenviar <span class="accent">desbloqueio</span>.
    </h1>
    <p class="loov-lead">
      Informe seu e-mail e reenviaremos as instruções para desbloquear sua conta.
    </p>

    <%= form_for(resource, as: resource_name, url: unlock_path(resource_name), html: { method: :post, style: "text-align:left;" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="loov-field">
        <%= f.label :email, "E-mail", class: "loov-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
            class: "loov-input", placeholder: "seu@email.com" %>
      </div>

      <%= f.submit "Reenviar instruções", class: "loov-btn-primary loov-btn-block loov-btn-lg", style: "margin-top:12px;" %>
    <% end %>

    <div class="loov-footer-row">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
