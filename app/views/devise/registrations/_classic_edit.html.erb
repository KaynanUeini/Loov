<div class="loov-page loov-page--narrow">
  <div class="loov-hero">
    <div class="loov-eyebrow"><span class="dot"></span>MINHA CONTA</div>
    <h1 class="loov-h1">
      Editar <span class="accent">conta</span>.
    </h1>
    <p class="loov-lead">
      Atualize seu e-mail ou troque sua senha. Precisamos da senha atual para confirmar as alterações.
    </p>
  </div>

  <div class="loov-card loov-card--lg">
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="loov-field">
        <%= f.label :email, "E-mail", class: "loov-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "loov-input" %>
      </div>

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <div class="loov-help" style="margin-bottom:16px;">
          Aguardando confirmação para: <strong><%= resource.unconfirmed_email %></strong>
        </div>
      <% end %>

      <hr class="loov-divider">

      <div class="loov-field">
        <%= f.label :password, "Nova senha", class: "loov-label" %>
        <%= f.password_field :password, autocomplete: "new-password",
            class: "loov-input", placeholder: "Deixe em branco se não quiser alterar" %>
        <% if @minimum_password_length %>
          <div class="loov-help">Mínimo <%= @minimum_password_length %> caracteres.</div>
        <% end %>
      </div>

      <div class="loov-field">
        <%= f.label :password_confirmation, "Confirmar nova senha", class: "loov-label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "loov-input" %>
      </div>

      <hr class="loov-divider">

      <div class="loov-field">
        <%= f.label :current_password, "Senha atual", class: "loov-label" %>
        <%= f.password_field :current_password, autocomplete: "current-password",
            class: "loov-input", placeholder: "Necessária para confirmar as alterações" %>
      </div>

      <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:8px;">
        <%= f.submit "Atualizar conta", class: "loov-btn-primary loov-btn-lg" %>
        <%= link_to "Voltar", :back, class: "loov-btn-secondary loov-btn-lg" %>
      </div>
    <% end %>
  </div>

  <div class="loov-card" style="margin-top:24px;border-color:rgba(200,80,80,0.2);background:#fdf6f6;">
    <h3 class="loov-card-title" style="color:#c85050;">Cancelar minha conta</h3>
    <p class="loov-card-text" style="margin-bottom:16px;">
      Esta ação é permanente. Todos os seus dados serão removidos.
    </p>
    <%= button_to "Cancelar minha conta", registration_path(resource_name),
        data: { confirm: "Tem certeza? Esta ação não pode ser desfeita.",
                turbo_confirm: "Tem certeza? Esta ação não pode ser desfeita." },
        method: :delete,
        class: "loov-btn-secondary",
        style: "border-color:rgba(200,80,80,0.3);color:#c85050;" %>
  </div>
</div>
