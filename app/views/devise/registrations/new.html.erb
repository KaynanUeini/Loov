<style>
  .reg-role-grid {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 10px; margin-bottom: 20px;
  }
  .reg-role-input { display: none; }
  .reg-role-card {
    display: flex; flex-direction: column; gap: 4px;
    background: var(--paper);
    border: 1px solid var(--stone);
    border-radius: 14px;
    padding: 14px 16px;
    cursor: pointer;
    transition: border-color .15s ease, background .15s ease, box-shadow .15s ease;
    user-select: none;
  }
  .reg-role-card:hover { border-color: var(--coral-100); background: var(--cream); }
  .reg-role-input:checked + .reg-role-card {
    border-color: var(--coral-500);
    background: var(--coral-50);
    box-shadow: 0 0 0 3px rgba(220,120,82,0.08);
  }
  .reg-role-title {
    font-size: 14.5px; font-weight: 600; color: var(--ink);
    display: flex; align-items: center; gap: 8px;
  }
  .reg-role-title i { color: var(--coral-500); font-size: 13px; }
  .reg-role-desc { font-size: 12px; color: var(--graphite); line-height: 1.4; }

  .reg-step-list {
    margin-top: 32px; padding-top: 24px;
    border-top: 1px solid var(--stone);
    display: flex; flex-direction: column; gap: 12px;
    position: relative;
  }
  .reg-step-row { display: flex; align-items: center; gap: 14px; font-size: 14px; color: var(--graphite); }
  .reg-step-num {
    width: 26px; height: 26px; border-radius: 50%;
    border: 1.5px solid var(--coral-300);
    display: inline-flex; align-items: center; justify-content: center;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 13px; font-weight: 700; color: var(--coral-700);
    flex-shrink: 0;
    background: var(--coral-50);
  }

  .client-fields { display: none; }
  .client-fields.visible { display: contents; }
</style>

<div class="loov-auth">

  <!-- ── EDITORIAL ──────────────────────────────────── -->
  <aside class="loov-auth-editorial">
    <div class="loov-eyebrow"><span class="dot"></span>BEM-VINDO À LOOV</div>
    <h1 class="loov-h1" style="text-align:left;">
      Crie sua<br><span class="accent">conta</span>.
    </h1>
    <p class="loov-lead" style="margin-left:0;text-align:left;">
      Escolha seu perfil e comece a usar a Loov em menos de 2 minutos.
    </p>
    <div class="reg-step-list">
      <div class="reg-step-row"><div class="reg-step-num">1</div>Escolha seu perfil</div>
      <div class="reg-step-row"><div class="reg-step-num">2</div>Preencha seus dados</div>
      <div class="reg-step-row"><div class="reg-step-num">3</div>Confirme seu e-mail</div>
    </div>
  </aside>

  <!-- ── FORM ──────────────────────────────────────── -->
  <section class="loov-auth-form-side">
    <div class="loov-eyebrow"><span class="dot"></span>CRIAR CONTA</div>
    <h2 class="loov-h1" style="font-size:clamp(28px,4vw,40px);text-align:left;">
      Vamos <span class="accent">começar</span>.
    </h2>
    <p class="loov-lead" style="margin-left:0;text-align:left;margin-bottom:28px;">
      Selecione seu perfil e cadastre-se em segundos.
    </p>

    <div class="reg-role-grid">
      <div>
        <input type="radio" name="role_ui" id="role-client" value="client" class="reg-role-input" checked>
        <label for="role-client" class="reg-role-card">
          <div class="reg-role-title"><i class="fas fa-user"></i> Cliente</div>
          <div class="reg-role-desc">Agende serviços em lava-rápidos próximos a você</div>
        </label>
      </div>
      <div>
        <input type="radio" name="role_ui" id="role-owner" value="owner" class="reg-role-input">
        <label for="role-owner" class="reg-role-card">
          <div class="reg-role-title"><i class="fas fa-store"></i> Proprietário</div>
          <div class="reg-role-desc">Gerencie seu lava-rápido e receba agendamentos</div>
        </label>
      </div>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { id: "reg-form" }) do |f| %>

      <%= f.hidden_field :role, id: "role-hidden", value: "client" %>

      <div class="client-fields visible" id="client-fields">
        <div class="loov-field">
          <%= f.label :full_name, "Nome completo", class: "loov-label" %>
          <%= f.text_field :full_name, class: "loov-input", placeholder: "Seu nome completo", id: "full_name_field" %>
        </div>
        <div class="loov-field">
          <%= f.label :phone, "Telefone", class: "loov-label" %>
          <%= f.text_field :phone, class: "loov-input", placeholder: "(11) 99999-9999", id: "phone_field", maxlength: 15 %>
        </div>
      </div>

      <div class="loov-field">
        <%= f.label :email, "E-mail", class: "loov-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
            class: "loov-input", placeholder: "seu@email.com" %>
      </div>

      <div class="loov-field">
        <%= f.label :password, "Senha", class: "loov-label" %>
        <%= f.password_field :password, autocomplete: "new-password",
            class: "loov-input", placeholder: "Mínimo #{resource.class.password_length.min} caracteres" %>
      </div>

      <div class="loov-field">
        <%= f.label :password_confirmation, "Confirmar senha", class: "loov-label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password",
            class: "loov-input", placeholder: "Repita a senha" %>
      </div>

      <%= f.submit "Criar conta", class: "loov-btn-primary loov-btn-block loov-btn-lg" %>

    <% end %>

    <div class="loov-footer-row">
      <%= render "devise/shared/links" %>
    </div>
  </section>

</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const radios       = document.querySelectorAll('input[name="role_ui"]');
  const clientFields = document.getElementById('client-fields');
  const roleHidden   = document.getElementById('role-hidden');
  const phoneField   = document.getElementById('phone_field');
  const nameField    = document.getElementById('full_name_field');

  radios.forEach(radio => {
    radio.addEventListener('change', function() {
      const isClient = this.value === 'client';
      roleHidden.value = this.value;
      clientFields.classList.toggle('visible', isClient);
      if (nameField)  nameField.required  = isClient;
      if (phoneField) phoneField.required = isClient;
    });
  });

  if (phoneField) {
    phoneField.addEventListener('input', function() {
      let v = this.value.replace(/\D/g, '');
      v = v.length <= 10
        ? v.replace(/^(\d{2})(\d{4})(\d{0,4})/, '($1) $2-$3')
        : v.replace(/^(\d{2})(\d{5})(\d{0,4})/, '($1) $2-$3');
      this.value = v;
    });
  }

  const currentRole   = roleHidden.value || 'client';
  const matchingRadio = document.querySelector('input[name="role_ui"][value="' + currentRole + '"]');
  if (matchingRadio) {
    matchingRadio.checked = true;
    clientFields.classList.toggle('visible', currentRole === 'client');
  }
});
</script>
