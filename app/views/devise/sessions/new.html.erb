<div class="loov-auth">

  <!-- ── EDITORIAL ──────────────────────────────────── -->
  <aside class="loov-auth-editorial">
    <div class="loov-eyebrow"><span class="dot"></span>A NOVA FORMA DE LAVAR</div>
    <h1 class="loov-h1" style="text-align:left;">
      Seu carro,<br><span class="accent">seu jeito</span>.
    </h1>
    <p class="loov-lead" style="margin-left:0;text-align:left;">
      Você escolhe o lugar, o horário e o serviço.<br>
      A Loov cuida do resto.
    </p>
    <div class="loov-auth-detail-row">
      <div class="loov-auth-detail-num">100%</div>
      <div class="loov-auth-detail-label">online<br><span class="weak">sem ligação, sem fila</span></div>
    </div>
  </aside>

  <!-- ── FORM ──────────────────────────────────────── -->
  <section class="loov-auth-form-side">
    <div class="loov-eyebrow"><span class="dot"></span>ENTRAR</div>
    <h2 class="loov-h1" style="font-size:clamp(28px,4vw,40px);text-align:left;">
      Bem-<span class="accent">vindo</span>.
    </h2>
    <p class="loov-lead" style="margin-left:0;text-align:left;margin-bottom:32px;">
      Entre pra agendar ou gerenciar seu lava-rápido.
    </p>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>

      <div class="loov-field">
        <%= f.label :email, "E-mail", class: "loov-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
            class: "loov-input", placeholder: "seu@email.com" %>
      </div>

      <div class="loov-field">
        <%= f.label :password, "Senha", class: "loov-label" %>
        <%= f.password_field :password, autocomplete: "current-password",
            class: "loov-input", placeholder: "••••••••" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <label style="display:flex;align-items:center;gap:8px;font-size:13.5px;color:var(--graphite);margin-bottom:18px;cursor:pointer;">
          <%= f.check_box :remember_me, style: "width:16px;height:16px;accent-color:var(--coral-500);" %>
          Lembrar de mim
        </label>
      <% end %>

      <%= f.submit "Entrar", class: "loov-btn-primary loov-btn-block loov-btn-lg" %>

    <% end %>

    <div class="loov-footer-row">
      <%= render "devise/shared/links" %>
    </div>
  </section>

</div>
