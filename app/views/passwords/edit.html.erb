<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Redefinir senha — Loov</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@400;700&family=JetBrains+Mono:wght@400;500;700&display=swap">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --cream:#fafaf6; --paper:#fefefd; --sand:#f1eee6; --stone:#e0dbd0;
      --ash:#ada699; --graphite:#575148; --ink:#28231c;
      --coral-50:#fbeae3; --coral-100:#f5d3c3; --coral-300:#e8a48a;
      --coral-500:#dd7852; --coral-700:#9c4930;
    }
    body {
      font-family: 'Inter', -apple-system, sans-serif;
      background: var(--cream); color: var(--ink);
      min-height: 100vh;
      display: flex; align-items: center; justify-content: center;
      padding: 40px 20px;
      -webkit-font-smoothing: antialiased;
    }
    .card {
      width: 100%; max-width: 460px;
      background: var(--paper);
      border: 1px solid var(--stone);
      border-radius: 24px;
      padding: 44px 36px;
      box-shadow: 0 14px 40px rgba(40,35,28,0.06);
      text-align: center;
    }
    .eyebrow {
      display: inline-flex; align-items: center; gap: 8px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px; letter-spacing: 2px;
      color: var(--coral-500); text-transform: uppercase;
      padding: 6px 14px;
      background: var(--coral-50);
      border: 1px solid var(--coral-100);
      border-radius: 100px;
      margin-bottom: 18px;
    }
    .eyebrow .dot {
      width: 6px; height: 6px; border-radius: 50%;
      background: var(--coral-500);
      animation: pulse 1.6s ease-in-out infinite;
    }
    @keyframes pulse { 0%,100%{opacity:1;transform:scale(1);} 50%{opacity:.4;transform:scale(.7);} }
    h1 {
      font-family: 'Space Grotesk', sans-serif;
      font-size: clamp(26px, 4.5vw, 34px);
      letter-spacing: -0.6px;
      color: var(--ink);
      margin-bottom: 12px;
    }
    h1 .accent {
      color: var(--coral-500);
      position: relative;
      white-space: nowrap;
    }
    h1 .accent::after {
      content: ''; position: absolute; left: 0; right: 0; bottom: -2px;
      height: 3px;
      background: linear-gradient(90deg, var(--coral-300), var(--coral-500));
      border-radius: 4px; opacity: .7;
    }
    .lead {
      font-size: 14.5px; color: var(--graphite);
      line-height: 1.55;
      margin-bottom: 22px;
    }
    .lead strong { color: var(--ink); }
    .err {
      background: #fdecec; border: 1px solid #f5cccc;
      color: #c85050;
      padding: 10px 14px; border-radius: 12px;
      font-size: 12.5px; margin-bottom: 14px;
      text-align: left;
    }
    form { text-align: left; }
    label {
      display: block;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px; font-weight: 600;
      letter-spacing: 1.4px;
      color: var(--graphite);
      text-transform: uppercase;
      margin-bottom: 6px;
    }
    input[type="password"] {
      width: 100%;
      background: var(--cream);
      border: 1px solid var(--stone);
      border-radius: 12px;
      padding: 12px 16px;
      font-family: 'Inter', sans-serif; font-size: 14.5px;
      color: var(--ink);
      outline: none;
      margin-bottom: 16px;
      transition: border-color .15s, box-shadow .15s;
    }
    input[type="password"]:focus {
      border-color: var(--coral-500);
      box-shadow: 0 0 0 3px rgba(220,120,82,0.08);
    }
    .btn {
      width: 100%;
      background: var(--coral-500);
      color: var(--cream);
      border: none;
      border-radius: 100px;
      padding: 14px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px; font-weight: 700;
      letter-spacing: 1.4px;
      cursor: pointer;
      box-shadow: 0 8px 20px rgba(220,120,82,0.22);
      transition: background .15s, transform .15s, box-shadow .15s;
      margin-top: 6px;
    }
    .btn:hover {
      background: var(--coral-700);
      transform: translateY(-2px);
      box-shadow: 0 10px 24px rgba(156,73,48,0.28);
    }
    .footnote {
      color: var(--ash); font-size: 11.5px;
      line-height: 1.55; margin-top: 22px;
      font-family: 'JetBrains Mono', monospace;
      letter-spacing: 0.4px;
    }
  </style>
</head>
<body>
  <div class="card">
    <div class="eyebrow"><span class="dot"></span>NOVA SENHA</div>
    <h1>Criar uma <span class="accent">nova senha</span></h1>
    <p class="lead">
      Conta: <strong><%= @user&.email %></strong>
    </p>

    <% if @error %>
      <div class="err"><%= @error %></div>
    <% end %>

    <form action="/password/update" method="post" autocomplete="off">
      <input type="hidden" name="reset_password_token" value="<%= @reset_token %>">

      <label>NOVA SENHA</label>
      <input type="password" name="password" minlength="6" required placeholder="••••••••">

      <label>CONFIRMAR SENHA</label>
      <input type="password" name="password_confirmation" minlength="6" required placeholder="Repita a senha">

      <button type="submit" class="btn">ATUALIZAR SENHA</button>
    </form>

    <p class="footnote">
      Após atualizar, volte ao app e faça login com a nova senha.
    </p>
  </div>
</body>
</html>
