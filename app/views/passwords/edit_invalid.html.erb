<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Link inválido — Loov</title>
</head>
<body style="margin:0;background:#fafaf6;">
<div style="font-family:-apple-system,Helvetica,Arial,sans-serif;background:#fafaf6;min-height:100vh;padding:32px 16px;box-sizing:border-box;">
  <div style="max-width:420px;margin:0 auto;background:#fefefd;border:1px solid #e0dbd0;border-radius:18px;padding:28px;text-align:center;box-shadow:0 2px 6px rgba(25,20,15,0.05);">
    <div style="width:64px;height:64px;border-radius:32px;background:#fdecec;border:1px solid #f5cccc;margin:0 auto 14px;display:flex;align-items:center;justify-content:center;">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#c85050" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    </div>
    <h1 style="font-size:20px;font-weight:700;letter-spacing:-0.3px;color:#28231c;margin:0 0 6px;">Link inválido</h1>
    <p style="color:#575148;font-size:13px;line-height:19px;margin:0;">
      <%= @error %>
    </p>
  </div>
</div>
</body>
</html>
