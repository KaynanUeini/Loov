          trigger: '#lh-near-pin', start: 'top top', end: function () { return '+=' + Math.max(1, dist()); }, pin: true, scrub: .6, invalidateOnRefresh: true,
          onUpdate: function (st) { marcar(st.progress); }
        } });
        return function () { rail.classList.remove('is-pinned'); gsap.set(rail, { x: 0 }); };
      });

      // 7. Fecho: "Vazou" se enche de baixo pra cima; ao encher, o ponto cai.
      var word = document.getElementById('lh-end-word');
      var dot = word.querySelector('em');
      gsap.set(dot, { y: -220, opacity: 0 });
      var caiu = false;
      ScrollTrigger.create({
        trigger: word, start: 'top 90%', end: 'bottom 55%', scrub: true,
        onUpdate: function (st) {
          word.querySelector('.w').style.setProperty('--fill', (st.progress * 100).toFixed(1) + '%');
          if (st.progress > 0.96 && !caiu) { caiu = true; gsap.to(dot, { y: 0, opacity: 1, duration: 0.9, ease: 'bounce.out' }); }
          if (st.progress < 0.5 && caiu) { caiu = false; gsap.to(dot, { y: -220, opacity: 0, duration: 0.3 }); }
        }
      });
    }

    // Números contam ao aparecer.
    document.querySelectorAll('.lh [data-count]').forEach(function (el) {
      if (!motion) return;
      el.textContent = '0';
      ScrollTrigger.create({ trigger: el, start: 'top 88%', once: true, onEnter: function () { contar(el); } });
    });

    // Saudação do celular do topo pela hora de quem visita (greeting() do app).
    var hiEl = document.getElementById('lh-app-hi');
    if (hiEl) { var hh = new Date().getHours(); hiEl.textContent = hh < 5 ? 'Boa noite' : hh < 12 ? 'Bom dia' : hh < 18 ? 'Boa tarde' : 'Boa noite'; }

    // Celular do topo: no computador encolhe conforme a altura da janela,
    // descontando a barra do site (60px) e o respiro do hero, pra caber inteiro.
    var stage = document.querySelector('.lh-hero .lh-phone-stage');
    if (stage) {
      var grade = stage.parentNode;
      var zoomHero = function () {
        if (window.innerWidth < 961) { stage.style.removeProperty('--hz'); stage.style.marginTop = ''; return; }
        var z = Math.max(0.6, Math.min(1, (window.innerHeight - 180) / 650));
        stage.style.setProperty('--hz', z.toFixed(3));
        // O texto do hero costuma ser mais alto que a tela; centralizado com
        // ele, o celular descia e cortava. Ele fica no meio da área visível
        // (abaixo da barra), sem passar do topo da grade.
        var alturaCel = 650 * z;
        var topoGrade = grade.getBoundingClientRect().top + window.scrollY;
        var alvo = 60 + (window.innerHeight - 60 - alturaCel) / 2;
        stage.style.marginTop = (Math.max(0, alvo - topoGrade) / z).toFixed(1) + 'px';
      };
      zoomHero();
      window.addEventListener('resize', zoomHero);
    }
    // Celular do dono (Agenda cheia): cabe inteiro na tela junto da lista.
    var donoCel = document.querySelector('.lh-dono-phone');
    if (donoCel) {
      var zoomDono = function () {
        var z = window.innerWidth < 961 ? 1 : Math.max(0.6, Math.min(1, (window.innerHeight - 130) / 650));
        donoCel.style.setProperty('--dz', z.toFixed(3));
      };
      zoomDono();
      window.addEventListener('resize', zoomDono);
    }

    // Celular acompanha o mouse de leve (só desktop, só com movimento).
    var phone = document.getElementById('lh-phone');
    if (phone && !reduce && window.matchMedia('(pointer: fine) and (min-width: 961px)').matches) {
      window.addEventListener('mousemove', function (ev) {
        var x = (ev.clientX / window.innerWidth - 0.5);
        var y = (ev.clientY / window.innerHeight - 0.5);
        phone.style.transform = 'rotateY(' + (-8 + x * 10).toFixed(2) + 'deg) rotateX(' + (4 - y * 8).toFixed(2) + 'deg)';
      }, { passive: true });
    }

