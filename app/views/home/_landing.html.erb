<script>
  // Decide antes do hero pintar: abertura só na primeira visita do dia.
  (function () {
    try {
      var hoje = new Date().toISOString().slice(0, 10);
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && localStorage.getItem('loov_abertura') !== hoje) {
        document.documentElement.classList.add('lh-abrindo');
        localStorage.setItem('loov_abertura', hoje);
      }
    } catch (e) {}
  })();
</script>
