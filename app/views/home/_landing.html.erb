      // visto já rolando — girado ali ele parecia torto. Lá fica reto.
      gsap.matchMedia().add('(min-width: 961px)', function () {
        gsap.to('.lh-hero-copy', { yPercent: -10, ease: 'none', scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: true } });
