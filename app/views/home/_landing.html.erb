<%#
  Landing pública (visitante). Mesma linguagem do app e do login do site.

  Roteiro da página — uma ideia por dobra (Apple), tipo grande e um acento
  só (Spotify), muito respiro (Wiemer):
    1. Hero: "Chegou. Lavou. Vazou." entrando palavra a palavra (tipografia
       cinética — a abertura do app) + o app "vivo" num celular ao lado.
    2. Faixa de serviços correndo (marquee).
    3. Como funciona em 3 passos numerados (01 02 03, como o ranking do PDF).
    4. Disponível: vaga em 30 min, em fundo obsidian, com cronômetro rodando.
    5. Perto de você agora — lava-rápidos reais, em lista estilo Spotify.
    6. Para lava-rápidos — o lado do dono.
    7. Fecho com o "Vazou." gigante.

  Movimento (inspiração: viture.com — a rolagem conta a história): rolagem
  suave (Lenis) e animação presa à rolagem (GSAP ScrollTrigger), as duas em
  public/vendor. O hero sobe em camadas; a faixa de serviços acelera com a
  rolagem; "Três toques" prende o celular na tela e troca a tela a cada
  passo; o Disponível cresce até ocupar a tela; os números contam; o
  "Vazou." do fecho se enche de baixo pra cima. Sem as bibliotecas ou com
  prefers-reduced-motion, a página fica estática e completa.

  Toda frase aqui é fato do produto (conferido no código): Disponível = 30
  min e 35% pago no app; lembrete na véspera; avaliação só de quem foi
  atendido; dono grátis na fase de testes. Movimento respeita
  prefers-reduced-motion.
%>
<%
  shops = (@nearby_car_washes || []).first(6)
  phone_shops = shops.first(3)
  services_ticker = ["Lavagem", "Polimento", "Higienização", "Cristalização", "Vitrificação",
                     "Enceramento", "Hidratação de couro", "Limpeza de motor", "Faróis", "Impermeabilização"]
%>
<style>
  .lh { background: var(--cream); color: var(--ink); overflow-x: clip; }
  .lh *, .lh *::before, .lh *::after { box-sizing: border-box; }
  .lh-wrap { width: 100%; max-width: 1240px; margin: 0 auto; padding: 0 32px; }
  .lh h1, .lh h2, .lh h3 { margin: 0; font-family: 'Space Grotesk', sans-serif !important; font-weight: 700; color: inherit; }
  .lh p { margin: 0; }
  .lh-eyebrow {
    display: inline-flex; align-items: center; gap: 10px;
    font-family: 'JetBrains Mono', monospace; font-size: 11.5px;
    letter-spacing: 2px; text-transform: uppercase; color: var(--coral-700);
  }
  .lh-eyebrow::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--coral-500); }

  /* Botões */
  .lh-btn {
    display: inline-flex; align-items: center; gap: 10px;
    height: 56px; padding: 0 28px; border-radius: 9999px;
    font-family: 'Inter', sans-serif; font-size: 16px; font-weight: 600; letter-spacing: .1px;
    text-decoration: none; cursor: pointer;
    transition: transform .18s ease, box-shadow .2s ease, background .15s ease, color .15s ease;
  }
  .lh-btn svg { transition: transform .2s ease; }
  .lh-btn:hover svg { transform: translateX(3px); }
  .lh-btn--primary { background: var(--coral-500); color: #fff !important; box-shadow: 0 12px 28px -12px rgba(221,120,82,.8); }
  .lh-btn--primary:hover { background: var(--coral-700); transform: translateY(-2px); }
  .lh-btn--ghost { color: var(--ink) !important; border: 1px solid var(--stone); background: var(--paper); }
  .lh-btn--ghost:hover { border-color: var(--ink); transform: translateY(-2px); }
  .lh-btn--light { background: var(--cream); color: var(--ink) !important; }
  .lh-btn--light:hover { transform: translateY(-2px); background: #fff; }

  /* Revelar ao rolar */
  .lh-reveal { opacity: 0; transform: translateY(28px); transition: opacity .8s ease, transform .8s cubic-bezier(.2,.8,.2,1); }
  .lh-reveal.is-in { opacity: 1; transform: none; }
  .lh-reveal[data-delay="1"] { transition-delay: .1s; }
  .lh-reveal[data-delay="2"] { transition-delay: .2s; }
  .lh-reveal[data-delay="3"] { transition-delay: .3s; }

  /* ── 1. Hero ─────────────────────────────────────────────────────── */
  .lh-hero { position: relative; min-height: min(calc(100svh - 60px), 940px); margin-top: 60px; display: flex; align-items: center; padding: 64px 0 80px; }
  .lh-hero::before {
    content: ""; position: absolute; z-index: 0; pointer-events: none;
    width: 820px; height: 820px; right: -180px; top: 50%; transform: translateY(-50%);
    background: radial-gradient(closest-side, rgba(221,120,82,.22), rgba(221,120,82,0) 72%);
    animation: lh-breathe 10s ease-in-out infinite;
  }
  @keyframes lh-breathe { 50% { transform: translateY(-54%) scale(1.07); } }
  .lh-hero-grid { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); align-items: center; gap: 48px; }
  .lh-kinetic { font-size: clamp(72px, 10.5vw, 168px) !important; line-height: .9; letter-spacing: -0.05em; margin-top: 22px !important; }
  .lh-kinetic span { display: block; opacity: 0; transform: translateY(38%); filter: blur(14px); animation: lh-word 1s cubic-bezier(.2,.8,.2,1) forwards; }
  .lh-kinetic span:nth-child(1) { animation-delay: .1s; }
  .lh-kinetic span:nth-child(2) { animation-delay: .5s; color: var(--coral-500); }
  .lh-kinetic span:nth-child(3) { animation-delay: .9s; }
  @keyframes lh-word { to { opacity: 1; transform: none; filter: none; } }
  .lh-hero-after { opacity: 0; animation: lh-fade .9s ease 1.45s forwards; }
  @keyframes lh-fade { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  .lh-lead { margin-top: 28px !important; max-width: 34ch; font-size: clamp(18px, 1.6vw, 21px); line-height: 1.5; color: var(--graphite); }
  .lh-lead strong { color: var(--ink); font-weight: 600; }
  .lh-hero-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; margin-top: 36px; }
  .lh-dot-live { width: 8px; height: 8px; border-radius: 50%; background: #2fa36b; box-shadow: 0 0 0 0 rgba(47,163,107,.5); animation: lh-ping 2s ease-out infinite; }
  @keyframes lh-ping { 70% { box-shadow: 0 0 0 8px rgba(47,163,107,0); } 100% { box-shadow: 0 0 0 0 rgba(47,163,107,0); } }

  /* Celular com o app */
  .lh-phone-stage { display: flex; justify-content: center; perspective: 1400px; opacity: 0; animation: lh-fade 1.1s ease .7s forwards; }
  .lh-phone {
    position: relative; width: 320px; height: 650px; border-radius: 52px; padding: 12px;
    background: var(--obsidian);
    box-shadow: 0 50px 100px -30px rgba(40,35,28,.45), 0 0 0 1px rgba(255,255,255,.06) inset;
    transform: rotateY(-8deg) rotateX(4deg); transition: transform .4s ease; will-change: transform;
  }
  .lh-screen { position: relative; height: 100%; border-radius: 41px; overflow: hidden; background: var(--cream); padding: 52px 18px 18px; }
  .lh-notch { position: absolute; top: 12px; left: 50%; transform: translateX(-50%); width: 100px; height: 28px; border-radius: 20px; background: var(--obsidian); }
  .lh-app-hi { font-size: 13px; color: var(--graphite); }
  .lh-app-title { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 25px; letter-spacing: -0.03em; margin: 2px 0 16px; }
  .lh-app-chips { display: flex; gap: 6px; margin-bottom: 16px; }
  .lh-app-chip { white-space: nowrap; font-size: 11.5px; font-weight: 600; padding: 7px 11px; border-radius: 99px; border: 1px solid var(--stone); color: var(--ink); background: var(--paper); }
  .lh-app-chip.is-on { background: var(--coral-500); border-color: var(--coral-500); color: #fff; }
  .lh-app-row { display: flex; align-items: center; gap: 12px; padding: 12px; border-radius: 16px; background: var(--paper); border: 1px solid var(--stone); margin-bottom: 9px; }
  /* Logo da loja (shared/_loov_logos): o mesmo emblema da home do cliente,
     do app e do Disponível. O SVG tem forma própria, então o slot é neutro. */
  .lh-app-av { flex: 0 0 40px; height: 40px; display: flex; align-items: center; justify-content: center; }
  .lh-app-av svg, .lh-item-av svg { width: 100%; height: 100%; display: block; }
  .lh-app-name { font-size: 13.5px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lh-app-sub { font-size: 11.5px; color: var(--graphite); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lh-status { font-family: 'JetBrains Mono', monospace; font-size: 9.5px; letter-spacing: 1px; padding: 4px 7px; border-radius: 6px; flex-shrink: 0; }
  .lh-status.is-open { background: #dcefe3; color: #23744a; }
  .lh-status.is-closed { background: var(--sand); color: var(--graphite); }
  .lh-toast {
    position: absolute; left: 14px; right: 14px; bottom: 18px;
    display: flex; align-items: center; gap: 12px; padding: 14px 16px; border-radius: 18px;
    background: var(--ink); color: var(--cream);
    box-shadow: 0 18px 36px -12px rgba(26,22,18,.55);
    transform: translateY(140%); animation: lh-toast 7s cubic-bezier(.2,.8,.2,1) 2.4s infinite;
  }
  .lh-toast-check { flex: 0 0 30px; height: 30px; border-radius: 50%; background: #2fa36b; display: flex; align-items: center; justify-content: center; }
  .lh-toast b { display: block; font-size: 13.5px; }
  .lh-toast span { font-size: 12px; color: #cfc8bb; }
  @keyframes lh-toast { 0% { transform: translateY(140%); } 10%, 72% { transform: none; } 82%, 100% { transform: translateY(140%); } }

  /* ── 2. Marquee ──────────────────────────────────────────────────── */
  .lh-marquee { border-top: 1px solid var(--stone); border-bottom: 1px solid var(--stone); padding: 22px 0; overflow: hidden; background: var(--paper); }
  .lh-marquee-track { display: flex; width: max-content; animation: lh-marquee 40s linear infinite; }
  .lh-marquee:hover .lh-marquee-track { animation-play-state: paused; }
  .lh-marquee-item { display: inline-flex; align-items: center; gap: 28px; padding-right: 28px; font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: clamp(28px, 3.4vw, 44px); letter-spacing: -0.03em; white-space: nowrap; }
  .lh-marquee-item:nth-child(even) { color: transparent; -webkit-text-stroke: 1.4px var(--ink); }
  .lh-marquee-item::after { content: ""; width: 12px; height: 12px; border-radius: 50%; background: var(--coral-500); }
  @keyframes lh-marquee { to { transform: translateX(-50%); } }

  /* ── 3. Como funciona ────────────────────────────────────────────── */
  .lh-section { padding: 140px 0; }
  .lh-h2 { font-size: clamp(40px, 5.2vw, 76px) !important; line-height: 1; letter-spacing: -0.045em; max-width: 14ch; margin-top: 18px !important; }

  /* ── 4. Disponível ───────────────────────────────────────────────── */
  .lh-dark { position: relative; background: var(--obsidian); color: var(--cream); border-radius: 44px; margin: 0 16px; overflow: hidden; isolation: isolate; }
  .lh-dark::before { content: ""; position: absolute; z-index: -1; width: 900px; height: 900px; left: -300px; bottom: -520px; background: radial-gradient(closest-side, rgba(221,120,82,.35), rgba(221,120,82,0) 70%); }
  .lh-dark .lh-eyebrow { color: var(--coral-300); }
  .lh-dark-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: 56px; align-items: center; }
  .lh-dark p.lh-dark-lead { margin-top: 28px; font-size: 20px; line-height: 1.55; color: #cfc8bb; max-width: 38ch; }
  .lh-dark p.lh-dark-lead strong { color: var(--cream); font-weight: 600; }
  .lh-slot { border-radius: 32px; padding: 36px; background: rgba(250,250,246,.06); border: 1px solid rgba(250,250,246,.12); backdrop-filter: blur(10px); }
  .lh-slot-top { display: flex; justify-content: space-between; align-items: center; }
  .lh-slot-tag { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 1.6px; text-transform: uppercase; color: var(--coral-300); display: inline-flex; align-items: center; gap: 8px; }
  .lh-slot-time { margin-top: 26px; font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: clamp(64px, 7vw, 104px); letter-spacing: -0.04em; line-height: 1; font-variant-numeric: tabular-nums; }
  .lh-slot-cap { margin-top: 8px; color: #cfc8bb; font-size: 15px; }
  .lh-slot-bar { margin-top: 28px; height: 6px; border-radius: 6px; background: rgba(250,250,246,.12); overflow: hidden; }
  .lh-slot-bar i { display: block; height: 100%; width: 100%; background: var(--coral-500); border-radius: 6px; transform-origin: left; transition: transform 1s linear; }
  .lh-slot-foot { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-top: 28px; }
  .lh-slot-foot div { font-size: 14px; color: #cfc8bb; }
  .lh-slot-foot b { display: block; color: var(--cream); font-size: 16px; }

  /* ── 5. Perto de você ────────────────────────────────────────────── */
  .lh-near-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; }
  .lh-list { margin-top: 48px; border-top: 1px solid var(--ink); }
  .lh-item { display: grid; grid-template-columns: 56px 52px minmax(0, 1fr) auto auto; align-items: center; gap: 18px; padding: 20px 8px; border-bottom: 1px solid var(--stone); text-decoration: none; color: var(--ink) !important; border-radius: 0; transition: background .2s ease, padding .2s ease; }
  .lh-item:hover { background: var(--paper); padding-left: 16px; padding-right: 16px; }
  .lh-item-n { font-family: 'JetBrains Mono', monospace; font-size: 14px; color: var(--ash); }
  .lh-item-av { width: 52px; height: 52px; display: flex; align-items: center; justify-content: center; }
  /* Localização sob demanda: o pedido só aparece quando a pessoa quer ver
     os mais perto (pedir ao abrir a página queimaria a permissão — um "não"
     aqui vale pro site inteiro, inclusive a home depois do cadastro). */
  .lh-near-btn { display: inline-flex; align-items: center; gap: 8px; height: 46px; padding: 0 20px; border-radius: 999px; border: 1px solid var(--ink); background: transparent; color: var(--ink); font: inherit; font-size: 15px; font-weight: 600; cursor: pointer; transition: background .2s ease, color .2s ease; }
  .lh-near-btn:hover { background: var(--ink); color: var(--cream); }
  .lh-near-btn[disabled] { opacity: .6; cursor: progress; }
  .lh-near-btn[hidden] { display: none; }
  .lh-near-note { font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: .5px; color: var(--graphite); }
  .lh-near-note[hidden] { display: none; }
  .lh-item-name { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 21px; letter-spacing: -0.02em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lh-item-addr { font-size: 14.5px; color: var(--graphite); margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lh-item-go { width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--stone); display: flex; align-items: center; justify-content: center; transition: background .2s ease, border-color .2s ease, color .2s ease; }
  .lh-item:hover .lh-item-go { background: var(--ink); border-color: var(--ink); color: var(--cream); }

  /* ── 6. Para lava-rápidos ────────────────────────────────────────── */
  .lh-owner { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 64px; align-items: center; }
  .lh-badge { display: inline-flex; align-items: center; gap: 8px; margin-top: 26px; padding: 8px 14px; border-radius: 99px; background: #dcefe3; color: #23744a; font-size: 14px; font-weight: 600; }
  .lh-checks { list-style: none; margin: 32px 0 36px; padding: 0; display: grid; gap: 16px; }
  .lh-checks li { display: grid; grid-template-columns: 28px 1fr; gap: 12px; font-size: 17px; line-height: 1.45; color: var(--graphite); }
  .lh-checks b { color: var(--ink); font-weight: 600; }
  .lh-checks i { width: 28px; height: 28px; border-radius: 50%; background: var(--coral-50); color: var(--coral-700); display: flex; align-items: center; justify-content: center; font-style: normal; font-size: 14px; font-weight: 700; }
  .lh-dash { border-radius: 32px; background: var(--paper); border: 1px solid var(--stone); padding: 32px; box-shadow: 0 50px 90px -50px rgba(40,35,28,.4); }
  .lh-dash-label { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 1.6px; text-transform: uppercase; color: var(--graphite); }
  .lh-dash-big { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 52px; letter-spacing: -0.04em; margin-top: 6px; }
  .lh-dash-pill { display: inline-block; margin-top: 6px; padding: 4px 10px; border-radius: 99px; background: var(--coral-50); color: var(--coral-700); font-size: 13px; font-weight: 600; }
  .lh-bars { display: flex; align-items: flex-end; gap: 10px; height: 150px; margin-top: 30px; padding-bottom: 6px; border-bottom: 1px solid var(--stone); }
  .lh-bars span { flex: 1; border-radius: 8px 8px 3px 3px; background: var(--coral-500); transform-origin: bottom; transform: scaleY(0); transition: transform .9s cubic-bezier(.2,.8,.2,1); }
  .lh-bars span.is-cost { background: var(--stone); }
  .lh-dash.is-in .lh-bars span { transform: scaleY(1); }
  .lh-dash-legend { display: flex; gap: 18px; margin-top: 14px; font-size: 13px; color: var(--graphite); }
  .lh-dash-legend b { display: inline-block; width: 10px; height: 10px; border-radius: 3px; margin-right: 6px; vertical-align: -1px; }
  .lh-dash-note { margin-top: 18px; font-size: 12px; color: var(--ash); }

  /* ── 7. Fecho ────────────────────────────────────────────────────── */
  .lh-end { text-align: center; padding: 120px 0 80px; }
  .lh-end-word { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: clamp(110px, 22vw, 340px); line-height: .85; letter-spacing: -0.06em; color: var(--ink); }
  .lh-end-word em { font-style: normal; color: var(--coral-500); }
  .lh-end p { margin: 28px auto 36px !important; max-width: 30ch; font-size: 20px; line-height: 1.5; color: var(--graphite); }
  .lh-foot { border-top: 1px solid var(--stone); padding: 28px 0 40px; }
  .lh-foot-in { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; font-size: 14px; color: var(--graphite); }
  .lh-foot a { color: var(--graphite) !important; text-decoration: none; margin-left: 22px; }
  .lh-foot a:hover { color: var(--ink) !important; }

  /* ── 3. Três toques: celular preso na tela, tela troca por passo ──── */
  .lh-how { position: relative; }
  .lh-how-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 64px; align-items: center; }
  .lh-how-steps { list-style: none; margin: 56px 0 0; padding: 0; display: grid; gap: 10px; }
  .lh-how-step { display: grid; grid-template-columns: 88px 1fr; gap: 8px 20px; padding: 22px 0; border-top: 1px solid var(--stone); }
  .lh-how-step .n { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 56px; line-height: .9; letter-spacing: -0.05em; color: var(--coral-500); }
  .lh-how-step h3 { font-size: 30px !important; letter-spacing: -0.03em; }
  .lh-how-step p { grid-column: 2; font-size: 16.5px; line-height: 1.55; color: var(--graphite); }
  .lh-how-phone { display: flex; justify-content: center; }
  .lh-how-box { position: relative; width: calc(320px * var(--s, 1)); height: calc(650px * var(--s, 1)); }
  .lh-how-box .lh-phone { position: absolute; top: 0; left: 0; transform: scale(var(--s, 1)) rotateY(-6deg); transform-origin: top left; }
  .lh-how-bar { display: flex; gap: 6px; margin-top: 28px; }
  .lh-how-bar i { flex: 1; height: 4px; border-radius: 4px; background: var(--stone); overflow: hidden; }
  .lh-how-bar i b { display: block; height: 100%; background: var(--coral-500); transform-origin: left; transform: scaleX(0); }
  /* Telas do celular: uma por passo. Sem movimento, só a primeira. */
  .lh-scr { position: absolute; inset: 0; padding: 52px 18px 18px; display: flex; flex-direction: column; transition: opacity .5s ease, transform .6s cubic-bezier(.2,.8,.2,1); }
  .lh-scr + .lh-scr { opacity: 0; transform: translateX(14%); }
  .lh-scr.is-past { opacity: 0; transform: translateX(-14%); }
  .lh-scr.is-on { opacity: 1; transform: none; }
  .lh-scr-k { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 1.4px; color: var(--ash); text-transform: uppercase; }
  .lh-scr-t { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 23px; letter-spacing: -0.03em; margin: 4px 0 14px; }
  .lh-svc { display: flex; justify-content: space-between; align-items: center; padding: 13px 14px; border-radius: 14px; border: 1px solid var(--stone); background: var(--paper); margin-bottom: 8px; font-size: 13.5px; font-weight: 600; transition: border-color .4s ease, background .4s ease; }
  .lh-svc small { display: block; font-weight: 400; font-size: 11.5px; color: var(--graphite); margin-top: 2px; }
  .lh-svc span { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 15px; }
  .lh-scr.is-on .lh-svc.is-pick { border-color: var(--coral-500); background: var(--coral-50); transition-delay: .45s; }
  .lh-days { display: flex; gap: 6px; margin-bottom: 14px; }
  .lh-days span { flex: 1; text-align: center; padding: 8px 0; border-radius: 12px; border: 1px solid var(--stone); font-size: 11px; color: var(--graphite); background: var(--paper); }
  .lh-days span b { display: block; font-family: 'Space Grotesk', sans-serif; font-size: 17px; color: var(--ink); }
  .lh-days span.is-on { background: var(--ink); border-color: var(--ink); color: #cfc8bb; }
  .lh-days span.is-on b { color: var(--cream); }
  .lh-times { display: grid; grid-template-columns: repeat(3, 1fr); gap: 7px; }
  .lh-times span { text-align: center; padding: 10px 0; border-radius: 11px; border: 1px solid var(--stone); background: var(--paper); font-size: 13px; font-weight: 600; font-variant-numeric: tabular-nums; transition: background .35s ease, color .35s ease, border-color .35s ease, transform .35s ease; }
  .lh-times span.is-off { color: var(--ash); text-decoration: line-through; background: transparent; }
  .lh-scr.is-on .lh-times span.is-pick { background: var(--coral-500); border-color: var(--coral-500); color: #fff; transform: scale(1.06); transition-delay: .45s; }
  .lh-scr-cta { margin-top: auto; height: 48px; border-radius: 99px; background: var(--ink); color: var(--cream); display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 600; }
  .lh-done { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
  .lh-done-check { width: 92px; height: 92px; border-radius: 50%; background: #2fa36b; display: flex; align-items: center; justify-content: center; transform: scale(.4); opacity: 0; transition: transform .6s cubic-bezier(.3,1.6,.5,1) .25s, opacity .3s ease .25s; }
  .lh-scr.is-on .lh-done-check { transform: none; opacity: 1; }
  .lh-done b { font-family: 'Space Grotesk', sans-serif; font-size: 26px; letter-spacing: -0.03em; margin-top: 20px; }
  .lh-done span { font-size: 13px; color: var(--graphite); margin-top: 4px; }
  .lh-done-rows { width: 100%; margin-top: 26px; display: grid; gap: 8px; text-align: left; }
  .lh-done-rows div { display: flex; align-items: center; gap: 10px; padding: 12px 14px; border-radius: 14px; background: var(--paper); border: 1px solid var(--stone); font-size: 12.5px; color: var(--graphite); opacity: 0; transform: translateY(10px); transition: opacity .5s ease, transform .5s ease; }
  .lh-done-rows div b { color: var(--ink); font-weight: 600; }
  .lh-scr.is-on .lh-done-rows div { opacity: 1; transform: none; }
  .lh-scr.is-on .lh-done-rows div:nth-child(1) { transition-delay: .6s; }
  .lh-scr.is-on .lh-done-rows div:nth-child(2) { transition-delay: .75s; }
  .lh-stars { color: var(--coral-500); letter-spacing: 2px; margin-left: auto; }

  .lh-how-box .lh-phone { width: 320px; height: 650px; }
  /* Com movimento (JS): a seção presa ocupa a tela, centrada. */
  .lh-motion .lh-how { padding: 0; }
  .lh-motion .lh-how-pinned { min-height: 100vh; display: flex; align-items: center; padding: 84px 0 24px; }
  .lh-motion .lh-how-pinned > .lh-wrap { width: 100%; }
  /* Com movimento (JS): os passos acendem um por vez. */
  .lh-motion .lh-how-step { opacity: .28; transition: opacity .4s ease; }
  .lh-motion .lh-how-step.is-on { opacity: 1; }

  /* ── 4b. Números ─────────────────────────────────────────────────── */
  .lh-stats { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--ink); }
  .lh-stat { padding: 34px 28px 8px 0; }
  .lh-stat + .lh-stat { padding-left: 28px; border-left: 1px solid var(--stone); }
  .lh-stat b { display: block; font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: clamp(56px, 6.4vw, 104px); line-height: .95; letter-spacing: -0.05em; font-variant-numeric: tabular-nums; }
  .lh-stat b small { font-size: .42em; letter-spacing: -0.02em; margin-left: 4px; }
  .lh-stat > span { display: block; margin-top: 14px; max-width: 22ch; font-size: 15.5px; line-height: 1.45; color: var(--graphite); }

  /* Fecho: o "Vazou." se enche de baixo pra cima (contorno → tinta). */
  .lh-motion .lh-end-word .w {
    color: transparent; -webkit-text-stroke: 2px var(--ink);
    background: linear-gradient(to top, var(--ink) var(--fill, 0%), transparent var(--fill, 0%));
    -webkit-background-clip: text; background-clip: text;
  }
  .lh-end-word em { display: inline-block; }

  /* ── Responsivo ──────────────────────────────────────────────────── */
  @media (max-width: 960px) {
    .lh-wrap { padding: 0 22px; }
    .lh-hero { padding: 40px 0 64px; min-height: auto; }
    .lh-hero-grid, .lh-dark-grid, .lh-owner { grid-template-columns: 1fr; gap: 56px; }
    .lh-phone { transform: none; width: 290px; height: 590px; }
    .lh-section { padding: 96px 0; }
    .lh-how-grid { grid-template-columns: 1fr; gap: 28px; }
    .lh-how-steps { margin-top: 28px; }
    .lh-how-step { grid-template-columns: 56px 1fr; padding: 16px 0; }
    .lh-how-step .n { font-size: 40px; }
    .lh-how-step h3 { font-size: 24px !important; }
    .lh-how-box .lh-phone { transform: scale(var(--s, 1)); }
    /* Celular preso (com movimento): só o passo da vez aparece embaixo. */
    .lh-motion .lh-how-pinned { display: flex; flex-direction: column; justify-content: center; min-height: 100svh; padding: 76px 0 24px; }
    .lh-motion .lh-how-pinned .lh-how-grid { gap: 18px; }
    .lh-motion .lh-how-pinned .lh-how-phone { order: -1; }
    .lh-motion .lh-how-pinned .lh-h2, .lh-motion .lh-how-pinned .lh-eyebrow { display: none; }
    .lh-motion .lh-how-pinned .lh-how-steps { margin-top: 0; }
    .lh-motion .lh-how-pinned .lh-how-step { display: none; border-top: 0; }
    .lh-motion .lh-how-pinned .lh-how-step.is-on { display: grid; }
    .lh-how-bar { margin-top: 12px; }
    .lh-stat { padding: 24px 10px 12px 0; }
    .lh-stat + .lh-stat { padding-left: 12px; }
    .lh-stat b { font-size: 40px; }
    .lh-stat > span { font-size: 13px; }
    .lh-dark { margin: 0 8px; border-radius: 32px; }
    .lh-item { grid-template-columns: 52px minmax(0, 1fr) auto; gap: 14px; }
    .lh-item-n, .lh-item-go { display: none; }
    .lh-near-head { flex-direction: column; align-items: flex-start; }
    .lh-foot a { margin: 0 18px 0 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .lh-kinetic span, .lh-hero-after, .lh-phone-stage { animation: none; opacity: 1; transform: none; filter: none; }
    .lh-reveal { opacity: 1; transform: none; transition: none; }
    .lh-marquee-track, .lh-hero::before, .lh-dot-live { animation: none; }
    .lh-toast { animation: none; transform: none; }
    .lh-bars span { transform: none; transition: none; }
    .lh-scr, .lh-done-check, .lh-done-rows div { transition: none; }
  }
</style>

<div class="lh">

  <%# ── 1. Hero ───────────────────────────────────────────────────────── %>
  <section class="lh-hero">
    <div class="lh-wrap lh-hero-grid">
      <div class="lh-hero-copy">
        <div class="lh-eyebrow lh-hero-after" style="animation-delay:.05s">O app do lava-rápido</div>
        <h1 class="lh-kinetic" aria-label="Chegou. Lavou. Vazou.">
          <span aria-hidden="true">Chegou.</span>
          <span aria-hidden="true">Lavou.</span>
          <span aria-hidden="true">Vazou.</span>
        </h1>
        <div class="lh-hero-after">
          <p class="lh-lead">Encontre o lava-rápido mais perto, escolha o horário e pronto. <strong>Sem ligar, sem fila, sem esperar na porta.</strong></p>
          <div class="lh-hero-cta">
            <a href="<%= new_user_registration_path %>" class="lh-btn lh-btn--primary">
              Começar agora
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
            <a href="#para-lava-rapidos" class="lh-btn lh-btn--ghost">Tenho um lava-rápido</a>
          </div>
        </div>
      </div>

      <div class="lh-phone-stage" aria-hidden="true">
        <div class="lh-phone-float" id="lh-phone-float">
        <div class="lh-phone" id="lh-phone">
          <div class="lh-screen">
            <div class="lh-notch"></div>
            <div class="lh-app-hi">Boa tarde 👋</div>
            <div class="lh-app-title">Perto de você</div>
            <div class="lh-app-chips">
              <span class="lh-app-chip is-on">Lavagem</span>
              <span class="lh-app-chip">Aberto agora</span>
            </div>
            <% if phone_shops.any? %>
              <% phone_shops.each do |cw| %>
                <% open = @open_car_wash_ids&.include?(cw.id) %>
                <div class="lh-app-row">
                  <div class="lh-app-av" data-logo="<%= cw.name %>"></div>
                  <div style="min-width:0;flex:1;">
                    <div class="lh-app-name"><%= cw.name %></div>
                    <div class="lh-app-sub"><%= cw.try(:bairro).presence || cw.try(:cidade).presence || "Perto de você" %></div>
                  </div>
                  <span class="lh-status <%= open ? 'is-open' : 'is-closed' %>"><%= open ? "ABERTO" : "FECHADO" %></span>
                </div>
              <% end %>
            <% else %>
              <% [["Lava-rápido do bairro", "Aberto"], ["Estética automotiva", "Aberto"], ["Lava jato express", "Aberto"]].each do |n, _| %>
                <div class="lh-app-row">
                  <div class="lh-app-av" data-logo="<%= n %>"></div>
                  <div style="min-width:0;flex:1;"><div class="lh-app-name"><%= n %></div><div class="lh-app-sub">Perto de você</div></div>
                  <span class="lh-status is-open">ABERTO</span>
                </div>
              <% end %>
            <% end %>
            <div class="lh-toast">
              <div class="lh-toast-check"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div>
              <div><b>Agendado!</b><span>Lavagem completa · hoje às 14:30</span></div>
            </div>
          </div>
        </div>
        </div>
      </div>
    </div>
  </section>

  <%# ── 2. Marquee ────────────────────────────────────────────────────── %>
  <div class="lh-marquee" aria-hidden="true">
    <div class="lh-marquee-track">
      <% 2.times do %>
        <% services_ticker.each do |s| %><span class="lh-marquee-item"><%= s %></span><% end %>
      <% end %>
    </div>
  </div>

  <%# ── 3. Como funciona ─────────────────────────────────────────────── %>
  <%# Com movimento, a seção fica presa na tela e a rolagem passa os três
      passos: o celular troca de tela (escolher o serviço, o horário,
      agendado) e o passo da vez acende. Sem movimento, tudo à vista. %>
  <section class="lh-section lh-how" id="lh-how">
    <div class="lh-how-pinned">
      <div class="lh-wrap lh-how-grid">
        <div>
          <div class="lh-eyebrow lh-reveal">Como funciona</div>
          <h2 class="lh-h2 lh-reveal" data-delay="1">Três toques. Carro limpo.</h2>
          <ol class="lh-how-steps">
            <li class="lh-how-step is-on" data-step="0">
              <span class="n">01</span><h3>Escolha</h3>
              <p>Veja quem está aberto agora, os serviços de cada lugar e o preço antes de sair de casa.</p>
            </li>
            <li class="lh-how-step" data-step="1">
              <span class="n">02</span><h3>Agende</h3>
              <p>Escolha o horário. A confirmação chega na hora — e um lembrete, na véspera.</p>
            </li>
            <li class="lh-how-step" data-step="2">
              <span class="n">03</span><h3>Vazou</h3>
              <p>Chegou, lavou, foi embora. Depois, avalie — aqui só avalia quem foi atendido.</p>
            </li>
          </ol>
          <div class="lh-how-bar" aria-hidden="true"><i><b></b></i><i><b></b></i><i><b></b></i></div>
        </div>

        <div class="lh-how-phone" aria-hidden="true">
          <div class="lh-how-box" id="lh-how-box">
            <div class="lh-phone">
              <div class="lh-screen" style="padding:0">
                <div class="lh-notch" style="z-index:2"></div>
                <div class="lh-scr is-on" data-scr="0">
                  <div class="lh-scr-k">Lavagem completa · aberto</div>
                  <div class="lh-scr-t">Serviços</div>
                  <div class="lh-svc"><div>Lavagem simples<small>Por fora, 30 min</small></div><span>R$ 40</span></div>
                  <div class="lh-svc is-pick"><div>Lavagem completa<small>Dentro e fora, 1 h</small></div><span>R$ 70</span></div>
                  <div class="lh-svc"><div>Higienização<small>Bancos e carpete, 3 h</small></div><span>R$ 220</span></div>
                  <div class="lh-svc"><div>Polimento<small>Brilho e proteção, 4 h</small></div><span>R$ 280</span></div>
                  <div class="lh-scr-cta">Escolher horário</div>
                </div>
                <div class="lh-scr" data-scr="1">
                  <div class="lh-scr-k">Lavagem completa · R$ 70</div>
                  <div class="lh-scr-t">Quando?</div>
                  <div class="lh-days">
                    <span class="is-on">HOJE<b>21</b></span><span>QUI<b>22</b></span><span>SEX<b>23</b></span><span>SÁB<b>24</b></span>
                  </div>
                  <div class="lh-times">
                    <span class="is-off">09:00</span><span>10:30</span><span class="is-off">11:00</span>
                    <span>13:00</span><span class="is-pick">14:30</span><span>15:00</span>
                    <span>16:30</span><span class="is-off">17:00</span><span>18:00</span>
                  </div>
                  <div class="lh-scr-cta">Confirmar agendamento</div>
                </div>
                <div class="lh-scr" data-scr="2">
                  <div class="lh-done">
                    <div class="lh-done-check"><svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div>
                    <b>Agendado!</b>
                    <span>Lavagem completa · hoje às 14:30</span>
                    <div class="lh-done-rows">
                      <div>🔔 <span><b>Lembrete</b> na véspera</span></div>
                      <div>⭐ <span><b>Avalie</b> depois de lavar</span><span class="lh-stars">★★★★★</span></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%# ── 4. Disponível ────────────────────────────────────────────────── %>
  <section class="lh-dark" id="lh-dark">
    <div class="lh-wrap"><div class="lh-section lh-dark-grid">
      <div>
        <div class="lh-eyebrow lh-reveal">Disponível</div>
        <h2 class="lh-h2 lh-reveal" data-delay="1">Vaga em 30 minutos. Perto de você.</h2>
        <p class="lh-dark-lead lh-reveal" data-delay="2">
          Lava-rápidos publicam os horários que sobraram no dia. Você garante a vaga
          <strong>pagando 35% pelo app</strong> e acerta o resto lá. Bateu a vontade, resolveu.
        </p>
      </div>
      <div class="lh-slot lh-reveal" data-delay="2" aria-hidden="true">
        <div class="lh-slot-top">
          <span class="lh-slot-tag"><span class="lh-dot-live"></span>Vaga livre agora</span>
          <span class="lh-status is-open">ABERTO</span>
        </div>
        <div class="lh-slot-time" id="lh-countdown">29:59</div>
        <div class="lh-slot-cap">para a vaga começar</div>
        <div class="lh-slot-bar"><i id="lh-countdown-bar"></i></div>
        <div class="lh-slot-foot">
          <div><b>Lavagem completa</b>a 1,2 km de você</div>
          <span class="lh-btn lh-btn--light" style="height:48px;padding:0 22px;font-size:15px;white-space:nowrap;">Garantir vaga</span>
        </div>
      </div>
    </div></div>
  </section>

  <%# ── 4b. Números (fatos do produto; contam ao aparecer) ───────────── %>
  <section class="lh-section" style="padding-bottom:0">
    <div class="lh-wrap">
      <div class="lh-stats">
        <%# Só regras do produto. Sem contagem de lava-rápidos: os cadastrados
            hoje são de teste — o número volta quando houver lojas reais. %>
        <div class="lh-stat lh-reveal"><b><span data-count="30">30</span><small>min</small></b><span>pra vaga do Disponível começar</span></div>
        <div class="lh-stat lh-reveal" data-delay="1"><b><span data-count="35">35</span><small>%</small></b><span>pagos no app garantem a vaga; o resto, lá</span></div>
        <div class="lh-stat lh-reveal" data-delay="2"><b data-count="3">3</b><span>toques do app ao carro limpo</span></div>
      </div>
    </div>
  </section>

  <%# ── 5. Perto de você ─────────────────────────────────────────────── %>
  <% if shops.any? %>
    <section class="lh-section">
      <div class="lh-wrap">
        <div class="lh-near-head">
          <div>
            <div class="lh-eyebrow lh-reveal">Na Loov agora</div>
            <h2 class="lh-h2 lh-reveal" data-delay="1" id="lh-near-title">Lava-rápidos na Loov.</h2>
          </div>
          <div class="lh-reveal" data-delay="1">
            <button type="button" class="lh-near-btn" id="lh-near-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <span>Ver os mais perto de mim</span>
            </button>
            <span class="lh-near-note" id="lh-near-note" hidden>ORDENADO PELA SUA LOCALIZAÇÃO</span>
          </div>
        </div>
        <div class="lh-list lh-reveal" data-delay="2" id="lh-near-list">
          <% shops.each_with_index do |cw, i| %>
            <%
              open = @open_car_wash_ids&.include?(cw.id)
              rua  = [cw.try(:logradouro), cw.try(:numero)].compact_blank.join(", ")
              addr = [rua.presence, cw.try(:bairro).presence].compact.join(" · ").presence || cw.address.to_s
            %>
            <a href="<%= car_wash_path(cw) %>" class="lh-item">
              <span class="lh-item-n"><%= format("%02d", i + 1) %></span>
              <span class="lh-item-av" data-logo="<%= cw.name %>"></span>
              <span style="min-width:0;">
                <span class="lh-item-name" style="display:block;"><%= cw.name %></span>
                <span class="lh-item-addr" style="display:block;"><%= addr %></span>
              </span>
              <span class="lh-status <%= open ? 'is-open' : 'is-closed' %>"><%= open ? "ABERTO" : "FECHADO" %></span>
              <span class="lh-item-go" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
            </a>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>

  <%# ── 6. Para lava-rápidos ─────────────────────────────────────────── %>
  <section class="lh-section" id="para-lava-rapidos" style="background:var(--sand);">
    <div class="lh-wrap lh-owner">
      <div>
        <div class="lh-eyebrow lh-reveal">Para lava-rápidos</div>
        <h2 class="lh-h2 lh-reveal" data-delay="1">Agenda cheia. Contas em dia.</h2>
        <div class="lh-badge lh-reveal" data-delay="1">✓ Grátis na fase de testes</div>
        <ul class="lh-checks lh-reveal" data-delay="2">
          <li><i>✓</i><span><b>Agenda e check-in</b> em tempo real, do celular ou do computador.</span></li>
          <li><i>✓</i><span><b>Horário vago vira cliente</b> com as vagas de última hora do Disponível.</span></li>
          <li><i>✓</i><span><b>Financeiro de verdade:</b> faturamento por serviço, custos e relatório em PDF e Excel.</span></li>
          <li><i>✓</i><span><b>Equipe e fidelidade:</b> atendentes com acesso limitado e cartão fidelidade para o cliente voltar.</span></li>
        </ul>
        <a href="<%= new_user_registration_path(role: "owner") %>" class="lh-btn lh-btn--primary lh-reveal" data-delay="3">
          Cadastrar meu lava-rápido
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
      <div class="lh-dash lh-reveal" data-delay="2" id="lh-dash" aria-hidden="true">
        <div class="lh-dash-label">Lucro do mês</div>
        <div class="lh-dash-big">R$ <span data-count="8420" data-thousands>8.420</span></div>
        <span class="lh-dash-pill">Margem 32%</span>
        <div class="lh-bars">
          <% [[62, 38], [70, 40], [58, 36], [82, 42], [90, 44], [76, 40]].each_with_index do |(rev, cost), i| %>
            <span style="height:<%= rev %>%;transition-delay:<%= i * 0.06 %>s"></span>
            <span class="is-cost" style="height:<%= cost %>%;transition-delay:<%= i * 0.06 + 0.03 %>s"></span>
          <% end %>
        </div>
        <div class="lh-dash-legend"><span><b style="background:var(--coral-500)"></b>Faturamento</span><span><b style="background:var(--stone)"></b>Custos</span></div>
        <div class="lh-dash-note">Ilustração do painel do dono.</div>
      </div>
    </div>
  </section>

  <%# ── 7. Fecho ─────────────────────────────────────────────────────── %>
  <section class="lh-end">
    <div class="lh-wrap">
      <div class="lh-end-word" id="lh-end-word"><span class="w">Vazou</span><em>.</em></div>
      <p class="lh-reveal" data-delay="1">Seu próximo carro limpo está a três toques.</p>
      <a href="<%= new_user_registration_path %>" class="lh-btn lh-btn--primary lh-reveal" data-delay="2">
        Criar conta grátis
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  </section>

  <%= render "shared/site_footer", audience: :visitor %>
</div>

<%= render "shared/loov_logos" %>
<link rel="stylesheet" href="/vendor/lenis-1.1.13.css">
<script src="/vendor/gsap-3.12.5.min.js"></script>
<script src="/vendor/ScrollTrigger-3.12.5.min.js"></script>
<script src="/vendor/lenis-1.1.13.min.js"></script>
<script>
  (function () {
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Logos das lojas (mesmo emblema da home do cliente e do app).
    function pintarLogos(root) {
      (root || document).querySelectorAll('[data-logo]').forEach(function (el) {
        el.innerHTML = LoovLogos.logoOf({ name: el.getAttribute('data-logo') });
      });
    }
    pintarLogos();

    // ── Perto de você sob demanda ────────────────────────────────────────
    // Sem localização a lista não tem ordem de distância, então o título não
    // promete "perto de você". O pedido de permissão só sai no botão. Quem
    // já deu permissão (ou já tem posição guardada pela home) vê ordenado
    // direto, sem pedir de novo.
    var nearBtn = document.getElementById('lh-near-btn');
    var nearList = document.getElementById('lh-near-list');
    var COORDS_KEY = 'loov_last_coords';
    function escH(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
    function fmtKm(km) { var n = parseFloat(km); if (isNaN(n)) return null; return n < 1 ? Math.round(n * 1000) + ' m' : n.toFixed(1).replace('.', ',') + ' km'; }
    function ordenarPerto(c) {
      return fetch('/car_washes.json?latitude=' + c.latitude + '&longitude=' + c.longitude, { headers: { Accept: 'application/json' } })
        .then(function (r) { if (!r.ok) throw new Error(); return r.json(); })
        .then(function (list) {
          if (!Array.isArray(list) || !list.length) throw new Error();
          var top = list.filter(function (cw) { return cw.distance_km != null; }).slice(0, 6);
          if (!top.length) throw new Error();
          var go = nearList.querySelector('.lh-item-go');
          go = go ? go.outerHTML : '';
          nearList.innerHTML = top.map(function (cw, i) {
            var rua = [cw.logradouro, cw.numero].filter(Boolean).join(', ');
            var addr = [rua, cw.bairro].filter(Boolean).join(' · ') || cw.address || '';
            var dist = fmtKm(cw.distance_km);
            return '<a href="/car_washes/' + encodeURIComponent(cw.id) + '" class="lh-item">' +
              '<span class="lh-item-n">' + String(i + 1).padStart(2, '0') + '</span>' +
              '<span class="lh-item-av" data-logo="' + escH(cw.name) + '"></span>' +
              '<span style="min-width:0;"><span class="lh-item-name" style="display:block;">' + escH(cw.name) + '</span>' +
              '<span class="lh-item-addr" style="display:block;">' + escH(dist ? dist + ' · ' + addr : addr) + '</span></span>' +
              '<span class="lh-status ' + (cw.open_now ? 'is-open' : 'is-closed') + '">' + (cw.open_now ? 'ABERTO' : 'FECHADO') + '</span>' +
              go + '</a>';
          }).join('');
          pintarLogos(nearList);
          document.getElementById('lh-near-title').textContent = 'Perto de você.';
          nearBtn.hidden = true;
          document.getElementById('lh-near-note').hidden = false;
        });
    }
    function guardar(c) { try { localStorage.setItem(COORDS_KEY, JSON.stringify({ lat: c.latitude, lng: c.longitude })); } catch (e) {} }
    function localizar() {
      if (!navigator.geolocation) return;
      nearBtn.disabled = true;
      nearBtn.querySelector('span').textContent = 'Localizando...';
      navigator.geolocation.getCurrentPosition(function (pos) {
        var c = { latitude: pos.coords.latitude, longitude: pos.coords.longitude };
        guardar(c);
        ordenarPerto(c).catch(restaurarBtn);
      }, restaurarBtn, { enableHighAccuracy: false, timeout: 10000, maximumAge: 300000 });
    }
    // Recusou ou falhou: a lista fica como está, sem mensagem de erro.
    function restaurarBtn() {
      nearBtn.disabled = false;
      nearBtn.querySelector('span').textContent = 'Ver os mais perto de mim';
    }
    if (nearBtn && nearList) {
      if (!navigator.geolocation) nearBtn.hidden = true;
      nearBtn.addEventListener('click', localizar);
      var guardada = null;
      try { var g = JSON.parse(localStorage.getItem(COORDS_KEY) || 'null'); if (g) guardada = { latitude: g.lat, longitude: g.lng }; } catch (e) {}
      if (guardada) {
        ordenarPerto(guardada).catch(function () {});
      } else if (navigator.permissions && navigator.permissions.query) {
        navigator.permissions.query({ name: 'geolocation' }).then(function (st) {
          if (st.state === 'granted') localizar();
        }).catch(function () {});
      }
    }

    // ── Movimento preso à rolagem ────────────────────────────────────────
    // Sem GSAP/Lenis (falhou o carregamento) ou com prefers-reduced-motion:
    // tudo à vista, sem animação.
    var root = document.querySelector('.lh');
    var motion = !reduce && window.gsap && window.ScrollTrigger && window.Lenis;
    var els = document.querySelectorAll('.lh-reveal, #lh-dash');
    function contar(el) {
      var alvo = parseInt(el.getAttribute('data-count'), 10), mil = el.hasAttribute('data-thousands');
      var fmt = function (n) { n = Math.round(n); return mil ? n.toLocaleString('pt-BR') : String(n); };
      if (!motion) { el.textContent = fmt(alvo); return; }
      var o = { v: 0 };
      gsap.to(o, { v: alvo, duration: 1.6, ease: 'power3.out', onUpdate: function () { el.textContent = fmt(o.v); } });
    }

    if (!motion) {
      els.forEach(function (el) { el.classList.add('is-in'); });
    } else {
      root.classList.add('lh-motion');
      gsap.registerPlugin(ScrollTrigger);

      // Rolagem suave (só roda/trackpad; no toque o celular já é suave).
      var lenis = new Lenis({ lerp: 0.1, wheelMultiplier: 1 });
      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add(function (t) { lenis.raf(t * 1000); });
      gsap.ticker.lagSmoothing(0);
      document.querySelectorAll('.lh a[href^="#"]').forEach(function (a) {
        a.addEventListener('click', function (e) {
          var alvo = document.querySelector(a.getAttribute('href'));
          if (alvo) { e.preventDefault(); lenis.scrollTo(alvo, { offset: -60, duration: 1.4 }); }
        });
      });

      // Revelar ao rolar.
      els.forEach(function (el) {
        ScrollTrigger.create({ trigger: el, start: 'top 88%', once: true, onEnter: function () { el.classList.add('is-in'); } });
      });

      // 1. Hero em camadas: o texto sobe devagar e some; o celular sobe mais
      // rápido e se endireita; o brilho de fundo acompanha.
      var hero = document.querySelector('.lh-hero');
      // Só no computador: no celular o aparelho fica embaixo do texto e é
      // visto já rolando — girado ali ele parecia torto. Lá fica reto.
      gsap.matchMedia().add('(min-width: 961px)', function () {
        gsap.to('.lh-hero-copy', { yPercent: -14, opacity: 0.15, ease: 'none', scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: true } });
        gsap.to('#lh-phone-float', { y: -140, rotate: -4, scale: 0.94, ease: 'none', scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: true } });
      });

      // 2. Faixa de serviços: acelera e inclina com a velocidade da rolagem,
      // e inverte o sentido quando a pessoa sobe.
      var track = document.querySelector('.lh-marquee-track');
      if (track) {
        track.style.animation = 'none';
        var loop = gsap.to(track, { xPercent: -50, duration: 40, ease: 'none', repeat: -1 });
        var skew = gsap.quickTo(track, 'skewX', { duration: 0.4, ease: 'power3' });
        ScrollTrigger.create({
          onUpdate: function (st) {
            var v = st.getVelocity();
            loop.timeScale(gsap.utils.clamp(-6, 6, (st.direction || 1) * (1 + Math.abs(v) / 400)));
            skew(gsap.utils.clamp(-8, 8, -v / 250));
          }
        });
        ScrollTrigger.addEventListener('scrollEnd', function () { gsap.to(loop, { timeScale: 1, duration: 0.6 }); skew(0); });
      }

      // 3. Três toques: a seção fica presa enquanto a rolagem passa os
      // passos. No celular (tela pequena) o aparelho encolhe pra caber.
      var how = document.getElementById('lh-how');
      var box = document.getElementById('lh-how-box');
      var steps = how.querySelectorAll('.lh-how-step');
      var scrs = how.querySelectorAll('.lh-scr');
      var bars = how.querySelectorAll('.lh-how-bar b');
      function escala() {
        var pequeno = window.innerWidth < 961;
        var s = pequeno ? Math.min(0.66, (window.innerHeight - 290) / 650) : Math.min(1, (window.innerHeight - 140) / 650);
        box.style.setProperty('--s', Math.max(0.42, s).toFixed(3));
      }
      escala();
      window.addEventListener('resize', escala);
      var atual = -1;
      function passo(i) {
        if (i === atual) return;
        atual = i;
        steps.forEach(function (el, k) { el.classList.toggle('is-on', k === i); });
        scrs.forEach(function (el, k) { el.classList.toggle('is-on', k === i); el.classList.toggle('is-past', k < i); });
      }
      passo(0);
      ScrollTrigger.create({
        trigger: how.querySelector('.lh-how-pinned'), start: 'top top', end: '+=220%', pin: true, scrub: true,
        onUpdate: function (st) {
          var p = st.progress * 3;
          passo(Math.min(2, Math.floor(p)));
          bars.forEach(function (b, k) { b.style.transform = 'scaleX(' + gsap.utils.clamp(0, 1, p - k).toFixed(3) + ')'; });
        }
      });

      // 4. Disponível: o cartão escuro cresce até ocupar a tela, como a
      // Viture troca o clima da página.
      var dark = document.getElementById('lh-dark');
      gsap.fromTo(dark, { clipPath: 'inset(0% 5% 0% 5% round 44px)' }, {
        clipPath: 'inset(0% 0% 0% 0% round 0px)', ease: 'none',
        scrollTrigger: { trigger: dark, start: 'top 95%', end: 'top 15%', scrub: true }
      });
      dark.style.margin = '0';
      dark.style.borderRadius = '0';

      // 6. Painel do dono: inclina de leve e se endireita ao entrar.
      gsap.fromTo('#lh-dash', { rotateX: 14, transformPerspective: 1200, y: 40 }, {
        rotateX: 0, y: 0, ease: 'none', scrollTrigger: { trigger: '#lh-dash', start: 'top bottom', end: 'center 60%', scrub: true }
      });

      // 7. Fecho: "Vazou" se enche de baixo pra cima; ao encher, o ponto cai.
      var word = document.getElementById('lh-end-word');
      var dot = word.querySelector('em');
      gsap.set(dot, { y: -220, opacity: 0 });
      var caiu = false;
      ScrollTrigger.create({
        trigger: word, start: 'top 90%', end: 'bottom 55%', scrub: true,
        onUpdate: function (st) {
          word.querySelector('.w').style.setProperty('--fill', (st.progress * 100).toFixed(1) + '%');
          if (st.progress > 0.96 && !caiu) { caiu = true; gsap.to(dot, { y: 0, opacity: 1, duration: 0.9, ease: 'bounce.out' }); }
          if (st.progress < 0.5 && caiu) { caiu = false; gsap.to(dot, { y: -220, opacity: 0, duration: 0.3 }); }
        }
      });
    }

    // Números contam ao aparecer.
    document.querySelectorAll('.lh [data-count]').forEach(function (el) {
      if (!motion) return;
      el.textContent = '0';
      ScrollTrigger.create({ trigger: el, start: 'top 88%', once: true, onEnter: function () { contar(el); } });
    });

    // Celular acompanha o mouse de leve (só desktop, só com movimento).
    var phone = document.getElementById('lh-phone');
    if (phone && !reduce && window.matchMedia('(pointer: fine) and (min-width: 961px)').matches) {
      window.addEventListener('mousemove', function (ev) {
        var x = (ev.clientX / window.innerWidth - 0.5);
        var y = (ev.clientY / window.innerHeight - 0.5);
        phone.style.transform = 'rotateY(' + (-8 + x * 10).toFixed(2) + 'deg) rotateX(' + (4 - y * 8).toFixed(2) + 'deg)';
      }, { passive: true });
    }

    // Cronômetro do Disponível: 30 min correndo, recomeça ao zerar.
    var clock = document.getElementById('lh-countdown');
    var bar = document.getElementById('lh-countdown-bar');
    if (clock && !reduce) {
      var total = 30 * 60, left = total - 1;
      setInterval(function () {
        left = left <= 0 ? total - 1 : left - 1;
        var m = Math.floor(left / 60), s = left % 60;
        clock.textContent = String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
        if (bar) bar.style.transform = 'scaleX(' + (left / total).toFixed(4) + ')';
      }, 1000);
    }
  })();
</script>
