  .c-days { display: flex; gap: 7px; margin: 0 14px 16px; }
  .c-days span { flex: 0 0 52px; height: 62px; border-radius: 14px; background: var(--paper); border: 1px solid var(--stone); display: flex; flex-direction: column; align-items: center; justify-content: center; }
  .c-days small { font-family: 'JetBrains Mono', monospace; font-size: 7.5px; color: var(--graphite); opacity: .7; }
  .c-days b { font-family: 'Space Grotesk', sans-serif; font-size: 18px; line-height: 1.1; }
  .c-days span.is-on { background: var(--ink); border-color: var(--ink); }
  .c-days span.is-on small, .c-days span.is-on b { color: var(--cream); opacity: 1; }
  .c-times { display: grid; grid-template-columns: repeat(3, 1fr); gap: 7px; margin: 0 14px; }
  .c-times span { height: 38px; border-radius: 11px; background: var(--paper); border: 1px solid var(--stone); display: flex; align-items: center; justify-content: center; font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 13px; transition: background .35s ease, color .35s ease, border-color .35s ease; }
  .c-times span.is-off { background: var(--sand); color: var(--ash); text-decoration: line-through; }
  .lh-scr.is-on .c-times span.is-pick { background: var(--ink); border-color: var(--ink); color: var(--cream); transition-delay: .45s; }
  .c-bar { position: absolute; left: 10px; right: 10px; bottom: 14px; display: flex; align-items: center; gap: 8px; padding: 8px; border-radius: 26px; background: var(--paper); box-shadow: 0 10px 24px -12px rgba(25,20,15,.4); }
  .c-bar > span { flex: 1; padding-left: 10px; }
  .c-bar small { display: block; font-family: 'JetBrains Mono', monospace; font-size: 8px; letter-spacing: 1px; color: var(--ash); }
  .c-bar b { font-family: 'Space Grotesk', sans-serif; font-size: 16px; }
  .c-bar em { font-style: normal; display: inline-flex; align-items: center; gap: 6px; height: 40px; padding: 0 16px; border-radius: 20px; background: var(--coral-500); color: var(--cream); font-size: 12px; font-weight: 600; }
  .lh-scr[data-scr="2"] { padding: 46px 16px 16px; }
  .c-check { width: 64px; height: 64px; border-radius: 50%; background: var(--coral-500); margin: 0 auto; display: flex; align-items: center; justify-content: center; transform: scale(.4); opacity: 0; transition: transform .6s cubic-bezier(.3,1.6,.5,1) .25s, opacity .3s ease .25s; }
  .lh-scr.is-on .c-check { transform: none; opacity: 1; }
  .c-ok { margin-top: 12px; text-align: center; font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 26px; letter-spacing: -0.04em; }
  .c-ok-s { text-align: center; font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 16px; letter-spacing: -0.03em; color: var(--graphite); }
  .c-card { margin-top: 14px; padding: 13px; border-radius: 16px; background: var(--paper); border: 1px solid var(--stone); }
  .c-lbl2 { display: block; font-family: 'JetBrains Mono', monospace; font-size: 8px; letter-spacing: 1px; color: var(--ash); }
  .c-when { display: block; margin-top: 2px; font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 16px; }
  .c-pill { display: inline-flex; align-items: center; gap: 6px; height: 28px; padding: 0 11px; margin-top: 8px; border-radius: 99px; border: 1.5px solid var(--ink); font-size: 10.5px; font-weight: 600; }
  .c-div { display: block; height: 1px; background: var(--stone); margin: 10px 0; }
  .c-shop { display: flex; align-items: center; gap: 8px; }
  .c-shop b { display: block; font-size: 11.5px; }
  .c-shop small { display: block; font-size: 9.5px; color: var(--graphite); }
  .c-addr { display: block; margin-top: 8px; font-size: 9.5px; color: var(--graphite); }
  .c-pay { display: flex; justify-content: space-between; align-items: center; font-size: 10.5px; color: var(--graphite); }
  .c-pay b { font-family: 'Space Grotesk', sans-serif; font-size: 16px; color: var(--ink); }
  .c-cta { margin-top: 12px; height: 42px; border-radius: 22px; background: var(--ink); color: var(--cream); display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 600; }
  /* Com movimento (JS): a seção presa ocupa a tela, centrada. */
  .lh-motion .lh-how { padding: 0; }
  .lh-motion .lh-how-pinned { min-height: 100vh; display: flex; align-items: center; padding: 84px 0 24px; }
  .lh-motion .lh-how-pinned > .lh-wrap { width: 100%; }
  /* O texto é mais alto que a tela; centralizado com ele, o celular descia
     e cortava embaixo. Preso no topo da coluna, cabe inteiro. */
  .lh-motion .lh-how-phone { align-self: start; }
  /* Notebook (tela baixa): a seção presa precisa caber inteira na tela,
     senão o passo 03 fica abaixo da dobra. Título menor, passos mais
     juntos e só o passo da vez mostra o texto. */
  @media (min-width: 961px) and (max-height: 860px) {
    .lh-motion .lh-how-pinned .lh-h2 { font-size: clamp(40px, 4.4vw, 64px) !important; }
    .lh-motion .lh-how-steps { margin-top: 28px; gap: 0; }
    .lh-motion .lh-how-step { padding: 14px 0; row-gap: 0; }
