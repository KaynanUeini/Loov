        'float caixa(vec2 p,vec4 r,float rad){vec2 c=(r.xy+r.zw)*.5;vec2 e=(r.zw-r.xy)*.5;vec2 q=abs(p-c)-e+rad;return length(max(q,0.))+min(max(q.x,q.y),0.)-rad;}',
        'void main(){',
        ' vec2 fc=gl_FragCoord.xy;vec2 p=fc/uR.y;float asp=uR.x/uR.y;vec2 mm=uM*vec2(asp,1.);',
        ' float dk=1.-smoothstep(-.75,.75,caixa(fc,uDk,uDr));',
        ' float sd=1.-step(0.,caixa(fc,uSd,0.));',
