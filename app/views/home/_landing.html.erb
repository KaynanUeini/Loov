        if (document.hidden) return;
        var t = (now - t0) / 1000, dt = Math.min(.05, (now - antes) / 1000); antes = now;
        if (!fino || now - m.ultimo > 2500) { m.tx = (innerWidth < 768 ? .5 : .72) + Math.sin(t * .3) * .2; m.ty = .45 + Math.cos(t * .23) * .2; }
        m.x += (m.tx - m.x) * .08; m.y += (m.ty - m.y) * .08;
        desenhar(t, dt);
        if (sonda && now > sonda.de) { sonda.n++; if (now > sonda.de + 1200) { var qps = sonda.n / 1.2; sonda = null; if (qps < 45) { escalaRes = .5; tam(); } } }
        raf = requestAnimationFrame(quadro);
      }
      window.addEventListener('resize', tam);
      tam();
      if (reduce) {
        // Sem movimento: o relevo fica parado e só acompanha a rolagem.
        window.addEventListener('scroll', function () { if (!raf) raf = requestAnimationFrame(function () { raf = 0; desenhar(0, 0); }); }, { passive: true });
        desenhar(0, 0);
        return;
      }
      if (fino) window.addEventListener('pointermove', function (e) { m.tx = e.clientX / innerWidth; m.ty = e.clientY / innerHeight; m.ultimo = performance.now(); }, { passive: true });
      document.addEventListener('visibilitychange', function () { if (!document.hidden && !raf) { antes = performance.now(); raf = requestAnimationFrame(quadro); } });
      raf = requestAnimationFrame(quadro);
    })();

    // Botões: o texto rola letra a letra no hover e o botão puxa de leve
    // pro cursor (só mouse); no toque, ele afunda e volta com mola.
    var mouse = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    function vivos(raiz) {
      if (reduce) return;
      raiz.querySelectorAll('.lh-btn').forEach(function (b) {
        if (b.dataset.vivo) return;
        b.dataset.vivo = '1';
        if (mouse) {
          var no = Array.prototype.find.call(b.childNodes, function (n) { return n.nodeType === 3 && n.textContent.trim(); });
          if (no) {
            var txt = no.textContent.trim(), roll = document.createElement('span');
            roll.className = 'lh-roll'; roll.setAttribute('aria-hidden', 'true');
            txt.split('').forEach(function (c, i) { var e = document.createElement('i'); e.style.setProperty('--i', i); e.textContent = c; roll.appendChild(e); });
            if (!b.getAttribute('aria-label') && b.tagName === 'A') b.setAttribute('aria-label', txt);
            b.replaceChild(roll, no);
          }
        }
        if (!window.gsap) return;
        if (mouse && b.tagName === 'A') {
          var qx = gsap.quickTo(b, 'x', { duration: .5, ease: 'power3' }), qy = gsap.quickTo(b, 'y', { duration: .5, ease: 'power3' });
          b.addEventListener('pointermove', function (e) { var r = b.getBoundingClientRect(); qx((e.clientX - r.left - r.width / 2) * .22); qy((e.clientY - r.top - r.height / 2) * .3); });
          b.addEventListener('pointerleave', function () { qx(0); qy(0); });
        } else if (!mouse) {
          b.addEventListener('pointerdown', function () { gsap.to(b, { scale: .96, duration: .12 }); });
          ['pointerup', 'pointercancel', 'pointerleave'].forEach(function (ev) { b.addEventListener(ev, function () { gsap.to(b, { scale: 1, duration: .4, ease: 'back.out(3)' }); }); });
        }
      });
    }
    vivos(document);

    // Dono: abas que andam sozinhas (6 s cada, a barra mostra o tempo) até a
    // pessoa escolher uma; só rodam com a seção na tela.
    (function () {
      var feats = document.querySelectorAll('.lh-feat'), telas = document.querySelectorAll('.lh-ds');
      if (!feats.length) return;
      var atual = 0, auto = !reduce, t0 = 0, raf = 0, visivel = false, DUR = 6000;
      function ir(i) {
        atual = i;
        feats.forEach(function (f, k) { f.classList.toggle('is-on', k === i); f.setAttribute('aria-selected', String(k === i)); f.querySelector('.lh-feat-bar b').style.transform = 'scaleX(0)'; });
        telas.forEach(function (t, k) { t.classList.toggle('is-on', k === i); });
        t0 = performance.now();
      }
      function passo(now) {
        raf = 0;
        if (!auto || !visivel) return;
        var p = Math.min(1, (now - t0) / DUR);
        feats[atual].querySelector('.lh-feat-bar b').style.transform = 'scaleX(' + p.toFixed(3) + ')';
        if (p >= 1) ir((atual + 1) % feats.length);
        raf = requestAnimationFrame(passo);
      }
      feats.forEach(function (f, k) {
        f.addEventListener('click', function () { auto = false; ir(k); });
      });
      if ('IntersectionObserver' in window) new IntersectionObserver(function (es) {
        visivel = es[0].isIntersecting;
        if (visivel && auto && !raf) { t0 = performance.now() - 0; raf = requestAnimationFrame(passo); }
      }, { threshold: .35 }).observe(document.querySelector('.lh-dono-grid'));
      ir(0);
    })();

    // Last Minute: o agora corre na régua entre duas marcas de meia hora; a
    // próxima marca é a vaga (CarWash#last_minute_slot).
    function hm(d) { return String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0'); }
    function el(id) { return document.getElementById(id); }
    function lmTique() {
      var agora = new Date(), antes = new Date(agora), prox, depois;
      antes.setSeconds(0, 0); antes.setMinutes(agora.getMinutes() < 30 ? 0 : 30);
      prox = new Date(antes.getTime() + 30 * 60000); depois = new Date(prox.getTime() + 30 * 60000);
      var falta = Math.max(0, Math.round((prox - agora) / 1000)), min = Math.ceil(falta / 60);
      if (!el('lh-lm-hora')) return;
      el('lh-lm-agora').textContent = hm(agora);
      el('lh-lm-antes').textContent = hm(antes); el('lh-lm-hora').textContent = hm(prox); el('lh-lm-depois').textContent = hm(depois);
      el('lh-lm-hora2').textContent = hm(prox); el('lh-lm-limite').textContent = hm(prox); el('lh-lm-prox').textContent = hm(depois);
      el('lh-lm-falta').textContent = min <= 1 ? 'começa em menos de 1 min' : 'começa em ' + min + ' min';
      // A régua vai de "antes" (0%) a "depois" (100%): a vaga fica no meio.
      el('lh-lm-cursor').style.setProperty('--p', (((agora - antes) / 3600000) * 100).toFixed(2) + '%');
    }
    lmTique();
    if (!reduce) setInterval(lmTique, 1000);
  })();
</script>
