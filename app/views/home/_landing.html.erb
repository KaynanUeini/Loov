  <%# ── 4. Last Minute ───────────────────────────────────────────────── %>
  <%# Fatos do produto (CarWash::JANELA_LAST_MINUTE, RelevanciaLastMinute::RAIO_KM,
      Appointment::PREPAYMENT_PCT e ACCEPTANCE_TTL): a vaga é a da próxima
      meia hora, nos lava-rápidos até 5 km; 35% no app; o dono aceita em até
      3 min. O cartão mostra a próxima marca de meia hora de verdade. %>
  <section class="lh-dark" id="lh-dark">
    <div class="lh-wrap"><div class="lh-section lh-dark-grid">
      <div>
        <div class="lh-eyebrow lh-reveal">Last Minute</div>
        <h2 class="lh-h2 lh-reveal" data-delay="1">Bateu a vontade? <span class="lh-dest">Lava agora.</span></h2>
        <p class="lh-dark-lead lh-reveal" data-delay="2">
          A cada meia hora, o Last Minute mostra a próxima vaga livre nos lava-rápidos
          <strong>até 5 km de você</strong>. Sem agendar com antecedência, sem ligar pra perguntar.
        </p>
        <ol class="lh-lm-steps lh-reveal" data-delay="3">
          <li><b>Veja a vaga da vez</b><span>É sempre a próxima meia hora cheia. Se agora são 14:10, a vaga é a das 14:30; se são 14:40, é a das 15:00. Você escolhe em qual lava-rápido.</span></li>
          <li><b>Pague 35% no app</b><span>Garante o seu lugar. O resto você acerta lá.</span></li>
          <li><b>O lava-rápido confirma</b><span>Em até 3 minutos. Só vira cobrança se ele aceitar.</span></li>
        </ol>
      </div>
      <%# A régua da meia hora: o agora corre entre duas marcas e a próxima
          marca é a vaga. Relógio de verdade (lmTique, no fim da página). %>
      <div class="lh-slot lh-reveal" data-delay="2" aria-hidden="true">
        <div class="lh-slot-top">
          <span class="lh-slot-tag"><span class="lh-dot-live"></span>Agora <b id="lh-lm-agora">19:12</b></span>
          <span class="lh-status is-open">ATÉ 5 KM</span>
        </div>
        <div class="lh-regua">
          <div class="lh-regua-linha"><i id="lh-lm-cursor"></i></div>
          <div class="lh-regua-marcas"><span id="lh-lm-antes">19:00</span><span class="is-vaga" id="lh-lm-hora">19:30</span><span id="lh-lm-depois">20:00</span></div>
        </div>
        <div class="lh-slot-time"><span class="lh-slot-k">A vaga do Last Minute</span><span id="lh-lm-hora2">19:30</span></div>
        <div class="lh-slot-cap" id="lh-lm-falta">começa em 18 min</div>
        <div class="lh-slot-foot">
          <div><b>Uma vaga por vez</b>Passou das <span id="lh-lm-limite">19:30</span>, a próxima é a das <span id="lh-lm-prox">20:00</span>.</div>
        </div>
      </div>
    </div></div>
  </section>

  <%# ── 4b. Números (fatos do produto; contam ao aparecer) ───────────── %>
  <section class="lh-section" style="padding-bottom:0">
    <div class="lh-wrap">
      <div class="lh-stats">
        <%# Só regras do produto. Sem contagem de lava-rápidos: os cadastrados
            hoje são de teste — o número volta quando houver lojas reais. %>
        <div class="lh-stat lh-reveal"><b><span data-count="30">30</span><small>min</small></b><span>entre uma vaga e outra do Last Minute</span></div>
        <div class="lh-stat lh-reveal" data-delay="1"><b><span data-count="35">35</span><small>%</small></b><span>pagos no app garantem a vaga; o resto, lá</span></div>
        <div class="lh-stat lh-reveal" data-delay="2"><b><span data-count="5">5</span><small>km</small></b><span>de raio pra achar a vaga mais perto</span></div>
      </div>
    </div>
  </section>

  <%# ── 5. Perto de você ─────────────────────────────────────────────── %>
  <%# Cards lado a lado (o modelo da prévia): no computador e no iPad a seção
      fica presa e a rolagem passa os cards pro lado; no celular a fileira
      desliza com o dedo. Com mouse, o card vira o verso escuro (preço e
      horário de hoje) a partir do ponto do cursor; o toque abre o detalhe,
      que cresce do próprio card, com os serviços e o link pra agendar.
      Os dados são os mesmos do /car_washes.json, que também refaz a fileira
      quando a pessoa pede os mais perto. %>
  <% if shops.any? %>
    <%
      hoje = Time.current.in_time_zone("America/Sao_Paulo").wday
      shops_json = shops.map do |cw|
        rua  = [cw.try(:logradouro), cw.try(:numero)].compact_blank.join(", ")
        addr = [rua.presence, cw.try(:bairro).presence].compact.join(" · ").presence || cw.address.to_s
        {
          id: cw.id, name: cw.name, addr: addr,
          open_now: !!@open_car_wash_ids&.include?(cw.id),
          rating_avg: cw.reviews.average(:rating)&.to_f&.round(1), reviews_count: cw.reviews.count,
          operating_hours: cw.operating_hours.map { |oh| { day_of_week: oh.day_of_week.to_i, closes_at: oh.closes_at&.strftime("%H:%M") } },
          services: cw.services.map { |sv| { title: sv.title, price: sv.price.to_f, duration: sv.duration } }
        }
      end
    %>
    <section class="lh-near" id="lh-perto">
      <div class="lh-near-pin" id="lh-near-pin">
        <div class="lh-wrap">
          <div class="lh-near-head">
            <div>
              <div class="lh-eyebrow lh-reveal">Na Loov agora</div>
              <h2 class="lh-h2 lh-reveal" data-delay="1" id="lh-near-title">Lava-rápidos na <span class="lh-dest">Loov.</span></h2>
            </div>
            <div class="lh-near-tools lh-reveal" data-delay="1">
              <button type="button" class="lh-near-btn" id="lh-near-btn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                <span>Ver os mais perto de mim</span>
              </button>
              <span class="lh-near-note" id="lh-near-note" hidden>ORDENADO PELA SUA LOCALIZAÇÃO</span>
              <span class="lh-near-prog" aria-hidden="true"><span id="lh-near-n">01 / <%= format("%02d", shops.size) %></span><span class="lh-near-bar"><i id="lh-near-i"></i></span></span>
            </div>
          </div>
          <%# Sem .lh-reveal aqui: a transição dela brigava com o deslize preso à rolagem. %>
          <div class="lh-rail" id="lh-near-list" role="list"></div>
        </div>
      </div>
      <script type="application/json" id="lh-near-data"><%= raw json_escape(shops_json.to_json) %></script>
    </section>

    <div class="lh-pop" id="lh-pop" aria-hidden="true">
      <div class="lh-pop-bg" id="lh-pop-bg"></div>
      <div class="lh-pop-card" id="lh-pop-card" role="dialog" aria-modal="true" aria-labelledby="lh-pop-nome"><div class="lh-pop-in" id="lh-pop-in"></div></div>
    </div>
  <% end %>

