      dark.style.borderRadius = '0';

      // 5. Perto de você: a seção fica presa e a rolagem passa os cards pro
      // lado, em qualquer tela.
      gsap.matchMedia().add('all', function () {
        var rail = document.getElementById('lh-near-list');
        if (!rail) return;
        rail.classList.add('is-pinned');
        var dist = function () { return Math.max(0, rail.scrollWidth - rail.parentElement.clientWidth); };
