<%= render "shared/loov_logos" %>
<link rel="stylesheet" href="/vendor/lenis-1.1.13.css">
<script src="/vendor/gsap-3.12.5.min.js"></script>
<script src="/vendor/ScrollTrigger-3.12.5.min.js"></script>
<script src="/vendor/lenis-1.1.13.min.js"></script>
<script>
  (function () {
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Logos das lojas (mesmo emblema da home do cliente e do app).
    function pintarLogos(root) {
      (root || document).querySelectorAll('[data-logo]').forEach(function (el) {
        el.innerHTML = LoovLogos.logoOf({ name: el.getAttribute('data-logo') });
      });
    }
    pintarLogos();

    // ── Perto de você: cards, verso no hover e detalhe ───────────────────
    // A fileira sai dos mesmos dados do /car_washes.json (embutidos na página
    // pra primeira pintura). Sem localização a lista não tem ordem de
    // distância, então o título não promete "perto de você". O pedido de
    // permissão só sai no botão; quem já deu permissão (ou já tem posição
    // guardada pela home) vê ordenado direto, sem pedir de novo.
    var nearBtn = document.getElementById('lh-near-btn');
    var nearList = document.getElementById('lh-near-list');
    var COORDS_KEY = 'loov_last_coords';
    var lojas = [];
    try { lojas = JSON.parse((document.getElementById('lh-near-data') || {}).textContent || '[]'); } catch (e) { lojas = []; }
    function escH(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
    function fmtKm(km) { var n = parseFloat(km); if (isNaN(n)) return null; return n < 1 ? Math.round(n * 1000) + ' m' : n.toFixed(1).replace('.', ',') + ' km'; }
    function fmtPreco(v) { v = Number(v) || 0; return 'R$ ' + (v % 1 ? v.toFixed(2).replace('.', ',') : String(v)); }
    function fmtDur(min) { min = parseInt(min, 10); if (!min) return ''; if (min < 60) return min + ' min'; var h = Math.floor(min / 60), r = min % 60; return h + ' h' + (r ? ' ' + r : ''); }
    function fechaHoje(l) {
      var d = new Date().getDay(), oh = (l.operating_hours || []).filter(function (o) { return Number(o.day_of_week) === d; })[0];
      return oh && oh.closes_at ? oh.closes_at : null;
    }
    function porPreco(l) { return (l.services || []).slice().sort(function (a, b) { return (a.price || 0) - (b.price || 0); }); }
    function cardHtml(l, i) {
      var svcs = porPreco(l), menor = svcs[0], fecha = fechaHoje(l);
      var addr = l.dist ? l.dist + ' · ' + l.addr : l.addr;
      return '<button type="button" class="lh-card" role="listitem" data-i="' + i + '" aria-label="' + escH(l.name) + ', ' + (l.open_now ? 'aberto' : 'fechado') + '. Ver serviços">' +
        '<span class="lh-card-f"><span class="lh-card-top"><span class="lh-card-av" data-logo="' + escH(l.name) + '"></span>' +
          '<span class="lh-status ' + (l.open_now ? 'is-open' : 'is-closed') + '">' + (l.open_now ? 'ABERTO' : 'FECHADO') + '</span></span>' +
          '<span><span class="lh-card-name">' + escH(l.name) + '</span><span class="lh-card-addr">' + escH(addr) + '</span><span class="lh-card-hint">Ver serviços →</span></span></span>' +
        '<span class="lh-card-b" aria-hidden="true"><span><small>' + (l.open_now ? 'Aberto agora' + (fecha ? ' · fecha às ' + escH(fecha) : '') : 'Fechado agora') + '</small>' +
          (menor ? '<span class="lh-card-big">' + escH(fmtPreco(menor.price)) + '</span><small style="margin-top:8px">a partir de · ' + svcs.length + (svcs.length === 1 ? ' serviço' : ' serviços') + '</small>' : '<span class="lh-card-big">' + escH(l.name.split(' ')[0]) + '</span>') + '</span>' +
          '<span class="lh-card-row"><span class="lh-card-pill">Ver serviços</span></span></span>' +
      '</button>';
    }
    function marcar(p) {
      var n = Math.min(lojas.length, Math.max(1, Math.round(p * (lojas.length - 1)) + 1));
      var el = document.getElementById('lh-near-n'), bar = document.getElementById('lh-near-i');
      if (el) el.textContent = String(n).padStart(2, '0') + ' / ' + String(lojas.length).padStart(2, '0');
      if (bar) bar.style.transform = 'scaleX(' + (n / Math.max(1, lojas.length)).toFixed(3) + ')';
    }
    function pintarCards() {
      if (!nearList) return;
      nearList.innerHTML = lojas.map(cardHtml).join('');
      pintarLogos(nearList);
      nearList.querySelectorAll('.lh-card').forEach(function (c) {
        var ponto = function (e) { var r = c.getBoundingClientRect(); c.style.setProperty('--x', (e.clientX - r.left) + 'px'); c.style.setProperty('--y', (e.clientY - r.top) + 'px'); };
        c.addEventListener('pointerenter', ponto); c.addEventListener('pointerleave', ponto);
        c.addEventListener('click', function () { abrirPop(c, lojas[+c.dataset.i]); });
      });
      marcar(0);
      if (window.ScrollTrigger && root.classList.contains('lh-motion')) ScrollTrigger.refresh();
    }
    if (nearList) nearList.addEventListener('scroll', function () { marcar(this.scrollLeft / Math.max(1, this.scrollWidth - this.clientWidth)); }, { passive: true });

    // Detalhe: cresce do card (FLIP) e encolhe de volta pra ele ao fechar.
    var pop = document.getElementById('lh-pop'), popCard = document.getElementById('lh-pop-card'), popIn = document.getElementById('lh-pop-in'), origem = null;
    function abrirPop(el, l) {
      if (!pop) return;
      origem = el;
      var svcs = porPreco(l), mostra = svcs.slice(0, 6), fecha = fechaHoje(l);
      var nota = l.reviews_count > 0 && l.rating_avg ? '<span class="lh-status is-closed">★ ' + String(l.rating_avg).replace('.', ',') + ' · ' + l.reviews_count + (l.reviews_count === 1 ? ' avaliação' : ' avaliações') + '</span>' : '';
      popIn.innerHTML =
        '<div class="lh-pop-top"><span class="lh-card-av" data-logo="' + escH(l.name) + '"></span><span style="min-width:0"><b id="lh-pop-nome">' + escH(l.name) + '</b><span class="s">' + escH(l.dist ? l.dist + ' · ' + l.addr : l.addr) + '</span></span>' +
          '<button type="button" class="lh-pop-x" id="lh-pop-x" aria-label="Fechar"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg></button></div>' +
        '<div class="lh-pop-meta"><span class="lh-status ' + (l.open_now ? 'is-open' : 'is-closed') + '">' + (l.open_now ? 'ABERTO' + (fecha ? ' · ATÉ ' + escH(fecha) : '') : 'FECHADO AGORA') + '</span>' + nota + '</div>' +
        (mostra.length ? '<div><div class="lh-pop-lbl">Serviços</div><div class="lh-svcs">' + mostra.map(function (sv) {
          return '<div><span>' + escH(sv.title) + (sv.duration ? '<small>' + escH(fmtDur(sv.duration)) + '</small>' : '') + '</span><b>' + escH(fmtPreco(sv.price)) + '</b></div>';
        }).join('') + '</div>' + (svcs.length > mostra.length ? '<div class="lh-near-note" style="margin-top:10px">+ ' + (svcs.length - mostra.length) + ' SERVIÇOS NA PÁGINA DO LAVA-RÁPIDO</div>' : '') + '</div>' : '<div></div>') +
        '<a class="lh-btn lh-btn--primary" href="/car_washes/' + encodeURIComponent(l.id) + '">Ver horários e agendar</a>';
      pintarLogos(popIn);
      if (typeof vivos === 'function') vivos(popIn);
      document.getElementById('lh-pop-x').addEventListener('click', fecharPop);
      pop.classList.add('is-on'); pop.setAttribute('aria-hidden', 'false');
      document.documentElement.style.overflow = 'hidden'; if (lenis) lenis.stop();
      popCard.style.visibility = 'visible';
      var pronto = function () { pop.classList.add('is-ready'); document.getElementById('lh-pop-x').focus(); };
      if (!root.classList.contains('lh-motion')) return pronto();
      var de = el.getBoundingClientRect();
      gsap.set(popCard, { clearProps: 'x,y,scaleX,scaleY' });
      var para = popCard.getBoundingClientRect();
      gsap.fromTo(popCard, { x: de.left - para.left, y: de.top - para.top, scaleX: de.width / para.width, scaleY: de.height / para.height },
        { x: 0, y: 0, scaleX: 1, scaleY: 1, duration: .7, ease: 'expo.inOut', onComplete: function () { gsap.set(popCard, { clearProps: 'x,y,scaleX,scaleY' }); pronto(); } });
    }
    function fecharPop() {
      if (!pop || !pop.classList.contains('is-on')) return;
      pop.classList.remove('is-ready');
      var fim = function () { popCard.style.visibility = 'hidden'; pop.classList.remove('is-on'); pop.setAttribute('aria-hidden', 'true'); document.documentElement.style.overflow = ''; if (lenis) lenis.start(); if (window.gsap) gsap.set(popCard, { clearProps: 'x,y,scaleX,scaleY' }); if (origem) origem.focus(); };
      if (!root.classList.contains('lh-motion') || !origem) return fim();
      var para = popCard.getBoundingClientRect(), de = origem.getBoundingClientRect();
      gsap.to(popCard, { x: '+=' + (de.left - para.left), y: '+=' + (de.top - para.top), scaleX: de.width / para.width, scaleY: de.height / para.height, duration: .55, ease: 'expo.inOut', onComplete: fim });
    }
    if (pop) {
      document.getElementById('lh-pop-bg').addEventListener('click', fecharPop);
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') fecharPop(); });
    }

    function ordenarPerto(c) {
      return fetch('/car_washes.json?latitude=' + c.latitude + '&longitude=' + c.longitude, { headers: { Accept: 'application/json' } })
        .then(function (r) { if (!r.ok) throw new Error(); return r.json(); })
        .then(function (list) {
          if (!Array.isArray(list) || !list.length) throw new Error();
          var top = list.filter(function (cw) { return cw.distance_km != null; }).slice(0, 6);
          if (!top.length) throw new Error();
          lojas = top.map(function (cw) {
            var rua = [cw.logradouro, cw.numero].filter(Boolean).join(', ');
            return { id: cw.id, name: cw.name, addr: [rua, cw.bairro].filter(Boolean).join(' · ') || cw.address || '', dist: fmtKm(cw.distance_km),
              open_now: !!cw.open_now, rating_avg: cw.rating_avg, reviews_count: cw.reviews_count || 0, operating_hours: cw.operating_hours || [], services: cw.services || [] };
          });
          pintarCards();
          document.getElementById('lh-near-title').innerHTML = 'Perto de <span class="lh-dest">você.</span>';
          nearBtn.hidden = true;
          document.getElementById('lh-near-note').hidden = false;
        });
    }
    function guardar(c) { try { localStorage.setItem(COORDS_KEY, JSON.stringify({ lat: c.latitude, lng: c.longitude })); } catch (e) {} }
    function localizar() {
      if (!navigator.geolocation) return;
      nearBtn.disabled = true;
      nearBtn.querySelector('span').textContent = 'Localizando...';
      navigator.geolocation.getCurrentPosition(function (pos) {
        var c = { latitude: pos.coords.latitude, longitude: pos.coords.longitude };
        guardar(c);
        ordenarPerto(c).catch(restaurarBtn);
      }, restaurarBtn, { enableHighAccuracy: false, timeout: 10000, maximumAge: 300000 });
    }
    // Recusou ou falhou: a lista fica como está, sem mensagem de erro.
    function restaurarBtn() {
      nearBtn.disabled = false;
      nearBtn.querySelector('span').textContent = 'Ver os mais perto de mim';
    }
    if (nearBtn && nearList) {
      if (!navigator.geolocation) nearBtn.hidden = true;
      nearBtn.addEventListener('click', localizar);
      var guardada = null;
      try { var g = JSON.parse(localStorage.getItem(COORDS_KEY) || 'null'); if (g) guardada = { latitude: g.lat, longitude: g.lng }; } catch (e) {}
      if (guardada) {
        ordenarPerto(guardada).catch(function () {});
      } else if (navigator.permissions && navigator.permissions.query) {
        navigator.permissions.query({ name: 'geolocation' }).then(function (st) {
          if (st.state === 'granted') localizar();
        }).catch(function () {});
      }
    }

    // ── Movimento preso à rolagem ────────────────────────────────────────
    // Sem GSAP/Lenis (falhou o carregamento) ou com prefers-reduced-motion:
    // tudo à vista, sem animação.
    var root = document.querySelector('.lh');
    pintarCards();
    var motion = !reduce && window.gsap && window.ScrollTrigger && window.Lenis;
    var els = document.querySelectorAll('.lh-reveal, #lh-dash');
    function contar(el) {
      var alvo = parseInt(el.getAttribute('data-count'), 10), mil = el.hasAttribute('data-thousands');
      var fmt = function (n) { n = Math.round(n); return mil ? n.toLocaleString('pt-BR') : String(n); };
      if (!motion) { el.textContent = fmt(alvo); return; }
      var o = { v: 0 };
      gsap.to(o, { v: alvo, duration: 1.6, ease: 'power3.out', onUpdate: function () { el.textContent = fmt(o.v); } });
    }

    if (!motion) {
      els.forEach(function (el) { el.classList.add('is-in'); });
    } else {
      root.classList.add('lh-motion');
