  .cancel-modal-input:focus { border-color:var(--od-rose-500); }
  .cancel-modal-actions { display:flex; gap:.5rem; }
  .cancel-modal-back {
    flex:1; background:transparent; border:1px solid var(--od-stone); border-radius:10px;
