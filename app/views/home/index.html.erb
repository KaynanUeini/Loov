      <div class="owner-clock-wrap">
        <div class="owner-clock" id="owner-clock">00:00</div>
        <div class="owner-date" id="owner-date"></div>
      </div>
      <div class="owner-header-actions">
        <button class="hdr-btn" id="pending-hdr-btn" title="Pendências de dias anteriores" onclick="openPendingDrawer()" style="display:none;">
          <i class="fas fa-triangle-exclamation"></i>
          <span class="hdr-badge orange" id="pending-hdr-badge"></span>
        </button>
        <% if current_user.owner? %>
        <button class="hdr-btn" id="approval-hdr-btn" title="Aprovações pendentes" onclick="openApprovalDrawer()">
          <i class="fas fa-bell"></i>
          <span class="hdr-badge yellow" id="approval-hdr-badge"></span>
        </button>
        <% end %>
        <button class="hdr-walkin-btn" id="btn-message" onclick="openMsgModal()" style="background:transparent;border:1px solid var(--border);color:#ada699;margin-right:.25rem;" title="Enviar mensagem ao cliente"><i class="fas fa-paper-plane"></i></button>
        <% if current_user.owner? %>
        <button class="hdr-walkin-btn" id="btn-loyalty" onclick="openLoyaltyModal()" style="background:transparent;border:1px solid var(--border);color:#ada699;margin-right:.25rem;" title="Programa de fidelidade"><i class="fas fa-star"></i></button>
        <% end %>
        <button class="hdr-walkin-btn" id="btn-walk-in"><i class="fas fa-plus"></i> Avulso</button>
      </div>
    </div>

    <%# ── CHECKLIST DE ATIVAÇÃO ── %>
    <% if current_user.owner? && @checklist && !@checklist_done %>
    <div class="activation-banner">
      <div class="activation-banner-header">
        <div class="activation-banner-title">
          <i class="fas fa-rocket"></i>
          Configure seu negócio
          <div class="activation-progress-track">
            <div class="activation-progress-fill" style="width:<%= (@checklist_progress / 3.0 * 100).round %>%;"></div>
          </div>
          <span style="font-size:.58rem;color:rgba(221, 120, 82,.4);"><%= @checklist_progress %>/3</span>
        </div>
        <span style="font-size:.62rem;color:var(--text-muted);">Complete para liberar seu perfil aos clientes</span>
      </div>
      <div class="activation-steps">
        <% if @checklist[:hours] %>
          <div class="activation-step done">
            <div class="activation-step-icon"><i class="fas fa-check"></i></div>
            <div class="activation-step-text">
              <div class="activation-step-label">Horários cadastrados</div>
              <div class="activation-step-sub">Clientes já sabem quando você abre</div>
            </div>
            <i class="fas fa-check activation-step-arrow"></i>
          </div>
        <% else %>
          <%= link_to manage_car_wash_path(@car_wash, anchor: 'hours'), class: "activation-step" do %>
            <div class="activation-step-icon"><i class="fas fa-clock"></i></div>
            <div class="activation-step-text">
              <div class="activation-step-label">Cadastrar horários</div>
              <div class="activation-step-sub">Defina quando você funciona</div>
            </div>
            <i class="fas fa-arrow-right activation-step-arrow"></i>
          <% end %>
        <% end %>

        <% if @checklist[:service] %>
          <div class="activation-step done">
            <div class="activation-step-icon"><i class="fas fa-check"></i></div>
            <div class="activation-step-text">
              <div class="activation-step-label">Serviços cadastrados</div>
              <div class="activation-step-sub">Clientes já podem agendar</div>
            </div>
            <i class="fas fa-check activation-step-arrow"></i>
          </div>
        <% else %>
          <%= link_to manage_car_wash_path(@car_wash, anchor: 'services'), class: "activation-step" do %>
            <div class="activation-step-icon"><i class="fas fa-car-wash"></i></div>
            <div class="activation-step-text">
              <div class="activation-step-label">Cadastrar serviços</div>
              <div class="activation-step-sub">Adicione preços e durações</div>
            </div>
            <i class="fas fa-arrow-right activation-step-arrow"></i>
          <% end %>
        <% end %>

        <% if @checklist[:checkin] %>
          <div class="activation-step done">
            <div class="activation-step-icon"><i class="fas fa-check"></i></div>
            <div class="activation-step-text">
              <div class="activation-step-label">Primeiro atendimento</div>
              <div class="activation-step-sub">Negócio ativo e funcionando</div>
            </div>
            <i class="fas fa-check activation-step-arrow"></i>
          </div>
        <% else %>
          <div class="activation-step" style="cursor:default;">
            <div class="activation-step-icon"><i class="fas fa-flag-checkered"></i></div>
            <div class="activation-step-text">
              <div class="activation-step-label">Primeiro atendimento</div>
              <div class="activation-step-sub">Marque o comparecimento de um cliente</div>
            </div>
            <i class="fas fa-hourglass activation-step-arrow"></i>
          </div>
        <% end %>
      </div>
    </div>
    <% end %>

    <div class="kpi-grid">
      <div class="kpi-card">
        <div class="kpi-label">Caixa do dia</div>
        <div class="kpi-value lime" id="kpi-revenue">R$&nbsp;<%= number_with_precision(@today_revenue || 0, precision: 0, delimiter: '.') %></div>
        <div class="kpi-sub" id="kpi-revenue-sub">vs. média 7 dias</div>
      </div>
      <div class="kpi-card">
        <div class="kpi-label">Total</div>
        <div class="kpi-value" id="kpi-total"><%= @today_total || 0 %></div>
        <div class="kpi-sub">agendamentos hoje</div>
      </div>
      <div class="kpi-card">
        <div class="kpi-label">Aguardando</div>
        <div class="kpi-value yellow" id="kpi-pending"><%= @today_pending || 0 %></div>
        <div class="kpi-sub">confirmados hoje</div>
      </div>
      <div class="kpi-card">
        <div class="kpi-label">Vieram</div>
        <div class="kpi-value green" id="kpi-attended"><%= @today_attended || 0 %></div>
        <div class="kpi-sub">atendidos hoje</div>
      </div>
    </div>

    <div class="section-header">
      <span class="section-title">Agenda de Hoje</span>
      <span class="section-count" id="agenda-count">—</span>
    </div>
    <div class="appts-wrap">
      <div id="appts-list">
        <div class="appts-loading"><div class="loov-loader"><span></span><span></span><span></span></div> Carregando agenda...</div>
      </div>
      <div class="upcoming-bar">
        <span>Próximos 7 dias: <span class="upcoming-val"><%= @upcoming_count || 0 %> agend.</span></span>
        <% if current_user.owner? %>
        <%= link_to owner_car_wash_appointments_path, style: "font-size:.72rem;color:rgba(221, 120, 82,.5);text-decoration:none;" do %>Ver agenda completa <i class="fas fa-arrow-right" style="font-size:.6rem;"></i><% end %>
        <% end %>
      </div>
    </div>
  </main>
</div>

<%= render 'owner/disponivel_acceptance/widget' %>

<script>
(function() {
  const CSRF = document.querySelector('meta[name="csrf-token"]')?.content;
  let allServices = [];
  let unresolvedData = [];

  function updateClock() {
    const now = new Date();
    const hh = String(now.getHours()).padStart(2,'0');
    const mm = String(now.getMinutes()).padStart(2,'0');
    const dateStr = now.toLocaleDateString('pt-BR',{weekday:'long',day:'2-digit',month:'long'});
    document.getElementById('owner-clock').textContent = hh + ':' + mm;
    document.getElementById('owner-date').textContent  = dateStr;
    document.getElementById('sidebar-date-small').textContent = dateStr;
  }
  updateClock(); setInterval(updateClock, 1000);

  function showToast(msg, type='success') {
    const c=document.getElementById('toast-container'), t=document.createElement('div');
    t.className=`toast ${type}`;
    const icons={success:'fa-check',error:'fa-times',warning:'fa-triangle-exclamation'};
    t.innerHTML=`<i class="fas ${icons[type]||'fa-check'}"></i> ${msg}`;
    c.appendChild(t);
    setTimeout(()=>{t.classList.add('out');setTimeout(()=>t.remove(),320);},3500);
  }

  function animateCounter(el, target, isRev, dur=500) {
    if (!el) return;
    const st=performance.now();
    function ease(t){return 1-Math.pow(1-t,3);}
    function step(ct){const p=Math.min((ct-st)/dur,1),v=Math.round(ease(p)*target);el.textContent=isRev?'R$\u00A0'+v.toLocaleString('pt-BR'):v;if(p<1)requestAnimationFrame(step);}
    requestAnimationFrame(step);
  }

  async function patch(url, body={}) {
    const r=await fetch(url,{method:'PATCH',headers:{'X-CSRF-Token':CSRF,'Content-Type':'application/json'},body:JSON.stringify(body)});
    return r.json();
  }
  async function post(url, body={}) {
    const r=await fetch(url,{method:'POST',headers:{'X-CSRF-Token':CSRF,'Content-Type':'application/json'},body:JSON.stringify(body)});
    return r.json();
  }

  function showEditModal(a) {
    document.getElementById('edit-modal')?.remove();
    const modal=document.createElement('div');
    modal.id='edit-modal';
    modal.style.cssText='position:fixed;inset:0;z-index:100;display:flex;align-items:center;justify-content:center;background:rgba(40, 35, 28,0.9);backdrop-filter:blur(8px);padding:24px;';
    const opts=allServices.map(s=>`<option value="${s.id}" ${s.id===a.service_id?'selected':''}>${s.title} \u2014 R$ ${s.price.toFixed(0)}</option>`).join('');
    modal.innerHTML=`<div style="background:#fafaf6;border:1px solid #e0dbd0;border-radius:20px;padding:24px;width:100%;max-width:360px;font-family:'Inter',sans-serif;">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;"><span style="font-size:.65rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:#dd7852;">Editar Serviço</span><button id="edit-close" style="background:none;border:none;color:#ada699;font-size:1rem;cursor:pointer;"><i class="fas fa-xmark"></i></button></div>
      <div style="font-size:.75rem;color:#ada699;margin-bottom:16px;">${a.client} · ${a.time}</div>
      <label style="font-size:.6rem;color:#ada699;text-transform:uppercase;letter-spacing:.1em;display:block;margin-bottom:6px;">Serviço</label>
      <select id="edit-service" style="width:100%;background:#fafaf6;border:1px solid #e0dbd0;border-radius:8px;color:#28231c;padding:10px 12px;font-size:.82rem;margin-bottom:14px;outline:none;">${opts}</select>
      <label style="font-size:.6rem;color:#ada699;text-transform:uppercase;letter-spacing:.1em;display:block;margin-bottom:6px;">Valor (vazio = padrão)</label>
      <input id="edit-price" type="number" step="0.01" min="0" placeholder="R$ ${a.price.toFixed(2)}" value="${a.price_overridden?a.price.toFixed(2):''}" style="width:100%;background:#fafaf6;border:1px solid #e0dbd0;border-radius:8px;color:#28231c;padding:10px 12px;font-size:.82rem;margin-bottom:20px;outline:none;">
      <div style="display:flex;gap:8px;"><button id="edit-cancel" style="flex:1;background:transparent;border:1px solid #e0dbd0;border-radius:8px;color:#ada699;padding:10px;font-size:.8rem;cursor:pointer;">Cancelar</button><button id="edit-save" style="flex:2;background:#dd7852;border:none;border-radius:8px;color:#fafaf6;padding:10px;font-size:.8rem;font-weight:700;cursor:pointer;">Salvar</button></div>
    </div>`;
    document.body.appendChild(modal);
    modal.querySelector('#edit-close').addEventListener('click',()=>modal.remove());
    modal.querySelector('#edit-cancel').addEventListener('click',()=>modal.remove());
    modal.querySelector('#edit-save').addEventListener('click', async()=>{
      const btn=modal.querySelector('#edit-save'); btn.textContent='...'; btn.disabled=true;
      const data=await patch(`/owner/checkins/${a.id}/update_service`,{service_id:modal.querySelector('#edit-service').value,price_override:modal.querySelector('#edit-price').value.trim()||null});
      modal.remove(); if(data.ok) loadToday();
    });
  }

  function showWalkInModal() {
    document.getElementById('walkin-modal')?.remove();
    const modal=document.createElement('div');
    modal.id='walkin-modal';
    modal.style.cssText='position:fixed;inset:0;z-index:100;display:flex;align-items:center;justify-content:center;background:rgba(40, 35, 28,0.9);backdrop-filter:blur(8px);padding:24px;';
    const opts=allServices.map(s=>`<option value="${s.id}">${s.title} \u2014 R$ ${s.price.toFixed(0)}</option>`).join('');
    const nowTime=new Date().toTimeString().slice(0,5);
    modal.innerHTML=`<div style="background:#fafaf6;border:1px solid #e0dbd0;border-radius:20px;padding:24px;width:100%;max-width:360px;font-family:'Inter',sans-serif;">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;"><span style="font-size:.65rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:#dd7852;">+ Serviço Avulso</span><button id="wi-close" style="background:none;border:none;color:#ada699;font-size:1rem;cursor:pointer;"><i class="fas fa-xmark"></i></button></div>
      <label style="font-size:.6rem;color:#ada699;text-transform:uppercase;letter-spacing:.1em;display:block;margin-bottom:6px;">Cliente</label>
      <input id="wi-name" type="text" placeholder="Nome do cliente" style="width:100%;background:#fafaf6;border:1px solid #e0dbd0;border-radius:8px;color:#28231c;padding:10px 12px;font-size:.82rem;margin-bottom:12px;outline:none;">
      <label style="font-size:.6rem;color:#ada699;text-transform:uppercase;letter-spacing:.1em;display:block;margin-bottom:6px;">Horário</label>
      <input id="wi-time" type="time" value="${nowTime}" style="width:100%;background:#fafaf6;border:1px solid #e0dbd0;border-radius:8px;color:#28231c;padding:10px 12px;font-size:.82rem;margin-bottom:12px;outline:none;">
      <label style="font-size:.6rem;color:#ada699;text-transform:uppercase;letter-spacing:.1em;display:block;margin-bottom:6px;">Serviço</label>
      <select id="wi-service" style="width:100%;background:#fafaf6;border:1px solid #e0dbd0;border-radius:8px;color:#28231c;padding:10px 12px;font-size:.82rem;margin-bottom:12px;outline:none;">${opts}</select>
      <label style="font-size:.6rem;color:#ada699;text-transform:uppercase;letter-spacing:.1em;display:block;margin-bottom:6px;">Valor (opcional)</label>
      <input id="wi-price" type="number" step="0.01" min="0" placeholder="Usa o preço do serviço" style="width:100%;background:#fafaf6;border:1px solid #e0dbd0;border-radius:8px;color:#28231c;padding:10px 12px;font-size:.82rem;margin-bottom:18px;outline:none;">
      <div id="wi-error" style="color:#f87171;font-size:.7rem;margin-bottom:10px;display:none;"></div>
      <div style="display:flex;gap:8px;"><button id="wi-cancel" style="flex:1;background:transparent;border:1px solid #e0dbd0;border-radius:8px;color:#ada699;padding:10px;font-size:.8rem;cursor:pointer;">Cancelar</button><button id="wi-save" style="flex:2;background:#dd7852;border:none;border-radius:8px;color:#fafaf6;padding:10px;font-size:.8rem;font-weight:700;cursor:pointer;">Registrar</button></div>
    </div>`;
    document.body.appendChild(modal);
    modal.querySelector('#wi-close').addEventListener('click',()=>modal.remove());
    modal.querySelector('#wi-cancel').addEventListener('click',()=>modal.remove());
    modal.querySelector('#wi-save').addEventListener('click', async()=>{
      const name=modal.querySelector('#wi-name').value.trim(),errEl=modal.querySelector('#wi-error'),btn=modal.querySelector('#wi-save');
      if(!name){errEl.textContent='Informe o nome do cliente.';errEl.style.display='block';return;}
      errEl.style.display='none'; btn.textContent='...'; btn.disabled=true;
      const data=await post('/owner/checkins/walk_in',{walk_in_name:name,scheduled_at:modal.querySelector('#wi-time').value,service_id:modal.querySelector('#wi-service').value,price_override:modal.querySelector('#wi-price').value.trim()||null});
      if(data.ok){modal.remove();loadToday();}
      else{errEl.textContent=data.error||'Erro ao registrar.';errEl.style.display='block';btn.textContent='Registrar';btn.disabled=false;}
    });
  }

  function renderRow(a) {
    const settled = a.status==='attended' || a.status==='no_show';
    let metaHtml = '';
    if (a.phone_last4 || a.vehicle) {
      const parts = [];
      if (a.phone_last4) parts.push(`<span style="display:inline-flex;align-items:center;gap:.25rem;"><span style="font-size:.55rem;color:#e0dbd0;text-transform:uppercase;letter-spacing:.1em;font-weight:700;">código</span><span style="font-family:'Space Grotesk',sans-serif;font-size:1.1rem;color:#dd7852;letter-spacing:.08em;">${a.phone_last4}</span></span>`);
      if (a.vehicle) parts.push(`<span style="font-size:.65rem;color:#ada699;">${a.vehicle}</span>`);
      metaHtml = `<div style="display:flex;align-items:center;gap:.5rem;margin-top:3px;">${parts.join('')}</div>`;
    }

    // Loyalty dots — usa filled (posição no ciclo) e não o total de visitas
    let loyaltyHtml = '';
    if (a.loyalty && a.loyalty.goal > 0) {
      const { filled, goal, milestone, reward } = a.loyalty;
      const dots = Array.from({ length: goal }, (_, i) =>
        `<span class="loyalty-dot ${i < filled ? (milestone ? 'milestone' : 'filled') : ''}"></span>`
      ).join('');
      if (milestone) {
        loyaltyHtml = `<div class="loyalty-dots" style="display:flex;gap:3px;">${dots}</div><div class="loyalty-milestone-badge"><i class="fas fa-trophy" style="font-size:.5rem;"></i>${reward}</div>`;
      } else {
        loyaltyHtml = `<div class="loyalty-dots">${dots}</div><div class="loyalty-label">${filled}/${goal} visitas</div>`;
      }
    }
    const dispBadge = a.is_disponivel ? `<span class="disp-tag"><i class="fas fa-bolt"></i>Disp.</span>` : '';
    let priceHtml;
    if (a.is_disponivel && a.remaining_amount != null) {
      priceHtml = `<span class="appt-price" style="color:var(--lime);">R$${a.remaining_amount.toFixed(0)}</span>`;
    } else {
      priceHtml = `<span class="appt-price ${a.price_overridden?'overridden':''}">R$${a.price.toFixed(0)}</span>`;
    }
    const row = document.createElement('div');
    row.className = `appt-row status-${a.status}${a.status==='attended'?' is-attended':a.status==='no_show'?' is-no_show':''}`;
    row.dataset.id = a.id;
    row.innerHTML = `
      <div style="display:flex;flex-direction:column;align-items:center;flex-shrink:0;min-width:56px;gap:2px;">
        <span style="font-family:'Space Grotesk',sans-serif;font-size:1.75rem;color:var(--white);line-height:1;letter-spacing:.02em;">${a.time}</span>
        <span class="appt-dot ${a.status_color}"></span>
      </div>
      <div class="appt-info">
        <div class="appt-client">${a.client}${dispBadge}${a.walk_in?'<span class="appt-walkin-tag">avulso</span>':''}</div>
        <div class="appt-service">${a.service}</div>
        ${metaHtml}${loyaltyHtml}
      </div>
      ${priceHtml}
      <div class="appt-action-row">
        ${settled
          ? `<button class="btn-text-revert" data-action="revert"><i class="fas fa-rotate-left" style="font-size:.6rem;"></i> Desfazer</button>`
          : `<button class="btn-text-attend" data-action="attend"><i class="fas fa-check" style="font-size:.6rem;"></i> Atendido</button>
             <button class="btn-text-noshow" data-action="noshow"><i class="fas fa-xmark" style="font-size:.6rem;"></i> Ausente</button>
             <div class="appt-action-sep"></div>
             <button class="appt-btn edit-btn" data-action="edit" title="Editar serviço"><i class="fas fa-pen"></i></button>
             <button class="appt-btn cancel-btn" data-action="cancel" title="Cancelar agendamento"><i class="fas fa-ban"></i></button>`
        }
      </div>`;
    row.querySelectorAll('.appt-btn, .btn-text-attend, .btn-text-noshow, .btn-text-revert').forEach(btn=>{
      btn.addEventListener('click', async e=>{
        e.stopPropagation();
        if(btn.dataset.action==='cancel'){ openCancelApptModal(a, btn); return; }
        if(btn.dataset.action==='edit'){ showEditModal(a); return; }
        btn.disabled=true;
        const origHtml = btn.innerHTML;
        btn.innerHTML='<i class="fas fa-circle-notch spin"></i>';
        const urls={attend:`/owner/checkins/${a.id}/attend`,noshow:`/owner/checkins/${a.id}/no_show`,revert:`/owner/checkins/${a.id}/revert`};
        const data=await patch(urls[btn.dataset.action]);
        if(data.ok){
          if(btn.dataset.action==='attend') row.classList.add('flash-green');
          else if(btn.dataset.action==='noshow') row.classList.add('flash-red');
          setTimeout(()=>loadToday(),420);
        } else {
          btn.disabled=false; btn.innerHTML=origHtml;
        }
      });
    });
    return row;
  }

  function updateUnresolvedBadge(items) {
    const hdrBtn=document.getElementById('pending-hdr-btn'), navBtn=document.getElementById('pending-nav-btn');
    const hdrBadge=document.getElementById('pending-hdr-badge'), snavBadge=document.getElementById('snav-pending-badge');
    const drawerBadge=document.getElementById('pending-drawer-badge');
    unresolvedData = items;
    if (items.length > 0) {
      if(hdrBtn){hdrBtn.style.display='flex';hdrBtn.classList.add('has-unresolved');}
      if(hdrBadge){hdrBadge.textContent=items.length;hdrBadge.classList.add('visible');}
      if(navBtn)navBtn.style.display='flex';
      if(snavBadge){snavBadge.textContent=items.length;snavBadge.classList.add('visible');}
      if(drawerBadge)drawerBadge.textContent=items.length;
      if(hdrBtn&&!hdrBtn.dataset.notified){hdrBtn.dataset.notified='1';showToast(`${items.length} agendamento${items.length>1?'s':''} de dias anteriores sem fechamento.`,'warning');}
    } else {
      if(hdrBtn){hdrBtn.style.display='none';hdrBtn.classList.remove('has-unresolved');delete hdrBtn.dataset.notified;}
      if(hdrBadge)hdrBadge.classList.remove('visible');
      if(navBtn)navBtn.style.display='none';
      if(snavBadge)snavBadge.classList.remove('visible');
    }
  }

  function renderPendingDrawer(items) {
    const body=document.getElementById('pending-drawer-body');
    if(!items.length){body.innerHTML='<div class="drawer-empty"><i class="fas fa-check-circle" style="display:block;font-size:1.5rem;margin-bottom:8px;color:#e0dbd0;"></i>Nenhuma pendência.</div>';return;}
    const grouped={};
    items.forEach(a=>{const key=a.date||'Sem data';if(!grouped[key])grouped[key]=[];grouped[key].push(a);});
    body.innerHTML='';
    Object.keys(grouped).sort().forEach(dateKey=>{
      const group=document.createElement('div');group.className='pending-day-group';
      let label=dateKey;
      if(dateKey.match(/^\d{4}-\d{2}-\d{2}$/)){const[y,m,d]=dateKey.split('-');label=new Date(y,m-1,d).toLocaleDateString('pt-BR',{weekday:'long',day:'2-digit',month:'long'});}
      group.innerHTML=`<div class="pending-day-label">${label}</div>`;
      grouped[dateKey].forEach(a=>{
        const card=document.createElement('div');card.className='pending-appt-card';card.id=`pcard-${a.id}`;
        card.innerHTML=`<div class="pending-appt-time">${a.time}</div><div class="pending-appt-info"><div class="pending-appt-client">${a.client}</div><div class="pending-appt-service">${a.service}</div></div><div class="pending-appt-price">R$${parseFloat(a.price).toFixed(0)}</div><div class="pending-appt-actions"><button class="pending-btn-attend"><i class="fas fa-check"></i> Veio</button><button class="pending-btn-noshow"><i class="fas fa-xmark"></i> Faltou</button></div>`;
        card.querySelector('.pending-btn-attend').addEventListener('click',async function(){await resolvePending(a.id,'attend',this,card);});
        card.querySelector('.pending-btn-noshow').addEventListener('click',async function(){await resolvePending(a.id,'no_show',this,card);});
        group.appendChild(card);
      });
      body.appendChild(group);
    });
  }

  async function resolvePending(id, action, btn, card) {
    btn.disabled=true;btn.innerHTML='<i class="fas fa-circle-notch spin"></i>';
    const url=action==='attend'?`/owner/checkins/${id}/attend`:`/owner/checkins/${id}/no_show`;
    const data=await patch(url);
    if(data.ok){card.classList.add('removing');setTimeout(()=>{card.remove();showToast(action==='attend'?'Marcado como compareceu.':'Marcado como não veio.',action==='attend'?'success':'error');loadToday();},220);}
    else{btn.disabled=false;btn.innerHTML=action==='attend'?'<i class="fas fa-check"></i> Veio':'<i class="fas fa-xmark"></i> Faltou';showToast('Erro ao atualizar.','error');}
  }

  window.openPendingDrawer=function(){renderPendingDrawer(unresolvedData);document.getElementById('pending-drawer').classList.add('open');document.getElementById('pending-overlay').classList.add('open');document.body.style.overflow='hidden';};
  function closePendingDrawer(){document.getElementById('pending-drawer').classList.remove('open');document.getElementById('pending-overlay').classList.remove('open');document.body.style.overflow='';}

  let _firstLoad = true;
  async function loadToday() {
    try {
      const res=await fetch('/owner/checkins/today',{headers:{Accept:'application/json'}});
      const data=await res.json();
      const appts=data.appointments||[],summary=data.summary||{};
      allServices=data.services||[];
      if (_firstLoad) {
        animateCounter(document.getElementById('kpi-total'),    summary.total||0,    false);
        animateCounter(document.getElementById('kpi-pending'),  summary.pending||0,  false);
        animateCounter(document.getElementById('kpi-attended'), summary.attended||0, false);
        animateCounter(document.getElementById('kpi-revenue'),  summary.revenue_today||0, true, 600);
        _firstLoad = false;
      } else {
        const kTotal    = document.getElementById('kpi-total');
        const kPending  = document.getElementById('kpi-pending');
        const kAttended = document.getElementById('kpi-attended');
        const kRevenue  = document.getElementById('kpi-revenue');
        if(kTotal)    kTotal.textContent    = summary.total||0;
        if(kPending)  kPending.textContent  = summary.pending||0;
        if(kAttended) kAttended.textContent = summary.attended||0;
        if(kRevenue)  kRevenue.textContent  = 'R$ ' + (summary.revenue_today||0).toLocaleString('pt-BR');
      }
      const avg7=summary.avg_7_days||0,rev=summary.revenue_today||0;
      if(avg7>0){const diff=rev-avg7,sign=diff>=0?'+':'';document.getElementById('kpi-revenue-sub').textContent=`${sign}R$${Math.abs(diff).toFixed(0)} vs média 7 dias`;}
      document.getElementById('agenda-count').textContent=`${appts.length} agendamento${appts.length===1?'':'s'}`;
      const list=document.getElementById('appts-list');list.innerHTML='';
      if(!appts.length){const h=new Date().getHours();const sub=h<8?'O movimento começa mais tarde.':h<12?'A manhã ainda está tranquila.':h<18?'Sem agendamentos esta tarde.':'Fim de expediente tranquilo.';list.innerHTML=`<div class="appts-empty"><div class="appts-empty-icon"><i class="fas fa-calendar-xmark"></i></div><div class="appts-empty-title">Nenhum agendamento</div><div class="appts-empty-sub">${sub}</div></div>`;}
      else{appts.forEach(a=>list.appendChild(renderRow(a)));}
      updateUnresolvedBadge(data.unresolved_past||[]);
    } catch(e){console.error('loadToday error:',e);}
  }

  const costLabels={rent:'Aluguel',salaries:'Salários',utilities:'Energia/Água',products:'Produtos',maintenance:'Manutenção',other_fixed:'Outros fixos',other_variable:'Outros variáveis',notes:'Observações'};
  function formatPayload(ct,payload){if(!payload)return'<em style="color:#575148">Sem detalhes.</em>';if(ct==='monthly_costs'){const cp=payload.cost_params||{},month=payload.month?`${String(payload.month).padStart(2,'0')}/${payload.year}`:'';let rows=`<div style="font-size:.6rem;color:#fbbf24;margin-bottom:6px;font-weight:700;letter-spacing:.1em;">CUSTOS — ${month}</div>`;rows+=Object.entries(cp).map(([k,v])=>{if(v===''||v===null||v===undefined)return'';const label=costLabels[k]||k;const val=k==='notes'?`<span style="color:#ada699">${v||'—'}</span>`:`<span style="color:#ada699">R$ ${parseFloat(v).toLocaleString('pt-BR',{minimumFractionDigits:2})}</span>`;return`<div style="display:flex;justify-content:space-between;padding:3px 0;border-bottom:1px solid #fafaf6;"><span style="color:#575148">${label}</span>${val}</div>`;}).join('');return rows;}return`<pre style="font-size:.62rem;color:#ada699;white-space:pre-wrap;margin:0;">${JSON.stringify(payload,null,2)}</pre>`;}
  function toggleDetail(id){const el=document.getElementById(id),icon=document.getElementById('icon-'+id);if(!el)return;const open=el.style.display==='none';el.style.display=open?'block':'none';icon.className=open?'fas fa-minus':'fas fa-plus';}
  window.toggleDetail=toggleDetail;
  function removeCard(cardEl,cb){cardEl.classList.add('removing');setTimeout(cb,220);}

  async function loadApprovals(){
    const btn=document.getElementById('approval-hdr-btn');if(!btn)return;
    try{
      const res=await fetch('/owner/pending_changes',{headers:{Accept:'application/json'}});
      const data=await res.json();
      const hdrBadge=document.getElementById('approval-hdr-badge'),snavBadge=document.getElementById('snav-approval-badge'),navBtn=document.getElementById('approval-nav-btn');
      if(data.length>0){btn.classList.add('has-pending-approvals');hdrBadge.textContent=data.length;hdrBadge.classList.add('visible');if(snavBadge){snavBadge.textContent=data.length;snavBadge.classList.add('visible');}if(navBtn)navBtn.style.display='flex';}
      else{btn.classList.remove('has-pending-approvals');hdrBadge.classList.remove('visible');if(navBtn)navBtn.style.display='none';}
      renderApprovalDrawer(data);
    }catch(e){}
  }

  function renderApprovalDrawer(data){
    const body=document.getElementById('drawer-body'),badge=document.getElementById('drawer-badge');
    badge.textContent=data.length;
    if(!data.length){body.innerHTML='<div class="drawer-empty"><i class="fas fa-check-circle" style="display:block;font-size:1.5rem;margin-bottom:8px;color:#e0dbd0;"></i>Nenhuma alteração pendente.</div>';return;}
    body.innerHTML='';
    data.forEach(pc=>{const did=`detail-${pc.id}`,card=document.createElement('div');card.className='approval-card';card.id=`acard-${pc.id}`;card.innerHTML=`<div class="approval-card-header"><div class="approval-card-desc">${pc.description}</div><button class="approval-toggle" onclick="toggleDetail('${did}')"><i class="fas fa-plus" id="icon-${did}"></i></button></div><div class="approval-card-meta"><i class="fas fa-user" style="margin-right:4px;color:#e0dbd0;"></i>${pc.attendant} · ${pc.created_at}</div><div id="${did}" class="approval-detail">${formatPayload(pc.change_type,pc.payload)}</div><div class="approval-actions"><button class="btn-approve" onclick="approveChange(${pc.id},this)"><i class="fas fa-check"></i> Aprovar</button><button class="btn-reject" onclick="rejectChange(${pc.id},this)"><i class="fas fa-times"></i> Rejeitar</button></div>`;body.appendChild(card);});
  }

  window.approveChange=async function(id,btn){if(btn){btn.disabled=true;btn.innerHTML='<i class="fas fa-circle-notch spin"></i>';}try{await fetch(`/owner/pending_changes/${id}/approve`,{method:'PATCH',headers:{'X-CSRF-Token':CSRF,'Content-Type':'application/json'}});const card=document.getElementById(`acard-${id}`);if(card)removeCard(card,()=>loadApprovals());else loadApprovals();showToast('Alteração aprovada.','success');}catch(e){showToast('Erro ao aprovar.','error');if(btn){btn.disabled=false;btn.innerHTML='<i class="fas fa-check"></i> Aprovar';}}};
  window.rejectChange=async function(id,btn){if(btn){btn.disabled=true;btn.innerHTML='<i class="fas fa-circle-notch spin"></i>';}try{await fetch(`/owner/pending_changes/${id}/reject`,{method:'PATCH',headers:{'X-CSRF-Token':CSRF,'Content-Type':'application/json'}});const card=document.getElementById(`acard-${id}`);if(card)removeCard(card,()=>loadApprovals());else loadApprovals();showToast('Alteração rejeitada.','error');}catch(e){showToast('Erro ao rejeitar.','error');if(btn){btn.disabled=false;btn.innerHTML='<i class="fas fa-times"></i> Rejeitar';}}};

  window.openApprovalDrawer=function(){document.getElementById('approval-drawer').classList.add('open');document.getElementById('approval-overlay').classList.add('open');document.body.style.overflow='hidden';};
  function closeApprovalDrawer(){document.getElementById('approval-drawer').classList.remove('open');document.getElementById('approval-overlay').classList.remove('open');document.body.style.overflow='';}

  // Checklist dismiss
  window.dismissActivation = function() {
    const el = document.getElementById('activation-banner');
    if (el) { el.style.transition = 'opacity .3s,transform .3s'; el.style.opacity = '0'; el.style.transform = 'translateY(-8px)'; setTimeout(() => el.remove(), 320); }
    sessionStorage.setItem('loov_activation_dismissed', '1');
  };
  if (sessionStorage.getItem('loov_activation_dismissed')) {
    document.addEventListener('DOMContentLoaded', () => { document.getElementById('activation-banner')?.remove(); });
  }

  document.getElementById('pending-drawer-close')?.addEventListener('click',closePendingDrawer);
  document.getElementById('pending-overlay')?.addEventListener('click',closePendingDrawer);
  document.getElementById('drawer-close')?.addEventListener('click',closeApprovalDrawer);
  document.getElementById('approval-overlay')?.addEventListener('click',closeApprovalDrawer);

  // ── MENSAGEM AO CLIENTE ──────────────────────────────────────────────────
  let msgTarget = 'all';

  window.openMsgModal = function() {
    document.getElementById('msg-modal-overlay').classList.add('open');
    document.body.style.overflow = 'hidden';
    document.getElementById('msg-body').value = '';
    document.getElementById('msg-count').textContent = '0';
    document.getElementById('msg-error').style.display = 'none';
    setMsgTarget('all');
    loadMsgClients();
  };

  function closeMsgModal() {
    document.getElementById('msg-modal-overlay').classList.remove('open');
    document.body.style.overflow = '';
  }

  window.setMsgTarget = function(t) {
    msgTarget = t;
    document.getElementById('msg-target-all').classList.toggle('active', t === 'all');
    document.getElementById('msg-target-user').classList.toggle('active', t === 'user');
    document.getElementById('msg-client-wrap').style.display = t === 'user' ? 'block' : 'none';
    document.getElementById('msg-client-select').style.display = t === 'user' ? 'block' : 'none';
  };

  window.updateMsgCount = function() {
    const v = document.getElementById('msg-body').value.length;
    document.getElementById('msg-count').textContent = v;
  };

  async function loadMsgClients() {
    const sel = document.getElementById('msg-client-select');
    sel.innerHTML = '<option value="">Carregando...</option>';
    try {
      const res = await fetch('/owner/messages/clients_today', { headers: { Accept: 'application/json' } });
      const data = await res.json();
      if (!data.length) {
        sel.innerHTML = '<option value="">Nenhum cliente hoje</option>';
      } else {
        sel.innerHTML = data.map(c => `<option value="${c.id}">${c.name}</option>`).join('');
      }
    } catch(e) {
      sel.innerHTML = '<option value="">Erro ao carregar</option>';
    }
  }

  window.sendOwnerMessage = async function() {
    const body   = document.getElementById('msg-body').value.trim();
    const errEl  = document.getElementById('msg-error');
    const btn    = document.getElementById('msg-send-btn');
    const recip  = msgTarget === 'user' ? document.getElementById('msg-client-select').value : null;

    errEl.style.display = 'none';
    if (!body) { errEl.textContent = 'Escreva uma mensagem antes de enviar.'; errEl.style.display = 'block'; return; }
    if (msgTarget === 'user' && !recip) { errEl.textContent = 'Selecione um cliente.'; errEl.style.display = 'block'; return; }

    btn.disabled = true; btn.innerHTML = '<i class="fas fa-circle-notch spin"></i> Enviando...';

    try {
      const payload = { target: msgTarget, body };
      if (msgTarget === 'user') payload.recipient_id = recip;

      const res = await fetch('/owner/messages', {
        method: 'POST',
        headers: { 'X-CSRF-Token': CSRF, 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (data.ok) {
        closeMsgModal();
        showToast('Mensagem enviada!', 'success');
      } else {
        errEl.textContent = data.error || 'Erro ao enviar.';
        errEl.style.display = 'block';
      }
    } catch(e) {
      errEl.textContent = 'Erro de conexão.';
      errEl.style.display = 'block';
    }
    btn.disabled = false; btn.innerHTML = '<i class="fas fa-paper-plane"></i> Enviar mensagem';
  };


  // ── LOYALTY ────────────────────────────────────────────────────────────────
  window.openLoyaltyModal = function() {
    fetch('/owner/loyalty_program', { headers: { Accept: 'application/json' } })
      .then(r => r.json()).then(data => {
        if (data.exists) {
          document.getElementById('loyalty-active').checked  = data.active;
          document.getElementById('loyalty-visits').value    = data.visits_required;
          document.getElementById('loyalty-reward').value    = data.reward_description;
        }
        document.getElementById('loyalty-modal-overlay').classList.add('open');
        document.body.style.overflow = 'hidden';
      });
  };

  function closeLoyaltyModal() {
    document.getElementById('loyalty-modal-overlay').classList.remove('open');
    document.body.style.overflow = '';
  }

  window.saveLoyaltyProgram = async function() {
    const btn    = document.getElementById('loyalty-save-btn');
    const errEl  = document.getElementById('loyalty-error');
    const visits = parseInt(document.getElementById('loyalty-visits').value);
    const reward = document.getElementById('loyalty-reward').value.trim();
    const active = document.getElementById('loyalty-active').checked;

    errEl.style.display = 'none';
    if (!reward) { errEl.textContent = 'Descreva a recompensa.'; errEl.style.display = 'block'; return; }
    if (!visits || visits < 1) { errEl.textContent = 'Informe o número de visitas (mínimo 1).'; errEl.style.display = 'block'; return; }

    btn.disabled = true; btn.innerHTML = '<i class="fas fa-circle-notch spin"></i> Salvando...';
    try {
      const res = await fetch('/owner/loyalty_program', {
        method: 'POST',
        headers: { 'X-CSRF-Token': CSRF, 'Content-Type': 'application/json' },
        body: JSON.stringify({ visits_required: visits, reward_description: reward, active })
      });
      const data = await res.json();
      if (data.ok) { closeLoyaltyModal(); showToast('Programa de fidelidade salvo!', 'success'); loadToday(); }
      else { errEl.textContent = data.error || 'Erro ao salvar.'; errEl.style.display = 'block'; }
    } catch(e) { errEl.textContent = 'Erro de conexão.'; errEl.style.display = 'block'; }
    btn.disabled = false; btn.innerHTML = '<i class="fas fa-check"></i> Salvar configuração';
  };

  document.getElementById('loyalty-modal-close')?.addEventListener('click', closeLoyaltyModal);
  document.getElementById('loyalty-modal-overlay')?.addEventListener('click', e => { if (e.target.id === 'loyalty-modal-overlay') closeLoyaltyModal(); });

  document.getElementById('msg-modal-close')?.addEventListener('click', closeMsgModal);
  document.getElementById('msg-modal-overlay')?.addEventListener('click', e => { if (e.target.id === 'msg-modal-overlay') closeMsgModal(); });

  // ── MODAL CANCELAMENTO INDIVIDUAL ────────────────────────────────────────
  let _cancelApptId = null;

  window.openCancelApptModal = function(a, btn) {
    _cancelApptId = a.id;
    const time = a.time || '';
    const client = a.client || 'Cliente';
    const service = a.service || '';
    document.getElementById('cancel-appt-desc').textContent =
      `${client} · ${service} · ${time} — O cliente será notificado por e-mail e no app.`;
    document.getElementById('cancel-appt-reason').value = '';
    document.getElementById('cancel-appt-error').style.display = 'none';
    const confirmBtn = document.getElementById('cancel-appt-confirm');
    confirmBtn.disabled = false;
    confirmBtn.textContent = 'Confirmar cancelamento';
    document.getElementById('cancel-appt-overlay').classList.add('open');
    document.body.style.overflow = 'hidden';
    setTimeout(() => document.getElementById('cancel-appt-reason').focus(), 100);
  };

  window.closeCancelApptModal = function() {
    document.getElementById('cancel-appt-overlay').classList.remove('open');
    document.body.style.overflow = '';
    _cancelApptId = null;
  };

  document.getElementById('cancel-appt-overlay')?.addEventListener('click', function(e) {
    if (e.target === this) closeCancelApptModal();
  });

  document.getElementById('cancel-appt-confirm')?.addEventListener('click', async function() {
    if (!_cancelApptId) return;
    const reason = document.getElementById('cancel-appt-reason').value.trim();
    const errEl  = document.getElementById('cancel-appt-error');
    errEl.style.display = 'none';
    this.disabled = true;
    this.textContent = 'Cancelando...';
    try {
      const res  = await fetch(`/owner/checkins/${_cancelApptId}/cancel`, {
        method: 'PATCH',
        headers: { 'X-CSRF-Token': CSRF, 'Content-Type': 'application/json' },
        body: JSON.stringify({ reason })
      });
      const data = await res.json();
      if (data.ok) {
        closeCancelApptModal();
        showToast('Agendamento cancelado.', 'error');
        loadToday();
      } else {
        errEl.textContent = data.error || 'Erro ao cancelar.';
        errEl.style.display = 'block';
        this.disabled = false;
        this.textContent = 'Confirmar cancelamento';
      }
    } catch(e) {
      errEl.textContent = 'Erro de conexão.';
      errEl.style.display = 'block';
      this.disabled = false;
      this.textContent = 'Confirmar cancelamento';
    }
  });

  document.addEventListener('DOMContentLoaded',()=>{
    loadToday();loadApprovals();
    setInterval(loadToday,30000);setInterval(loadApprovals,60000);
    document.getElementById('btn-walk-in')?.addEventListener('click',showWalkInModal);
  });
})();
</script>

<% else %>

<% unless user_signed_in? %>

<%# ─── LANDING PUBLICA · DESIGN LOOV (cream/coral) ───────────────────── %>
<style>
  .loov-landing * { box-sizing: border-box; }

  .loov-landing {
    --cream:    #fafaf6;
    --paper:    #fefefd;
    --sand:     #f1eee6;
    --stone:    #e0dbd0;
    --ash:      #ada699;
    --graphite: #575148;
    --ink:      #28231c;

    --coral-50:  #fbeae3;
    --coral-100: #f5d3c3;
    --coral-300: #e8a48a;
    --coral-500: #dd7852;
    --coral-700: #9c4930;

    background: var(--cream);
    color: var(--ink);
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    -webkit-font-smoothing: antialiased;
    line-height: 1.5;
    min-height: 100vh;
    padding-top: 60px;
  }

  /* ── Hero ─────────────────────────────────────────────── */
  .loov-landing .hero {
    max-width: 980px;
    margin: 0 auto;
    padding: 80px 24px 56px;
    text-align: center;
    position: relative;
  }
  .loov-landing .hero .eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 2px;
    color: var(--coral-500);
    text-transform: uppercase;
    margin-bottom: 22px;
    padding: 6px 14px;
    background: var(--coral-50);
    border: 1px solid var(--coral-100);
    border-radius: 100px;
  }
  .loov-landing .hero .eyebrow .dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--coral-500);
    animation: hero-pulse 1.6s ease-in-out infinite;
  }
  @keyframes hero-pulse {
    0%,100% { opacity: 1; transform: scale(1); }
    50%     { opacity: .4; transform: scale(.7); }
  }
  .loov-landing .hero h1 {
    font-family: 'Space Grotesk', 'Inter', sans-serif;
    font-weight: 700;
    font-size: clamp(40px, 6vw, 68px);
    letter-spacing: -1.4px;
    line-height: 1.02;
    color: var(--ink);
    margin: 0 0 22px;
  }
  .loov-landing .hero h1 .accent {
    color: var(--coral-500);
    position: relative;
    white-space: nowrap;
  }
  .loov-landing .hero h1 .accent::after {
    content: '';
    position: absolute; left: 0; right: 0; bottom: -4px;
    height: 4px;
    background: linear-gradient(90deg, var(--coral-300), var(--coral-500));
    border-radius: 4px;
    opacity: .7;
  }
  .loov-landing .hero p.lead {
    font-size: 17px;
    color: var(--graphite);
    max-width: 600px;
    margin: 0 auto 38px;
  }

  .loov-landing .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }
  .loov-landing .btn-primary,
  .loov-landing .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 15px 28px;
    border-radius: 100px;
    text-decoration: none;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    letter-spacing: 1.4px;
    font-weight: 600;
    transition: transform .15s ease, box-shadow .15s ease, background .15s ease, border-color .15s ease, color .15s ease;
    cursor: pointer;
    border: none;
    text-transform: uppercase;
  }
  .loov-landing .btn-primary {
    background: var(--coral-500);
    color: var(--cream);
    box-shadow: 0 8px 20px rgba(220,120,82,0.25);
  }
  .loov-landing .btn-primary:hover {
    background: var(--coral-700);
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(156,73,48,0.3);
  }
  .loov-landing .btn-secondary {
    background: var(--paper);
    color: var(--ink);
    border: 1px solid var(--stone);
  }
  .loov-landing .btn-secondary:hover {
    border-color: var(--coral-500);
    color: var(--coral-700);
    transform: translateY(-2px);
  }

  /* ── Stats inline ─────────────────────────────────────── */
  .loov-landing .hero-stats {
    display: flex;
    justify-content: center;
    gap: 44px;
    margin-top: 56px;
    flex-wrap: wrap;
  }
  .loov-landing .hero-stat {
    text-align: center;
  }
  .loov-landing .hero-stat-value {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 28px;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.5px;
    margin-bottom: 4px;
  }
  .loov-landing .hero-stat-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 1.6px;
    color: var(--ash);
    text-transform: uppercase;
  }

  /* ── Features ─────────────────────────────────────────── */
  .loov-landing .features {
    max-width: 1100px;
    margin: 96px auto 0;
    padding: 0 24px;
  }
  .loov-landing .features-header {
    text-align: center;
    margin-bottom: 36px;
