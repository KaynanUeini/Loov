  <script>
  (function() {
    const tiles      = document.querySelectorAll('.cat-tile');
    const clearBtn   = document.getElementById('cat-clear');
    const pills      = document.querySelectorAll('.filter-pill');
    const grid       = document.getElementById('shops-grid');
    const emptyEl    = document.getElementById('shops-empty');
    const allShops   = grid ? Array.from(grid.querySelectorAll('.shop-row')) : [];
    let activeCat    = null;
    let activeFilter = 'todos';

    function applyFilters() {
      const visible = allShops.filter(card => {
        const cats   = (card.dataset.categories || '').toLowerCase();
        const open   = card.dataset.open === '1';
        if (activeCat && !cats.includes(activeCat)) return false;
        if (activeFilter === 'aberto agora' && !open) return false;
        return true;
      });

      // Ordenação por filtro
      let sorted = visible.slice();
      if (activeFilter === 'perto de mim') {
        sorted.sort((a, b) => parseFloat(a.dataset.distance) - parseFloat(b.dataset.distance));
      } else if (activeFilter === 'melhores avaliados') {
        sorted.sort((a, b) => parseFloat(b.dataset.rating) - parseFloat(a.dataset.rating));
      }

      // Re-render: hide all, then re-append visible em ordem
      allShops.forEach(c => { c.style.display = 'none'; });
      sorted.forEach(c => { c.style.display = ''; grid.appendChild(c); });

      if (emptyEl) {
        emptyEl.style.display = sorted.length === 0 ? '' : 'none';
        grid.appendChild(emptyEl);
      }
    }

    tiles.forEach(tile => {
      tile.addEventListener('click', function() {
        const key = this.dataset.cat;
        if (activeCat === key) {
          activeCat = null;
          this.classList.remove('active');
          this.querySelector('.cat-tile-check').style.display = 'none';
        } else {
          tiles.forEach(t => {
            t.classList.remove('active');
            t.querySelector('.cat-tile-check').style.display = 'none';
          });
          activeCat = key;
          this.classList.add('active');
          this.querySelector('.cat-tile-check').style.display = '';
        }
        if (clearBtn) clearBtn.style.display = activeCat ? 'inline-flex' : 'none';
        applyFilters();
      });
    });

    if (clearBtn) {
      clearBtn.addEventListener('click', function() {
        activeCat = null;
        tiles.forEach(t => {
          t.classList.remove('active');
          t.querySelector('.cat-tile-check').style.display = 'none';
        });
        clearBtn.style.display = 'none';
        applyFilters();
      });
    }

    pills.forEach(pill => {
      pill.addEventListener('click', function() {
        pills.forEach(p => p.classList.remove('active'));
        this.classList.add('active');
        activeFilter = this.dataset.filter;
        applyFilters();
      });
    });
  })();
  </script>

  <% end %>

