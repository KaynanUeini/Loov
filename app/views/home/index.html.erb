<% if user_signed_in? && (current_user.owner? || current_user.attendant?) %>

<style>
  /* ── OWNER DASHBOARD (web) — espelha OwnerDashboardScreen.js ───────── */
  * { box-sizing: border-box; margin: 0; padding: 0; }
  :root {
    --od-cream:#fafaf6; --od-paper:#fefefd; --od-sand:#f1eee6;
    --od-stone:#e0dbd0; --od-ash:#ada699; --od-graphite:#575148; --od-ink:#28231c;
    --od-coral-50:#fbeae3; --od-coral-100:#f5d3c3; --od-coral-500:#dd7852; --od-coral-700:#9c4930;
    --od-mint-500:#5dc39f; --od-pool-500:#4b8ec0; --od-amber-500:#d6b14a; --od-rose-500:#c85050;

    /* aliases legados que o resto da página owner ainda usa */
    --lime:#dd7852; --lime-dim:#9c4930;
    --black:#fafaf6; --surface:#fafaf6; --surface-2:#fafaf6; --surface-3:#fefefd;
    --border:#e0dbd0; --border-soft:#e0dbd0;
    --text-muted:#ada699; --white:#28231c;
    --orange:#f97316; --yellow:#fbbf24; --red:#f87171; --blue:#60a5fa;
  }
  body { background:var(--od-cream); font-family:'Inter',sans-serif; color:var(--od-ink); overflow-x:hidden; }

  /* ── Wrapper geral ── */
  .owner-wrap { display:flex; min-height:100vh; padding-top:60px; }

  /* ── Sidebar (mantém comportamento existente) ── */
  .owner-sidebar {
    width:220px; flex-shrink:0;
    background:var(--od-paper); border-right:1px solid var(--od-stone);
    position:fixed; top:60px; bottom:0; left:0;
    display:flex; flex-direction:column; padding:1.25rem 0; z-index:10;
  }
  .sidebar-brand { padding:0 1.25rem 1.25rem; border-bottom:1px solid var(--od-stone); margin-bottom:.75rem; }
  .sidebar-cw-name { font-family:'Space Grotesk',sans-serif; font-size:1.1rem; color:var(--od-ink); letter-spacing:-.02em; line-height:1.1; }
  .sidebar-cw-role { font-family:'JetBrains Mono',monospace; font-size:.58rem; letter-spacing:.16em; text-transform:uppercase; color:var(--od-ash); margin-top:4px; }

  .sidebar-nav { display:flex; flex-direction:column; gap:2px; padding:0 .75rem; flex:1; }
  .snav-item { display:flex; align-items:center; gap:.625rem; padding:.625rem .875rem; border-radius:10px; font-size:.8125rem; font-weight:500; color:var(--od-graphite); text-decoration:none; transition:all .15s; border:1px solid transparent; background:transparent; cursor:pointer; width:100%; text-align:left; }
  .snav-item:hover { color:var(--od-ink); background:var(--od-sand); }
  .snav-item i { width:16px; text-align:center; font-size:.75rem; }
  .snav-badge { margin-left:auto; border-radius:100px; padding:1px 6px; font-size:.52rem; font-weight:800; display:none; }
  .snav-badge.visible { display:inline-block; }
  .snav-badge.yellow { background:var(--od-amber-500); color:var(--od-cream); }
  .snav-badge.orange { background:var(--od-rose-500); color:var(--od-cream); }

  .sidebar-footer { padding:.75rem 1.25rem 0; border-top:1px solid var(--od-stone); margin-top:auto; }
  .sidebar-date-small { font-family:'JetBrains Mono',monospace; font-size:.62rem; color:var(--od-ash); text-transform:uppercase; letter-spacing:.1em; }

  .owner-content { margin-left:220px; flex:1; padding:2rem; max-width:760px; }

  /* ── Header (data + nome do shop + sino) ── */
  .owner-dash-topbar { display:flex; align-items:flex-start; gap:1rem; padding-top:.25rem; padding-bottom:1.5rem; }
  .owner-dash-topbar-left { flex:1; min-width:0; }
  .owner-dash-today {
    font-family:'JetBrains Mono',monospace; font-size:.65rem; letter-spacing:.18em;
    text-transform:uppercase; color:var(--od-ash);
  }
  .owner-dash-shopname {
    color:var(--od-ink); font-family:'Space Grotesk',sans-serif;
    font-size:1.65rem; line-height:1.1; letter-spacing:-.02em; margin-top:4px;
    white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
  }
  .owner-dash-bell {
    position:relative; width:40px; height:40px; border-radius:20px;
    background:var(--od-sand); border:none;
    display:flex; align-items:center; justify-content:center;
    color:var(--od-ink); cursor:pointer; flex-shrink:0; transition:background .15s;
  }
  .owner-dash-bell:hover { background:var(--od-stone); }
  .owner-dash-bell .od-dot {
    position:absolute; top:8px; right:8px;
    width:9px; height:9px; border-radius:5px;
    background:var(--od-coral-500); border:2px solid var(--od-cream);
    display:none;
  }
  .owner-dash-bell.has-pending .od-dot { display:block; }

  /* ── Hero card dark ink ── */
  .owner-dash-hero {
    background:var(--od-ink); border-radius:24px;
    padding:22px; margin-bottom:12px;
    display:flex; align-items:flex-start; gap:1rem;
  }
  .owner-dash-hero-left { flex:1; }
  .owner-dash-hero-right { text-align:right; }
  .owner-dash-eyebrow {
    font-family:'JetBrains Mono',monospace;
    color:#9e9688; font-size:.65rem; letter-spacing:.18em; text-transform:uppercase;
  }
  .owner-dash-revenue {
    color:var(--od-cream);
    font-family:'Space Grotesk',sans-serif;
    font-size:2.4rem; line-height:1.05; letter-spacing:-.04em; margin-top:6px;
    font-variant-numeric:tabular-nums;
  }
  .owner-dash-services-count {
    color:var(--od-cream);
    font-family:'Space Grotesk',sans-serif;
    font-size:1.65rem; margin-top:4px; letter-spacing:-.02em;
    font-variant-numeric:tabular-nums;
  }

  /* ── 3 KPI tiles ── */
  .owner-dash-kpis { display:grid; grid-template-columns:repeat(3,1fr); gap:.5rem; margin-bottom:1.5rem; }
  .owner-dash-kpi {
    background:var(--od-paper);
    border:1px solid var(--od-stone); border-radius:16px; padding:14px;
    display:flex; flex-direction:column; gap:.25rem;
  }
  .owner-dash-kpi.accent { background:var(--od-coral-50); border-color:var(--od-coral-100); }
  .owner-dash-kpi-value {
    color:var(--od-ink); font-family:'Space Grotesk',sans-serif;
    font-size:1.4rem; letter-spacing:-.02em; line-height:1;
    font-variant-numeric:tabular-nums;
  }
  .owner-dash-kpi.accent .owner-dash-kpi-value { color:var(--od-coral-700); }
  .owner-dash-kpi-label {
    font-family:'JetBrains Mono',monospace;
    color:var(--od-ash); font-size:.58rem; letter-spacing:.14em;
    text-transform:uppercase; margin-top:4px;
  }
  .owner-dash-kpi.accent .owner-dash-kpi-label { color:var(--od-coral-700); }

  /* ── Past pending banner ── */
  .owner-dash-past-banner {
    display:flex; align-items:center; gap:12px;
    padding:14px; border-radius:14px; margin-bottom:18px;
    background:rgba(200,80,80,.08);
    border:1.5px solid var(--od-rose-500);
    cursor:pointer; transition:background .15s;
    color:inherit; text-decoration:none;
  }
  .owner-dash-past-banner:hover { background:rgba(200,80,80,.12); }
  .owner-dash-past-banner.hidden { display:none; }
  .owner-dash-past-icon-wrap {
    position:relative; width:36px; height:36px; flex-shrink:0;
    display:flex; align-items:center; justify-content:center;
  }
  .owner-dash-past-icon-wrap::before {
    content:''; position:absolute; inset:2px;
    border-radius:18px; background:var(--od-rose-500);
    animation:owner-dash-pulse 1.4s ease-out infinite;
  }
  @keyframes owner-dash-pulse {
    0% { transform:scale(1); opacity:.55; }
    100% { transform:scale(1.6); opacity:0; }
  }
  .owner-dash-past-icon {
    position:relative; width:32px; height:32px; border-radius:10px;
    background:var(--od-rose-500); color:var(--od-cream);
    display:flex; align-items:center; justify-content:center; font-size:.85rem;
  }
  .owner-dash-past-text { flex:1; min-width:0; }
  .owner-dash-past-title {
    color:var(--od-ink); font-size:.85rem; font-weight:600; letter-spacing:-.005em;
    overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
  }
  .owner-dash-past-sub {
    color:var(--od-graphite); font-size:.72rem; line-height:1.3; margin-top:3px;
  }
  .owner-dash-past-banner i.fa-chevron-right { color:var(--od-rose-500); font-size:.8rem; }

  /* ── Section header ATENDIMENTOS ── */
  .owner-dash-section-head {
    display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;
  }
  .owner-dash-section-left { display:flex; align-items:center; gap:8px; }
  .owner-dash-pulse {
    width:8px; height:8px; border-radius:4px; background:var(--od-coral-500);
    animation:owner-dash-blink 1.2s ease-in-out infinite;
    display:none;
  }
  .owner-dash-pulse.visible { display:block; }
  @keyframes owner-dash-blink { 0%,100%{opacity:1} 50%{opacity:.3} }
  .owner-dash-section-title {
    color:var(--od-ink); font-family:'Space Grotesk',sans-serif;
    font-size:.95rem; font-weight:600; letter-spacing:-.01em;
  }
  .owner-dash-live-badge {
    display:none;
    background:var(--od-coral-500); color:var(--od-cream);
    border-radius:100px; padding:2px 8px; font-size:.7rem; font-weight:600;
    min-width:20px; text-align:center;
  }
  .owner-dash-live-badge.visible { display:inline-block; }
  .owner-dash-avulso-pill {
    display:inline-flex; align-items:center; gap:5px;
    padding:5px 10px; border-radius:100px;
    border:1px solid var(--od-coral-100); background:var(--od-coral-50);
    color:var(--od-coral-700); font-family:'JetBrains Mono',monospace;
    font-size:.62rem; font-weight:600; letter-spacing:.1em;
    cursor:pointer; transition:background .15s;
  }
  .owner-dash-avulso-pill:hover { background:var(--od-coral-100); }
  .owner-dash-avulso-pill i { font-size:.55rem; }

  /* ── Lista de atendimentos ── */
  .owner-dash-list { display:flex; flex-direction:column; gap:10px; margin-bottom:22px; }
  .owner-dash-empty {
    display:flex; align-items:center; gap:10px;
    padding:14px; margin-bottom:22px;
    background:var(--od-paper); border:1px dashed var(--od-stone);
    border-radius:14px; color:var(--od-graphite); font-size:.82rem;
  }
  .owner-dash-empty i { color:var(--od-ash); font-size:1rem; }

  .owner-dash-card {
    padding:14px; background:var(--od-paper);
    border:1px solid var(--od-stone); border-radius:18px;
  }
  .owner-dash-card.inactive { background:var(--od-sand); border-color:var(--od-stone); }
  .owner-dash-card-top { display:flex; align-items:center; gap:12px; }
  .owner-dash-time-bar { width:4px; height:38px; border-radius:2px; flex-shrink:0; }
  .owner-dash-time-bar.mint { background:var(--od-mint-500); }
  .owner-dash-time-bar.rose { background:var(--od-rose-500); }
  .owner-dash-time-block {
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    padding:7px 10px; min-width:60px;
    background:var(--od-sand); border-radius:12px;
    font-variant-numeric:tabular-nums;
  }
  .owner-dash-card.inactive .owner-dash-time-block { background:var(--od-stone); }
  .owner-dash-time-date {
    font-family:'JetBrains Mono',monospace;
    color:var(--od-graphite); font-size:.55rem; letter-spacing:.06em; margin-bottom:1px;
  }
  .owner-dash-time {
    color:var(--od-ink); font-family:'Space Grotesk',sans-serif;
    font-size:1.1rem; letter-spacing:-.02em;
  }
  .owner-dash-card-body { flex:1; min-width:0; }
  .owner-dash-card-row1 {
    display:flex; align-items:center; gap:6px; flex-wrap:wrap;
  }
  .owner-dash-client {
    color:var(--od-ink); font-size:.85rem; font-weight:600; letter-spacing:-.005em;
    flex-shrink:1; max-width:100%; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
  }
  .owner-dash-client-icon { color:var(--od-graphite); font-size:.75rem; }
  .owner-dash-tag-walkin {
    display:inline-block;
    background:var(--od-ink); color:var(--od-cream);
    padding:2px 7px; border-radius:6px;
    font-family:'JetBrains Mono',monospace;
    font-size:.55rem; letter-spacing:.12em; text-transform:uppercase;
  }
  .owner-dash-tag-lastmin {
    display:inline-flex; align-items:center; gap:3px;
    background:var(--od-coral-50); border:1px solid var(--od-coral-100);
    color:var(--od-coral-700);
    padding:2px 7px; border-radius:6px;
    font-family:'JetBrains Mono',monospace;
    font-size:.55rem; letter-spacing:.1em;
  }
  .owner-dash-tag-lastmin i { font-size:.5rem; }
  .owner-dash-tag-code {
    display:inline-flex; align-items:center; gap:3px;
    background:var(--od-coral-50); border:1px solid var(--od-coral-100);
    color:var(--od-coral-700);
    padding:2px 6px; border-radius:6px;
    font-family:'JetBrains Mono',monospace;
    font-size:.6rem; letter-spacing:.08em;
  }
  .owner-dash-tag-code i { font-size:.5rem; }
  .owner-dash-meta {
    color:var(--od-graphite); font-size:.72rem; margin-top:2px;
    overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
  }
  .owner-dash-meta-price { color:var(--od-ink); font-weight:600; }
  .owner-dash-card-right { display:flex; flex-direction:column; align-items:flex-end; flex-shrink:0; gap:2px; }
  .owner-dash-phase {
    font-family:'JetBrains Mono',monospace;
    font-size:.55rem; letter-spacing:.1em; text-transform:uppercase;
  }
  .owner-dash-phase.amber { color:var(--od-amber-500); }
  .owner-dash-phase.coral { color:var(--od-coral-500); }
  .owner-dash-phase.pool  { color:var(--od-pool-500); }
  .owner-dash-eta {
    color:var(--od-ink); font-family:'Space Grotesk',sans-serif;
    font-size:1rem; font-variant-numeric:tabular-nums;
  }
  .owner-dash-revert-pill {
    display:inline-flex; align-items:center; gap:5px;
    padding:7px 12px; border-radius:100px;
    background:var(--od-ink); color:var(--od-cream);
    font-family:'JetBrains Mono',monospace;
    font-size:.6rem; letter-spacing:.12em; text-transform:uppercase;
    border:none; cursor:pointer; transition:opacity .15s;
    box-shadow:0 2px 6px rgba(40,35,28,.15);
  }
  .owner-dash-revert-pill:disabled { opacity:.5; cursor:wait; }
  .owner-dash-revert-pill i { font-size:.55rem; }

  .owner-dash-progress {
    margin-top:12px; height:5px; border-radius:3px;
    background:var(--od-sand); overflow:hidden;
  }
  .owner-dash-progress-fill {
    height:100%; border-radius:3px;
    transition:width .5s ease;
  }

  .owner-dash-actions { display:flex; gap:8px; margin-top:14px; }
  .owner-dash-btn-ghost {
    flex:1; display:flex; align-items:center; justify-content:center; gap:6px;
    border-radius:10px; padding:10px;
    border:1.5px solid var(--od-stone); background:transparent;
    color:var(--od-graphite); font-size:.78rem; font-weight:600; cursor:pointer;
    transition:all .15s;
  }
  .owner-dash-btn-ghost:hover:not(:disabled) { border-color:var(--od-graphite); }
  .owner-dash-btn-ghost:disabled { opacity:.5; cursor:wait; }
  .owner-dash-btn-primary {
    flex:1.5; display:flex; align-items:center; justify-content:center; gap:6px;
    border-radius:10px; padding:10px;
    background:var(--od-coral-500); color:var(--od-cream);
    font-size:.78rem; font-weight:600; border:none; cursor:pointer;
    transition:background .15s;
  }
  .owner-dash-btn-primary:hover:not(:disabled) { background:var(--od-coral-700); }
  .owner-dash-btn-primary:disabled { opacity:.5; cursor:wait; }

  .owner-dash-secondary {
    display:flex; align-items:center; justify-content:center; gap:8px; margin-top:10px;
  }
  .owner-dash-link {
    display:inline-flex; align-items:center; gap:4px; padding:4px;
    background:none; border:none; cursor:pointer;
    color:var(--od-graphite); font-size:.7rem; font-weight:600;
    transition:opacity .15s;
  }
  .owner-dash-link:hover { opacity:.7; }
  .owner-dash-link.danger { color:var(--od-rose-500); }
  .owner-dash-link i { font-size:.6rem; }
  .owner-dash-link-sep { width:1px; height:12px; background:var(--od-stone); }

  /* ── Loyalty card ── */
  .owner-dash-section-eyebrow {
    font-family:'JetBrains Mono',monospace;
    color:var(--od-ash); font-size:.6rem; letter-spacing:.18em; text-transform:uppercase;
    margin-bottom:10px;
  }
  .owner-dash-loyalty {
    display:flex; align-items:center; gap:14px; padding:16px;
    background:var(--od-paper); border:1px solid var(--od-stone);
    border-radius:16px; cursor:pointer; transition:background .15s;
  }
  .owner-dash-loyalty:hover { background:var(--od-sand); }
  .owner-dash-loyalty-icon {
    width:40px; height:40px; border-radius:12px;
    background:var(--od-coral-50); color:var(--od-coral-700);
    display:flex; align-items:center; justify-content:center; font-size:.95rem;
    flex-shrink:0;
  }
  .owner-dash-loyalty-text { flex:1; min-width:0; }
  .owner-dash-loyalty-title { color:var(--od-ink); font-size:.85rem; font-weight:600; }
  .owner-dash-loyalty-desc { color:var(--od-graphite); font-size:.72rem; line-height:1.3; margin-top:2px; }
  .owner-dash-loyalty-badge {
    background:#d1ebd6; color:#2d6b42;
    padding:4px 10px; border-radius:100px;
    font-family:'JetBrains Mono',monospace;
    font-size:.55rem; font-weight:600; letter-spacing:.12em; flex-shrink:0;
  }

  /* ── Modais (bottom sheet) ── */
  .owner-dash-modal-overlay {
    position:fixed; inset:0; z-index:200;
    background:rgba(25,20,15,.5); backdrop-filter:blur(6px);
    display:none; align-items:flex-end; justify-content:center;
  }
  .owner-dash-modal-overlay.open { display:flex; }
  .owner-dash-sheet {
    background:var(--od-paper);
    border-top-left-radius:28px; border-top-right-radius:28px;
    padding:0 20px 30px;
    width:100%; max-width:520px;
    max-height:85vh; display:flex; flex-direction:column;
    animation:owner-dash-sheet-in .25s ease-out;
  }
  @keyframes owner-dash-sheet-in {
    from { transform:translateY(40px); opacity:0; }
    to   { transform:translateY(0);    opacity:1; }
  }
  .owner-dash-sheet-handle {
    align-self:center; width:40px; height:4px; border-radius:2px;
    background:var(--od-stone); margin:10px 0;
  }
  .owner-dash-sheet-header {
    display:flex; justify-content:space-between; align-items:center; padding:14px 0;
  }
  .owner-dash-sheet-title {
    color:var(--od-ink); font-family:'Space Grotesk',sans-serif;
    font-size:1.15rem; letter-spacing:-.01em;
  }
  .owner-dash-sheet-sub {
    color:var(--od-graphite); font-size:.78rem; margin-bottom:14px;
  }
  .owner-dash-sheet-close {
    background:none; border:none; cursor:pointer; padding:4px;
    color:var(--od-graphite); font-size:1.05rem;
  }
  .owner-dash-sheet-body { overflow-y:auto; flex:1; }

  .owner-dash-svc-row {
    display:flex; align-items:center; gap:10px;
    padding:14px; border-radius:14px; margin-bottom:8px;
    border:1px solid var(--od-stone);
    background:var(--od-cream); cursor:pointer; transition:all .15s;
  }
  .owner-dash-svc-row:hover { border-color:var(--od-graphite); }
  .owner-dash-svc-row.active { border-color:var(--od-coral-500); background:var(--od-coral-50); }
  .owner-dash-svc-row.disabled { opacity:.55; cursor:wait; }
  .owner-dash-svc-title { color:var(--od-ink); font-size:.85rem; font-weight:600; flex:1; }
  .owner-dash-svc-hint {
    font-family:'JetBrains Mono',monospace;
    color:var(--od-coral-700); font-size:.6rem; letter-spacing:.1em; margin-top:2px;
  }
  .owner-dash-svc-price {
    color:var(--od-ink); font-family:'Space Grotesk',sans-serif;
    font-size:.95rem; letter-spacing:-.01em; font-variant-numeric:tabular-nums;
  }

  .owner-dash-cancel-body {
    color:var(--od-graphite); font-size:.78rem; line-height:1.4;
    margin-top:-4px; margin-bottom:18px;
  }
  .owner-dash-btn-danger {
    width:100%; display:flex; align-items:center; justify-content:center; gap:8px;
    background:var(--od-rose-500); color:var(--od-cream);
    border:none; border-radius:14px;
    padding:14px;
    font-family:'JetBrains Mono',monospace;
    font-size:.78rem; font-weight:600; letter-spacing:.12em; cursor:pointer;
    margin-bottom:4px; transition:opacity .15s;
  }
  .owner-dash-btn-danger:disabled { opacity:.6; cursor:wait; }
  .owner-dash-btn-link {
    width:100%; padding:12px; text-align:center; cursor:pointer;
    background:none; border:none;
    color:var(--od-ash); font-size:.78rem;
  }
  .owner-dash-cancel-input {
    width:100%; background:var(--od-cream);
    border:1px solid var(--od-stone); border-radius:10px;
    color:var(--od-ink); font-family:'Inter',sans-serif; font-size:.85rem;
    padding:12px; outline:none; margin-bottom:14px;
    transition:border-color .15s;
  }
  .owner-dash-cancel-input:focus { border-color:var(--od-coral-500); }
  .owner-dash-cancel-input::placeholder { color:var(--od-ash); }
  .owner-dash-error {
    display:none; font-size:.72rem; color:var(--od-rose-500);
    background:rgba(200,80,80,.08); border:1px solid rgba(200,80,80,.2);
    padding:.5rem .75rem; border-radius:8px; margin-bottom:10px;
  }

  /* ── Walk-in modal extra fields ── */
  .owner-dash-field-label {
    font-family:'JetBrains Mono',monospace;
    font-size:.58rem; letter-spacing:.14em; text-transform:uppercase;
    color:var(--od-ash); display:block; margin-bottom:6px; margin-top:10px;
  }
  .owner-dash-field-input {
    width:100%; background:var(--od-cream);
    border:1px solid var(--od-stone); border-radius:10px;
    color:var(--od-ink); font-family:'Inter',sans-serif; font-size:.85rem;
    padding:11px 12px; outline:none;
    transition:border-color .15s;
  }
  .owner-dash-field-input:focus { border-color:var(--od-coral-500); }
  .owner-dash-field-select { appearance:none; background-image:none; }
  .owner-dash-btn-coral {
    width:100%; display:flex; align-items:center; justify-content:center; gap:8px;
    margin-top:18px; padding:14px;
    background:var(--od-coral-500); color:var(--od-cream);
    border:none; border-radius:14px; cursor:pointer;
    font-size:.85rem; font-weight:600; transition:background .15s;
  }
  .owner-dash-btn-coral:hover:not(:disabled) { background:var(--od-coral-700); }
  .owner-dash-btn-coral:disabled { opacity:.6; cursor:wait; }

  /* ── Toast (mantém visual existente) ── */
  .toast-container { position:fixed; bottom:28px; left:50%; transform:translateX(-50%); z-index:300; display:flex; flex-direction:column; align-items:center; gap:8px; pointer-events:none; }
  .toast { display:inline-flex; align-items:center; gap:8px; padding:10px 18px; border-radius:100px; font-family:'Inter',sans-serif; font-size:.78rem; font-weight:600; backdrop-filter:blur(16px); box-shadow:0 8px 24px rgba(40,35,28,.18); opacity:0; transform:translateY(12px); animation:toastIn .3s ease forwards; pointer-events:none; }
  .toast.success { background:rgba(221,120,82,.12); border:1px solid rgba(221,120,82,.3); color:var(--od-coral-700); }
  .toast.error   { background:rgba(200,80,80,.12); border:1px solid rgba(200,80,80,.3); color:var(--od-rose-500); }
  .toast.warning { background:rgba(214,177,74,.12); border:1px solid rgba(214,177,74,.3); color:var(--od-amber-500); }
  .toast.info    { background:rgba(75,142,192,.12); border:1px solid rgba(75,142,192,.3); color:var(--od-pool-500); }
  .toast.out { animation:toastOut .3s ease forwards; }
  @keyframes toastIn  { from{opacity:0;transform:translateY(12px)} to{opacity:1;transform:translateY(0)} }
  @keyframes toastOut { from{opacity:1;transform:translateY(0)} to{opacity:0;transform:translateY(-8px)} }
  @keyframes spin { to{transform:rotate(360deg)} }
  .spin { animation:spin .8s linear infinite; display:inline-block; }

  /* ── Activation banner (mantido) ── */
  .activation-banner { background:rgba(221,120,82,.04); border:1px solid rgba(221,120,82,.15); border-radius:16px; padding:1.25rem 1.5rem; margin-bottom:2rem; position:relative; overflow:hidden; }
  .activation-banner::before { content:''; position:absolute; top:0; left:0; right:0; height:1px; background:linear-gradient(to right,transparent,rgba(221,120,82,.4),transparent); }
  .activation-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:1rem; flex-wrap:wrap; gap:.5rem; }
  .activation-title { font-family:'JetBrains Mono',monospace; font-size:.62rem; font-weight:700; letter-spacing:.16em; text-transform:uppercase; color:var(--od-coral-700); display:flex; align-items:center; gap:.5rem; }
  .activation-progress-text { font-size:.7rem; color:var(--od-ash); }
  .activation-bar-wrap { height:3px; background:var(--od-stone); border-radius:99px; margin-bottom:1.25rem; overflow:hidden; }
  .activation-bar-fill { height:100%; background:var(--od-coral-500); border-radius:99px; transition:width .6s cubic-bezier(.16,1,.3,1); }
  .activation-steps { display:flex; flex-direction:column; gap:.625rem; }
  .activation-step { display:flex; align-items:center; gap:.875rem; padding:.75rem 1rem; border-radius:10px; background:var(--od-paper); border:1px solid var(--od-stone); transition:border-color .15s; }
  .activation-step.done { opacity:.5; }
  .activation-step:not(.done):hover { border-color:var(--od-coral-100); }
  .activation-step-icon { width:32px; height:32px; border-radius:8px; display:flex; align-items:center; justify-content:center; font-size:.75rem; flex-shrink:0; }
  .activation-step.done .activation-step-icon { background:var(--od-coral-50); color:var(--od-coral-700); }
  .activation-step:not(.done) .activation-step-icon { background:var(--od-sand); color:var(--od-graphite); }
  .activation-step-label { flex:1; font-size:.82rem; color:var(--od-ink); line-height:1.3; }
  .activation-step.done .activation-step-label { color:var(--od-graphite); text-decoration:line-through; }
  .activation-step-cta { background:var(--od-coral-500); color:var(--od-cream); border-radius:100px; padding:.4rem 1rem; font-size:.7rem; font-weight:700; text-decoration:none; white-space:nowrap; transition:background .15s; flex-shrink:0; }
  .activation-step-cta:hover { background:var(--od-coral-700); }
  .activation-dismiss { background:none; border:none; color:var(--od-ash); font-size:.7rem; cursor:pointer; padding:0; }
  .activation-dismiss:hover { color:var(--od-graphite); }

  /* ── Drawers existentes (aprovações + pendências) ── */
  .drawer-overlay { position:fixed; inset:0; z-index:50; background:rgba(40,35,28,.45); backdrop-filter:blur(6px); opacity:0; pointer-events:none; transition:opacity .25s ease; }
  .drawer-overlay.open { opacity:1; pointer-events:all; }
  .side-drawer { position:fixed; top:0; right:0; bottom:0; z-index:51; width:min(400px,94vw); background:var(--od-paper); display:flex; flex-direction:column; transform:translateX(100%); transition:transform .32s cubic-bezier(.32,.72,0,1); box-shadow:-20px 0 60px rgba(40,35,28,.18); }
  .side-drawer.open { transform:translateX(0); }
  .drawer-hdr { padding:20px; border-bottom:1px solid var(--od-stone); display:flex; align-items:center; justify-content:space-between; flex-shrink:0; }
  .drawer-title { font-family:'JetBrains Mono',monospace; font-size:.65rem; font-weight:700; letter-spacing:.16em; text-transform:uppercase; display:flex; align-items:center; gap:8px; color:var(--od-ink); }
  .drawer-title.yellow { color:var(--od-amber-500); border-left:2px solid var(--od-amber-500); padding-left:10px; }
  .drawer-title.orange { color:var(--od-rose-500); border-left:2px solid var(--od-rose-500); padding-left:10px; }
  .drawer-title-badge { border-radius:100px; font-size:.6rem; font-weight:700; padding:2px 7px; }
  .drawer-title.yellow .drawer-title-badge { background:var(--od-amber-500); color:var(--od-cream); }
  .drawer-title.orange .drawer-title-badge { background:var(--od-rose-500); color:var(--od-cream); }
  .drawer-close { background:none; border:1px solid var(--od-stone); border-radius:8px; width:30px; height:30px; display:flex; align-items:center; justify-content:center; cursor:pointer; color:var(--od-graphite); font-size:.75rem; transition:all .15s; }
  .drawer-close:hover { border-color:var(--od-rose-500); color:var(--od-rose-500); }
  .drawer-body { overflow-y:auto; flex:1; padding:12px; }
  .drawer-body::-webkit-scrollbar { width:4px; }
  .drawer-body::-webkit-scrollbar-thumb { background:var(--od-stone); border-radius:99px; }
  .drawer-empty { padding:32px 16px; text-align:center; color:var(--od-ash); font-size:.78rem; }

  .approval-card { background:var(--od-paper); border:1px solid var(--od-stone); border-radius:12px; padding:12px 14px; margin-bottom:8px; transition:opacity .2s,transform .2s; position:relative; overflow:hidden; }
  .approval-card::before { content:''; position:absolute; left:0; top:0; bottom:0; width:2px; background:var(--od-amber-500); opacity:.5; }
  .approval-card.removing { opacity:0; transform:translateX(16px); }
  .approval-card-header { display:flex; align-items:flex-start; justify-content:space-between; gap:8px; margin-bottom:6px; }
  .approval-card-desc { font-size:.8rem; color:var(--od-ink); line-height:1.4; flex:1; }
  .approval-card-meta { font-size:.66rem; color:var(--od-ash); margin-bottom:8px; }
  .approval-toggle { background:rgba(214,177,74,.12); border:1px solid rgba(214,177,74,.25); color:var(--od-amber-500); border-radius:6px; width:22px; height:22px; font-size:.6rem; cursor:pointer; flex-shrink:0; display:flex; align-items:center; justify-content:center; transition:background .15s; }
  .approval-toggle:hover { background:rgba(214,177,74,.2); }
  .approval-detail { display:none; background:var(--od-sand); border:1px solid var(--od-stone); border-radius:8px; padding:10px; margin-bottom:8px; font-size:.74rem; line-height:1.6; color:var(--od-graphite); }
  .approval-actions { display:flex; gap:6px; }
  .btn-approve { flex:1; background:rgba(221,120,82,.1); border:1px solid rgba(221,120,82,.25); color:var(--od-coral-700); border-radius:7px; font-size:.72rem; font-weight:700; cursor:pointer; padding:6px 0; transition:all .15s; }
  .btn-approve:hover { background:rgba(221,120,82,.18); }
  .btn-reject { flex:1; background:rgba(200,80,80,.08); border:1px solid rgba(200,80,80,.2); color:var(--od-rose-500); border-radius:7px; font-size:.72rem; font-weight:700; cursor:pointer; padding:6px 0; transition:all .15s; }
  .btn-reject:hover { background:rgba(200,80,80,.15); }

  /* ── Header buttons (sino + msg + loyalty) - estilos dos extras ── */
  .owner-dash-icon-btn {
    width:40px; height:40px; border-radius:20px;
    background:var(--od-sand); border:none;
    display:flex; align-items:center; justify-content:center;
    color:var(--od-ink); cursor:pointer; flex-shrink:0; transition:background .15s;
    position:relative;
  }
  .owner-dash-icon-btn:hover { background:var(--od-stone); }
  .owner-dash-icon-btn .od-mini-badge {
    position:absolute; top:-3px; right:-3px;
    min-width:16px; height:16px; padding:0 4px; border-radius:8px;
    background:var(--od-amber-500); color:var(--od-cream);
    font-size:.6rem; font-weight:700;
    display:none; align-items:center; justify-content:center;
    border:2px solid var(--od-cream);
  }
  .owner-dash-icon-btn .od-mini-badge.visible { display:flex; }

  /* ── Modais legados (mensagem / loyalty config) — estilos preservados ── */
  .msg-modal-overlay,
  .loyalty-modal-overlay,
  .cancel-modal-overlay {
    position:fixed; inset:0; z-index:200;
    background:rgba(25,20,15,.5); backdrop-filter:blur(6px);
    display:none; align-items:center; justify-content:center; padding:1rem;
  }
  .msg-modal-overlay.open,
  .loyalty-modal-overlay.open,
  .cancel-modal-overlay.open { display:flex; }
  .msg-modal,
  .loyalty-modal,
  .cancel-modal {
    background:var(--od-paper); border:1px solid var(--od-stone); border-radius:20px;
    width:100%; max-width:440px;
    display:flex; flex-direction:column; overflow:hidden;
  }
  .cancel-modal { max-width:400px; padding:1.5rem; }
  .msg-modal-hdr,
  .loyalty-modal-hdr {
    padding:1.125rem 1.25rem; border-bottom:1px solid var(--od-stone);
    display:flex; align-items:center; justify-content:space-between;
  }
  .msg-modal-title,
  .loyalty-modal-title {
    font-family:'JetBrains Mono',monospace; font-size:.65rem; font-weight:700;
    letter-spacing:.15em; text-transform:uppercase; color:var(--od-coral-500);
    display:flex; align-items:center; gap:.5rem;
  }
  .loyalty-modal-title { color:var(--od-amber-500); }
  .msg-modal-close {
    background:none; border:1px solid var(--od-stone); border-radius:8px;
    width:30px; height:30px; display:flex; align-items:center; justify-content:center;
    cursor:pointer; color:var(--od-graphite); font-size:.78rem; transition:all .15s;
  }
  .msg-modal-close:hover { border-color:var(--od-rose-500); color:var(--od-rose-500); }
  .msg-modal-body,
  .loyalty-modal-body { padding:1.25rem; display:flex; flex-direction:column; gap:.875rem; }
  .msg-field-label {
    font-family:'JetBrains Mono',monospace;
    font-size:.6rem; font-weight:700; letter-spacing:.14em;
    text-transform:uppercase; color:var(--od-ash); display:block; margin-bottom:.375rem;
  }
  .msg-target-row { display:flex; gap:.5rem; }
  .msg-target-btn {
    flex:1; padding:.625rem; border-radius:10px; border:1px solid var(--od-stone);
    background:transparent; color:var(--od-graphite); font-family:'Inter',sans-serif;
    font-size:.78rem; cursor:pointer; transition:all .15s; text-align:center;
  }
  .msg-target-btn.active {
    border-color:var(--od-coral-500); color:var(--od-coral-700);
    background:var(--od-coral-50);
  }
  .msg-select {
    width:100%; background:var(--od-cream); border:1px solid var(--od-stone); border-radius:10px;
    color:var(--od-ink); font-family:'Inter',sans-serif; font-size:.85rem;
    padding:.75rem 1rem; outline:none; cursor:pointer; display:none;
  }
  .msg-textarea {
    width:100%; background:var(--od-cream); border:1px solid var(--od-stone); border-radius:10px;
    color:var(--od-ink); font-family:'Inter',sans-serif; font-size:.85rem;
    padding:.75rem 1rem; outline:none; resize:none; height:100px;
    transition:border-color .2s;
  }
  .msg-textarea:focus { border-color:var(--od-coral-500); }
  .msg-textarea::placeholder { color:var(--od-ash); }
  .msg-char-count { font-size:.66rem; color:var(--od-ash); text-align:right; margin-top:-.5rem; }
  .msg-error {
    font-size:.72rem; color:var(--od-rose-500); padding:.5rem .75rem;
    background:rgba(200,80,80,.08); border:1px solid rgba(200,80,80,.2);
    border-radius:8px; display:none;
  }
  .msg-send-btn {
    width:100%; background:var(--od-coral-500); border:none; border-radius:12px;
    color:var(--od-cream); font-family:'Inter',sans-serif; font-size:.85rem;
    font-weight:700; padding:.85rem; cursor:pointer; transition:background .15s;
    display:flex; align-items:center; justify-content:center; gap:.4rem;
  }
  .msg-send-btn:hover { background:var(--od-coral-700); }
  .msg-send-btn:disabled { opacity:.5; cursor:not-allowed; }

  .loyalty-toggle-row {
    display:flex; align-items:center; justify-content:space-between;
    padding:.875rem 1rem; background:var(--od-sand);
    border:1px solid var(--od-stone); border-radius:12px;
  }
  .loyalty-toggle-label { font-size:.85rem; color:var(--od-ink); }
  .loyalty-toggle-sub { font-size:.7rem; color:var(--od-ash); margin-top:2px; }
  .toggle-switch { position:relative; width:40px; height:22px; cursor:pointer; }
  .toggle-switch input { opacity:0; width:0; height:0; }
  .toggle-slider {
    position:absolute; inset:0; background:var(--od-stone); border-radius:100px;
    border:1px solid var(--od-stone); transition:.3s;
  }
  .toggle-slider:before {
    content:''; position:absolute; width:16px; height:16px;
    border-radius:50%; background:var(--od-paper); bottom:2px; left:2px; transition:.3s;
  }
  .toggle-switch input:checked + .toggle-slider { background:var(--od-coral-50); border-color:var(--od-coral-100); }
  .toggle-switch input:checked + .toggle-slider:before { background:var(--od-coral-500); transform:translateX(18px); }
  .loyalty-save-btn {
    width:100%; background:var(--od-amber-500); border:none; border-radius:12px;
    color:var(--od-cream); font-family:'Inter',sans-serif; font-size:.85rem;
    font-weight:700; padding:.85rem; cursor:pointer; transition:background .15s;
  }
  .loyalty-save-btn:hover { background:#b8973d; }
  .cancel-modal-title {
    font-family:'JetBrains Mono',monospace; font-size:.62rem; font-weight:700;
    letter-spacing:.16em; text-transform:uppercase; color:var(--od-rose-500);
    display:flex; align-items:center; gap:.5rem; margin-bottom:.625rem;
  }
  .cancel-modal-desc { font-size:.82rem; color:var(--od-graphite); margin-bottom:1rem; line-height:1.5; }
  .cancel-modal-input {
    width:100%; background:var(--od-cream); border:1px solid var(--od-stone); border-radius:10px;
    color:var(--od-ink); font-family:'Inter',sans-serif; font-size:.85rem;
    padding:.75rem 1rem; outline:none; margin-bottom:1rem;
  }
  .cancel-modal-input:focus { border-color:var(--od-rose-500); }
  .cancel-modal-actions { display:flex; gap:.5rem; }
  .cancel-modal-back {
    flex:1; background:transparent; border:1px solid var(--od-stone); border-radius:10px;
    color:var(--od-graphite); font-family:'Inter',sans-serif; font-size:.82rem;
    padding:.625rem; cursor:pointer; transition:all .15s;
  }
  .cancel-modal-confirm {
    flex:2; background:var(--od-rose-500); border:none;
    border-radius:10px; color:var(--od-cream); font-family:'Inter',sans-serif;
    font-size:.82rem; font-weight:700; padding:.625rem; cursor:pointer; transition:opacity .15s;
  }
  .cancel-modal-confirm:disabled { opacity:.5; cursor:not-allowed; }

  /* ── Mobile ── */
  @media(max-width:900px) {
    .owner-sidebar { display:none; }
    .owner-content { margin-left:0; }
  }
  @media(max-width:500px) {
    .owner-content { padding:1rem; }
    .owner-dash-kpis { grid-template-columns:1fr; }
    .owner-dash-revenue { font-size:2rem; }
  }
</style>

<%# ── Drawers (aprovações + pendências legacy) ───────────────────────── %>
<div class="drawer-overlay" id="approval-overlay"></div>
<div class="side-drawer" id="approval-drawer">
  <div class="drawer-hdr">
    <div class="drawer-title yellow"><i class="fas fa-clock"></i>Aprovações pendentes<span class="drawer-title-badge" id="drawer-badge">0</span></div>
    <button class="drawer-close" id="drawer-close"><i class="fas fa-xmark"></i></button>
  </div>
  <div class="drawer-body" id="drawer-body">
    <div class="drawer-empty"><i class="fas fa-check-circle" style="display:block;font-size:1.5rem;margin-bottom:8px;color:var(--od-ash);"></i>Nenhuma alteração pendente.</div>
  </div>
</div>

<div class="toast-container" id="toast-container"></div>

<%# ── MODAL CANCELAMENTO INDIVIDUAL ── %>
<div class="cancel-modal-overlay" id="cancel-appt-overlay">
  <div class="cancel-modal">
    <div class="cancel-modal-title"><i class="fas fa-ban"></i>Cancelar agendamento</div>
    <div class="cancel-modal-desc" id="cancel-appt-desc">Carregando...</div>
    <input class="cancel-modal-input" id="cancel-appt-reason" placeholder="Motivo do cancelamento (opcional)" />
    <div id="cancel-appt-error" style="display:none;font-size:.72rem;color:var(--od-rose-500);margin-bottom:.75rem;"></div>
    <div class="cancel-modal-actions">
      <button class="cancel-modal-back" onclick="closeCancelApptModal()">Voltar</button>
      <button class="cancel-modal-confirm" id="cancel-appt-confirm">Confirmar cancelamento</button>
    </div>
  </div>
</div>

<%# ── MODAL LOYALTY (config do programa, owner only) ── %>
<% if current_user.owner? %>
<div class="loyalty-modal-overlay" id="loyalty-modal-overlay">
  <div class="loyalty-modal">
    <div class="loyalty-modal-hdr">
      <div class="loyalty-modal-title"><i class="fas fa-star"></i>Programa de Fidelidade</div>
      <button class="msg-modal-close" id="loyalty-modal-close"><i class="fas fa-xmark"></i></button>
    </div>
    <div class="loyalty-modal-body">
      <div class="loyalty-toggle-row">
        <div>
          <div class="loyalty-toggle-label">Ativar programa</div>
          <div class="loyalty-toggle-sub">Clientes acumulam visitas e ganham recompensas</div>
        </div>
        <label class="toggle-switch">
          <input type="checkbox" id="loyalty-active" checked>
          <span class="toggle-slider"></span>
        </label>
      </div>
      <div>
        <label class="msg-field-label">Visitas necessárias para a recompensa</label>
        <input type="number" id="loyalty-visits" min="1" max="50" value="5"
          class="owner-dash-field-input">
      </div>
      <div>
        <label class="msg-field-label">Descrição da recompensa</label>
        <input type="text" id="loyalty-reward" maxlength="120"
          placeholder="Ex: Lavagem simples grátis, 20% de desconto..."
          class="owner-dash-field-input">
        <div style="font-size:.66rem;color:var(--od-ash);margin-top:.375rem;">Isso aparece para o cliente ao atingir a meta</div>
      </div>
      <div id="loyalty-error" style="display:none;font-size:.72rem;color:var(--od-rose-500);padding:.5rem .75rem;background:rgba(200,80,80,.08);border:1px solid rgba(200,80,80,.2);border-radius:8px;"></div>
      <button class="loyalty-save-btn" id="loyalty-save-btn" onclick="saveLoyaltyProgram()">
        <i class="fas fa-check"></i> Salvar configuração
      </button>
    </div>
  </div>
</div>
<% end %>

<%# ── MODAL MENSAGEM AO CLIENTE ── %>
<div class="msg-modal-overlay" id="msg-modal-overlay">
  <div class="msg-modal">
    <div class="msg-modal-hdr">
      <div class="msg-modal-title"><i class="fas fa-paper-plane"></i>Enviar mensagem</div>
      <button class="msg-modal-close" id="msg-modal-close"><i class="fas fa-xmark"></i></button>
    </div>
    <div class="msg-modal-body">
      <div>
        <label class="msg-field-label">Destinatário</label>
        <div class="msg-target-row">
          <button class="msg-target-btn active" id="msg-target-all" onclick="setMsgTarget('all')">
            <i class="fas fa-users" style="margin-right:.3rem;"></i>Todos de hoje
          </button>
          <button class="msg-target-btn" id="msg-target-user" onclick="setMsgTarget('user')">
            <i class="fas fa-user" style="margin-right:.3rem;"></i>Cliente específico
          </button>
        </div>
      </div>
      <div id="msg-client-wrap">
