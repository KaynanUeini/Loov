<% if user_signed_in? && (current_user.owner? || current_user.attendant?) %>

<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  :root {
    --lime:#dd7852; --lime-dim:#9c4930;
    --black:#fafaf6; --surface:#fafaf6; --surface-2:#fafaf6; --surface-3:#fefefd;
    --border:#e0dbd0; --border-soft:#e0dbd0;
    --text-muted:#ada699; --white:#28231c;
    --orange:#f97316; --yellow:#fbbf24; --red:#f87171; --blue:#60a5fa;
  }
  body { background:var(--black); font-family:'Inter',sans-serif; color:var(--white); overflow-x:hidden; }

  .owner-wrap { display:flex; min-height:100vh; padding-top:60px; }

  .owner-sidebar {
    width:220px; flex-shrink:0;
    background:var(--surface-2); border-right:1px solid var(--border);
    position:fixed; top:60px; bottom:0; left:0;
    display:flex; flex-direction:column; padding:1.25rem 0; z-index:10;
  }
  .sidebar-brand { padding:0 1.25rem 1.25rem; border-bottom:1px solid var(--border); margin-bottom:.75rem; }
  .sidebar-cw-name { font-family:'Space Grotesk',sans-serif; font-size:1.1rem; color:var(--white); letter-spacing:.04em; line-height:1.1; }
  .sidebar-cw-role { font-size:.58rem; font-weight:700; letter-spacing:.16em; text-transform:uppercase; color:rgba(221, 120, 82,.35); margin-top:2px; }

  .sidebar-nav { display:flex; flex-direction:column; gap:2px; padding:0 .75rem; flex:1; }
  .snav-item { display:flex; align-items:center; gap:.625rem; padding:.625rem .875rem; border-radius:10px; font-size:.8125rem; font-weight:500; color:var(--text-muted); text-decoration:none; transition:all .15s; border:1px solid transparent; background:transparent; cursor:pointer; width:100%; text-align:left; }
  .snav-item:hover { color:var(--white); background:rgba(40, 35, 28,.03); }
  .snav-item i { width:16px; text-align:center; font-size:.75rem; }
  .snav-badge { margin-left:auto; border-radius:100px; padding:1px 6px; font-size:.52rem; font-weight:800; display:none; }
  .snav-badge.visible { display:inline-block; }
  .snav-badge.yellow { background:var(--yellow); color:#fafaf6; }
  .snav-badge.orange { background:var(--orange); color:#fafaf6; }

  .sidebar-footer { padding:.75rem 1.25rem 0; border-top:1px solid var(--border); margin-top:auto; }
  .sidebar-date-small { font-size:.62rem; color:var(--text-muted); text-transform:capitalize; }

  .owner-content { margin-left:220px; flex:1; padding:2rem; }

  .owner-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:2rem; gap:1rem; flex-wrap:wrap; }
  .owner-clock-wrap { display:flex; align-items:baseline; gap:.75rem; }
  .owner-clock { font-family:'Space Grotesk',sans-serif; font-size:3.5rem; line-height:1; letter-spacing:.04em; color:var(--white); }
  .owner-date { font-size:.75rem; color:var(--text-muted); text-transform:capitalize; }
  .owner-header-actions { display:flex; align-items:center; gap:.5rem; }

  .hdr-btn { position:relative; width:36px; height:36px; border-radius:10px; background:transparent; border:1px solid var(--border); display:flex; align-items:center; justify-content:center; color:var(--text-muted); font-size:.78rem; cursor:pointer; transition:all .2s; }
  .hdr-btn:hover { color:var(--white); border-color:var(--border-soft); background:rgba(40, 35, 28,.03); }
  .hdr-btn.has-pending-approvals { border-color:rgba(251,191,36,.3); color:#fbbf24; background:rgba(251,191,36,.04); }
  .hdr-btn.has-unresolved { border-color:rgba(249,115,22,.35); color:var(--orange); background:rgba(249,115,22,.05); animation:unresolvedPulse 2.5s ease-in-out infinite; }
  @keyframes unresolvedPulse { 0%,100%{box-shadow:0 0 0 0 rgba(249,115,22,0)} 50%{box-shadow:0 0 0 4px rgba(249,115,22,.12)} }
  .hdr-badge { position:absolute; top:-5px; right:-5px; font-family:'Inter',sans-serif; font-size:.48rem; font-weight:800; width:15px; height:15px; border-radius:50%; display:none; align-items:center; justify-content:center; border:2px solid #fafaf6; }
  .hdr-badge.visible { display:flex; }
  .hdr-badge.yellow { background:var(--yellow); color:#fafaf6; }
  .hdr-badge.orange { background:var(--orange); color:#fafaf6; }

  .hdr-walkin-btn { background:var(--lime); border:none; border-radius:10px; color:#fafaf6; height:36px; padding:0 1rem; font-family:'Inter',sans-serif; font-size:.78rem; font-weight:700; cursor:pointer; display:flex; align-items:center; gap:.4rem; transition:background .15s; }
  .hdr-walkin-btn:hover { background:var(--lime-dim); }

  .kpi-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:1rem; margin-bottom:2rem; }
  .kpi-card { background:var(--surface-2); border:1px solid var(--border); border-radius:16px; padding:1.25rem 1.5rem; position:relative; overflow:hidden; }
  .kpi-card::before { content:''; position:absolute; top:0; left:0; right:0; height:1px; background:linear-gradient(to right,transparent,rgba(221, 120, 82,.15),transparent); }
  .kpi-label { font-size:.6rem; font-weight:700; letter-spacing:.18em; text-transform:uppercase; color:var(--text-muted); margin-bottom:.5rem; }
  .kpi-value { font-family:'Space Grotesk',sans-serif; font-size:2.25rem; line-height:1; letter-spacing:.02em; color:var(--white); }
  .kpi-value.lime { color:var(--lime); }
  .kpi-value.yellow { color:var(--yellow); }
  .kpi-value.green { color:var(--lime); }
  .kpi-sub { font-size:.68rem; color:var(--text-muted); margin-top:.375rem; }

  .section-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:1rem; }
  .section-title { font-size:.75rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; color:var(--text-muted); }
  .section-count { font-size:.72rem; color:var(--text-muted); }

  .appts-wrap { background:var(--surface-2); border:1px solid var(--border); border-radius:16px; overflow:hidden; }
  .appts-loading { display:flex; align-items:center; justify-content:center; padding:3rem; gap:.75rem; color:var(--text-muted); font-size:.8125rem; }
  .loov-loader { display:inline-flex; align-items:center; gap:5px; }
  .loov-loader span { width:5px; height:5px; background:var(--lime); border-radius:50%; animation:loaderPulse 1.2s ease-in-out infinite; }
  .loov-loader span:nth-child(2){animation-delay:.2s;} .loov-loader span:nth-child(3){animation-delay:.4s;}
  @keyframes loaderPulse{0%,100%{opacity:.2;transform:scale(.8)}50%{opacity:1;transform:scale(1.2)}}

  .appt-row { display:flex; align-items:center; gap:12px; padding:.875rem 1.25rem; border-bottom:1px solid rgba(40, 35, 28,.03); transition:background .15s; position:relative; overflow:hidden; }
  .appt-row::before { content:''; position:absolute; left:0; top:6px; bottom:6px; width:2px; border-radius:99px; opacity:0; transition:opacity .2s; }
  .appt-row:hover { background:rgba(40, 35, 28,.02); }
  .appt-row:hover::before { opacity:1; }
  .appt-row.status-confirmed::before { background:var(--yellow); }
  .appt-row.status-attended::before  { background:var(--lime); }
  .appt-row.status-no_show::before   { background:var(--red); }
  .appt-row.is-attended { opacity:.45; }
  .appt-row.is-no_show  { opacity:.22; }
  .appt-row:last-child { border-bottom:none; }
  .appt-row.flash-green { background:rgba(221, 120, 82,.06)!important; }
  .appt-row.flash-red   { background:rgba(248,113,113,.06)!important; }

  .appt-info { flex:1; min-width:0; }
  .appt-client { font-size:.8125rem; font-weight:500; color:#ada699; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; display:flex; align-items:center; gap:5px; }
  .appt-service { font-size:.7rem; color:#e0dbd0; margin-top:1px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .appt-walkin-tag { font-size:.52rem; color:#ada699; background:#fafaf6; border:1px solid #e0dbd0; border-radius:4px; padding:1px 5px; flex-shrink:0; }
  .disp-tag { display:inline-flex; align-items:center; gap:.2rem; background:rgba(221, 120, 82,.1); border:1px solid rgba(221, 120, 82,.25); border-radius:100px; padding:.1rem .4rem; font-size:.52rem; font-weight:700; color:var(--lime); flex-shrink:0; }
  .appt-dot { width:4px; height:4px; border-radius:50%; flex-shrink:0; }
  .appt-dot.yellow{background:var(--yellow);} .appt-dot.green{background:var(--lime);} .appt-dot.red{background:var(--red);} .appt-dot.gray{background:#575148;}
  .appt-price { font-family:'Space Grotesk',sans-serif; font-size:1rem; color:#575148; flex-shrink:0; letter-spacing:.02em; }
  .appt-price.overridden { color:var(--yellow); }

  .appt-actions { display:flex; gap:3px; flex-shrink:0; }
  .appt-btn { width:28px; height:28px; border-radius:8px; border:1px solid rgba(40, 35, 28,.05); background:transparent; color:#e0dbd0; font-size:.65rem; display:flex; align-items:center; justify-content:center; cursor:pointer; transition:all .15s; flex-shrink:0; }
  .appt-btn:hover.attend-btn { background:rgba(221, 120, 82,.1); border-color:var(--lime); color:var(--lime); }
  .appt-btn:hover.noshow-btn { background:rgba(248,113,113,.1); border-color:var(--red); color:var(--red); }
  .appt-btn:hover.revert-btn { background:rgba(251,191,36,.1); border-color:var(--yellow); color:var(--yellow); }
  .appt-btn:hover.edit-btn   { background:rgba(40, 35, 28,.04); border-color:#e0dbd0; color:#ada699; }
  .appt-btn:hover.cancel-btn { background:rgba(248,113,113,.1); border-color:var(--red); color:var(--red); }

  /* ── BOTÕES DE AÇÃO TEXTO ── */
  .appt-action-row { display:flex; align-items:center; gap:5px; flex-shrink:0; }
  .appt-action-sep { width:1px; height:18px; background:#e0dbd0; flex-shrink:0; }
  .btn-text-attend {
    display:inline-flex; align-items:center; gap:4px;
    background:rgba(221, 120, 82,.08); border:1px solid rgba(221, 120, 82,.2);
    color:var(--lime); border-radius:100px; padding:4px 10px;
    font-family:'Inter',sans-serif; font-size:.7rem; font-weight:700;
    cursor:pointer; white-space:nowrap; transition:all .15s;
  }
  .btn-text-attend:hover { background:rgba(221, 120, 82,.15); border-color:var(--lime); }
  .btn-text-noshow {
    display:inline-flex; align-items:center; gap:4px;
    background:transparent; border:1px solid #e0dbd0;
    color:#ada699; border-radius:100px; padding:4px 10px;
    font-family:'Inter',sans-serif; font-size:.7rem; font-weight:500;
    cursor:pointer; white-space:nowrap; transition:all .15s;
  }
  .btn-text-noshow:hover { border-color:rgba(248,113,113,.3); color:var(--red); }
  .btn-text-revert {
    display:inline-flex; align-items:center; gap:4px;
    background:transparent; border:1px solid #e0dbd0;
    color:#ada699; border-radius:100px; padding:4px 10px;
    font-family:'Inter',sans-serif; font-size:.7rem; font-weight:500;
    cursor:pointer; white-space:nowrap; transition:all .15s;
  }
  .btn-text-revert:hover { border-color:rgba(251,191,36,.3); color:var(--yellow); }

  /* ── MODAL CANCELAMENTO ── */
  .cancel-modal-overlay {
    position:fixed; inset:0; z-index:200;
    background:rgba(40, 35, 28,.88); backdrop-filter:blur(8px);
    display:none; align-items:center; justify-content:center; padding:1rem;
  }
  .cancel-modal-overlay.open { display:flex; }
  .cancel-modal {
    background:#fafaf6; border:1px solid #e0dbd0; border-radius:20px;
    width:100%; max-width:400px; padding:1.5rem;
  }
  .cancel-modal-title {
    font-family:'Inter',sans-serif; font-size:.62rem; font-weight:700;
    letter-spacing:.15em; text-transform:uppercase; color:var(--red);
    display:flex; align-items:center; gap:.5rem; margin-bottom:.625rem;
  }
  .cancel-modal-desc { font-size:.8rem; color:#ada699; margin-bottom:1rem; line-height:1.5; }
  .cancel-modal-input {
    width:100%; background:#fafaf6; border:1px solid #e0dbd0; border-radius:8px;
    color:#28231c; font-family:'Inter',sans-serif; font-size:.8125rem;
    padding:.75rem 1rem; outline:none; margin-bottom:1rem;
    transition:border-color .2s;
  }
  .cancel-modal-input:focus { border-color:rgba(248,113,113,.3); }
  .cancel-modal-input::placeholder { color:#575148; }
  .cancel-modal-actions { display:flex; gap:.5rem; }
  .cancel-modal-back {
    flex:1; background:transparent; border:1px solid #e0dbd0; border-radius:8px;
    color:#ada699; font-family:'Inter',sans-serif; font-size:.8rem;
    padding:.625rem; cursor:pointer; transition:all .15s;
  }
  .cancel-modal-back:hover { border-color:#575148; color:#ada699; }
  .cancel-modal-confirm {
    flex:2; background:rgba(248,113,113,.08); border:1px solid rgba(248,113,113,.2);
    border-radius:8px; color:var(--red); font-family:'Inter',sans-serif;
    font-size:.8rem; font-weight:700; padding:.625rem; cursor:pointer; transition:all .15s;
  }
  .cancel-modal-confirm:hover { background:rgba(248,113,113,.15); border-color:var(--red); }
  .cancel-modal-confirm:disabled { opacity:.5; cursor:not-allowed; }

  .appts-empty { padding:3rem 1.25rem; text-align:center; }
  .appts-empty-icon { width:48px; height:48px; border-radius:14px; background:rgba(40, 35, 28,.02); border:1px solid var(--border); display:flex; align-items:center; justify-content:center; margin:0 auto .75rem; font-size:1.1rem; color:#e0dbd0; }
  .appts-empty-title { font-size:.72rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; color:#e0dbd0; margin-bottom:4px; }
  .appts-empty-sub { font-size:.7rem; color:#fefefd; }

  .upcoming-bar { display:flex; align-items:center; justify-content:space-between; padding:.875rem 1.25rem; border-top:1px solid var(--border); font-size:.72rem; color:var(--text-muted); }
  .upcoming-val { color:rgba(221, 120, 82,.7); font-weight:700; }

  .drawer-overlay { position:fixed; inset:0; z-index:50; background:rgba(40, 35, 28,.75); backdrop-filter:blur(8px); opacity:0; pointer-events:none; transition:opacity .25s ease; }
  .drawer-overlay.open { opacity:1; pointer-events:all; }
  .side-drawer { position:fixed; top:0; right:0; bottom:0; z-index:51; width:min(400px,94vw); background:rgba(3,3,3,0.98); display:flex; flex-direction:column; transform:translateX(100%); transition:transform .32s cubic-bezier(.32,.72,0,1); box-shadow:-20px 0 60px rgba(40, 35, 28,.7); }
  .side-drawer.open { transform:translateX(0); }
  .drawer-hdr { padding:20px; border-bottom:1px solid rgba(40, 35, 28,.04); display:flex; align-items:center; justify-content:space-between; flex-shrink:0; }
  .drawer-title { font-family:'Inter',sans-serif; font-size:.62rem; font-weight:700; letter-spacing:.18em; text-transform:uppercase; display:flex; align-items:center; gap:8px; }
  .drawer-title.yellow { color:var(--yellow); border-left:2px solid var(--yellow); padding-left:10px; }
  .drawer-title.orange { color:var(--orange); border-left:2px solid var(--orange); padding-left:10px; }
  .drawer-title-badge { border-radius:100px; font-size:.56rem; font-weight:800; padding:2px 7px; }
  .drawer-title.yellow .drawer-title-badge { background:var(--yellow); color:#fafaf6; }
  .drawer-title.orange .drawer-title-badge { background:var(--orange); color:#fafaf6; }
  .drawer-close { background:none; border:1px solid rgba(40, 35, 28,.06); border-radius:8px; width:30px; height:30px; display:flex; align-items:center; justify-content:center; cursor:pointer; color:#ada699; font-size:.75rem; transition:all .15s; }
  .drawer-close:hover { border-color:var(--red); color:var(--red); }
  .drawer-body { overflow-y:auto; flex:1; padding:12px; }
  .drawer-body::-webkit-scrollbar { width:2px; }
  .drawer-body::-webkit-scrollbar-thumb { background:#e0dbd0; border-radius:99px; }
  .drawer-empty { padding:32px 16px; text-align:center; color:#e0dbd0; font-size:.75rem; }

  .approval-card { background:rgba(40, 35, 28,.02); border:1px solid rgba(40, 35, 28,.05); border-radius:12px; padding:12px 14px; margin-bottom:8px; transition:opacity .2s,transform .2s; position:relative; overflow:hidden; }
  .approval-card::before { content:''; position:absolute; left:0; top:0; bottom:0; width:2px; background:var(--yellow); opacity:.5; }
  .approval-card.removing { opacity:0; transform:translateX(16px); }
  .approval-card-header { display:flex; align-items:flex-start; justify-content:space-between; gap:8px; margin-bottom:6px; }
  .approval-card-desc { font-size:.78rem; color:#ada699; line-height:1.4; flex:1; }
  .approval-card-meta { font-size:.62rem; color:#575148; margin-bottom:8px; }
  .approval-toggle { background:rgba(251,191,36,.08); border:1px solid rgba(251,191,36,.15); color:var(--yellow); border-radius:6px; width:22px; height:22px; font-size:.6rem; cursor:pointer; flex-shrink:0; display:flex; align-items:center; justify-content:center; transition:background .15s; }
  .approval-toggle:hover { background:rgba(251,191,36,.15); }
  .approval-detail { display:none; background:rgba(40, 35, 28,.5); border:1px solid rgba(40, 35, 28,.04); border-radius:8px; padding:10px; margin-bottom:8px; font-size:.7rem; line-height:1.6; }
  .approval-actions { display:flex; gap:6px; }
  .btn-approve { flex:1; background:rgba(221, 120, 82,.08); border:1px solid rgba(221, 120, 82,.2); color:var(--lime); border-radius:7px; font-size:.68rem; font-weight:700; cursor:pointer; padding:6px 0; transition:all .15s; }
  .btn-approve:hover { background:rgba(221, 120, 82,.14); border-color:var(--lime); }
  .btn-reject { flex:1; background:rgba(248,113,113,.06); border:1px solid rgba(248,113,113,.15); color:var(--red); border-radius:7px; font-size:.68rem; font-weight:700; cursor:pointer; padding:6px 0; transition:all .15s; }
  .btn-reject:hover { background:rgba(248,113,113,.12); border-color:var(--red); }

  .pending-day-group { margin-bottom:16px; }
  .pending-day-label { font-family:'Inter',sans-serif; font-size:.55rem; font-weight:700; letter-spacing:.18em; text-transform:uppercase; color:rgba(249,115,22,.5); padding:0 4px 6px; border-bottom:1px solid rgba(249,115,22,.08); margin-bottom:8px; }
  .pending-appt-card { display:flex; align-items:center; gap:10px; padding:10px 12px; border-radius:12px; margin-bottom:4px; border:1px solid rgba(249,115,22,.08); background:rgba(249,115,22,.02); position:relative; overflow:hidden; transition:opacity .2s,transform .2s; }
  .pending-appt-card::before { content:''; position:absolute; left:0; top:4px; bottom:4px; width:2px; background:var(--orange); border-radius:99px; opacity:.5; }
  .pending-appt-card.removing { opacity:0; transform:translateX(16px); }
  .pending-appt-time { font-family:'Space Grotesk',sans-serif; font-size:1.1rem; color:var(--orange); line-height:1; letter-spacing:.02em; flex-shrink:0; min-width:40px; text-align:center; }
  .pending-appt-info { flex:1; min-width:0; }
  .pending-appt-client { font-size:.8rem; font-weight:500; color:#ada699; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .pending-appt-service { font-size:.68rem; color:#575148; margin-top:1px; }
  .pending-appt-price { font-family:'Space Grotesk',sans-serif; font-size:.9rem; color:#ada699; flex-shrink:0; }
  .pending-appt-actions { display:flex; gap:4px; flex-shrink:0; }
  .pending-btn-attend { background:rgba(221, 120, 82,.08); border:1px solid rgba(221, 120, 82,.2); color:var(--lime); border-radius:7px; font-size:.62rem; font-weight:700; cursor:pointer; padding:5px 8px; transition:all .15s; white-space:nowrap; }
  .pending-btn-attend:hover { background:rgba(221, 120, 82,.15); border-color:var(--lime); }
  .pending-btn-noshow { background:rgba(248,113,113,.06); border:1px solid rgba(248,113,113,.15); color:var(--red); border-radius:7px; font-size:.62rem; font-weight:700; cursor:pointer; padding:5px 8px; transition:all .15s; white-space:nowrap; }
  .pending-btn-noshow:hover { background:rgba(248,113,113,.12); border-color:var(--red); }

  .toast-container { position:fixed; bottom:28px; left:50%; transform:translateX(-50%); z-index:300; display:flex; flex-direction:column; align-items:center; gap:8px; pointer-events:none; }
  .toast { display:inline-flex; align-items:center; gap:8px; padding:10px 18px; border-radius:100px; font-family:'Inter',sans-serif; font-size:.7rem; font-weight:600; backdrop-filter:blur(16px); box-shadow:0 8px 24px rgba(40, 35, 28,.5); opacity:0; transform:translateY(12px); animation:toastIn .3s ease forwards; pointer-events:none; }
  .toast.success { background:rgba(221, 120, 82,.12); border:1px solid rgba(221, 120, 82,.3); color:var(--lime); }
  .toast.error   { background:rgba(248,113,113,.12); border:1px solid rgba(248,113,113,.3); color:var(--red); }
  .toast.warning { background:rgba(249,115,22,.12); border:1px solid rgba(249,115,22,.3); color:var(--orange); }
  .toast.out { animation:toastOut .3s ease forwards; }
  @keyframes toastIn  { from{opacity:0;transform:translateY(12px)} to{opacity:1;transform:translateY(0)} }
  @keyframes toastOut { from{opacity:1;transform:translateY(0)} to{opacity:0;transform:translateY(-8px)} }
  @keyframes spin { to{transform:rotate(360deg)} }
  .spin { animation:spin .8s linear infinite; display:inline-block; }


  /* ── CHECKLIST DE ATIVAÇÃO ── */
  .activation-banner {
    background: linear-gradient(135deg, rgba(221, 120, 82,.04), rgba(221, 120, 82,.02));
    border: 1px solid rgba(221, 120, 82,.15);
    border-radius: 16px;
    padding: 1.25rem 1.5rem;
    margin-bottom: 2rem;
    position: relative;
    overflow: hidden;
  }
  .activation-banner::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(221, 120, 82,.4), transparent);
  }
