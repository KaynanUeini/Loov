  #page-transition{position:fixed;inset:0;z-index:10000;background:#fafaf6;transform:translateY(100%);pointer-events:none;}
  #page-transition.enter{animation:pgEnter .42s cubic-bezier(.76,0,.24,1) forwards;}
  #page-transition.exit{animation:pgExit .42s cubic-bezier(.76,0,.24,1) forwards;}
  @keyframes pgEnter{from{transform:translateY(100%)}to{transform:translateY(0)}}
  @keyframes pgExit{from{transform:translateY(0)}to{transform:translateY(-100%)}}
  *{box-sizing:border-box;}body{cursor:none;background:var(--black);font-family:'Inter',sans-serif;}
  .home-wrap{min-height:100vh;background:var(--black);padding-top:60px;}
  .home-top{max-width:1200px;margin:0 auto;padding:2rem 1.5rem 0;}
  .home-tagline{font-family:'Space Grotesk',sans-serif;font-size:clamp(2.1rem,4.8vw,3rem);letter-spacing:.02em;color:var(--white);line-height:1;margin-bottom:1.25rem;opacity:0;animation:fadeUp .7s cubic-bezier(.16,1,.3,1) forwards .05s;}
  .home-tagline span{color:var(--lime);}
  .home-search-row{display:flex;align-items:center;gap:.75rem;margin-bottom:2rem;opacity:0;animation:fadeUp .7s cubic-bezier(.16,1,.3,1) forwards .15s;}
  .home-search-field{flex:1;position:relative;}
  .home-search-icon{position:absolute;left:1.125rem;top:50%;transform:translateY(-50%);color:var(--text-muted);font-size:.875rem;pointer-events:none;}
  .home-search-input{width:100%;background:var(--surface-3);border:1px solid var(--border);border-radius:100px;padding:.875rem .875rem .875rem 2.75rem;font-family:'Inter',sans-serif;font-size:.9375rem;color:var(--white);outline:none;transition:border-color .2s;cursor:none;}
  .home-search-input::placeholder{color:rgba(40, 35, 28,.2);}
  .home-search-input:focus{border-color:var(--lime);}
  .home-search-btn{position:absolute;right:.375rem;top:50%;transform:translateY(-50%);background:var(--lime);color:#fafaf6;border:none;border-radius:100px;width:38px;height:38px;display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:.8rem;transition:background .2s;}
  .home-search-btn:hover{background:var(--lime-dim);}
  .home-location-btn{display:inline-flex;align-items:center;gap:.45rem;background:var(--surface-3);border:1px solid var(--border);border-radius:100px;padding:.875rem 1.125rem;font-family:'Inter',sans-serif;font-size:.8rem;font-weight:500;color:var(--text-secondary);white-space:nowrap;cursor:pointer;transition:all .2s;flex-shrink:0;}
  .home-location-btn:hover{border-color:rgba(221, 120, 82,.3);color:var(--lime);}
  .home-location-btn i{color:var(--lime);font-size:.72rem;}
  .home-location-text{max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
  .home-section{max-width:1200px;margin:0 auto;padding:1.75rem 1.5rem 0;}
  .home-section-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem;}
  .home-section-title{font-size:1.0625rem;font-weight:700;color:var(--white);}
  .home-section-link{font-size:.8rem;font-weight:600;color:var(--lime);text-decoration:none;}
  .home-section-link:hover{opacity:.75;}
  .h-scroll{display:flex;gap:1.25rem;overflow-x:auto;padding-bottom:.625rem;scrollbar-width:none;}
  .h-scroll::-webkit-scrollbar{display:none;}
  .disp-card{flex-shrink:0;width:280px;background:#fefefd;border-radius:16px;padding:1.5rem;position:relative;overflow:hidden;transition:background .2s;cursor:none;border:1px solid rgba(40, 35, 28,.05);}
  .disp-card:hover{background:#fefefd;border-color:rgba(221, 120, 82,.15);}
  .disp-card-header{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:.5rem;}
  .disp-card-time{font-family:'Space Grotesk',sans-serif;font-size:4rem;color:var(--lime);line-height:.85;letter-spacing:.02em;}
  .disp-card-badge{display:inline-flex;align-items:center;gap:.3rem;background:rgba(40, 35, 28,.6);border:1px solid rgba(221, 120, 82,.2);border-radius:100px;padding:.2rem .625rem;font-size:.58rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;flex-shrink:0;margin-top:.25rem;}
  .disp-badge-dot{width:6px;height:6px;border-radius:50%;background:var(--lime);animation:bdPulse 1.2s ease-in-out infinite;}
  @keyframes bdPulse{0%,100%{opacity:1}50%{opacity:.3}}
  .disp-card-name{font-family:'Space Grotesk',sans-serif;font-size:1.5rem;color:var(--white);line-height:1;margin-bottom:.25rem;transition:color .2s;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .disp-card:hover .disp-card-name{color:var(--lime);}
  .disp-card-dist{font-size:.68rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--text-muted);display:flex;align-items:center;gap:.3rem;margin-bottom:1rem;}
  .disp-services{margin-bottom:1rem;}
  .disp-svc-row{display:flex;justify-content:space-between;align-items:center;padding:.375rem 0;border-bottom:1px solid rgba(40, 35, 28,.05);}
  .disp-svc-row:last-child{border-bottom:none;}
  .disp-svc-name{font-size:.8rem;font-weight:500;color:#ada699;}
  .disp-svc-price{font-family:'Space Grotesk',sans-serif;font-size:1rem;color:var(--white);}
  .disp-btn{width:100%;background:linear-gradient(135deg,#dd7852,#9c4930);color:#fafaf6;border:none;border-radius:100px;padding:.75rem;font-family:'Inter',sans-serif;font-size:.875rem;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:.375rem;transition:all .2s;text-decoration:none;}
  .disp-btn:hover{transform:translateY(-1px);box-shadow:0 6px 16px rgba(221, 120, 82,.2);}
  .cw-card{flex-shrink:0;width:260px;background:#fefefd;border-radius:16px;padding:1.25rem;display:flex;flex-direction:column;gap:1rem;text-decoration:none;cursor:none;transition:all .2s;border:1px solid rgba(40, 35, 28,.05);position:relative;overflow:hidden;}
  .cw-card:hover{border-color:rgba(221, 120, 82,.18);background:#fefefd;}
  .cw-card-top{display:flex;align-items:center;gap:.875rem;}
  .cw-card-avatar{width:52px;height:52px;border-radius:50%;background:var(--lime);color:#fafaf6;font-family:'Space Grotesk',sans-serif;font-size:1.125rem;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
  .cw-card-avatar-info{flex:1;min-width:0;}
  .cw-card-name{font-family:'Space Grotesk',sans-serif;font-size:1.375rem;color:var(--white);line-height:1;margin-bottom:.25rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .cw-card-stars{display:flex;align-items:center;gap:.2rem;}
  .cw-card-stars i{font-size:.6rem;color:var(--lime);}
  .cw-card-rating-val{font-size:.72rem;font-weight:700;color:var(--white);margin-left:.2rem;}
  .cw-card-rating-ct{font-size:.68rem;color:var(--text-muted);}
  .cw-card-meta{display:flex;flex-direction:column;gap:.5rem;}
  .cw-card-addr{display:flex;align-items:flex-start;gap:.4rem;font-size:.75rem;color:var(--text-muted);line-height:1.4;}
  .cw-card-addr i{color:var(--text-muted);font-size:.6rem;margin-top:2px;flex-shrink:0;}
  .cw-card-row{display:flex;align-items:center;justify-content:space-between;gap:.5rem;}
  .cw-status-open{display:inline-flex;align-items:center;gap:.3rem;font-size:.68rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:var(--lime);background:rgba(221, 120, 82,.08);border:1px solid rgba(221, 120, 82,.2);border-radius:100px;padding:.2rem .625rem;}
  .cw-status-open-dot{width:5px;height:5px;border-radius:50%;background:var(--lime);}
  .cw-status-closed{display:inline-flex;align-items:center;font-size:.68rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#ada699;border:1px solid #e0dbd0;border-radius:100px;padding:.2rem .625rem;}
  .cw-card-dist{font-size:.72rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.08em;}
  .cw-card-btn{width:100%;border:1px solid rgba(40, 35, 28,.12);background:transparent;color:var(--white);border-radius:100px;padding:.6875rem;font-family:'Inter',sans-serif;font-size:.8125rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;cursor:pointer;transition:all .2s;text-decoration:none;display:flex;align-items:center;justify-content:center;}
  .cw-card-btn:hover{background:rgba(40, 35, 28,.06);border-color:rgba(40, 35, 28,.25);}
  .geo-banner{background:rgba(221, 120, 82,.04);border:1px solid rgba(221, 120, 82,.12);border-radius:12px;padding:1rem 1.25rem;display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;}
  .geo-banner-text{font-size:.875rem;color:var(--text-muted);}
  .geo-banner-btn{background:rgba(221, 120, 82,.12);border:1px solid rgba(221, 120, 82,.2);color:var(--lime);border-radius:100px;padding:.375rem 1rem;font-size:.78rem;font-weight:700;cursor:pointer;white-space:nowrap;transition:background .15s;}
  .geo-banner-btn:hover{background:rgba(221, 120, 82,.2);}
  .empty-banner{background:var(--surface-3);border:1px solid var(--border);border-radius:12px;padding:1rem 1.25rem;display:flex;align-items:center;gap:.875rem;}
  .empty-banner i{color:#575148;font-size:.9rem;flex-shrink:0;}
  .empty-banner-title{font-size:.875rem;font-weight:600;color:#575148;}
  .empty-banner-text{font-size:.75rem;color:#e0dbd0;line-height:1.5;}
  .home-divider{max-width:1200px;margin:1.75rem auto 0;padding:0 1.5rem;}
  .home-divider-line{height:1px;background:var(--border);}
  .loov-footer{max-width:1200px;margin:2.5rem auto 0;padding:2rem 1.5rem;border-top:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1.25rem;}
  .loov-footer-logo{font-family:'Space Grotesk',sans-serif;font-size:1.375rem;color:var(--white);text-decoration:none;}
  .loov-footer-logo span{color:var(--lime);}
  .loov-footer-links{display:flex;gap:1.5rem;list-style:none;margin:0;padding:0;flex-wrap:wrap;}
  .loov-footer-links a{font-size:.78rem;color:var(--text-muted);text-decoration:none;transition:color .2s;}
  .loov-footer-links a:hover{color:var(--lime);}
  .loov-footer-copy{font-size:.68rem;color:#e0dbd0;}
  .flash-wrap{max-width:1200px;margin:0 auto;padding:1.25rem 1.5rem 0;}
  .flash-msg{display:flex;align-items:center;gap:.75rem;padding:.875rem 1.125rem;border-radius:10px;font-size:.875rem;margin-bottom:.5rem;}
  .flash-msg.error{background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.2);color:#fca5a5;}
  .flash-msg.success{background:rgba(221, 120, 82,.08);border:1px solid rgba(221, 120, 82,.15);color:var(--lime);}
  @keyframes fadeUp{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
  @media(max-width:640px){.home-top,.home-section,.home-divider,.loov-footer,.flash-wrap{padding-left:1.125rem;padding-right:1.125rem;}.home-search-row{flex-direction:column;align-items:stretch;}.home-location-btn{justify-content:center;}.home-location-text{max-width:none;}.disp-card{width:260px;}.cw-card{width:230px;}}
</style>

<div class="home-wrap">
  <% if flash[:alert] || flash[:notice] %>
  <div class="flash-wrap">
    <% if flash[:alert] %><div class="flash-msg error"><i class="fas fa-circle-exclamation"></i><span><%= flash[:alert] %></span></div><% end %>
    <% if flash[:notice] %><div class="flash-msg success"><i class="fas fa-circle-check"></i><span><%= flash[:notice] %></span></div><% flash.discard(:notice) %><% end %>
  </div>
  <% end %>

  <%
    # Greeting por horário (substitui "SEU CARRO, SEU JEITO")
    now_sp_hero = Time.current.in_time_zone("America/Sao_Paulo")
    h_hero = now_sp_hero.hour
    greet_hero = if h_hero < 5      then "Boa madrugada"
                 elsif h_hero < 12  then "Bom dia"
                 elsif h_hero < 18  then "Boa tarde"
                 else                    "Boa noite"
                 end
    weekdays_hero = ['domingo','segunda-feira','terça-feira','quarta-feira','quinta-feira','sexta-feira','sábado']
    months_hero   = ['janeiro','fevereiro','março','abril','maio','junho','julho','agosto','setembro','outubro','novembro','dezembro']
    day_hero  = weekdays_hero[now_sp_hero.wday].capitalize
    date_hero = "#{now_sp_hero.day} de #{months_hero[now_sp_hero.month - 1]}"
    first_name_hero = if user_signed_in?
      (current_user.display_name.to_s.split(' ').first.presence || current_user.email.split('@').first.capitalize)
    end
  %>
  <style>
    .home-greet-eyebrow {
      display: inline-block;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px; letter-spacing: 2px;
      color: var(--coral-500) !important; text-transform: uppercase;
      padding: 6px 14px;
      background: var(--coral-50);
      border: 1px solid var(--coral-100);
      border-radius: 100px;
      margin-bottom: 16px;
    }
    .home-greet-title {
      font-family: 'Space Grotesk', sans-serif !important;
      font-weight: 700;
      font-size: clamp(36px, 6vw, 56px);
      letter-spacing: -1.2px;
      line-height: 1.05;
      color: var(--ink) !important;
      margin: 0 0 1.75rem 0;
    }
    .home-greet-title .greet-name {
      color: var(--coral-500);
      position: relative;
      white-space: nowrap;
    }
    .home-greet-title .greet-name::after {
      content: ''; position: absolute; left: 0; right: 0; bottom: -3px;
      height: 4px;
      background: linear-gradient(90deg, var(--coral-300), var(--coral-500));
      border-radius: 4px;
      opacity: .7;
    }
    .home-greet-wave {
      display: inline-block;
      animation: home-greet-wave 2.4s ease-in-out infinite;
      transform-origin: 70% 70%;
      font-size: 0.9em;
      margin-left: 12px;
    }
    @keyframes home-greet-wave {
      0%, 60%, 100% { transform: rotate(0); }
      10% { transform: rotate(14deg); }
      20% { transform: rotate(-8deg); }
      30% { transform: rotate(14deg); }
      40% { transform: rotate(-4deg); }
      50% { transform: rotate(10deg); }
    }

    /* Empilhar localização abaixo da busca (em vez de lado a lado) */
    .home-search-row { flex-direction: column !important; align-items: stretch !important; }
    .home-search-row .home-location-btn { justify-content: center; }
  </style>
  <div class="home-top">
    <div class="home-greet-eyebrow"><%= day_hero %> · <%= date_hero %></div>
    <h1 class="home-greet-title">
      <%= greet_hero %><% if first_name_hero %>,<br><span class="greet-name"><%= first_name_hero %></span><% end %><span class="home-greet-wave">👋</span>
    </h1>
    <%= form_with url: root_path, method: :get, local: true do %>
    <div class="home-search-row">
      <div class="home-search-field" style="position:relative;">
        <i class="fas fa-magnifying-glass home-search-icon"></i>
        <%= text_field_tag :search, params[:search], placeholder: "Buscar lava-rápido, bairro ou serviço...", class: "home-search-input", id: "search-input", autocomplete: "off" %>
        <% if params[:latitude].present? %>
          <%= hidden_field_tag :latitude, params[:latitude] %>
          <%= hidden_field_tag :longitude, params[:longitude] %>
        <% end %>
        <button type="submit" class="home-search-btn"><i class="fas fa-arrow-right"></i></button>
      </div>
      <% if params[:latitude].present? && @location_name.present? %>
        <div class="home-location-btn" style="cursor:default;"><i class="fas fa-location-dot"></i><span class="home-location-text"><%= @location_name %></span></div>
      <% elsif params[:latitude].present? %>
        <div class="home-location-btn" style="cursor:default;"><i class="fas fa-location-dot"></i><span>Localização ativa</span></div>
      <% else %>
        <button type="button" class="home-location-btn" onclick="requestGeo()"><i class="fas fa-location-dot"></i><span>Usar localização</span></button>
      <% end %>
    </div>
    <% end %>
  </div>

  <%# ── RESULTADOS DE BUSCA — aparece antes de tudo quando há busca ── %>
  <% if params[:search].present? %>
  <div class="home-section" id="search-results-section">
    <div class="home-section-header">
      <span class="home-section-title">Resultados para "<%= params[:search] %>"</span>
      <span style="font-size:.78rem;color:var(--text-muted);"><%= @search_results.count %> encontrado<%= @search_results.count == 1 ? '' : 's' %></span>
    </div>
    <% if @search_results.empty? %>
      <div class="empty-banner"><i class="fas fa-magnifying-glass"></i><div><div class="empty-banner-title">Nenhum resultado</div><div class="empty-banner-text">Tente outro nome, bairro ou serviço.</div></div></div>
    <% else %>
    <div class="h-scroll">
      <% @search_results.each do |cw| %>
      <% reviews=cw.reviews; avg_rating=reviews.any? ? reviews.average(:rating).to_f : nil; is_open=@open_car_wash_ids&.include?(cw.id); opens_today=cw.operating_hours.find_by(day_of_week: Time.current.in_time_zone("America/Sao_Paulo").wday) %>
      <div class="cw-card" onclick="window.location='<%= car_wash_path(cw) %>'" style="cursor:none;">
        <div class="cw-card-top"><div class="cw-card-avatar"><%= cw.name.first(2).upcase %></div><div class="cw-card-avatar-info"><div class="cw-card-name"><%= cw.name %></div><% if avg_rating %><div style="display:flex;align-items:center;gap:.2rem;flex-wrap:wrap;"><div class="cw-card-stars"><% 5.times do |s| %><i class="fas fa-star" style="color:<%= s < avg_rating.round ? '#dd7852' : '#575148' %>;"></i><% end %></div><span class="cw-card-rating-val"><%= sprintf('%.1f', avg_rating) %></span><span class="cw-card-rating-ct">(<%= reviews.count %>)</span></div><% end %></div></div>
        <div class="cw-card-meta"><div class="cw-card-addr"><i class="fas fa-location-dot"></i><span><%= cw.address || "Endereço não informado" %></span></div><div class="cw-card-row"><% if is_open %><div class="cw-status-open"><div class="cw-status-open-dot"></div>ABERTO</div><% elsif opens_today %><div class="cw-status-closed">ABRE ÀS <%= opens_today.opens_at.strftime("%H:%M") %></div><% else %><div class="cw-status-closed">FECHADO</div><% end %><% if params[:latitude].present? && cw.latitude && cw.longitude %><span class="cw-card-dist"><%= number_with_precision(cw.distance_to([params[:latitude].to_f, params[:longitude].to_f], :km), precision: 1) %> KM</span><% end %></div></div>
        <%= link_to "Ver detalhes", car_wash_path(cw), class: "cw-card-btn" %>
      </div>
      <% end %>
    </div>
    <% end %>
  </div>
  <div class="home-divider"><div class="home-divider-line"></div></div>
  <% end %>

  <% if user_signed_in? && current_user.client? %>

  <%# ── LAST MINUTE — espelha o app (zap icon, ver todos, helper text, cards dark ink) ── %>
  <% if @disponivel_has_location %>
  <style>
    .lm-section { max-width: 1200px; margin: 0 auto; padding: 1.75rem 1.5rem 0; }
    .lm-header  { display: flex; align-items: center; justify-content: space-between; margin-bottom: .35rem; }
    .lm-title-row { display: flex; align-items: center; gap: 8px; }
    .lm-title-row i { color: var(--coral-500); font-size: 1.1rem; }
    .lm-title { font-family: 'Space Grotesk', sans-serif; font-size: 1.0625rem; font-weight: 700; color: var(--ink); letter-spacing: -.2px; }
    .lm-link  { font-size: .8125rem; font-weight: 600; color: var(--coral-500); text-decoration: none; }
    .lm-link:hover { color: var(--coral-700); }
    .lm-helper { font-size: .8125rem; color: var(--graphite); margin-bottom: 14px; }
    .lm-scroll { display: flex; gap: 12px; overflow-x: auto; padding-bottom: 24px; -webkit-overflow-scrolling: touch; scroll-snap-type: x mandatory; }
    .lm-scroll::-webkit-scrollbar { height: 0; }
    .lm-card {
      flex-shrink: 0; width: 240px;
      background: var(--ink); border-radius: 20px;
      padding: 18px; position: relative; overflow: hidden;
      text-decoration: none; color: var(--cream);
      transition: transform .15s ease, box-shadow .15s ease;
      scroll-snap-align: start;
    }
    .lm-card:hover { transform: translateY(-2px); box-shadow: 0 14px 36px rgba(40,35,28,.18); }
    .lm-blob {
      position: absolute; top: -30px; right: -30px;
      width: 140px; height: 140px; border-radius: 50%;
      background: var(--coral-500); opacity: .2; pointer-events: none;
    }
    .lm-distance-pill {
      display: inline-flex; align-items: center; gap: 4px;
      background: rgba(221,120,82,0.18);
      border: 1px solid rgba(221,120,82,0.35);
      color: var(--coral-500);
      padding: 4px 10px; border-radius: 100px;
      font-size: 11px; font-weight: 600;
      position: relative;
    }
    .lm-distance-pill i { font-size: 10px; }
    .lm-shop {
      color: var(--cream); font-size: 16px;
      margin-top: 12px;
      letter-spacing: -.3px;
      font-family: 'Space Grotesk', sans-serif; font-weight: 600;
      position: relative;
    }
    .lm-meta {
      color: #b5ae9f; font-size: 11px;
      margin-top: 4px; line-height: 15px;
      position: relative;
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .lm-price-row {
      display: flex; align-items: baseline; justify-content: space-between;
      margin-top: 14px; position: relative;
    }
    .lm-price {
      font-size: 36px; color: var(--coral-500);
      letter-spacing: -1px;
      font-family: 'Space Grotesk', sans-serif; font-weight: 700;
      line-height: 1;
    }
    .lm-slot {
