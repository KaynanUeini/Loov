<script>
(function() {
  // CSRF token pra mutações (PATCH/POST). GETs não precisam, mas mantemos
  // o header sempre presente pra simplificar.
  const CSRF = document.querySelector('meta[name="csrf-token"]')?.content;

  const MESES = ['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];
  const DIAS  = ['dom','seg','ter','qua','qui','sex','sáb'];

  // Estado em memória — fonte da verdade depois do fetch.
  let allServices    = [];
  let allAppointments = [];
  let unresolvedPast = [];
  let loyaltyData    = null;
  let actionLoadingId = null;
  let editingAppt = null;
  let cancelTarget = null;

  // ── Helpers ───────────────────────────────────────────────────────────
  function fmtMoney(v, decimals = 2) {
    const n = Number(v);
    if (!Number.isFinite(n)) return 'R$ 0,00';
    return 'R$ ' + n.toFixed(decimals).replace('.', ',');
  }
  function todayLabel() {
    const d = new Date();
    return `${DIAS[d.getDay()]} · ${d.getDate()} ${MESES[d.getMonth()]}`.toUpperCase();
  }
  function fmtDateBR(iso) {
    if (!iso) return '';
    const [, m, d] = iso.split('-');
    return `${Number(d)} ${MESES[Number(m) - 1] || ''}`;
  }
  function escapeHtml(s) {
    return String(s ?? '').replace(/[&<>"']/g, c => ({
      '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
    })[c]);
  }
  function isInService(appt) {
    const start = new Date(appt.scheduled_at).getTime();
    const elapsed = Date.now() - start;
    if (elapsed < 0) return false;
    if (appt.status === 'confirmed') return true;
    if (appt.status === 'attended' && appt.walk_in) {
      const duration = Math.max(1, Number(appt.duration) || 30) * 60 * 1000;
      return elapsed < duration;
    }
    return false;
  }
  function liveProgress(appt) {
    const start = new Date(appt.scheduled_at).getTime();
    const duration = Math.max(1, Number(appt.duration) || 30) * 60 * 1000;
    const elapsed = Date.now() - start;
    const progress = Math.min(100, Math.max(0, Math.round((elapsed / duration) * 100)));
    const etaMinutes = Math.max(0, Math.round((duration - elapsed) / 60000));
    let phase = 'iniciando';
    if (progress >= 30 && progress < 80) phase = 'em andamento';
    else if (progress >= 80) phase = 'finalizando';
    return { progress, etaMinutes, phase };
  }

  function showToast(msg, type='info') {
    const c=document.getElementById('toast-container');
    if(!c) return;
    const t=document.createElement('div');
    t.className=`toast ${type}`;
    const icons={success:'fa-check',error:'fa-times',warning:'fa-triangle-exclamation',info:'fa-info-circle'};
    t.innerHTML=`<i class="fas ${icons[type]||'fa-info-circle'}"></i> ${escapeHtml(msg)}`;
    c.appendChild(t);
    setTimeout(()=>{t.classList.add('out');setTimeout(()=>t.remove(),320);},3200);
  }

  // ── Clock / sidebar date ──────────────────────────────────────────────
  function updateClock() {
    const lbl = todayLabel();
    document.getElementById('od-today-label').textContent = lbl;
    const sd = document.getElementById('sidebar-date-small');
    if (sd) sd.textContent = lbl;
  }
  updateClock();
  setInterval(updateClock, 60_000);

  // ── Fetch helpers ─────────────────────────────────────────────────────
  async function patchJson(url, body) {
    const res = await fetch(url, {
      method: 'PATCH',
      headers: {
        'X-CSRF-Token': CSRF,
        'Accept': 'application/json',
        'Content-Type': 'application/json'
      },
      body: body ? JSON.stringify(body) : null,
    });
    return { ok: res.ok, data: await res.json().catch(()=>({})) };
  }
  async function postJson(url, body) {
    const res = await fetch(url, {
      method: 'POST',
      headers: {
        'X-CSRF-Token': CSRF,
        'Accept': 'application/json',
        'Content-Type': 'application/json'
      },
      body: body ? JSON.stringify(body) : null,
    });
    return { ok: res.ok, data: await res.json().catch(()=>({})) };
  }

  // ── Card render ───────────────────────────────────────────────────────
  // Legenda sob demanda do selo/código, por card. Sobrevive ao re-render do
  // polling; some sozinha em 4s ou ao clicar de novo.
  const cardHints = {};
  function toggleHint(id, kind) {
    const cur = cardHints[id];
    if (cur) clearTimeout(cur.timer);
    if (cur && cur.kind === kind) { delete cardHints[id]; render(); return; }
    cardHints[id] = { kind, timer: setTimeout(() => { delete cardHints[id]; render(); }, 4000) };
    render();
  }

  function renderCard(appt, opts = {}) {
    const { isPast = false, showDate = false } = opts;
    const isWalkIn   = appt.walk_in === true;
    const isAttended = appt.status === 'attended';
    const isNoShow   = appt.status === 'no_show';
    const isConfirmed = appt.status === 'confirmed';
    const inService  = !isPast && isInService(appt);
    const isFinalized = !inService && (isAttended || isNoShow);
    const isFuture    = !isPast && !inService && !isFinalized;

    let phase = null, etaMinutes = 0, progress = 0;
    if (inService) {
      const live = liveProgress(appt);
      phase = live.phase; etaMinutes = live.etaMinutes; progress = live.progress;
    }

    const showPrimaryActions   = (inService && !isWalkIn) || (isPast && isConfirmed);
    const showSecondaryActions = inService || isFuture || (isPast && isConfirmed);

    const card = document.createElement('div');
    card.className = `owner-dash-card${isFinalized ? ' inactive' : ''}`;
    card.dataset.id = appt.id;

    const isDisp = appt.is_disponivel && appt.remaining_amount != null;
    const charge = isDisp ? appt.remaining_amount : appt.price;

    let tagHtml = '';
    if (isWalkIn) {
      tagHtml = `<span class="owner-dash-tag-walkin">AVULSO</span>`;
    } else {
      if (appt.is_disponivel) {
        tagHtml += `<button type="button" class="owner-dash-zap" data-hint="lastminute"
          title="Cliente do Last Minute" aria-label="Cliente do Last Minute. Clique para saber mais."><i class="fas fa-bolt"></i></button>`;
      }
      if (appt.show_code && appt.phone_last4) {
        tagHtml += `<button type="button" class="owner-dash-code" data-hint="code"
          title="Código de conferência" aria-label="Código de conferência ${escapeHtml(appt.phone_last4)}. Clique para saber mais."><i class="fas fa-shield-halved"></i>${escapeHtml(appt.phone_last4)}</button>`;
      }
    }

    const hint = cardHints[appt.id]?.kind;
    const hintHtml = hint ? `
      <div class="owner-dash-hint">
        <i class="fas ${hint === 'code' ? 'fa-shield-halved' : 'fa-bolt'}"></i>
        <span>${hint === 'code'
          ? 'Últimos 4 dígitos do telefone do cliente. Peça pra ele confirmar antes de entregar o carro.'
          : 'Reserva feita pelo Last Minute: o cliente já pagou parte no app, e o valor ao lado é o que falta receber.'}</span>
      </div>` : '';

    const timeBarHtml = isFinalized
      ? `<div class="owner-dash-time-bar ${isNoShow ? 'rose' : 'mint'}"></div>`
      : '';

    const dateLineHtml = (showDate && appt.date)
      ? `<div class="owner-dash-time-date">${escapeHtml(fmtDateBR(appt.date))}</div>`
      : '';

    let rightHtml = '';
    if (inService) {
      rightHtml = `
        <span class="owner-dash-phase">${escapeHtml(phase)}</span>
        <span class="owner-dash-eta">${etaMinutes}m</span>
      `;
    } else if (isFinalized) {
      rightHtml = isNoShow
        ? `<span class="owner-dash-outcome out"><i class="fas fa-user-xmark"></i>FALTOU</span>`
        : `<span class="owner-dash-outcome ok"><i class="fas fa-check"></i>ATENDIDO</span>`;
    }

    const revertHtml = isFinalized ? `
      <button type="button" class="owner-dash-revert-row" data-action="revert">
        <i class="fas fa-rotate-left"></i> Reverter
      </button>
    ` : '';

    const progressHtml = inService ? `
      <div class="owner-dash-progress">
        <div class="owner-dash-progress-fill" style="width:${progress}%;"></div>
      </div>
    ` : '';

    const primaryHtml = showPrimaryActions ? `
      <div class="owner-dash-actions">
        <button class="owner-dash-btn-ghost" data-action="noshow">
          <i class="fas fa-user-xmark"></i> Ausente
        </button>
        <button class="owner-dash-btn-primary" data-action="attend">
          <i class="fas fa-check"></i> ${isPast ? 'Compareceu' : 'Finalizado'}
        </button>
      </div>
    ` : '';

    const secondaryHtml = showSecondaryActions ? `
      <div class="owner-dash-secondary">
        <button class="owner-dash-link" data-action="edit">
          <i class="fas fa-pen"></i> Editar serviço
        </button>
        ${!isPast ? `
          <div class="owner-dash-link-sep"></div>
          <button class="owner-dash-link danger" data-action="cancel">
            <i class="fas fa-xmark"></i> Cancelar
          </button>
        ` : ''}
      </div>
    ` : '';

    const vehicleHtml = appt.vehicle
      ? `<div class="owner-dash-meta">${escapeHtml(appt.vehicle)}</div>`
      : '';

    card.innerHTML = `
      <div class="owner-dash-card-top">
        ${timeBarHtml}
        <div class="owner-dash-time-block">
          ${dateLineHtml}
          <div class="owner-dash-time">${escapeHtml(appt.time)}</div>
        </div>
        <div class="owner-dash-card-body">
          <div class="owner-dash-card-row1">
            <span class="owner-dash-client">${escapeHtml(appt.client || 'Cliente')}</span>
            ${tagHtml}
          </div>
          ${hintHtml}
          <div class="owner-dash-meta">
            ${escapeHtml(appt.service)} · <span class="owner-dash-meta-price">${fmtMoney(charge, 2)}</span>
          </div>
          ${vehicleHtml}
        </div>
        <div class="owner-dash-card-right">${rightHtml}</div>
      </div>
      ${revertHtml}
      ${progressHtml}
      ${primaryHtml}
      ${secondaryHtml}
    `;

    card.querySelectorAll('[data-hint]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleHint(appt.id, btn.dataset.hint);
      });
    });

    // Hooks de ação — delegação por dataset.action
    card.querySelectorAll('[data-action]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const act = btn.dataset.action;
        if (act === 'attend')  return doAction(appt, 'attend',  btn);
        if (act === 'noshow')  return doAction(appt, 'no_show', btn);
        if (act === 'revert')  return doAction(appt, 'revert',  btn);
        if (act === 'edit')    return openEditSheet(appt);
        if (act === 'cancel')  return openCancelSheet(appt);
      });
    });

    return card;
  }

  async function doAction(appt, path, btn) {
    if (actionLoadingId) return;
    actionLoadingId = appt.id;
    btn.disabled = true;
    const orig = btn.innerHTML;
    btn.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i>';
    const { ok, data } = await patchJson(`/owner/checkins/${appt.id}/${path}`);
    actionLoadingId = null;
    if (!ok) {
      btn.disabled = false;
      btn.innerHTML = orig;
      showToast(data.error || 'Ação falhou.', 'error');
      return;
    }
    if (path === 'attend')  showToast('Atendimento finalizado.', 'success');
    if (path === 'no_show') showToast('Marcado como ausente.', 'info');
    if (path === 'revert')  showToast('Reversão concluída.', 'info');
    await loadDashboard(true);
  }

  // ── Render principal ──────────────────────────────────────────────────
  function render() {
    // Lista única do dia em ordem cronológica (cancelados/rejected fora)
    const todayList = allAppointments
      .filter(a => a.status !== 'cancelled' && a.status !== 'rejected')
      .sort((a, b) => {
        const t = new Date(a.scheduled_at) - new Date(b.scheduled_at);
        if (t !== 0) return t;
        return (a.id || 0) - (b.id || 0);
      });

    const inServiceCount = todayList.filter(isInService).length;

    // Section header
    const pulse = document.getElementById('od-pulse');
    const liveBadge = document.getElementById('od-live-badge');
    pulse.classList.toggle('visible', inServiceCount > 0);
    liveBadge.classList.toggle('visible', inServiceCount > 0);
    liveBadge.textContent = inServiceCount;

    // Lista
    const list = document.getElementById('od-list');
    list.innerHTML = '';
    if (todayList.length === 0) {
      list.innerHTML = `<div class="owner-dash-empty"><i class="fas fa-calendar"></i> Sem atendimentos hoje</div>`;
    } else {
      todayList.forEach(a => list.appendChild(renderCard(a)));
    }

    // Past pending banner
    const banner = document.getElementById('od-past-banner');
    const title  = document.getElementById('od-past-title');
    if (unresolvedPast.length > 0) {
      banner.classList.remove('hidden');
      title.textContent = unresolvedPast.length === 1
        ? '1 pendência de dias anteriores'
        : `${unresolvedPast.length} pendências de dias anteriores`;
    } else {
      banner.classList.add('hidden');
    }

    // Loyalty card
    const loyaltyBlock = document.getElementById('od-loyalty-block');
    if (loyaltyData?.active) {
      loyaltyBlock.style.display = '';
      document.getElementById('od-loyalty-title').textContent =
        `A cada ${loyaltyData.visits_required} visitas`;
      document.getElementById('od-loyalty-desc').textContent =
        loyaltyData.reward_description || '';
    } else {
      loyaltyBlock.style.display = 'none';
    }
  }

  // ── Pausa (Last Minute + agendamentos) ────────────────────────────────
  // Mesmo contrato do app: PATCH com minutes (null = até fechar), DELETE
  // retoma. O polling de 15s traz o estado do servidor; o tique de 10s só
  // faz a barra andar entre uma resposta e outra.
  const pauseState = { loaded:false, paused:false, until:null, at:null, open:true, setup:true, busy:false };
  let pauseTick = null;

  function fmtHoraLocal(iso) {
    if (!iso) return '';
    return new Date(iso).toLocaleTimeString('pt-BR', { hour:'2-digit', minute:'2-digit', timeZone:'America/Sao_Paulo' });
  }

  function renderPause() {
    const group = document.getElementById('od-pause-group');
    if (!group) return;
    const st = pauseState;
    // Cadastro incompleto: o checklist de ativação já está acima, e pausar
    // uma loja que ainda não recebe nada não faz sentido.
    group.hidden = !st.loaded || !st.setup;
    if (group.hidden) return;

    const card = document.getElementById('od-pause-card');
    const sw   = document.getElementById('od-pause-switch');
    card.classList.toggle('on', st.paused);
    card.classList.toggle('closed', !st.paused && !st.open);
    document.getElementById('od-pause-state').textContent =
      st.paused ? 'PAUSADO' : st.open ? 'RECEBENDO' : 'FORA DO HORÁRIO';
    document.getElementById('od-pause-line').textContent =
      st.paused ? `Retorno às ${fmtHoraLocal(st.until)}` : 'Last Minute e agendamentos';

    sw.setAttribute('aria-checked', String(!st.paused && st.open));
    sw.disabled = !st.open && !st.paused;
    sw.classList.toggle('busy', st.busy);
    sw.title = st.paused ? 'Voltar a receber' : st.open ? 'Pausar por 30 min' : 'Fora do horário de funcionamento';

    const extra = document.getElementById('od-pause-extra');
    extra.hidden = !st.paused;
    extra.querySelectorAll('button').forEach(b => b.disabled = st.busy);
    if (st.paused) {
      const rest  = new Date(st.until).getTime() - Date.now();
      const total = st.at ? new Date(st.until).getTime() - new Date(st.at).getTime() : 0;
      const frac  = total > 0 ? Math.min(1, Math.max(0, rest / total)) : 1;
      document.getElementById('od-pause-bar').style.width = `${Math.round(frac * 100)}%`;
      if (rest <= 0) { st.paused = false; st.until = st.at = null; return renderPause(); }
    }

    const foot = document.getElementById('od-pause-foot');
    foot.hidden = st.paused;
    foot.textContent = st.open
      ? 'Desligar bloqueia agendamentos novos até o horário de retorno. O que já está marcado continua valendo.'
      : 'Fora do horário não chega agendamento de última hora.';

    if (st.paused && !pauseTick) pauseTick = setInterval(renderPause, 10_000);
    if (!st.paused && pauseTick) { clearInterval(pauseTick); pauseTick = null; }
  }

  function applyShop(sd) {
    pauseState.loaded = true;
    pauseState.paused = !!sd.paused;
    pauseState.until  = sd.paused_until || null;
    pauseState.at     = sd.paused_at || null;
    pauseState.open   = sd.open_now !== false;
    pauseState.setup  = !!(sd.operating_hours?.length && sd.services?.length);
    renderPause();
  }

  async function changePause(minutes) {
    if (pauseState.busy) return;
    pauseState.busy = true; renderPause();
    const resume = minutes === 'resume';
    try {
      const res = await fetch('/owner/car_wash/pause', {
        method: resume ? 'DELETE' : 'PATCH',
        headers: { Accept:'application/json', 'Content-Type':'application/json', 'X-CSRF-Token': CSRF },
        body: resume ? null : JSON.stringify({ minutes }),
      });
      if (!res.ok) throw new Error();
      const d = await res.json();
      pauseState.paused = !!d.paused;
      pauseState.until  = d.paused_until || null;
      pauseState.at     = d.paused_at || null;
      showToast(d.paused ? `Last Minute pausado até ${fmtHoraLocal(d.paused_until)}.` : 'Voltou a receber Last Minute.',
                d.paused ? 'info' : 'success');
    } catch {
      showToast('Não foi possível mudar a pausa.', 'error');
    } finally {
      pauseState.busy = false; renderPause();
    }
  }

  document.getElementById('od-pause-switch')?.addEventListener('click', () => {
    if (pauseState.busy) return;
    changePause(pauseState.paused ? 'resume' : 30);
  });
  document.querySelectorAll('#od-pause-extra [data-pause]').forEach(b => {
    b.addEventListener('click', () => changePause(b.dataset.pause === 'close' ? null : 30));
  });

  // ── Loaders ───────────────────────────────────────────────────────────
  async function loadDashboard(silent = false) {
    try {
      const hasPause = !!document.getElementById('od-pause-group');
      const [ckRes, dispRes, shopRes] = await Promise.all([
        fetch('/owner/checkins/today',         { headers:{ Accept:'application/json' }}),
        fetch('/owner/disponivel_acceptance',  { headers:{ Accept:'application/json' }}).catch(()=>null),
        hasPause && !pauseState.busy
          ? fetch('/owner/car_wash', { headers:{ Accept:'application/json' }}).catch(()=>null)
          : null,
      ]);
      if (shopRes && shopRes.ok && !pauseState.busy) {
        shopRes.json().then(applyShop).catch(()=>{});
      }
      if (!ckRes.ok) throw new Error('today fetch failed');
      const data = await ckRes.json();
      const summary = data.summary || {};

      allServices     = data.services || [];
      allAppointments = data.appointments || [];
      // Dedupe defensivo por id (race entre cliques rápidos + refetch)
      const seen = new Set();
      unresolvedPast = (data.unresolved_past || []).filter(a => {
        if (seen.has(a.id)) return false;
        seen.add(a.id); return true;
      });
      loyaltyData = data.loyalty || null;

      // Hero + KPIs
      document.getElementById('od-revenue').textContent  = fmtMoney(summary.revenue_today || 0, 2);
      document.getElementById('od-svc-count').textContent= summary.total ?? 0;
      document.getElementById('od-kpi-attended').textContent = summary.attended ?? 0;
      document.getElementById('od-kpi-pending').textContent  = summary.pending ?? 0;
      document.getElementById('od-kpi-noshow').textContent   = summary.no_show ?? 0;

      // Sino dot — pendências disponível
      if (dispRes && dispRes.ok) {
        const arr = await dispRes.json().catch(()=>[]);
        const bell = document.getElementById('od-bell-btn');
        bell.classList.toggle('has-pending', Array.isArray(arr) && arr.length > 0);
      }

      render();
    } catch (e) {
      if (!silent) showToast('Não foi possível carregar o painel.', 'error');
      console.error('[loadDashboard]', e);
    }
  }

  // ── Modal: edit service ───────────────────────────────────────────────
  function openEditSheet(appt) {
    editingAppt = appt;
    document.getElementById('od-edit-sub').textContent = `${appt.client} · ${appt.time}`;
    const list = document.getElementById('od-edit-list');
    list.innerHTML = '';
    allServices.forEach(svc => {
      const isCurrent = svc.id === appt.service_id;
      const row = document.createElement('div');
      row.className = `owner-dash-svc-row${isCurrent ? ' active' : ''}`;
      row.innerHTML = `
        <div style="flex:1;">
          <div class="owner-dash-svc-title">${escapeHtml(svc.title)}</div>
          ${isCurrent ? '<div class="owner-dash-svc-hint">ATUAL</div>' : ''}
        </div>
        <div class="owner-dash-svc-price">${fmtMoney(svc.price, 0)}</div>
      `;
      row.addEventListener('click', () => updateService(svc.id, row));
      list.appendChild(row);
    });
    document.getElementById('od-edit-overlay').classList.add('open');
  }

  async function updateService(serviceId, row) {
    if (!editingAppt) return;
    document.querySelectorAll('#od-edit-list .owner-dash-svc-row').forEach(r => r.classList.add('disabled'));
    const { ok, data } = await patchJson(
      `/owner/checkins/${editingAppt.id}/update_service`,
      { service_id: serviceId }
    );
    if (!ok) {
      showToast(data.error || 'Não foi possível atualizar o serviço.', 'error');
      document.querySelectorAll('#od-edit-list .owner-dash-svc-row').forEach(r => r.classList.remove('disabled'));
      return;
    }
    showToast('Serviço atualizado.', 'success');
    closeOverlay('edit');
    editingAppt = null;
    await loadDashboard(true);
  }

  // ── Modal: cancel ─────────────────────────────────────────────────────
  function openCancelSheet(appt) {
    cancelTarget = appt;
    document.getElementById('od-cancel-sub').textContent =
      `${appt.client} · ${appt.service} · ${appt.time}`;
    document.getElementById('od-cancel-reason').value = '';
    document.getElementById('od-cancel-error').style.display = 'none';
    const btn = document.getElementById('od-cancel-confirm');
    btn.disabled = false;
    btn.innerHTML = '<i class="fas fa-xmark"></i> CANCELAR ATENDIMENTO';
    document.getElementById('od-cancel-overlay').classList.add('open');
  }

  document.getElementById('od-cancel-confirm').addEventListener('click', async () => {
    if (!cancelTarget) return;
    const btn = document.getElementById('od-cancel-confirm');
    const errEl = document.getElementById('od-cancel-error');
    const reason = document.getElementById('od-cancel-reason').value.trim();
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> Cancelando...';
    errEl.style.display = 'none';
    const { ok, data } = await patchJson(
      `/owner/checkins/${cancelTarget.id}/cancel`,
      { reason }
    );
    if (!ok) {
      errEl.textContent = data.error || 'Erro ao cancelar.';
      errEl.style.display = 'block';
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-xmark"></i> CANCELAR ATENDIMENTO';
      return;
    }
    showToast('Atendimento cancelado.', 'success');
    closeOverlay('cancel');
    cancelTarget = null;
    await loadDashboard(true);
  });

  // ── Modal: walk-in ────────────────────────────────────────────────────
  function openWalkInSheet() {
    const sel = document.getElementById('od-wi-service');
    sel.innerHTML = allServices.map(s =>
      `<option value="${s.id}">${escapeHtml(s.title)} — ${fmtMoney(s.price, 0)}</option>`
    ).join('');
    document.getElementById('od-wi-name').value  = '';
    document.getElementById('od-wi-price').value = '';
    document.getElementById('od-wi-time').value  = new Date().toTimeString().slice(0,5);
    const err = document.getElementById('od-wi-error');
    err.style.display = 'none';
    const btn = document.getElementById('od-wi-save');
    btn.disabled = false;
    btn.innerHTML = '<i class="fas fa-check"></i> Registrar atendimento';
    document.getElementById('od-walkin-overlay').classList.add('open');
  }

  document.getElementById('od-wi-save').addEventListener('click', async () => {
    const name  = document.getElementById('od-wi-name').value.trim();
    const time  = document.getElementById('od-wi-time').value;
    const svc   = document.getElementById('od-wi-service').value;
    const price = document.getElementById('od-wi-price').value.trim();
    const err = document.getElementById('od-wi-error');
    const btn = document.getElementById('od-wi-save');
    err.style.display = 'none';
    if (!name) {
      err.textContent = 'Informe o nome do cliente.';
      err.style.display = 'block';
      return;
    }
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> Registrando...';
    const { ok, data } = await postJson('/owner/checkins/walk_in', {
      walk_in_name: name,
      scheduled_at: time,
      service_id: svc,
      price_override: price || null
    });
    if (!ok) {
      err.textContent = data.error || 'Erro ao registrar.';
      err.style.display = 'block';
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-check"></i> Registrar atendimento';
      return;
    }
    showToast('Atendimento registrado.', 'success');
    closeOverlay('walkin');
    await loadDashboard(true);
  });

  // ── Modal: past pending sheet ─────────────────────────────────────────
  window.openPastSheet = function() {
    const list = document.getElementById('od-past-list');
    const sub  = document.getElementById('od-past-sub');
    sub.textContent = `${unresolvedPast.length} aguardando sua confirmação`;
    list.innerHTML = '';
    unresolvedPast.forEach(a => {
      list.appendChild(renderCard(a, { isPast:true, showDate:true }));
    });
    document.getElementById('od-past-overlay').classList.add('open');
    if (unresolvedPast.length === 0) closeOverlay('past');
  };

  // Auto-close past sheet quando todas as pendências forem resolvidas
  function autoClosePastIfEmpty() {
    if (document.getElementById('od-past-overlay')?.classList.contains('open')
        && unresolvedPast.length === 0) {
      closeOverlay('past');
    }
  }

  // ── Overlay close (genérico) ──────────────────────────────────────────
  function closeOverlay(kind) {
    const map = { edit:'od-edit-overlay', cancel:'od-cancel-overlay', walkin:'od-walkin-overlay', past:'od-past-overlay' };
    const el = document.getElementById(map[kind]);
    if (el) el.classList.remove('open');
  }
  document.querySelectorAll('[data-od-close]').forEach(btn => {
    btn.addEventListener('click', () => closeOverlay(btn.dataset.odClose));
  });
  // Click no backdrop fecha
  ['od-edit-overlay','od-cancel-overlay','od-walkin-overlay','od-past-overlay'].forEach(id => {
    document.getElementById(id)?.addEventListener('click', e => {
      if (e.target.id === id) closeOverlay(id.replace('od-','').replace('-overlay',''));
    });
  });

  // ── Hooks ─────────────────────────────────────────────────────────────
  document.getElementById('od-walkin-btn').addEventListener('click', openWalkInSheet);
  // O sino abre o pedido do Last Minute pendente (alerta global do layout).
  // Antes mandava pra /owner/disponivel_acceptance, que é só JSON.
  document.getElementById('od-bell-btn').addEventListener('click', () => {
    if (!(window.LoovLM && window.LoovLM.open())) showToast('Nenhum pedido do Last Minute aguardando agora.', 'info');
  });

  // ── Live tick — atualiza ETAs e progress sem refetch ─────────────────
  setInterval(() => {
    // Re-render só se há atendimentos ativos (evita pisca toda hora)
    const hasLive = allAppointments.some(isInService);
    if (hasLive) render();
  }, 30_000);

  // Polling silencioso a cada 15s pra refletir mudanças do app
  setInterval(() => loadDashboard(true), 15_000);

  // ── APROVAÇÕES (drawer mantido) ──────────────────────────────────────
  async function loadApprovals() {
    const btn = document.getElementById('od-approval-btn');
    if (!btn) return;
    try {
      const res = await fetch('/owner/pending_changes', { headers:{ Accept:'application/json' }});
      const data = await res.json();
      const badge = document.getElementById('od-approval-badge');
      const navBadge = document.getElementById('snav-approval-badge');
      const navBtn = document.getElementById('approval-nav-btn');
      if (data.length > 0) {
        badge.textContent = data.length; badge.classList.add('visible');
        if (navBadge) { navBadge.textContent = data.length; navBadge.classList.add('visible'); }
        if (navBtn) navBtn.style.display = 'flex';
      } else {
        badge.classList.remove('visible');
        if (navBadge) navBadge.classList.remove('visible');
        if (navBtn) navBtn.style.display = 'none';
      }
      renderApprovalDrawer(data);
    } catch(e) {}
  }
  function renderApprovalDrawer(data) {
    const body = document.getElementById('drawer-body');
    const badge = document.getElementById('drawer-badge');
    badge.textContent = data.length;
    if (!data.length) {
      body.innerHTML = '<div class="drawer-empty"><i class="fas fa-check-circle" style="display:block;font-size:1.5rem;margin-bottom:8px;color:var(--od-ash);"></i>Nenhuma alteração pendente.</div>';
      return;
    }
    body.innerHTML = '';
    data.forEach(pc => {
      const did = `detail-${pc.id}`;
      const card = document.createElement('div');
      card.className = 'approval-card'; card.id = `acard-${pc.id}`;
      card.innerHTML = `
        <div class="approval-card-header">
          <div class="approval-card-desc">${escapeHtml(pc.description)}</div>
          <button class="approval-toggle" onclick="toggleDetail('${did}')"><i class="fas fa-plus" id="icon-${did}"></i></button>
        </div>
        <div class="approval-card-meta"><i class="fas fa-user" style="margin-right:4px;color:var(--od-stone);"></i>${escapeHtml(pc.attendant)} · ${escapeHtml(pc.created_at)}</div>
        <div id="${did}" class="approval-detail">${formatPayload(pc.change_type, pc.payload)}</div>
        <div class="approval-actions">
          <button class="btn-approve" onclick="approveChange(${pc.id},this)"><i class="fas fa-check"></i> Aprovar</button>
          <button class="btn-reject" onclick="rejectChange(${pc.id},this)"><i class="fas fa-xmark"></i> Rejeitar</button>
        </div>
      `;
      body.appendChild(card);
    });
  }
  const costLabels = { rent:'Aluguel', salaries:'Salários', utilities:'Energia/Água', products:'Produtos', maintenance:'Manutenção', other_fixed:'Outros fixos', other_variable:'Outros variáveis', notes:'Observações' };
  function formatPayload(ct, payload) {
    if (!payload) return '<em style="color:var(--od-ash)">Sem detalhes.</em>';
    if (ct === 'monthly_costs') {
      const cp = payload.cost_params || {};
      const month = payload.month ? `${String(payload.month).padStart(2,'0')}/${payload.year}` : '';
      let rows = `<div style="font-size:.62rem;color:var(--od-amber-500);margin-bottom:6px;font-weight:700;letter-spacing:.1em;">CUSTOS — ${month}</div>`;
      rows += Object.entries(cp).map(([k,v]) => {
        if (v==='' || v==null) return '';
        const label = costLabels[k] || k;
        const val = k==='notes'
          ? `<span style="color:var(--od-graphite)">${escapeHtml(v||'—')}</span>`
          : `<span style="color:var(--od-graphite)">R$ ${parseFloat(v).toLocaleString('pt-BR',{minimumFractionDigits:2})}</span>`;
        return `<div style="display:flex;justify-content:space-between;padding:3px 0;border-bottom:1px solid var(--od-stone);"><span style="color:var(--od-ash)">${label}</span>${val}</div>`;
      }).join('');
      return rows;
    }
    return `<pre style="font-size:.66rem;color:var(--od-graphite);white-space:pre-wrap;margin:0;">${escapeHtml(JSON.stringify(payload,null,2))}</pre>`;
  }
  function removeCard(cardEl, cb) { cardEl.classList.add('removing'); setTimeout(cb, 220); }
  window.toggleDetail = function(id) {
    const el=document.getElementById(id), icon=document.getElementById('icon-'+id);
    if(!el) return;
    const open = el.style.display === 'none' || !el.style.display;
    el.style.display = open ? 'block' : 'none';
    icon.className = open ? 'fas fa-minus' : 'fas fa-plus';
  };
  window.approveChange = async function(id, btn) {
    if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i>'; }
    try {
      await fetch(`/owner/pending_changes/${id}/approve`, {
        method:'PATCH',
        headers:{ 'X-CSRF-Token':CSRF, 'Content-Type':'application/json' }
      });
      const card = document.getElementById(`acard-${id}`);
      if (card) removeCard(card, () => loadApprovals());
      else loadApprovals();
      showToast('Alteração aprovada.', 'success');
    } catch(e) {
      showToast('Erro ao aprovar.', 'error');
      if (btn) { btn.disabled = false; btn.innerHTML = '<i class="fas fa-check"></i> Aprovar'; }
    }
  };
  window.rejectChange = async function(id, btn) {
    if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i>'; }
    try {
      await fetch(`/owner/pending_changes/${id}/reject`, {
        method:'PATCH',
        headers:{ 'X-CSRF-Token':CSRF, 'Content-Type':'application/json' }
      });
      const card = document.getElementById(`acard-${id}`);
      if (card) removeCard(card, () => loadApprovals());
      else loadApprovals();
      showToast('Alteração rejeitada.', 'error');
    } catch(e) {
      showToast('Erro ao rejeitar.', 'error');
      if (btn) { btn.disabled = false; btn.innerHTML = '<i class="fas fa-xmark"></i> Rejeitar'; }
    }
  };
  window.openApprovalDrawer = function() {
    document.getElementById('approval-drawer').classList.add('open');
    document.getElementById('approval-overlay').classList.add('open');
    document.body.style.overflow = 'hidden';
  };
  function closeApprovalDrawer() {
    document.getElementById('approval-drawer').classList.remove('open');
    document.getElementById('approval-overlay').classList.remove('open');
    document.body.style.overflow = '';
  }
  document.getElementById('drawer-close')?.addEventListener('click', closeApprovalDrawer);
  document.getElementById('approval-overlay')?.addEventListener('click', closeApprovalDrawer);

  // ── ACTIVATION CHECKLIST DISMISS ─────────────────────────────────────
  window.dismissActivation = function() {
    const el = document.getElementById('activation-banner');
    if (el) {
      el.style.transition = 'opacity .3s,transform .3s';
      el.style.opacity = '0'; el.style.transform = 'translateY(-8px)';
      setTimeout(() => el.remove(), 320);
    }
    sessionStorage.setItem('loov_activation_dismissed', '1');
  };
  if (sessionStorage.getItem('loov_activation_dismissed')) {
    document.addEventListener('DOMContentLoaded', () => {
      document.getElementById('activation-banner')?.remove();
    });
  }

  // ── MENSAGEM AO CLIENTE (modal legado preservado) ───────────────────
  let msgTarget = 'all';
  window.openMsgModal = function() {
    document.getElementById('msg-modal-overlay').classList.add('open');
    document.body.style.overflow = 'hidden';
    document.getElementById('msg-body').value = '';
    document.getElementById('msg-count').textContent = '0';
    document.getElementById('msg-error').style.display = 'none';
    setMsgTarget('all');
    loadMsgClients();
  };
  function closeMsgModal() {
    document.getElementById('msg-modal-overlay').classList.remove('open');
    document.body.style.overflow = '';
  }
  window.setMsgTarget = function(t) {
    msgTarget = t;
    document.getElementById('msg-target-all').classList.toggle('active', t==='all');
    document.getElementById('msg-target-user').classList.toggle('active', t==='user');
    document.getElementById('msg-client-wrap').style.display = t==='user' ? 'block' : 'none';
    document.getElementById('msg-client-select').style.display = t==='user' ? 'block' : 'none';
  };
  window.updateMsgCount = function() {
    const v = document.getElementById('msg-body').value.length;
    document.getElementById('msg-count').textContent = v;
  };
  async function loadMsgClients() {
    const sel = document.getElementById('msg-client-select');
    sel.innerHTML = '<option value="">Carregando...</option>';
    try {
      const res = await fetch('/owner/messages/clients_today', { headers:{ Accept:'application/json' }});
      const data = await res.json();
      sel.innerHTML = data.length
        ? data.map(c => `<option value="${c.id}">${escapeHtml(c.name)}</option>`).join('')
        : '<option value="">Nenhum cliente hoje</option>';
    } catch(e) { sel.innerHTML = '<option value="">Erro ao carregar</option>'; }
  }
  window.sendOwnerMessage = async function() {
    const body  = document.getElementById('msg-body').value.trim();
    const errEl = document.getElementById('msg-error');
    const btn   = document.getElementById('msg-send-btn');
    const recip = msgTarget==='user' ? document.getElementById('msg-client-select').value : null;
    errEl.style.display = 'none';
    if (!body)  { errEl.textContent='Escreva uma mensagem antes de enviar.'; errEl.style.display='block'; return; }
    if (msgTarget==='user' && !recip) { errEl.textContent='Selecione um cliente.'; errEl.style.display='block'; return; }
    btn.disabled = true; btn.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> Enviando...';
    try {
      const payload = { target: msgTarget, body };
      if (msgTarget==='user') payload.recipient_id = recip;
      const res = await fetch('/owner/messages', {
        method:'POST',
        headers:{ 'X-CSRF-Token':CSRF, 'Content-Type':'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (data.ok) { closeMsgModal(); showToast('Mensagem enviada!', 'success'); }
      else { errEl.textContent = data.error || 'Erro ao enviar.'; errEl.style.display='block'; }
    } catch(e) { errEl.textContent='Erro de conexão.'; errEl.style.display='block'; }
    btn.disabled = false; btn.innerHTML = '<i class="fas fa-paper-plane"></i> Enviar mensagem';
  };
  document.getElementById('msg-modal-close')?.addEventListener('click', closeMsgModal);
  document.getElementById('msg-modal-overlay')?.addEventListener('click', e => {
    if (e.target.id === 'msg-modal-overlay') closeMsgModal();
  });

  // ── LOYALTY CONFIG (modal legado preservado) ────────────────────────
  window.openLoyaltyModal = function() {
    fetch('/owner/loyalty_program', { headers:{ Accept:'application/json' }})
      .then(r => r.json()).then(data => {
        if (data.exists) {
          document.getElementById('loyalty-active').checked = data.active;
          document.getElementById('loyalty-visits').value   = data.visits_required;
          document.getElementById('loyalty-reward').value   = data.reward_description;
        }
        document.getElementById('loyalty-modal-overlay').classList.add('open');
        document.body.style.overflow = 'hidden';
      });
  };
  function closeLoyaltyModal() {
    document.getElementById('loyalty-modal-overlay').classList.remove('open');
    document.body.style.overflow = '';
  }
  window.saveLoyaltyProgram = async function() {
    const btn   = document.getElementById('loyalty-save-btn');
    const errEl = document.getElementById('loyalty-error');
    const visits= parseInt(document.getElementById('loyalty-visits').value);
    const reward= document.getElementById('loyalty-reward').value.trim();
    const active= document.getElementById('loyalty-active').checked;
    errEl.style.display = 'none';
    if (!reward) { errEl.textContent='Descreva a recompensa.'; errEl.style.display='block'; return; }
    if (!visits || visits < 1) { errEl.textContent='Informe o número de visitas (mínimo 1).'; errEl.style.display='block'; return; }
    btn.disabled = true; btn.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> Salvando...';
    try {
      const res = await fetch('/owner/loyalty_program', {
        method:'POST',
        headers:{ 'X-CSRF-Token':CSRF, 'Content-Type':'application/json' },
        body: JSON.stringify({ visits_required: visits, reward_description: reward, active })
      });
      const data = await res.json();
      if (data.ok) { closeLoyaltyModal(); showToast('Programa de fidelidade salvo!', 'success'); loadDashboard(true); }
      else { errEl.textContent = data.error || 'Erro ao salvar.'; errEl.style.display='block'; }
    } catch(e) { errEl.textContent='Erro de conexão.'; errEl.style.display='block'; }
    btn.disabled = false; btn.innerHTML = '<i class="fas fa-check"></i> Salvar configuração';
  };
  document.getElementById('loyalty-modal-close')?.addEventListener('click', closeLoyaltyModal);
  document.getElementById('loyalty-modal-overlay')?.addEventListener('click', e => {
    if (e.target.id === 'loyalty-modal-overlay') closeLoyaltyModal();
  });

  // ── CANCEL MODAL LEGADO (mantido pra compatibilidade) ───────────────
  let _legacyCancelId = null;
  window.openCancelApptModal = function(a) {
    _legacyCancelId = a.id;
    document.getElementById('cancel-appt-desc').textContent =
      `${a.client} · ${a.service} · ${a.time} — O cliente será notificado.`;
    document.getElementById('cancel-appt-reason').value = '';
    document.getElementById('cancel-appt-error').style.display = 'none';
    const btn = document.getElementById('cancel-appt-confirm');
    btn.disabled = false; btn.textContent = 'Confirmar cancelamento';
    document.getElementById('cancel-appt-overlay').classList.add('open');
    document.body.style.overflow = 'hidden';
  };
  window.closeCancelApptModal = function() {
    document.getElementById('cancel-appt-overlay').classList.remove('open');
    document.body.style.overflow = '';
    _legacyCancelId = null;
  };
  document.getElementById('cancel-appt-overlay')?.addEventListener('click', function(e) {
    if (e.target === this) closeCancelApptModal();
  });
  document.getElementById('cancel-appt-confirm')?.addEventListener('click', async function() {
    if (!_legacyCancelId) return;
    const reason = document.getElementById('cancel-appt-reason').value.trim();
    const errEl  = document.getElementById('cancel-appt-error');
    errEl.style.display = 'none';
    this.disabled = true; this.textContent = 'Cancelando...';
    try {
      const res = await fetch(`/owner/checkins/${_legacyCancelId}/cancel`, {
        method:'PATCH',
        headers:{ 'X-CSRF-Token':CSRF, 'Content-Type':'application/json' },
        body: JSON.stringify({ reason })
      });
      const data = await res.json();
      if (data.ok) {
        closeCancelApptModal();
        showToast('Agendamento cancelado.', 'error');
        loadDashboard(true);
      } else {
        errEl.textContent = data.error || 'Erro ao cancelar.';
        errEl.style.display = 'block';
        this.disabled = false; this.textContent = 'Confirmar cancelamento';
      }
    } catch(e) {
      errEl.textContent = 'Erro de conexão.';
      errEl.style.display = 'block';
      this.disabled = false; this.textContent = 'Confirmar cancelamento';
    }
  });

  // ── Boot ─────────────────────────────────────────────────────────────
  document.addEventListener('DOMContentLoaded', () => {
    loadDashboard();
    <% if current_user.owner? %>
    loadApprovals();
    setInterval(loadApprovals, 60_000);
    <% end %>
  });
})();
</script>

<% else %>

<% unless user_signed_in? %>

<%# Landing pública — ver home/_landing. %>
<%= render "home/landing" %>

<% else %>

<%# Home do cliente logado — ver home/_client (porte da HomeScreen do app). %>
<%= render "home/client" %>

<% end %>

<% end %>
