<style>
  .conf-wrap { min-height:100vh; display:flex; align-items:center; justify-content:center; padding:24px; padding-top:80px; background:var(--cream); }

  .conf-card {
    width:100%; max-width:460px;
    background:var(--paper);
    border:1px solid var(--stone);
    border-radius:24px;
    padding:40px 32px;
    text-align:center;
    box-shadow: 0 14px 40px rgba(40,35,28,0.06);
    position:relative; overflow:hidden;
  }
  .conf-card::before { content:''; position:absolute; top:0; left:0; right:0; height:3px; background:linear-gradient(to right, transparent, var(--coral-500), transparent); }

  .state { display:none; }
  .state.active { display:block; }

  .countdown-ring { position:relative; width:128px; height:128px; margin:0 auto 22px; }
  .countdown-ring svg { transform:rotate(-90deg); }
  .ring-track { fill:none; stroke:var(--sand); stroke-width:6; }
  .ring-fill { fill:none; stroke:var(--coral-500); stroke-width:6; stroke-linecap:round; transition:stroke-dashoffset .9s linear; }
  .ring-fill.urgent { stroke:var(--rose-500); }
  .countdown-num {
    position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center;
    font-family:'Space Grotesk', sans-serif; font-size:36px; font-weight:700; color:var(--ink); line-height:1;
  }
  .countdown-label {
    font-family:'JetBrains Mono', monospace;
    font-size:10px; color:var(--ash); letter-spacing:1.6px; text-transform:uppercase; margin-top:4px;
  }

  .conf-title { font-family:'Space Grotesk', sans-serif; font-weight:700; font-size:24px; color:var(--ink); margin:0 0 8px; letter-spacing:-0.3px; }
  .conf-sub { font-size:14.5px; color:var(--graphite); line-height:1.6; margin:0 0 22px; }

  .appt-summary { background:var(--cream); border:1px solid var(--stone); border-radius:14px; padding:14px 18px; text-align:left; margin-bottom:20px; }
  .summ-row { display:flex; justify-content:space-between; align-items:center; margin-bottom:8px; gap:12px; }
  .summ-row:last-child { margin-bottom:0; }
  .summ-label { font-family:'JetBrains Mono', monospace; font-size:10.5px; color:var(--ash); letter-spacing:1.4px; text-transform:uppercase; }
  .summ-val { font-size:13.5px; color:var(--ink); font-weight:500; text-align:right; }
  .summ-val.coral { color:var(--coral-700); font-weight:700; }
  .summ-val.small { font-size:12.5px; color:var(--graphite); }

  .pulse-dots { display:flex; justify-content:center; gap:8px; margin-top:12px; }
  .pulse-dot { width:8px; height:8px; border-radius:50%; background:var(--coral-500); animation:dotPulse 1.4s ease-in-out infinite; }
  .pulse-dot:nth-child(2) { animation-delay:.2s; background:var(--coral-300); }
  .pulse-dot:nth-child(3) { animation-delay:.4s; background:var(--coral-100); }
  @keyframes dotPulse { 0%,80%,100%{transform:scale(.7);opacity:.4} 40%{transform:scale(1);opacity:1} }

  .state-confirmed .icon-circle { width:84px; height:84px; border-radius:50%; background:var(--coral-50); border:2px solid var(--coral-500); display:flex; align-items:center; justify-content:center; margin:0 auto 22px; font-size:30px; color:var(--coral-700); }
  .state-rejected .icon-circle  { width:84px; height:84px; border-radius:50%; background:#fdecec; border:2px solid var(--rose-500); display:flex; align-items:center; justify-content:center; margin:0 auto 22px; font-size:30px; color:var(--rose-500); }
</style>

<div class="conf-wrap">
  <div class="conf-card">

    <div class="state state-waiting <%= @appointment.pending_acceptance? ? 'active' : '' %>" id="state-waiting">

      <div class="countdown-ring">
        <svg width="128" height="128" viewBox="0 0 120 120">
          <circle class="ring-track" cx="60" cy="60" r="54"/>
          <circle class="ring-fill" id="ring-fill" cx="60" cy="60" r="54"
            stroke-dasharray="339.3"
            stroke-dashoffset="0"/>
        </svg>
        <div class="countdown-num">
          <span id="countdown-val">3:00</span>
          <span class="countdown-label">restantes</span>
        </div>
      </div>

      <h2 class="conf-title">Aguardando confirmação</h2>
      <p class="conf-sub">O lava-rápido tem 3 minutos para aceitar sua reserva. Se não confirmar, você <strong style="color:var(--ink);">não será cobrado</strong>.</p>

      <div class="appt-summary">
        <div class="summ-row">
          <span class="summ-label">Local</span>
          <span class="summ-val"><%= @appointment.car_wash.name %></span>
        </div>
        <div class="summ-row">
          <span class="summ-label">Serviço</span>
          <span class="summ-val"><%= @appointment.service.title %></span>
        </div>
        <div class="summ-row">
          <span class="summ-label">Horário</span>
          <span class="summ-val"><%= @appointment.scheduled_at.strftime("%H:%M") %> — hoje</span>
        </div>
        <div class="summ-row">
          <span class="summ-label">Pago agora (35%)</span>
          <span class="summ-val coral">R$ <%= number_with_precision(@appointment.prepayment_amount, precision: 2) %></span>
        </div>
        <div class="summ-row">
          <span class="summ-label">Restante no local</span>
          <span class="summ-val small">R$ <%= number_with_precision(@appointment.effective_price - @appointment.prepayment_amount.to_f, precision: 2) %></span>
        </div>
      </div>

      <div class="pulse-dots">
        <div class="pulse-dot"></div>
        <div class="pulse-dot"></div>
        <div class="pulse-dot"></div>
      </div>

    </div>

    <div class="state state-confirmed <%= @appointment.confirmed? ? 'active' : '' %>" id="state-confirmed">
      <div class="icon-circle"><i class="fas fa-check"></i></div>
      <h2 class="conf-title">Reserva Confirmada!</h2>
      <p class="conf-sub">O lava-rápido aceitou. Vá agora — seu horário está garantido.</p>
      <div class="appt-summary">
        <div class="summ-row">
          <span class="summ-label">Local</span>
          <span class="summ-val"><%= @appointment.car_wash.name %></span>
        </div>
        <div class="summ-row">
          <span class="summ-label">Horário</span>
          <span class="summ-val coral"><%= @appointment.scheduled_at.strftime("%H:%M") %></span>
        </div>
        <div class="summ-row">
          <span class="summ-label">Pague no local</span>
          <span class="summ-val">R$ <%= number_with_precision(@appointment.effective_price - @appointment.prepayment_amount.to_f, precision: 2) %></span>
        </div>
      </div>
      <%= link_to car_washes_path, class: "loov-btn-primary" do %>
        <i class="fas fa-car"></i> Ok, estou indo!
      <% end %>
    </div>

    <div class="state state-rejected <%= ((@appointment.rejected? || @appointment.cancelled?) && !@appointment.confirmed?) ? 'active' : '' %>" id="state-rejected">
      <div class="icon-circle"><i class="fas fa-times"></i></div>
      <h2 class="conf-title">Reserva não confirmada</h2>
      <p class="conf-sub">O lava-rápido não confirmou a tempo ou recusou. <strong style="color:var(--ink);">Nenhum valor foi cobrado</strong> no seu cartão.</p>
      <%= link_to disponivel_index_path, class: "loov-btn-primary" do %>
        <i class="fas fa-rotate-left"></i> Buscar outro horário
      <% end %>
    </div>

  </div>
</div>

<script>
const APPOINTMENT_ID  = <%= @appointment.id %>;
const SECONDS_LEFT    = <%= @appointment.seconds_until_expiry || 0 %>;
const CIRCUMFERENCE   = 339.3;

let secondsLeft = SECONDS_LEFT;
const ringFill  = document.getElementById('ring-fill');
const countdownEl = document.getElementById('countdown-val');

function updateRing(seconds) {
  const pct    = seconds / 180;
  const offset = CIRCUMFERENCE * (1 - pct);
  ringFill.style.strokeDashoffset = offset;
  if (seconds <= 30) {
    ringFill.classList.add('urgent');
  }
}

function formatTime(s) {
  const m = Math.floor(s / 60);
  const sec = s % 60;
  return m + ':' + String(sec).padStart(2,'0');
}

if (document.getElementById('state-waiting').classList.contains('active')) {
  updateRing(secondsLeft);
  countdownEl.textContent = formatTime(secondsLeft);

  const timer = setInterval(() => {
    secondsLeft--;
    if (secondsLeft < 0) secondsLeft = 0;
    updateRing(secondsLeft);
    countdownEl.textContent = formatTime(secondsLeft);
  }, 1000);

  const poll = setInterval(() => {
    fetch('/disponivel/<%= @appointment.id %>', {
      headers: { Accept: 'application/json' }
    })
    .then(r => r.json())
    .then(data => {
      if (data.status === 'confirmed') {
        clearInterval(timer);
        clearInterval(poll);
        showState('confirmed');
      } else if (['cancelled', 'rejected'].includes(data.status)) {
        clearInterval(timer);
        clearInterval(poll);
        showState('rejected');
      }
    })
    .catch(() => {});
  }, 4000);
}

function showState(name) {
  document.querySelectorAll('.state').forEach(s => s.classList.remove('active'));
  document.getElementById('state-' + name).classList.add('active');
}

</script>
