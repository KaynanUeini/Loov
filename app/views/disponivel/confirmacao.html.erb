<style>
  .conf-wrap { min-height:100vh; display:flex; align-items:center; justify-content:center; padding:24px; padding-top:80px; background:var(--cream); }

  .conf-card {
    width:100%; max-width:460px;
    background:var(--paper);
    border:1px solid var(--stone);
    border-radius:24px;
    padding:40px 32px;
    text-align:center;
    box-shadow: 0 14px 40px rgba(40,35,28,0.06);
    position:relative; overflow:hidden;
  }
  .conf-card::before { content:''; position:absolute; top:0; left:0; right:0; height:3px; background:linear-gradient(to right, transparent, var(--coral-500), transparent); }

  .state { display:none; }
  .state.active { display:block; }

  .countdown-ring { position:relative; width:128px; height:128px; margin:0 auto 22px; }
  .countdown-ring svg { transform:rotate(-90deg); }
  .ring-track { fill:none; stroke:var(--sand); stroke-width:6; }
  .ring-fill { fill:none; stroke:var(--coral-500); stroke-width:6; stroke-linecap:round; transition:stroke-dashoffset .9s linear; }
  .ring-fill.urgent { stroke:var(--rose-500); }
  .countdown-num {
    position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center;
    font-family:'Space Grotesk', sans-serif; font-size:36px; font-weight:700; color:var(--ink); line-height:1;
  }
  .countdown-label {
    font-family:'JetBrains Mono', monospace;
    font-size:10px; color:var(--ash); letter-spacing:1.6px; text-transform:uppercase; margin-top:4px;
  }

  .conf-title { font-family:'Space Grotesk', sans-serif; font-weight:700; font-size:24px; color:var(--ink); margin:0 0 8px; letter-spacing:-0.3px; }
  .conf-sub { font-size:14.5px; color:var(--graphite); line-height:1.6; margin:0 0 22px; }

  .appt-summary { background:var(--cream); border:1px solid var(--stone); border-radius:14px; padding:14px 18px; text-align:left; margin-bottom:20px; }
  .summ-row { display:flex; justify-content:space-between; align-items:center; margin-bottom:8px; gap:12px; }
  .summ-row:last-child { margin-bottom:0; }
  .summ-label { font-family:'JetBrains Mono', monospace; font-size:10.5px; color:var(--ash); letter-spacing:1.4px; text-transform:uppercase; }
  .summ-val { font-size:13.5px; color:var(--ink); font-weight:500; text-align:right; }
  .summ-val.coral { color:var(--coral-700); font-weight:700; }
  .summ-val.small { font-size:12.5px; color:var(--graphite); }

  .pulse-dots { display:flex; justify-content:center; gap:8px; margin-top:12px; }
  .pulse-dot { width:8px; height:8px; border-radius:50%; background:var(--coral-500); animation:dotPulse 1.4s ease-in-out infinite; }
  .pulse-dot:nth-child(2) { animation-delay:.2s; background:var(--coral-300); }
  .pulse-dot:nth-child(3) { animation-delay:.4s; background:var(--coral-100); }
  @keyframes dotPulse { 0%,80%,100%{transform:scale(.7);opacity:.4} 40%{transform:scale(1);opacity:1} }

  .state-confirmed .icon-circle { width:84px; height:84px; border-radius:50%; background:var(--coral-50); border:2px solid var(--coral-500); display:flex; align-items:center; justify-content:center; margin:0 auto 22px; font-size:30px; color:var(--coral-700); }
  .state-rejected .icon-circle  { width:84px; height:84px; border-radius:50%; background:#fdecec; border:2px solid var(--rose-500); display:flex; align-items:center; justify-content:center; margin:0 auto 22px; font-size:30px; color:var(--rose-500); }

  /* ── Brick Racing — mesma arte do app ────────────────────────────────── */
  .brick-section { margin-top:20px; padding-top:20px; border-top:1px solid var(--stone); }
  .brick-section-label {
    font-family:'JetBrains Mono', monospace;
    font-size:10.5px; color:var(--ash); letter-spacing:1.6px;
    text-transform:uppercase; margin-bottom:12px; text-align:left;
  }
  .brick-section-label i { color:var(--coral-500); margin-right:5px; }

  .brick-wrap { display:flex; flex-direction:column; align-items:center; }
  .brick-board {
    background:var(--sand);
    border-radius:16px;
    overflow:hidden;
    position:relative;
    box-shadow: inset 0 0 0 1px var(--stone);
    touch-action: none;
  }
  .brick-board canvas { display:block; }

  .brick-controls {
    display:flex; gap:10px; margin-top:12px; width:100%;
  }
  .brick-ctrl-btn {
    flex:1; height:48px;
    background:var(--paper); border:1px solid var(--stone);
    border-radius:14px;
    display:flex; align-items:center; justify-content:center;
    color:var(--ink); font-size:24px;
    cursor:pointer; transition: background .12s, transform .12s;
    user-select:none; -webkit-user-select:none;
  }
  .brick-ctrl-btn:hover  { background:var(--sand); }
  .brick-ctrl-btn:active { transform:scale(0.96); background:var(--coral-50); border-color:var(--coral-300); }
  .brick-ctrl-btn.disabled { opacity:.4; pointer-events:none; }
</style>

<div class="conf-wrap">
  <div class="conf-card">

    <div class="state state-waiting <%= @appointment.pending_acceptance? ? 'active' : '' %>" id="state-waiting">

      <div class="countdown-ring">
        <svg width="128" height="128" viewBox="0 0 120 120">
          <circle class="ring-track" cx="60" cy="60" r="54"/>
          <circle class="ring-fill" id="ring-fill" cx="60" cy="60" r="54"
            stroke-dasharray="339.3"
            stroke-dashoffset="0"/>
        </svg>
        <div class="countdown-num">
          <span id="countdown-val">3:00</span>
          <span class="countdown-label">restantes</span>
        </div>
      </div>

      <h2 class="conf-title">Aguardando confirmação</h2>
      <p class="conf-sub">O lava-rápido tem 3 minutos para aceitar sua reserva. Se não confirmar, você <strong style="color:var(--ink);">não será cobrado</strong>.</p>

      <div class="appt-summary">
        <div class="summ-row">
          <span class="summ-label">Local</span>
          <span class="summ-val"><%= @appointment.car_wash.name %></span>
        </div>
        <div class="summ-row">
          <span class="summ-label">Serviço</span>
          <span class="summ-val"><%= @appointment.service.title %></span>
        </div>
        <div class="summ-row">
          <span class="summ-label">Horário</span>
          <span class="summ-val"><%= @appointment.scheduled_at.strftime("%H:%M") %> — hoje</span>
        </div>
        <div class="summ-row">
          <span class="summ-label">Pago agora (35%)</span>
          <span class="summ-val coral">R$ <%= number_with_precision(@appointment.prepayment_amount, precision: 2) %></span>
        </div>
        <div class="summ-row">
          <span class="summ-label">Restante no local</span>
          <span class="summ-val small">R$ <%= number_with_precision(@appointment.effective_price - @appointment.prepayment_amount.to_f, precision: 2) %></span>
        </div>
      </div>

      <div class="pulse-dots">
        <div class="pulse-dot"></div>
        <div class="pulse-dot"></div>
        <div class="pulse-dot"></div>
      </div>

      <%# ── Brick Racing — passa o tempo enquanto espera ─ %>
      <div class="brick-section">
        <div class="brick-section-label">
          <i class="fas fa-gamepad"></i>Aproveite a espera — Brick Racing
        </div>
        <div class="brick-wrap" id="brick-wrap">
          <div class="brick-board" id="brick-board">
            <canvas id="brick-canvas"></canvas>
          </div>
          <div class="brick-controls">
            <button type="button" class="brick-ctrl-btn" id="brick-left" aria-label="Esquerda">
              <i class="fas fa-chevron-left"></i>
            </button>
            <button type="button" class="brick-ctrl-btn" id="brick-right" aria-label="Direita">
              <i class="fas fa-chevron-right"></i>
            </button>
          </div>
        </div>
      </div>

    </div>

    <div class="state state-confirmed <%= @appointment.confirmed? ? 'active' : '' %>" id="state-confirmed">
      <div class="icon-circle"><i class="fas fa-check"></i></div>
      <h2 class="conf-title">Reserva Confirmada!</h2>
      <p class="conf-sub">O lava-rápido aceitou. Vá agora — seu horário está garantido.</p>
      <div class="appt-summary">
        <div class="summ-row">
          <span class="summ-label">Local</span>
          <span class="summ-val"><%= @appointment.car_wash.name %></span>
        </div>
        <div class="summ-row">
          <span class="summ-label">Horário</span>
          <span class="summ-val coral"><%= @appointment.scheduled_at.strftime("%H:%M") %></span>
        </div>
        <div class="summ-row">
          <span class="summ-label">Pague no local</span>
          <span class="summ-val">R$ <%= number_with_precision(@appointment.effective_price - @appointment.prepayment_amount.to_f, precision: 2) %></span>
        </div>
      </div>
      <%= link_to car_washes_path, class: "loov-btn-primary" do %>
        <i class="fas fa-car"></i> Ok, estou indo!
      <% end %>
    </div>

    <div class="state state-rejected <%= ((@appointment.rejected? || @appointment.cancelled?) && !@appointment.confirmed?) ? 'active' : '' %>" id="state-rejected">
      <div class="icon-circle"><i class="fas fa-times"></i></div>
      <h2 class="conf-title">Reserva não confirmada</h2>
      <p class="conf-sub">O lava-rápido não confirmou a tempo ou recusou. <strong style="color:var(--ink);">Nenhum valor foi cobrado</strong> no seu cartão.</p>
      <%= link_to disponivel_index_path, class: "loov-btn-primary" do %>
        <i class="fas fa-rotate-left"></i> Buscar outro horário
      <% end %>
    </div>

  </div>
</div>

<script>
const APPOINTMENT_ID  = <%= @appointment.id %>;
const SECONDS_LEFT    = <%= @appointment.seconds_until_expiry || 0 %>;
const CIRCUMFERENCE   = 339.3;

let secondsLeft = SECONDS_LEFT;
const ringFill  = document.getElementById('ring-fill');
const countdownEl = document.getElementById('countdown-val');

function updateRing(seconds) {
  const pct    = seconds / 180;
  const offset = CIRCUMFERENCE * (1 - pct);
  ringFill.style.strokeDashoffset = offset;
  if (seconds <= 30) {
    ringFill.classList.add('urgent');
  }
}

function formatTime(s) {
  const m = Math.floor(s / 60);
  const sec = s % 60;
  return m + ':' + String(sec).padStart(2,'0');
}

if (document.getElementById('state-waiting').classList.contains('active')) {
  updateRing(secondsLeft);
  countdownEl.textContent = formatTime(secondsLeft);

  const timer = setInterval(() => {
    secondsLeft--;
    if (secondsLeft < 0) secondsLeft = 0;
    updateRing(secondsLeft);
    countdownEl.textContent = formatTime(secondsLeft);
  }, 1000);

  const poll = setInterval(() => {
    fetch('/disponivel/<%= @appointment.id %>', {
      headers: { Accept: 'application/json' }
    })
    .then(r => r.json())
    .then(data => {
      if (data.status === 'confirmed') {
        clearInterval(timer);
        clearInterval(poll);
        showState('confirmed');
      } else if (['cancelled', 'rejected'].includes(data.status)) {
        clearInterval(timer);
        clearInterval(poll);
        showState('rejected');
      }
    })
    .catch(() => {});
  }, 4000);
}

function showState(name) {
  document.querySelectorAll('.state').forEach(s => s.classList.remove('active'));
  document.getElementById('state-' + name).classList.add('active');

  // Para o jogo se sair do estado de espera
  if (name !== 'waiting' && window.__brickGame) {
    window.__brickGame.stop();
  }
}

// ── Brick Racing — porte 1:1 do componente do app ───────────────────────────
(function() {
  const canvas = document.getElementById('brick-canvas');
  if (!canvas) return;

  const COLS         = 11;
  const ROWS         = 22;
  const LANES        = 5;
  const LANE_X_LEFT  = [0, 2, 4, 6, 8];
  const CAR_W_CELLS  = 3;
  const CAR_H_CELLS  = 4;
  const PLAYER_TOP   = ROWS - CAR_H_CELLS - 1;

  const CAR_PIXELS = [
    [0, 1],
    [1, 0], [1, 1], [1, 2],
    [2, 1],
    [3, 0], [3, 1], [3, 2],
  ];

  // Tamanho responsivo — máximo 22px por célula, mas reduz se a tela for estreita
  const board     = document.getElementById('brick-board');
  const wrap      = document.getElementById('brick-wrap');
  const maxBoardW = Math.min(22 * COLS, (wrap.clientWidth || 360));
  const CELL      = Math.floor(maxBoardW / COLS);
  const BOARD_W   = CELL * COLS;
  const BOARD_H   = CELL * ROWS;

  const dpr = window.devicePixelRatio || 1;
  canvas.width  = BOARD_W * dpr;
  canvas.height = BOARD_H * dpr;
  canvas.style.width  = BOARD_W + 'px';
  canvas.style.height = BOARD_H + 'px';
  board.style.width   = BOARD_W + 'px';
  board.style.height  = BOARD_H + 'px';

  const ctx = canvas.getContext('2d');
  ctx.scale(dpr, dpr);

  // Mecânica
  const TICK_MS                  = 55;
  const SPAWN_INTERVAL_MIN_MS    = 400;
  const MAX_LANE_JUMP            = 2;
  const DIFFICULTY_INTERVAL_MS   = 2500;
  const INITIAL_SPEED_CELLS_TICK = 0.58;
  const SPEED_MAX_CELLS_TICK     = 1.95;
  const SPEED_STEP_PER_LEVEL     = 0.12;
  const INITIAL_GAP_CELLS        = 12;
  const GAP_MIN_CELLS            = 8;
  const GAP_STEP_PER_LEVEL       = 1;
  const MIN_REACTION_SECONDS     = 0.78;
  const FIRST_SPAWN_GRACE_MS     = -800;

  const BOARD_BG       = '#f1eee6';
  const CELL_GHOST     = 'rgba(40,35,28,0.05)';
  const PLAYER_COLOR   = '#dd7852';
  const OBSTACLE_COLOR = '#28231c';

  const BEST_KEY = 'loov_brick_best';

  let lane          = Math.floor(LANES / 2);
  let obstacles     = [];
  let score         = 0;
  let best          = parseInt(localStorage.getItem(BEST_KEY) || '0', 10);
  let running       = false;
  let gameOver      = false;
  let speed         = INITIAL_SPEED_CELLS_TICK;
  let gap           = INITIAL_GAP_CELLS;
  let level         = 0;
  let spawnTimer    = FIRST_SPAWN_GRACE_MS;
  let nextId        = 0;
  let lastLane      = -1;
  let tickInterval  = null;
  let diffInterval  = null;

  function start() {
    obstacles  = [];
    score      = 0;
    lane       = Math.floor(LANES / 2);
    speed      = INITIAL_SPEED_CELLS_TICK;
    gap        = INITIAL_GAP_CELLS;
    level      = 0;
    spawnTimer = FIRST_SPAWN_GRACE_MS;
    nextId     = 0;
    lastLane   = -1;
    gameOver   = false;
    running    = true;
    runLoop();
  }

  function stop(crashed) {
    running = false;
    if (tickInterval) clearInterval(tickInterval);
    if (diffInterval) clearInterval(diffInterval);
    if (crashed) {
      gameOver = true;
      if (score > best) {
        best = score;
        try { localStorage.setItem(BEST_KEY, String(best)); } catch (e) {}
      }
      draw();
    }
  }

  function move(delta) {
    if (!running) return;
    lane = Math.max(0, Math.min(LANES - 1, lane + delta));
  }

  function pickNextLane() {
    if (lastLane < 0) {
      const l = Math.floor(Math.random() * LANES);
      lastLane = l;
      return l;
    }
    const candidates = [];
    for (let l = 0; l < LANES; l++) {
      if (l === lastLane) continue;
      if (Math.abs(l - lastLane) <= MAX_LANE_JUMP) candidates.push(l);
    }
    const l = candidates[Math.floor(Math.random() * candidates.length)];
    lastLane = l;
    return l;
  }

  function runLoop() {
    diffInterval = setInterval(() => {
      level += 1;
      speed = Math.min(SPEED_MAX_CELLS_TICK, speed + SPEED_STEP_PER_LEVEL);
      gap   = Math.max(GAP_MIN_CELLS, gap - GAP_STEP_PER_LEVEL);
    }, DIFFICULTY_INTERVAL_MS);

    tickInterval = setInterval(() => {
      // Move obstáculos
      obstacles = obstacles
        .map(o => ({ ...o, y: o.y + speed }))
        .filter(o => o.y < ROWS + CAR_H_CELLS);

      // Spawn
      spawnTimer += TICK_MS;
      if (spawnTimer >= SPAWN_INTERVAL_MIN_MS) {
        const topMostY = obstacles.length > 0
          ? Math.min(...obstacles.map(o => o.y))
          : Infinity;
        const currentGap   = topMostY + CAR_H_CELLS;
        const cellsPerSec  = speed * (1000 / TICK_MS);
        const safetyFloor  = Math.ceil(cellsPerSec * MIN_REACTION_SECONDS);
        const requiredGap  = Math.max(gap, safetyFloor);
        if (currentGap >= requiredGap) {
          spawnTimer = 0;
          obstacles.push({
            id:   nextId++,
            lane: pickNextLane(),
            y:    -CAR_H_CELLS,
          });
        }
      }

      // Colisão
      const pl = LANE_X_LEFT[lane];
      const pt = PLAYER_TOP;
      let crashed = false;
      for (const o of obstacles) {
        const ol = LANE_X_LEFT[o.lane];
        const ot = o.y;
        const overlap =
          pl < ol + CAR_W_CELLS &&
          ol < pl + CAR_W_CELLS &&
          pt < ot + CAR_H_CELLS &&
          ot < pt + CAR_H_CELLS;
        if (overlap) { crashed = true; break; }
      }

      score += 1;
      draw();

      if (crashed) {
        setTimeout(() => stop(true), 0);
      }
    }, TICK_MS);
  }

  function drawCar(leftCells, topCellsFloat, color) {
    ctx.fillStyle = color;
    for (const [dr, dc] of CAR_PIXELS) {
      const x = (leftCells + dc) * CELL + 1.5;
      const y = (topCellsFloat + dr) * CELL + 1.5;
      const s = CELL - 3;
      ctx.fillRect(x, y, s, s);
    }
  }

  function draw() {
    // background
    ctx.fillStyle = BOARD_BG;
    ctx.fillRect(0, 0, BOARD_W, BOARD_H);

    // ghost cells
    ctx.fillStyle = CELL_GHOST;
    for (let r = 0; r < ROWS; r++) {
      for (let c = 0; c < COLS; c++) {
        ctx.fillRect(c * CELL + 1.5, r * CELL + 1.5, CELL - 3, CELL - 3);
      }
    }

    // obstáculos
    for (const o of obstacles) {
      drawCar(LANE_X_LEFT[o.lane], o.y, OBSTACLE_COLOR);
    }

    // player
    drawCar(LANE_X_LEFT[lane], PLAYER_TOP, PLAYER_COLOR);

    // score pill (top-right)
    drawScorePill(BOARD_W - 8, 8, String(score).padStart(4, '0'), null);
    // best pill (top-left)
    drawScorePill(8, 8, String(best).padStart(4, '0'), 'BEST', true);

    // game over overlay
    if (gameOver) {
      ctx.fillStyle = 'rgba(241,238,230,0.92)';
      ctx.fillRect(0, 0, BOARD_W, BOARD_H);
      ctx.textAlign = 'center';
      ctx.fillStyle = '#c85050';
      ctx.font = "700 26px 'Space Grotesk', sans-serif";
      ctx.fillText('FIM', BOARD_W / 2, BOARD_H / 2 - 40);
      ctx.fillStyle = '#28231c';
      ctx.font = "500 24px 'JetBrains Mono', monospace";
      ctx.fillText(String(score).padStart(4, '0'), BOARD_W / 2, BOARD_H / 2 - 10);
      ctx.fillStyle = '#dd7852';
      ctx.font = "500 11px 'JetBrains Mono', monospace";
      const bestLine = (score > 0 && score >= best)
        ? '✦ NOVO RECORDE ✦'
        : 'BEST ' + String(best).padStart(4, '0');
      ctx.fillText(bestLine, BOARD_W / 2, BOARD_H / 2 + 10);

      // botão "JOGAR DE NOVO"
      const btnW = 160, btnH = 36;
      const btnX = (BOARD_W - btnW) / 2;
      const btnY = BOARD_H / 2 + 30;
      ctx.fillStyle = '#dd7852';
      roundRect(ctx, btnX, btnY, btnW, btnH, 12);
      ctx.fill();
      ctx.fillStyle = '#fafaf6';
      ctx.font = "600 11px 'JetBrains Mono', monospace";
      ctx.fillText('JOGAR DE NOVO', BOARD_W / 2, btnY + 22);
      window.__brickRestart = { x: btnX, y: btnY, w: btnW, h: btnH };
    }
  }

  function drawScorePill(x, y, text, label, alignLeft) {
    const padX = 8, padY = 4;
    ctx.font = "500 11px 'JetBrains Mono', monospace";
    const textW = ctx.measureText(text).width;
    let labelW = 0;
    if (label) {
      ctx.font = "500 9px 'JetBrains Mono', monospace";
      labelW = ctx.measureText(label).width + 4;
    }
    const w = textW + labelW + padX * 2;
    const h = 18;
    const px = alignLeft ? x : x - w;
    ctx.fillStyle = 'rgba(40,35,28,0.06)';
    roundRect(ctx, px, y, w, h, 6);
    ctx.fill();
    let cursorX = px + padX;
    if (label) {
      ctx.fillStyle = '#dd7852';
      ctx.font = "500 9px 'JetBrains Mono', monospace";
      ctx.textAlign = 'left'; ctx.textBaseline = 'middle';
      ctx.fillText(label, cursorX, y + h / 2);
      cursorX += labelW;
    }
    ctx.fillStyle = '#575148';
    ctx.font = "500 11px 'JetBrains Mono', monospace";
    ctx.textAlign = 'left'; ctx.textBaseline = 'middle';
    ctx.fillText(text, cursorX, y + h / 2);
    ctx.textAlign = 'center'; ctx.textBaseline = 'alphabetic';
  }

  function roundRect(ctx, x, y, w, h, r) {
    ctx.beginPath();
    ctx.moveTo(x + r, y);
    ctx.arcTo(x + w, y,     x + w, y + h, r);
    ctx.arcTo(x + w, y + h, x,     y + h, r);
    ctx.arcTo(x,     y + h, x,     y,     r);
    ctx.arcTo(x,     y,     x + w, y,     r);
    ctx.closePath();
  }

  // ── Inputs ─────────────────────────────────────────
  document.getElementById('brick-left').addEventListener('click',  () => move(-1));
  document.getElementById('brick-right').addEventListener('click', () => move(1));

  document.addEventListener('keydown', e => {
    if (!running) return;
    if (e.key === 'ArrowLeft')  { move(-1); e.preventDefault(); }
    if (e.key === 'ArrowRight') { move(1);  e.preventDefault(); }
  });

  // Touch swipe simples no canvas
  let touchStartX = null;
  canvas.addEventListener('touchstart', e => {
    touchStartX = e.touches[0].clientX;
  }, { passive: true });
  canvas.addEventListener('touchend', e => {
    if (touchStartX == null) return;
    const dx = e.changedTouches[0].clientX - touchStartX;
    if (Math.abs(dx) > 24) {
      move(dx > 0 ? 1 : -1);
    }
    touchStartX = null;
  }, { passive: true });

  // Click no canvas reinicia se estiver em game over
  canvas.addEventListener('click', e => {
    if (!gameOver || !window.__brickRestart) return;
    const rect = canvas.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const y = e.clientY - rect.top;
    const r = window.__brickRestart;
    if (x >= r.x && x <= r.x + r.w && y >= r.y && y <= r.y + r.h) {
      start();
    }
  });

  // Expor pra showState parar quando sair de waiting
  window.__brickGame = { start, stop };

  // Auto-start se estamos no estado waiting
  if (document.getElementById('state-waiting').classList.contains('active')) {
    start();
  } else {
    draw();
  }
})();
</script>
