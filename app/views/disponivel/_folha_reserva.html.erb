<%#
  Folha de reserva do Last Minute ("Reservar em"): serviço, divisão do
  pagamento (agora no cartão / na chegada), vale, cartão e o pedido em si,
  com a confirmação do banco (3DS). Uma só, usada na lista do Last Minute e
  na página do lava-rápido (o horário com raio): duas cópias do checkout do
  pagamento acabariam aceitando coisas diferentes.

  window.LoovReservaLM.abrir(item, opcoes)
    item:    um item do GET /disponivel ({ car_wash, services, slots })
    opcoes:  origem       elemento de onde a folha cresce (e pra onde encolhe)
             servico      id do serviço já escolhido
             voltar       url pra onde o cadastro de cartão devolve
             toast(t, tipo)
             aoReservar(appt)  pedido com o dono: a página leva pra espera
             aoFalhar()        nada foi cobrado (a página pode recarregar)
%>
<style>
  #dp-sheet-bg *, #dp-sheet-bg *::before, #dp-sheet-bg *::after { box-sizing: border-box; }
  #dp-sheet-bg button { font-family: inherit; line-height: normal; cursor: pointer; }
  #dp-sheet-bg svg.feather { display: block; }
  .dp-offrow { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin: 0 0 10px; padding: 12px 14px; border-radius: 14px; background: var(--sand); font-size: 13.5px; color: var(--ink); }
  .dp-offrow span { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; }
  .dp-offrow b { font-family: 'Space Grotesk', sans-serif; font-weight: 600; color: var(--ink); white-space: nowrap; }
  .dp-spin { width: 22px; height: 22px; border-radius: 50%; border: 2.5px solid rgba(221,120,82,.25); border-top-color: var(--coral-500); animation: dp-rot .8s linear infinite; }
  @keyframes dp-rot { to { transform: rotate(360deg); } }
  /* ── Folha "Reservar em" ──────────────────────────────────────────────── */
  .dp-sheet-bg { position: fixed; inset: 0; z-index: 200; background: rgba(25,20,15,.55); display: flex; align-items: flex-end; justify-content: center; opacity: 0; transition: opacity .2s ease; }
  .dp-sheet-bg.is-open { opacity: 1; }
  .dp-sheet-bg[hidden] { display: none; } /* display:flex anula o hidden; sem isto a camada invisível bloquearia a página */
  /* Coluna: topo escuro e botão fixos, o miolo rola. Em tela baixa (abaixo)
     a folha inteira rola, senão o miolo sumiria espremido entre os dois. */
  .dp-sheet { width: 100%; max-height: 85vh; max-height: 85dvh; display: flex; flex-direction: column; overflow: hidden; background: var(--paper); color: var(--ink); border-radius: 28px 28px 0 0; padding: 0 20px calc(20px + env(safe-area-inset-bottom, 0px)); transform: translateY(100%); transition: transform .32s cubic-bezier(.2,.8,.2,1); }
  .dp-sheet-bg.is-open .dp-sheet { transform: none; }
  /* Topo no escuro da aba Last Minute: selo, a hora gigante da vaga e o
     quanto falta pra ela começar. É o que diz que esta reserva é a vaga de
     agora, não um agendamento. Sangra até a borda da folha. */
  .dp-band { flex-shrink: 0; margin: 0 -20px; padding: 0 20px 18px; background: var(--obsidian, #1a1612); color: var(--cream); border-radius: 28px 28px 0 0; }
  .dp-handle { width: 40px; height: 4px; border-radius: 2px; background: rgba(250,250,246,.25); margin: 0 auto; position: relative; top: 10px; }
  .dp-band-top { display: flex; align-items: center; justify-content: space-between; padding-top: 18px; }
  .dp-selo { display: inline-flex; align-items: center; gap: 5px; padding: 5px 12px; border-radius: 100px; background: var(--coral-500); color: var(--cream); font-size: 12px; font-weight: 600; }
  .dp-x { flex-shrink: 0; width: 40px; height: 40px; margin-right: -8px; border-radius: 50%; border: 0; background: transparent; color: var(--cream); display: flex; align-items: center; justify-content: center; }
  .dp-x:hover { background: rgba(250,250,246,.1); }
  /* line-height acima da fonte: igual ou menor cortava o topo dos números. */
  .dp-hora { margin: 6px 0 0 -3px; font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 84px; line-height: 92px; letter-spacing: -5px; font-variant-numeric: tabular-nums; color: var(--cream); }
  .dp-vivo { display: flex; align-items: center; gap: 8px; margin-top: 2px; font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 1.4px; color: var(--coral-300, #e8a48a); }
  .dp-vivo i { flex-shrink: 0; width: 7px; height: 7px; border-radius: 50%; background: var(--coral-500); animation: dp-pulso 1.4s ease-in-out infinite; }
  @keyframes dp-pulso { 50% { opacity: .25; } }
  .dp-shop-row { flex-shrink: 0; display: flex; align-items: center; gap: 12px; padding: 12px 0; }
  .dp-shop-row > div { flex: 1; min-width: 0; }
  .dp-sh-name { margin: 0 !important; font-family: 'Space Grotesk', sans-serif !important; font-weight: 600; font-size: 22px; line-height: 26px; letter-spacing: -0.5px; color: var(--ink) !important; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .dp-sh-addr { margin-top: 4px; font-size: 13px; line-height: 17px; color: var(--graphite); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .dp-dist { flex-shrink: 0; font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 1.6px; color: var(--ink); }
  .dp-rule { flex-shrink: 0; height: 2px; background: var(--ink); }
  .dp-mid { flex: 1 1 auto; min-height: 0; overflow: auto; overscroll-behavior: contain; padding-bottom: 2px; }
  .dp-foot { flex-shrink: 0; }
  .dp-sh-label { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--ash); margin: 20px 0 10px; }
  /* Lista de serviços: linhas grandes, preço em tinta. Coral fica pro topo e
     pro botão de reservar (um acento só). */
  .dp-svcs { list-style: none; margin: 0; padding: 0; }
  .dp-svc-row { width: 100%; display: flex; align-items: center; gap: 12px; padding: 14px 4px; border: 0; background: transparent; color: var(--ink); text-align: left; border-radius: 12px; transition: background .15s; }
  .dp-svcs li + li .dp-svc-row { border-top: 1px solid var(--stone); border-radius: 0; }
  .dp-svc-row:hover { background: var(--sand); }
  .dp-svc-row:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .dp-svc-t { flex: 1; min-width: 0; }
  .dp-svc-t b { display: block; font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 16px; line-height: 20px; letter-spacing: -0.2px; }
  .dp-svc-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; margin-top: 4px; font-size: 12.5px; color: var(--graphite); }
  .dp-svc-off { display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 100px; background: var(--sand); color: var(--ink); font-size: 11px; font-weight: 600; }
  .dp-svc-off svg { width: 11px; height: 11px; }
  .dp-svc-pr { flex-shrink: 0; text-align: right; }
  .dp-svc-pr s { display: block; font-size: 12px; color: var(--ash); }
  .dp-svc-pr b { display: block; font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 17px; letter-spacing: -0.3px; white-space: nowrap; }
  .dp-svc-row > svg { flex-shrink: 0; color: var(--ash); }
  .dp-trocar { display: inline-flex; align-items: center; gap: 4px; height: 34px; margin-top: 14px; padding: 0 14px 0 10px; border: 1.5px solid var(--ink); border-radius: 999px; background: transparent; color: var(--ink); font-size: 13px; font-weight: 600; transition: background .15s; }
  .dp-trocar:hover { background: var(--sand); }
  .dp-svc { margin-top: 16px; }
  .dp-svc h3 { margin: 0 !important; font-family: 'Space Grotesk', sans-serif !important; font-weight: 600; font-size: 18px; letter-spacing: -0.3px; color: var(--ink) !important; }
  .dp-svc .price { margin-top: 4px; font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 22px; letter-spacing: -0.5px; color: var(--ink); }
  /* Last Minute mais barato que o agendamento: preço normal riscado ao lado. */
  .dp-svc .price .dp-old { margin-right: 8px; font-family: 'Inter', sans-serif; font-weight: 400; font-size: 15px; letter-spacing: 0; color: var(--ash); }
  .dp-svc .price small { font-family: 'Inter', sans-serif; font-weight: 400; font-size: 14px; letter-spacing: 0; color: var(--graphite); }
  .dp-svc p { margin: 12px 0 0; font-size: 14px; line-height: 20px; color: var(--graphite); white-space: pre-line; }
  /* Divisão do pagamento: o que sai do cartão AGORA vem primeiro e maior —
     é a informação que o cliente precisa saber antes de tocar no botão. */
  .dp-vale { display: flex; align-items: center; gap: 10px; margin-top: 18px; padding: 10px 12px; border-radius: 14px; background: var(--sand); color: var(--ink); }
  .dp-vale-t { flex: 1; min-width: 0; }
  .dp-vale-t b { display: block; font-size: 13.5px; font-weight: 600; color: var(--ink); }
  .dp-vale-t small { display: block; font-size: 12px; color: var(--graphite); }
  .dp-vale-v { font-size: 14px; font-weight: 600; color: var(--ink); white-space: nowrap; }
  .dp-vale-sw { position: relative; flex: 0 0 44px; height: 26px; border: 0; border-radius: 13px; background: var(--stone); cursor: pointer; transition: background .2s; }
  .dp-vale-sw::after { content: ''; position: absolute; top: 3px; left: 3px; width: 20px; height: 20px; border-radius: 50%; background: #fff; box-shadow: 0 1px 3px rgba(25,20,15,.2); transition: transform .2s; }
  .dp-vale-sw[aria-checked="true"] { background: var(--ink); }
  .dp-vale-sw[aria-checked="true"]::after { transform: translateX(18px); }
  .dp-pay { margin-top: 18px; border: 1px solid var(--stone); border-radius: 16px; overflow: hidden; background: var(--cream); }
  .dp-pay-row { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding: 12px 14px; }
  .dp-pay-row + .dp-pay-row { border-top: 1px solid var(--stone); }
  .dp-pay-row span { color: var(--graphite); font-size: 13.5px; }
  .dp-pay-row span em { font-style: normal; font-family: 'JetBrains Mono', monospace; font-size: 10.5px; letter-spacing: .6px; color: var(--ash); margin-left: 6px; }
  .dp-pay-row b { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 15px; color: var(--ink); white-space: nowrap; }
  .dp-pay-row.now span { color: var(--ink); font-weight: 600; }
  .dp-pay-row.now b { font-size: 18px; }
  .dp-pay-card { display: flex; align-items: center; gap: 10px; padding: 12px 14px; border-top: 1px solid var(--stone); background: var(--paper); font-size: 13px; color: var(--ink); }
  .dp-pay-card svg { color: var(--graphite); flex-shrink: 0; }
  /* Ação dentro de card é botão: pílula de contorno tinta. */
  .dp-pay-card a { margin-left: auto; display: inline-flex; align-items: center; height: 34px; padding: 0 14px; border: 1.5px solid var(--ink); border-radius: 999px; color: var(--ink) !important; font-weight: 600; font-size: 13px; text-decoration: none; transition: background .15s; }
  .dp-pay-card a:hover { background: var(--sand); }
  .dp-pay-card.missing { background: var(--coral-50); color: var(--coral-700); line-height: 1.4; }
  .dp-pay-card.missing svg { color: var(--coral-500); }
  .dp-hint { margin: 16px 0 12px; text-align: center; font-size: 11px; line-height: 15px; color: var(--ash); }
  .dp-confirm { width: 100%; display: flex; align-items: center; justify-content: center; gap: 8px; min-height: 52px; padding: 16px; border: 0; border-radius: 14px !important; background: var(--coral-500) !important; color: var(--cream) !important; font-size: 14px; font-weight: 600; }
  .dp-confirm[disabled] { opacity: .6; cursor: default; }
  .dp-confirm .dp-spin { width: 18px; height: 18px; border-color: rgba(255,255,255,.35); border-top-color: #fff; }
  /* Aviso da folha quando a página não tem o seu (página do lava-rápido). */
  .dp-rtoast { position: fixed; left: 50%; bottom: 24px; z-index: 260; transform: translate(-50%, 20px); opacity: 0; pointer-events: none; display: flex; align-items: center; gap: 10px; max-width: calc(100% - 32px); padding: 13px 16px; border-radius: 14px; background: var(--ink); color: var(--cream); font-size: 13px; line-height: 18px; box-shadow: 0 10px 30px rgba(25,20,15,.35); transition: opacity .2s, transform .2s; }
  .dp-rtoast.is-on { opacity: 1; transform: translate(-50%, 0); }
  .dp-rtoast svg { flex-shrink: 0; color: var(--coral-500); }
  .dp-rtoast.is-err svg { color: #f0a3a3; }
  @media (min-width: 900px) {
    /* No computador a folha vira janela central — folha presa à base de uma
       tela larga é um gesto de celular sem o celular. */
    .dp-sheet-bg { align-items: center; padding: 24px; }
    .dp-sheet { max-width: 520px; border-radius: 28px; padding-bottom: 24px; transform: translateY(24px) scale(.98); opacity: 0; transition: transform .28s cubic-bezier(.2,.8,.2,1), opacity .2s; }
    .dp-sheet-bg.is-open .dp-sheet { opacity: 1; }
    .dp-handle { display: none; }
    .dp-band-top { padding-top: 20px; }
  }
  /* Folha larga do computador com mouse (renderLarga). */
  @media (min-width: 1024px) and (hover: hover) and (pointer: fine) {
    .dp-sheet.is-dk { max-width: 880px; height: min(600px, 92vh); max-height: none; display: grid; grid-template-columns: 360px minmax(0, 1fr); grid-template-rows: minmax(0, 1fr); padding: 0; overflow: hidden; }
    .dp-dk-esq { margin: 0; padding: 26px 26px 22px; border-radius: 0; overflow: auto; display: flex; flex-direction: column; }
    .dp-dk-esq .dp-selo { align-self: flex-start; }
    .dp-dk-esq .dp-hora { margin-top: 12px; }
    .dp-dk-loja { margin-top: 18px; padding-top: 16px; border-top: 1px solid rgba(250,250,246,.14); }
    .dp-dk-loja .dp-sh-name { color: var(--cream) !important; white-space: normal; }
    .dp-dk-loja .dp-sh-addr { color: rgba(250,250,246,.6); white-space: normal; }
    .dp-dk-esq .dp-sh-label { color: rgba(250,250,246,.5); margin: 18px 0 8px; }
    .dp-dk-svcs { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
    .dp-dk-svc { width: 100%; display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 12px 14px; border: 2px solid transparent; border-radius: 14px; background: rgba(250,250,246,.06); color: var(--cream); text-align: left; transition: background .15s, border-color .15s; }
    .dp-dk-svc:hover { background: rgba(250,250,246,.1); }
    .dp-dk-svc.is-on { border-color: var(--coral-500); background: rgba(250,250,246,.1); }
    .dp-dk-svc:focus-visible { outline: 2px solid var(--cream); outline-offset: 2px; }
    .dp-dk-svc b { display: block; font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 15.5px; }
    .dp-dk-svc small { display: block; margin-top: 2px; font-size: 12.5px; color: rgba(250,250,246,.55); }
    .dp-dk-pr { flex-shrink: 0; text-align: right; }
    .dp-dk-pr s { display: block; font-size: 12px; color: rgba(250,250,246,.45); }
    .dp-dk-pr b { font-size: 16px; white-space: nowrap; }
    .dp-dk-dir { position: relative; padding: 26px 30px 24px; overflow: auto; overscroll-behavior: contain; display: flex; flex-direction: column; }
    .dp-dk-dir .dp-svc { margin-top: 0; padding-right: 44px; }
    .dp-dk-dir .dp-foot { margin-top: auto; }
    .dp-dk-x { position: absolute; top: 16px; right: 18px; margin: 0; color: var(--ink); }
    .dp-dk-x:hover { background: var(--sand); }
    .dp-dk-vazio { margin: auto 0; color: var(--graphite); font-size: 15px; text-align: center; }
  }
  /* Tela baixa (celular deitado, notebook pequeno com zoom): a folha inteira
     rola, com o topo e o botão junto. */
  @media (max-height: 620px) {
    .dp-sheet { display: block; overflow: auto; overscroll-behavior: contain; }
    .dp-mid { overflow: visible; }
    .dp-hora { font-size: 64px; line-height: 72px; letter-spacing: -3.5px; }
  }
  @media (max-width: 360px) {
    .dp-sheet { padding-left: 16px; padding-right: 16px; }
    .dp-band { margin: 0 -16px; padding-left: 16px; padding-right: 16px; }
    .dp-hora { font-size: 72px; line-height: 80px; letter-spacing: -4px; }
    .dp-sh-name { font-size: 20px; line-height: 24px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .dp-sheet { transition: none; }
    .dp-vivo i { animation: none; }
  }
</style>

<div class="dp-rtoast" id="dp-rtoast" role="status"></div>
<div class="dp-sheet-bg" id="dp-sheet-bg" hidden>
  <div class="dp-sheet" role="dialog" aria-modal="true" aria-labelledby="dp-sh-name" id="dp-sheet"></div>
</div>

<script>
(function () {
  if (window.LoovReservaLM) return;
  var SIGNED_IN = <%= user_signed_in? ? "true" : "false" %>;
  // Pelo site a reserva pré-autoriza esta fração no cartão (Appointment::PREPAYMENT_PCT).
  var PCT       = <%= Appointment::PREPAYMENT_PCT %>;
  var PCT_LABEL = Math.round(PCT * 100) + '%', REST_LABEL = (100 - Math.round(PCT * 100)) + '%';
  var HAS_CARD  = <%= (user_signed_in? && current_user.has_payment_method?) ? "true" : "false" %>;
  var CARD_TXT  = <%= raw json_escape(((user_signed_in? && current_user.card_display) || "").to_json) %>;
  var STRIPE_PK = <%= raw json_escape(ENV['STRIPE_PUBLISHABLE_KEY'].to_s.to_json) %>;
  var MIN_PREPAGO = <%= Appointment::PREPAGO_MINIMO %>;
  // Vales de fidelidade livres do cliente, por lava-rápido (LoyaltyReward).
  // O desconto é a mesma conta do servidor (LoyaltyReward#desconto_para),
  // sobre o preço do Last Minute.
  <% vales = user_signed_in? && current_user.client? ? LoyaltyReward.livres.where(user_id: current_user.id).order(:expires_at).to_a.uniq(&:car_wash_id) : [] %>
  var VALES = <%= raw json_escape(vales.to_h { |v| [v.car_wash_id, {
    type: v.reward_type, value: v.reward_value.to_f, service_id: v.reward_service_id, short: v.resumo_curto,
    expires: v.expires_at.in_time_zone("America/Sao_Paulo").strftime("%d/%m") }] }.to_json) %>;
  var HORA_OFF_IC = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 12l3-3M12 12v5M9.8 14.8L12 17l2.2-2.2"/></svg>';
  var SEM_MOV = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var DESK = window.matchMedia('(min-width: 1024px) and (hover: hover) and (pointer: fine)');
  var CURVA = 'cubic-bezier(.87,0,.13,1)';

  var useReward = true;
  var st = { target: null, selectedId: null, reserving: false, op: {}, origem: null, lastFocus: null, fechando: false };

  function $(id) { return document.getElementById(id); }
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
  function icon(n, size, extra) { return window.feather && feather.icons[n] ? feather.icons[n].toSvg(Object.assign({ width: size, height: size }, extra || {})) : ''; }
  function money(v, d) { var n = Number(v); return isFinite(n) ? n.toFixed(d || 0).replace('.', ',') : '—'; }
  function fmtTime(iso) { if (!iso) return ''; var d = new Date(iso); return String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0'); }
  function api(url, opts) {
    opts = opts || {};
    var csrf = (document.querySelector('meta[name="csrf-token"]') || {}).content;
    return fetch(url, Object.assign({ credentials: 'same-origin' }, opts, {
      headers: Object.assign({ Accept: 'application/json', 'Content-Type': 'application/json', 'X-CSRF-Token': csrf }, opts.headers || {})
    }));
  }
  function toast(t, tipo) { if (st.op.toast) st.op.toast(t, tipo); }
  // Abaixo do mínimo do Stripe (vale cobrindo quase tudo) não há sinal.
  function prepayOf(price) { var v = Math.round(Number(price) * PCT * 100) / 100; return v < MIN_PREPAGO ? 0 : v; }
  function valeDe(cw) { return cw && VALES[cw.id] || null; }
  function descontoDe(cw, svc) {
    var v = valeDe(cw); if (!v || !useReward || !svc) return 0;
    var base = Number(svc.price), d = 0;
    if (v.type === 'percent') d = base * v.value / 100;
    else if (v.type === 'fixed') d = v.value;
    else if (v.type === 'free_service') d = svc.id === v.service_id ? base : v.value;
    return Math.round(Math.min(Math.max(d, 0), base) * 100) / 100;
  }
  function totalDe(cw, svc) { return svc ? Math.max(0, Math.round((Number(svc.price) - descontoDe(cw, svc)) * 100) / 100) : 0; }
  function cardUrl(cwId) {
    var back = st.op.voltar || ('/disponivel' + (cwId ? '?car_wash_id=' + cwId : ''));
    return '/client/profile/edit?add_card=1&return_to=' + encodeURIComponent(back);
  }

  // ── abrir / fechar (cresce do botão e encolhe de volta, como o + Lançar custos)
  function salto() {
    var o = st.origem.getBoundingClientRect(), f = $('dp-sheet').getBoundingClientRect();
    return 'translate(' + ((o.left + o.width / 2) - (f.left + f.width / 2)) + 'px,' + ((o.top + o.height / 2) - (f.top + f.height / 2)) + 'px) ' +
      'scale(' + Math.max(.05, o.width / f.width) + ',' + Math.max(.02, o.height / f.height) + ')';
  }
  function abrir(it, op) {
    st.op = op || {};
    st.target = it;
    var pre = st.op.servico && (it.services || []).find(function (s) { return Number(s.id) === Number(st.op.servico); });
    // Nada vem escolhido quando há mais de um serviço: com a Lavagem Simples
    // já marcada, o cliente ia direto pro pagamento sem ver as outras. Vindo
    // da página do lava-rápido o serviço já foi escolhido lá.
    // No computador a lista fica sempre ao lado do pagamento, então o
    // primeiro já vem escolhido.
    st.selectedId = pre ? pre.id : ((it.services || []).length === 1 || DESK.matches ? it.services[0].id : null);
    st.origem = st.op.origem && !SEM_MOV ? st.op.origem : null;
    st.lastFocus = document.activeElement;
    var bg = $('dp-sheet-bg'), sh = $('dp-sheet');
    bg.hidden = false;
    sh.scrollTop = 0;
    render();
    document.documentElement.style.overflow = 'hidden';
    if (st.origem && sh.animate) {
      // Já no lugar final (sem a transição de subir) e crescendo do botão.
      sh.style.transition = 'none';
      bg.classList.add('is-open');
      sh.animate([{ transform: salto(), opacity: 0 }, { opacity: 1, offset: .15 }, { transform: 'none', opacity: 1 }], { duration: 700, easing: CURVA });
      blocos(sh).forEach(function (k, i) {
        k.animate([{ opacity: 0, transform: 'translateY(14px)' }, { opacity: 1, transform: 'none' }], { duration: 500, delay: 480 + Math.min(i, 6) * 60, easing: 'cubic-bezier(.2,.8,.2,1)', fill: 'backwards' });
      });
      var x = bg.querySelector('.dp-x'); if (x) x.focus({ preventScroll: true });
    } else {
      requestAnimationFrame(function () { bg.classList.add('is-open'); var x = bg.querySelector('.dp-x'); if (x) x.focus(); });
    }
  }
  function fechar(depois) {
    if (st.fechando) return;
    var bg = $('dp-sheet-bg'), sh = $('dp-sheet');
    var fim = function () {
      bg.classList.remove('is-open');
      setTimeout(function () {
        bg.hidden = true; st.target = null;
        sh.getAnimations && sh.getAnimations().forEach(function (a) { a.cancel(); });
        blocos(sh).forEach(function (k) { k.getAnimations && k.getAnimations().forEach(function (a) { a.cancel(); }); });
        sh.style.transition = ''; st.fechando = false;
        if (depois) depois();
      }, 220);
      document.documentElement.style.overflow = '';
      if (st.lastFocus && st.lastFocus.focus) st.lastFocus.focus({ preventScroll: true });
    };
    st.fechando = true;
    if (st.origem && st.origem.isConnected && sh.animate) {
      blocos(sh).forEach(function (k) { k.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 160, fill: 'forwards' }); });
      var a = sh.animate([{ transform: 'none', opacity: 1 }, { opacity: 1, offset: .85 }, { transform: salto(), opacity: 0 }], { duration: 550, delay: 60, easing: CURVA, fill: 'forwards' });
      a.onfinish = fim;
    } else fim();
  }
  function fecharPeloCliente() { if (!st.reserving) fechar(); }

  function render() {
    var it = st.target; if (!it) return;
    var cw = it.car_wash, svcs = it.services || [];
    var svc = svcs.find(function (s) { return s.id === st.selectedId; }) || null;
    var addr = [[cw.logradouro, cw.numero].filter(Boolean).join(', '), cw.bairro].filter(Boolean).join(' · ') || cw.address || '';
    var dist = cw.distance_km != null ? Number(cw.distance_km).toFixed(1).replace('.', ',') + ' km' : null;
    var dur = svc && Number(svc.duration) > 0 ? ' · ' + svc.duration + ' min' : '';
    $('dp-sheet').classList.toggle('is-dk', DESK.matches);
    if (DESK.matches) { renderLarga(it, cw, svcs, svc, addr, dist, dur); return; }
    var mid = $('dp-mid'), rolou = mid ? mid.scrollTop : 0;
    $('dp-sheet').innerHTML =
      '<div class="dp-band"><div class="dp-handle"></div>' +
        '<div class="dp-band-top"><span class="dp-selo">' + icon('zap', 12) + 'last minute</span>' +
          '<button type="button" class="dp-x" id="dp-close" aria-label="Fechar"' + (st.reserving ? ' disabled' : '') + '>' + icon('x', 20) + '</button></div>' +
        '<div class="dp-hora">' + fmtTime(it.slots[0]) + '</div>' +
        '<div class="dp-vivo"><i></i><span id="dp-vivo">' + vivoTxt() + '</span></div></div>' +
      '<div class="dp-shop-row"><div><h2 class="dp-sh-name" id="dp-sh-name">' + esc(cw.name) + '</h2>' +
        (addr ? '<div class="dp-sh-addr">' + esc(addr) + '</div>' : '') + '</div>' +
        (dist ? '<span class="dp-dist">' + esc(dist.toUpperCase()) + '</span>' : '') + '</div>' +
      '<div class="dp-rule"></div>' +
      '<div class="dp-mid" id="dp-mid">' +
      // Primeiro momento: a lista inteira, nada marcado, sem pagamento.
      (!svc ? '<div class="dp-sh-label" id="dp-svcs-t">Escolha o serviço</div><ul class="dp-svcs" aria-labelledby="dp-svcs-t">' +
        svcs.map(function (s) {
          var off = s.hora_off && Number(s.regular_price) > Number(s.price);
          return '<li><button type="button" class="dp-svc-row" data-svc="' + s.id + '"><span class="dp-svc-t"><b>' + esc(s.title) + '</b><span class="dp-svc-meta">' +
            (Number(s.duration) > 0 ? '<span>' + s.duration + ' min</span>' : '') + (off ? '<span class="dp-svc-off">' + HORA_OFF_IC + 'Hora Off</span>' : '') + '</span></span>' +
            '<span class="dp-svc-pr">' + (Number(s.regular_price) > Number(s.price) ? '<s>R$ ' + money(s.regular_price, 2) + '</s>' : '') + '<b>R$ ' + money(s.price, 2) + '</b></span>' +
            icon('chevron-right', 18) + '</button></li>';
        }).join('') + '</ul>' : '') +
      // Segundo momento: o serviço escolhido, com a volta pra lista.
      (svc && svcs.length > 1 ? '<button type="button" class="dp-trocar" data-trocar' + (st.reserving ? ' disabled' : '') + '>' + icon('chevron-left', 15) + 'Trocar serviço</button>' : '') +
      // Descrição inteira: quem rola é o miolo, nada de caixa cortando o texto.
      (svc ? '<div class="dp-svc"><h3>' + esc(svc.title) + '</h3><div class="price">' + (Number(svc.regular_price) > Number(svc.price) ? '<s class="dp-old">R$ ' + money(svc.regular_price, 2) + '</s>' : '') + 'R$ ' + money(svc.price, 2) + '<small>' + dur + '</small></div>' +
        '<p>' + esc(svc.description && svc.description.trim() ? svc.description : 'Este lava-rápido não cadastrou uma descrição detalhada. Confirme os itens incluídos ao chegar.') + '</p></div>' : '') +
      payBlock(svc, cw) + '</div>' +
      (svc ? footHtml(svc, cw) : '');
    // Trocar de serviço ou o vale redesenha a folha: o miolo fica onde estava.
    if (rolou) $('dp-mid').scrollTop = rolou;
  }
  // Computador com mouse: a folha do celular centralizada escondia a divisão
  // do pagamento numa caixinha com rolagem, logo antes do botão que cobra.
  // Aqui ela vira um cartão largo: à esquerda (escuro) a vaga, o lava-rápido
  // e os serviços; à direita o serviço escolhido, o pagamento e o botão, tudo
  // à vista.
  function renderLarga(it, cw, svcs, svc, addr, dist, dur) {
    var dir = $('dp-dk-dir'), rolou = dir ? dir.scrollTop : 0;
    $('dp-sheet').innerHTML =
      '<div class="dp-band dp-dk-esq">' +
        '<span class="dp-selo">' + icon('zap', 12) + 'last minute</span>' +
        '<div class="dp-hora">' + fmtTime(it.slots[0]) + '</div>' +
        '<div class="dp-vivo"><i></i><span id="dp-vivo">' + vivoTxt() + '</span></div>' +
        '<div class="dp-dk-loja"><h2 class="dp-sh-name" id="dp-sh-name">' + esc(cw.name) + '</h2>' +
          '<div class="dp-sh-addr">' + esc([addr, dist].filter(Boolean).join(' · ')) + '</div></div>' +
        '<div class="dp-sh-label" id="dp-svcs-t">Serviço</div>' +
        '<ul class="dp-dk-svcs" aria-labelledby="dp-svcs-t">' + svcs.map(function (s) {
          var on = svc && s.id === svc.id;
          return '<li><button type="button" class="dp-dk-svc' + (on ? ' is-on' : '') + '" data-svc="' + s.id + '" aria-pressed="' + !!on + '"' + (st.reserving ? ' disabled' : '') + '>' +
            '<span><b>' + esc(s.title) + '</b>' + (Number(s.duration) > 0 ? '<small>' + s.duration + ' min</small>' : '') + '</span>' +
            '<span class="dp-dk-pr">' + (Number(s.regular_price) > Number(s.price) ? '<s>R$ ' + money(s.regular_price, 2) + '</s>' : '') + '<b>R$ ' + money(s.price, 2) + '</b></span></button></li>';
        }).join('') + '</ul></div>' +
      '<div class="dp-dk-dir" id="dp-dk-dir">' +
        '<button type="button" class="dp-x dp-dk-x" id="dp-close" aria-label="Fechar"' + (st.reserving ? ' disabled' : '') + '>' + icon('x', 20) + '</button>' +
        (svc
          ? '<div class="dp-svc"><h3>' + esc(svc.title) + '</h3><div class="price">' + (Number(svc.regular_price) > Number(svc.price) ? '<s class="dp-old">R$ ' + money(svc.regular_price, 2) + '</s>' : '') + 'R$ ' + money(svc.price, 2) + '<small>' + dur + '</small></div>' +
              '<p>' + esc(svc.description && svc.description.trim() ? svc.description : 'Este lava-rápido não cadastrou uma descrição detalhada. Confirme os itens incluídos ao chegar.') + '</p></div>' +
            payBlock(svc, cw) + footHtml(svc, cw)
          : '<p class="dp-dk-vazio">Escolha o serviço ao lado para ver o pagamento.</p>') +
      '</div>';
    if (rolou) $('dp-dk-dir').scrollTop = rolou;
  }
  function footHtml(svc, cw) {
    return '<div class="dp-foot"><p class="dp-hint">' + (prepayOf(totalDe(cw, svc))
        ? 'Os ' + PCT_LABEL + ' ficam reservados no cartão e só são cobrados se o lava-rápido aceitar: ele tem até 3 min pra responder. ' +
          'Se ele recusar ou o tempo acabar, o valor é liberado. Depois de aceita, não há reembolso se você não for; ' +
          'se o lava-rápido cancelar, você recebe de volta.'
        : 'Nada é cobrado no cartão agora. O lava-rápido tem até 3 min pra responder' + (descontoDe(cw, svc) > 0 ? '; se ele recusar ou o tempo acabar, o vale volta pra você' : '') + '.') + '</p>' +
      '<button type="button" class="dp-confirm" id="dp-confirm"' + (st.reserving || !svc ? ' disabled' : '') + '>' +
        (st.reserving ? '<span class="dp-spin"></span>'
          : (SIGNED_IN && !HAS_CARD) ? icon('credit-card', 16) + ' Cadastrar cartão para reservar'
          : svc ? icon('zap', 16) + (prepayOf(totalDe(cw, svc)) ? 'Reservar e pagar R$ ' + money(prepayOf(totalDe(cw, svc)), 2) : 'Reservar com o vale') + ' ' + icon('arrow-right', 16)
          : 'Confirmar reserva') + '</button></div>';
  }
  // Minutos até a vaga começar (a próxima marca de meia hora). Atualiza a
  // cada 15 s com a folha aberta: não pode ficar mostrando um número velho.
  function vivoTxt() {
    var slot = st.target && st.target.slots && st.target.slots[0];
    var m = slot ? Math.max(0, Math.ceil((new Date(slot).getTime() - Date.now()) / 60000)) : 0;
    return m > 0 ? 'COMEÇA EM ' + m + ' MIN' : 'COMEÇA AGORA';
  }
  setInterval(function () { var el = st.target && $('dp-vivo'); if (el) el.textContent = vivoTxt(); }, 15000);
  // Blocos que entram em cascata: o conteúdo, não a faixa escura (ela já é o
  // que cresce do botão).
  function blocos(sh) {
    if (sh.classList.contains('is-dk')) return Array.prototype.slice.call(sh.querySelectorAll('.dp-dk-esq > *, .dp-dk-dir > *:not(.dp-dk-x)'));
    var band = sh.querySelector('.dp-band');
    var dentro = band ? Array.prototype.filter.call(band.children, function (k) { return !k.classList.contains('dp-handle'); }) : [];
    return dentro.concat(Array.prototype.filter.call(sh.children, function (k) { return k !== band; }));
  }
  // O "Pagamento na chegada" escondia que parte sai do cartão na hora. Agora a
  // divisão fica explícita antes do botão, com o valor em reais e o cartão
  // que vai ser usado — sem surpresa na fatura.
  function payBlock(svc, cw) {
    if (!svc) return '';
    var total = totalDe(cw, svc), now = prepayOf(total), rest = Math.max(0, Math.round((total - now) * 100) / 100);
    var v = valeDe(cw), d = descontoDe(cw, svc);
    // Vale ligado por padrão; a chave guarda pra outra vez.
    var valeRow = !v ? '' : '<div class="dp-vale' + (useReward ? ' is-on' : '') + '">' + icon('gift', 15) +
      '<span class="dp-vale-t"><b>Vale de fidelidade</b><small>' + esc(v.short) + ' · até ' + esc(v.expires) + '</small></span>' +
      (useReward ? '<b class="dp-vale-v">' + (v.type === 'gift' ? 'no balcão' : '−R$ ' + money(d, 2)) + '</b>' : '') +
      '<button type="button" class="dp-vale-sw" role="switch" aria-checked="' + useReward + '" aria-label="Usar o vale nesta reserva" data-vale></button></div>';
    var cardLine = !SIGNED_IN ? ''
      : HAS_CARD ? '<div class="dp-pay-card">' + icon('credit-card', 15) + '<span>' + esc(CARD_TXT) + '</span><a href="' + cardUrl(cw.id) + '">Trocar</a></div>'
      : '<div class="dp-pay-card missing">' + icon('credit-card', 15) + '<span>Para reservar no Last Minute você precisa de um cartão cadastrado. É ele que garante a vaga.</span></div>';
    var hoff = svc.hora_off ? Math.round((Number(svc.regular_price) - Number(svc.price)) * 100) / 100 : 0;
    var offRow = hoff > 0 ? '<div class="dp-offrow"><span>' + HORA_OFF_IC + 'Desconto Hora Off</span><b>−R$ ' + money(hoff, 2) + '</b></div>' : '';
    // Vale cobrindo tudo: "35% R$ 0,00 / 65% R$ 0,00" fazia parecer que havia
    // alguma cobrança. Diz o que é. Sem sinal (abaixo do mínimo do Stripe),
    // some a divisão em porcentagem.
    var linhas = total <= 0
      ? '<div class="dp-pay-row now"><span>Coberto pelo vale</span><b>R$ 0,00</b></div>'
      : now <= 0
      ? '<div class="dp-pay-row"><span>Nada no cartão agora</span><b>R$ 0,00</b></div>' +
        '<div class="dp-pay-row now"><span>Na chegada, no lava-rápido</span><b>R$ ' + money(total, 2) + '</b></div>'
      : '<div class="dp-pay-row now"><span>Agora, no cartão<em>' + PCT_LABEL + '</em></span><b>R$ ' + money(now, 2) + '</b></div>' +
        '<div class="dp-pay-row"><span>Na chegada, no lava-rápido<em>' + REST_LABEL + '</em></span><b>R$ ' + money(rest, 2) + '</b></div>';
    return offRow + valeRow + '<div class="dp-pay">' + linhas + cardLine + '</div>';
  }
  // Lista ⇄ serviço: o miolo volta pro topo e entra com um fade curto; o foco
  // vai pro que o teclado precisa (o primeiro serviço ou o "Trocar").
  function trocarPara(id) {
    st.selectedId = id;
    var mid = $('dp-mid') || $('dp-dk-dir'); if (mid) mid.scrollTop = 0;
    $('dp-sheet').scrollTop = 0;
    render();
    var novo = $('dp-mid') || $('dp-dk-dir');
    if (novo && novo.animate && !SEM_MOV) novo.animate([{ opacity: 0, transform: 'translateY(8px)' }, { opacity: 1, transform: 'none' }], { duration: 260, easing: 'cubic-bezier(.2,.8,.2,1)' });
    var f = document.querySelector(id == null ? '#dp-sheet [data-svc]' : '#dp-sheet [data-trocar]');
    if (f) f.focus({ preventScroll: true });
  }
  function falhou(msg) { toast(msg, 'error'); if (st.op.aoFalhar) st.op.aoFalhar(); }
  function confirmar() {
    var it = st.target;
    var svc = it && (it.services || []).find(function (s) { return s.id === st.selectedId; });
    var slot = it && it.slots && it.slots[0];
    // Toque mudo em "Confirmar" era indistinguível de site travado.
    if (!it || !svc || !slot) { toast(!slot ? 'Este horário não está mais disponível. Atualize a lista.' : 'Selecione um serviço para continuar.', 'error'); return; }
    if (!SIGNED_IN) { toast('Entre na sua conta para reservar.', 'error'); setTimeout(function () { location.href = '/users/sign_in'; }, 900); return; }
    if (!HAS_CARD) { location.href = cardUrl(it.car_wash.id); return; }
    // Folha aberta há tempo (aba esquecida): o horário já passou. O servidor
    // também recusa; aqui só evita a ida e volta.
    if (new Date(slot).getTime() <= Date.now()) { fechar(); falhou('Esse horário já passou. Atualizamos as vagas: escolha de novo.'); return; }
    st.reserving = true; render();
    api('/disponivel', { method: 'POST', body: JSON.stringify({ car_wash_id: it.car_wash.id, service_id: svc.id, slot: slot, use_reward: !!valeDe(it.car_wash) && useReward }) })
      .then(function (r) { return r.json().catch(function () { return {}; }).then(function (d) { return { r: r, d: d }; }); })
      .then(function (x) {
        if (x.r.status === 401) { location.href = '/users/sign_in'; return; }
        if (x.d.code === 'card_required') { location.href = cardUrl(it.car_wash.id); return; }
        // A vaga saiu do Last Minute (tela parada, horário passou): fecha a
        // folha e recarrega a lista, em vez de deixar o cliente tentar de novo.
        if (x.d.code === 'slot_gone') { st.reserving = false; fechar(); falhou(x.d.error); return; }
        if (!x.r.ok || !x.d.ok) { toast(x.d.error || ('Erro ' + x.r.status + ': não foi possível reservar.'), 'error'); return; }
        return (x.d.requires_action ? confirmarNoBanco(x.d) : Promise.resolve(x.d)).then(function (d) {
          if (!d) return; // banco não confirmou: já avisado, vaga liberada
          st.reserving = false;
          var appt = { id: d.appointment_id, expires_at: d.expires_at, seconds: d.seconds || 180, car_wash: it.car_wash, service: svc, slot: slot,
            prepayment: d.prepayment != null ? d.prepayment : prepayOf(totalDe(it.car_wash, svc)),
            // Total já com o vale: o que sobra pra pagar na chegada sai dele.
            total: d.total != null ? Number(d.total) : totalDe(it.car_wash, svc), desconto: Number(d.reward_discount) || 0 };
          // Reservou: a folha sai sem encolher (a página vai pra espera).
          st.origem = null;
          fechar();
          if (st.op.aoReservar) st.op.aoReservar(appt);
        });
      })
      .catch(function () { toast('Erro de conexão. Tente novamente.', 'error'); })
      .finally(function () { if (st.reserving) { st.reserving = false; render(); } });
  }

  // ── confirmação do banco (3DS) ───────────────────────────────────────────
  // Alguns bancos pedem uma confirmação extra (senha, código por SMS, app do
  // banco) antes de reservar os 35%. O Stripe.js abre essa janela do próprio
  // banco aqui mesmo; depois o servidor confere com o Stripe antes de levar o
  // pedido ao dono — o resultado que vem do navegador não é confiado.
  function confirmarNoBanco(d) {
    var release = function (msg) {
      api('/disponivel/' + d.appointment_id + '/cancel', { method: 'PATCH' }).catch(function () {});
      falhou(msg);
      return null;
    };
    if (!window.Stripe || !STRIPE_PK) return Promise.resolve(release('Não foi possível abrir a confirmação do banco. Tente de novo.'));
    toast('Seu banco pediu uma confirmação. Siga as instruções na janela que vai abrir.');
    return Stripe(STRIPE_PK).handleNextAction({ clientSecret: d.client_secret }).then(function (res) {
      if (res.error) return release(res.error.message ? 'O banco não confirmou: ' + res.error.message : 'O banco não confirmou o pagamento. Nada foi cobrado.');
      return api('/disponivel/' + d.appointment_id + '/authorized', { method: 'POST' })
        .then(function (r) { return r.json().catch(function () { return {}; }).then(function (b) { return { r: r, b: b }; }); })
        .then(function (y) {
          if (y.r.ok && y.b.ok) return y.b;
          falhou(y.b.error || 'Não foi possível concluir a reserva.');
          return null;
        });
    }).catch(function () { return release('A confirmação do banco foi interrompida. Nada foi cobrado.'); });
  }

  document.addEventListener('click', function (e) {
    if (!st.target) return;
    var t;
    if ((t = e.target.closest('#dp-sheet [data-svc]'))) { trocarPara(Number(t.dataset.svc)); return; }
    if (e.target.closest('#dp-sheet [data-trocar]')) { trocarPara(null); return; }
    if (e.target.closest('#dp-close')) { fecharPeloCliente(); return; }
    if (e.target.id === 'dp-sheet-bg') { fecharPeloCliente(); return; }
    if (e.target.closest('#dp-confirm')) { confirmar(); return; }
    if (e.target.closest('#dp-sheet [data-vale]')) { useReward = !useReward; render(); return; }
  });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && st.target && !$('dp-sheet-bg').hidden) fecharPeloCliente(); });

  var avisoT = null;
  function aviso(text, tipo) {
    var t = $('dp-rtoast');
    t.className = 'dp-rtoast is-on' + (tipo === 'error' ? ' is-err' : '');
    t.innerHTML = icon(tipo === 'error' ? 'x-circle' : 'info', 15) + '<span>' + esc(text) + '</span>';
    clearTimeout(avisoT); avisoT = setTimeout(function () { t.className = 'dp-rtoast'; }, 3500);
  }

  window.LoovReservaLM = { abrir: abrir, fechar: fechar, aviso: aviso, aberta: function () { return !!st.target; } };
})();
</script>
