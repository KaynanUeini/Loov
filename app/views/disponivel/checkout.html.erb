<style>
  .ck-wrap { min-height:100vh; display:flex; align-items:center; justify-content:center; padding:24px; padding-top:80px; background:var(--cream); }

  .ck-card {
    width:100%; max-width:460px;
    background:var(--paper);
    border:1px solid var(--stone);
    border-radius:24px; overflow:hidden;
    box-shadow: 0 14px 40px rgba(40,35,28,0.06);
  }
  .ck-card::before { content:''; display:block; height:3px; background:linear-gradient(to right, transparent, var(--coral-500), transparent); }

  .ck-body { padding:28px 28px 18px; }
  .ck-eyebrow {
    display:inline-flex; align-items:center; gap:6px;
    font-family:'JetBrains Mono', monospace;
    font-size:10.5px; letter-spacing:1.6px; text-transform:uppercase;
    color:var(--coral-500);
    background:var(--coral-50); border:1px solid var(--coral-100);
    border-radius:100px; padding:5px 11px;
    margin-bottom:14px;
  }
  .ck-name { font-family:'Space Grotesk', sans-serif; font-weight:700; font-size:26px; color:var(--ink); line-height:1.1; letter-spacing:-0.4px; margin-bottom:4px; }
  .ck-service { font-size:13.5px; color:var(--graphite); margin-bottom:22px; }

  .ck-rows { display:flex; flex-direction:column; gap:10px; margin-bottom:18px; }
  .ck-row { display:flex; justify-content:space-between; align-items:center; gap:10px; }
  .ck-row-label { font-family:'JetBrains Mono', monospace; font-size:10.5px; color:var(--ash); letter-spacing:1.4px; text-transform:uppercase; }
  .ck-row-val { font-size:13.5px; color:var(--ink); font-weight:500; text-align:right; }
  .ck-row-val.muted { color:var(--graphite); }

  .ck-divider { height:1px; background:var(--stone); margin-bottom:18px; }

  .ck-total-row { display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:18px; gap:12px; }
  .ck-total-label { font-family:'JetBrains Mono', monospace; font-size:10.5px; color:var(--ash); letter-spacing:1.4px; text-transform:uppercase; }
  .ck-total-val { font-family:'Space Grotesk', sans-serif; font-weight:700; font-size:34px; color:var(--coral-500); letter-spacing:-0.5px; line-height:1; }

  .ck-card-info { display:flex; align-items:center; gap:12px; background:var(--cream); border:1px solid var(--stone); border-radius:12px; padding:12px 14px; margin-bottom:14px; }
  .ck-card-icon { width:40px; height:40px; border-radius:10px; background:var(--coral-50); border:1px solid var(--coral-100); display:flex; align-items:center; justify-content:center; color:var(--coral-700); font-size:14px; flex-shrink:0; }
  .ck-card-label { font-family:'JetBrains Mono', monospace; font-size:10px; color:var(--ash); letter-spacing:1.4px; text-transform:uppercase; }
  .ck-card-val { font-size:13.5px; color:var(--ink); font-weight:500; margin-top:2px; }

  .ck-no-card { display:flex; align-items:flex-start; gap:12px; background:#fdecec; border:1px solid #f5cccc; border-radius:12px; padding:14px 16px; margin-bottom:14px; }
  .ck-no-card i { color:var(--rose-500); margin-top:2px; flex-shrink:0; }
  .ck-no-card-text { font-size:13px; color:#7a3434; line-height:1.55; }
  .ck-no-card-text strong { color:var(--ink); }

  .ck-note { font-size:12.5px; color:var(--graphite); line-height:1.55; padding:12px 14px; background:var(--coral-50); border:1px solid var(--coral-100); border-radius:12px; margin-bottom:14px; }
  .ck-note strong { color:var(--ink); }

  .ck-footer { padding:20px 28px 28px; border-top:1px solid var(--stone); display:flex; flex-direction:column; gap:10px; align-items:center; }

  .ck-error { color:var(--rose-500); font-size:12.5px; text-align:center; display:none; }

  .spinner { display:inline-block; width:14px; height:14px; border:2px solid rgba(254,254,253,0.4); border-top-color:var(--cream); border-radius:50%; animation:spin .7s linear infinite; }
  @keyframes spin { to { transform:rotate(360deg); } }
</style>

<div class="ck-wrap">
  <div class="ck-card">
    <div class="ck-body">
      <div class="ck-eyebrow"><span class="dot" style="width:6px;height:6px;border-radius:50%;background:var(--coral-500);"></span>Confirmação de reserva</div>
      <div class="ck-name"><%= @car_wash.name %></div>
      <div class="ck-service"><%= @service.title %> · <%= @service.duration %> min</div>

      <div class="ck-rows">
        <div class="ck-row">
          <span class="ck-row-label">Horário</span>
          <span class="ck-row-val"><%= @slot.strftime("%H:%M") %> — hoje, <%= @slot.strftime("%d/%m") %></span>
        </div>
        <div class="ck-row">
          <span class="ck-row-label">Valor total</span>
          <span class="ck-row-val">R$ <%= number_with_precision(@total_price, precision: 2) %></span>
        </div>
        <div class="ck-row">
          <span class="ck-row-label">Pagar no local (65%)</span>
          <span class="ck-row-val muted">R$ <%= number_with_precision(@remaining, precision: 2) %></span>
        </div>
      </div>

      <div class="ck-divider"></div>

      <div class="ck-total-row">
        <span class="ck-total-label">Cobrado agora (35%)</span>
        <span class="ck-total-val">R$ <%= number_with_precision(@prepayment, precision: 2) %></span>
      </div>

      <% if @has_card %>
        <div class="ck-card-info">
          <div class="ck-card-icon"><i class="fas fa-credit-card"></i></div>
          <div>
            <div class="ck-card-label">Cartão cadastrado</div>
            <div class="ck-card-val"><%= @card_display %></div>
          </div>
        </div>
        <div class="ck-note">
          O lava-rápido tem <strong>3 minutos</strong> para confirmar.
          Se não confirmar, <strong>nenhum valor é cobrado</strong>.
          O restante é pago diretamente no local.
        </div>
      <% else %>
        <div class="ck-no-card">
          <i class="fas fa-credit-card"></i>
          <div class="ck-no-card-text">
            <strong>Nenhum cartão cadastrado.</strong><br>
            Você precisa de um cartão para reservar na aba Disponíveis. Cadastre agora e volte para concluir a reserva.
          </div>
        </div>
      <% end %>
    </div>

    <div class="ck-footer">
      <% if @has_card %>
        <button class="loov-btn-primary loov-btn-block loov-btn-lg" id="confirm-btn">
          <i class="fas fa-bolt"></i> Confirmar reserva
        </button>
      <% else %>
        <%= link_to edit_client_profile_path(add_card: true), class: "loov-btn-primary loov-btn-block loov-btn-lg" do %>
          <i class="fas fa-credit-card"></i> Cadastrar cartão
        <% end %>
      <% end %>
      <div class="ck-error" id="ck-error"></div>
      <%= link_to disponivel_index_path, class: "loov-btn-ghost loov-btn-sm" do %>
        <i class="fas fa-arrow-left"></i> Cancelar e voltar
      <% end %>
    </div>
  </div>
</div>

<% if @has_card %>
<script>
  const CSRF        = document.querySelector('meta[name="csrf-token"]').content;
  const CAR_WASH_ID = <%= @car_wash.id %>;
  const SERVICE_ID  = <%= @service.id %>;
  const SLOT        = "<%= @slot.iso8601 %>";

  document.getElementById('confirm-btn').addEventListener('click', async function() {
    const btn     = this;
    const errorEl = document.getElementById('ck-error');
    btn.disabled  = true;
    btn.innerHTML = '<span class="spinner"></span> Processando...';
    errorEl.style.display = 'none';

    try {
      const res = await fetch('/disponivel', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF, 'Accept': 'application/json' },
        body: JSON.stringify({ car_wash_id: CAR_WASH_ID, service_id: SERVICE_ID, slot: SLOT })
      });
      const data = await res.json();

      if (data.ok) {
        window.location.href = '/disponivel/' + data.appointment_id + '/confirmacao';
      } else if (data.redirect) {
        window.location.href = data.redirect;
      } else {
        errorEl.textContent   = data.error || 'Erro ao criar reserva.';
        errorEl.style.display = 'block';
        btn.disabled  = false;
        btn.innerHTML = '<i class="fas fa-bolt"></i> Confirmar reserva';
      }
    } catch(e) {
      errorEl.textContent   = 'Erro de conexão. Tente novamente.';
      errorEl.style.display = 'block';
      btn.disabled  = false;
      btn.innerHTML = '<i class="fas fa-bolt"></i> Confirmar reserva';
    }
  });
</script>
<% end %>
