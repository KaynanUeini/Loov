          '<span class="dw-rel-n" aria-hidden="true">' + fmtTime(a.slot) + '</span></span>' +
        '<p class="dw-frase"><span class="dw-frase-t" id="dw-frase">' + esc(frase(a)) + '</span></p>' +
        '<p class="dw-visto' + (a.seen_at ? ' on' : '') + '" id="dw-visto"><i aria-hidden="true">✓✓</i><span id="dw-visto-txt" aria-live="polite">' + esc(vistoTxt(a)) + '</span></p>' +
        '<p class="dw-dica">O ' + esc(nome) + ' tem até 3 minutos pra aceitar. <b>Pode trocar de aba:</b> o título da aba mostra o tempo e avisa quando ele responder.</p></div>' +
        // Enviado, decidindo, sua vaga. A barra do meio anda com o mesmo
        // tempo do placar do lava-rápido, puxada pelo carro.
        '<div class="dw-passos" aria-label="Pedido enviado, esperando a decisão do lava-rápido">' +
          '<span class="feito"><u><i></i></u>Enviado</span>' +
          '<span class="agora"><u><i><b id="dw-barra" style="width:' + pct + '%"></b></i></u>Decidindo</span>' +
          '<span class="vaga"><u><i><b id="dw-f3"></b><span class="dw-box" aria-hidden="true"><s></s><s></s><em></em><em></em><em></em><em></em></span></i></u>Sua vaga</span>' +
          '<span class="dw-carro" id="dw-carro">' + CARRO + '</span>' +
        '</div>' +
      '</div>' +
      '<div class="dw-linhas">' +
        // Onde: o cliente vai ter que ir até lá.
        '<div class="dw-lp dw-onde"><i class="dw-onde-logo" aria-hidden="true">' + (window.LoovLogos ? LoovLogos.logoOf(cw) : '') + '</i><span>Onde</span>' +
          '<b><em>' + esc(nome) + '</em>' + (onde ? '<small>' + esc(onde) + '</small>' : '') + '</b></div>' +
        '<div class="dw-lp"><span>Serviço</span><b>' + esc(a.service.title || 'Lavagem') + dur + '</b></div>' +
        (a.desconto > 0 ? '<div class="dw-lp"><span>Vale</span><b>−R$ ' + money(a.desconto, 2) + '</b></div>' : '') +
        '<div class="dw-lp"><span>No cartão</span><b>' + (v.held > 0 ? 'R$ ' + money(v.held, 2) : 'nada') + '</b></div>' +
        '<div class="dw-lp"><span>Na chegada</span><b>R$ ' + money(v.rest, 2) + '</b></div>' +
        '<div class="dw-desl" id="dw-desl"><span class="dw-desl-r" id="dw-desl-r"></span>' +
          '<span class="dw-desl-t" id="dw-desl-t">Deslize para cancelar<em aria-hidden="true">›››</em></span>' +
          '<button type="button" class="dw-bola" id="dw-bola" aria-label="Cancelar pedido. Deslize até o fim, ou aperte Enter">' + icon('x', 20, { 'stroke-width': 2.6 }) + '</button></div>' +
        // Com mouse, cancelar é clicar e confirmar.
        '<div class="dw-canc" id="dw-canc">' + cancHtml(false) + '</div>' +
      '</div>' +
      '<div class="dw-fim-baixo" id="dw-fim-baixo"><div class="dw-lp"><span>' + esc(a.service.title || 'Lavagem') + '</span><b>' + fmtTime(a.slot) + ' · R$ ' + money(v.total, 2) + '</b></div>' +
        '<button type="button" class="dw-cta" data-result="list">Buscar outro lava-rápido' + icon('arrow-right', 15) + '</button></div>' +
      '</div>';
    $('dw').scrollTop = 0;
    bindSlide();
    updateUrgency();
    poeCarro();
  }
  // Aceita: a mesma tela de "Agendado" do agendamento comum
  // (shared/_confirmacao_agendamento), com o que é do Last Minute.
  function renderAceito() {
    var a = state.appt, slot = new Date(a.slot), pago = Number(a.prepayment) || 0;
    var total = a.total != null ? Number(a.total) : Number(a.service && a.service.price) || 0;
    var dia = slot.toDateString() === new Date().toDateString() ? 'hoje' : ['dom', 'seg', 'ter', 'qua', 'qui', 'sex', 'sáb'][slot.getDay()];
    $('dw-in').innerHTML = LoovConfirmacao.html({
      lastMinute: true,
      quando: dia + ', ' + fmtTime(a.slot),
      agendaUrl: a.agenda_url,
      cw: a.car_wash, servico: a.service,
      pagoCartao: pago, pagoLabel: 'Pago no cartão',
      aPagar: Math.max(0, Math.round((total - pago) * 100) / 100),
      comVale: a.desconto > 0, valeTxt: a.desconto > 0 ? 'Vale aplicado: −R$ ' + money(a.desconto, 2) : null,
      aviso: 'Se não puder ir, o valor pago no cartão não volta. Se o lava-rápido cancelar, você recebe de volta.',
      homeUrl: '/'
    });
    $('dw').scrollTop = 0;
    var b = document.querySelector('#dw-in .ok-primary'); if (b) b.focus({ preventScroll: true });
  }
  function renderResult() {
    var o = state.outcome, a = state.appt || {}, name = (a.car_wash && a.car_wash.name) || 'lava-rápido';
    if (o === 'accepted') { renderAceito(); return; }
    var v = valores(a);
    // Cada desfecho diz quem decidiu. O tempo esgotado não diz "não
    // respondeu": soa como se o lava-rápido tivesse visto e ignorado.
    var estado = o === 'rejected' ? 'Recusado' : o === 'expired' ? 'Tempo esgotado' : 'Cancelado';
    var palavra = o === 'rejected' ? 'não rolou.' : o === 'expired' ? 'não deu tempo.' : 'pedido cancelado.';
    var motivo = o === 'rejected' ? 'O ' + name + ' não pôde aceitar agora.'
      : o === 'expired' ? 'O ' + name + ' não conseguiu responder dentro dos 3 minutos.'
      : 'Você cancelou antes da resposta e o horário foi liberado.';
    var dinheiro = v.held > 0 ? ' Os R$ ' + money(v.held, 2) + ' reservados foram liberados: nada foi cobrado.' : ' Nada foi cobrado.';
    $('dw-in').innerHTML = '<div class="dw-fim">' +
      '<div class="dw-vivo"><span>Last Minute</span><span' + (o === 'rejected' ? ' class="is-rec"' : '') + '>' + estado + '</span></div>' +
      '<span class="dw-rel">' + fmtTime(a.slot) + '</span>' +
      (o !== 'cancelled' ? '<p class="dw-frase riscada">' + esc(frase(a)) + '</p>' : '') +
      '<p class="dw-frase">' + palavra + '</p>' +
      '<p class="dw-fim-txt">' + esc(motivo + dinheiro) + '</p>' +
      '<div class="dw-lp"><span>' + esc((a.service && a.service.title) || 'Lavagem') + '</span><b>' + fmtTime(a.slot) + ' · R$ ' + money(v.total, 2) + '</b></div>' +
      '<button type="button" class="dw-cta" data-result="list">Buscar outro lava-rápido' + icon('arrow-right', 15) + '</button>' +
    '</div>';
    $('dw').scrollTop = 0;
    var b = document.querySelector('.dw-cta'); if (b) b.focus({ preventScroll: true });
  }
  function cancHtml(perguntando) {
    return perguntando
      ? '<p>Cancelar o pedido?<br>O horário volta a ficar livre.</p><div><button type="button" data-canc="manter">Manter</button><button type="button" class="is-cheio" data-canc="sim">Sim, cancelar</button></div>'
      : '<button type="button" class="is-rosa" data-canc="perguntar">Cancelar pedido</button>';
  }
  function closeWaiting() {
    stopPolling();
    paraPisca(); document.title = TITULO;
    state.appt = null; state.outcome = null; state.saindo = false;
    $('dw').classList.remove('is-on', 'is-urgent');
    document.documentElement.style.overflow = '';
  }

  // Deslizar pra cancelar: arrastar a bolinha até 90% da trilha cancela;
  // soltar antes volta com mola. Teclado e leitor de tela cancelam direto,
  // porque não arrastam.
  function bindSlide() {
    var trilha = $('dw-desl'), bola = $('dw-bola'), rastro = $('dw-desl-r'), txt = $('dw-desl-t');
    var x0 = null, dx = 0, foi = false;
    var maxX = function () { return trilha.clientWidth - bola.offsetWidth - 8; };
    var poe = function (v) {
      dx = Math.max(0, Math.min(maxX(), v));
      bola.style.transform = 'translateX(' + dx + 'px)';
      rastro.style.width = (dx + 52) + 'px';
      txt.style.opacity = String(Math.max(0, 1 - dx / (maxX() * .6)));
    };
    var cancela = function () { if (foi) return; foi = true; giveUp(); };
    bola.addEventListener('pointerdown', function (e) { x0 = e.clientX - dx; trilha.classList.remove('volta'); try { bola.setPointerCapture(e.pointerId); } catch (_) {} });
    bola.addEventListener('pointermove', function (e) { if (x0 !== null) poe(e.clientX - x0); });
    var solta = function () {
      if (x0 === null) return;
      x0 = null;
      if (maxX() > 0 && dx >= maxX() * .9) { poe(maxX()); cancela(); }
      else { trilha.classList.add('volta'); poe(0); }
    };
    bola.addEventListener('pointerup', solta); bola.addEventListener('pointercancel', solta);
    bola.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); cancela(); } });
    // Leitor de tela ativa o botão sem ponteiro (clique com detail 0).
    bola.addEventListener('click', function (e) { if (e.detail === 0) cancela(); });
    bola.addEventListener('contextmenu', function (e) { e.preventDefault(); });
  }
  // Cancelado pelo cliente: a espera desce e encolhe, o contrário de como a
  // folha abriu, e o cliente vai pra Home. O pedido é cancelado durante a
  // saída; se o lava-rápido tiver aceitado no mesmo instante, o servidor
  // recusa o cancelamento e a tela mostra o aceite.
  function giveUp() {
    if (state.outcome || state.saindo) return;
    var id = state.appt && state.appt.id;
    state.saindo = true;
    stopPolling();
    var esp = $('dw-in');
    var pedido = id ? api('/disponivel/' + id + '/cancel', { method: 'PATCH' }).then(function (r) { return r.ok ? null : r.json().catch(function () { return {}; }); }).catch(function () { return null; }) : Promise.resolve(null);
    // Encolhe inteira e só some no fim: esmaecer cedo deixava a espera cinza.
    var saida = anima(esp, [{ transform: 'none', opacity: 1, borderRadius: '0px' }, { opacity: 1, offset: .85 }, { transform: 'translateY(60%) scale(.86)', opacity: 0, borderRadius: '34px' }], 680, CURVA);
    Promise.all([pedido, saida]).then(function (r) {
      state.saindo = false;
      if (r[0] && r[0].status === 'confirmed') {
        esp.getAnimations().forEach(function (an) { an.cancel(); });
        state.outcome = 'accepted';
        renderAceito();
        return;
      }
      window.location.href = '/';
    });
  }

  // ── eventos ──────────────────────────────────────────────────────────────
  document.addEventListener('click', function (e) {
    var t;
    if ((t = e.target.closest('[data-open]'))) { var it = state.items.find(function (x) { return String(x.car_wash.id) === t.dataset.open; }); if (it) openSheet(it); return; }
    if ((t = e.target.closest('[data-sort]'))) { state.sortBy = t.dataset.sort; render(); return; }
    if (e.target.closest('#dp-retry')) { retryLocation(); return; }
    if ((t = e.target.closest('[data-canc]'))) {
      var c = $('dw-canc'); if (!c || state.outcome || state.saindo) return;
      if (t.dataset.canc === 'sim') { giveUp(); return; }
      var perg = t.dataset.canc === 'perguntar';
      c.innerHTML = cancHtml(perg);
      var f = c.querySelector(perg ? '[data-canc="manter"]' : '[data-canc="perguntar"]'); if (f) f.focus();
      return;
    }
    if ((t = e.target.closest('[data-result]'))) {
      closeWaiting(); load(true);
    }
  });
  document.addEventListener('mouseover', function (e) { var c = e.target.closest('.dp-card'); if (c && !c.contains(e.relatedTarget)) hot(c.dataset.open, true); });
  document.addEventListener('mouseout', function (e) { var c = e.target.closest('.dp-card'); if (c && !c.contains(e.relatedTarget)) hot(c.dataset.open, false); });
  $('dp-maptoggle').addEventListener('click', toggleMapMode);
  wideMap.addEventListener('change', function () { renderMap(validItems()); });
  // Contagem "em Xmin" dos cards se atualiza sozinha (como o app, a cada 15s).
  setInterval(function () { if (!state.appt && !state.loading && state.loc === 'granted') render(); }, 15000);

  function boot() {
    if (window.feather) feather.replace(); $('dp-maptoggle-ic').innerHTML = icon('map', 16); render(); initLocation();
    // Pedido feito na página do lava-rápido (a folha abre lá, no horário com
    // raio): ele já reservou e vem pra cá só a espera do aceite, a mesma de
    // sempre. Lido uma vez e apagado, senão recarregar reabriria a espera.
    var esp = null;
    try { esp = JSON.parse(sessionStorage.getItem('loov_lm_espera') || 'null'); sessionStorage.removeItem('loov_lm_espera'); } catch (e) {}
    if (esp && esp.id && esp.expires_at) startWaiting(esp);
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot); else boot();
})();
</script>
