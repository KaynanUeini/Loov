  }
  function stopPolling() { clearTimeout(pollT); pollT = null; clearInterval(tickT); tickT = null; }
  function setOutcome(o) { state.outcome = o; bird.stop(); renderWaiting(); }
  function accentOf() {
    var urgent = state.secondsLeft < 30 && !state.outcome;
    return state.outcome === 'accepted' ? 'var(--mint-500)' : (state.outcome || urgent) ? 'var(--rose-500)' : 'var(--coral-500)';
  }
  function statusLabel() {
    var o = state.outcome, urgent = state.secondsLeft < 30 && !o;
    return o === 'accepted' ? 'RESERVA CONFIRMADA' : o === 'rejected' ? 'RESERVA RECUSADA' : o === 'expired' ? 'TEMPO ESGOTADO'
      : o === 'cancelled' ? 'RESERVA CANCELADA' : urgent ? 'EXPIRA EM SEGUNDOS' : 'AGUARDANDO ACEITE';
  }
  function updateUrgency() {
    var dw = $('dw'), urgent = state.secondsLeft < 30 && !state.outcome;
    dw.classList.toggle('is-urgent', urgent);
    dw.style.setProperty('--accent', accentOf());
    var st = $('dw-status-txt'); if (st) st.textContent = statusLabel();
    var sub = $('dw-subtle'); if (sub) sub.textContent = urgent ? 'O lava-rápido está prestes a responder' : 'O lava-rápido tem até 3 min pra aceitar';
  }
  function renderWaiting() {
    var a = state.appt, dw = $('dw');
    dw.style.setProperty('--accent', accentOf());
    if (state.outcome) { renderResult(); return; }
    var price = a.service && a.service.price != null ? 'R$ ' + money(a.service.price, 2) : null;
    var dur = Number(a.service && a.service.duration) > 0 ? ' · ' + a.service.duration + ' min' : '';
    $('dw-in').innerHTML =
      '<div class="dw-head"><div class="dw-status"><span class="dw-dot"></span><span id="dw-status-txt">' + statusLabel() + '</span></div>' +
        '<h2 class="dw-shop">' + esc(a.car_wash.name) + '</h2></div>' +
      '<div class="dw-hero"><div class="dw-stage"><span class="dw-ring"></span><span class="dw-halo"></span>' +
        '<span class="dw-count" id="dw-count" role="timer" aria-label="Tempo restante">' + mmss(state.secondsLeft) + '</span></div>' +
        '<div class="dw-subtle" id="dw-subtle">O lava-rápido tem até 3 min pra aceitar</div></div>' +
      '<div class="dw-card">' +
        '<div class="dw-row"><span>Serviço</span><b>' + esc(a.service.title || '—') + '</b></div>' +
        '<div class="dw-row"><span>Horário</span><b>' + fmtTime(a.slot) + dur + '</b></div>' +
        (price ? '<div class="dw-row"><span>Na chegada</span><b style="color:var(--coral-500)">' + price + '</b></div>' : '') +
        // Cancelar exige SEGURAR 2,5s: com um alvo voando pela tela, um toque
        // perdido na caça ao passarinho não pode desfazer a reserva.
        '<button type="button" class="dw-cancel" id="dw-cancel" aria-label="Cancelar reserva. Mantenha pressionado por dois segundos e meio">' +
          '<i></i><span id="dw-cancel-txt">Segure para cancelar</span></button>' +
      '</div>' +
      '<p class="dw-reassure">Você não é cobrado se a reserva não for aceita</p>' +
      '<div class="dw-game" id="dw-game"></div>';
    bindCancel();
    renderScore();
    updateUrgency();
  }
  function renderResult() {
    var o = state.outcome, name = (state.appt && state.appt.car_wash && state.appt.car_wash.name) || 'O lava-rápido';
    var r = o === 'accepted'
      ? { t: 'Reserva confirmada', s: 'Seu horário está garantido. É só chegar, e o pagamento é no local.', cta: 'Ir para agendamento', go: 'appt' }
      : o === 'expired'
      ? { t: 'Tempo esgotado', s: name + ' não respondeu dentro dos 3 minutos e o horário foi liberado. Você não foi cobrado.', cta: 'Buscar outro lava-rápido', go: 'list' }
      : o === 'rejected'
      ? { t: 'Reserva recusada', s: name + ' não pôde atender agora. Você não foi cobrado.', cta: 'Buscar outro lava-rápido', go: 'list' }
      : { t: 'Reserva cancelada', s: 'O horário foi liberado e você não foi cobrado.', cta: 'Buscar outro lava-rápido', go: 'list' };
    $('dw-in').innerHTML = '<div class="dw-result' + (o === 'accepted' ? ' is-ok' : '') + '">' +
      (o === 'accepted' ? '<div class="dw-mark">' + icon('check', 20) + '</div>'
        : '<img src="' + ILL + 'reserva-vazia.svg" alt="Ilustração de um carro parado com bolhas de espuma, um relógio e um passarinho pousado no teto">') +
      '<h2>' + r.t + '</h2><p>' + esc(r.s) + '</p>' +
      '<div><button type="button" class="dw-cta" data-result="' + r.go + '">' + r.cta + icon('arrow-right', 15) + '</button></div></div>';
    var b = document.querySelector('.dw-cta'); if (b) b.focus();
  }
  function closeWaiting() {
    stopPolling(); bird.stop();
    state.appt = null; state.outcome = null;
    $('dw').classList.remove('is-on', 'is-urgent');
    document.documentElement.style.overflow = '';
  }

  // Segurar pra cancelar (mouse, toque e teclado).
  function bindCancel() {
    var btn = $('dw-cancel'), timer = null;
    var start = function (e) {
      if (e && e.type === 'keydown') { if (e.key !== ' ' && e.key !== 'Enter') return; if (e.repeat) return; e.preventDefault(); }
      if (timer) return;
      btn.classList.add('is-holding'); $('dw-cancel-txt').textContent = 'Solte para manter a reserva';
      timer = setTimeout(function () { timer = null; giveUp(); }, 2500);
    };
    var stop = function (e) {
      if (e && e.type === 'keyup' && e.key !== ' ' && e.key !== 'Enter') return;
      if (!timer) return;
      clearTimeout(timer); timer = null;
      btn.classList.remove('is-holding'); $('dw-cancel-txt').textContent = 'Segure para cancelar';
    };
    btn.addEventListener('pointerdown', start);
    ['pointerup', 'pointerleave', 'pointercancel'].forEach(function (ev) { btn.addEventListener(ev, stop); });
    btn.addEventListener('keydown', start); btn.addEventListener('keyup', stop);
    btn.addEventListener('contextmenu', function (e) { e.preventDefault(); });
  }
  function giveUp() {
    var id = state.appt && state.appt.id;
    closeWaiting();
    if (id) api('/disponivel/' + id + '/cancel', { method: 'PATCH' }).catch(function () {});
    toast('Reserva desistida. Horário liberado.', 'error');
    load(true);
  }

  // ── passarinho (porte do jogo do app) ────────────────────────────────────
  // Entra por um canto, faz curvas, sai por outro e volta depois de uma pausa.
  // Pegar sobe o nível: mais rápido, mais curvas, menos folga de mira.
  var record = 0; try { record = Number(localStorage.getItem(RECORD_KEY)) || 0; } catch (e) {}
  var level = 0;
  function renderScore() {
    var g = $('dw-game'); if (!g) return;
    g.innerHTML = level === 0 ? '<span class="dw-tip">toque no passarinho</span>'
      : '<span class="dw-score"><img src="' + ILL + 'voo-abertas.svg" alt="">' + level + (level >= record ? '<em>recorde</em>' : '') + '</span>';
  }
  function difficulty(n) {
    var fall = function (from, floor, rate) { return floor + (from - floor) * Math.pow(rate, n); };
    return { dur: fall(7200, 1750, .82), pause: fall(1900, 280, .80), turns: Math.min(6, 1 + Math.floor(n / 2.2)),
      rough: Math.min(.55, .15 + n * .03), slack: Math.max(0, 16 - n * 2), trail: Math.max(.20, .5 - n * .03) };
  }
  function sampleRoute(pts, per) {
    var n = pts.length - 1, segs = [];
    var clip = function (b, vx, vy, cap, sign) { var m = Math.hypot(vx, vy), k = m > cap ? cap / m : 1; return { x: b.x + sign * vx * k, y: b.y + sign * vy * k }; };
    for (var s = 0; s < n; s++) {
      var prev = pts[Math.max(0, s - 1)], p0 = pts[s], p3 = pts[s + 1], next = pts[Math.min(n, s + 2)];
      var cap = Math.hypot(p3.x - p0.x, p3.y - p0.y) / 3;
      segs.push({ p0: p0, p3: p3, p1: clip(p0, (p3.x - prev.x) / 6, (p3.y - prev.y) / 6, cap, 1), p2: clip(p3, (next.x - p0.x) / 6, (next.y - p0.y) / 6, cap, -1) });
    }
    var x = [], y = [], ang = [];
    var push = function (sg, u) {
      var v = 1 - u, p0 = sg.p0, p1 = sg.p1, p2 = sg.p2, p3 = sg.p3;
      x.push(v*v*v*p0.x + 3*v*v*u*p1.x + 3*v*u*u*p2.x + u*u*u*p3.x);
      y.push(v*v*v*p0.y + 3*v*v*u*p1.y + 3*v*u*u*p2.y + u*u*u*p3.y);
      var dx = 3*v*v*(p1.x-p0.x) + 6*v*u*(p2.x-p1.x) + 3*u*u*(p3.x-p2.x), dy = 3*v*v*(p1.y-p0.y) + 6*v*u*(p2.y-p1.y) + 3*u*u*(p3.y-p2.y);
      ang.push(Math.hypot(dx, dy) < 1e-6 && ang.length ? ang[ang.length - 1] : Math.atan2(dy, dx) * 180 / Math.PI);
    };
    for (var i = 0; i < n; i++) for (var k = 0; k < per; k++) push(segs[i], k / per);
    push(segs[n - 1], 1);
    for (var j = 1; j < ang.length; j++) { while (ang[j] - ang[j-1] > 180) ang[j] -= 360; while (ang[j] - ang[j-1] < -180) ang[j] += 360; }
    var acc = [0]; for (var q = 1; q < x.length; q++) acc.push(acc[q-1] + Math.max(Math.hypot(x[q]-x[q-1], y[q]-y[q-1]), 1e-4));
    var tot = acc[acc.length - 1] || 1;
    return { t: acc.map(function (v) { return v / tot; }), x: x, y: y, ang: ang };
  }
  function at(c, t) {
    t = Math.min(1, Math.max(0, t)); var i = 0;
    while (i < c.t.length - 2 && c.t[i + 1] < t) i++;
    var f = (t - c.t[i]) / (c.t[i + 1] - c.t[i] || 1);
    return { x: c.x[i] + (c.x[i+1] - c.x[i]) * f, y: c.y[i] + (c.y[i+1] - c.y[i]) * f, a: c.ang[i] + (c.ang[i+1] - c.ang[i]) * f };
  }
  var bird = (function () {
    var W = 56, H = 92, raf = null, timer = null, el = null, imgs = null, route = null, t0 = 0, d = null, caught = false, running = false, trail = [];
    function sky() { return $('dw-sky'); }
    function rand(a, b) { return a + Math.random() * (b - a); }
    function edge(w, h, which) {
      return which === 0 ? { x: rand(.1, .8) * w, y: -H - 30 } : which === 1 ? { x: w + 30, y: rand(.15, .75) * h }
        : which === 2 ? { x: rand(.1, .8) * w, y: h + 30 } : { x: -W - 30, y: rand(.15, .75) * h };
    }
    function newRoute(w, h, dd) {
      var p0, pf, len, dx, dy;
      for (var k = 0; k < 8; k++) {
        p0 = edge(w, h, Math.floor(Math.random() * 4)); pf = edge(w, h, Math.floor(Math.random() * 4));
        dx = pf.x - p0.x; dy = pf.y - p0.y; len = Math.hypot(dx, dy);
        if (len > .5 * Math.max(w, h)) break;
      }
      len = len || 1;
      var nx = -dy / len, ny = dx / len, pts = [p0], side = Math.random() < .5 ? 1 : -1, gap = len / (dd.turns + 1);
      var room = function (b, ux, uy) {
        var m = Infinity;
        if (ux > 1e-6) m = Math.min(m, (w - 34 - b.x) / ux); else if (ux < -1e-6) m = Math.min(m, (b.x - 34) / -ux);
        if (uy > 1e-6) m = Math.min(m, (h - 74 - b.y) / uy); else if (uy < -1e-6) m = Math.min(m, (b.y - 74) / -uy);
        return Math.max(0, m);
      };
      for (var i = 1; i <= dd.turns; i++) {
        var u = i / (dd.turns + 1), off = rand(-.28, .28) * gap;
        var base = { x: p0.x + dx * u + (dx / len) * off, y: p0.y + dy * u + (dy / len) * off };
        var amp = Math.min(rand(.5, 1) * dd.rough * gap, room(base, nx * side, ny * side));
        pts.push({ x: base.x + nx * side * amp, y: base.y + ny * side * amp }); side = -side;
      }
      pts.push(pf);
      var c = sampleRoute(pts, 10);
      return { c: c, step: Math.max(2, Math.round(c.t.length / 14)) };
    }
    function ensureEl() {
      if (el && el.isConnected) return;
      el = document.createElement('button');
      el.type = 'button'; el.className = 'dw-bird'; el.setAttribute('aria-label', 'Pegar o passarinho');
      el.innerHTML = ['voo-abertas', 'voo-meio', 'voo-levantadas'].map(function (n) { return '<img src="' + ILL + n + '.svg" alt="">'; }).join('');
      imgs = el.querySelectorAll('img');
      el.addEventListener('pointerdown', function (e) { e.preventDefault(); catchIt(); });
      el.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); catchIt(); } });
      sky().appendChild(el);
    }
    function clearTrail() { trail.forEach(function (x) { x.el.remove(); }); trail = []; }
    function trip() {
      if (!running) return;
      var s = sky(), w = s.clientWidth, h = s.clientHeight;
      d = difficulty(level); route = newRoute(w, h, d); caught = false;
      ensureEl(); clearTrail();
      el.style.setProperty('--slack', d.slack + 'px');
      el.style.width = (W + 2 * d.slack) + 'px'; el.style.height = (H + 2 * d.slack) + 'px';
      route.c.t.forEach(function (tp, k) {
        if (k % route.step !== 1 || k >= route.c.t.length - 1) return;
        var dot = document.createElement('span'); dot.className = 'dw-trail';
        dot.style.left = (route.c.x[k] + 20) + 'px'; dot.style.top = (route.c.y[k] + 44) + 'px';
        dot.style.transform = 'rotate(' + route.c.ang[k].toFixed(1) + 'deg)';
        s.insertBefore(dot, el); trail.push({ el: dot, tp: tp });
      });
      el.style.opacity = '1';
      t0 = performance.now();
      cancelAnimationFrame(raf); raf = requestAnimationFrame(frame);
    }
    function frame(now) {
      if (!running || caught) return;
      var t = (now - t0) / d.dur;
      if (t >= 1) { el.style.opacity = '0'; clearTrail(); timer = setTimeout(trip, d.pause); return; }
      var p = at(route.c, t);
      el.style.transform = 'translate(' + (p.x - d.slack) + 'px,' + (p.y - d.slack) + 'px) rotate(' + p.a.toFixed(1) + 'deg)';
      // Asas: abertas → meio → levantadas → meio, troca seca de quadro.
      var period = Math.max(130, Math.min(300, d.dur / 26)) * 2, ph = ((now - t0) % period) / period;
      var f = ph < .33 ? 0 : ph < .5 ? 1 : ph < .83 ? 2 : 1;
      for (var i = 0; i < 3; i++) imgs[i].classList.toggle('on', i === f);
      // Rastro tracejado: cada traço acende quando ele passa e apaga devagar.
      trail.forEach(function (x) {
        var o = t < x.tp ? 0 : t < x.tp + .02 ? .6 * (t - x.tp) / .02 : t < x.tp + d.trail ? .6 * (1 - (t - x.tp) / d.trail) : 0;
        x.el.style.opacity = o.toFixed(3);
      });
      raf = requestAnimationFrame(frame);
    }
    function catchIt() {
      if (!running || caught || !route) return;
      caught = true; cancelAnimationFrame(raf);
      var p = at(route.c, (performance.now() - t0) / d.dur);
      puff(p.x + W / 2, p.y + H / 2);
      el.style.opacity = '0';
      trail.forEach(function (x) { x.el.style.transition = 'opacity .38s'; x.el.style.opacity = '0'; });
      setTimeout(clearTrail, 400);
      level += 1;
      if (level > record) { record = level; try { localStorage.setItem(RECORD_KEY, String(record)); } catch (e) {} }
      renderScore();
      timer = setTimeout(trip, difficulty(level).pause * .55);
    }
    function puff(x, y) {
      var s = sky(), ring = document.createElement('span');
      ring.className = 'dw-puff-ring'; ring.style.left = (x - 34) + 'px'; ring.style.top = (y - 34) + 'px'; s.appendChild(ring);
      [[-36, -24], [31, -32], [44, 9], [-41, 14], [-7, -46], [13, 40]].forEach(function (v) {
        var f = document.createElement('span'); f.className = 'dw-feather';
        f.style.left = x + 'px'; f.style.top = y + 'px'; f.style.setProperty('--fx', v[0] + 'px'); f.style.setProperty('--fy', v[1] + 'px');
        s.appendChild(f); setTimeout(function () { f.remove(); }, 600);
      });
      setTimeout(function () { ring.remove(); }, 600);
    }
    return {
      start: function () {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        running = true; level = 0; renderScore(); timer = setTimeout(trip, 600);
      },
      stop: function () { running = false; cancelAnimationFrame(raf); clearTimeout(timer); clearTrail(); if (el) el.style.opacity = '0'; }
    };
  })();

  // ── eventos ──────────────────────────────────────────────────────────────
  document.addEventListener('click', function (e) {
    var t;
    if ((t = e.target.closest('[data-open]'))) { var it = state.items.find(function (x) { return String(x.car_wash.id) === t.dataset.open; }); if (it) openSheet(it); return; }
    if ((t = e.target.closest('[data-sort]'))) { state.sortBy = t.dataset.sort; render(); return; }
    if ((t = e.target.closest('[data-svc]'))) { state.selectedId = Number(t.dataset.svc); renderSheet(); return; }
    if (e.target.closest('#dp-close')) { closeSheet(); return; }
    if (e.target.id === 'dp-sheet-bg') { closeSheet(); return; }
    if (e.target.closest('#dp-confirm')) { confirmReserve(); return; }
    if (e.target.closest('#dp-retry')) { retryLocation(); return; }
    if ((t = e.target.closest('[data-result]'))) {
      if (t.dataset.result === 'appt') { location.href = '<%= appointments_path %>'; return; }
      closeWaiting(); load(true);
    }
  });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && state.target && !$('dp-sheet-bg').hidden) closeSheet(); });
  // Contagem "em Xmin" dos cards se atualiza sozinha (como o app, a cada 15s).
  setInterval(function () { if (!state.appt && !state.loading && state.loc === 'granted') render(); }, 15000);

  function boot() { if (window.feather) feather.replace(); render(); initLocation(); }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot); else boot();
})();
</script>
