<%#
  Disponível (last minute) — porte da DisponivelScreen do app
  (LoovApp/src/screens/DisponivelScreen.js), consumindo os mesmos endpoints:
    GET   /disponivel(.json)          lista (5 km · próximos 30 min)
    POST  /disponivel                 cria a reserva (pending_acceptance)
    GET   /disponivel/:id             status (polling)
    PATCH /disponivel/:id/cancel      desistir antes do aceite

  Fluxo: lista escura (Spotify) → folha "Reservar em" com o serviço →
  espera de até 3 min pelo aceite (contador vivo, cancelar SEGURANDO 2,5s,
  passarinho pra pegar enquanto espera) → desfecho.

  ?car_wash_id=X (vem do Last minute da home) ABRE a reserva desse
  lava-rápido por cima da lista inteira — não filtra, como no app: lista
  filtrada sem indicação nem saída deixava o cliente preso em uma loja.
%>
<%= render "shared/loov_logos" %>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@1,9..144,600,100,1&display=swap">
<script src="/vendor/feather-4.29.2.min.js"></script>
<%# Leaflet (BSD-2) hospedado aqui; mapa do OpenStreetMap, sem chave de API. %>
<link rel="stylesheet" href="/vendor/leaflet-1.9.4/leaflet.css">
<script src="/vendor/leaflet-1.9.4/leaflet.js"></script>

<style>
  /* Menu do topo é translúcido; sobre o fundo escuro ele ficava cinza. */
  .loov-nav { background: var(--cream) !important; }
  /* O CSS global põe overflow-x: hidden em html e body; isso transforma o
     body em área de rolagem e desliga o position: sticky do mapa. clip corta
     o excesso lateral do mesmo jeito, sem esse efeito. */
  html, body { overflow-x: clip !important; }
  .dp { --pad: 20px; background: var(--obsidian); color: var(--cream); min-height: 100vh; padding-top: 60px; }
  .dp *, .dp *::before, .dp *::after { box-sizing: border-box; }
  .dp button { font-family: inherit; line-height: normal; cursor: pointer; }
  .dp svg.feather { display: block; }
  .dp-col { width: 100%; max-width: 1240px; margin: 0 auto; }

  .dp-top { padding: 8px 16px; }
  .dp-back { width: 40px; height: 40px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.14); color: var(--cream) !important; text-decoration: none; transition: background .15s; }
  .dp-back:hover { background: rgba(255,255,255,.14); }

  .dp-hero { padding: 20px var(--pad) 4px; }
  .dp-badge { display: inline-flex; align-items: center; gap: 5px; padding: 5px 12px; border-radius: 100px; background: var(--coral-500); color: var(--cream); font-size: 12px; font-weight: 600; }
  .dp-title { margin: 14px 0 0 !important; color: var(--cream) !important; font-family: 'Space Grotesk', sans-serif !important; font-weight: 700; font-size: clamp(36px, 5vw, 64px); line-height: 1.05; letter-spacing: -0.035em; }
  .dp-title em { font-style: normal; color: var(--coral-500); }

  .dp-strip { display: flex; align-items: center; gap: 12px; margin: 24px var(--pad) 0; padding: 14px; border-radius: 16px; background: rgba(255,255,255,.06); max-width: 520px; }
  .dp-strip-ic { flex: 0 0 40px; height: 40px; border-radius: 12px; background: var(--coral-500); display: flex; align-items: center; justify-content: center; color: var(--cream); }
  .dp-strip b { display: block; font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 15px; letter-spacing: -0.2px; color: var(--cream); }
  .dp-strip span { display: block; margin-top: 2px; font-family: 'JetBrains Mono', monospace; font-size: 11px; color: #b5ae9f; }

  .dp-sort { display: flex; gap: 8px; padding: 20px var(--pad) 0; overflow-x: auto; scrollbar-width: none; }
  .dp-sort::-webkit-scrollbar { display: none; }
  .dp-chip { flex-shrink: 0; display: inline-flex; align-items: center; gap: 6px; padding: 8px 14px; border-radius: 100px; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.12); color: rgba(250,250,246,.7); font-size: 12px; font-weight: 600; transition: background .15s, color .15s; }
  .dp-chip:hover { background: rgba(255,255,255,.1); }
  .dp-chip[aria-pressed="true"] { background: var(--cream); border-color: var(--cream); color: var(--obsidian); }

  .dp-list { display: grid; grid-template-columns: 1fr; gap: 14px; padding: 20px var(--pad) 80px; }
  .dp-card.is-hot { box-shadow: 0 0 0 2px var(--coral-500), 0 18px 32px rgba(0,0,0,.35); }
  .dp-stat b small { font-size: 15px; letter-spacing: 0; margin-right: 3px; font-weight: 600; }
  .dp-when { color: var(--coral-500); font-weight: 600; }

  /* Mapa: lista + mapa lado a lado no desktop (Uber/Airbnb); no celular,
     alterna com o botão flutuante "Mapa"/"Lista". */
  .dp-split { position: relative; }
  .dp-mapcol { display: none; }
  .dp-map { width: 100%; height: 100%; border-radius: 24px; overflow: hidden; background: #e9e5dc; }
  .dp-map .leaflet-tile-pane { filter: grayscale(.85) sepia(.18) brightness(1.04) contrast(.92); }
  .dp-map .leaflet-control-attribution { font-size: 10px; background: rgba(250,250,246,.85); }
  .dp-pin { transform: translate(-50%, -100%); display: inline-flex; align-items: center; justify-content: center; white-space: nowrap; padding: 6px 11px; border-radius: 99px; background: var(--paper); color: var(--ink); font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 13px; letter-spacing: -0.2px; box-shadow: 0 4px 14px rgba(26,22,18,.28); border: 1px solid rgba(26,22,18,.08); cursor: pointer; transition: transform .15s, background .15s, color .15s; }
  .dp-pin::after { content: ""; position: absolute; left: 50%; bottom: -5px; width: 10px; height: 10px; background: inherit; transform: translateX(-50%) rotate(45deg); border-right: 1px solid rgba(26,22,18,.08); border-bottom: 1px solid rgba(26,22,18,.08); border-radius: 0 0 2px 0; }
  .dp-pin.is-hot { background: var(--coral-500); color: var(--cream); transform: translate(-50%, -100%) scale(1.12); z-index: 1000; }
  .dp-pin-wrap.is-hot { z-index: 1000 !important; }
  .dp-me { width: 18px; height: 18px; border-radius: 50%; background: var(--pool-500); border: 3px solid #fff; box-shadow: 0 0 0 6px rgba(75,142,192,.25); }
  .dp-maptoggle { position: fixed; left: 50%; bottom: 24px; z-index: 120; transform: translateX(-50%); display: none; align-items: center; gap: 8px; padding: 13px 20px; border: 0; border-radius: 99px; background: var(--cream); color: var(--obsidian); font-size: 14px; font-weight: 600; box-shadow: 0 10px 28px rgba(0,0,0,.4); }
  .dp.has-items .dp-maptoggle { display: inline-flex; }
  .dp.map-mode .dp-left { display: none; }
  .dp.map-mode .dp-mapcol { display: block; height: calc(100vh - 140px); padding: 12px var(--pad) 90px; }
  .dp-card { position: relative; display: block; width: 100%; text-align: left; border: 0; padding: 0; border-radius: 22px; overflow: hidden; background: var(--ink); color: var(--cream); box-shadow: 0 6px 16px rgba(40,35,28,.15); transition: transform .2s ease, box-shadow .2s ease; }
  .dp-card:hover { transform: translateY(-3px); box-shadow: 0 18px 32px rgba(0,0,0,.35); }
  .dp-card:focus-visible { outline: 2px solid var(--coral-500); outline-offset: 3px; }
  .dp-stats { display: flex; align-items: center; padding: 20px 8px 18px; border-bottom: 1px solid rgba(250,250,246,.08); }
  .dp-stat { flex: 1; text-align: center; }
  /* Números em creme: dois destaques em coral lado a lado disputavam a atenção. */
  .dp-stat b { display: block; font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 32px; line-height: 36px; letter-spacing: -1px; color: var(--cream); }
  .dp-stat span { display: block; margin-top: 8px; font-family: 'JetBrains Mono', monospace; font-size: 9px; letter-spacing: 1.6px; color: rgba(250,250,246,.55); }
  .dp-div { width: 1px; height: 48px; background: rgba(250,250,246,.12); }
  .dp-shop { display: flex; align-items: center; gap: 14px; padding: 14px 18px; }
  .dp-logo { flex: 0 0 48px; height: 48px; border-radius: 12px; overflow: hidden; }
  .dp-logo svg { width: 100%; height: 100%; display: block; }
  .dp-shop-txt { flex: 1; min-width: 0; }
  .dp-shop-name { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 17px; line-height: 21px; letter-spacing: -0.3px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .dp-shop-meta { margin-top: 4px; font-size: 12px; line-height: 16px; color: rgba(250,250,246,.55); }
  .dp-cd { color: var(--coral-500); font-weight: 600; letter-spacing: .2px; }
  .dp-fav { flex: 0 0 26px; height: 26px; border-radius: 50%; background: rgba(250,250,246,.08); display: flex; align-items: center; justify-content: center; color: rgba(250,250,246,.5); }
  .dp-chev { color: rgba(250,250,246,.35); transition: transform .2s; }
  .dp-card:hover .dp-chev { transform: translateX(3px); color: rgba(250,250,246,.6); }
  /* Selo Hora Off: o relógio com a seta pra baixo, num tom de coral que se lê
     no cartão escuro. A Hora Pico não tem selo: o cliente vê só o preço. */
  .dp-off { flex-shrink: 0; width: 22px; height: 22px; border-radius: 50%; background: rgba(232,154,124,.18); color: #e89a7c; display: inline-flex; align-items: center; justify-content: center; }
  .dp-rate { flex-shrink: 0; display: inline-flex; align-items: center; gap: 4px; padding: 4px 8px; border-radius: 100px; background: rgba(250,250,246,.08); font-size: 11px; font-weight: 600; }

  .dp-state { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 56px var(--pad) 80px; }
  .dp-state img { width: 72%; max-width: 320px; height: auto; margin-bottom: 6px; }
  .dp-state h2 { margin: 14px 0 6px !important; color: var(--cream) !important; font-family: 'Inter', sans-serif !important; font-size: 16px; font-weight: 700; letter-spacing: 0; }
  .dp-state p { margin: 0; max-width: 420px; color: #b5ae9f; font-size: 13px; line-height: 19px; }
  .dp-state .dp-btn { margin-top: 18px; }
  .dp-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 12px 22px; border: 0; border-radius: 100px; background: var(--ink); color: var(--cream) !important; font-size: 13.5px; font-weight: 600; text-decoration: none; transition: background .15s, transform .15s; }
  .dp-btn:hover { background: #3a342b; }
  .dp-spin { width: 22px; height: 22px; border-radius: 50%; border: 2.5px solid rgba(221,120,82,.25); border-top-color: var(--coral-500); animation: dp-rot .8s linear infinite; }
  @keyframes dp-rot { to { transform: rotate(360deg); } }


  /* ── Espera / desfecho ────────────────────────────────────────────────── */
  .dw { position: fixed; inset: 60px 0 0 0; z-index: 150; background: var(--cream); color: var(--ink); overflow: hidden auto; display: none; }
  .dw.is-on { display: block; }
  .dw-in { position: relative; z-index: 1; max-width: 460px; margin: 0 auto; min-height: 100%; padding: 0 20px 24px; display: flex; flex-direction: column; }
  /* Espera do aceite: o espelho do placar do lava-rápido. Abre com o topo
     escuro da folha de reserva, o relógio dos 3 minutos em número grande, a
     frase em destaque, a barra secando junto com a do lava-rápido e as mesmas
     linhas com fio de tinta. No celular o topo ocupa a altura que sobra e as
     linhas ficam no pé da tela, sem vão; relógio e respiros seguem a altura. */
  .dw-esp { flex: 1; display: flex; flex-direction: column; }
  .dw-faixa { flex: 1; display: flex; flex-direction: column; margin: 0 -20px; padding: clamp(14px, 3vh, 24px) 22px 18px; background: var(--obsidian, #1a1612); color: var(--cream); border-radius: 0 0 28px 28px; }
  .dw-meio { margin-block: auto; padding-block: clamp(8px, 2vh, 18px); }
  .dw-vivo { display: flex; justify-content: space-between; align-items: center; gap: 12px; font-family: 'JetBrains Mono', monospace; font-size: 10.5px; letter-spacing: 1.4px; text-transform: uppercase; color: var(--ash); }
  .dw-vivo > span:first-child { display: inline-flex; align-items: center; gap: 7px; min-width: 0; color: var(--cream); }
  .dw-dot { flex: 0 0 7px; height: 7px; border-radius: 50%; background: var(--coral-500); animation: dw-blink 1.6s ease-in-out infinite; }
  @keyframes dw-blink { 50% { opacity: .25; } }
  .dw-rel { display: block; margin-left: -3px; font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: clamp(64px, min(27vw, 14vh), 112px); line-height: 1.05; letter-spacing: -0.045em; font-variant-numeric: tabular-nums; }
  .dw-frase { margin: 2px 0 0; font-family: 'Fraunces', Georgia, serif; font-style: italic; font-weight: 600; font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 144; font-size: clamp(24px, min(8.4vw, 4.4vh), 34px); line-height: 1.15; letter-spacing: -0.02em; color: var(--coral-500); overflow-wrap: anywhere; }
  .dw-passos { display: flex; gap: 6px; font-size: 12px; color: var(--ash); }
  .dw-passos > span { flex: 1; display: grid; gap: 4px; }
  /* A caixa tem a altura do carro, com o trilho no meio: os três passos
     ficam alinhados mesmo só o do meio tendo carro. */
  .dw-passos u { position: relative; display: flex; align-items: center; height: 14px; text-decoration: none; }
  .dw-passos i { display: block; flex: 1; height: 3px; border-radius: 2px; background: rgba(250,250,246,.18); overflow: hidden; }
  .dw-passos .feito i { background: var(--cream); }
  .dw-passos .agora { color: var(--cream); }
  /* A barra enche da esquerda pra direita, rumo a "Sua vaga", puxada por um
     carro visto de cima. O carro anda só dentro do trilho: sai com a traseira
     no começo e chega com a frente no fim. */
  .dw-passos b { display: block; height: 100%; background: var(--coral-500); transition: width 1s linear; }
  .dw-carro { position: absolute; top: 0; width: 28px; height: 14px; color: var(--coral-500); transition: left 1s linear, transform 1s linear; }
  .dw-carro svg { display: block; }
  .dw.is-urgent .dw-frase { color: var(--rose-500); }
  .dw.is-urgent .dw-dot, .dw.is-urgent .dw-passos b { background: var(--rose-500); }
  .dw.is-urgent .dw-carro { color: var(--rose-500); }
  /* Linhas do placar: rótulo em mono, valor na fonte de título, fio de tinta. */
  .dw-linhas { padding-top: clamp(6px, 1.4vh, 12px); }
  .dw-lp { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: clamp(8px, 1.4vh, 11px) 0; border-top: 2px solid var(--ink); }
  .dw-lp:first-child { border-top: 0; }
  .dw-lp span { flex-shrink: 0; font-family: 'JetBrains Mono', monospace; font-size: 10.5px; letter-spacing: 1.2px; text-transform: uppercase; color: var(--graphite); }
  .dw-lp b { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-align: right; font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 15px; color: var(--ink); font-variant-numeric: tabular-nums; }
  /* Deslizar para cancelar: arrastar a bolinha até 90% da trilha cancela;
     soltar antes volta com mola. Teclado (Enter ou espaço) cancela direto. */
  .dw-desl { position: relative; height: 56px; margin-top: 8px; border-radius: 999px; border: 2px solid var(--ink); overflow: hidden; touch-action: none; user-select: none; -webkit-user-select: none; }
  .dw-desl-r { position: absolute; left: 0; top: 0; bottom: 0; width: 52px; background: color-mix(in srgb, var(--rose-500) 16%, transparent); }
  .dw-desl-t { position: absolute; inset: 0 0 0 48px; display: flex; align-items: center; justify-content: center; gap: 6px; color: var(--rose-500); font-size: 14.5px; font-weight: 600; pointer-events: none; }
  .dw-desl-t em { font-style: normal; letter-spacing: 2px; opacity: .55; }
  .dw-bola { position: absolute; left: 4px; top: 4px; width: 44px; height: 44px; padding: 0; border: 0; border-radius: 50%; background: var(--rose-500); color: var(--cream); display: flex; align-items: center; justify-content: center; cursor: grab; touch-action: none; }
  .dw-bola:active { cursor: grabbing; }
  .dw-bola:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .dw-desl.volta .dw-bola { transition: transform .45s cubic-bezier(.3,1.5,.5,1); }
  .dw-desl.volta .dw-desl-r { transition: width .45s cubic-bezier(.3,1.5,.5,1); }
  .dw-desl.volta .dw-desl-t { transition: opacity .3s; }

  /* Desfecho sem reserva: o mesmo molde do placar, em creme. */
  .dw-fim { padding-top: clamp(14px, 3vh, 24px); }
  .dw-fim .dw-vivo { color: var(--graphite); }
  .dw-fim .dw-vivo > span:first-child { color: var(--graphite); }
  .dw-fim .dw-vivo .is-rec { color: var(--rose-500); }
  .dw-fim .dw-rel { margin-left: 0; line-height: 1.05; font-size: clamp(56px, min(23vw, 12vh), 96px); color: var(--ink); }
  .dw-fim .dw-frase { color: var(--ink); }
  .dw-fim .dw-frase.riscada { color: var(--ash); text-decoration: line-through; text-decoration-thickness: 2px; font-size: clamp(19px, min(6.4vw, 3.4vh), 26px); }
  .dw-fim-txt { margin: 12px 0 0; max-width: 36ch; font-size: 14.5px; line-height: 21px; color: var(--graphite); }
  .dw-fim .dw-lp { margin-top: clamp(12px, 2.4vh, 18px); border-top: 2px solid var(--ink); }
  .dw-cta { display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; height: 52px; margin-top: clamp(14px, 2.8vh, 22px); border: 0; border-radius: 28px; background: var(--ink); color: var(--cream); font-size: 15.5px; font-weight: 600; }
  .dw-cta:hover { background: #3a342b; }
  .dw-fim > * { animation: dw-surge .6s cubic-bezier(.2,.8,.2,1) both; }
  .dw-fim > :nth-child(2) { animation-delay: .06s; }
  .dw-fim > :nth-child(3), .dw-fim > :nth-child(4) { animation-delay: .14s; }
  .dw-fim > :nth-child(5) { animation-delay: .22s; }
  .dw-fim > :nth-child(6), .dw-fim > :nth-child(7) { animation-delay: .3s; }
  @keyframes dw-surge { from { opacity: 0; transform: translateY(16px); } }
  /* "Agendado" dentro da espera: a .dw-in já dá o respiro dos lados, e a
     margem automática centra o bloco na altura livre, sem buraco entre o
     cartão e os botões. */
  .dw-in > .ok { width: 100%; padding: 22px 0 0; margin: auto 0; }
  /* Tela larga: a faixa deixa de sangrar e vira um bloco arredondado. */
  @media (min-width: 520px) {
    .dw-in { padding-top: 24px; }
    .dw-esp { flex: none; margin-block: auto; }
    .dw-faixa { flex: none; margin: 0; border-radius: 28px; }
  }

  .dp-toast { position: fixed; left: 50%; bottom: 28px; z-index: 300; transform: translate(-50%, 20px); opacity: 0; display: inline-flex; align-items: center; gap: 8px; max-width: calc(100% - 32px); padding: 12px 16px; border-radius: 14px; background: var(--paper); border: 1px solid var(--stone); box-shadow: 0 12px 30px rgba(0,0,0,.25); color: var(--coral-500); font-size: 13px; font-weight: 600; transition: opacity .2s, transform .2s; }
  .dp-toast.is-on { opacity: 1; transform: translate(-50%, 0); }
  .dp-toast.is-err { color: var(--rose-500); }

  /* ── Responsivo ───────────────────────────────────────────────────────── */
  @media (min-width: 640px) {
    .dp-list { grid-template-columns: repeat(auto-fill, minmax(330px, 1fr)); gap: 18px; }
  }
  @media (min-width: 1100px) {
    .dp-split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(380px, 44%); gap: 8px; align-items: start; }
    /* Ao lado do mapa: uma coluna de cards largos até ~1500px; 2 colunas em
       telas grandes. Em 2 colunas estreitas os nomes cortavam. */
    .dp-left .dp-list { grid-template-columns: repeat(auto-fill, minmax(380px, 1fr)); padding-right: 12px; }
    .dp-mapcol, .dp.map-mode .dp-mapcol { display: block; position: sticky; top: 76px; height: calc(100vh - 92px); padding: 20px var(--pad) 16px 0; }
    .dp.map-mode .dp-left { display: block; }
    .dp.has-items .dp-maptoggle { display: none; }
  }
  @media (min-width: 900px) {
    .dp { --pad: 48px; }
    .dp-top { padding: 16px 40px 0; }
    .dp-hero { padding-top: 36px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .dw-dot, .dw-fim > * { animation: none; }
    .dw-passos b, .dw-carro, .dw-desl.volta .dw-bola, .dw-desl.volta .dw-desl-r { transition: none; }
  }
</style>

<div class="dp" id="dp">
  <div class="dp-col dp-top">
    <a href="/" class="dp-back" aria-label="Voltar pra home"><i data-feather="chevron-left" style="width:18px;height:18px"></i></a>
  </div>

  <main class="dp-col">
    <section class="dp-hero">
      <span class="dp-badge"><i data-feather="zap" style="width:12px;height:12px"></i>last minute</span>
      <h1 class="dp-title">Vagas <em>agora</em>, perto de você.</h1>
    </section>
    <div class="dp-split">
      <div class="dp-left">
        <div id="dp-strip"></div>
        <div class="dp-sort" id="dp-sort" role="group" aria-label="Ordenar"></div>
        <div id="dp-body"></div>
      </div>
      <aside class="dp-mapcol" aria-label="Mapa das vagas"><div class="dp-map" id="dp-map"></div></aside>
    </div>
  </main>
  <button type="button" class="dp-maptoggle" id="dp-maptoggle"><span id="dp-maptoggle-ic"></span><span id="dp-maptoggle-txt">Mapa</span></button>

  <%= render "shared/site_footer", audience: (user_signed_in? ? :client : :visitor) %>
</div>

<%# Folha de reserva %>
<%= render "disponivel/folha_reserva" %>
<%= render "shared/confirmacao_agendamento" %>

<%# Espera pelo aceite / desfecho %>
<section class="dw" id="dw" aria-live="polite">
  <div class="dw-in" id="dw-in"></div>
</section>

<div class="dp-toast" id="dp-toast" role="status"></div>

<script>
(function () {
  var SORTS = [
    { key: 'relevance', label: 'Relevância',  icon: 'zap' },
    { key: 'distance',  label: 'Mais perto',  icon: 'map-pin' },
    { key: 'price',     label: 'Menor preço', icon: 'tag' }
  ];
  var ILL = '/illustrations/';
  var POLL_MS = 3000;
  var COORDS_KEY = 'loov_last_coords';
  var HORA_OFF_IC = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 12l3-3M12 12v5M9.8 14.8L12 17l2.2-2.2"/></svg>';

  var state = {
    loc: 'pending', coords: null, loading: true, items: [], sortBy: 'relevance',
    openId: null, target: null, selectedId: null, reserving: false,
    appt: null, secondsLeft: 0, outcome: null
  };

  // ── utilitários ──────────────────────────────────────────────────────────
  function $(id) { return document.getElementById(id); }
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
  function icon(n, size, extra) { return window.feather && feather.icons[n] ? feather.icons[n].toSvg(Object.assign({ width: size, height: size }, extra || {})) : ''; }
  function money(v, d) { var n = Number(v); return isFinite(n) ? n.toFixed(d || 0).replace('.', ',') : '—'; }
  function fmtTime(iso) { if (!iso) return ''; var d = new Date(iso); return String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0'); }
  function fmtDistance(km) { if (km == null) return null; return km < 1 ? Math.round(km * 1000) + ' m' : Number(km).toFixed(1).replace('.', ',') + ' km'; }
  function itemMinPrice(it) {
    var mp = Number(it && it.min_price); if (isFinite(mp) && mp > 0) return mp;
    var p = (it.services || []).map(function (s) { return Number(s.price); }).filter(isFinite);
    return p.length ? Math.min.apply(null, p) : Infinity;
  }
  function sortItems(list, by) {
    if (by === 'relevance') return list;
    var a = list.slice();
    if (by === 'distance') a.sort(function (x, y) { return (x.car_wash.distance_km == null ? Infinity : x.car_wash.distance_km) - (y.car_wash.distance_km == null ? Infinity : y.car_wash.distance_km); });
    if (by === 'price') a.sort(function (x, y) { return itemMinPrice(x) - itemMinPrice(y); });
    return a;
  }
  function validItems() { var now = Date.now(); return state.items.filter(function (it) { return it.slots && it.slots[0] && new Date(it.slots[0]).getTime() > now; }); }
  var toastT = null;
  function toast(text, type) {
    var t = $('dp-toast');
    t.className = 'dp-toast is-on' + (type === 'error' ? ' is-err' : '');
    t.innerHTML = icon(type === 'error' ? 'x-circle' : 'check-circle', 15) + '<span>' + esc(text) + '</span>';
    clearTimeout(toastT); toastT = setTimeout(function () { t.className = 'dp-toast' + (type === 'error' ? ' is-err' : ''); }, 3500);
  }
  function api(url, opts) {
    opts = opts || {};
    var csrf = (document.querySelector('meta[name="csrf-token"]') || {}).content;
    return fetch(url, Object.assign({ credentials: 'same-origin' }, opts, {
      headers: Object.assign({ Accept: 'application/json', 'Content-Type': 'application/json', 'X-CSRF-Token': csrf }, opts.headers || {})
    }));
  }

  // ── localização (URL → cache → GPS), como a home ─────────────────────────
  function initLocation() {
    var u = new URL(location.href), lat = parseFloat(u.searchParams.get('latitude')), lng = parseFloat(u.searchParams.get('longitude'));
    state.openId = u.searchParams.get('car_wash_id');
    var start = null;
    if (!isNaN(lat) && !isNaN(lng)) start = { latitude: lat, longitude: lng };
    else { try { var c = JSON.parse(localStorage.getItem(COORDS_KEY) || 'null'); if (c) start = { latitude: c.lat, longitude: c.lng }; } catch (e) {} }
    if (start) { state.coords = start; state.loc = 'granted'; load(); }
    if (!navigator.geolocation) { if (!start) { state.loc = 'error'; render(); } return; }
    navigator.geolocation.getCurrentPosition(function (pos) {
      var fresh = { latitude: pos.coords.latitude, longitude: pos.coords.longitude };
      try { localStorage.setItem(COORDS_KEY, JSON.stringify({ lat: fresh.latitude, lng: fresh.longitude })); } catch (e) {}
      if (!start) { state.coords = fresh; state.loc = 'granted'; load(); }
    }, function (err) {
      if (!start) { state.loc = err && err.code === 1 ? 'denied' : 'error'; render(); }
    }, { timeout: start ? 12000 : 8000, maximumAge: 300000 });
  }
  function retryLocation() { state.loc = 'pending'; render(); initLocation(); }

  // ── dados ────────────────────────────────────────────────────────────────
  function load(silent) {
    if (!silent) { state.loading = true; render(); }
    var q = state.coords ? '?latitude=' + state.coords.latitude + '&longitude=' + state.coords.longitude : '';
    return api('/disponivel' + q).then(function (r) { return r.json(); }).then(function (data) {
      var seen = {};
      state.items = (Array.isArray(data) ? data : []).filter(function (it) {
        var id = it.car_wash && it.car_wash.id; if (id == null || seen[id]) return false; seen[id] = true; return true;
      });
      // Veio do Last minute da home: abre a reserva dessa loja sobre a lista.
      if (state.openId) {
        var it = state.items.find(function (x) { return String(x.car_wash.id) === String(state.openId); });
        state.openId = null;
        var u = new URL(location.href); u.searchParams.delete('car_wash_id'); history.replaceState(null, '', u);
        if (it) setTimeout(function () { openSheet(it); }, 100);
      }
    }).catch(function () { state.items = []; }).finally(function () { state.loading = false; render(); });
  }

  // ── lista ────────────────────────────────────────────────────────────────
  // O horário das vagas é, quase sempre, o mesmo pra todas (a próxima marca
  // de 30 min). Repetir "22:00" gigante em todo card não ajuda a escolher:
  // ele sobe pro topo, uma vez, e o card destaca o que de fato diferencia —
  // distância e preço. Card com horário diferente do comum avisa.
  function commonSlot(list) {
    var count = {}, best = null;
    list.forEach(function (it) { var k = it.slots[0]; count[k] = (count[k] || 0) + 1; if (!best || count[k] > count[best]) best = k; });
    return best;
  }
  function priceLabel(it) {
    var p = itemMinPrice(it);
    if (!isFinite(p)) return '—';
    return '<small>R$</small>' + (Math.round(p) === p ? String(p) : money(p, 2));
  }
  function card(it, now, common) {
    var cw = it.car_wash, slot = new Date(it.slots[0]);
    var mins = Math.ceil((slot.getTime() - now) / 60000);
    var differs = common && it.slots[0] !== common;
    var street = cw.logradouro ? cw.logradouro + (cw.numero ? ', ' + cw.numero : '') : null;
    var reviews = Number(cw.reviews_count) || 0, rating = Number(cw.rating_avg) || 0;
    var meta = [street, cw.bairro].filter(Boolean).join(' · ') || '—';
    return '<button type="button" class="dp-card" data-open="' + cw.id + '" aria-label="Reservar em ' + esc(cw.name) + ', ' + fmtTime(it.slots[0]) + '">' +
      '<div class="dp-stats"><div class="dp-stat"><b>' + esc(fmtDistance(cw.distance_km) || '—') + '</b><span>DISTÂNCIA</span></div><div class="dp-div"></div>' +
      '<div class="dp-stat"><b>' + priceLabel(it) + '</b><span>A PARTIR DE</span></div></div>' +
      '<div class="dp-shop"><div class="dp-logo">' + LoovLogos.logoOf(cw) + '</div>' +
        '<div class="dp-shop-txt"><div class="dp-shop-name">' + esc(cw.name) + '</div>' +
        '<div class="dp-shop-meta">' + esc(meta) + (differs ? ' · <span class="dp-when">às ' + fmtTime(it.slots[0]) + (mins > 0 && mins < 1000 ? ' (em ' + mins + 'min)' : '') + '</span>' : '') + '</div></div>' +
        ((it.services || []).some(function (s) { return s.hora_off; }) ? '<span class="dp-off" role="img" aria-label="Hora Off" title="Hora Off">' + HORA_OFF_IC + '</span>' : '') +
        (cw.favorited ? '<span class="dp-fav" title="Favorito">' + icon('heart', 13) + '</span>' : '') +
        (reviews ? '<span class="dp-rate">' + icon('star', 10, { color: 'var(--coral-500)' }) + rating.toFixed(1).replace('.', ',') + '</span>' : '') +
        '<span class="dp-chev">' + icon('chevron-right', 20) + '</span></div>' +
    '</button>';
  }
  function render() {
    var valid = validItems();
    var common = valid.length ? commonSlot(valid) : null;
    var allSame = valid.every(function (it) { return it.slots[0] === common; });
    var cmins = common ? Math.ceil((new Date(common).getTime() - Date.now()) / 60000) : 0;
    $('dp-strip').innerHTML = valid.length
      ? '<div class="dp-strip"><div class="dp-strip-ic">' + icon('clock', 18) + '</div><div><b>' + valid.length + (valid.length === 1 ? ' vaga' : ' vagas') +
          (allSame ? ' às ' : ' a partir das ') + fmtTime(common) + '</b><span>' + (cmins > 0 ? 'começa em ' + cmins + ' min · ' : '') + 'raio de 5 km</span></div></div>'
      : '';
    $('dp').classList.toggle('has-items', valid.length > 0 && state.loc === 'granted' && !state.loading);
    $('dp-sort').innerHTML = state.loc === 'granted' && !state.loading && valid.length > 1
      ? SORTS.map(function (o) { return '<button type="button" class="dp-chip" data-sort="' + o.key + '" aria-pressed="' + (state.sortBy === o.key) + '">' + icon(o.icon, 12) + o.label + '</button>'; }).join('')
      : '';
    var body = $('dp-body');
    if (state.loc === 'pending') {
      body.innerHTML = '<div class="dp-state"><div class="dp-spin"></div><p style="margin-top:12px">Localizando você…</p></div>';
    } else if (state.loc !== 'granted') {
      body.innerHTML = '<div class="dp-state">' + icon('map-pin', 32, { color: 'var(--coral-500)' }) + '<h2>Localização necessária</h2>' +
        '<p>Pra mostrar lava-rápidos perto de você, precisamos da sua localização. Sem ela não dá pra filtrar a lista.' +
        (state.loc === 'denied' ? ' Libere a localização nas configurações do navegador.' : '') + '</p>' +
        '<button type="button" class="dp-btn" id="dp-retry">Tentar de novo</button></div>';
    } else if (state.loading) {
      body.innerHTML = '<div class="dp-state"><div class="dp-spin"></div></div>';
    } else if (!valid.length) {
      body.innerHTML = '<div class="dp-state"><img src="' + ILL + 'vaga-vazia.svg" alt="Ilustração de um relógio com um passarinho pousado em cima">' +
        '<h2>Sem vaga por agora</h2><p>Nenhum lava-rápido a até 5 km tem horário livre nos próximos 30 minutos. Essa janela muda sozinha, vale voltar daqui a pouco. Se preferir não esperar, dá pra marcar um horário certo na Home.</p>' +
        '<a class="dp-btn" href="/">Ver lava-rápidos</a></div>';
    } else {
      var now = Date.now();
      body.innerHTML = '<div class="dp-list">' + sortItems(valid, state.sortBy).map(function (it) { return card(it, now, allSame ? null : common); }).join('') + '</div>';
    }
    renderMap(valid);
  }

  // ── mapa ─────────────────────────────────────────────────────────────────
  var map = null, pins = {}, meMarker = null, fitted = false;
  var wideMap = window.matchMedia('(min-width: 1100px)');
  function mapVisible() { return wideMap.matches || $('dp').classList.contains('map-mode'); }
  function renderMap(valid) {
    if (!window.L || !mapVisible()) return;
    if (!map) {
      map = L.map('dp-map', { zoomControl: true, attributionControl: true, scrollWheelZoom: true });
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19, attribution: '&copy; OpenStreetMap'
      }).addTo(map);
    }
    Object.keys(pins).forEach(function (k) { map.removeLayer(pins[k]); }); pins = {};
    var pts = [];
    valid.forEach(function (it) {
      var cw = it.car_wash, lat = parseFloat(cw.latitude), lng = parseFloat(cw.longitude);
      if (isNaN(lat) || isNaN(lng)) return;
      var p = itemMinPrice(it);
      var html = '<div class="dp-pin" data-pin="' + cw.id + '">' + (isFinite(p) ? 'R$ ' + (Math.round(p) === p ? p : money(p, 2)) : esc(cw.name)) + '</div>';
      var m = L.marker([lat, lng], { icon: L.divIcon({ html: html, className: 'dp-pin-wrap', iconSize: null }), keyboard: true, title: cw.name, riseOnHover: true });
      m.on('click', function () { openSheet(it); });
      m.on('mouseover', function () { hot(cw.id, true); });
      m.on('mouseout', function () { hot(cw.id, false); });
      m.addTo(map); pins[cw.id] = m; pts.push([lat, lng]);
    });
    if (state.coords) {
      var me = [state.coords.latitude, state.coords.longitude];
      if (!meMarker) meMarker = L.marker(me, { icon: L.divIcon({ html: '<div class="dp-me"></div>', className: '', iconSize: [18, 18], iconAnchor: [9, 9] }), interactive: false, keyboard: false }).addTo(map);
      else meMarker.setLatLng(me);
      pts.push(me);
    }
    // Enquadra depois do mapa ter tamanho real — calculado com o container
    // ainda sem layout, o zoom saía fechado e mostrava 2 de 20 pinos.
    // Só conta como enquadrado com pinos: o primeiro desenho acontece ainda
    // carregando, só com a posição do cliente.
    if (!fitted && Object.keys(pins).length) {
      fitted = true;
      requestAnimationFrame(function () { map.invalidateSize(); map.fitBounds(pts, { padding: [56, 56], maxZoom: 15 }); });
    } else {
      setTimeout(function () { map.invalidateSize(); }, 50);
    }
  }
  // Card ↔ pino: passar por um acende o outro.
  function hot(id, on) {
    var pin = document.querySelector('.dp-pin[data-pin="' + id + '"]');
    if (pin) { pin.classList.toggle('is-hot', on); if (pin.parentElement) pin.parentElement.classList.toggle('is-hot', on); }
    var c = document.querySelector('.dp-card[data-open="' + id + '"]'); if (c) c.classList.toggle('is-hot', on);
  }
  function toggleMapMode() {
    var on = !$('dp').classList.contains('map-mode');
    $('dp').classList.toggle('map-mode', on);
    $('dp-maptoggle-txt').textContent = on ? 'Lista' : 'Mapa';
    $('dp-maptoggle-ic').innerHTML = icon(on ? 'list' : 'map', 16);
    window.scrollTo(0, 0);
    fitted = false;
    renderMap(validItems());
  }

  // ── folha "Reservar em" (disponivel/_folha_reserva, a mesma da página do lava-rápido)
  function openSheet(it) {
    window.LoovReservaLM.abrir(it, {
      toast: toast,
      aoReservar: startWaiting,
      aoFalhar: function () { load(true); }
    });
  }

  // ── espera pelo aceite ───────────────────────────────────────────────────
  var pollT = null, tickT = null;
  function startWaiting(appt) {
    state.appt = appt; state.outcome = null;
    state.secondsLeft = appt.seconds;
    $('dw').classList.add('is-on');
    document.documentElement.style.overflow = 'hidden';
    window.scrollTo(0, 0);
    renderWaiting();
    // Polling ANTES do relógio: startPolling limpa o que estiver rodando
    // (inclusive o relógio) — na ordem inversa o contador ficava em 03:00.
    startPolling(appt.id);
    startTicker(appt.expires_at);
  }
  function startTicker(exp) {
    clearInterval(tickT);
    var tick = function () {
      state.secondsLeft = Math.max(0, Math.round((new Date(exp).getTime() - Date.now()) / 1000));
      var el = $('dw-count'); if (el) el.textContent = relogio(state.secondsLeft);
      var p = passouPct(state.appt) + '%';
      var b = $('dw-barra'); if (b) b.style.width = p;
      var c = $('dw-carro'); if (c) { c.style.left = p; c.style.transform = 'translateX(-' + p + ')'; }
      updateUrgency();
    };
    tick(); tickT = setInterval(tick, 1000);
  }
  // Encadeado com recuo: servidor fora ou limitando não melhora com insistência.
  function startPolling(id) {
    stopPolling();
    var wait = POLL_MS;
    var step = function () {
      api('/disponivel/' + id).then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); }).then(function (d) {
        if (d.status === 'confirmed') { stopPolling(); if (state.appt) state.appt.agenda_url = d.agenda_url || null; setOutcome('accepted'); }
        else if (['rejected', 'cancelled', 'expired'].indexOf(d.status) !== -1) { stopPolling(); setOutcome(d.status); }
        wait = POLL_MS;
      }).catch(function () { wait = Math.min(30000, wait * 2); }).finally(function () {
        if (pollT) pollT = setTimeout(step, wait);
      });
    };
    pollT = setTimeout(step, POLL_MS);
  }
  function stopPolling() { clearTimeout(pollT); pollT = null; clearInterval(tickT); tickT = null; }
  function setOutcome(o) { state.outcome = o; renderWaiting(); }
  function relogio(sec) { sec = Math.max(0, sec | 0); return Math.floor(sec / 60) + ':' + String(sec % 60).padStart(2, '0'); }
  // O que já passou dos 3 minutos, em %: a barra de "Decidindo" enche.
  function passouPct(a) { return (Math.max(0, Math.min(1, 1 - state.secondsLeft / ((a && a.seconds) || 180))) * 100).toFixed(1); }
  // Carro visto de cima, de frente pra direita. A carroceria segue a cor da
  // barra (currentColor).
  var CARRO = '<svg width="28" height="14" viewBox="0 0 28 14" aria-hidden="true">' +
    '<rect x="5" y="0" width="4" height="2" rx="1" fill="#ada699"/><rect x="18" y="0" width="4" height="2" rx="1" fill="#ada699"/>' +
    '<rect x="5" y="12" width="4" height="2" rx="1" fill="#ada699"/><rect x="18" y="12" width="4" height="2" rx="1" fill="#ada699"/>' +
    '<rect x="1" y="1.5" width="26" height="11" rx="4" fill="currentColor"/>' +
    '<rect x="17" y="3.2" width="4.2" height="7.6" rx="1.6" fill="#1a1612" opacity=".85"/><rect x="4.4" y="3.6" width="3" height="6.8" rx="1.2" fill="#1a1612" opacity=".85"/>' +
    '<circle cx="25.6" cy="4.2" r=".9" fill="#fafaf6"/><circle cx="25.6" cy="9.8" r=".9" fill="#fafaf6"/></svg>';
  function urgente() { return state.secondsLeft <= 30 && !state.outcome; }
  function frase(a) { return 'chegou pro ' + ((a.car_wash && a.car_wash.name) || 'lava-rápido') + '.'; }
  function updateUrgency() {
    var u = urgente();
    $('dw').classList.toggle('is-urgent', u);
    var st = $('dw-status-txt'); if (st) st.textContent = u ? 'Resposta a qualquer segundo' : 'Pedido enviado';
    var fr = $('dw-frase'); if (fr) fr.textContent = u ? 'a qualquer segundo.' : frase(state.appt);
  }
  function valores(a) {
    var total = a.total != null ? Number(a.total) : Number(a.service && a.service.price) || 0;
    var held = Number(a.prepayment) || 0;
    return { total: total, held: held, rest: Math.max(0, Math.round((total - held) * 100) / 100) };
  }
  function quandoTopo(a) {
    var hoje = new Date(a.slot).toDateString() === new Date().toDateString();
    return fmtTime(a.slot) + (hoje ? ' · hoje' : '');
  }
  function renderWaiting() {
    var a = state.appt;
    if (state.outcome) { renderResult(); return; }
    var v = valores(a);
    var dur = Number(a.service && a.service.duration) > 0 ? ' · ' + a.service.duration + ' min' : '';
    var pct = passouPct(a);
    $('dw-in').innerHTML = '<div class="dw-esp">' +
      '<div class="dw-faixa">' +
        '<div class="dw-vivo"><span><span class="dw-dot"></span><span id="dw-status-txt">Pedido enviado</span></span><span>' + quandoTopo(a) + '</span></div>' +
        '<div class="dw-meio"><span class="dw-rel" id="dw-count" role="timer" aria-label="Tempo até a resposta">' + relogio(state.secondsLeft) + '</span>' +
        '<p class="dw-frase" id="dw-frase">' + esc(frase(a)) + '</p></div>' +
        // Enviado, decidindo, sua vaga. A barra do meio anda com o mesmo
        // tempo do placar do lava-rápido, puxada pelo carro.
        '<div class="dw-passos" aria-label="Pedido enviado, esperando a decisão do lava-rápido">' +
          '<span class="feito"><u><i></i></u>Enviado</span>' +
          '<span class="agora"><u><i><b id="dw-barra" style="width:' + pct + '%"></b></i><span class="dw-carro" id="dw-carro" style="left:' + pct + '%;transform:translateX(-' + pct + '%)">' + CARRO + '</span></u>Decidindo</span>' +
          '<span><u><i></i></u>Sua vaga</span>' +
        '</div>' +
      '</div>' +
      '<div class="dw-linhas">' +
        '<div class="dw-lp"><span>Serviço</span><b>' + esc(a.service.title || 'Lavagem') + dur + '</b></div>' +
        (a.desconto > 0 ? '<div class="dw-lp"><span>Vale</span><b>−R$ ' + money(a.desconto, 2) + '</b></div>' : '') +
        '<div class="dw-lp"><span>No cartão</span><b>' + (v.held > 0 ? 'R$ ' + money(v.held, 2) : 'nada') + '</b></div>' +
        '<div class="dw-lp"><span>Na chegada</span><b>R$ ' + money(v.rest, 2) + '</b></div>' +
        '<div class="dw-desl" id="dw-desl"><span class="dw-desl-r" id="dw-desl-r"></span>' +
          '<span class="dw-desl-t" id="dw-desl-t">Deslize para cancelar<em aria-hidden="true">›››</em></span>' +
          '<button type="button" class="dw-bola" id="dw-bola" aria-label="Cancelar pedido. Deslize até o fim, ou aperte Enter">' + icon('x', 20, { 'stroke-width': 2.6 }) + '</button></div>' +
      '</div></div>';
    $('dw').scrollTop = 0;
    bindSlide();
    updateUrgency();
  }
  // Aceita: a mesma tela de "Agendado" do agendamento comum
  // (shared/_confirmacao_agendamento), com o que é do Last Minute.
  function renderAceito() {
    var a = state.appt, slot = new Date(a.slot), pago = Number(a.prepayment) || 0;
    var total = a.total != null ? Number(a.total) : Number(a.service && a.service.price) || 0;
    var dia = slot.toDateString() === new Date().toDateString() ? 'hoje' : ['dom', 'seg', 'ter', 'qua', 'qui', 'sex', 'sáb'][slot.getDay()];
    $('dw-in').innerHTML = LoovConfirmacao.html({
      lastMinute: true,
      quando: dia + ', ' + fmtTime(a.slot),
      agendaUrl: a.agenda_url,
      cw: a.car_wash, servico: a.service,
      pagoCartao: pago, pagoLabel: 'Pago no cartão',
      aPagar: Math.max(0, Math.round((total - pago) * 100) / 100),
      comVale: a.desconto > 0, valeTxt: a.desconto > 0 ? 'Vale aplicado: −R$ ' + money(a.desconto, 2) : null,
      aviso: 'Se não puder ir, o valor pago no cartão não volta. Se o lava-rápido cancelar, você recebe de volta.',
      homeUrl: '/'
    });
    $('dw').scrollTop = 0;
    var b = document.querySelector('#dw-in .ok-primary'); if (b) b.focus({ preventScroll: true });
  }
  function renderResult() {
    var o = state.outcome, a = state.appt || {}, name = (a.car_wash && a.car_wash.name) || 'lava-rápido';
    if (o === 'accepted') { renderAceito(); return; }
    var v = valores(a);
    // Cada desfecho diz quem decidiu. O tempo esgotado não diz "não
    // respondeu": soa como se o lava-rápido tivesse visto e ignorado.
    var estado = o === 'rejected' ? 'Recusado' : o === 'expired' ? 'Tempo esgotado' : 'Cancelado';
    var palavra = o === 'rejected' ? 'não rolou.' : o === 'expired' ? 'não deu tempo.' : 'pedido cancelado.';
    var motivo = o === 'rejected' ? 'O ' + name + ' não pôde aceitar agora.'
      : o === 'expired' ? 'O ' + name + ' não conseguiu responder dentro dos 3 minutos.'
      : 'Você cancelou antes da resposta e o horário foi liberado.';
    var dinheiro = v.held > 0 ? ' Os R$ ' + money(v.held, 2) + ' reservados foram liberados: nada foi cobrado.' : ' Nada foi cobrado.';
    $('dw-in').innerHTML = '<div class="dw-fim">' +
      '<div class="dw-vivo"><span>Last Minute</span><span' + (o === 'rejected' ? ' class="is-rec"' : '') + '>' + estado + '</span></div>' +
      '<span class="dw-rel">' + fmtTime(a.slot) + '</span>' +
      (o !== 'cancelled' ? '<p class="dw-frase riscada">' + esc(frase(a)) + '</p>' : '') +
      '<p class="dw-frase">' + palavra + '</p>' +
      '<p class="dw-fim-txt">' + esc(motivo + dinheiro) + '</p>' +
      '<div class="dw-lp"><span>' + esc((a.service && a.service.title) || 'Lavagem') + '</span><b>' + fmtTime(a.slot) + ' · R$ ' + money(v.total, 2) + '</b></div>' +
      '<button type="button" class="dw-cta" data-result="list">Buscar outro lava-rápido' + icon('arrow-right', 15) + '</button>' +
    '</div>';
    $('dw').scrollTop = 0;
    var b = document.querySelector('.dw-cta'); if (b) b.focus({ preventScroll: true });
  }
  function closeWaiting() {
    stopPolling();
    state.appt = null; state.outcome = null;
    $('dw').classList.remove('is-on', 'is-urgent');
    document.documentElement.style.overflow = '';
  }

  // Deslizar pra cancelar: arrastar a bolinha até 90% da trilha cancela;
  // soltar antes volta com mola. Teclado e leitor de tela cancelam direto,
  // porque não arrastam.
  function bindSlide() {
    var trilha = $('dw-desl'), bola = $('dw-bola'), rastro = $('dw-desl-r'), txt = $('dw-desl-t');
    var x0 = null, dx = 0, foi = false;
    var maxX = function () { return trilha.clientWidth - bola.offsetWidth - 8; };
    var poe = function (v) {
      dx = Math.max(0, Math.min(maxX(), v));
      bola.style.transform = 'translateX(' + dx + 'px)';
      rastro.style.width = (dx + 52) + 'px';
      txt.style.opacity = String(Math.max(0, 1 - dx / (maxX() * .6)));
    };
    var cancela = function () { if (foi) return; foi = true; giveUp(); };
    bola.addEventListener('pointerdown', function (e) { x0 = e.clientX - dx; trilha.classList.remove('volta'); try { bola.setPointerCapture(e.pointerId); } catch (_) {} });
    bola.addEventListener('pointermove', function (e) { if (x0 !== null) poe(e.clientX - x0); });
    var solta = function () {
      if (x0 === null) return;
      x0 = null;
      if (maxX() > 0 && dx >= maxX() * .9) { poe(maxX()); cancela(); }
      else { trilha.classList.add('volta'); poe(0); }
    };
    bola.addEventListener('pointerup', solta); bola.addEventListener('pointercancel', solta);
    bola.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); cancela(); } });
    // Leitor de tela ativa o botão sem ponteiro (clique com detail 0).
    bola.addEventListener('click', function (e) { if (e.detail === 0) cancela(); });
    bola.addEventListener('contextmenu', function (e) { e.preventDefault(); });
  }
  function giveUp() {
    var id = state.appt && state.appt.id;
    closeWaiting();
    if (id) api('/disponivel/' + id + '/cancel', { method: 'PATCH' }).catch(function () {});
    toast('Pedido cancelado. Nada foi cobrado.', 'error');
    load(true);
  }

  // ── eventos ──────────────────────────────────────────────────────────────
  document.addEventListener('click', function (e) {
    var t;
    if ((t = e.target.closest('[data-open]'))) { var it = state.items.find(function (x) { return String(x.car_wash.id) === t.dataset.open; }); if (it) openSheet(it); return; }
    if ((t = e.target.closest('[data-sort]'))) { state.sortBy = t.dataset.sort; render(); return; }
    if (e.target.closest('#dp-retry')) { retryLocation(); return; }
    if ((t = e.target.closest('[data-result]'))) {
      closeWaiting(); load(true);
    }
  });
  document.addEventListener('mouseover', function (e) { var c = e.target.closest('.dp-card'); if (c && !c.contains(e.relatedTarget)) hot(c.dataset.open, true); });
  document.addEventListener('mouseout', function (e) { var c = e.target.closest('.dp-card'); if (c && !c.contains(e.relatedTarget)) hot(c.dataset.open, false); });
  $('dp-maptoggle').addEventListener('click', toggleMapMode);
  wideMap.addEventListener('change', function () { renderMap(validItems()); });
  // Contagem "em Xmin" dos cards se atualiza sozinha (como o app, a cada 15s).
  setInterval(function () { if (!state.appt && !state.loading && state.loc === 'granted') render(); }, 15000);

  function boot() {
    if (window.feather) feather.replace(); $('dp-maptoggle-ic').innerHTML = icon('map', 16); render(); initLocation();
    // Pedido feito na página do lava-rápido (a folha abre lá, no horário com
    // raio): ele já reservou e vem pra cá só a espera do aceite, a mesma de
    // sempre. Lido uma vez e apagado, senão recarregar reabriria a espera.
    var esp = null;
    try { esp = JSON.parse(sessionStorage.getItem('loov_lm_espera') || 'null'); sessionStorage.removeItem('loov_lm_espera'); } catch (e) {}
    if (esp && esp.id && esp.expires_at) startWaiting(esp);
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot); else boot();
})();
</script>
