<style>
  .how-row { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; margin:8px 0 32px; }
  .how-card {
    background:var(--paper);
    border:1px solid var(--stone);
    border-radius:16px;
    padding:18px 20px;
    position:relative; overflow:hidden;
  }
  .how-card::before { content:''; position:absolute; left:0; top:0; bottom:0; width:3px; background:var(--coral-500); opacity:.5; }
  .how-num { font-family:'Space Grotesk', sans-serif; font-weight:700; font-size:32px; color:var(--coral-100); line-height:1; margin-bottom:6px; letter-spacing:-0.5px; }
  .how-text { font-size:13px; color:var(--graphite); line-height:1.55; }
  .how-text strong { color:var(--ink); font-weight:600; }

  .geo-banner { margin-bottom:24px; }
  .geo-inner {
    background:var(--coral-50); border:1px solid var(--coral-100); border-radius:14px;
    padding:14px 16px; display:flex; align-items:center; justify-content:space-between; gap:14px; flex-wrap:wrap;
  }
  .geo-text { font-size:13.5px; color:var(--graphite); }
  .geo-btn {
    background:var(--coral-500); border:none; border-radius:100px;
    padding:8px 16px; font-family:'JetBrains Mono', monospace; font-size:11px; font-weight:600; letter-spacing:1.4px; text-transform:uppercase;
    color:var(--cream); cursor:pointer; transition:background .15s;
  }
  .geo-btn:hover { background:var(--coral-700); }

  .slot-group { margin-bottom:32px; }
  .slot-cw-header { display:flex; align-items:flex-start; justify-content:space-between; gap:14px; margin-bottom:14px; flex-wrap:wrap; }
  .slot-cw-name { font-family:'Space Grotesk', sans-serif; font-weight:700; font-size:22px; color:var(--ink); letter-spacing:-0.3px; line-height:1.2; }
  .slot-cw-meta { font-size:12.5px; color:var(--graphite); margin-top:4px; }
  .slot-cw-meta i { color:var(--coral-500); margin-right:4px; }
  .slot-price-from {
    font-family:'JetBrains Mono', monospace; font-size:11px; letter-spacing:1.4px; text-transform:uppercase;
    color:var(--coral-700); background:var(--coral-50); border:1px solid var(--coral-100);
    padding:5px 11px; border-radius:100px;
  }

  .slot-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(260px, 1fr)); gap:12px; }

  .slot-card {
    background:var(--paper); border:1px solid var(--stone);
    border-radius:18px; padding:18px;
    transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    position:relative; overflow:hidden;
    text-decoration:none; display:block;
  }
  .slot-card::before { content:''; position:absolute; left:0; top:0; bottom:0; width:3px; background:var(--coral-500); transform:scaleY(0); transform-origin:bottom; transition:transform .3s cubic-bezier(.16,1,.3,1); }
  .slot-card:hover { border-color:var(--coral-100); box-shadow: 0 12px 28px rgba(25,20,15,0.06); transform:translateY(-2px); }
  .slot-card:hover::before { transform:scaleY(1); }

  .slot-time { font-family:'Space Grotesk', sans-serif; font-weight:700; font-size:32px; color:var(--coral-500); line-height:1; letter-spacing:-0.5px; }
  .slot-today { font-family:'JetBrains Mono', monospace; font-size:10px; color:var(--ash); letter-spacing:1.4px; text-transform:uppercase; margin-top:4px; }

  .slot-services { margin-top:14px; display:flex; flex-direction:column; gap:6px; }
  .slot-svc { display:flex; align-items:center; justify-content:space-between; gap:8px; }
  .slot-svc-name { font-size:13px; color:var(--ink); font-weight:500; }
  .slot-svc-meta { display:flex; align-items:center; gap:8px; }
  .slot-svc-dur { font-size:11.5px; color:var(--ash); }
  .slot-svc-price { font-family:'Space Grotesk', sans-serif; font-weight:600; font-size:13px; color:var(--graphite); }

  .slot-cta { margin-top:16px; display:flex; align-items:center; justify-content:space-between; gap:8px; flex-wrap:wrap; }
  .slot-prepay-tag { font-family:'JetBrains Mono', monospace; font-size:9.5px; color:var(--ash); letter-spacing:1.2px; text-transform:uppercase; }
  .slot-cta-btn {
    display:inline-flex; align-items:center; gap:6px;
    background:var(--coral-500); color:var(--cream); border:none; border-radius:100px;
    padding:8px 16px; font-family:'JetBrains Mono', monospace; font-size:11px; font-weight:600; letter-spacing:1.4px; text-transform:uppercase;
    cursor:pointer; transition:background .15s, transform .15s;
  }
  .slot-cta-btn:hover { background:var(--coral-700); transform:translateY(-1px); }

  .svc-select-overlay { display:none; margin-top:14px; padding-top:14px; border-top:1px solid var(--stone); }
  .svc-select-overlay.open { display:block; }
  .svc-select-label { font-family:'JetBrains Mono', monospace; font-size:10.5px; font-weight:600; letter-spacing:1.6px; text-transform:uppercase; color:var(--ash); margin-bottom:8px; }
  .svc-btn {
    display:flex; align-items:center; justify-content:space-between; width:100%;
    padding:10px 14px; background:var(--cream); border:1px solid var(--stone);
    border-radius:10px; margin-bottom:6px; cursor:pointer; transition:all .15s;
    text-align:left; text-decoration:none;
  }
  .svc-btn:hover { border-color:var(--coral-500); background:var(--coral-50); }
  .svc-btn-name { font-size:13px; color:var(--ink); font-weight:500; }
  .svc-btn-right { display:flex; align-items:center; gap:10px; }
  .svc-btn-dur { font-size:11.5px; color:var(--ash); }
  .svc-btn-price { font-family:'Space Grotesk', sans-serif; font-weight:600; font-size:13px; color:var(--coral-700); }

  .empty-state { text-align:center; padding:60px 24px; background:var(--paper); border:1px solid var(--stone); border-radius:20px; }
  .empty-icon { font-size:36px; color:var(--stone); margin-bottom:14px; }
  .empty-title { font-family:'Space Grotesk', sans-serif; font-weight:700; font-size:24px; color:var(--ink); margin-bottom:8px; letter-spacing:-0.3px; }
  .empty-text { font-size:14px; color:var(--graphite); max-width:380px; margin:0 auto 22px; line-height:1.6; }

  @media (max-width:600px) {
    .how-row { grid-template-columns:1fr; }
  }
</style>

<div class="loov-page loov-page--wide">

  <div class="loov-hero">
    <div class="loov-eyebrow"><span class="dot"></span>VAGAS AGORA</div>
    <h1 class="loov-h1"><span class="accent">Disponíveis</span> agora.</h1>
    <p class="loov-lead">Lava-rápidos com vagas nos próximos 120 minutos. Reserve em segundos.</p>
  </div>

  <div class="how-row">
    <div class="how-card">
      <div class="how-num">01</div>
      <div class="how-text"><strong>Escolha o slot</strong><br>Veja vagas abertas perto de você agora.</div>
    </div>
    <div class="how-card">
      <div class="how-num">02</div>
      <div class="how-text"><strong>Pague 35% agora</strong><br>Garante sua vaga. O dono tem 3 min para confirmar.</div>
    </div>
    <div class="how-card">
      <div class="how-num">03</div>
      <div class="how-text"><strong>Vá ao lava-rápido</strong><br>Pague o restante (65%) no local.</div>
    </div>
  </div>

  <% unless @lat %>
  <div class="geo-banner">
    <div class="geo-inner">
      <span class="geo-text"><i class="fas fa-location-dot" style="color:var(--coral-500);margin-right:6px;"></i>Permita sua localização para ver vagas mais próximas.</span>
      <button class="geo-btn" onclick="requestGeo()">Usar minha localização</button>
    </div>
  </div>
  <% end %>

  <% if @available_slots.empty? %>
    <div class="empty-state">
      <div class="empty-icon"><i class="fas fa-car-wash"></i></div>
      <div class="empty-title">Nenhuma vaga agora</div>
      <p class="empty-text">Não encontramos lava-rápidos com vagas disponíveis nos próximos 120 minutos. Tente o agendamento normal ou volte em alguns minutos.</p>
      <%= link_to car_washes_path, class: "loov-btn-primary" do %>
        <i class="fas fa-calendar"></i> Ver agendamentos
      <% end %>
    </div>

  <% else %>

    <% @available_slots.each_with_index do |slot_data, idx| %>
    <div class="slot-group">

      <div class="slot-cw-header">
        <div>
          <div class="slot-cw-name"><%= slot_data[:car_wash].name %></div>
          <div class="slot-cw-meta">
            <i class="fas fa-location-dot"></i>
            <%= slot_data[:car_wash].address %>
            <% if @lat && @lon && slot_data[:car_wash].latitude %>
              <% dist = slot_data[:car_wash].distance_to([@lat, @lon], :km) %>
              · <%= number_with_precision(dist, precision: 1) %> km
            <% end %>
          </div>
        </div>
        <span class="slot-price-from">A partir de R$ <%= number_with_precision(slot_data[:min_price], precision: 0) %></span>
      </div>

      <div class="slot-grid">
        <% slot_data[:slots].first(4).each do |slot_time| %>
        <div class="slot-card" data-cw="<%= slot_data[:car_wash].id %>" data-slot="<%= slot_time.iso8601 %>">
          <div class="slot-time"><%= slot_time.strftime("%H:%M") %></div>
          <div class="slot-today">Hoje · <%= slot_time.strftime("%d/%m") %></div>

          <div class="slot-services">
            <% slot_data[:services].first(3).each do |svc| %>
            <div class="slot-svc">
              <span class="slot-svc-name"><%= svc.title %></span>
              <div class="slot-svc-meta">
                <span class="slot-svc-dur"><%= svc.duration %>min</span>
                <span class="slot-svc-price">R$<%= number_with_precision(svc.price, precision: 0) %></span>
              </div>
            </div>
            <% end %>
          </div>

          <div class="slot-cta">
            <span class="slot-prepay-tag">35% agora · resto no local</span>
            <button class="slot-cta-btn" onclick="openServiceSelect(this)" data-cw="<%= slot_data[:car_wash].id %>" data-slot="<%= slot_time.iso8601 %>">
              Reservar <i class="fas fa-arrow-right"></i>
            </button>
          </div>

          <div class="svc-select-overlay">
            <div class="svc-select-label">Escolha o serviço</div>
            <% slot_data[:services].each do |svc| %>
            <%= link_to checkout_disponivel_index_path(car_wash_id: slot_data[:car_wash].id, service_id: svc.id, slot: slot_time.iso8601), class: "svc-btn" do %>
              <span class="svc-btn-name"><%= svc.title %></span>
              <div class="svc-btn-right">
                <span class="svc-btn-dur"><%= svc.duration %>min</span>
                <span class="svc-btn-price">R$<%= number_with_precision(svc.price, precision: 0) %></span>
              </div>
            <% end %>
            <% end %>
          </div>

        </div>
        <% end %>
      </div>

    </div>
    <% end %>

  <% end %>
</div>

<script>
function openServiceSelect(btn) {
  const card    = btn.closest('.slot-card');
  const overlay = card.querySelector('.svc-select-overlay');
  const isOpen  = overlay.classList.contains('open');
  document.querySelectorAll('.svc-select-overlay.open').forEach(o => o.classList.remove('open'));
  if (!isOpen) overlay.classList.add('open');
}

function requestGeo() {
  if (typeof window.loovGeoReload === 'function') {
    window.loovGeoReload();
    return;
  }
  if (!navigator.geolocation) {
    alert('Seu navegador não suporta localização.');
    return;
  }
  navigator.geolocation.getCurrentPosition(pos => {
    const url = new URL(window.location);
    url.searchParams.set('latitude',  pos.coords.latitude);
    url.searchParams.set('longitude', pos.coords.longitude);
    window.location.href = url.toString();
  }, err => {
    if (err.code === 1) alert('Permissão de localização negada. Libere nas configurações do site.');
    else if (err.code === 2) alert('Não conseguimos detectar sua localização. Verifique se o GPS está ativo.');
    else if (err.code === 3) alert('A busca demorou demais. Tente de novo.');
    else alert('Não foi possível obter sua localização.');
  }, { enableHighAccuracy: true, timeout: 8000, maximumAge: 0 });
}
</script>
