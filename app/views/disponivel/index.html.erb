<style>
  /* Página dark padrão Loov — espelha DisponivelScreen.js do app */
  .disp-wrap {
    background: var(--obsidian);
    min-height: 100vh;
    margin-top: -60px; /* compensa o navbar fixed cream — aqui queremos full-bleed dark */
    padding-top: 60px;
  }
  body.disp-active { background: var(--obsidian); }

  .disp-back {
    display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; border-radius: 22px;
    background: rgba(254,254,253,0.08);
    border: 1px solid rgba(254,254,253,0.12);
    color: var(--cream);
    margin: 14px 20px 0;
    text-decoration: none;
    transition: background .15s ease;
  }
  .disp-back:hover { background: rgba(254,254,253,0.14); color: var(--cream); }

  .disp-page {
    max-width: 760px;
    margin: 0 auto;
    padding: 16px 20px 80px;
  }

  /* ── Hero ─────────────────────────────────────────────── */
  .disp-hero { padding: 12px 0 28px; }
  .disp-badge {
    display: inline-flex; align-items: center; gap: 6px;
    background: var(--coral-500);
    color: var(--cream);
    padding: 6px 12px;
    border-radius: 100px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; font-weight: 600;
    letter-spacing: 1.4px; text-transform: lowercase;
    margin-bottom: 16px;
  }
  .disp-badge i { font-size: 11px; }
  .disp-h1 {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: clamp(34px, 5.5vw, 52px);
    line-height: 1.05;
    color: var(--cream);
    letter-spacing: -1px;
    margin: 0;
  }
  .disp-h1 .accent { color: var(--coral-500); }

  /* ── Info strip ───────────────────────────────────────── */
  .disp-info-strip {
    display: flex; align-items: center; gap: 14px;
    background: rgba(254,254,253,0.05);
    border: 1px solid rgba(254,254,253,0.10);
    border-radius: 16px;
    padding: 14px 18px;
    margin-bottom: 24px;
  }
  .strip-icon {
    width: 44px; height: 44px; border-radius: 14px;
    background: rgba(220,120,82,0.18);
    border: 1px solid rgba(220,120,82,0.30);
    color: var(--coral-500);
    display: flex; align-items: center; justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
  }
  .strip-label { color: var(--cream); font-size: 14px; font-weight: 600; }
  .strip-value {
    color: #b5ae9f; font-size: 12.5px;
    font-family: 'JetBrains Mono', monospace;
    letter-spacing: 0.5px; margin-top: 2px;
  }

  /* ── Geo banner / Empty state ─────────────────────────── */
  .disp-banner {
    background: rgba(220,120,82,0.10);
    border: 1px solid rgba(220,120,82,0.25);
    border-radius: 18px;
    padding: 18px 20px;
    margin-bottom: 24px;
    display: flex; align-items: center; justify-content: space-between;
    gap: 14px; flex-wrap: wrap;
  }
  .disp-banner-text { color: var(--cream); font-size: 13.5px; }
  .disp-banner-text i { color: var(--coral-500); margin-right: 6px; }
  .disp-banner-btn {
    background: var(--coral-500); color: var(--cream);
    border: none; border-radius: 100px;
    padding: 10px 18px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; font-weight: 600; letter-spacing: 1.4px; text-transform: uppercase;
    cursor: pointer; transition: background .15s;
  }
  .disp-banner-btn:hover { background: var(--coral-700); }

  .disp-empty {
    background: rgba(254,254,253,0.04);
    border: 1px solid rgba(254,254,253,0.08);
    border-radius: 20px;
    padding: 56px 24px;
    text-align: center;
  }
  .disp-empty-icon {
    width: 64px; height: 64px; border-radius: 50%;
    background: rgba(220,120,82,0.15);
    color: var(--coral-500);
    margin: 0 auto 16px;
    display: flex; align-items: center; justify-content: center;
    font-size: 28px;
  }
  .disp-empty-title {
    font-family: 'Space Grotesk', sans-serif; font-weight: 700;
    font-size: 22px; color: var(--cream);
    letter-spacing: -0.3px; margin-bottom: 8px;
  }
  .disp-empty-text {
    font-size: 14px; color: #b5ae9f; line-height: 1.55;
    max-width: 380px; margin: 0 auto;
  }

  /* ── Card escuro (espelha cardDark do app) ───────────── */
  .disp-list { display: flex; flex-direction: column; gap: 12px; }

  .disp-card-dark {
    background: var(--ink);
    border-radius: 24px;
    padding: 22px;
    position: relative; overflow: hidden;
    border: 1px solid rgba(254,254,253,0.05);
  }
  .disp-blob {
    position: absolute; top: -50px; right: -50px;
    width: 220px; height: 220px;
    border-radius: 50%;
    background: var(--coral-500);
    pointer-events: none;
  }

  .disp-top {
    display: flex; align-items: flex-start; gap: 14px;
    position: relative;
  }
  .shop-info { flex: 1; min-width: 0; }
  .shop-name {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 19px;
    color: var(--cream);
    letter-spacing: -0.3px;
    line-height: 1.2;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .shop-addr {
    color: #c9c4ba;
    font-size: 12.5px;
    margin-top: 4px;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .shop-addr-sub {
    color: #8a857c;
    font-size: 11.5px;
    margin-top: 2px;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .disp-distance-pill {
    display: inline-flex; align-items: center; gap: 4px;
    background: rgba(220,120,82,0.18);
    border: 1px solid rgba(220,120,82,0.35);
    color: var(--coral-500);
    padding: 4px 10px;
    border-radius: 100px;
    font-size: 11px; font-weight: 600;
    flex-shrink: 0;
  }
  .disp-distance-pill i { font-size: 10px; }

  /* Service pills */
  .disp-svc-pills {
    display: flex; gap: 6px;
    margin-top: 14px;
    overflow-x: auto;
    padding-bottom: 4px;
    position: relative;
  }
  .disp-svc-pills::-webkit-scrollbar { height: 0; }
  .svc-pill {
    flex-shrink: 0;
    background: rgba(254,254,253,0.08);
    border: 1px solid rgba(254,254,253,0.10);
    border-radius: 100px;
    padding: 7px 14px;
    color: var(--cream);
    font-size: 12.5px; font-weight: 500;
    cursor: pointer;
    transition: all .15s ease;
    white-space: nowrap;
  }
  .svc-pill:hover { background: rgba(254,254,253,0.12); }
  .svc-pill.active {
    background: var(--cream);
    color: var(--ink);
    border-color: var(--cream);
    font-weight: 600;
  }

  /* Bottom row */
  .disp-bottom {
    display: flex; align-items: center; gap: 14px;
    margin-top: 18px;
    position: relative;
  }
  .bottom-left { flex: 1; min-width: 0; }
  .bottom-slot-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 1.6px;
    color: var(--coral-500);
    text-transform: uppercase;
    margin-bottom: 4px;
  }
  .bottom-price {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 42px;
    color: var(--coral-500);
    letter-spacing: -1.5px;
    line-height: 1;
  }
  .bottom-subtext {
    color: #c9c4ba; font-size: 12.5px;
    margin-top: 8px;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }

  .arrow-btn {
    width: 56px; height: 56px;
    border-radius: 50%;
    background: var(--coral-500);
    border: none;
    color: var(--cream);
    display: flex; align-items: center; justify-content: center;
    font-size: 22px;
    cursor: pointer;
    transition: background .15s ease, transform .15s ease, box-shadow .15s ease;
    text-decoration: none;
    flex-shrink: 0;
    box-shadow: 0 8px 20px rgba(220,120,82,0.35);
  }
  .arrow-btn:hover {
    background: var(--coral-700);
    transform: translateY(-2px);
    color: var(--cream);
    box-shadow: 0 10px 24px rgba(156,73,48,0.4);
  }

  @media (max-width: 600px) {
    .disp-page { padding: 12px 16px 80px; }
    .disp-card-dark { padding: 18px; border-radius: 20px; }
    .bottom-price { font-size: 36px; }
    .arrow-btn { width: 48px; height: 48px; font-size: 18px; }
  }
</style>

<script>document.body.classList.add('disp-active');</script>

<div class="disp-wrap">

  <a href="/" class="disp-back" aria-label="Voltar">
    <i class="fas fa-chevron-left"></i>
  </a>

  <div class="disp-page">

    <%# ── Hero ────────────────────────────────────────────── %>
    <div class="disp-hero">
      <span class="disp-badge"><i class="fas fa-bolt"></i> last minute</span>
      <h1 class="disp-h1">
        Vagas <span class="accent">agora</span>,<br>perto de você.
      </h1>
    </div>

    <%# ── Info strip ──────────────────────────────────────── %>
    <% slots_count = @available_slots.size %>
    <div class="disp-info-strip">
      <div class="strip-icon"><i class="fas fa-location-dot"></i></div>
      <div style="flex:1;">
        <div class="strip-label">
          <%= slots_count %> <%= slots_count == 1 ? "vaga disponível" : "vagas disponíveis" %>
        </div>
        <div class="strip-value">raio de 5 km · próximos 30 min</div>
      </div>
    </div>

    <%# ── Geo banner (sem lat) ────────────────────────────── %>
    <% unless @lat %>
      <div class="disp-banner">
        <span class="disp-banner-text">
          <i class="fas fa-location-dot"></i>
          Permita sua localização para ver vagas perto de você.
        </span>
        <button class="disp-banner-btn" onclick="requestGeo()">USAR LOCALIZAÇÃO</button>
      </div>
    <% end %>

    <%# ── Empty state ─────────────────────────────────────── %>
    <% if @lat && @available_slots.empty? %>
      <div class="disp-empty">
        <div class="disp-empty-icon"><i class="fas fa-bolt"></i></div>
        <div class="disp-empty-title">Nenhum slot disponível</div>
        <p class="disp-empty-text">
          Sem lava-rápidos com horários livres nos próximos 30 min num raio de 5 km.
        </p>
      </div>

    <%# ── Lista de cards (espelha DisponivelCard) ─────────── %>
    <% elsif @available_slots.any? %>
      <div class="disp-list">
        <% @available_slots.each_with_index do |slot_data, idx| %>
          <% cw       = slot_data[:car_wash] %>
          <% slot_iso = slot_data[:slots].first.iso8601 %>
          <% slot_str = slot_data[:slots].first.strftime("%H:%M") %>
          <% services = slot_data[:services] %>
          <% first    = services.first %>

          <% addr_line = [cw.try(:logradouro), cw.try(:bairro)].compact_blank.join(" · ").presence || cw.address.to_s %>
          <% city_line = [cw.try(:cidade), cw.try(:uf)].compact_blank.join(" · ") %>
          <% distance = (@lat && cw.has_valid_coordinates?) ? cw.distance_to([@lat, @lon], :km).round(1) : nil %>

          <div class="disp-card-dark"
               data-cw-id="<%= cw.id %>"
               data-slot="<%= slot_iso %>"
               style="--blob-opacity:<%= [0.20 - idx * 0.03, 0.05].max %>;">
            <div class="disp-blob" style="opacity:<%= [0.20 - idx * 0.03, 0.05].max %>;"></div>

            <div class="disp-top">
              <div class="shop-info">
                <div class="shop-name"><%= cw.name %></div>
                <% if addr_line.present? %>
                  <div class="shop-addr"><%= addr_line %></div>
                <% end %>
                <% if city_line.present? %>
                  <div class="shop-addr-sub"><%= city_line %></div>
                <% end %>
              </div>
              <% if distance %>
                <div class="disp-distance-pill">
                  <i class="fas fa-map-pin"></i><%= sprintf('%.1f km', distance) %>
                </div>
              <% end %>
            </div>

            <% if services.count > 1 %>
              <div class="disp-svc-pills">
                <% services.each_with_index do |svc, i| %>
                  <button class="svc-pill <%= 'active' if i == 0 %>"
                          data-svc-id="<%= svc.id %>"
                          data-price="<%= number_with_precision(svc.price, precision: 0) %>"
                          data-title="<%= svc.title %>"
                          data-duration="<%= svc.duration %>"
                          onclick="selectService(this)">
                    <%= svc.title %>
                  </button>
                <% end %>
              </div>
            <% end %>

            <div class="disp-bottom">
              <div class="bottom-left">
                <div class="bottom-slot-label">HOJE · <%= slot_str %></div>
                <div class="bottom-price">R$<span class="price-val"><%= number_with_precision(first.price, precision: 0) %></span></div>
                <div class="bottom-subtext">
                  <span class="svc-name"><%= first.title.presence || "Lavagem" %></span>
                  <% if first.duration.present? && first.duration > 0 %>
                    · <span class="svc-dur"><%= first.duration %>min</span>
                  <% end %>
                  <% if distance %>
                    · <%= sprintf('%.1f km', distance) %>
                  <% end %>
                </div>
              </div>

              <a href="<%= checkout_disponivel_index_path(car_wash_id: cw.id, service_id: first.id, slot: slot_iso) %>"
                 class="arrow-btn" data-base-url="<%= checkout_disponivel_index_path %>"
                 aria-label="Reservar">
                <i class="fas fa-arrow-right"></i>
              </a>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

  </div>
</div>

<script>
function selectService(btn) {
  const card = btn.closest('.disp-card-dark');
  if (!card) return;

  card.querySelectorAll('.svc-pill').forEach(p => p.classList.remove('active'));
  btn.classList.add('active');

  const svcId    = btn.dataset.svcId;
  const price    = btn.dataset.price;
  const title    = btn.dataset.title;
  const duration = btn.dataset.duration;

  const priceEl = card.querySelector('.price-val');
  const nameEl  = card.querySelector('.svc-name');
  const durEl   = card.querySelector('.svc-dur');

  if (priceEl) priceEl.textContent = price;
  if (nameEl)  nameEl.textContent  = title;
  if (durEl)   durEl.textContent   = duration + 'min';

  const cwId = card.dataset.cwId;
  const slot = card.dataset.slot;
  const arrow = card.querySelector('.arrow-btn');
  if (arrow) {
    const params = new URLSearchParams({ car_wash_id: cwId, service_id: svcId, slot: slot });
    arrow.href = '/disponivel/checkout?' + params.toString();
  }
}

function requestGeo() {
  if (typeof window.loovGeoReload === 'function') {
    window.loovGeoReload();
    return;
  }
  if (!navigator.geolocation) {
    alert('Seu navegador não suporta localização.');
    return;
  }
  navigator.geolocation.getCurrentPosition(pos => {
    const url = new URL(window.location);
    url.searchParams.set('latitude',  pos.coords.latitude);
    url.searchParams.set('longitude', pos.coords.longitude);
    window.location.href = url.toString();
  }, err => {
    if (err.code === 1) alert('Permissão de localização negada. Libere nas configurações do site.');
    else if (err.code === 2) alert('Não conseguimos detectar sua localização. Verifique se o GPS está ativo.');
    else if (err.code === 3) alert('A busca demorou demais. Tente de novo.');
    else alert('Não foi possível obter sua localização.');
  }, { enableHighAccuracy: true, timeout: 8000, maximumAge: 0 });
}
</script>
