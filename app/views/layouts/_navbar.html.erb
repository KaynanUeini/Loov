<style>
  :root {
    --cream:    #fafaf6;
    --paper:    #fefefd;
    --sand:     #f1eee6;
    --stone:    #e0dbd0;
    --ash:      #ada699;
    --graphite: #575148;
    --ink:      #28231c;
    --obsidian: #1a1612;

    --coral-50:  #fbeae3;
    --coral-100: #f5d3c3;
    --coral-300: #e8a48a;
    --coral-500: #dd7852;
    --coral-700: #9c4930;
  }

  /* ─────────────  NAV  ───────────── */
  .loov-nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1.5rem;
    background: rgba(250,250,246,0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--stone);
  }

  .loov-nav-logo { display:flex; align-items:center; text-decoration:none; flex-shrink:0; }

  /* Loov pill — replicates the React Native LoovPill */
  .loov-pill {
    display:inline-flex; align-items:center; gap:8px;
    background: var(--ink);
    color: var(--cream);
    border-radius: 9999px;
    padding: 7px 14px 7px 11px;
    transition: transform .15s ease, box-shadow .15s ease;
  }
  .loov-pill:hover { transform: translateY(-1px); box-shadow: 0 6px 16px rgba(40,35,28,0.16); }
  .loov-pill .glyph { position:relative; width:22px; height:22px; }
  .loov-pill .glyph .ring-cream {
    position:absolute; left:0; top:1px;
    width:18px; height:18px; border-radius:50%;
    border:2px solid var(--cream);
  }
  .loov-pill .glyph .ring-coral {
    position:absolute; right:0; top:1px;
    width:18px; height:18px; border-radius:50%;
    border:2px solid var(--coral-500);
  }
  .loov-pill .glyph .ring-coral-dot {
    position:absolute; right:6px; top:8px;
    width:5px; height:5px; border-radius:50%;
    background: var(--coral-500);
  }
  .loov-pill .word {
    font-family: 'Space Grotesk', 'Inter', sans-serif;
    font-weight: 700; font-size: 18px;
    letter-spacing: -0.4px; color: var(--cream);
    line-height: 1;
  }

  /* ─────────────  LINKS  ───────────── */
  .loov-nav-links {
    display: flex; align-items: center; gap: 0.125rem;
    list-style: none; margin: 0; padding: 0;
  }
  .loov-nav-links li { display:flex; align-items:center; }
  .loov-nav-links a,
  .loov-nav-links button.nav-link-btn {
    display: inline-flex; align-items: center; gap: 0.4rem;
    padding: 0.5rem 0.85rem; border-radius: 100px;
    font-family: 'Inter', sans-serif; font-size: 0.8125rem; font-weight: 500;
    color: var(--graphite); text-decoration: none;
    transition: color 0.15s ease, background 0.15s ease;
    background: transparent; border: none; cursor: pointer; white-space: nowrap;
  }
  .loov-nav-links a:hover,
  .loov-nav-links button.nav-link-btn:hover { color:var(--ink); background:var(--sand); }
  .loov-nav-links a.active { color:var(--coral-700); background:var(--coral-50); }

  .loov-nav-sep { width:1px; height:16px; background:var(--stone); margin:0 0.35rem; flex-shrink:0; }

  .loov-nav-links a.nav-exit,
  .loov-nav-links button.nav-exit { color:var(--ash); }
  .loov-nav-links a.nav-exit:hover,
  .loov-nav-links button.nav-exit:hover { color:#c85050; background:rgba(200,80,80,0.06); }

  .nav-avatar {
    width:32px; height:32px; border-radius:50%;
    background:var(--coral-500); color:var(--cream);
    font-family:'Space Grotesk',sans-serif; font-size:0.82rem;
    display:inline-flex; align-items:center; justify-content:center;
    text-decoration:none; transition:opacity 0.15s ease, transform 0.15s ease; flex-shrink:0;
    box-shadow: 0 4px 12px rgba(220,120,82,0.22);
  }
  .nav-avatar:hover { opacity:0.92; transform:scale(1.06); }
  .nav-avatar.incomplete { background:transparent; border:2px solid #ffaa00; color:#ffaa00; box-shadow:none; }
  .nav-avatar-wrap { display:inline-flex; align-items:center; gap:0.35rem; position:relative; }
  .nav-avatar-dot { width:8px; height:8px; border-radius:50%; background:#ffaa00; position:absolute; top:-1px; right:-1px; border:2px solid var(--cream); }

  /* ── FAVORITOS CLIENTE ── */
  .nav-fav-btn {
    position:relative; width:34px; height:34px; border-radius:10px;
    background:transparent; border:1px solid transparent;
    display:flex; align-items:center; justify-content:center;
    color:var(--graphite); font-size:.86rem; cursor:pointer; transition:all .2s;
    text-decoration:none;
  }
  .nav-fav-btn:hover { color:var(--coral-500); background:var(--coral-50); border-color:var(--coral-100); }
  .nav-fav-btn.active { color:var(--coral-500); background:var(--coral-50); border-color:var(--coral-100); }

  /* ── SINO CLIENTE ── */
  .nav-bell-wrap { position:relative; display:inline-flex; align-items:center; }
  .nav-bell-btn {
    position:relative; width:34px; height:34px; border-radius:10px;
    background:transparent; border:1px solid transparent;
    display:flex; align-items:center; justify-content:center;
    color:var(--graphite); font-size:.86rem; cursor:pointer; transition:all .2s;
  }
  .nav-bell-btn:hover { color:var(--ink); background:var(--sand); border-color:var(--stone); }
  .nav-bell-btn.has-notif { color:var(--coral-700); border-color:var(--coral-100); background:var(--coral-50); }
  .nav-bell-badge {
    position:absolute; top:-4px; right:-4px;
    background:var(--coral-500); color:var(--cream);
    font-family:'Inter',sans-serif; font-size:.55rem; font-weight:800;
    min-width:16px; height:16px; padding:0 4px; border-radius:99px;
    display:none; align-items:center; justify-content:center;
    border:2px solid var(--cream);
  }
  .nav-bell-badge.visible { display:flex; }

  .nav-notif-dropdown {
    position:absolute; top:calc(100% + 10px); right:0;
    width:320px; background:var(--paper);
    border:1px solid var(--stone); border-radius:18px;
    overflow:hidden; box-shadow:0 14px 40px rgba(40,35,28,0.12);
    opacity:0; pointer-events:none; transform:translateY(-8px);
    transition:all .2s cubic-bezier(.16,1,.3,1); z-index:200;
  }
  .nav-notif-dropdown.open { opacity:1; pointer-events:all; transform:translateY(0); }
  .nav-notif-header {
    padding:.85rem 1rem .55rem;
    border-bottom:1px solid var(--stone);
    font-family:'JetBrains Mono', monospace; font-size:.62rem; font-weight:700;
    letter-spacing:.18em; text-transform:uppercase; color:var(--coral-500);
  }
  .nav-notif-item {
    display:flex; align-items:flex-start; gap:.75rem;
    padding:.875rem 1rem; border-bottom:1px solid var(--stone);
    text-decoration:none; transition:background .15s; cursor:pointer;
  }
  .nav-notif-item:hover { background:var(--sand); }
  .nav-notif-item:last-child { border-bottom:none; }
  .nav-notif-icon {
    width:34px; height:34px; border-radius:10px; flex-shrink:0;
    display:flex; align-items:center; justify-content:center; font-size:.82rem;
  }
  .nav-notif-icon.pending   { background:var(--coral-50); color:var(--coral-700); border:1px solid var(--coral-100); }
  .nav-notif-icon.confirmed { background:#d6ecde; color:#2d6b42; border:1px solid #b5d8c1; }
  .nav-notif-icon.rejected  { background:rgba(200,80,80,0.08); color:#c85050; border:1px solid rgba(200,80,80,0.16); }
  .nav-notif-icon.cancelled { background:rgba(249,115,22,.08); color:#c95612; border:1px solid rgba(249,115,22,.18); }
  .nav-notif-icon.regular   { background:#dceaf3; color:#2a5f8a; border:1px solid #b5cee0; }
  .nav-notif-title { font-size:.82rem; font-weight:600; color:var(--ink); margin-bottom:.18rem; }
  .nav-notif-sub { font-size:.72rem; color:var(--graphite); line-height:1.45; }
  .nav-notif-empty { padding:1.5rem 1rem; text-align:center; font-size:.78rem; color:var(--ash); }
  .nav-notif-footer { padding:.7rem 1rem; border-top:1px solid var(--stone); text-align:center; background: var(--cream); }
  .nav-notif-footer a { font-family:'JetBrains Mono', monospace; font-size:.66rem; letter-spacing:.12em; text-transform:uppercase; color:var(--coral-700); text-decoration:none; transition:color .15s; }
  .nav-notif-footer a:hover { color:var(--coral-500); }

  /* ── SUPORTE OWNER/ATTENDANT ── */
  .nav-support-btn {
    position:relative; width:34px; height:34px; border-radius:10px;
    background:transparent; border:1px solid transparent;
    display:flex; align-items:center; justify-content:center;
    color:var(--graphite); font-size:.86rem; cursor:pointer; transition:all .2s;
  }
  .nav-support-btn:hover { color:var(--ink); background:var(--sand); border-color:var(--stone); }
  .nav-support-btn.has-reply { color:#2a5f8a; border-color:#b5cee0; background:#dceaf3; }
  .nav-support-badge {
    position:absolute; top:-4px; right:-4px;
    background:#2a5f8a; color:var(--cream);
    font-family:'Inter',sans-serif; font-size:.55rem; font-weight:800;
    width:16px; height:16px; border-radius:50%;
    display:none; align-items:center; justify-content:center;
    border:2px solid var(--cream);
  }
  .nav-support-badge.visible { display:flex; }

  /* Modal suporte */
  .support-modal-overlay {
    position:fixed; inset:0; z-index:300;
    background:rgba(40,35,28,0.55); backdrop-filter:blur(8px);
    display:none; align-items:center; justify-content:center; padding:1rem;
  }
  .support-modal-overlay.open { display:flex; }
  .support-modal {
    background:var(--paper); border:1px solid var(--stone); border-radius:20px;
    width:100%; max-width:480px; max-height:85vh;
    display:flex; flex-direction:column; overflow:hidden;
    box-shadow: 0 20px 60px rgba(40,35,28,0.2);
  }
  .support-modal-header {
    padding:1.125rem 1.25rem; border-bottom:1px solid var(--stone);
    display:flex; align-items:center; justify-content:space-between; flex-shrink:0;
  }
  .support-modal-title {
    font-family:'JetBrains Mono', monospace; font-size:.66rem; font-weight:700;
    letter-spacing:.18em; text-transform:uppercase; color:var(--coral-500);
  }
  .support-modal-close {
    background:none; border:none; color:var(--ash); font-size:1rem; cursor:pointer;
    width:30px; height:30px; display:flex; align-items:center; justify-content:center;
    border-radius:8px; transition:all .15s;
  }
  .support-modal-close:hover { color:#c85050; background:rgba(200,80,80,0.08); }
  .support-modal-body { flex:1; overflow-y:auto; padding:1rem 1.25rem; background: var(--cream); }
  .support-modal-body::-webkit-scrollbar { width:4px; }
  .support-modal-body::-webkit-scrollbar-thumb { background:var(--stone); border-radius:99px; }
  .support-thread { display:flex; flex-direction:column; gap:8px; margin-bottom:1rem; }
  .support-msg { max-width:85%; padding:10px 14px; border-radius:14px; line-height:1.5; }
  .support-msg-admin { align-self:flex-end; background:var(--coral-50); border:1px solid var(--coral-100); }
  .support-msg-owner { align-self:flex-start; background:var(--paper); border:1px solid var(--stone); }
  .support-msg-author { font-family:'JetBrains Mono', monospace; font-size:.6rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; margin-bottom:3px; }
  .support-msg-admin .support-msg-author { color:var(--coral-700); }
  .support-msg-owner .support-msg-author { color:var(--graphite); }
  .support-msg-body { font-size:.82rem; color:var(--ink); white-space:pre-wrap; }
  .support-modal-footer { padding:.875rem 1.25rem 1.25rem; border-top:1px solid var(--stone); flex-shrink:0; background: var(--paper); }
  .support-textarea {
    width:100%; background:var(--cream); border:1px solid var(--stone); border-radius:10px;
    color:var(--ink); font-family:'Inter',sans-serif; font-size:.85rem;
    padding:.75rem 1rem; outline:none; resize:vertical; min-height:68px;
    transition:border-color .2s; margin-bottom:.625rem;
  }
  .support-textarea:focus { border-color:var(--coral-500); }
  .support-textarea::placeholder { color:var(--ash); }
  .support-footer-actions { display:flex; gap:.5rem; }
  .support-btn-send {
    flex:2; background:var(--coral-500); border:none; border-radius:100px; color:var(--cream);
    font-family:'JetBrains Mono', monospace; font-size:.74rem; letter-spacing:.1em; font-weight:700;
    padding:.7rem; cursor:pointer; transition:background .15s;
  }
  .support-btn-send:hover { background:var(--coral-700); }
  .support-btn-close-ticket {
    flex:1; background:transparent; border:1px solid var(--stone); border-radius:100px;
    color:var(--graphite); font-family:'JetBrains Mono', monospace; font-size:.7rem; letter-spacing:.08em;
    padding:.7rem; cursor:pointer; transition:all .15s;
  }
  .support-btn-close-ticket:hover { border-color:#c85050; color:#c85050; }

  .support-new-form { display:flex; flex-direction:column; gap:.875rem; }
  .support-form-label { font-family:'JetBrains Mono', monospace; font-size:.62rem; font-weight:700; letter-spacing:.14em; text-transform:uppercase; color:var(--ash); margin-bottom:.3rem; display:block; }
  .support-form-select {
    width:100%; background:var(--cream); border:1px solid var(--stone); border-radius:10px;
    color:var(--ink); font-family:'Inter',sans-serif; font-size:.85rem;
    padding:.75rem 1rem; outline:none; cursor:pointer;
  }
  .support-form-select option { background:var(--paper); }
  .support-btn-open {
    width:100%; background:var(--coral-500); border:none; border-radius:100px; color:var(--cream);
    font-family:'JetBrains Mono', monospace; font-size:.78rem; letter-spacing:.12em; font-weight:700;
    padding:.85rem; cursor:pointer; transition:background .15s;
  }
  .support-btn-open:hover { background:var(--coral-700); }

  .support-history-section { margin-top:1.25rem; border-top:1px solid var(--stone); padding-top:1rem; }
  .support-history-label { font-family:'JetBrains Mono', monospace; font-size:.62rem; font-weight:700; letter-spacing:.16em; text-transform:uppercase; color:var(--ash); margin-bottom:.75rem; }
  .support-history-item { margin-bottom:.5rem; }
  .support-history-item summary {
    font-size:.78rem; color:var(--graphite); cursor:pointer; padding:.5rem .75rem;
    border-radius:8px; border:1px solid var(--stone); list-style:none;
    display:flex; align-items:center; justify-content:space-between;
    background: var(--paper);
  }
  .support-history-item summary:hover { color:var(--ink); border-color:var(--coral-100); }
  .support-history-item-body { padding:.625rem .5rem 0; }

  /* ── HAMBURGER + DRAWER ── */
  .loov-hamburger {
    display:none; flex-direction:column; justify-content:center; align-items:center;
    gap:5px; width:38px; height:38px; background:none; border:none;
    cursor:pointer; padding:4px; border-radius:10px;
    transition:background 0.15s ease; z-index:110; flex-shrink:0;
  }
  .loov-hamburger:hover { background:var(--sand); }
  .loov-hamburger span { display:block; width:20px; height:1.8px; background:var(--ink); border-radius:99px; transition:transform 0.25s ease, opacity 0.25s ease, width 0.25s ease; transform-origin:center; }
  .loov-hamburger.open span:nth-child(1) { transform:translateY(6.8px) rotate(45deg); }
  .loov-hamburger.open span:nth-child(2) { opacity:0; width:0; }
  .loov-hamburger.open span:nth-child(3) { transform:translateY(-6.8px) rotate(-45deg); }

  .loov-drawer-overlay { display:none; position:fixed; inset:0; z-index:105; background:rgba(40,35,28,0.45); backdrop-filter:blur(4px); -webkit-backdrop-filter:blur(4px); opacity:0; pointer-events:none; transition:opacity 0.25s ease; }
  .loov-drawer-overlay.open { opacity:1; pointer-events:auto; }
  .loov-drawer {
    position:fixed; top:0; right:0; bottom:0; z-index:106;
    width:min(310px,86vw);
    background: var(--paper);
    border-left:1px solid var(--stone);
    display:flex; flex-direction:column;
    padding:80px 1.25rem 2rem; gap:0.25rem;
    transform:translateX(100%);
    transition:transform 0.3s cubic-bezier(0.32,0.72,0,1);
    box-shadow: -8px 0 30px rgba(40,35,28,0.08);
  }
  .loov-drawer.open { transform:translateX(0); }
  .loov-drawer a, .loov-drawer button.drawer-link {
    display:flex; align-items:center; gap:0.7rem;
    padding:0.8rem 1rem; border-radius:12px;
    font-family:'Inter',sans-serif; font-size:0.95rem; font-weight:500;
    color:var(--graphite); text-decoration:none;
    transition:color 0.15s ease, background 0.15s ease;
    background:transparent; border:none; cursor:pointer; width:100%; text-align:left;
  }
  .loov-drawer a:hover, .loov-drawer button.drawer-link:hover { color:var(--ink); background:var(--sand); }
  .loov-drawer a i, .loov-drawer button.drawer-link i { width:18px; text-align:center; font-size:0.9rem; color:var(--coral-500); flex-shrink:0; }
  .loov-drawer .drawer-sep { height:1px; background:var(--stone); margin:0.5rem 0; }
  .loov-drawer a.drawer-exit, .loov-drawer button.drawer-exit { color:var(--ash); margin-top:auto; }
  .loov-drawer a.drawer-exit:hover, .loov-drawer button.drawer-exit:hover { color:#c85050; background:rgba(200,80,80,0.06); }
  .loov-drawer a.drawer-exit i, .loov-drawer button.drawer-exit i { color:inherit; }
  .loov-drawer a.drawer-active { color:var(--coral-700); background:var(--coral-50); }
  .loov-drawer a.drawer-active i { color:var(--coral-500); }

  @media (max-width: 860px) {
    .loov-nav-links { display:none; }
    .loov-hamburger { display:flex; }
    .loov-drawer-overlay { display:block; }
  }
  @media (min-width: 861px) {
    .loov-drawer { display:none !important; }
    .loov-drawer-overlay { display:none !important; }
  }
</style>

<% current_path = request.path %>

<% if user_signed_in? && (current_user.owner? || current_user.attendant?) %>
<div class="support-modal-overlay" id="support-modal-overlay">
  <div class="support-modal">
    <div class="support-modal-header">
      <span class="support-modal-title"><i class="fas fa-headset" style="margin-right:.4rem;"></i>Suporte Loov</span>
      <button class="support-modal-close" id="support-modal-close"><i class="fas fa-xmark"></i></button>
    </div>
    <div class="support-modal-body" id="support-modal-body">
      <div style="text-align:center;padding:2rem;color:var(--ash);font-size:.82rem;">Carregando...</div>
    </div>
    <div class="support-modal-footer" id="support-modal-footer" style="display:none;"></div>
  </div>
</div>
<% end %>

<div class="loov-drawer-overlay" id="drawer-overlay"></div>
<div class="loov-drawer" id="loov-drawer">
  <% if user_signed_in? %>
    <% if current_user.client? %>
      <%= link_to root_path, class: "#{current_path == '/' ? 'drawer-active' : ''}" do %>
        <i class="fas fa-house"></i> Home
      <% end %>
      <%= link_to appointments_path, class: "#{current_path == appointments_path ? 'drawer-active' : ''}" do %>
        <i class="fas fa-calendar-check"></i> Meus Agendamentos
      <% end %>
      <%= link_to client_favorites_path, class: "#{current_path == client_favorites_path ? 'drawer-active' : ''}" do %>
        <i class="fas fa-heart"></i> Favoritos
      <% end %>
      <%= link_to client_notifications_path, class: "#{current_path == client_notifications_path ? 'drawer-active' : ''}" do %>
        <i class="fas fa-bell"></i> Notificações
        <span id="drawer-notif-badge" style="margin-left:auto;display:none;font-size:0.65rem;color:var(--coral-700);background:var(--coral-50);border:1px solid var(--coral-100);border-radius:100px;padding:2px 8px;font-family:'JetBrains Mono',monospace;font-weight:700;"></span>
      <% end %>
      <div class="drawer-sep"></div>
      <%= link_to edit_client_profile_path, class: "#{current_user.profile_complete? ? '' : 'drawer-active'}" do %>
        <i class="fas fa-user"></i>
        Meu Perfil
        <% unless current_user.profile_complete? %>
          <span style="margin-left:auto;font-size:0.65rem;color:#ffaa00;background:rgba(255,170,0,0.1);border:1px solid rgba(255,170,0,0.2);border-radius:100px;padding:2px 8px;">Incompleto</span>
        <% end %>
      <% end %>
      <%= link_to destroy_user_session_path, method: :delete, class: "drawer-exit" do %>
        <i class="fas fa-arrow-right-from-bracket"></i> Sair
      <% end %>

    <% elsif current_user.owner? %>
      <% @car_wash = current_user.car_washes.first if @car_wash.nil? %>
      <% if @car_wash&.persisted? %>
        <%= link_to manage_car_wash_path(@car_wash), class: "#{current_path.include?('/manage') ? 'drawer-active' : ''}" do %>
          <i class="fas fa-store"></i> Meu Negócio
        <% end %>
      <% else %>
        <%= link_to new_car_wash_path do %><i class="fas fa-store"></i> Cadastrar Negócio<% end %>
      <% end %>
      <%= link_to owner_car_wash_appointments_path, class: "#{current_path.include?('appointments') ? 'drawer-active' : ''}" do %><i class="fas fa-calendar-days"></i> Agenda<% end %>
      <%= link_to owner_monthly_costs_path, class: "#{current_path.include?('monthly_costs') ? 'drawer-active' : ''}" do %><i class="fas fa-wallet"></i> Financeiro<% end %>
      <%= link_to owner_financial_tracking_path, class: "#{current_path.include?('financial_tracking') ? 'drawer-active' : ''}" do %><i class="fas fa-wand-magic-sparkles"></i> IA insights<% end %>
      <%= link_to owner_attendant_invitations_path, class: "#{current_path.include?('attendant') ? 'drawer-active' : ''}" do %><i class="fas fa-users"></i> Equipe<% end %>
      <div class="drawer-sep"></div>
      <%= link_to destroy_user_session_path, method: :delete, class: "drawer-exit" do %><i class="fas fa-arrow-right-from-bracket"></i> Sair<% end %>

    <% elsif current_user.attendant? %>
      <% _cw = current_car_wash %>
      <% if _cw %>
        <%= link_to manage_car_wash_path(_cw), class: "#{current_path.include?('/manage') ? 'drawer-active' : ''}" do %><i class="fas fa-store"></i> Meu Negócio<% end %>
        <%= link_to edit_owner_monthly_costs_path, class: "#{current_path.include?('monthly_costs') ? 'drawer-active' : ''}" do %><i class="fas fa-wallet"></i> Financeiro<% end %>
      <% end %>
      <div class="drawer-sep"></div>
      <%= link_to destroy_user_session_path, method: :delete, class: "drawer-exit" do %><i class="fas fa-arrow-right-from-bracket"></i> Sair<% end %>

    <% else %>
      <%= link_to destroy_user_session_path, method: :delete, class: "drawer-exit" do %><i class="fas fa-arrow-right-from-bracket"></i> Sair<% end %>
    <% end %>
  <% else %>
    <%= link_to new_user_session_path do %><i class="fas fa-arrow-right-to-bracket"></i> Entrar<% end %>
    <%= link_to new_user_registration_path do %><i class="fas fa-user-plus"></i> Criar Conta<% end %>
  <% end %>
</div>

