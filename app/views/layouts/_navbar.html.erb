<script nonce="<%= csp_nonce %>">
(function() {
  const CSRF = document.querySelector('meta[name="csrf-token"]')?.content;

  // ── HAMBURGER ─────────────────────────────────────────────────────────
  const hamburger = document.getElementById('loov-hamburger');
  const drawer    = document.getElementById('loov-drawer');
  const overlay   = document.getElementById('drawer-overlay');

  function openDrawer()  { hamburger.classList.add('open'); drawer.classList.add('open'); overlay.classList.add('open'); document.body.style.overflow='hidden'; }
  function closeDrawer() { hamburger.classList.remove('open'); drawer.classList.remove('open'); overlay.classList.remove('open'); document.body.style.overflow=''; }

  hamburger.addEventListener('click', () => drawer.classList.contains('open') ? closeDrawer() : openDrawer());
  overlay.addEventListener('click', closeDrawer);
  drawer.querySelectorAll('a').forEach(a => a.addEventListener('click', closeDrawer));

  // ── SINO CLIENTE ─────────────────────────────────────────────────────
  const bellBtn   = document.getElementById('nav-bell-btn');
  const bellBadge = document.getElementById('nav-bell-badge');
  const dropdown  = document.getElementById('nav-notif-dropdown');
  const notifList = document.getElementById('nav-notif-list');

  if (bellBtn) {
    const SEEN_KEY = 'loov_notif_seen_at';
    function getSeenAt() { const v=localStorage.getItem(SEEN_KEY); return v?new Date(v):new Date(0); }
    function markAsSeen() { localStorage.setItem(SEEN_KEY, new Date().toISOString()); }

    document.addEventListener('click', function(e) {
      if (!bellBtn.closest('.nav-bell-wrap').contains(e.target)) dropdown.classList.remove('open');
    });

    bellBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      const isOpen = dropdown.classList.contains('open');
      dropdown.classList.toggle('open');
      if (!isOpen) { markAsSeen(); bellBtn.classList.remove('has-notif'); bellBadge.classList.remove('visible'); bellBadge.textContent=''; loadNotifications(); }
    });

    const PAGE_SIZE = 8;
    let allNotifs   = [];

    function loadNotifications() {
      fetch('/client/notifications', { headers: { Accept: 'application/json' } })
        .then(r => r.json()).then(data => { allNotifs = Array.isArray(data) ? data : []; renderNotifications(allNotifs, PAGE_SIZE); }).catch(() => {});
    }

    // Mesmo formato da página /client/notifications e do app:
    // { id, type, title, desc, created_at, read }. O sino ainda lia o formato
    // antigo (service_name, car_wash_name…) e mostrava "undefined".
    const NOTIF_META = {
      appointment_confirmed: { iconClass: 'confirmed', icon: 'fa-check',          tag: 'CONFIRMADA' },
      appointment_rejected:  { iconClass: 'rejected',  icon: 'fa-times',          tag: 'RECUSADA' },
      appointment_cancelled: { iconClass: 'cancelled', icon: 'fa-calendar-xmark', tag: 'CANCELADA' },
      review_available:      { iconClass: 'pending',   icon: 'fa-star',           tag: 'AVALIAR' },
      owner_message:         { iconClass: 'regular',   icon: 'fa-comment',        tag: 'MENSAGEM' }
    };
    function notifEsc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])); }
    function notifTime(iso) {
      if (!iso) return '';
      const t = new Date(iso), s = Math.floor((Date.now() - t.getTime()) / 1000);
      if (s < 60) return 'agora';
      if (s < 3600) return 'há ' + Math.floor(s / 60) + ' min';
      if (s < 86400) return 'há ' + Math.floor(s / 3600) + 'h';
      if (s < 604800) return 'há ' + Math.floor(s / 86400) + 'd';
      return t.toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit' });
    }
    // Pra onde o toque leva: avaliação direto no atendimento; reservas, Agenda.
    function notifHref(item) {
      if (item.type === 'review_available') { const m = /-(\d+)$/.exec(item.id || ''); return '/appointments' + (m ? '#avaliar-' + m[1] : ''); }
      if (/^appointment_/.test(item.type || '')) return '/appointments';
      return '/client/notifications';
    }

    function renderNotifications(items, limit) {
      if (!Array.isArray(items) || !items.length) { notifList.innerHTML='<div class="nav-notif-empty">Nenhuma notificação.</div>'; return; }
      const visible  = items.slice(0, limit);
      const hasMore  = items.length > limit;
      notifList.innerHTML = visible.map(item => {
        const m = NOTIF_META[item.type] || { iconClass: 'pending', icon: 'fa-bell', tag: 'AVISO' };
        return `<a class="nav-notif-item${item.read ? '' : ' is-unread'}" href="${notifHref(item)}" data-notif-id="${notifEsc(item.id)}">
          <div class="nav-notif-icon ${m.iconClass}"><i class="fas ${m.icon}"></i></div>
          <div style="min-width:0;flex:1;">
            <div class="nav-notif-meta"><span>${m.tag}</span><span>${notifTime(item.created_at)}${item.read ? '' : '<i class="nav-notif-dot"></i>'}</span></div>
            <div class="nav-notif-title">${notifEsc(item.title)}</div>
            <div class="nav-notif-sub">${notifEsc(item.desc)}</div>
          </div>
        </a>`;
      }).join('') + (hasMore
        ? `<button type="button" data-notif-more style="width:100%;padding:.7rem;background:var(--cream);border:none;border-top:1px solid var(--stone);color:var(--coral-700);font-family:'JetBrains Mono',monospace;font-size:.66rem;letter-spacing:.1em;cursor:pointer;transition:color .15s;">VER MAIS ${items.length - limit}</button>`
        : '');
    }

    // Tocar marca como lida antes de sair (senão a próxima página ainda a vê nova).
    notifList.addEventListener('click', function (e) {
      const a = e.target.closest('[data-notif-id]');
      if (!a || !a.classList.contains('is-unread')) return;
      e.preventDefault();
      const csrf = document.querySelector('meta[name="csrf-token"]')?.content;
      fetch('/client/notifications/' + encodeURIComponent(a.dataset.notifId) + '/read', { method: 'PATCH', credentials: 'same-origin', headers: { Accept: 'application/json', 'X-CSRF-Token': csrf } })
        .catch(() => {}).finally(() => { location.href = a.getAttribute('href'); });
    });

    window.expandNotifs = function() { renderNotifications(allNotifs, allNotifs.length); };
    // Listener em vez de onclick embutido: a página de cartão bloqueia eventos inline.
    notifList.addEventListener('click', function (e) { if (e.target.closest('[data-notif-more]')) { e.stopPropagation(); expandNotifs(); } });

    function pollBadge() {
      if (dropdown.classList.contains('open')) return;
      fetch('/client/notifications', { headers: { Accept: 'application/json' } })
        .then(r => r.json()).then(data => {
          // Conta não-lidas (campo `read` do controller). Fallback pra
          // notif_at + seenAt pra compatibilidade com versão antiga.
          const seenAt = getSeenAt();
          const newCount = data.filter(i => {
            if (typeof i.read === 'boolean') return !i.read;
            return i.notif_at && new Date(i.notif_at) > seenAt;
          }).length;

          if (newCount > 0) {
            bellBtn.classList.add('has-notif');
            bellBadge.textContent = newCount;
            bellBadge.classList.add('visible');
          } else {
            bellBtn.classList.remove('has-notif');
            bellBadge.classList.remove('visible');
          }

          // Espelha no badge do drawer mobile
          const drawerBadge = document.getElementById('drawer-notif-badge');
          if (drawerBadge) {
            if (newCount > 0) {
              drawerBadge.textContent = newCount;
              drawerBadge.style.display = 'inline-block';
            } else {
              drawerBadge.style.display = 'none';
            }
          }
        }).catch(() => {});
    }

    document.addEventListener('DOMContentLoaded', () => { pollBadge(); setInterval(pollBadge, 8000); });
  }

  // ── SUPORTE OWNER/ATTENDANT ───────────────────────────────────────────
  // O botão leva pra página de suporte (/suporte), a mesma conversa do app.
  // Antes abria uma janelinha própria, com outro desenho e só um chamado por
  // vez. Aqui fica só o aviso de resposta nova no ícone.
  const supportBtn   = document.getElementById('nav-support-btn');
  const supportBadge = document.getElementById('nav-support-badge');

  if (supportBtn) {
    supportBtn.addEventListener('click', () => { window.location.href = '/suporte'; });

    // Aviso no ícone: alguma resposta da Loov ainda não vista (unread_reply,
    // marcado como visto ao abrir a conversa no site ou no app).
    function pollSupportBadge() {
      fetch('/owner/support_tickets', { headers: { Accept: 'application/json' } })
        .then(r => r.json()).then(tickets => {
          const n = (Array.isArray(tickets) ? tickets : []).filter(t => t.unread_reply).length;
          supportBtn.classList.toggle('has-reply', n > 0);
          supportBadge.textContent = n > 9 ? '9+' : String(n);
          supportBadge.classList.toggle('visible', n > 0);
        }).catch(() => {});
    }

    document.addEventListener('DOMContentLoaded', () => { pollSupportBadge(); setInterval(pollSupportBadge, 15000); });
  }
})();
</script>
