<script>
(function() {
  const CSRF = document.querySelector('meta[name="csrf-token"]')?.content;

  // ── HAMBURGER ─────────────────────────────────────────────────────────
  const hamburger = document.getElementById('loov-hamburger');
  const drawer    = document.getElementById('loov-drawer');
  const overlay   = document.getElementById('drawer-overlay');

  function openDrawer()  { hamburger.classList.add('open'); drawer.classList.add('open'); overlay.classList.add('open'); document.body.style.overflow='hidden'; }
  function closeDrawer() { hamburger.classList.remove('open'); drawer.classList.remove('open'); overlay.classList.remove('open'); document.body.style.overflow=''; }

  hamburger.addEventListener('click', () => drawer.classList.contains('open') ? closeDrawer() : openDrawer());
  overlay.addEventListener('click', closeDrawer);
  drawer.querySelectorAll('a').forEach(a => a.addEventListener('click', closeDrawer));

  // ── SINO CLIENTE ─────────────────────────────────────────────────────
  const bellBtn   = document.getElementById('nav-bell-btn');
  const bellBadge = document.getElementById('nav-bell-badge');
  const dropdown  = document.getElementById('nav-notif-dropdown');
  const notifList = document.getElementById('nav-notif-list');

  if (bellBtn) {
    const SEEN_KEY = 'loov_notif_seen_at';
    function getSeenAt() { const v=localStorage.getItem(SEEN_KEY); return v?new Date(v):new Date(0); }
    function markAsSeen() { localStorage.setItem(SEEN_KEY, new Date().toISOString()); }

    document.addEventListener('click', function(e) {
      if (!bellBtn.closest('.nav-bell-wrap').contains(e.target)) dropdown.classList.remove('open');
    });

    bellBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      const isOpen = dropdown.classList.contains('open');
      dropdown.classList.toggle('open');
      if (!isOpen) { markAsSeen(); bellBtn.classList.remove('has-notif'); bellBadge.classList.remove('visible'); bellBadge.textContent=''; loadNotifications(); }
    });

    const PAGE_SIZE = 8;
    let allNotifs   = [];

    function loadNotifications() {
      fetch('/client/notifications', { headers: { Accept: 'application/json' } })
        .then(r => r.json()).then(data => { allNotifs = data; renderNotifications(data, PAGE_SIZE); }).catch(() => {});
    }

    function notifMeta(item) {
      let iconClass, icon, title;
      if (item.type === 'cancelled_by_establishment') {
        iconClass = 'cancelled'; icon = 'fa-calendar-xmark'; title = 'Reserva cancelada';
      } else if (item.type === 'regular_confirmed') {
        iconClass = 'regular'; icon = 'fa-calendar-check'; title = 'Agendamento confirmado';
      } else if (item.type === 'disponivel') {
        if (item.status === 'confirmed')      { iconClass='confirmed'; icon='fa-check';    title='Reserva confirmada!'; }
        else if (item.status === 'rejected')  { iconClass='rejected';  icon='fa-times';    title='Reserva recusada'; }
        else if (item.status === 'cancelled') { iconClass='rejected';  icon='fa-times';    title='Reserva expirou'; }
        else                                  { iconClass='pending';   icon='fa-clock';    title='Aguardando confirmação'; }
      } else {
        iconClass = 'pending'; icon = 'fa-clock'; title = 'Notificação';
      }
      return { iconClass, icon, title };
    }

    function renderNotifications(items, limit) {
      if (!items.length) { notifList.innerHTML='<div class="nav-notif-empty">Nenhuma notificação.</div>'; return; }
      const visible  = items.slice(0, limit);
      const hasMore  = items.length > limit;
      notifList.innerHTML = visible.map(item => {
        const { iconClass, icon, title } = notifMeta(item);
        return `<a class="nav-notif-item" href="/appointments">
          <div class="nav-notif-icon ${iconClass}"><i class="fas ${icon}"></i></div>
          <div style="min-width:0;">
            <div class="nav-notif-title">${title}</div>
            <div class="nav-notif-sub">${item.service_name} · ${item.car_wash_name}<br>${item.scheduled_at}</div>
          </div>
        </a>`;
      }).join('') + (hasMore
        ? `<button onclick="expandNotifs()" style="width:100%;padding:.7rem;background:var(--cream);border:none;border-top:1px solid var(--stone);color:var(--coral-700);font-family:'JetBrains Mono',monospace;font-size:.66rem;letter-spacing:.1em;cursor:pointer;transition:color .15s;">VER MAIS ${items.length - limit}</button>`
        : '');
    }

    window.expandNotifs = function() { renderNotifications(allNotifs, allNotifs.length); };

    function pollBadge() {
      if (dropdown.classList.contains('open')) return;
      fetch('/client/notifications', { headers: { Accept: 'application/json' } })
        .then(r => r.json()).then(data => {
          // Conta não-lidas (campo `read` do controller). Fallback pra
          // notif_at + seenAt pra compatibilidade com versão antiga.
          const seenAt = getSeenAt();
          const newCount = data.filter(i => {
            if (typeof i.read === 'boolean') return !i.read;
            return i.notif_at && new Date(i.notif_at) > seenAt;
          }).length;

          if (newCount > 0) {
            bellBtn.classList.add('has-notif');
            bellBadge.textContent = newCount;
            bellBadge.classList.add('visible');
          } else {
            bellBtn.classList.remove('has-notif');
            bellBadge.classList.remove('visible');
          }

          // Espelha no badge do drawer mobile
          const drawerBadge = document.getElementById('drawer-notif-badge');
          if (drawerBadge) {
            if (newCount > 0) {
              drawerBadge.textContent = newCount;
              drawerBadge.style.display = 'inline-block';
            } else {
              drawerBadge.style.display = 'none';
            }
          }
        }).catch(() => {});
    }

    document.addEventListener('DOMContentLoaded', () => { pollBadge(); setInterval(pollBadge, 8000); });
  }

  // ── SUPORTE OWNER/ATTENDANT ───────────────────────────────────────────
  const supportBtn     = document.getElementById('nav-support-btn');
  const supportOverlay = document.getElementById('support-modal-overlay');
  const supportClose   = document.getElementById('support-modal-close');
  const supportBody    = document.getElementById('support-modal-body');
  const supportFooter  = document.getElementById('support-modal-footer');
  const supportBadge   = document.getElementById('nav-support-badge');

  if (supportBtn) {
    let currentTicket = null;

    function openSupportModal() {
      supportOverlay.classList.add('open');
      document.body.style.overflow = 'hidden';
      loadTicket();
    }

    function closeSupportModal() {
      supportOverlay.classList.remove('open');
      document.body.style.overflow = '';
    }

    supportBtn.addEventListener('click', openSupportModal);
    supportClose.addEventListener('click', closeSupportModal);
    supportOverlay.addEventListener('click', e => { if (e.target === supportOverlay) closeSupportModal(); });

    function loadTicket() {
      supportBody.innerHTML = '<div style="text-align:center;padding:2rem;color:var(--ash);font-size:.82rem;">Carregando...</div>';
      supportFooter.style.display = 'none';
      fetch('/owner/support_tickets', { headers: { Accept: 'application/json' } })
        .then(r => r.json())
        .then(tickets => {
          const open     = tickets.find(t => t.status !== 'resolved');
          const resolved = tickets.filter(t => t.status === 'resolved');
          currentTicket  = open || null;
          if (open) renderThread(open, resolved);
          else renderNewForm(resolved);
        }).catch(() => {
          supportBody.innerHTML = '<div style="text-align:center;padding:2rem;color:#c85050;">Erro ao carregar suporte.</div>';
        });
    }

    function buildHistoryHtml(resolvedTickets) {
      if (!resolvedTickets.length) return '';
      return `
        <div class="support-history-section">
          <div class="support-history-label">Chamados anteriores</div>
          ${resolvedTickets.map(t => `
            <details class="support-history-item">
              <summary>#${t.id} · ${t.category} · ${t.created_at} <span style="font-size:.6rem;color:var(--ash);">▼</span></summary>
              <div class="support-history-item-body">
                ${t.messages.map(m => `
                  <div class="support-msg ${m.from_admin ? 'support-msg-admin' : 'support-msg-owner'}" style="margin-bottom:4px;">
                    <div class="support-msg-author">${m.author} · ${m.created_at}</div>
                    <div class="support-msg-body">${m.body}</div>
                  </div>`).join('')}
              </div>
            </details>`).join('')}
        </div>`;
    }

    function renderThread(ticket, resolvedTickets = []) {
      const statusColor = ticket.status === 'resolved' ? 'var(--coral-700)' : '#2a5f8a';
      const statusLabel = ticket.status === 'resolved' ? 'Resolvido' : ticket.status === 'in_progress' ? 'Em andamento' : 'Aberto';
      const msgs = ticket.messages.map(m => `
        <div class="support-msg ${m.from_admin ? 'support-msg-admin' : 'support-msg-owner'}">
          <div class="support-msg-author">${m.author} · ${m.created_at}</div>
          <div class="support-msg-body">${m.body}</div>
        </div>`).join('');

      supportBody.innerHTML = `
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.875rem;">
          <span style="font-family:'JetBrains Mono',monospace;font-size:.66rem;letter-spacing:.1em;color:var(--graphite);">#${ticket.id} · ${ticket.category}</span>
          <span style="font-family:'JetBrains Mono',monospace;font-size:.66rem;letter-spacing:.1em;font-weight:700;color:${statusColor};">${statusLabel}</span>
        </div>
        <div class="support-thread" id="support-thread-msgs">${msgs || '<div style="font-size:.78rem;color:var(--ash);padding:.5rem 0;">Nenhuma mensagem ainda.</div>'}</div>
        ${buildHistoryHtml(resolvedTickets)}`;

      const thread = supportBody.querySelector('#support-thread-msgs');
      if (thread) setTimeout(() => { thread.scrollTop = thread.scrollHeight; }, 50);

      if (ticket.status !== 'resolved') {
        supportFooter.style.display = 'block';
        supportFooter.innerHTML = `
          <textarea class="support-textarea" id="support-msg-input" placeholder="Escreva sua mensagem..."></textarea>
          <div class="support-footer-actions">
            <button class="support-btn-send" id="support-send-btn"><i class="fas fa-paper-plane"></i> ENVIAR</button>
            <button class="support-btn-close-ticket" id="support-close-btn">ENCERRAR</button>
          </div>`;
        document.getElementById('support-send-btn').addEventListener('click', sendMessage);
        document.getElementById('support-close-btn').addEventListener('click', closeTicket);
      } else {
        supportFooter.style.display = 'block';
        supportFooter.innerHTML = `<button class="support-btn-open" id="support-new-btn" style="background:transparent;border:1px solid var(--stone);color:var(--graphite);">ABRIR NOVO CHAMADO</button>`;
        document.getElementById('support-new-btn').addEventListener('click', () => renderNewForm(resolvedTickets));
      }
    }

    function renderNewForm(resolvedTickets = []) {
      supportBody.innerHTML = `
        <p style="font-size:.85rem;color:var(--graphite);margin-bottom:1rem;line-height:1.55;">Como podemos ajudar? Descreva o problema e nossa equipe responderá em breve.</p>
        <div class="support-new-form">
          <div>
            <label class="support-form-label">Categoria</label>
            <select class="support-form-select" id="support-category">
              <option value="financeiro">Financeiro / Relatórios</option>
              <option value="agendamento">Agendamento</option>
              <option value="cadastro">Cadastro e perfil</option>
              <option value="tecnico">Técnico / Bug</option>
              <option value="disponivel">Disponíveis</option>
              <option value="atendente">Equipe / Atendentes</option>
              <option value="cancelamento">Cancelamento</option>
              <option value="outro">Outro</option>
            </select>
          </div>
          <div>
            <label class="support-form-label">Descreva o problema</label>
            <textarea class="support-textarea" id="support-description" placeholder="Ex: Não consigo visualizar o relatório do mês de março..." style="min-height:100px;"></textarea>
          </div>
          <div id="support-open-error" style="display:none;font-size:.75rem;color:#c85050;padding:.5rem .75rem;background:rgba(200,80,80,0.06);border:1px solid rgba(200,80,80,0.18);border-radius:8px;"></div>
          <button class="support-btn-open" id="support-open-btn"><i class="fas fa-headset"></i> ABRIR CHAMADO</button>
        </div>
        ${buildHistoryHtml(resolvedTickets)}`;
      supportFooter.style.display = 'none';
      document.getElementById('support-open-btn').addEventListener('click', openTicket);
    }

    function openTicket() {
      const category    = document.getElementById('support-category').value;
      const description = document.getElementById('support-description').value.trim();
      const errEl       = document.getElementById('support-open-error');
      if (!description) { errEl.textContent='Descreva o problema antes de abrir o chamado.'; errEl.style.display='block'; return; }
      errEl.style.display = 'none';
      const btn = document.getElementById('support-open-btn');
      btn.disabled = true; btn.textContent = 'Abrindo...';
      fetch('/owner/support_tickets', {
        method: 'POST',
        headers: { 'X-CSRF-Token': CSRF, 'Content-Type': 'application/json' },
        body: JSON.stringify({ category, description })
      }).then(r => r.json()).then(data => {
        if (data.ok) { currentTicket = data.ticket; renderThread(data.ticket, []); }
        else { errEl.textContent = data.error || 'Erro ao abrir chamado.'; errEl.style.display='block'; btn.disabled=false; btn.innerHTML='<i class="fas fa-headset"></i> ABRIR CHAMADO'; }
      }).catch(() => { errEl.textContent='Erro de conexão. Tente novamente.'; errEl.style.display='block'; btn.disabled=false; btn.innerHTML='<i class="fas fa-headset"></i> ABRIR CHAMADO'; });
    }

    function sendMessage() {
      const input = document.getElementById('support-msg-input');
      const body  = input?.value.trim();
      if (!body) return;
      const btn = document.getElementById('support-send-btn');
      btn.disabled = true; btn.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i>';
      fetch(`/owner/support_tickets/${currentTicket.id}/message`, {
        method: 'POST',
        headers: { 'X-CSRF-Token': CSRF, 'Content-Type': 'application/json' },
        body: JSON.stringify({ body })
      }).then(r => r.json()).then(data => {
        if (data.ok) { currentTicket = data.ticket; renderThread(data.ticket, []); }
        else { alert(data.error || 'Erro ao enviar.'); }
        btn.disabled = false; btn.innerHTML = '<i class="fas fa-paper-plane"></i> ENVIAR';
      }).catch(() => { btn.disabled = false; btn.innerHTML = '<i class="fas fa-paper-plane"></i> ENVIAR'; });
    }

    function closeTicket() {
      openConfirmModal(
        'Encerrar chamado',
        'Tem certeza que deseja encerrar este chamado? Ele ficará no histórico.',
        function() {
          fetch(`/owner/support_tickets/${currentTicket.id}/close`, {
            method: 'PATCH',
            headers: { 'X-CSRF-Token': CSRF, 'Content-Type': 'application/json' }
          }).then(r => r.json()).then(data => {
            if (data.ok) loadTicket();
          });
        }
      );
    }

    // ── MODAL CONFIRM GENÉRICO ─────────────────────────────────────────
    function openConfirmModal(title, message, onConfirm) {
      let overlay = document.getElementById('loov-confirm-overlay');
      if (!overlay) {
        overlay = document.createElement('div');
        overlay.id = 'loov-confirm-overlay';
        overlay.style.cssText = 'position:fixed;inset:0;z-index:500;background:rgba(40,35,28,.55);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;padding:1rem;';
        overlay.innerHTML = `<div style="background:var(--paper);border:1px solid var(--stone);border-radius:20px;width:100%;max-width:380px;padding:1.5rem;box-shadow:0 20px 60px rgba(40,35,28,0.2);">
          <div id="loov-confirm-title" style="font-family:'JetBrains Mono',monospace;font-size:.66rem;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:#c85050;margin-bottom:.6rem;"></div>
          <div id="loov-confirm-msg" style="font-size:.85rem;color:var(--graphite);margin-bottom:1.25rem;line-height:1.55;"></div>
          <div style="display:flex;gap:.5rem;">
            <button id="loov-confirm-cancel" style="flex:1;background:transparent;border:1px solid var(--stone);border-radius:100px;color:var(--graphite);font-family:'JetBrains Mono',monospace;font-size:.7rem;letter-spacing:.1em;padding:.7rem;cursor:pointer;">VOLTAR</button>
            <button id="loov-confirm-ok" style="flex:2;background:rgba(200,80,80,0.08);border:1px solid rgba(200,80,80,0.25);border-radius:100px;color:#c85050;font-family:'JetBrains Mono',monospace;font-size:.7rem;letter-spacing:.1em;font-weight:700;padding:.7rem;cursor:pointer;">CONFIRMAR</button>
          </div>
        </div>`;
        document.body.appendChild(overlay);
        overlay.addEventListener('click', e => { if(e.target===overlay) overlay.style.display='none'; });
        overlay.querySelector('#loov-confirm-cancel').addEventListener('click', () => overlay.style.display='none');
      }
      overlay.querySelector('#loov-confirm-title').textContent = title;
      overlay.querySelector('#loov-confirm-msg').textContent   = message;
      overlay.querySelector('#loov-confirm-ok').onclick = () => { overlay.style.display='none'; onConfirm(); };
      overlay.style.display = 'flex';
    }

    function pollSupportBadge() {
      fetch('/owner/support_tickets', { headers: { Accept: 'application/json' } })
        .then(r => r.json()).then(tickets => {
          const open = tickets.find(t => t.status !== 'resolved');
          if (open && open.messages.some(m => m.from_admin)) {
            const lastAdmin = open.messages.filter(m => m.from_admin).pop();
            const lastOwner = open.messages.filter(m => !m.from_admin).pop();
            const hasNew = lastAdmin && (!lastOwner || new Date(lastAdmin.created_at) > new Date(lastOwner.created_at));
            if (hasNew) { supportBtn.classList.add('has-reply'); supportBadge.textContent='1'; supportBadge.classList.add('visible'); return; }
          }
          supportBtn.classList.remove('has-reply'); supportBadge.classList.remove('visible');
        }).catch(() => {});
    }

    document.addEventListener('DOMContentLoaded', () => { pollSupportBadge(); setInterval(pollSupportBadge, 15000); });
  }
})();
</script>
