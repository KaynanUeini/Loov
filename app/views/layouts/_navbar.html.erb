        <li><%= link_to "IA insights", owner_financial_tracking_path, class: current_path.include?('financial_tracking') ? 'active' : '' %></li>
        <li><%= link_to "Equipe", owner_attendant_invitations_path, class: current_path.include?('attendant') ? 'active' : '' %></li>
