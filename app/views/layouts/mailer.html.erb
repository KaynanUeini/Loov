<%#
  Base de todo e-mail da Loov. Cada e-mail só escreve o miolo do cartão.
    content_for :preheader — frase ao lado do assunto na caixa de entrada
    content_for :footer    — por que a pessoa recebeu este e-mail

  Regras de e-mail, não de site: layout em tabela e estilo inline (Gmail e
  Outlook ignoram <style> e flex), nenhuma imagem — a marca é o selo LOOV
  em HTML, igual ao do topo do site. Peças em app/views/emails/_*.
%>
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <meta name="supported-color-schemes" content="light">
  <title>Loov</title>
</head>
<body style="margin:0;padding:0;background:#f1eee6;">
  <% if content_for?(:preheader) %>
    <div style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;"><%= yield :preheader %></div>
  <% end %>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f1eee6;">
    <tr>
      <td align="center" style="padding:40px 16px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:520px;">

          <tr>
            <td style="padding:0 0 24px 4px;">
              <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td style="background:#1a1612;border-radius:999px;padding:9px 16px 9px 14px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;font-weight:700;letter-spacing:0.5px;color:#fafaf6;">
                    <span style="color:#dd7852;">&#9673;</span>&nbsp; LOOV
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td style="background:#fefefd;border-radius:24px;padding:40px 36px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#28231c;">
              <%= yield %>
            </td>
          </tr>

          <tr>
            <td style="padding:24px 8px 0;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;line-height:18px;color:#ada699;text-align:center;">
              <% if content_for?(:footer) %><%= yield :footer %><br><% end %>
              Loov · agendamento de lava-rápidos
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
