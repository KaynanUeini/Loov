<!DOCTYPE html>
<html data-theme="loov">
<head>
  <title>Loov</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500&family=Montserrat:wght@400;500;700&family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap">
  <link rel="stylesheet" href="/assets/tailwind.css">
  <link rel="stylesheet" href="/assets/application.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.5.1/css/all.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.css">
  <script src="https://js.stripe.com/v3/"></script>
  <script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/matter-js@0.19.0/build/matter.min.js"></script>
  <style>
    #matter-wrap-container {
      position: fixed;
      top: 0; left: 0;
      width: 100vw; height: 100vh;
      z-index: 0;
      overflow: hidden;
    }
    #matter-wrap-container canvas {
      display: block;
      width: 100vw !important;
      height: 100vh !important;
    }
  </style>

  <%# ─── LOOV THEME — global override ─────────────────────────────────
       Mantém estrutura/layout das páginas existentes; só remapeia as
       variáveis CSS legacy (lime/black/surface/etc) pra paleta Loov
       (cream/coral/sand) e força fontes Inter + Space Grotesk +
       JetBrains Mono. Páginas que usam var(--lime), var(--surface),
       etc auto-adotam o novo design sem alterações no markup. %>
  <style>
    :root {
      /* Tokens Loov canônicos */
      --cream:    #fafaf6;
      --paper:    #fefefd;
      --sand:     #f1eee6;
      --stone:    #e0dbd0;
      --ash:      #ada699;
      --graphite: #575148;
      --ink:      #28231c;
      --obsidian: #1a1612;

      --coral-50:  #fbeae3;
      --coral-100: #f5d3c3;
      --coral-300: #e8a48a;
      --coral-500: #dd7852;
      --coral-700: #9c4930;

      --pool-50:   #eaf1f7;
      --pool-100:  #d1e1ed;
      --pool-500:  #4b8ec0;
      --pool-700:  #2a5f8a;

      --mint-500:  #5dc39f;
      --amber-500: #d6b14a;
      --rose-500:  #c85050;

      /* ── Remapeamento dos tokens legacy ───────────────────────── */
      --black:        var(--cream);     /* backgrounds principais */
      --surface:      var(--paper);
      --surface-2:    var(--paper);
      --surface-3:    var(--sand);

      --border:       var(--stone);
      --border-soft:  var(--stone);

      --white:        var(--ink);       /* textos primários sobre cream */
      --text-muted:   var(--ash);
      --text-secondary: var(--graphite);

      --lime:         var(--coral-500); /* destaques/accents */
      --lime-dim:     var(--coral-700);

      --orange:       var(--coral-500);
      --yellow:       var(--amber-500);
      --red:          var(--rose-500);
      --blue:         var(--pool-500);
    }

    /* ── Body global e tipografia ─────────────────────────────────── */
    html, body {
      background: var(--cream) !important;
      color: var(--ink) !important;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif !important;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    /* Títulos: Space Grotesk (substitui Bebas Neue) */
    h1, h2, h3, h4, h5, h6,
    .home-tagline, .sidebar-cw-name {
      font-family: 'Space Grotesk', 'Inter', sans-serif !important;
      letter-spacing: -0.3px;
      color: var(--ink);
    }

    /* Eyebrow / labels mono coral — qualquer .eyebrow ou role/label */
    .eyebrow, .sidebar-cw-role, .label-mono,
    [class*="eyebrow"], [class*="label-uppercase"] {
      font-family: 'JetBrains Mono', monospace !important;
      letter-spacing: 1.5px;
      color: var(--coral-500);
      text-transform: uppercase;
    }

    /* Inputs e textareas — paper/stone */
    input[type="text"], input[type="email"], input[type="password"],
    input[type="number"], input[type="date"], input[type="time"],
    input[type="tel"], input[type="search"], input[type="url"],
    select, textarea {
      background: var(--paper) !important;
      border: 1px solid var(--stone) !important;
      color: var(--ink) !important;
      border-radius: 12px;
      transition: border-color .15s;
    }
    input:focus, select:focus, textarea:focus {
      border-color: var(--coral-500) !important;
      outline: none;
    }
    input::placeholder, textarea::placeholder {
      color: var(--ash) !important;
    }

    /* Botões primários (coral) — qualquer btn-primary ou similar */
    .btn-primary, .btn--primary,
    button[type="submit"]:not(.btn-secondary):not(.btn-ghost) {
      background: var(--coral-500) !important;
      color: var(--cream) !important;
      border: none !important;
      transition: background .15s, transform .15s;
    }
    .btn-primary:hover, button[type="submit"]:hover { background: var(--coral-700) !important; }

    /* Botões secundários (paper outlined) */
    .btn-secondary, .btn--secondary {
      background: var(--paper) !important;
      color: var(--ink) !important;
      border: 1px solid var(--stone) !important;
    }
    .btn-secondary:hover { border-color: var(--coral-500) !important; color: var(--coral-700) !important; }

    /* Cards genéricos — qualquer .card sem fundo explícito */
    .card, .panel, .box {
      background: var(--paper);
      border: 1px solid var(--stone);
      border-radius: 16px;
      box-shadow: 0 2px 6px rgba(25,20,15,0.04);
      color: var(--ink);
    }

    /* Links */
    a { color: var(--coral-700); }
    a:hover { color: var(--coral-500); }

    /* Navbar — fundo claro */
    .navbar, nav.navbar, .top-nav, header.navbar {
      background: var(--cream) !important;
      border-bottom: 1px solid var(--stone) !important;
      color: var(--ink) !important;
    }
    .navbar a, .navbar .nav-link {
      color: var(--graphite) !important;
    }
    .navbar a:hover, .navbar .nav-link:hover {
      color: var(--coral-700) !important;
    }
    .navbar .brand, .navbar-brand {
      color: var(--ink) !important;
      font-family: 'Space Grotesk', sans-serif !important;
    }

    /* Sidebar (owner dashboard) */
    .owner-sidebar, .sidebar {
      background: var(--paper) !important;
      border-right: 1px solid var(--stone) !important;
    }
    .snav-item {
      color: var(--graphite) !important;
    }
    .snav-item:hover, .snav-item.active {
      background: var(--sand) !important;
      color: var(--ink) !important;
    }
    .snav-item.active {
      border: 1px solid var(--coral-100) !important;
      background: var(--coral-50) !important;
      color: var(--coral-700) !important;
    }

    /* Footer */
    footer, .footer {
      background: var(--cream) !important;
      color: var(--ash) !important;
      border-top: 1px solid var(--stone) !important;
    }

    /* Tabelas */
    table { color: var(--ink); }
    table th { color: var(--graphite); border-bottom: 1px solid var(--stone); }
    table td { border-bottom: 1px solid var(--stone); }
    table tr:hover td { background: var(--sand); }

    /* Pills/badges padrão */
    .badge, .pill {
      background: var(--coral-50);
      color: var(--coral-700);
      border: 1px solid var(--coral-100);
      border-radius: 100px;
    }

    /* Status badges semânticos */
    .status-success, .badge-success { background: #d6ecde !important; color: #2d6b42 !important; border-color: #b5d8c1 !important; }
    .status-error, .badge-error     { background: #fdecec !important; color: var(--rose-500) !important; border-color: #f5cccc !important; }
    .status-warning, .badge-warning { background: #fbe2c0 !important; color: #7a4814 !important; border-color: #f0d0a0 !important; }

    /* Scrollbar discreta */
    ::-webkit-scrollbar { width: 10px; height: 10px; }
    ::-webkit-scrollbar-track { background: var(--sand); }
    ::-webkit-scrollbar-thumb { background: var(--stone); border-radius: 100px; }
    ::-webkit-scrollbar-thumb:hover { background: var(--ash); }

    /* Modal/overlay backdrop mais suave */
    .modal-backdrop, .overlay { background: rgba(40,35,28,0.45) !important; }

    /* Selection */
    ::selection { background: var(--coral-100); color: var(--ink); }

    /* ─────────────────────────────────────────────────────
       LOOV CANONICAL DESIGN SYSTEM — utility classes
       Match the public landing aesthetic. Use these on any
       page to opt into the Loov look without rewriting CSS.
       ───────────────────────────────────────────────────── */

    .loov-page {
      max-width: 1100px;
      margin: 0 auto;
      padding: 80px 24px 96px;
    }
    .loov-page--narrow { max-width: 720px; }
    .loov-page--wide   { max-width: 1240px; }

    /* Hero header — every page should start with this */
    .loov-hero {
      text-align: center;
      margin-bottom: 48px;
    }
    .loov-hero--left { text-align: left; }

    .loov-eyebrow {
      display: inline-flex; align-items: center; gap: 8px;
      font-family: 'JetBrains Mono', monospace !important;
      font-size: 11px;
      letter-spacing: 2px;
      color: var(--coral-500) !important;
      text-transform: uppercase;
      padding: 6px 14px;
      background: var(--coral-50);
      border: 1px solid var(--coral-100);
      border-radius: 100px;
      margin-bottom: 18px;
    }
    .loov-eyebrow .dot {
      width: 6px; height: 6px; border-radius: 50%;
      background: var(--coral-500);
      animation: loov-pulse 1.6s ease-in-out infinite;
    }
    @keyframes loov-pulse {
      0%,100% { opacity: 1; transform: scale(1); }
      50%     { opacity: .4; transform: scale(.7); }
    }

    .loov-h1 {
      font-family: 'Space Grotesk', 'Inter', sans-serif !important;
      font-weight: 700;
      font-size: clamp(36px, 5.5vw, 56px);
      letter-spacing: -1.2px;
      line-height: 1.05;
      color: var(--ink) !important;
      margin: 0 0 18px !important;
    }
    .loov-h1 .accent {
      color: var(--coral-500);
      position: relative;
      white-space: nowrap;
    }
    .loov-h1 .accent::after {
      content: '';
      position: absolute; left: 0; right: 0; bottom: -3px;
      height: 4px;
      background: linear-gradient(90deg, var(--coral-300), var(--coral-500));
      border-radius: 4px;
      opacity: .7;
    }

    .loov-h2 {
      font-family: 'Space Grotesk', sans-serif !important;
      font-weight: 700; font-size: 28px;
      color: var(--ink) !important;
      letter-spacing: -0.4px;
      margin: 0;
    }

    .loov-lead {
      font-size: 16.5px;
      color: var(--graphite) !important;
      max-width: 580px;
      margin: 0 auto 28px;
      line-height: 1.55;
    }
    .loov-hero--left .loov-lead { margin-left: 0; margin-right: 0; }

    .loov-cta-row {
      display: flex; flex-wrap: wrap; gap: 12px; justify-content: center;
    }
    .loov-hero--left .loov-cta-row { justify-content: flex-start; }

    /* Section with eyebrow + h2 */
    .loov-section { margin-bottom: 56px; }
    .loov-section-header {
      display: flex; align-items: flex-end; justify-content: space-between;
      gap: 16px; flex-wrap: wrap;
      margin-bottom: 24px;
    }
    .loov-section-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px; letter-spacing: 2px;
      color: var(--coral-500); text-transform: uppercase;
      margin-bottom: 6px;
    }

    /* Cards */
    .loov-card {
      background: var(--paper);
      border: 1px solid var(--stone);
      border-radius: 20px;
      padding: 26px;
      box-shadow: 0 2px 6px rgba(25,20,15,0.04);
      transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    }
    .loov-card--hover:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 28px rgba(25,20,15,0.07);
      border-color: var(--coral-100);
    }
    .loov-card--compact { padding: 18px; border-radius: 16px; }
    .loov-card--lg      { padding: 36px; border-radius: 24px; }

    .loov-card-icon {
      width: 48px; height: 48px;
      border-radius: 14px;
      background: var(--coral-50);
      border: 1px solid var(--coral-100);
      display: inline-flex; align-items: center; justify-content: center;
      color: var(--coral-700);
      margin-bottom: 14px;
    }
    .loov-card-title {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 17px; font-weight: 700;
      color: var(--ink);
      margin: 0 0 8px;
      letter-spacing: -0.2px;
    }
    .loov-card-text {
      font-size: 13.5px;
      color: var(--graphite);
      line-height: 1.6;
      margin: 0;
    }

    /* Buttons */
    .loov-btn-primary, .loov-btn-secondary, .loov-btn-ghost {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 13px 24px;
      border-radius: 100px;
      text-decoration: none !important;
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      letter-spacing: 1.4px;
      font-weight: 600;
      text-transform: uppercase;
      transition: transform .15s ease, box-shadow .15s ease, background .15s ease, border-color .15s ease, color .15s ease;
      cursor: pointer;
      border: none;
      white-space: nowrap;
    }
    .loov-btn-primary {
      background: var(--coral-500) !important;
      color: var(--cream) !important;
      box-shadow: 0 8px 20px rgba(220,120,82,0.22);
    }
    .loov-btn-primary:hover {
      background: var(--coral-700) !important;
      transform: translateY(-2px);
      box-shadow: 0 10px 24px rgba(156,73,48,0.28);
      color: var(--cream) !important;
    }
    .loov-btn-secondary {
      background: var(--paper) !important;
      color: var(--ink) !important;
      border: 1px solid var(--stone) !important;
    }
    .loov-btn-secondary:hover {
      border-color: var(--coral-500) !important;
      color: var(--coral-700) !important;
      transform: translateY(-2px);
    }
    .loov-btn-ghost {
      background: transparent !important;
      color: var(--graphite) !important;
    }
    .loov-btn-ghost:hover { color: var(--coral-700) !important; background: var(--sand) !important; }

    .loov-btn-block { width: 100%; justify-content: center; }
    .loov-btn-sm    { padding: 9px 18px; font-size: 11px; }
    .loov-btn-lg    { padding: 16px 30px; font-size: 13px; }

    /* Form fields */
    .loov-field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 16px; }
    .loov-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px; font-weight: 600;
      letter-spacing: 1.4px;
      color: var(--graphite);
      text-transform: uppercase;
    }
    .loov-input, .loov-select, .loov-textarea {
      background: var(--paper) !important;
      border: 1px solid var(--stone) !important;
      border-radius: 12px !important;
      padding: 12px 16px !important;
      font-family: 'Inter', sans-serif !important;
      font-size: 14.5px !important;
      color: var(--ink) !important;
      outline: none;
      width: 100%;
      transition: border-color .15s ease, box-shadow .15s ease;
    }
    .loov-input:focus, .loov-select:focus, .loov-textarea:focus {
      border-color: var(--coral-500) !important;
      box-shadow: 0 0 0 3px rgba(220,120,82,0.08) !important;
    }
    .loov-input::placeholder, .loov-textarea::placeholder { color: var(--ash) !important; }
    .loov-textarea { min-height: 90px; resize: vertical; }
    .loov-help { font-size: 12px; color: var(--ash); margin-top: 4px; }
    .loov-error { font-size: 12.5px; color: var(--rose-500); margin-top: 4px; font-weight: 500; }

    /* Generic feature/stats grids */
    .loov-grid-3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; }
    .loov-grid-2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 16px; }
    .loov-grid-4 { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px; }

    /* Stats inline */
    .loov-stats {
      display: flex; flex-wrap: wrap; gap: 44px; justify-content: center;
      margin-top: 48px;
    }
    .loov-stat { text-align: center; }
    .loov-stat-value {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 28px; font-weight: 700;
      color: var(--ink); letter-spacing: -0.5px; margin-bottom: 4px;
    }
    .loov-stat-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px; letter-spacing: 1.6px;
      color: var(--ash); text-transform: uppercase;
    }

    /* CTA dark band */
    .loov-cta-band {
      background: linear-gradient(135deg, var(--ink) 0%, var(--obsidian) 100%);
      color: var(--cream);
      border-radius: 24px;
      padding: 48px 32px;
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .loov-cta-band::before {
      content: '';
      position: absolute; top: -50%; right: -20%;
      width: 380px; height: 380px;
      background: radial-gradient(circle, var(--coral-500) 0%, transparent 60%);
      opacity: .25; pointer-events: none;
    }
    .loov-cta-band > * { position: relative; }
    .loov-cta-band h2 {
      font-family: 'Space Grotesk', sans-serif !important;
      font-weight: 700; font-size: clamp(24px, 4vw, 32px);
      letter-spacing: -0.5px; margin: 14px 0 12px !important;
      color: var(--cream) !important;
    }
    .loov-cta-band p { color: var(--ash); margin: 0 auto 24px; max-width: 460px; }

    /* Pills/badges */
    .loov-pill {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 4px 12px; border-radius: 100px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px; font-weight: 700; letter-spacing: 1.4px;
      text-transform: uppercase;
      border: 1px solid;
    }
    .loov-pill--coral  { background: var(--coral-50); color: var(--coral-700); border-color: var(--coral-100); }
    .loov-pill--success{ background: #d6ecde; color: #2d6b42; border-color: #b5d8c1; }
    .loov-pill--danger { background: #fdecec; color: var(--rose-500); border-color: #f5cccc; }
    .loov-pill--warn   { background: #fbe2c0; color: #7a4814; border-color: #f0d0a0; }
    .loov-pill--neutral{ background: var(--sand); color: var(--graphite); border-color: var(--stone); }

    /* Divider */
    .loov-divider {
      height: 1px; background: var(--stone); border: none;
      margin: 32px 0;
    }

    /* Auth shared two-column layout */
    .loov-auth {
      min-height: 100vh;
      padding-top: 60px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
      background: var(--cream);
    }
    .loov-auth-editorial {
      padding: 64px 48px 64px 64px;
      display: flex; flex-direction: column; justify-content: center;
      border-right: 1px solid var(--stone);
      background: var(--paper);
      position: relative;
      overflow: hidden;
    }
    .loov-auth-editorial::before {
      content: '';
      position: absolute; top: 10%; right: -30%;
      width: 460px; height: 460px;
      background: radial-gradient(circle, var(--coral-500) 0%, transparent 65%);
      opacity: .14;
      pointer-events: none;
    }
    .loov-auth-form-side {
      padding: 64px 64px 64px 48px;
      display: flex; flex-direction: column; justify-content: center;
      max-width: 580px;
      width: 100%;
      margin: 0 auto;
    }
    .loov-auth-detail-row {
      margin-top: 36px; padding-top: 28px;
      border-top: 1px solid var(--stone);
      display: flex; align-items: center; gap: 18px;
      position: relative;
    }
    .loov-auth-detail-num {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 40px; font-weight: 700; color: var(--coral-500);
      line-height: 1; letter-spacing: -0.5px;
    }
    .loov-auth-detail-label { font-size: 13px; color: var(--graphite); line-height: 1.5; }
    .loov-auth-detail-label span.weak { color: var(--ash); }
    @media (max-width: 860px) {
      .loov-auth { grid-template-columns: 1fr; }
      .loov-auth-editorial { display: none; }
      .loov-auth-form-side { padding: 48px 24px; max-width: 100%; }
    }

    /* Centered single card (smaller auth pages, success pages) */
    .loov-center-page {
      min-height: 100vh;
      padding: 80px 20px 60px;
      display: flex; align-items: center; justify-content: center;
      background: var(--cream);
    }
    .loov-center-card {
      width: 100%; max-width: 480px;
      background: var(--paper);
      border: 1px solid var(--stone);
      border-radius: 24px;
      padding: 48px 36px;
      box-shadow: 0 14px 40px rgba(40,35,28,0.06);
      text-align: center;
    }

    /* Footer link row inside cards */
    .loov-footer-row {
      margin-top: 28px; padding-top: 24px;
      border-top: 1px solid var(--stone);
      display: flex; flex-direction: column; gap: 8px; align-items: center;
    }
    .loov-footer-row a {
      font-size: 13.5px; color: var(--graphite);
      text-decoration: none;
      transition: color .15s ease;
    }
    .loov-footer-row a:hover { color: var(--coral-700); }
    .loov-footer-row a.strong { color: var(--coral-700); font-weight: 600; }

    /* Mobile */
    @media (max-width: 600px) {
      .loov-page { padding: 56px 18px 64px; }
      .loov-h1 { font-size: clamp(30px, 7vw, 38px); }
      .loov-h2 { font-size: 22px; }
      .loov-stats { gap: 28px; }
      .loov-stat-value { font-size: 22px; }
      .loov-cta-band { padding: 36px 22px; }
      .loov-card { padding: 22px; }
      .loov-center-card { padding: 36px 24px; }
    }
  </style>
</head>
<body>
  <%= render 'layouts/navbar' %>
  <main>
    <%= yield %>
  </main>
  <script>
    document.addEventListener('DOMContentLoaded', () => {

      // Animações de entrada legadas
      document.querySelectorAll('.fade-in-card').forEach((card, i) => {
        setTimeout(() => { card.style.opacity = '1'; card.style.transform = 'translateY(0)'; }, i * 150);
      });
      document.querySelectorAll('.fade-in-welcome').forEach((el, i) => {
        setTimeout(() => { el.style.opacity = '1'; el.style.transform = 'translateY(0)'; }, i * 200);
      });
      const searchSection = document.querySelector('.fade-in-search');
      if (searchSection) setTimeout(() => { searchSection.style.opacity = '1'; searchSection.style.transform = 'translateY(0)'; }, 400);

      // Typewriter no search
      const placeholderText = "Buscar lava-rápido ou serviço...";
      const searchInput = document.getElementById('search-input');
      if (searchInput) {
        searchInput.setAttribute('placeholder', '');
        let i = 0;
        function typeWriter() {
          if (i < placeholderText.length) {
            searchInput.setAttribute('placeholder', searchInput.getAttribute('placeholder') + placeholderText.charAt(i));
            i++;
            setTimeout(typeWriter, 50);
          }
        }
        setTimeout(typeWriter, 600);
      }

      // ── GEOLOCATION HELPER ─────────────────────────────────────────────
      // Helper global que pede a posição com fallback "high accuracy → low
      // accuracy", trata os 3 códigos de erro distintamente e mostra um
      // toast Loov com a causa real. Usado pelo banner "Usar localização"
      // em /, /disponivel e pelo auto-geo na entrada do app.
      window.loovGeo = function(opts) {
        opts = opts || {};
        const onOk   = opts.onOk   || function() {};
        const onFail = opts.onFail || function() {};

        const ua = (navigator.userAgent || '').toLowerCase();
        const isIOS    = /ipad|iphone|ipod/.test(ua) || (ua.includes('mac') && navigator.maxTouchPoints > 1);
        const isSafari = /safari/.test(ua) && !/chrome|crios|fxios/.test(ua);

        const denyInstructions = () => {
          if (isIOS) {
            return '<strong>Permissão negada.</strong><br>'
                 + '1. Abra <b>Ajustes do iPhone</b> (não no Safari) → <b>Privacidade e Segurança</b> → <b>Serviços de Localização</b> → certifique-se que está <b>ativado</b>.<br>'
                 + '2. Role até <b>Sites do Safari</b> e selecione <b>Perguntar</b> ou <b>Permitir</b>.<br>'
                 + '3. Volte ao Safari, recarregue a página e tente de novo.';
          }
          if (isSafari) {
            return '<strong>Permissão negada.</strong><br>'
                 + '1. <b>Ajustes do Sistema</b> → <b>Privacidade e Segurança</b> → <b>Serviços de Localização</b> → ative para Safari.<br>'
                 + '2. No Safari: <b>Safari</b> menu → <b>Ajustes para este site</b> → <b>Localização: Permitir</b>.';
          }
          return '<strong>Permissão de localização negada.</strong><br>'
               + 'Clique no ícone de cadeado/site na barra de endereço, mude '
               + 'Localização para "Permitir" e recarregue.';
        };

        const showToast = (msg, isError, longLived) => {
          // Remove toasts antigos
          document.querySelectorAll('[data-loov-geo-toast]').forEach(n => n.remove());
          const t = document.createElement('div');
          t.setAttribute('data-loov-geo-toast', '1');
          t.style.cssText = 'position:fixed;left:50%;top:24px;transform:translateX(-50%);z-index:99999;'
            + 'background:' + (isError ? '#fdecec' : '#d6ecde')
            + ';border:1px solid ' + (isError ? '#f5cccc' : '#b5d8c1')
            + ';color:' + (isError ? '#7a3838' : '#2d6b42')
            + ';padding:14px 22px;border-radius:18px;font-family:Inter,sans-serif;font-size:13.5px;'
            + 'font-weight:500;box-shadow:0 14px 40px rgba(40,35,28,0.18);max-width:min(440px,92vw);'
            + 'line-height:1.55;text-align:left;';
          t.innerHTML = msg;
          if (longLived) {
            const close = document.createElement('button');
            close.innerText = '×';
            close.style.cssText = 'position:absolute;top:6px;right:10px;background:none;border:none;'
              + 'font-size:20px;color:inherit;opacity:.6;cursor:pointer;line-height:1;padding:0;';
            close.onclick = () => t.remove();
            t.style.position = 'fixed';
            t.style.paddingRight = '32px';
            t.appendChild(close);
          }
          document.body.appendChild(t);
          if (!longLived) {
            setTimeout(() => { t.style.transition='opacity .4s'; t.style.opacity='0'; setTimeout(()=>t.remove(),400); }, 5500);
          }
        };

        if (!navigator.geolocation) {
          showToast('Seu navegador não suporta localização.', true);
          onFail({ code: 'unsupported' });
          return;
        }

        // Se a Permission API existir, conferimos antes — alguns browsers
        // demoram pra rejeitar quando já está em "denied" persistente.
        const tryGeo = (highAccuracy) => {
          navigator.geolocation.getCurrentPosition(
            (pos) => onOk(pos),
            (err) => {
              if (err.code === 1) {
                showToast(denyInstructions(), true, true);
                onFail(err);
              } else if (err.code === 2) {
                if (highAccuracy) {
                  // Tenta de novo sem GPS — IP-based / WiFi
                  tryGeo(false);
                } else {
                  showToast('Não conseguimos detectar onde você está. Verifique se o GPS/localização do dispositivo está ativo.', true);
                  onFail(err);
                }
              } else if (err.code === 3) {
                if (highAccuracy) {
                  tryGeo(false);
                } else {
                  showToast('A busca demorou demais. Tente de novo em alguns segundos.', true);
                  onFail(err);
                }
              } else {
                showToast('Não foi possível obter sua localização.', true);
                onFail(err);
              }
            },
            {
              enableHighAccuracy: highAccuracy,
              timeout: highAccuracy ? 8000 : 18000,
              maximumAge: highAccuracy ? 0 : 60000
            }
          );
        };

        // IMPORTANTE: NÃO pré-bloquear com Permissions.query — Safari iOS
        // retorna estado cacheado mesmo depois do usuário liberar nos
        // ajustes do iPhone. Sempre tentar o getCurrentPosition real;
        // se falhar, o err.code===1 mostra o toast com instruções.
        tryGeo(true);
      };

      // Reload com lat/lng nos params
      window.loovGeoReload = function() {
        window.loovGeo({
          onOk: (pos) => {
            try {
              localStorage.setItem('loov_last_coords', JSON.stringify({
                lat: pos.coords.latitude, lng: pos.coords.longitude
              }));
            } catch (e) {}
            const url = new URL(window.location);
            url.searchParams.set('latitude', pos.coords.latitude);
            url.searchParams.set('longitude', pos.coords.longitude);
            window.location.href = url.toString();
          }
        });
      };

      // Geolocalização automática para clientes — silenciosa
      const urlParams = new URLSearchParams(window.location.search);
      <% if user_signed_in? && current_user.client? %>
      if (!window.location.pathname.includes('/client/profile') &&
          (!urlParams.has('latitude') || !urlParams.has('longitude'))) {
        const cached = localStorage.getItem('loov_last_coords');
        if (cached) {
          try {
            const c = JSON.parse(cached);
            const url = new URL(window.location);
            url.searchParams.set('latitude',  c.lat);
            url.searchParams.set('longitude', c.lng);
            window.location.href = url.toString();
          } catch (e) {
            localStorage.removeItem('loov_last_coords');
          }
        }
        // Não auto-pedimos geolocation aqui pra não causar prompt no
        // primeiro acesso. O usuário aciona via botão "Usar localização".
      }
      <% end %>

      // Matter.js para owner/attendant
      <% if user_signed_in? && (current_user.owner? || current_user.attendant?) %>
      if (typeof Matter === 'undefined') return;
      const { Engine, Render, World, Bodies, Body, Mouse, MouseConstraint, Events, Vector } = Matter;
      const engine = Engine.create();
      engine.world.gravity.y = 0;
      const canvas = document.getElementById('matter-wrap-canvas');
      if (!canvas) return;
      const W = window.innerWidth;
      const H = window.innerHeight;
      canvas.width  = W;
      canvas.height = H;
      const render = Render.create({
        canvas, engine,
        options: { width: W, height: H, wireframes: false, background: '#fafaf6' }
      });
      window.addEventListener('resize', () => {
        const nW = window.innerWidth, nH = window.innerHeight;
        render.canvas.width  = nW; render.canvas.height = nH;
        render.options.width = nW; render.options.height = nH;
      });
      const wallOpts = { isStatic: true, render: { fillStyle: '#fafaf6' } };
      const off = 50;
      World.add(engine.world, [
        Bodies.rectangle(W/2,   -off,    W+2*off, off*2, wallOpts),
        Bodies.rectangle(W/2,   H+off,   W+2*off, off*2, wallOpts),
        Bodies.rectangle(-off,   H/2,    off*2, H+2*off, wallOpts),
        Bodies.rectangle(W+off,  H/2,    off*2, H+2*off, wallOpts)
      ]);
      const makeBody = (type, fill) => {
        const size = Math.random() * 16 + 10;
        const x = Math.random() * (W-60) + 30;
        const y = Math.random() * (H-60) + 30;
        const opts = { restitution: 0.6, friction: 0, frictionAir: 0.008, render: { fillStyle: fill } };
        const b = type === 'circle' ? Bodies.circle(x, y, size, opts) : Bodies.rectangle(x, y, size, size, opts);
        Body.setVelocity(b, { x: (Math.random()-0.5)*2, y: (Math.random()-0.5)*2 });
        return b;
      };
      const allBodies = [
        ...Array.from({length:10}, () => makeBody('rect',   '#28231c')),
        ...Array.from({length:8},  () => makeBody('circle', '#dd7852')),
        ...Array.from({length:6},  () => makeBody('circle', '#333333'))
      ];
      World.add(engine.world, allBodies);
      const mouse = Mouse.create(render.canvas);
      World.add(engine.world, MouseConstraint.create(engine, { mouse, constraint: { stiffness: 0.2, render: { visible: false } } }));
      render.mouse = mouse;
      Events.on(engine, 'beforeUpdate', () => {
        allBodies.forEach(body => {
          const vel = body.velocity;
          const speed = Vector.magnitude(vel);
          if (speed < 0.8) Body.setVelocity(body, Vector.mult(Vector.normalise(speed > 0 ? vel : {x:1,y:0}), 0.8));
          const dist = Vector.magnitude(Vector.sub(body.position, mouse.position));
          if (dist < 120 && dist > 0) {
            Body.applyForce(body, body.position, Vector.mult(Vector.normalise(Vector.sub(body.position, mouse.position)), (1-dist/120)*0.025));
          }
        });
      });
      Engine.run(engine);
      Render.run(render);
      <% end %>
    });
  </script>
</body>
</html>
