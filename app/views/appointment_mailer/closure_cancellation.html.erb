<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body { margin: 0; padding: 0; background: #0a0a0a; font-family: Arial, sans-serif; }
    .wrap { max-width: 560px; margin: 0 auto; padding: 40px 24px; }
    .logo { font-size: 2rem; font-weight: 900; color: #afff2d; margin-bottom: 32px; }
    .card { background: #111111; border: 1px solid #222222; border-radius: 16px; padding: 32px; }
    .badge { display: inline-block; background: rgba(248,113,113,0.1); color: #f87171; border: 1px solid rgba(248,113,113,0.2); border-radius: 100px; padding: 6px 16px; font-size: 0.75rem; font-weight: 600; margin-bottom: 24px; }
    .title { font-size: 1.25rem; font-weight: 600; color: #ffffff; margin: 0 0 8px; }
    .subtitle { font-size: 0.875rem; color: #666666; margin: 0 0 28px; }
    .divider { height: 1px; background: #222222; margin: 24px 0; }
    .row { display: flex; justify-content: space-between; margin-bottom: 12px; }
    .label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: #555555; }
    .value { font-size: 0.875rem; color: #ffffff; font-weight: 500; }
    .reason-box { background: rgba(248,113,113,0.07); border: 1px solid rgba(248,113,113,0.15); border-radius: 10px; padding: 14px 16px; margin-top: 20px; font-size: 0.875rem; color: #fca5a5; line-height: 1.6; }
    .btn { display: block; background: #afff2d; color: #000000; text-decoration: none; text-align: center; padding: 14px 24px; border-radius: 100px; font-weight: 600; font-size: 0.875rem; margin-top: 28px; }
    .footer { text-align: center; font-size: 0.75rem; color: #444444; margin-top: 32px; }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="logo">loov</div>
    <div class="card">
      <div class="badge">❌ Agendamento Cancelado</div>
      <p class="title">Seu agendamento foi cancelado</p>
      <p class="subtitle">Olá, <%= @user.display_name.split(' ').first %>. Infelizmente o lava-rápido precisou cancelar seu agendamento.</p>
      <div class="divider"></div>
      <div class="row">
        <span class="label">Lava-rápido</span>
        <span class="value"><%= @car_wash.name %></span>
      </div>
      <div class="row">
        <span class="label">Serviço</span>
        <span class="value"><%= @service.title %></span>
      </div>
      <div class="row">
        <span class="label">Data</span>
        <span class="value"><%= @appointment.scheduled_at.in_time_zone("America/Sao_Paulo").strftime("%d/%m/%Y") %></span>
      </div>
      <div class="row">
        <span class="label">Horário</span>
        <span class="value"><%= @appointment.scheduled_at.in_time_zone("America/Sao_Paulo").strftime("%H:%M") %></span>
      </div>
      <div class="divider"></div>
      <% if @closure.reason.present? %>
      <div class="reason-box">
        <strong>Motivo:</strong> <%= @closure.reason %>
      </div>
      <% else %>
      <div class="reason-box">
        O estabelecimento estará fechado no período de <%= @closure.display_period %>.
      </div>
      <% end %>
      <a href="<%= appointments_url %>" class="btn">Ver meus agendamentos</a>
    </div>
    <div class="footer">
      Loov — plataforma de agendamento para lava-rápidos<br>
      Pedimos desculpas pelo inconveniente.
    </div>
  </div>
</body>
</html>
