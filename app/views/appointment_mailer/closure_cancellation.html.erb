<%
  period = if @closure.single_day?
    "Fechado em #{@closure.start_date.strftime('%d/%m')}."
  else
    "Fechado de #{@closure.start_date.strftime('%d/%m')} a #{@closure.end_date.strftime('%d/%m')}."
  end
%>
<%= render "appointment_mailer/cancelled",
      lead:   "O #{@car_wash.name} vai estar fechado nesse dia e precisou cancelar seu agendamento.",
      reason: [@closure.reason.presence&.strip&.sub(/[.!?]?\z/) { |m| m.presence || "." }, period].compact.join(" ") %>
