<% content_for :preheader, "#{@service.title} no #{@car_wash.name}, amanhã às #{email_time(@appointment.scheduled_at)}." %>
<% content_for :footer, "Você recebeu este e-mail porque tem um agendamento pela Loov." %>

<%= render "emails/heading", eyebrow: "Lembrete", title: "Amanhã às #{email_time(@appointment.scheduled_at)}." %>
<%= render "emails/paragraph", text: "#{email_greeting(@user)} Passando para lembrar do seu horário no #{@car_wash.name}." %>

<%= render "appointment_mailer/where" %>

<%= render "emails/button", url: appointments_url, label: "Ver meus agendamentos", top: 24 %>
<%= render "emails/callout", title: "Não vai conseguir ir?", text: "Cancele pelo app. O lava-rápido libera o horário para outra pessoa." %>
