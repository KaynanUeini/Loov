<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body { margin: 0; padding: 0; background: #fafaf6; font-family: Arial, sans-serif; }
    .wrap { max-width: 560px; margin: 0 auto; padding: 40px 24px; }
    .logo { font-size: 2rem; font-weight: 900; color: #dd7852; margin-bottom: 32px; }
    .card { background: #fafaf6111; border: 1px solid #e0dbd0222; border-radius: 16px; padding: 32px; }
    .badge { display: inline-block; background: rgba(221, 120, 82,0.1); color: #dd7852; border: 1px solid rgba(221, 120, 82,0.2); border-radius: 100px; padding: 6px 16px; font-size: 0.75rem; font-weight: 600; margin-bottom: 24px; }
    .title { font-size: 1.25rem; font-weight: 600; color: #28231c; margin: 0 0 8px; }
    .subtitle { font-size: 0.875rem; color: #ada699666; margin: 0 0 28px; }
    .divider { height: 1px; background: #e0dbd0222; margin: 24px 0; }
    .row { display: flex; justify-content: space-between; margin-bottom: 12px; }
    .label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: #ada699555; }
    .value { font-size: 0.875rem; color: #28231c; font-weight: 500; }
    .btn { display: block; background: #dd7852; color: #fafaf6; text-decoration: none; text-align: center; padding: 14px 24px; border-radius: 100px; font-weight: 600; font-size: 0.875rem; margin-top: 28px; }
    .footer { text-align: center; font-size: 0.75rem; color: #ada699444; margin-top: 32px; }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="logo">loov</div>
    <div class="card">
      <div class="badge">✅ Confirmado</div>
      <p class="title">Seu agendamento está confirmado!</p>
      <p class="subtitle">Olá, <%= @user.display_name.split(' ').first %>. Veja os detalhes abaixo.</p>
      <div class="divider"></div>
      <div class="row">
        <span class="label">Lava-rápido</span>
        <span class="value"><%= @car_wash.name %></span>
      </div>
      <div class="row">
        <span class="label">Serviço</span>
        <span class="value"><%= @service.title %></span>
      </div>
      <div class="row">
        <span class="label">Data</span>
        <span class="value"><%= @appointment.scheduled_at.strftime("%d/%m/%Y") %></span>
      </div>
      <div class="row">
        <span class="label">Horário</span>
        <span class="value"><%= @appointment.scheduled_at.strftime("%H:%M") %></span>
      </div>
      <% if @car_wash.address.present? %>
      <div class="row">
        <span class="label">Endereço</span>
        <span class="value"><%= @car_wash.address %></span>
      </div>
      <% end %>
      <div class="divider"></div>
      <a href="<%= appointments_url %>" class="btn">Ver meus agendamentos</a>
    </div>
    <div class="footer">
      Loov — plataforma de agendamento para lava-rápidos<br>
      Se não foi você, ignore este e-mail.
    </div>
  </div>
</body>
</html>
