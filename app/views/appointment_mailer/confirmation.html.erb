<% content_for :preheader, "#{email_when(@appointment.scheduled_at)} · #{@service.title}" %>
<% content_for :footer, "Você recebeu este e-mail porque agendou pela Loov com #{@user.email}." %>

<%= render "emails/heading", eyebrow: "Agendamento confirmado", title: "Tudo certo para #{email_day(@appointment.scheduled_at).downcase}." %>
<%= render "emails/paragraph", text: "#{email_greeting(@user)} Seu horário no #{@car_wash.name} está reservado." %>

<%= render "appointment_mailer/where", price: true %>

<% if @appointment.disponivel? && @appointment.prepayment_amount.present? %>
  <%= render "emails/note", text: "Você já pagou #{email_money(@appointment.prepayment_amount)} pelo app. O restante, #{email_money(@appointment.effective_price - @appointment.prepayment_amount.to_f)}, é pago no local." %>
<% end %>

<%= render "emails/button", url: appointments_url, label: "Ver meus agendamentos", top: 24 %>
<%= render "emails/callout", title: "Precisa remarcar?", text: "Cancele ou remarque pelo app com antecedência. Assim o horário fica livre para outra pessoa." %>
