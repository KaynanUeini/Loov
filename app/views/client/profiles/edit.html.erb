<% Rails.logger.info("Renderizando client/profiles/edit.html.erb") %>

<style>
  .pf-tabs {
    display: flex; gap: 4px; margin-bottom: 28px;
    background: var(--paper); border: 1px solid var(--stone);
    border-radius: 14px; padding: 4px;
  }
  .pf-tab {
    flex: 1; padding: 12px 18px; border-radius: 10px; border: none;
    background: transparent; color: var(--graphite);
    font-family: 'JetBrains Mono', monospace; font-size: 11.5px; font-weight: 600;
    letter-spacing: 1.4px; text-transform: uppercase;
    cursor: pointer; transition: all .15s ease;
    display: flex; align-items: center; justify-content: center; gap: 8px;
  }
  .pf-tab:hover { color: var(--ink); background: var(--sand); }
  .pf-tab.active {
    background: var(--coral-50); color: var(--coral-700);
    box-shadow: inset 0 0 0 1px var(--coral-100);
  }
  .pf-tab.active i { color: var(--coral-500); }
  .pf-tab i { font-size: 12px; }
  .pf-tab .pf-dot {
    width: 7px; height: 7px; border-radius: 50%; background: var(--rose-500);
    display: inline-block; margin-left: 2px;
  }

  .pf-tab-content { display: none; }
  .pf-tab-content.active { display: block; }

  .pf-card-saved {
    display: flex; align-items: center; justify-content: space-between;
    gap: 14px; flex-wrap: wrap;
    padding: 14px 16px; background: var(--cream);
    border: 1px solid var(--stone); border-radius: 14px;
  }
  .pf-card-saved-left { display: flex; align-items: center; gap: 12px; }
  .pf-card-icon {
    width: 44px; height: 44px; border-radius: 12px;
    background: var(--coral-50); border: 1px solid var(--coral-100);
    display: flex; align-items: center; justify-content: center;
    color: var(--coral-700); font-size: 16px; flex-shrink: 0;
  }
  .pf-card-info-label {
    font-family: 'JetBrains Mono', monospace; font-size: 10px;
    letter-spacing: 1.4px; color: var(--ash); text-transform: uppercase;
    margin-bottom: 2px;
  }
  .pf-card-info-val { font-size: 14.5px; font-weight: 600; color: var(--ink); }

  #stripe-card-element {
    background: var(--paper); border: 1px solid var(--stone);
    border-radius: 12px; padding: 14px 16px;
    transition: border-color .15s, box-shadow .15s;
  }
  #stripe-card-element.StripeElement--focus { border-color: var(--coral-500); box-shadow: 0 0 0 3px rgba(220,120,82,0.08); }
  #stripe-card-element.StripeElement--invalid { border-color: var(--rose-500); }
  #card-errors { color: var(--rose-500); font-size: 12.5px; margin-top: 6px; min-height: 1rem; }

  .pf-banner-card-required {
    display: flex; align-items: flex-start; gap: 10px;
    background: var(--coral-50); border: 1px solid var(--coral-100);
    border-radius: 14px; padding: 14px 16px; margin-bottom: 18px;
  }
  .pf-banner-card-required i { color: var(--coral-700); margin-top: 2px; flex-shrink: 0; }
  .pf-banner-card-required-text { font-size: 13.5px; color: var(--graphite); line-height: 1.55; }
  .pf-banner-card-required-text strong { color: var(--ink); display: block; margin-bottom: 2px; }

  .pf-payment-note {
    display: flex; align-items: center; gap: 8px;
    margin-top: 14px; font-size: 12px; color: var(--ash);
  }
  .pf-payment-note i { color: var(--coral-500); font-size: 11px; }

  .pf-spinner {
    display: inline-block; width: 14px; height: 14px;
    border: 2px solid rgba(254,254,253,.4); border-top-color: var(--cream);
    border-radius: 50%; animation: pf-spin .7s linear infinite;
  }
  @keyframes pf-spin { to { transform: rotate(360deg); } }

  .pf-toast {
    position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%);
    padding: 12px 22px; border-radius: 100px; font-size: 13.5px;
    display: flex; align-items: center; gap: 8px; z-index: 9999;
    box-shadow: 0 14px 40px rgba(40,35,28,0.18);
    animation: pf-toast-up .3s cubic-bezier(.16,1,.3,1) forwards;
    white-space: nowrap;
  }
  .pf-toast--success { background: #d6ecde; border: 1px solid #b5d8c1; color: #2d6b42; }
  .pf-toast--error   { background: #fdecec; border: 1px solid #f5cccc; color: var(--rose-500); }
  @keyframes pf-toast-up {
    from { opacity:0; transform: translateX(-50%) translateY(12px); }
    to   { opacity:1; transform: translateX(-50%) translateY(0); }
  }

  .pf-avatar-row {
    display: flex; align-items: center; gap: 16px;
    padding: 18px 20px; background: var(--paper);
    border: 1px solid var(--stone); border-radius: 16px;
    margin-bottom: 28px;
  }
  .pf-avatar-circle {
    width: 56px; height: 56px; border-radius: 16px;
    background: var(--coral-50); border: 1px solid var(--coral-100);
    color: var(--coral-700);
    font-family: 'Space Grotesk', sans-serif; font-size: 22px; font-weight: 700;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .pf-avatar-name { font-size: 15.5px; font-weight: 600; color: var(--ink); }
  .pf-avatar-email { font-size: 13px; color: var(--graphite); }

  .pf-required-badge {
    display: inline-block; font-family: 'JetBrains Mono', monospace;
    font-size: 9.5px; font-weight: 700; letter-spacing: 1px;
    padding: 2px 8px; border-radius: 100px; text-transform: uppercase;
    margin-left: 6px;
  }
  .pf-required-badge.req { background: var(--coral-50); color: var(--coral-700); border: 1px solid var(--coral-100); }
  .pf-required-badge.opt { background: transparent; color: var(--ash); border: 1px solid var(--stone); }

  .pf-section-title-row {
    display: flex; align-items: center; gap: 10px;
    padding-bottom: 12px; margin-bottom: 18px;
    border-bottom: 1px solid var(--stone);
  }
  .pf-section-title-row i { color: var(--coral-500); font-size: 13px; }
  .pf-section-title-row .pf-section-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; font-weight: 700; letter-spacing: 1.6px;
    color: var(--graphite); text-transform: uppercase;
  }

  .field-error-msg {
    font-size: 12.5px; color: var(--rose-500); margin-top: 4px;
    display: flex; align-items: center; gap: 5px;
  }
  .loov-input.error { border-color: var(--rose-500) !important; box-shadow: 0 0 0 3px rgba(200,80,80,0.08) !important; }
</style>

<div class="loov-page loov-page--narrow">

  <div class="loov-hero">
    <div class="loov-eyebrow"><span class="dot"></span>MEU PERFIL</div>
    <h1 class="loov-h1">
      Seus dados, do seu <span class="accent">jeito</span>.
    </h1>
    <p class="loov-lead">
      Mantenha tudo atualizado pra agilizar seus agendamentos.
    </p>
  </div>

  <div class="pf-avatar-row">
    <div class="pf-avatar-circle"><%= current_user.initials %></div>
    <div>
      <div class="pf-avatar-name"><%= current_user.display_name %></div>
      <div class="pf-avatar-email"><%= current_user.email %></div>
    </div>
  </div>

  <% if notice %>
    <div class="pf-toast pf-toast--success"><i class="fas fa-check-circle"></i> <%= notice %></div>
  <% end %>
  <% if flash[:errors] %>
    <% flash[:errors].each do |msg| %>
      <div class="pf-toast pf-toast--error"><i class="fas fa-circle-exclamation"></i> <%= msg %></div>
    <% end %>
  <% end %>
  <% if flash[:alert] %>
    <div class="pf-toast pf-toast--error"><i class="fas fa-circle-exclamation"></i> <%= flash[:alert] %></div>
  <% end %>

  <div class="pf-tabs">
    <button class="pf-tab <%= params[:add_card] ? '' : 'active' %>" data-tab="perfil">
      <i class="fas fa-user"></i> PERFIL
    </button>
    <button class="pf-tab <%= params[:add_card] ? 'active' : '' %>" data-tab="pagamento">
      <i class="fas fa-credit-card"></i> PAGAMENTO
      <% unless current_user.has_payment_method? %>
        <span class="pf-dot"></span>
      <% end %>
    </button>
  </div>

  <!-- TAB: PERFIL -->
  <div class="pf-tab-content <%= params[:add_card] ? '' : 'active' %>" id="pf-tab-perfil">
    <div class="loov-card loov-card--lg" style="margin-bottom:18px;">
      <div class="pf-section-title-row">
        <i class="fas fa-user"></i>
        <span class="pf-section-label">Dados pessoais</span>
      </div>

      <%= form_with model: current_user, url: client_profile_path, method: :patch, data: { turbo: false }, id: "pf-form" do |f| %>
        <div class="loov-field">
          <%= f.label :full_name, class: "loov-label" do %>
            Nome completo <span class="pf-required-badge req">obrigatório</span>
          <% end %>
          <%= f.text_field :full_name, class: "loov-input", placeholder: "Seu nome completo", id: "full_name_field" %>
        </div>

        <div class="loov-field">
          <%= f.label :email, "E-mail", class: "loov-label" %>
          <%= f.email_field :email, class: "loov-input", disabled: true, value: current_user.email, style: "opacity:.6;cursor:not-allowed;" %>
          <div class="loov-help">O e-mail não pode ser alterado aqui.</div>
        </div>

        <div class="loov-field">
          <%= f.label :phone, class: "loov-label" do %>
            Telefone <span class="pf-required-badge req">obrigatório</span>
          <% end %>
          <%= f.text_field :phone, class: "loov-input", placeholder: "(11) 99999-9999", id: "phone_field", maxlength: 15 %>
        </div>

        <div class="loov-field">
          <%= f.label :cpf, class: "loov-label" do %>
            CPF <span class="pf-required-badge opt">opcional</span>
          <% end %>
          <%= f.text_field :cpf, class: "loov-input", placeholder: "000.000.000-00", id: "cpf_field", maxlength: 14 %>
        </div>

        <hr class="loov-divider">

        <div class="pf-section-title-row" style="border:none;padding-bottom:0;margin-bottom:12px;">
          <i class="fas fa-car"></i>
          <span class="pf-section-label">Veículo</span>
        </div>
        <div class="loov-field">
          <%= f.label :vehicle_model, class: "loov-label" do %>
            Modelo <span class="pf-required-badge opt">opcional</span>
          <% end %>
          <%= f.text_field :vehicle_model, class: "loov-input", placeholder: "Ex: Honda Civic Preto 2022" %>
          <div class="loov-help">Ajuda o lava-rápido a te encontrar na fila.</div>
        </div>

        <%= f.submit "Salvar perfil", class: "loov-btn-primary loov-btn-block loov-btn-lg", style: "margin-top:8px;" %>
      <% end %>
    </div>
  </div>

  <!-- TAB: PAGAMENTO -->
  <div class="pf-tab-content <%= params[:add_card] ? 'active' : '' %>" id="pf-tab-pagamento">
    <div class="loov-card loov-card--lg">
      <div class="pf-section-title-row">
        <i class="fas fa-credit-card"></i>
        <span class="pf-section-label">Cartão de pagamento</span>
      </div>

      <% if current_user.has_payment_method? %>
        <div class="pf-card-saved">
          <div class="pf-card-saved-left">
            <div class="pf-card-icon"><i class="fas fa-credit-card"></i></div>
            <div>
              <div class="pf-card-info-label">CARTÃO CADASTRADO</div>
              <div class="pf-card-info-val"><%= current_user.card_display %></div>
            </div>
          </div>
          <%= link_to "REMOVER", remove_payment_method_client_profile_path,
                      method: :delete,
                      data: { turbo: false, confirm: "Tem certeza? Você não poderá usar a aba Disponíveis sem um cartão." },
                      class: "loov-btn-secondary loov-btn-sm",
                      style: "border-color:rgba(200,80,80,.3);color:var(--rose-500);" %>
        </div>
        <div class="pf-payment-note">
          <i class="fas fa-shield-halved"></i>
          Seu cartão é armazenado com segurança pelo Stripe. A Loov não guarda dados do cartão.
        </div>
      <% else %>
        <% if params[:add_card] %>
          <div class="pf-banner-card-required">
            <i class="fas fa-bolt"></i>
            <div class="pf-banner-card-required-text">
              <strong>Cartão necessário para a aba Disponíveis.</strong>
              Cadastre um cartão para reservar vagas em tempo real. O valor é autorizado mas só cobrado após o lava-rápido confirmar.
            </div>
          </div>
        <% end %>

        <div class="loov-field">
          <label class="loov-label">Dados do cartão</label>
          <div id="stripe-card-element"></div>
          <div id="card-errors" role="alert"></div>
        </div>

        <button id="btn-save-card" class="loov-btn-primary loov-btn-block loov-btn-lg">
          <i class="fas fa-lock"></i> SALVAR CARTÃO
        </button>

        <div class="pf-payment-note">
          <i class="fas fa-shield-halved"></i>
          Pagamento processado com segurança pelo Stripe. Não armazenamos dados do cartão.
        </div>
      <% end %>
    </div>
  </div>

</div>

<% if !current_user.has_payment_method? && @setup_client_secret.present? %>
<script>
  const STRIPE_PK        = "<%= ENV['STRIPE_PUBLISHABLE_KEY'] %>";
  const SETUP_SECRET     = "<%= @setup_client_secret %>";
  const CSRF_TOKEN       = document.querySelector('meta[name="csrf-token"]').content;
  const RETURN_TO        = "<%= session[:return_to_after_card] || edit_client_profile_path %>";
  const HAS_SETUP_INTENT = true;
</script>
<% else %>
<script>
  const HAS_SETUP_INTENT = false;
  const STRIPE_PK        = "<%= ENV['STRIPE_PUBLISHABLE_KEY'] %>";
  const CSRF_TOKEN       = document.querySelector('meta[name="csrf-token"]').content;
  const RETURN_TO        = "<%= edit_client_profile_path %>";
</script>
<% end %>

<script>
document.addEventListener('DOMContentLoaded', function() {

  document.querySelectorAll('.pf-tab').forEach(btn => {
    btn.addEventListener('click', function() {
      const tab = this.dataset.tab;
      document.querySelectorAll('.pf-tab').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.pf-tab-content').forEach(t => t.classList.remove('active'));
      this.classList.add('active');
      document.getElementById('pf-tab-' + tab).classList.add('active');
    });
  });

  const phoneField = document.getElementById('phone_field');
  const cpfField   = document.getElementById('cpf_field');
  if (phoneField) {
    phoneField.addEventListener('input', function() {
      let v = this.value.replace(/\D/g, '');
      v = v.length <= 10
        ? v.replace(/^(\d{2})(\d{4})(\d{0,4})/, '($1) $2-$3')
        : v.replace(/^(\d{2})(\d{5})(\d{0,4})/, '($1) $2-$3');
      this.value = v;
    });
  }
  if (cpfField) {
    cpfField.addEventListener('input', function() {
      let v = this.value.replace(/\D/g, '');
      this.value = v.replace(/^(\d{3})(\d{3})(\d{3})(\d{0,2})/, '$1.$2.$3-$4');
    });
  }

  const nameField = document.getElementById('full_name_field');
  function validateField(field) {
    const val = field.value.trim();
    field.classList.remove('error');
    const prev = field.parentElement.querySelector('.field-error-msg');
    if (prev) prev.remove();
    if (val === '') {
      field.classList.add('error');
      const msg = document.createElement('div');
      msg.className = 'field-error-msg';
      msg.innerHTML = '<i class="fas fa-circle-exclamation"></i> Campo obrigatório';
      field.parentElement.appendChild(msg);
      return false;
    }
    return true;
  }
  if (nameField)  nameField.addEventListener('blur', () => validateField(nameField));
  if (phoneField) phoneField.addEventListener('blur', () => validateField(phoneField));
  const form = document.getElementById('pf-form');
  if (form) {
    form.addEventListener('submit', function(e) {
      let valid = true, first = null;
      [nameField, phoneField].forEach(f => {
        if (!f) return;
        if (!validateField(f)) { if (!first) first = f; valid = false; }
      });
      if (!valid) {
        e.preventDefault();
        first.scrollIntoView({ behavior: 'smooth', block: 'center' });
        setTimeout(() => first.focus(), 400);
      }
    });
  }

  if (HAS_SETUP_INTENT && document.getElementById('stripe-card-element')) {
    const stripe   = Stripe(STRIPE_PK);
    const elements = stripe.elements();
    const card     = elements.create('card', {
      style: {
        base: {
          color: '#28231c', fontFamily: 'Inter, sans-serif',
          fontSize: '15px', '::placeholder': { color: '#ada699' },
          iconColor: '#dd7852', backgroundColor: '#fefefd'
        },
        invalid: { color: '#c85050', iconColor: '#c85050' }
      },
      hidePostalCode: true
    });
    card.mount('#stripe-card-element');
    card.on('change', e => {
      document.getElementById('card-errors').textContent = e.error ? e.error.message : '';
    });

    const saveBtn = document.getElementById('btn-save-card');
    if (saveBtn) {
      saveBtn.addEventListener('click', async function() {
        saveBtn.disabled = true;
        saveBtn.innerHTML = '<span class="pf-spinner"></span> Salvando...';
        document.getElementById('card-errors').textContent = '';

        const result = await stripe.confirmCardSetup(SETUP_SECRET, {
          payment_method: { card: card }
        });

        if (result.error) {
          document.getElementById('card-errors').textContent = result.error.message;
          saveBtn.disabled = false;
          saveBtn.innerHTML = '<i class="fas fa-lock"></i> SALVAR CARTÃO';
          return;
        }

        const res = await fetch('/client/profile/attach_payment_method', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF_TOKEN, 'Accept': 'application/json' },
          body: JSON.stringify({ payment_method_id: result.setupIntent.payment_method })
        });
        const data = await res.json();

        if (data.ok) {
          window.location.href = data.return_to || window.location.href;
        } else {
          document.getElementById('card-errors').textContent = data.error || 'Erro ao salvar cartão.';
          saveBtn.disabled = false;
          saveBtn.innerHTML = '<i class="fas fa-lock"></i> SALVAR CARTÃO';
        }
      });
    }
  }

  document.querySelectorAll('.pf-toast').forEach(t => {
    setTimeout(() => {
      t.style.transition = 'opacity .5s ease';
      t.style.opacity = '0';
      setTimeout(() => t.remove(), 500);
    }, 3500);
  });
});
</script>
