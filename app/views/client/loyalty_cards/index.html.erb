<%#
  Fidelidade — os cartões de carimbos do cliente (porte da
  ClientFidelidadeScreen do app), aberta pela Conta e pelo rodapé.

    · Cabeçalho no desenho da Central de notificações (voltar, RECOMPENSAS /
      Fidelidade).
    · Um cartão por lava-rápido, com os mesmos carimbos da Conta e uma
      linha dizendo quanto falta; tocar abre a página do lava-rápido.
    · Sem cartões: explica como funciona e leva pros lava-rápidos — os que
      têm programa mostram o selo de fidelidade na página deles.
%>
<script src="/vendor/feather-4.29.2.min.js"></script>

<style>
  .loov-nav { background: var(--cream) !important; }
  .fd { background: var(--cream); color: var(--ink); min-height: 100vh; padding-top: 60px; }
  .fd *, .fd *::before, .fd *::after { box-sizing: border-box; }
  .fd svg.feather { display: block; flex-shrink: 0; }
  .fd a { text-decoration: none; }
  .fd-wrap { width: 100%; max-width: 760px; margin: 0 auto; padding-bottom: 48px; }

  .fd-head { display: flex; align-items: center; padding: 8px 16px; }
  .fd-btn { flex: 0 0 40px; height: 40px; border-radius: 50%; background: var(--sand); color: var(--ink) !important; display: flex; align-items: center; justify-content: center; transition: background .15s; }
  .fd-btn:hover { background: var(--stone); }
  .fd-hc { flex: 1; text-align: center; padding-right: 40px; }
  .fd-hc small { display: block; font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 2px; color: var(--coral-500); }
  .fd-hc h1 { margin: 2px 0 0 !important; font-family: 'Space Grotesk', sans-serif !important; font-weight: 700; font-size: 20px; letter-spacing: -0.3px; color: var(--ink) !important; }

  .fd-list { display: grid; gap: 10px; padding: 16px 16px 8px; }
  /* Mesmo cartão de carimbos da Conta (.ac-lc). */
  .fd-card { display: block; padding: 18px; background: var(--paper); border: 1px solid var(--stone); border-radius: 20px; color: var(--ink) !important; transition: border-color .15s, box-shadow .2s; }
  .fd-card:hover { border-color: var(--ink); box-shadow: 0 12px 28px -22px rgba(40,35,28,.55); }
  .fd-card-h { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; }
  .fd-card-h b { display: block; font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 15px; letter-spacing: -0.2px; }
  .fd-card-h small { display: block; margin-top: 2px; font-size: 12px; color: var(--graphite); }
  .fd-badge { flex-shrink: 0; display: inline-flex; align-items: center; gap: 4px; padding: 4px 10px; border-radius: 100px; background: #fde8b5; color: #7a6419; font-size: 11px; font-weight: 600; }
  .fd-stamps { display: flex; gap: 4px; margin-top: 14px; }
  .fd-stamps i { flex: 1; height: 28px; border-radius: 6px; background: var(--sand); display: flex; align-items: center; justify-content: center; color: var(--cream); }
  .fd-stamps i.is-on { background: var(--coral-500); }
  .fd-next { display: flex; align-items: center; gap: 6px; margin-top: 12px; font-size: 12.5px; color: var(--graphite); }
  .fd-next.is-close { color: var(--coral-700); font-weight: 600; }
  .fd-next svg { color: var(--coral-500); }

  .fd-sec { padding: 22px 16px 10px; font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 1.2px; text-transform: uppercase; color: var(--ash); }
  .fd-how { margin: 0 16px; padding: 4px 16px; list-style: none; background: var(--paper); border: 1px solid var(--stone); border-radius: 18px; }
  .fd-how li { display: flex; gap: 12px; align-items: center; padding: 12px 0; border-bottom: 1px solid var(--stone); font-size: 13px; line-height: 18px; color: var(--graphite); }
  .fd-how li:last-child { border-bottom: 0; }
  .fd-how p { flex: 1; margin: 0 !important; font-size: 13px !important; line-height: 18px !important; color: var(--graphite) !important; }
  .fd-how-ic { flex: 0 0 34px; height: 34px; border-radius: 10px; background: var(--sand); color: var(--ink); display: flex; align-items: center; justify-content: center; }

  .fd-empty { display: flex; flex-direction: column; align-items: center; padding: 40px 24px 8px; text-align: center; }
  .fd-empty-ic { width: 64px; height: 64px; margin-bottom: 14px; border-radius: 50%; background: var(--coral-50); border: 1px solid var(--coral-100); color: var(--coral-500); display: flex; align-items: center; justify-content: center; }
  .fd-empty h2 { margin: 0 0 6px !important; font-family: 'Space Grotesk', sans-serif !important; font-weight: 700; font-size: 18px; color: var(--ink) !important; }
  .fd-empty p { margin: 0; max-width: 36ch; font-size: 13px; line-height: 19px; color: var(--graphite); }
  .fd-cta { display: inline-flex; align-items: center; gap: 8px; margin-top: 18px; padding: 13px 22px; border-radius: 100px; background: var(--coral-500); color: var(--cream) !important; font-size: 14px; font-weight: 600; transition: background .15s; }
  .fd-cta:hover { background: var(--coral-700); }

  @media (min-width: 720px) {
    .fd-head { padding: 28px 32px 8px; }
    .fd-hc h1 { font-size: 28px; letter-spacing: -0.6px; }
    .fd-list { padding: 20px 32px 8px; grid-template-columns: 1fr 1fr; gap: 12px; }
    .fd-sec { padding-left: 32px; padding-right: 32px; }
    .fd-how { margin: 0 32px; }
  }
</style>

<% qs = request.query_string.present? ? "?#{request.query_string}" : "" %>
<div class="fd">
  <div class="fd-wrap">
    <div class="fd-head">
      <a class="fd-btn" id="fd-back" href="/users/edit<%= qs %>" aria-label="Voltar"><i data-feather="chevron-left" style="width:18px;height:18px"></i></a>
      <div class="fd-hc"><small>RECOMPENSAS</small><h1>Fidelidade</h1></div>
    </div>

    <% if @cards.any? %>
      <div class="fd-list">
        <% @cards.each do |c| %>
          <% faltam = c[:milestone] ? 0 : c[:visits_required] - c[:filled] %>
          <a class="fd-card" href="<%= car_wash_path(c[:car_wash_id]) %><%= qs %>">
            <div class="fd-card-h">
              <div><b><%= c[:car_wash_name] %></b><small><%= c[:reward_description] %></small></div>
              <span class="fd-badge"><i data-feather="star" style="width:11px;height:11px"></i><%= c[:filled] %>/<%= c[:visits_required] %></span>
            </div>
            <div class="fd-stamps">
              <% c[:visits_required].times do |i| %>
                <i class="<%= 'is-on' if i < c[:filled] %>"><% if i < c[:filled] %><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg><% end %></i>
              <% end %>
            </div>
            <% if c[:milestone] %>
              <div class="fd-next is-close"><i data-feather="award" style="width:14px;height:14px"></i>Cartão completo! A recompensa sai nesta visita; o próximo cartão começa em seguida.</div>
            <% elsif faltam == 1 %>
              <div class="fd-next is-close"><i data-feather="gift" style="width:14px;height:14px"></i>Na próxima visita você ganha a recompensa.</div>
            <% else %>
              <div class="fd-next"><i data-feather="gift" style="width:14px;height:14px"></i>Faltam <%= faltam %> visitas pra recompensa.</div>
            <% end %>
          </a>
        <% end %>
      </div>
    <% else %>
      <div class="fd-empty">
        <div class="fd-empty-ic"><i data-feather="gift" style="width:28px;height:28px"></i></div>
        <h2>Nenhum cartão ainda</h2>
        <p>Alguns lava-rápidos dão uma recompensa a cada tantas visitas. Seu cartão começa na primeira lavagem concluída num deles.</p>
        <a class="fd-cta" href="/<%= qs %>"><i data-feather="map-pin" style="width:16px;height:16px"></i>Ver lava-rápidos perto</a>
      </div>
    <% end %>

    <div class="fd-sec">Como funciona</div>
    <ul class="fd-how">
      <li><span class="fd-how-ic"><i data-feather="award" style="width:16px;height:16px"></i></span><p>Lava-rápidos com programa mostram o selo <b style="color:var(--ink)">Fidelidade</b> na página deles, com a recompensa.</p></li>
      <li><span class="fd-how-ic"><i data-feather="check" style="width:16px;height:16px"></i></span><p>Cada lavagem concluída ali conta um carimbo no seu cartão.</p></li>
      <li><span class="fd-how-ic"><i data-feather="gift" style="width:16px;height:16px"></i></span><p>Na visita que completa o cartão, o lava-rápido te dá a recompensa.</p></li>
      <li><span class="fd-how-ic"><i data-feather="refresh-cw" style="width:16px;height:16px"></i></span><p>Depois disso o cartão zera e começa um novo ciclo.</p></li>
    </ul>
  </div>
  <%= render "shared/site_footer", audience: :client %>
</div>

<script>
(function () {
  var back = document.getElementById('fd-back');
  back.addEventListener('click', function (e) {
    if (document.referrer && document.referrer.indexOf(location.origin) === 0 && history.length > 1) { e.preventDefault(); history.back(); }
  });
  if (window.feather) feather.replace();
})();
</script>
