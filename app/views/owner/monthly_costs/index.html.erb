  </div>
</div>

<script nonce="<%= csp_nonce %>">
(function () {
  var C = { ink: '#28231c', coral500: '#dd7852', coral50: '#fbeae3', coral700: '#9c4930', graphite: '#575148', sand: '#f1eee6', stone: '#e0dbd0', ash: '#ada699', rose500: '#c85050', cream: '#fafaf6' };
  var MESES = ['Janeiro', 'Fevereiro', 'Março', 'Abril', 'Maio', 'Junho', 'Julho', 'Agosto', 'Setembro', 'Outubro', 'Novembro', 'Dezembro'];
  var REF = { day: 'que ontem', week: 'que a semana passada', month: 'que o mês passado', year: 'que o ano passado', custom: 'que o intervalo anterior' };

  function $(id) { return document.getElementById(id); }
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
  // Cópia dos ícones Feather desta página: rede de empresa às vezes bloqueia
  // o script e os botões ficavam sem ícone.
  var FEATHER_IC = {
    'alert-circle': '<circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line>',
    'arrow-down-right': '<line x1="7" y1="7" x2="17" y2="17"></line><polyline points="17 7 17 17 7 17"></polyline>',
    'arrow-up-right': '<line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline>',
    'award': '<circle cx="12" cy="8" r="7"></circle><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>',
    'bar-chart-2': '<line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line>',
    'calendar': '<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line>',
    'check-circle': '<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline>',
    'chevron-down': '<polyline points="6 9 12 15 18 9"></polyline>',
    'chevron-right': '<polyline points="9 18 15 12 9 6"></polyline>',
    'file-text': '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline>',
    'grid': '<rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect>',
    'info': '<circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line>',
    'plus': '<line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line>',
    'share': '<path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path><polyline points="16 6 12 2 8 6"></polyline><line x1="12" y1="2" x2="12" y2="15"></line>',
    'trending-down': '<polyline points="23 18 13.5 8.5 8.5 13.5 1 6"></polyline><polyline points="17 18 23 18 23 12"></polyline>',
    'trending-up': '<polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline>',
    'x': '<line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line>',
    'zap': '<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>',
    'clock': '<circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline>',
    'tag': '<path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line>',
    'gift': '<polyline points="20 12 20 22 4 22 4 12"></polyline><rect x="2" y="7" width="20" height="5"></rect><line x1="12" y1="22" x2="12" y2="7"></line><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>',
    'user': '<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle>',
    'users': '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path>',
    'list': '<line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line>'
  };
  function icon(n, size, extra) {
    var corpo = FEATHER_IC[n] || (window.feather && feather.icons[n] && feather.icons[n].contents);
    if (!corpo) return '';
    var cls = 'feather feather-' + n + (extra && extra['class'] ? ' ' + extra['class'] : '');
    return '<svg xmlns="http://www.w3.org/2000/svg" width="' + size + '" height="' + size + '" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="' + ((extra && extra['stroke-width']) || 2) + '" stroke-linecap="round" stroke-linejoin="round" class="' + cls + '" aria-hidden="true">' + corpo + '</svg>';
  }
  function money(v, d) { var n = Number(v || 0); d = d == null ? 2 : d; return (n < 0 ? '−' : '') + 'R$ ' + Math.abs(n).toFixed(d).replace('.', ',').replace(/\B(?=(\d{3})+(?!\d))/g, '.'); }
  function moneyC(v) { return Math.abs(Number(v || 0)) >= 1000 ? money(v, 0) : money(v, 2); }
  function q(o) { var s = 'period=' + encodeURIComponent(o.period); if (o.period === 'custom' && o.start && o.end) s += '&start_date=' + o.start + '&end_date=' + o.end; return s; }

  var st = { period: 'month', start: null, end: null, data: null, open: null, sel: null, pin: null, loading: false };
  // Detalhe da barra clicada: o que formou o faturamento, os custos e o lucro.
  var why = { cache: {}, seq: 0 };

  // ── Dados ────────────────────────────────────────────────────────────────
  var seqLoad = 0;
  function load() {
    var my = ++seqLoad;
    if (!st.data) $('fn-body').innerHTML = '<div class="fn-loading"><span class="fn-spin"></span></div>';
    else $('fn-body').style.opacity = '.55';
    fetch('/owner/financial_tracking.json?' + q(st), { credentials: 'same-origin', headers: { Accept: 'application/json' } })
      .then(function (r) { if (!r.ok) throw r.status; return r.json(); })
      .then(function (d) { if (my !== seqLoad) return; st.data = d; st.sel = null; st.pin = null; why.cache = {}; render(); })
      .catch(function () { if (my !== seqLoad) return; $('fn-body').innerHTML = '<div class="fn-empty"><h3>Não foi possível carregar</h3><p>Confira a conexão e tente de novo.</p></div>'; })
      .then(function () { $('fn-body').style.opacity = ''; });
  }

  // ── Render ───────────────────────────────────────────────────────────────
  function semMovimento(d) { var k = d.kpis || {}; return !Number(k.revenue) && !Number(k.open_revenue) && !Number((k.costs || {}).total); }

  function deltaHtml(prev) {
    if (!prev) return '';
    var delta = Number(prev.profit_delta) || 0, pct = prev.profit_delta_pct, ref = (REF[st.period] || 'que o período anterior') + (prev.partial ? ', até o mesmo dia' : '');
    if (Math.abs(delta) < 0.01) return '<div class="fn-delta">No mesmo nível ' + ref + '</div>';
    var up = delta > 0, size = pct != null ? Math.abs(pct).toFixed(1).replace('.', ',') + '%' : moneyC(Math.abs(delta));
    return '<div class="fn-delta ' + (up ? 'is-up' : 'is-down') + '">' + icon(up ? 'arrow-up-right' : 'arrow-down-right', 15) + '<b>' + size + ' ' + (up ? 'acima' : 'abaixo') + '</b><span>' + ref + '</span></div>';
  }

  function heroHtml(d) {
    var k = d.kpis, neg = Number(k.profit) < 0;
    return '<section class="fn-hero' + (neg ? ' is-neg' : '') + '">' +
      '<div class="fn-hero-top"><span class="fn-mono">Lucro · ' + esc(d.period_label) + '</span>' +
        (k.margin != null ? '<span class="fn-margin">' + icon(neg ? 'trending-down' : 'trending-up', 13) + Number(k.margin).toFixed(1).replace('.', ',') + '% margem</span>' : '') + '</div>' +
      '<div class="fn-profit">' + money(k.profit) + '</div>' + deltaHtml(d.previous) +
      '<div class="fn-rule"></div>' +
      '<div class="fn-calc"><div><small>REALIZADO</small><b>' + moneyC(k.revenue) + '</b></div><span>−</span><div><small>CUSTOS</small><b>' + moneyC((k.costs || {}).total) + '</b></div></div>' +
    '</section>';
  }

  function sideHtml(d) {
    var k = d.kpis, out = '', open = Number(k.open_revenue) || 0, t = d.trailing_12m, c = k.costs || {};
    var ct = Number(c.total) || 0, fx = Number(c.fixed) || 0, vr = Number(c.variable) || 0;
    // O que não aparece em outro lugar da tela: volume, ticket, o serviço que
    // mais rende e o peso do Last Minute no faturamento.
    var op = d.operation || {};
    if (op.attended) {
      var top = op.top_service, lm = op.last_minute || {};
      out += '<div class="fn-card"><div class="fn-mono">Como o dinheiro entrou</div>' +
        '<div class="fn-op-row"><div><b>' + op.attended + '</b><span>' + (op.attended === 1 ? 'atendimento' : 'atendimentos') + '</span></div><div><b>' + moneyC(op.avg_ticket) + '</b><span>ticket médio</span></div></div>' +
        (top ? '<div class="fn-op-line"><span class="fn-op-ic">' + icon('award', 15) + '</span><span><small>Serviço que mais rende</small><strong>' + esc(top.title) + '</strong></span><em>' + moneyC(top.revenue) + (top.share != null ? '<small>' + Number(top.share).toFixed(0) + '% do total</small>' : '') + '</em></div>' : '') +
