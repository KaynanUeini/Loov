      <div class="fn-rg-f"><label class="fn-glab" for="rg-start">DE</label>
        <span class="fn-dwrap"><i data-feather="calendar" style="width:16px;height:16px"></i><input type="date" class="fn-date" id="rg-start"></span></div>
      <div class="fn-rg-f"><label class="fn-glab" for="rg-end">ATÉ</label>
        <span class="fn-dwrap"><i data-feather="calendar" style="width:16px;height:16px"></i><input type="date" class="fn-date" id="rg-end"></span></div>
