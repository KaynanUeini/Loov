<style>
  .kpi-grid {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 14px; margin-bottom: 22px;
  }
  .kpi-card-mini {
    background: var(--paper); border: 1px solid var(--stone);
    border-radius: 16px; padding: 18px;
    display: flex; flex-direction: column; gap: 6px;
    box-shadow: 0 2px 6px rgba(25,20,15,0.04);
    position: relative; overflow: hidden;
  }
  .kpi-card-mini.accent::before {
    content: ''; position: absolute;
    left: 0; top: 0; bottom: 0; width: 3px;
    background: var(--coral-500);
  }
  .kpi-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px; font-weight: 600; letter-spacing: 1.4px;
    color: var(--ash); text-transform: uppercase;
  }
  .kpi-value {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 26px; font-weight: 700;
    color: var(--ink); line-height: 1;
    letter-spacing: -0.4px;
  }
  .kpi-value.coral { color: var(--coral-500); }
  .kpi-value.danger { color: var(--rose-500); }
  .kpi-value.warn   { color: #7a4814; }
  .kpi-value.muted  { color: var(--ash); }
  .kpi-sub { font-size: 12px; color: var(--ash); }

  .fin-section {
    background: var(--paper); border: 1px solid var(--stone);
    border-radius: 20px; overflow: hidden;
    margin-bottom: 16px;
    box-shadow: 0 2px 6px rgba(25,20,15,0.04);
  }
  .fin-section-header {
    padding: 18px 22px;
    border-bottom: 1px solid var(--stone);
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 10px;
  }
  .fin-section-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 17px; font-weight: 700;
    color: var(--ink); letter-spacing: -0.2px;
    display: flex; align-items: center; gap: 8px;
  }
  .fin-section-title i { color: var(--coral-500); font-size: 14px; }

  .chart-wrap { padding: 22px; }
  .chart-inner { position: relative; height: 260px; }

  .dre-table { width: 100%; border-collapse: collapse; }
  .dre-table thead th {
    padding: 12px 18px; text-align: left;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px; font-weight: 600; letter-spacing: 1.4px;
    color: var(--graphite); text-transform: uppercase;
    border-bottom: 1px solid var(--stone);
    background: var(--sand);
    white-space: nowrap;
  }
  .dre-table tbody td {
    padding: 14px 18px; font-size: 14px;
    color: var(--ink); border-bottom: 1px solid var(--stone);
  }
  .dre-table tbody tr:last-child td { border-bottom: none; }
  .dre-table tbody tr:hover td { background: var(--sand); }
  .dre-table tbody tr.row-pending td { background: rgba(216, 178, 74, 0.05); }
  .dre-table tbody tr.row-pending:hover td { background: rgba(216, 178, 74, 0.10); }

  .td-mes { font-weight: 600; }
  .td-value {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14.5px; font-weight: 600;
    letter-spacing: -0.2px;
  }
  .td-coral  { color: var(--coral-500); }
  .td-danger { color: var(--rose-500); }
  .td-warn   { color: #7a4814; }
  .td-muted  { color: var(--ash); font-size: 13px; }

  .margin-pill {
    display: inline-flex; align-items: center;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px; font-weight: 700; letter-spacing: 1px;
    padding: 3px 10px; border-radius: 100px;
    border: 1px solid;
  }
  .margin-positive { background: #d6ecde; color: #2d6b42; border-color: #b5d8c1; }
  .margin-negative { background: #fdecec; color: var(--rose-500); border-color: #f5cccc; }
  .margin-neutral  { background: #fbe2c0; color: #7a4814; border-color: #f0d0a0; }

  .pending-badge {
    display: inline-flex; align-items: center; gap: 5px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px; font-weight: 700; letter-spacing: 1.2px;
    color: #7a4814;
    background: #fbe2c0; border: 1px solid #f0d0a0;
    border-radius: 100px; padding: 3px 10px;
    text-transform: uppercase; white-space: nowrap;
  }

  .no-cost-badge {
    display: inline-flex; align-items: center; gap: 5px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px; font-weight: 600; letter-spacing: 1.2px;
    color: var(--ash); text-transform: uppercase;
    border: 1px dashed var(--stone); border-radius: 100px;
    padding: 3px 10px;
  }

  .btn-launch-sm {
    display: inline-flex; align-items: center; gap: 5px;
    background: var(--coral-50); color: var(--coral-700);
    border: 1px solid var(--coral-100); border-radius: 100px;
    padding: 5px 12px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px; font-weight: 700; letter-spacing: 1.2px;
    cursor: pointer; transition: all 0.2s ease;
    text-decoration: none; text-transform: uppercase;
  }
  .btn-launch-sm:hover {
    background: var(--coral-500); color: var(--cream);
    border-color: var(--coral-500);
  }

  .btn-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 30px; height: 30px; border-radius: 8px;
    border: 1px solid var(--stone); background: var(--paper);
    color: var(--graphite); cursor: pointer;
    transition: all 0.2s ease;
    font-size: 12px;
  }
  .btn-icon:hover { border-color: var(--coral-500); color: var(--coral-700); }
  .btn-icon.danger:hover { border-color: var(--rose-500); color: var(--rose-500); }

  .legend-row {
    display: flex; gap: 22px;
    padding: 14px 22px;
    border-top: 1px solid var(--stone);
    flex-wrap: wrap;
  }
  .legend-item {
    display: flex; align-items: center; gap: 6px;
    font-size: 12px; color: var(--graphite);
  }
  .legend-dot {
    width: 8px; height: 8px; border-radius: 50%;
    flex-shrink: 0;
  }

  .flash-msg {
    display: flex; align-items: center; gap: 10px;
    padding: 12px 18px; border-radius: 12px;
    font-size: 14px; margin-bottom: 22px;
  }
  .flash-success { background: #d6ecde; border: 1px solid #b5d8c1; color: #2d6b42; }
  .flash-error   { background: #fdecec; border: 1px solid #f5cccc; color: var(--rose-500); }

  @media (max-width: 900px) {
    .kpi-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .kpi-grid { grid-template-columns: 1fr 1fr; }
  }
</style>

<div class="loov-page loov-page--wide">

  <div class="loov-hero loov-hero--left" style="display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; flex-wrap: wrap;">
    <div>
      <div class="loov-eyebrow"><span class="dot"></span>Gestão</div>
      <h1 class="loov-h1" style="margin-bottom: 0 !important;">
        Financeiro<span class="accent">.</span>
      </h1>
    </div>
    <%= link_to edit_owner_monthly_costs_path(year: Date.current.year, month: Date.current.month), class: "loov-btn-primary" do %>
      <i class="fas fa-plus"></i> Lançar custos
    <% end %>
  </div>

  <% if flash[:notice] %>
  <div class="flash-msg flash-success"><i class="fas fa-circle-check"></i> <%= flash[:notice] %></div>
  <% end %>
  <% if flash[:alert] %>
  <div class="flash-msg flash-error"><i class="fas fa-circle-exclamation"></i> <%= flash[:alert] %></div>
  <% end %>

  <%
    current_dre      = @dre.last
    avg_margin       = @dre.select { |d| d[:margem] }.map { |d| d[:margem] }.then { |ms| ms.any? ? (ms.sum / ms.size).round(1) : nil }
    total_profit     = @dre.sum { |d| d[:lucro] }
    months_with_cost = @dre.count { |d| d[:tem_custo] }
    current_pending  = current_dre&.dig(:receita_aberto).to_f
  %>

  <div class="kpi-grid">
    <div class="kpi-card-mini accent">
      <div class="kpi-label">Faturamento este mês</div>
      <div class="kpi-value coral">R$&nbsp;<%= number_with_precision(current_dre&.dig(:faturamento).to_f, precision: 0, delimiter: '.') %></div>
      <div class="kpi-sub">clientes que compareceram</div>
    </div>
    <div class="kpi-card-mini">
      <div class="kpi-label">Em aberto</div>
      <div class="kpi-value warn">R$&nbsp;<%= number_with_precision(current_pending, precision: 0, delimiter: '.') %></div>
      <div class="kpi-sub">confirmados, não realizados</div>
    </div>
    <div class="kpi-card-mini">
      <div class="kpi-label">Lucro este mês</div>
      <% if current_dre && current_dre[:tem_custo] %>
        <div class="kpi-value <%= current_dre[:lucro] >= 0 ? 'coral' : 'danger' %>">R$&nbsp;<%= number_with_precision(current_dre[:lucro].abs, precision: 0, delimiter: '.') %></div>
        <div class="kpi-sub"><%= current_dre[:lucro] >= 0 ? 'lucro líquido' : 'prejuízo' %></div>
      <% else %>
        <div class="kpi-value muted">—</div>
        <div class="kpi-sub">custos não cadastrados</div>
      <% end %>
    </div>
    <div class="kpi-card-mini">
      <div class="kpi-label">Margem média 12m</div>
      <% if avg_margin %>
        <div class="kpi-value <%= avg_margin >= 20 ? 'coral' : avg_margin >= 0 ? '' : 'danger' %>"><%= avg_margin %>%</div>
        <div class="kpi-sub"><%= months_with_cost %> meses com dados</div>
      <% else %>
        <div class="kpi-value muted">—</div>
        <div class="kpi-sub">cadastre custos mensais</div>
      <% end %>
    </div>
  </div>

  <% if months_with_cost > 0 %>
  <div class="fin-section">
    <div class="fin-section-header">
      <div class="fin-section-title"><i class="fas fa-chart-bar"></i> Faturamento vs Custos vs Lucro</div>
    </div>
    <div class="chart-wrap">
      <div class="chart-inner"><canvas id="dreChart"></canvas></div>
    </div>
  </div>
  <% end %>

  <div class="fin-section">
    <div class="fin-section-header">
      <div class="fin-section-title"><i class="fas fa-table-list"></i> DRE mensal</div>
    </div>
    <div style="overflow-x: auto;">
      <table class="dre-table">
        <thead>
          <tr>
            <th>Mês</th>
            <th>Faturamento real</th>
            <th>Em aberto</th>
            <th>Custos fixos</th>
            <th>Custos variáveis</th>
            <th>Total custos</th>
            <th>Lucro líquido</th>
            <th>Margem</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @dre.reverse.each do |d| %>
          <%
            is_current  = d[:ano] == Date.current.year && d[:mes_num] == Date.current.month
            has_pending = d[:receita_aberto].to_f > 0
          %>
          <tr class="<%= is_current && has_pending ? 'row-pending' : '' %>">
            <td class="td-mes">
              <%= d[:mes_label] %> <%= d[:ano] %>
              <% if is_current %>
                <span style="font-family: 'JetBrains Mono', monospace; font-size: 9px; letter-spacing: 1.2px; color: var(--coral-500); margin-left: 6px; text-transform: uppercase;">● atual</span>
              <% end %>
            </td>

            <td><span class="td-value td-coral">R$ <%= number_with_precision(d[:faturamento], precision: 2) %></span></td>

            <td>
              <% if is_current && has_pending %>
                <span class="pending-badge"><i class="fas fa-clock"></i> R$ <%= number_with_precision(d[:receita_aberto], precision: 2) %></span>
              <% else %>
                <span class="td-muted">—</span>
              <% end %>
            </td>

            <% if d[:tem_custo] %>
              <% cost = @car_wash.monthly_costs.find_by(year: d[:ano], month: d[:mes_num]) %>
              <td class="td-muted">R$ <%= number_with_precision(cost&.total_fixed.to_f, precision: 2) %></td>
              <td class="td-muted">R$ <%= number_with_precision(cost&.total_variable.to_f, precision: 2) %></td>
              <td><span class="td-value td-warn">R$ <%= number_with_precision(d[:custos], precision: 2) %></span></td>
              <td><span class="td-value <%= d[:lucro] >= 0 ? 'td-coral' : 'td-danger' %>"><%= d[:lucro] < 0 ? '▼ ' : '' %>R$ <%= number_with_precision(d[:lucro].abs, precision: 2) %></span></td>
              <td>
                <% if d[:margem] %>
                  <span class="margin-pill <%= d[:margem] >= 20 ? 'margin-positive' : d[:margem] >= 0 ? 'margin-neutral' : 'margin-negative' %>"><%= d[:margem] %>%</span>
                <% end %>
              </td>
              <td>
                <div style="display: flex; gap: 6px; align-items: center;">
                  <%= link_to edit_owner_monthly_costs_path(year: d[:ano], month: d[:mes_num]), class: "btn-icon" do %>
                    <i class="fas fa-pen"></i>
                  <% end %>
                  <%= button_to owner_monthly_cost_path(cost), method: :delete, form: { style: "display:inline;" }, data: { confirm: "Remover custos de #{d[:mes_label]}?" }, class: "btn-icon danger" do %>
                    <i class="fas fa-trash-can"></i>
                  <% end %>
                </div>
              </td>
            <% else %>
              <td colspan="5"><span class="no-cost-badge"><i class="fas fa-circle-info"></i> Custos não lançados</span></td>
              <td>
                <%= link_to edit_owner_monthly_costs_path(year: d[:ano], month: d[:mes_num]), class: "btn-launch-sm" do %>
                  <i class="fas fa-plus"></i> Lançar
                <% end %>
              </td>
            <% end %>
          </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="legend-row">
      <div class="legend-item"><div class="legend-dot" style="background: var(--coral-500);"></div> Faturamento real = clientes que compareceram</div>
      <div class="legend-item"><div class="legend-dot" style="background: #d6b14a;"></div> Em aberto = agendamentos confirmados ainda não realizados</div>
    </div>
  </div>

  <div style="margin-top: 28px;">
    <%= link_to owner_financial_tracking_path, class: "loov-btn-secondary" do %>
      <i class="fas fa-chart-line"></i> Ver análise completa
    <% end %>
  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
  var dreCtx = document.getElementById('dreChart');
  if (!dreCtx) return;

  var labels = <%= raw @dre.map { |d| d[:mes] }.to_json %>;
  var fat    = <%= raw @dre.map { |d| d[:faturamento] }.to_json %>;
  var costs  = <%= raw @dre.map { |d| d[:custos] }.to_json %>;
  var profit = <%= raw @dre.map { |d| d[:lucro] }.to_json %>;

  new Chart(dreCtx, {
    type: 'bar',
    data: {
      labels: labels,
      datasets: [
        { label: 'Faturamento real', data: fat,    backgroundColor: 'rgba(221, 120, 82, 0.6)', borderRadius: 6, order: 2 },
        { label: 'Custos',           data: costs,  backgroundColor: 'rgba(214, 177, 74, 0.55)', borderRadius: 6, order: 2 },
        { label: 'Lucro',            data: profit, type: 'line', borderColor: '#dd7852', backgroundColor: 'rgba(221, 120, 82, 0.08)', borderWidth: 2.5, fill: true, tension: 0.4, pointBackgroundColor: '#dd7852', pointBorderColor: '#fefefd', pointBorderWidth: 2, pointRadius: 5, order: 1 }
      ]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      interaction: { mode: 'index', intersect: false },
      plugins: {
        legend: { labels: { color: '#575148', font: { family: 'Inter', size: 12 } } },
        tooltip: {
          backgroundColor: '#fefefd', borderColor: '#e0dbd0', borderWidth: 1,
          titleColor: '#dd7852', bodyColor: '#28231c', padding: 12,
          callbacks: { label: function(c) { return ' ' + c.dataset.label + ': R$ ' + c.parsed.y.toFixed(2); } }
        }
      },
      scales: {
        x: { grid: { color: 'rgba(40, 35, 28, 0.04)' }, ticks: { color: '#ada699', font: { family: 'Inter', size: 11 } } },
        y: { beginAtZero: true, grid: { color: 'rgba(40, 35, 28, 0.04)' }, ticks: { color: '#ada699', font: { family: 'Inter', size: 11 }, callback: function(v) { return 'R$ ' + v.toLocaleString('pt-BR'); } } }
      }
    }
  });
});
</script>
