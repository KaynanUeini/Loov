<style>
  .pending-banner {
    display: flex; align-items: flex-start; gap: 12px;
    background: #fbe2c0; border: 1px solid #f0d0a0;
    border-radius: 16px; padding: 14px 18px;
    margin-bottom: 22px;
    color: #7a4814;
  }
  .pending-banner i { font-size: 16px; flex-shrink: 0; margin-top: 2px; color: #7a4814; }
  .pending-banner-text { font-size: 13.5px; line-height: 1.55; }
  .pending-banner-text strong { color: #7a4814; }

  .cost-section {
    background: var(--paper); border: 1px solid var(--stone);
    border-radius: 20px; margin-bottom: 14px; overflow: hidden;
    box-shadow: 0 2px 6px rgba(25,20,15,0.04);
  }

  .cost-section-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 16px 22px;
    cursor: pointer; user-select: none;
    transition: background 0.15s ease;
  }
  .cost-section-header:hover { background: var(--sand); }

  .cost-section-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 17px; font-weight: 700;
    color: var(--ink); letter-spacing: -0.2px;
    display: flex; align-items: center; gap: 10px;
  }
  .cost-section-title i { color: var(--coral-500); font-size: 14px; }

  .cost-section-right { display: flex; align-items: center; gap: 12px; }

  .cost-section-total {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 15px; font-weight: 600;
    color: var(--graphite); letter-spacing: -0.2px;
  }

  .cost-chevron {
    color: var(--ash); font-size: 12px;
    transition: transform 0.25s ease;
  }
  .cost-chevron.open { transform: rotate(180deg); }

  .cost-section-body {
    max-height: 0; overflow: hidden;
    transition: max-height 0.35s ease;
  }
  .cost-section-body.open { max-height: 1400px; }
  .cost-section-body-inner {
    padding: 4px 22px 22px;
    border-top: 1px solid var(--stone);
  }

  .cost-field-header {
    display: flex; align-items: center; justify-content: space-between;
  }

  .cost-label-note {
    font-family: 'Inter', sans-serif;
    font-size: 11.5px; color: var(--ash);
    font-weight: 400; text-transform: none; letter-spacing: 0;
    margin-left: 6px;
  }

  .cost-pending-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9.5px; font-weight: 700; letter-spacing: 1.2px;
    color: #7a4814; text-transform: uppercase;
    background: #fbe2c0; border: 1px solid #f0d0a0;
    border-radius: 100px; padding: 3px 8px;
    display: inline-flex; align-items: center; gap: 4px;
  }
  .cost-pending-tag i { font-size: 9px; }

  .cost-input-wrap { position: relative; }
  .cost-input-prefix {
    position: absolute; left: 14px; top: 50%;
    transform: translateY(-50%);
    font-size: 13px; color: var(--ash);
    font-family: 'JetBrains Mono', monospace; font-weight: 600;
    pointer-events: none;
    z-index: 1;
  }
  .cost-input-wrap .loov-input {
    padding-left: 40px !important;
    text-align: right;
  }
  .cost-input-wrap .loov-input:disabled {
    opacity: 0.4; cursor: not-allowed;
    border-color: #f0d0a0 !important;
  }
  .cost-input-wrap .loov-textarea:disabled { opacity: 0.4; cursor: not-allowed; }

  .cost-actions {
    display: flex; gap: 12px; flex-wrap: wrap;
    margin-top: 22px;
  }
</style>

<div class="loov-page loov-page--narrow">

  <div class="loov-hero">
    <div class="loov-eyebrow"><span class="dot"></span>Lançamento de Custos</div>
    <h1 class="loov-h1">
      <%= MonthlyCost::MONTH_NAMES[@cost.month - 1] %><span class="accent">/<%= @cost.year %></span>
    </h1>
    <p class="loov-lead">Registre os custos fixos e variáveis do mês.</p>
  </div>

  <% if @has_pending %>
  <div class="pending-banner">
    <i class="fas fa-clock"></i>
    <div class="pending-banner-text">
      <strong>Alteração pendente de aprovação.</strong><br>
      Os campos marcados com <strong>⏳</strong> aguardam aprovação e não podem ser alterados até lá.
    </div>
  </div>
  <% end %>

  <%= form_with model: @cost, url: upsert_owner_monthly_costs_path, method: :post, local: true do |f| %>
    <%= hidden_field_tag :year,  @cost.year  %>
    <%= hidden_field_tag :month, @cost.month %>

    <!-- FIXOS -->
    <div class="cost-section">
      <div class="cost-section-header" onclick="toggleSection(this)">
        <div class="cost-section-title"><i class="fas fa-lock"></i> Custos fixos</div>
        <div class="cost-section-right">
          <span class="cost-section-total" id="total-fixed">R$ 0,00</span>
          <i class="fas fa-chevron-down cost-chevron open"></i>
        </div>
      </div>
      <div class="cost-section-body open">
        <div class="cost-section-body-inner">
          <% [
            [:rent,          "Aluguel",                     nil],
            [:salaries,      "Salários e Encargos",         nil],
            [:utilities,     "Água, Luz e Internet",        nil],
            [:other_fixed,   "Outros Fixos",                "contador, seguros, etc"],
          ].each do |field, label, note| %>
          <div class="loov-field" style="margin-top: 14px;">
            <div class="cost-field-header">
              <label class="loov-label">
                <%= label %>
                <% if note %><span class="cost-label-note">(<%= note %>)</span><% end %>
              </label>
              <% if @pending_fields.include?(field.to_s) %>
                <span class="cost-pending-tag"><i class="fas fa-clock"></i> Aguard. aprovação</span>
              <% end %>
            </div>
            <div class="cost-input-wrap">
              <span class="cost-input-prefix">R$</span>
              <%= f.text_field field, class: "loov-input cost-input",
                  placeholder: "0,00",
                  data: { group: "fixed", field: field },
                  disabled: @pending_fields.include?(field.to_s),
                  value: number_with_precision(@cost.send(field), precision: 2, delimiter: '.', separator: ',') %>
            </div>
          </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- VARIÁVEIS -->
    <div class="cost-section">
      <div class="cost-section-header" onclick="toggleSection(this)">
        <div class="cost-section-title"><i class="fas fa-arrows-spin"></i> Custos variáveis</div>
        <div class="cost-section-right">
          <span class="cost-section-total" id="total-variable">R$ 0,00</span>
          <i class="fas fa-chevron-down cost-chevron open"></i>
        </div>
      </div>
      <div class="cost-section-body open">
        <div class="cost-section-body-inner">
          <% [
            [:products,       "Produtos",       "shampoo, cera, detergente, etc"],
            [:maintenance,    "Manutenção",     "equipamentos, reparos"],
            [:other_variable, "Outros Variáveis", nil],
          ].each do |field, label, note| %>
          <div class="loov-field" style="margin-top: 14px;">
            <div class="cost-field-header">
              <label class="loov-label">
                <%= label %>
                <% if note %><span class="cost-label-note">(<%= note %>)</span><% end %>
              </label>
              <% if @pending_fields.include?(field.to_s) %>
                <span class="cost-pending-tag"><i class="fas fa-clock"></i> Aguard. aprovação</span>
              <% end %>
            </div>
            <div class="cost-input-wrap">
              <span class="cost-input-prefix">R$</span>
              <%= f.text_field field, class: "loov-input cost-input",
                  placeholder: "0,00",
                  data: { group: "variable", field: field },
                  disabled: @pending_fields.include?(field.to_s),
                  value: number_with_precision(@cost.send(field), precision: 2, delimiter: '.', separator: ',') %>
            </div>
          </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- OBSERVAÇÕES -->
    <div class="cost-section">
      <div class="cost-section-header" onclick="toggleSection(this)">
        <div class="cost-section-title"><i class="fas fa-note-sticky"></i> Observações</div>
        <i class="fas fa-chevron-down cost-chevron"></i>
      </div>
      <div class="cost-section-body">
        <div class="cost-section-body-inner">
          <div class="loov-field" style="margin-top: 14px;">
            <% if @pending_fields.include?("notes") %>
              <span class="cost-pending-tag" style="margin-bottom: 6px; align-self: flex-start;"><i class="fas fa-clock"></i> Aguard. aprovação</span>
            <% end %>
            <%= f.text_area :notes, class: "loov-textarea",
                placeholder: "Ex: aluguel reajustado, comprei equipamento novo...",
                disabled: @pending_fields.include?("notes") %>
          </div>
        </div>
      </div>
    </div>

    <div class="cost-actions">
      <%= f.submit "Salvar custos", class: "loov-btn-primary" %>
      <%= link_to "Cancelar", owner_monthly_costs_path, class: "loov-btn-ghost" %>
    </div>
  <% end %>

</div>

<script>
function toggleSection(header) {
  var body = header.nextElementSibling;
  var chevron = header.querySelector('.cost-chevron');
  var isOpen = body.classList.contains('open');
  body.classList.toggle('open');
  chevron.classList.toggle('open', !isOpen);
}

function applyMask(input){var d=input.value.replace(/\D/g,'');if(!d.length)d='0';var c=parseInt(d,10),r=(c/100).toFixed(2),p=r.split('.');input.value=p[0].replace(/\B(?=(\d{3})+(?!\d))/g,'.')+','+p[1];}
function getRawValue(input){return input.value.replace(/\./g,'').replace(',','.');}

document.querySelectorAll('.cost-input').forEach(function(el){
  var raw=el.value.replace(/\./g,'').replace(',','.');var num=parseFloat(raw)||0;var c=Math.round(num*100);var r=(c/100).toFixed(2);var p=r.split('.');el.value=p[0].replace(/\B(?=(\d{3})+(?!\d))/g,'.')+','+p[1];
  el.addEventListener('input',function(){applyMask(this);recalc();});
  el.addEventListener('keydown',function(e){if([8,9,27,46,37,38,39,40].indexOf(e.keyCode)!==-1)return;if((e.keyCode<48||e.keyCode>57)&&(e.keyCode<96||e.keyCode>105))e.preventDefault();});
});

document.querySelector('form').addEventListener('submit',function(){
  document.querySelectorAll('.cost-input').forEach(function(el){if(!el.disabled)el.value=getRawValue(el);});
});

function fmtBRL(v){return'R$ '+Math.abs(v).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2});}
function recalc(){var fixed=0,variable=0;document.querySelectorAll('.cost-input').forEach(function(el){if(el.disabled)return;var raw=el.value.replace(/\./g,'').replace(',','.');var val=parseFloat(raw)||0;if(el.dataset.group==='fixed')fixed+=val;if(el.dataset.group==='variable')variable+=val;});document.getElementById('total-fixed').textContent=fmtBRL(fixed);document.getElementById('total-variable').textContent=fmtBRL(variable);}
recalc();
</script>
