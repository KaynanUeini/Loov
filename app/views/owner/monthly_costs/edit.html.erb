<style>
  /* ── Pending banner (atendente) ─────────────────────── */
  .pending-banner {
    display: flex; align-items: flex-start; gap: 12px;
    background: var(--coral-50); border: 1px solid var(--coral-100);
    border-radius: 16px; padding: 14px 18px;
    margin-bottom: 22px;
    color: var(--coral-700);
  }
  .pending-banner i { font-size: 16px; flex-shrink: 0; margin-top: 2px; color: var(--coral-700); }
  .pending-banner-text { font-size: 13.5px; line-height: 1.55; color: var(--ink); }
  .pending-banner-text strong { color: var(--coral-700); }

  /* ── Cost section card (acordeão) ───────────────────── */
  .cost-section {
    background: var(--paper); border: 1px solid var(--stone);
    border-radius: 20px; margin-bottom: 14px; overflow: hidden;
    box-shadow: 0 2px 6px rgba(25,20,15,0.04);
  }

  .cost-section-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 16px 22px;
    cursor: pointer; user-select: none;
    transition: background 0.15s ease;
  }
  .cost-section-header:hover { background: var(--sand); }

  .cost-section-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 17px; font-weight: 700;
    color: var(--ink); letter-spacing: -0.2px;
    display: flex; align-items: center; gap: 10px;
  }
  .cost-section-title i { color: var(--coral-500); font-size: 14px; }

  .cost-section-right { display: flex; align-items: center; gap: 12px; }

  .cost-section-total {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13.5px; font-weight: 600;
    color: var(--graphite); letter-spacing: -0.2px;
  }

  .cost-chevron {
    color: var(--ash); font-size: 12px;
    transition: transform 0.25s ease;
  }
  .cost-chevron.open { transform: rotate(180deg); }

  .cost-section-body {
    max-height: 0; overflow: hidden;
    transition: max-height 0.4s ease;
  }
  .cost-section-body.open { max-height: 4000px; }
  .cost-section-body-inner {
    padding: 8px 22px 22px;
    border-top: 1px solid var(--stone);
  }

  /* ── MoneyField (linha label + input) ───────────────── */
  .money-field {
    display: flex; align-items: center; gap: 14px;
    padding: 10px 0;
    border-bottom: 1px solid var(--stone);
  }
  .money-field:last-child { border-bottom: none; }
  .money-field-label-col { flex: 1; min-width: 0; }
  .money-field-label {
    font-family: 'Inter', sans-serif;
    font-size: 14px; color: var(--graphite);
    font-weight: 500;
  }
  .money-field-note {
    font-size: 11.5px; color: var(--ash);
    font-weight: 400; margin-left: 4px;
  }

  .money-input-wrap {
    display: inline-flex; align-items: center;
    background: var(--paper); border: 1px solid var(--stone);
    border-radius: 12px; padding: 0 12px;
    width: 170px;
    transition: border-color .15s ease, box-shadow .15s ease, background .15s ease;
  }
  .money-input-wrap:focus-within {
    border-color: var(--coral-500);
    box-shadow: 0 0 0 3px rgba(220,120,82,0.08);
  }
  .money-input-wrap.pending {
    border-color: var(--coral-500);
    background: var(--coral-50);
  }
  .money-input-prefix {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12.5px; color: var(--ash);
    font-weight: 600; margin-right: 6px;
  }
  /* !important pra anular o global input { border:1px solid var(--stone) !important }
     que estava criando borda dupla (wrapper + input). */
  .money-input,
  input[type="text"].money-input {
    flex: 1; min-width: 0;
    border: none !important; outline: none; background: transparent !important;
    padding: 11px 0 !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    font-family: 'JetBrains Mono', monospace !important;
    font-size: 14px !important; color: var(--ink) !important;
    text-align: right;
  }
  .money-input:focus,
  input[type="text"].money-input:focus { border: none !important; box-shadow: none !important; }
  .money-input:disabled { opacity: 0.5; cursor: not-allowed; }

  /* ── Pending tag (Aguardando aprovação) ─────────────── */
  .pending-tag {
    display: inline-flex; align-items: center; gap: 5px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 9.5px; font-weight: 700; letter-spacing: 1.2px;
    color: var(--coral-700); text-transform: uppercase;
    background: var(--coral-50); border: 1px solid var(--coral-100);
    border-radius: 100px; padding: 3px 9px;
    margin-top: 4px;
  }
  .pending-tag i { font-size: 9px; }
  .pending-tag-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--coral-500);
  }

  /* ── Custom lines (linhas nomeadas) ─────────────────── */
  .custom-line-row {
    display: flex; align-items: center; gap: 10px;
    padding: 10px 0;
    border-bottom: 1px solid var(--stone);
  }
  .custom-line-row:last-child { border-bottom: none; }
  .custom-line-name {
    flex: 1; min-width: 0;
    background: var(--paper); border: 1px solid var(--stone);
    border-radius: 12px; padding: 10px 12px;
    font-family: 'Inter', sans-serif; font-size: 14px;
    color: var(--ink); outline: none;
    transition: border-color .15s ease, box-shadow .15s ease;
  }
  .custom-line-name:focus {
    border-color: var(--coral-500);
    box-shadow: 0 0 0 3px rgba(220,120,82,0.08);
  }
  .custom-line-name.pending {
    border-color: var(--coral-500);
    background: var(--coral-50);
  }
  .custom-line-name:disabled { opacity: 0.5; cursor: not-allowed; }
  .custom-line-money-wrap {
    display: inline-flex; align-items: center;
    background: var(--paper); border: 1px solid var(--stone);
    border-radius: 12px; padding: 0 12px;
    width: 150px;
    transition: border-color .15s ease, box-shadow .15s ease, background .15s ease;
  }
  .custom-line-money-wrap:focus-within {
    border-color: var(--coral-500);
    box-shadow: 0 0 0 3px rgba(220,120,82,0.08);
  }
  .custom-line-money-wrap.pending {
    border-color: var(--coral-500);
    background: var(--coral-50);
  }
  .custom-line-trash {
    display: inline-flex; align-items: center; justify-content: center;
    width: 32px; height: 32px; border-radius: 10px;
    background: var(--sand); border: 1px solid var(--stone);
    color: var(--graphite); cursor: pointer;
    transition: all .15s ease;
    flex-shrink: 0;
  }
  .custom-line-trash:hover {
    border-color: var(--rose-500); color: var(--rose-500);
    background: var(--paper);
  }

  .add-line-btn {
    display: inline-flex; align-items: center; justify-content: center;
    gap: 8px; width: 100%;
    padding: 11px 14px;
    background: var(--coral-50); color: var(--coral-700);
    border: 1px dashed var(--coral-100); border-radius: 12px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px; font-weight: 700; letter-spacing: 1.2px;
    text-transform: uppercase;
    cursor: pointer; margin-top: 12px;
    transition: all .15s ease;
  }
  .add-line-btn:hover {
    background: var(--coral-500); color: var(--cream);
    border-color: var(--coral-500); border-style: solid;
  }
  .add-line-btn i { font-size: 11px; }

  /* ── Notes textarea ─────────────────────────────────── */
  .notes-area {
    width: 100%; min-height: 100px;
    background: var(--paper); border: 1px solid var(--stone);
    border-radius: 12px; padding: 12px 14px;
    font-family: 'Inter', sans-serif;
    font-size: 14px; color: var(--ink);
    resize: vertical; outline: none;
    transition: border-color .15s ease, box-shadow .15s ease;
  }
  .notes-area:focus {
    border-color: var(--coral-500);
    box-shadow: 0 0 0 3px rgba(220,120,82,0.08);
  }
  .notes-area.pending {
    border-color: var(--coral-500);
    background: var(--coral-50);
  }
  .notes-area:disabled { opacity: 0.5; cursor: not-allowed; }

  /* ── Footer actions ─────────────────────────────────── */
  .cost-actions {
    display: flex; gap: 12px; flex-wrap: wrap;
    margin-top: 22px;
  }

  /* ── Flash messages ─────────────────────────────────── */
  .flash-msg {
    display: flex; align-items: center; gap: 10px;
    padding: 12px 18px; border-radius: 12px;
    font-size: 14px; margin-bottom: 22px;
  }
  .flash-success { background: #d6ecde; border: 1px solid #b5d8c1; color: #2d6b42; }
  .flash-error   { background: #fdecec; border: 1px solid #f5cccc; color: var(--rose-500); }
</style>

<%
  car_wash       = @car_wash || current_user.linked_car_wash
  effective_lines = (@effective_lines || []).map { |l| l.is_a?(Hash) ? l : l.to_h.stringify_keys }
  custom_fixed    = effective_lines.select { |l| l["cost_type"] == "fixed"    }
  custom_variable = effective_lines.select { |l| l["cost_type"] == "variable" }
  pending_keys    = (@pending_line_keys || []).map(&:to_s)

  legacy_other_fixed    = @cost.other_fixed.to_f
  legacy_other_variable = @cost.other_variable.to_f
  legacy_utilities      = @cost.utilities.to_f
  has_new_utilities     = @cost.water.to_f > 0 || @cost.electricity.to_f > 0
%>

<div class="loov-page loov-page--narrow">

  <div class="loov-hero loov-hero--left">
    <div class="loov-eyebrow"><span class="dot"></span>Lançar Custos</div>
    <h1 class="loov-h1">
      <%= MonthlyCost::MONTH_NAMES[@cost.month - 1] %><span class="accent">/<%= @cost.year %></span>
    </h1>
    <p class="loov-lead" style="margin-bottom: 24px;">
      Cadastre os custos fixos e variáveis do mês — o cálculo de DRE usa esses valores.
    </p>
  </div>

  <% if flash[:notice] %>
    <div class="flash-msg flash-success"><i class="fas fa-circle-check"></i> <%= flash[:notice] %></div>
  <% end %>
  <% if flash[:alert] %>
    <div class="flash-msg flash-error"><i class="fas fa-circle-exclamation"></i> <%= flash[:alert] %></div>
  <% end %>

  <% if @has_pending %>
    <div class="pending-banner">
      <i class="fas fa-clock"></i>
      <div class="pending-banner-text">
        <strong>Você tem alterações aguardando aprovação do dono nesse mês.</strong><br>
        Os campos marcados com a etiqueta laranja estão pendentes — só serão aplicados após aprovação.
      </div>
    </div>
  <% end %>

  <%= form_with model: @cost, url: upsert_owner_monthly_costs_path, method: :post, local: true, html: { id: "cost-form" } do |f| %>
    <%= hidden_field_tag :year,  @cost.year  %>
    <%= hidden_field_tag :month, @cost.month %>

    <!-- ─── FIXOS ───────────────────────────────────── -->
    <div class="cost-section">
      <div class="cost-section-header" onclick="toggleSection(this)">
        <div class="cost-section-title"><i class="fas fa-lock"></i> Custos fixos</div>
        <div class="cost-section-right">
          <span class="cost-section-total" id="total-fixed">R$ 0,00</span>
          <i class="fas fa-chevron-down cost-chevron open"></i>
        </div>
      </div>
      <div class="cost-section-body open">
        <div class="cost-section-body-inner">
          <% [
            [:rent,     "Aluguel",  nil],
            [:salaries, "Salários", "e encargos"],
            [:water,    "Água",     nil],
            [:electricity, "Luz",   nil],
          ].each do |field, label, note|
            is_pending = @pending_fields.include?(field.to_s)
            value = @cost.send(field).to_f
            # Migra valor legado de utilities → electricity quando water/electricity ainda zerados.
            if field == :electricity && value.zero? && !has_new_utilities && legacy_utilities > 0
              value = legacy_utilities
            end
          %>
            <div class="money-field">
              <div class="money-field-label-col">
                <span class="money-field-label"><%= label %></span>
                <% if note %><span class="money-field-note">(<%= note %>)</span><% end %>
                <% if is_pending %>
                  <div class="pending-tag">
                    <span class="pending-tag-dot"></span>AGUARDANDO APROVAÇÃO
                  </div>
                <% end %>
              </div>
              <label class="money-input-wrap <%= 'pending' if is_pending %>">
                <span class="money-input-prefix">R$</span>
                <%= f.text_field field, class: "money-input cost-input",
                    id: "monthly_cost_#{field}",
                    inputmode: "numeric",
                    placeholder: "0,00",
                    data: { group: "fixed", field: field },
                    disabled: is_pending,
                    value: number_with_precision(value, precision: 2, delimiter: '.', separator: ',') %>
              </label>
            </div>
          <% end %>

          <!-- Linhas customizadas fixas -->
          <div id="custom-fixed-list">
            <% custom_fixed.each_with_index do |line, idx|
              key = line["id"].to_s
              is_pending = pending_keys.include?(key)
            %>
              <div class="custom-line-row" data-line-type="fixed">
                <input type="hidden" name="custom_lines[][id]"        value="<%= line["id"] %>">
                <input type="hidden" name="custom_lines[][cost_type]" value="fixed">
                <input type="text"
                       class="custom-line-name <%= 'pending' if is_pending %>"
                       name="custom_lines[][name]"
                       value="<%= line["name"] %>"
                       maxlength="60"
                       placeholder="Nome do custo (ex.: Internet)"
                       <%= 'disabled' if is_pending %>>
                <label class="custom-line-money-wrap <%= 'pending' if is_pending %>">
                  <span class="money-input-prefix">R$</span>
                  <input type="text"
                         class="money-input cost-input"
                         inputmode="numeric"
                         data-group="fixed"
                         name="custom_lines[][amount]"
                         placeholder="0,00"
                         <%= 'disabled' if is_pending %>
                         value="<%= number_with_precision(line["amount"].to_f, precision: 2, delimiter: '.', separator: ',') %>">
                </label>
                <button type="button" class="custom-line-trash" onclick="removeCustomLine(this)" title="Remover">
                  <i class="fas fa-xmark"></i>
                </button>
              </div>
              <% if is_pending %>
                <div style="margin: -4px 0 8px 4px;">
                  <span class="pending-tag"><span class="pending-tag-dot"></span>AGUARDANDO APROVAÇÃO</span>
                </div>
              <% end %>
            <% end %>

            <!-- Migração de other_fixed legado, só se não há pending -->
            <% if legacy_other_fixed > 0 && !@has_pending %>
              <div class="custom-line-row" data-line-type="fixed" data-legacy="1">
                <input type="hidden" name="custom_lines[][cost_type]" value="fixed">
                <input type="text" class="custom-line-name" name="custom_lines[][name]"
                       value="Outros fixos" maxlength="60" placeholder="Nome do custo">
                <label class="custom-line-money-wrap">
                  <span class="money-input-prefix">R$</span>
                  <input type="text" class="money-input cost-input" inputmode="numeric"
                         data-group="fixed" name="custom_lines[][amount]"
                         value="<%= number_with_precision(legacy_other_fixed, precision: 2, delimiter: '.', separator: ',') %>">
                </label>
                <button type="button" class="custom-line-trash" onclick="removeCustomLine(this)" title="Remover">
                  <i class="fas fa-xmark"></i>
                </button>
              </div>
            <% end %>
          </div>

          <button type="button" class="add-line-btn" onclick="addCustomLine('fixed')">
            <i class="fas fa-plus"></i> Adicionar custo fixo
          </button>
        </div>
      </div>
    </div>

    <!-- ─── VARIÁVEIS ───────────────────────────────── -->
    <div class="cost-section">
      <div class="cost-section-header" onclick="toggleSection(this)">
        <div class="cost-section-title"><i class="fas fa-arrows-spin"></i> Custos variáveis</div>
        <div class="cost-section-right">
          <span class="cost-section-total" id="total-variable">R$ 0,00</span>
          <i class="fas fa-chevron-down cost-chevron open"></i>
        </div>
      </div>
      <div class="cost-section-body open">
        <div class="cost-section-body-inner">
          <% [
            [:products,    "Produtos",   "shampoo, cera, detergente"],
            [:maintenance, "Manutenção", "equipamentos, reparos"],
          ].each do |field, label, note|
            is_pending = @pending_fields.include?(field.to_s)
          %>
            <div class="money-field">
              <div class="money-field-label-col">
                <span class="money-field-label"><%= label %></span>
                <% if note %><span class="money-field-note">(<%= note %>)</span><% end %>
                <% if is_pending %>
                  <div class="pending-tag">
                    <span class="pending-tag-dot"></span>AGUARDANDO APROVAÇÃO
                  </div>
                <% end %>
              </div>
              <label class="money-input-wrap <%= 'pending' if is_pending %>">
                <span class="money-input-prefix">R$</span>
                <%= f.text_field field, class: "money-input cost-input",
                    id: "monthly_cost_#{field}",
                    inputmode: "numeric",
                    placeholder: "0,00",
                    data: { group: "variable", field: field },
                    disabled: is_pending,
                    value: number_with_precision(@cost.send(field), precision: 2, delimiter: '.', separator: ',') %>
              </label>
            </div>
          <% end %>

          <!-- Linhas customizadas variáveis -->
          <div id="custom-variable-list">
            <% custom_variable.each_with_index do |line, idx|
              key = line["id"].to_s
              is_pending = pending_keys.include?(key)
            %>
              <div class="custom-line-row" data-line-type="variable">
                <input type="hidden" name="custom_lines[][id]"        value="<%= line["id"] %>">
                <input type="hidden" name="custom_lines[][cost_type]" value="variable">
                <input type="text"
                       class="custom-line-name <%= 'pending' if is_pending %>"
                       name="custom_lines[][name]"
                       value="<%= line["name"] %>"
                       maxlength="60"
                       placeholder="Nome do custo (ex.: Combustível)"
                       <%= 'disabled' if is_pending %>>
                <label class="custom-line-money-wrap <%= 'pending' if is_pending %>">
                  <span class="money-input-prefix">R$</span>
                  <input type="text"
                         class="money-input cost-input"
                         inputmode="numeric"
                         data-group="variable"
                         name="custom_lines[][amount]"
                         placeholder="0,00"
                         <%= 'disabled' if is_pending %>
                         value="<%= number_with_precision(line["amount"].to_f, precision: 2, delimiter: '.', separator: ',') %>">
                </label>
                <button type="button" class="custom-line-trash" onclick="removeCustomLine(this)" title="Remover">
                  <i class="fas fa-xmark"></i>
                </button>
              </div>
              <% if is_pending %>
                <div style="margin: -4px 0 8px 4px;">
                  <span class="pending-tag"><span class="pending-tag-dot"></span>AGUARDANDO APROVAÇÃO</span>
                </div>
              <% end %>
            <% end %>

            <% if legacy_other_variable > 0 && !@has_pending %>
              <div class="custom-line-row" data-line-type="variable" data-legacy="1">
                <input type="hidden" name="custom_lines[][cost_type]" value="variable">
                <input type="text" class="custom-line-name" name="custom_lines[][name]"
                       value="Outros variáveis" maxlength="60" placeholder="Nome do custo">
                <label class="custom-line-money-wrap">
                  <span class="money-input-prefix">R$</span>
                  <input type="text" class="money-input cost-input" inputmode="numeric"
                         data-group="variable" name="custom_lines[][amount]"
                         value="<%= number_with_precision(legacy_other_variable, precision: 2, delimiter: '.', separator: ',') %>">
                </label>
                <button type="button" class="custom-line-trash" onclick="removeCustomLine(this)" title="Remover">
                  <i class="fas fa-xmark"></i>
                </button>
              </div>
            <% end %>
          </div>

          <button type="button" class="add-line-btn" onclick="addCustomLine('variable')">
            <i class="fas fa-plus"></i> Adicionar custo variável
          </button>
        </div>
      </div>
    </div>

    <!-- ─── OBSERVAÇÕES ─────────────────────────────── -->
    <div class="cost-section">
      <div class="cost-section-header" onclick="toggleSection(this)">
        <div class="cost-section-title"><i class="fas fa-note-sticky"></i> Observações</div>
        <i class="fas fa-chevron-down cost-chevron"></i>
      </div>
      <div class="cost-section-body">
        <div class="cost-section-body-inner">
          <% notes_pending = @pending_fields.include?("notes") %>
          <% if notes_pending %>
            <div style="margin-bottom: 10px;">
              <span class="pending-tag"><span class="pending-tag-dot"></span>AGUARDANDO APROVAÇÃO</span>
            </div>
          <% end %>
          <%= f.text_area :notes,
              class: "notes-area #{'pending' if notes_pending}",
              placeholder: "Ex.: aluguel reajustado, comprei equipamento novo…",
              disabled: notes_pending %>
        </div>
      </div>
    </div>

    <!-- Hidden zeros para campos legados que a UI não expõe mais -->
    <%= hidden_field_tag "monthly_cost[utilities]",      "0", id: "hidden_utilities" %>
    <%= hidden_field_tag "monthly_cost[other_fixed]",    "0", id: "hidden_other_fixed" %>
    <%= hidden_field_tag "monthly_cost[other_variable]", "0", id: "hidden_other_variable" %>

    <div class="cost-actions">
      <%= f.submit "Salvar custos", class: "loov-btn-primary" %>
      <%= link_to "Cancelar", owner_monthly_costs_path, class: "loov-btn-ghost" %>
    </div>
  <% end %>

</div>

<!-- Template pra novas linhas customizadas (clonado por addCustomLine) -->
<template id="custom-line-template">
  <div class="custom-line-row" data-line-type="__TYPE__">
    <input type="hidden" name="custom_lines[][cost_type]" value="__TYPE__">
    <input type="text" class="custom-line-name" name="custom_lines[][name]"
           maxlength="60" placeholder="Nome do custo">
    <label class="custom-line-money-wrap">
      <span class="money-input-prefix">R$</span>
      <input type="text" class="money-input cost-input" inputmode="numeric"
             data-group="__TYPE__" name="custom_lines[][amount]"
             placeholder="0,00" value="0,00">
    </label>
    <button type="button" class="custom-line-trash" onclick="removeCustomLine(this)" title="Remover">
      <i class="fas fa-xmark"></i>
    </button>
  </div>
</template>

<script>
// ─── Section toggle (acordeão) ──────────────────────────
function toggleSection(header) {
  var body = header.nextElementSibling;
  var chevron = header.querySelector('.cost-chevron');
  var isOpen = body.classList.contains('open');
  body.classList.toggle('open');
  chevron.classList.toggle('open', !isOpen);
}

// ─── Cash-register currency mask ────────────────────────
// Cada keystroke cresce o valor em centavos (estilo "máquina registradora"):
// 4 → 0,04 · 48 → 0,48 · 248 → 2,48 · 1248 → 12,48
function applyMask(input) {
  var d = (input.value || '').replace(/\D/g, '');
  if (!d.length) d = '0';
  // limita a 12 dígitos pra evitar overflow (R$ 9.999.999.999,99)
  d = d.slice(0, 12);
  var c = parseInt(d, 10);
  var r = (c / 100).toFixed(2);
  var p = r.split('.');
  input.value = p[0].replace(/\B(?=(\d{3})+(?!\d))/g, '.') + ',' + p[1];
}

function getRawValue(input) {
  return (input.value || '').replace(/\./g, '').replace(',', '.');
}

function attachMask(el) {
  // Normaliza valor inicial passando pela máscara.
  var raw = getRawValue(el);
  var num = parseFloat(raw) || 0;
  var c   = Math.round(num * 100);
  var r   = (c / 100).toFixed(2);
  var p   = r.split('.');
  el.value = p[0].replace(/\B(?=(\d{3})+(?!\d))/g, '.') + ',' + p[1];

  el.addEventListener('input', function() { applyMask(this); recalc(); });
  el.addEventListener('keydown', function(e) {
    if ([8, 9, 27, 46, 37, 38, 39, 40].indexOf(e.keyCode) !== -1) return;
    if ((e.keyCode < 48 || e.keyCode > 57) && (e.keyCode < 96 || e.keyCode > 105)) {
      e.preventDefault();
    }
  });
}

document.querySelectorAll('.cost-input').forEach(attachMask);

// ─── Submit handler: converte máscara → raw ──────────────
document.getElementById('cost-form').addEventListener('submit', function() {
  document.querySelectorAll('.cost-input').forEach(function(el) {
    if (!el.disabled) el.value = getRawValue(el);
  });
});

// ─── Totais (visualização) ───────────────────────────────
function fmtBRL(v) {
  return 'R$ ' + Math.abs(v).toLocaleString('pt-BR', {
    minimumFractionDigits: 2, maximumFractionDigits: 2
  });
}

function recalc() {
  var fixed = 0, variable = 0;
  document.querySelectorAll('.cost-input').forEach(function(el) {
    if (el.disabled) return;
    var raw = getRawValue(el);
    var val = parseFloat(raw) || 0;
    if (el.dataset.group === 'fixed')    fixed    += val;
    if (el.dataset.group === 'variable') variable += val;
  });
  var f = document.getElementById('total-fixed');
  var v = document.getElementById('total-variable');
  if (f) f.textContent = fmtBRL(fixed);
  if (v) v.textContent = fmtBRL(variable);
}
recalc();

// ─── Custom lines: add/remove ────────────────────────────
function addCustomLine(type) {
  var listId = type === 'fixed' ? 'custom-fixed-list' : 'custom-variable-list';
  var list   = document.getElementById(listId);
  var tpl    = document.getElementById('custom-line-template');
  var html   = tpl.innerHTML.replace(/__TYPE__/g, type);

  var wrap = document.createElement('div');
  wrap.innerHTML = html.trim();
  var row = wrap.firstElementChild;
  list.appendChild(row);

  // attach mask + focus name
  row.querySelectorAll('.cost-input').forEach(attachMask);
  var nameInput = row.querySelector('.custom-line-name');
  if (nameInput) nameInput.focus();
  recalc();
}

function removeCustomLine(btn) {
  var row = btn.closest('.custom-line-row');
  if (!row) return;
  // Se a próxima for a tag pending, remove também.
  var next = row.nextElementSibling;
  row.remove();
  if (next && next.querySelector && next.querySelector('.pending-tag')) {
    next.remove();
  }
  recalc();
}
</script>
