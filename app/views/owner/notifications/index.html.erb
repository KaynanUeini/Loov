<%#
  Notificações do dono e do atendente — porte da OwnerNotificacoesScreen do
  app, com a mesma lista (Owner::NotificationsController#build_notifications)
  embutida na página. Mesmo desenho da Central do cliente.

    · Cabeçalho padrão (shared/page_head), igual à Central do cliente. Abrir
      a página já marca todas como lidas: nesta visita as novas mantêm o
      ponto coral e a frase diz quantas chegaram; na próxima já vêm lidas.
    · Cartão: ícone e etiqueta pelo tipo (DISPONÍVEL, APROVAÇÃO, SUPORTE,
      IA INSIGHTS, ATENDENTE), tempo relativo, ponto coral se não lida. Mudança
      feita por atendente abre a lista do que mudou em "VER DETALHES".
    · Tocar leva pra tela do assunto no site (Suporte, IA insights,
      Gerenciar); aprovação abre a gaveta de Aprovações do painel.
%>
<script src="/vendor/feather-4.29.2.min.js"></script>

<style>
  .loov-nav { background: var(--cream) !important; }
  .nt { background: var(--cream); color: var(--ink); min-height: 100vh; padding-top: 60px; }
  .nt *, .nt *::before, .nt *::after { box-sizing: border-box; }
  .nt button { font-family: inherit; line-height: normal; cursor: pointer; }
  .nt svg.feather { display: block; }
  .nt a { text-decoration: none; }
  .nt-wrap { width: 100%; max-width: 1120px; margin: 0 auto; padding: 0 20px 64px; }

  /* Lista na largura de leitura; o cabeçalho segue a largura da página. */
  .nt-list { display: grid; gap: 10px; max-width: 760px; padding-top: 28px; }
  .nt-card { background: var(--paper); border: 1px solid var(--stone); border-radius: 16px; padding: 14px; box-shadow: 0 2px 6px -4px rgba(40,35,28,.2); transition: border-color .15s, box-shadow .2s; }
  .nt-card:hover { border-color: var(--ink); box-shadow: 0 12px 28px -22px rgba(40,35,28,.55); }
  .nt-card.is-unread { border-color: var(--coral-100); }
  .nt-top { display: flex; align-items: flex-start; gap: 12px; width: 100%; padding: 0; border: 0; background: transparent; text-align: left; color: var(--ink); }
  .nt-ic { flex: 0 0 36px; height: 36px; border-radius: 50%; border: 1px solid; display: flex; align-items: center; justify-content: center; }
  .nt-body { flex: 1; min-width: 0; }
  .nt-meta { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 4px; }
  .nt-tag { font-family: 'JetBrains Mono', monospace; font-size: 9px; letter-spacing: 1.2px; }
  .nt-time { display: flex; align-items: center; gap: 6px; font-family: 'JetBrains Mono', monospace; font-size: 10px; color: var(--ash); white-space: nowrap; }
  .nt-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--coral-500); }
  .nt-title { margin-bottom: 2px; font-size: 14px; font-weight: 600; }
  .nt-desc { font-size: 12px; line-height: 17px; color: var(--graphite); }
  .nt-card:not(.is-open) .nt-title { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .nt-card:not(.is-open) .nt-desc { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .nt-more { display: flex; align-items: center; justify-content: center; gap: 6px; width: 100%; margin-top: 10px; padding: 9px 0 0; border: 0; border-top: 1px solid var(--stone); background: transparent; color: var(--coral-700); font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 1.2px; }
  .nt-more:hover { color: var(--coral-500); }

  .nt-items { margin: 10px 0 0 48px; padding: 0; list-style: none; display: grid; gap: 6px; }
  .nt-items li { position: relative; padding-left: 14px; font-size: 12.5px; line-height: 18px; color: var(--ink); }
  .nt-items li::before { content: ""; position: absolute; left: 0; top: 7px; width: 5px; height: 5px; border-radius: 50%; background: var(--coral-500); }
  .nt-empty { display: flex; flex-direction: column; align-items: center; padding: 32px 20px 60px; text-align: center; }
  /* A ilustração do passarinho, como o vazio da Central do cliente. */
  .nt-empty img { width: min(84%, 340px); height: auto; margin-bottom: 18px; }
  .nt-empty h2 { margin: 0 0 4px !important; font-family: 'Space Grotesk', sans-serif !important; font-weight: 700; font-size: 18px; letter-spacing: -0.2px; color: var(--ink) !important; }
  .nt-empty p { margin: 0; font-size: 13px; line-height: 18px; color: var(--ash); }

  @media (min-width: 720px) {
    .nt-list { padding-top: 36px; gap: 12px; }
    .nt-card { padding: 16px 18px; }
  }
  @media (min-width: 960px) { .nt-wrap { padding: 0 40px 80px; } }
</style>

<div class="nt">
  <div class="nt-wrap">
    <%= render "shared/page_head", back_href: "/users/edit", back_id: "nt-back", eyebrow: "Central",
               title: "Notificações", title_id: "nt-title", lead_id: "nt-lead" %>
    <div id="nt-body"></div>
  </div>
</div>

<script>
(function () {
  var LIST = <%= raw json_escape(@notifications.to_json) %>;
  var CSRF = (document.querySelector('meta[name="csrf-token"]') || {}).content;
  // Onde cada aviso leva no site (no app é a `route` de cada um).
  var HREF = {
    OwnerDisponivel:   '/',
    OwnerMudancasPendentes: '/?abrir=aprovacoes',
    OwnerAiInsights:   '<%= owner_financial_tracking_path %>',
    OwnerSupport:      '<%= suporte_path %>',
    OwnerGerenciar:    <%= raw json_escape((current_car_wash ? manage_car_wash_path(current_car_wash) : nil).to_json) %>
  };
  // Mesma tabela do app (TYPE_META).
  var TYPE_META = {
    disponivel:         { icon: 'zap',            color: 'var(--amber-500, #c98a1b)', bg: 'var(--sand)',     border: 'var(--stone)',     label: 'DISPONÍVEL' },
    pending_change:     { icon: 'check-square',   color: 'var(--coral-500)',          bg: 'var(--coral-50)', border: 'var(--coral-100)', label: 'APROVAÇÃO' },
    support_reply:      { icon: 'message-circle', color: 'var(--pool-500, #2f7bb5)',  bg: 'var(--pool-50, #eef5fa)', border: 'var(--pool-100, #d3e5f2)', label: 'SUPORTE' },
    ai_insight:         { icon: 'cpu',            color: 'var(--coral-500)',          bg: 'var(--coral-50)', border: 'var(--coral-100)', label: 'IA INSIGHTS' },
    ai_insights_cycle:  { icon: 'cpu',            color: 'var(--coral-500)',          bg: 'var(--coral-50)', border: 'var(--coral-100)', label: 'IA INSIGHTS' },
    attendant_activity: { icon: 'edit-3',         color: 'var(--coral-500)',          bg: 'var(--coral-50)', border: 'var(--coral-100)', label: 'ATENDENTE' }
  };
  var FALLBACK = { icon: 'bell', color: 'var(--graphite)', bg: 'var(--sand)', border: 'var(--stone)', label: 'AVISO' };
  var open = {};

  function $(id) { return document.getElementById(id); }
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
  function icon(n, size) { return window.feather && feather.icons[n] ? feather.icons[n].toSvg({ width: size, height: size }) : ''; }
  function relTime(iso) {
    if (!iso) return '';
    var t = new Date(iso), s = Math.floor((Date.now() - t.getTime()) / 1000);
    if (s < 60) return 'agora';
    if (s < 3600) return 'há ' + Math.floor(s / 60) + ' min';
    if (s < 86400) return 'há ' + Math.floor(s / 3600) + 'h';
    if (s < 604800) return 'há ' + Math.floor(s / 86400) + 'd';
    return t.toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit' });
  }
  function post(url, method) {
    return fetch(url, { method: method, credentials: 'same-origin', headers: { Accept: 'application/json', 'X-CSRF-Token': CSRF } });
  }

  function card(n) {
    var m = TYPE_META[n.type] || FALLBACK, desc = n.desc || '', items = Array.isArray(n.items) ? n.items : [];
    var canOpen = items.length > 0 || desc.length > 80, isOpen = !!open[n.id];
    // Aberto com lista: a lista substitui o resumo, pra não repetir (igual ao app).
    var showDesc = !isOpen || !items.length;
    return '<article class="nt-card' + (n.read ? '' : ' is-unread') + (isOpen ? ' is-open' : '') + '">' +
      '<button type="button" class="nt-top" data-tap="' + esc(n.id) + '">' +
        '<span class="nt-ic" style="background:' + m.bg + ';border-color:' + m.border + ';color:' + m.color + '">' + icon(m.icon, 15) + '</span>' +
        '<span class="nt-body"><span class="nt-meta"><span class="nt-tag" style="color:' + m.color + '">' + m.label + '</span>' +
          '<span class="nt-time">' + relTime(n.created_at) + (n.read ? '' : '<span class="nt-dot" aria-label="não lida"></span>') + '</span></span>' +
          '<span class="nt-title" style="display:block">' + esc(n.title) + '</span>' +
          (showDesc ? '<span class="nt-desc">' + esc(desc) + '</span>' : '') + '</span>' +
      '</button>' +
      (isOpen && items.length ? '<ul class="nt-items">' + items.map(function (it) { return '<li>' + esc(it) + '</li>'; }).join('') + '</ul>' : '') +
      (canOpen ? '<button type="button" class="nt-more" data-more="' + esc(n.id) + '" aria-expanded="' + isOpen + '">' + (isOpen ? 'OCULTAR DETALHES' : 'VER DETALHES') + icon(isOpen ? 'chevron-up' : 'chevron-down', 14) + '</button>' : '') +
    '</article>';
  }

  function render() {
    var unread = LIST.filter(function (n) { return !n.read; }).length;
    $('nt-title').textContent = LIST.length ? 'Suas notificações.' : 'Notificações';
    $('nt-lead').textContent = !LIST.length ? ''
      : unread ? unread + (unread === 1 ? ' nova' : ' novas') + ' desde a última visita.' : 'Você está em dia.';
    $('nt-body').innerHTML = LIST.length
      ? '<div class="nt-list">' + LIST.map(card).join('') + '</div>'
      : '<div class="nt-empty"><img src="/illustrations/notificacoes-vazia.svg" alt="Ilustração de um sino quieto com um sinal de tudo certo e um passarinho pousado"><h2>Nada por aqui</h2><p>Você está em dia — sem notificações pendentes.</p></div>';
  }

  // Tocar leva pra tela do assunto. A leitura já foi marcada ao abrir.
  function tap(id) {
    var n = LIST.filter(function (x) { return x.id === id; })[0]; if (!n) return;
    var go = HREF[n.route] || null;
    if (go) location.href = go;
  }
  // Abrir já conta como ler tudo (igual à Central do cliente); a lista desta
  // visita segue mostrando o ponto nas novas.
  if (LIST.some(function (n) { return !n.read; })) post('/owner/notifications/read_all', 'POST').catch(function () {});

  document.addEventListener('click', function (e) {
    var t;
    if ((t = e.target.closest('[data-more]'))) { var id = t.dataset.more; open[id] = !open[id]; render(); return; }
    if ((t = e.target.closest('[data-tap]'))) { tap(t.dataset.tap); return; }
  });
  $('nt-back').addEventListener('click', function (e) {
    if (document.referrer && document.referrer.indexOf(location.origin) === 0 && history.length > 1) { e.preventDefault(); history.back(); }
  });

  if (window.feather) feather.replace();
  render();
})();
</script>
