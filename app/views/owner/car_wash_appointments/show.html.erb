<% Rails.logger.info("Renderizando owner/car_wash_appointments/show.html.erb: appointment=#{@appointment.inspect}") %>

<style>
  .appt-detail-row {
    display: flex; align-items: center; gap: 14px;
    padding: 14px 22px;
    border-bottom: 1px solid var(--stone);
  }
  .appt-detail-row:last-child { border-bottom: none; }
  .appt-detail-row:hover { background: var(--sand); }
  .appt-detail-icon {
    width: 36px; height: 36px; border-radius: 10px;
    background: var(--coral-50); border: 1px solid var(--coral-100);
    display: flex; align-items: center; justify-content: center;
    font-size: 13px; color: var(--coral-700);
    flex-shrink: 0;
  }
  .appt-detail-content { flex: 1; min-width: 0; }
  .appt-detail-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px; letter-spacing: 1.4px;
    color: var(--ash); text-transform: uppercase;
    margin-bottom: 3px;
  }
  .appt-detail-value {
    font-size: 14.5px; color: var(--ink);
    font-weight: 500;
  }
  .appt-detail-value.highlight {
    color: var(--coral-500);
    font-family: 'Space Grotesk', sans-serif;
    font-size: 18px; font-weight: 600;
    letter-spacing: -0.2px;
  }
</style>

<div class="loov-page loov-page--narrow">

  <div class="loov-hero">
    <div class="loov-eyebrow"><span class="dot"></span><%= @appointment.car_wash.name %></div>
    <h1 class="loov-h1">Detalhes do <span class="accent">agendamento</span>.</h1>
  </div>

  <div class="loov-card" style="padding: 0; overflow: hidden;">
    <div style="padding: 18px 22px; border-bottom: 1px solid var(--stone); display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;">
      <div style="font-family: 'Space Grotesk', sans-serif; font-size: 16px; font-weight: 700; color: var(--ink); letter-spacing: -0.2px; display: flex; align-items: center; gap: 8px;">
        <i class="fas fa-calendar-check" style="color: var(--coral-500); font-size: 14px;"></i>
        Agendamento #<%= @appointment.id %>
      </div>
      <%
        st = @appointment.status.to_s.downcase.gsub('í','i').gsub('ú','u')
        pill_mod = case st
                   when 'agendado' then 'loov-pill--coral'
                   when 'concluido' then 'loov-pill--success'
                   when 'cancelado' then 'loov-pill--danger'
                   else 'loov-pill--neutral'
                   end
      %>
      <span class="loov-pill <%= pill_mod %>">
        <i class="fas fa-circle" style="font-size: 5px;"></i>
        <%= @appointment.status %>
      </span>
    </div>

    <div>
      <div class="appt-detail-row">
        <div class="appt-detail-icon"><i class="fas fa-calendar-day"></i></div>
        <div class="appt-detail-content">
          <div class="appt-detail-label">Data</div>
          <div class="appt-detail-value"><%= @appointment.scheduled_at.strftime("%d/%m/%Y") %></div>
        </div>
      </div>

      <div class="appt-detail-row">
        <div class="appt-detail-icon"><i class="fas fa-clock"></i></div>
        <div class="appt-detail-content">
          <div class="appt-detail-label">Horário</div>
          <div class="appt-detail-value highlight"><%= @appointment.scheduled_at.strftime("%H:%M") %></div>
        </div>
      </div>

      <div class="appt-detail-row">
        <div class="appt-detail-icon"><i class="fas fa-user"></i></div>
        <div class="appt-detail-content">
          <div class="appt-detail-label">Cliente</div>
          <div class="appt-detail-value"><%= @appointment.user.email.split('@').first.capitalize %></div>
        </div>
      </div>

      <div class="appt-detail-row">
        <div class="appt-detail-icon"><i class="fas fa-envelope"></i></div>
        <div class="appt-detail-content">
          <div class="appt-detail-label">E-mail</div>
          <div class="appt-detail-value"><%= @appointment.user.email %></div>
        </div>
      </div>

      <div class="appt-detail-row">
        <div class="appt-detail-icon"><i class="fas fa-spray-can-sparkles"></i></div>
        <div class="appt-detail-content">
          <div class="appt-detail-label">Serviço</div>
          <div class="appt-detail-value"><%= @appointment.service.title %></div>
        </div>
      </div>

      <div class="appt-detail-row">
        <div class="appt-detail-icon"><i class="fas fa-location-dot"></i></div>
        <div class="appt-detail-content">
          <div class="appt-detail-label">Endereço</div>
          <div class="appt-detail-value"><%= @appointment.car_wash.address %></div>
        </div>
      </div>

      <% if @appointment.service.price.present? %>
      <div class="appt-detail-row">
        <div class="appt-detail-icon"><i class="fas fa-tag"></i></div>
        <div class="appt-detail-content">
          <div class="appt-detail-label">Preço</div>
          <div class="appt-detail-value">R$ <%= number_with_precision(@appointment.service.price, precision: 2) %></div>
        </div>
      </div>
      <% end %>
    </div>
  </div>

  <div class="loov-cta-row" style="margin-top: 28px; justify-content: flex-start;">
    <%= link_to owner_car_wash_appointments_path, class: "loov-btn-secondary" do %>
      <i class="fas fa-arrow-left"></i> Voltar
    <% end %>
    <% if @appointment.status == "confirmed" && (@appointment.scheduled_at - Time.now) > 2.hours %>
      <%= link_to cancel_appointment_path(@appointment),
          method: :patch,
          data: { confirm: "Deseja cancelar este agendamento?" },
          class: "loov-btn-ghost",
          style: "color: var(--rose-500);" do %>
        <i class="fas fa-xmark"></i> Cancelar agendamento
      <% end %>
    <% end %>
  </div>

</div>

<% Rails.logger.info("Template owner/car_wash_appointments/show.html.erb renderizado com sucesso") %>
