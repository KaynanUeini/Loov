<% Rails.logger.info("Renderizando owner/car_wash_appointments/index.html.erb") %>

<style>
  .filter-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 14px; align-items: end;
  }
  .filter-actions { display: flex; gap: 8px; align-items: end; flex-wrap: wrap; }

  .custom-dates {
    display: none; grid-template-columns: 1fr 1fr;
    gap: 14px; margin-top: 14px; padding-top: 14px;
    border-top: 1px solid var(--stone);
  }
  .custom-dates.visible { display: grid; }

  .date-group { margin-bottom: 14px; }

  .date-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 20px;
    background: var(--paper); border: 1px solid var(--stone);
    border-radius: 14px; cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease;
    user-select: none;
  }
  .date-header:hover { background: var(--sand); }
  .date-header.open {
    border-radius: 14px 14px 0 0;
    border-bottom-color: transparent;
    background: var(--paper);
  }

  .date-header-left { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }

  .date-label {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 18px; font-weight: 700;
    color: var(--ink); letter-spacing: -0.3px;
  }
  .date-today { color: var(--coral-500); }
  .date-weekday {
    font-family: 'Inter', sans-serif;
    color: var(--ash); font-size: 13.5px;
    font-weight: 400; letter-spacing: 0;
    margin-left: 6px;
  }

  .date-count {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px; font-weight: 600; letter-spacing: 1.2px;
    color: var(--graphite); text-transform: uppercase;
    background: var(--sand); border: 1px solid var(--stone);
    border-radius: 100px; padding: 4px 10px;
  }

  .date-chevron {
    color: var(--ash); font-size: 12px;
    transition: transform 0.25s ease;
  }
  .date-chevron.open { transform: rotate(180deg); }

  .date-body {
    max-height: 0; overflow: hidden;
    transition: max-height 0.35s ease;
    background: var(--paper); border: 1px solid var(--stone);
    border-top: none; border-radius: 0 0 14px 14px;
  }
  .date-body.open { max-height: 2400px; }

  .appt-list { display: flex; flex-direction: column; }

  .appt-row {
    padding: 14px 20px;
    display: flex; align-items: center; gap: 14px;
    transition: background 0.15s ease;
    border-bottom: 1px solid var(--stone);
  }
  .appt-row:last-child { border-bottom: none; border-radius: 0 0 14px 14px; }
  .appt-row:hover { background: var(--sand); }

  .appt-time {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 18px; font-weight: 700;
    color: var(--coral-500); letter-spacing: -0.3px;
    min-width: 56px;
  }

  .appt-sep { width: 1px; height: 36px; background: var(--stone); flex-shrink: 0; }

  .appt-info { flex: 1; min-width: 0; }
  .appt-client {
    font-size: 14.5px; font-weight: 600;
    color: var(--ink); margin-bottom: 2px;
  }
  .appt-service { font-size: 12.5px; color: var(--graphite); }

  .btn-detail {
    display: inline-flex; align-items: center; justify-content: center;
    width: 34px; height: 34px; border-radius: 8px;
    background: transparent; border: 1px solid var(--stone);
    color: var(--graphite); text-decoration: none;
    transition: all 0.2s ease; font-size: 12px;
    flex-shrink: 0;
  }
  .btn-detail:hover {
    border-color: var(--coral-500);
    color: var(--coral-700);
    background: var(--coral-50);
  }

  .empty-state-card {
    text-align: center; padding: 60px 24px;
  }
  .empty-icon-lg {
    font-size: 38px; color: var(--stone);
    margin-bottom: 14px;
  }
  .empty-title-lg {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 22px; font-weight: 700;
    color: var(--ink); margin-bottom: 6px;
    letter-spacing: -0.3px;
  }
  .empty-text-lg {
    font-size: 14px; color: var(--graphite);
    margin-bottom: 22px;
  }

  @media (max-width: 540px) {
    .filter-grid { grid-template-columns: 1fr; }
    .custom-dates { grid-template-columns: 1fr; }
    .appt-sep { display: none; }
  }
</style>

<div class="loov-page">

  <div class="loov-hero">
    <div class="loov-eyebrow"><span class="dot"></span><%= current_user.car_washes.first&.name || "Lava-rápido" %></div>
    <h1 class="loov-h1">Sua <span class="accent">agenda</span>.</h1>
    <p class="loov-lead">Filtre, acompanhe e gerencie todos os agendamentos do lava-rápido.</p>
  </div>

  <%= form_with url: owner_car_wash_appointments_path, method: :get, local: true do %>
  <div class="loov-card" style="margin-bottom: 28px;">
    <div class="filter-grid">
      <div class="loov-field" style="margin-bottom: 0;">
        <label class="loov-label">Período</label>
        <%= select_tag :period, options_for_select([
          ["Últimos 7 dias", "last_7_days"],
          ["Próximos 7 dias", "next_7_days"],
          ["Personalizado", "custom"]
        ], params[:period]), include_blank: "Todos os períodos", class: "loov-input", id: "period-select" %>
      </div>
      <div class="loov-field" style="margin-bottom: 0;">
        <label class="loov-label">Status</label>
        <%= select_tag :status, options_for_select([
          ["Todos", "Todos"], ["Agendado", "Agendado"],
          ["Concluído", "Concluído"], ["Cancelado", "Cancelado"]
        ], params[:status]), class: "loov-input" %>
      </div>
      <div class="loov-field" style="margin-bottom: 0;">
        <label class="loov-label">Buscar</label>
        <%= text_field_tag :search, params[:search], placeholder: "Cliente ou serviço...", class: "loov-input" %>
      </div>
      <div class="filter-actions">
        <%= submit_tag "Filtrar", class: "loov-btn-primary" %>
        <%= link_to "Limpar", owner_car_wash_appointments_path, class: "loov-btn-ghost" %>
      </div>
    </div>
    <div class="custom-dates <%= params[:period] == 'custom' ? 'visible' : '' %>" id="custom-dates">
      <div class="loov-field" style="margin-bottom: 0;">
        <label class="loov-label">Data inicial</label>
        <%= date_field_tag :start_date, params[:start_date], class: "loov-input" %>
      </div>
      <div class="loov-field" style="margin-bottom: 0;">
        <label class="loov-label">Data final</label>
        <%= date_field_tag :end_date, params[:end_date], class: "loov-input" %>
      </div>
    </div>
  </div>
  <% end %>

  <% if @appointments_by_date.empty? %>
  <div class="loov-card empty-state-card">
    <div class="empty-icon-lg"><i class="fas fa-calendar-xmark"></i></div>
    <div class="empty-title-lg">Nenhum agendamento</div>
    <p class="empty-text-lg">Nenhum resultado para os filtros selecionados.</p>
    <%= link_to "Limpar filtros", owner_car_wash_appointments_path, class: "loov-btn-secondary" %>
  </div>
  <% else %>
  <div>
    <% @appointments_by_date.each_with_index do |(date, appointments), index| %>
    <% is_today = date == Date.today %>
    <div class="date-group">
      <div class="date-header <%= is_today ? 'open' : '' %>" onclick="toggleDate(this)">
        <div class="date-header-left">
          <span class="date-label <%= is_today ? 'date-today' : '' %>">
            <%= is_today ? 'Hoje' : date.strftime("%d/%m/%Y") %>
            <% unless is_today %>
              <span class="date-weekday">
                <%= I18n.l(date, format: "%A") rescue date.strftime("%A") %>
              </span>
            <% end %>
          </span>
          <span class="date-count"><%= appointments.count %> agendamento<%= appointments.count == 1 ? '' : 's' %></span>
        </div>
        <i class="fas fa-chevron-down date-chevron <%= is_today ? 'open' : '' %>"></i>
      </div>
      <div class="date-body <%= is_today ? 'open' : '' %>">
        <div class="appt-list">
          <% appointments.each do |appointment| %>
          <div class="appt-row">
            <div class="appt-time"><%= appointment.scheduled_at.strftime("%H:%M") %></div>
            <div class="appt-sep"></div>
            <div class="appt-info">
              <div class="appt-client"><%= appointment.user.display_name.presence || appointment.user.email.split('@').first.capitalize %></div>
              <div class="appt-service"><%= appointment.service.title %></div>
            </div>
            <%
              status_class = appointment.status.downcase.gsub('í','i').gsub('ú','u')
              pill_mod = case status_class
                         when 'agendado' then 'loov-pill--coral'
                         when 'concluido' then 'loov-pill--success'
                         when 'cancelado' then 'loov-pill--danger'
                         else 'loov-pill--neutral'
                         end
            %>
            <span class="loov-pill <%= pill_mod %>">
              <i class="fas fa-circle" style="font-size: 5px;"></i>
              <%= appointment.status %>
            </span>
            <%= link_to owner_car_wash_appointment_path(appointment), class: "btn-detail", title: "Ver detalhes" do %>
              <i class="fas fa-arrow-up-right"></i>
            <% end %>
          </div>
          <% end %>
        </div>
      </div>
    </div>
    <% end %>
  </div>
  <% end %>

</div>

<script>
function toggleDate(header) {
  var body    = header.nextElementSibling;
  var chevron = header.querySelector('.date-chevron');
  var isOpen  = body.classList.contains('open');
  body.classList.toggle('open', !isOpen);
  chevron.classList.toggle('open', !isOpen);
  header.classList.toggle('open', !isOpen);
}

document.addEventListener('DOMContentLoaded', function() {
  var periodSelect = document.getElementById('period-select');
  var customDates  = document.getElementById('custom-dates');
  if (periodSelect) {
    periodSelect.addEventListener('change', function() {
      customDates.classList.toggle('visible', this.value === 'custom');
    });
  }
});
</script>

<% Rails.logger.info("Template owner/car_wash_appointments/index.html.erb renderizado com sucesso") %>
