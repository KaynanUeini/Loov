<%#
  Alerta de pedido do Last Minute — em TODAS as páginas do dono e do
  atendente (renderizado pelo layout), não só no painel.

  O pedido vive 3 minutos. Antes este alerta só existia no dashboard: o dono
  que estava no Financeiro ou no Gerenciar não via nada, o tempo acabava e o
  cliente recebia uma recusa que ninguém decidiu. Agora:

  - Toma a tela, como o pedido de corrida do motorista no Uber: um pedido com
    prazo não pode ser um sino discreto num canto.
  - Anel de contagem regressiva (o comprimento é o tempo, coral → rosa nos
    últimos 30s), mesmo vocabulário do painel e do app.
  - Som curto ao chegar e a cada 15s enquanto ninguém decide.
  - Título da aba piscando e notificação do sistema quando a aba está em
    segundo plano — o dono pode estar em outra aba ou outro programa.

  Navegador só toca som e mostra notificação depois de um clique na página e
  de uma permissão; a pílula "Ativar alertas" pede as duas coisas de uma vez.
%>
<div id="lm-alert" hidden>
  <div class="lma-ov"></div>
  <div class="lma-card" role="alertdialog" aria-modal="true" aria-labelledby="lma-svc" aria-describedby="lma-when">
    <div class="lma-head">
      <span class="lma-eyebrow"><i class="lma-dot"></i><span id="lma-eyebrow-txt">Last Minute · novo pedido</span></span>
      <span class="lma-queue" id="lma-queue" hidden></span>
    </div>

    <div class="lma-ring-wrap">
      <svg class="lma-ring" viewBox="0 0 120 120" aria-hidden="true">
        <circle cx="60" cy="60" r="52" class="lma-ring-bg"/>
        <circle cx="60" cy="60" r="52" class="lma-ring-fg" id="lma-ring"/>
      </svg>
      <div class="lma-count"><b id="lma-count">3:00</b><span>pra decidir</span></div>
    </div>

    <div class="lma-main">
      <h3 class="lma-svc" id="lma-svc">—</h3>
      <div class="lma-when" id="lma-when">—</div>
      <div class="lma-client">
        <span class="lma-av" id="lma-av">?</span>
        <div style="min-width:0">
          <div class="lma-name" id="lma-name">—</div>
          <div class="lma-car" id="lma-car"></div>
        </div>
      </div>
    </div>

    <div class="lma-money">
      <div class="lma-row"><span>Valor do serviço</span><b id="lma-total">—</b></div>
      <div class="lma-row"><span>Garantido no cartão do cliente <em>35%</em></span><b id="lma-pre">—</b></div>
      <div class="lma-row strong"><span>Você recebe na chegada</span><b id="lma-rest">—</b></div>
    </div>

    <div class="lma-actions" id="lma-actions">
      <button type="button" class="lma-btn lma-no" id="lma-no">Recusar</button>
      <button type="button" class="lma-btn lma-yes" id="lma-yes">Aceitar pedido</button>
    </div>
    <div class="lma-result" id="lma-result" hidden></div>
  </div>
</div>

<button type="button" class="lma-enable" id="lma-enable" hidden>
  <span class="lma-enable-ic">🔔</span>
  <span><b>Ativar alertas do Last Minute</b><small>Som e aviso do navegador quando chegar pedido</small></span>
  <span class="lma-enable-x" id="lma-enable-x" aria-label="Agora não">×</span>
</button>

<style>
  #lm-alert[hidden], .lma-enable[hidden], #lm-alert [hidden] { display: none !important; }
  #lm-alert { position: fixed; inset: 0; z-index: 2000; display: flex; align-items: center; justify-content: center; padding: 16px; }
  .lma-ov { position: absolute; inset: 0; background: rgba(25,20,15,.62); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); animation: lmaFade .25s ease both; }
  .lma-card {
    position: relative; width: 100%; max-width: 420px; max-height: calc(100vh - 32px); overflow-y: auto;
    background: var(--paper, #fefefd); border-radius: 28px; padding: 22px 22px 20px;
    box-shadow: 0 30px 80px rgba(25,20,15,.45); animation: lmaIn .38s cubic-bezier(.16,1,.3,1) both;
    font-family: 'Inter', sans-serif; color: var(--ink, #28231c);
  }
  @keyframes lmaFade { from { opacity: 0; } }
  @keyframes lmaIn { from { opacity: 0; transform: translateY(24px) scale(.96); } }
  .lma-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .lma-eyebrow { display: inline-flex; align-items: center; gap: 8px; font-family: 'JetBrains Mono', monospace; font-size: 10.5px; letter-spacing: 1.6px; text-transform: uppercase; color: var(--coral-500, #dd7852); }
  .lma-dot { width: 8px; height: 8px; border-radius: 50%; background: currentColor; animation: lmaPulse 1s ease-in-out infinite; }
  @keyframes lmaPulse { 50% { opacity: .3; transform: scale(.7); } }
  .lma-queue { font-size: 11.5px; font-weight: 600; color: var(--graphite, #575148); background: var(--sand, #f1eee6); border-radius: 999px; padding: 4px 10px; }

  .lma-ring-wrap { position: relative; width: 132px; height: 132px; margin: 14px auto 6px; }
  .lma-ring { width: 100%; height: 100%; transform: rotate(-90deg); }
  .lma-ring-bg { fill: none; stroke: var(--sand, #f1eee6); stroke-width: 8; }
  .lma-ring-fg { fill: none; stroke: var(--coral-500, #dd7852); stroke-width: 8; stroke-linecap: round; stroke-dasharray: 326.73; transition: stroke-dashoffset .95s linear, stroke .3s; }
  #lm-alert.urgent .lma-ring-fg { stroke: var(--rose-500, #d05a5a); }
  .lma-count { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; }
  .lma-count b { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 32px; letter-spacing: -1px; font-variant-numeric: tabular-nums; }
  .lma-count span { font-size: 11px; color: var(--ash, #ada699); margin-top: 2px; }
  #lm-alert.urgent .lma-count b { color: var(--rose-500, #d05a5a); }

  .lma-main { text-align: center; }
  .lma-svc { margin: 6px 0 0 !important; font-family: 'Space Grotesk', sans-serif !important; font-weight: 700; font-size: 24px !important; letter-spacing: -.6px; color: var(--ink, #28231c) !important; line-height: 1.15; }
  .lma-when { color: var(--graphite, #575148); font-size: 13.5px; margin-top: 4px; }
  .lma-client { display: flex; align-items: center; gap: 10px; text-align: left; margin-top: 16px; padding: 12px 14px; background: var(--cream, #fafaf6); border: 1px solid var(--stone, #e0dbd0); border-radius: 16px; }
  .lma-av { width: 36px; height: 36px; border-radius: 50%; flex-shrink: 0; display: flex; align-items: center; justify-content: center; background: var(--coral-50, #fbeae3); color: var(--coral-500, #dd7852); font-weight: 700; }
  .lma-name { font-weight: 600; font-size: 14.5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .lma-car { display: flex; align-items: center; gap: 8px; margin-top: 3px; color: var(--graphite, #575148); font-size: 12.5px; flex-wrap: wrap; }
  .lma-plate { font-family: 'JetBrains Mono', monospace; font-size: 11.5px; letter-spacing: 1.5px; background: var(--ink, #28231c); color: var(--cream, #fafaf6); border-radius: 6px; padding: 2px 7px; }

  .lma-money { margin-top: 12px; border: 1px solid var(--stone, #e0dbd0); border-radius: 16px; overflow: hidden; }
  .lma-row { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding: 10px 14px; font-size: 13.5px; color: var(--graphite, #575148); }
  .lma-row + .lma-row { border-top: 1px solid var(--stone, #e0dbd0); }
  .lma-row em { font-style: normal; font-family: 'JetBrains Mono', monospace; font-size: 10px; color: var(--ash, #ada699); margin-left: 4px; }
  .lma-row b { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 15px; color: var(--ink, #28231c); font-variant-numeric: tabular-nums; }
  .lma-row.strong span { color: var(--ink, #28231c); font-weight: 600; }
  .lma-row.strong b { color: var(--coral-500, #dd7852); font-size: 17px; }

  .lma-actions { display: grid; grid-template-columns: 1fr 1.6fr; gap: 10px; margin-top: 16px; }
  .lma-btn { border-radius: 999px; padding: 15px 14px; font-size: 14.5px; font-weight: 600; cursor: pointer; font-family: inherit; transition: background .15s, border-color .15s, opacity .15s, transform .15s; }
  .lma-yes { background: var(--coral-500, #dd7852) !important; color: var(--cream, #fafaf6) !important; border: none !important; box-shadow: 0 6px 16px rgba(221,120,82,.3); }
  .lma-yes:hover:not(:disabled) { background: var(--coral-700, #9c4930) !important; transform: translateY(-1px); }
  .lma-no { background: transparent; color: var(--graphite, #575148); border: 1px solid var(--stone, #e0dbd0); }
  .lma-no:hover:not(:disabled) { border-color: var(--rose-500, #d05a5a); color: var(--rose-500, #d05a5a); }
  .lma-btn:disabled { opacity: .55; cursor: wait; transform: none; }
  .lma-result { margin-top: 16px; padding: 14px; border-radius: 16px; text-align: center; font-weight: 600; font-size: 14px; }
  .lma-result.ok  { background: #e4f4ed; color: #2d6b4f; }
  .lma-result.no  { background: var(--sand, #f1eee6); color: var(--graphite, #575148); }
  .lma-result.err { background: #fdecec; color: var(--rose-500, #d05a5a); }

  .lma-enable {
    position: fixed; left: 16px; bottom: calc(16px + env(safe-area-inset-bottom)); z-index: 1500;
    display: flex; align-items: center; gap: 12px; max-width: calc(100vw - 32px);
    padding: 12px 14px 12px 12px; border-radius: 18px; cursor: pointer; text-align: left; font-family: 'Inter', sans-serif;
    background: var(--ink, #28231c); color: var(--cream, #fafaf6); border: none;
    box-shadow: 0 14px 34px rgba(25,20,15,.3); animation: lmaIn .4s cubic-bezier(.16,1,.3,1) both;
  }
  .lma-enable-ic { width: 34px; height: 34px; border-radius: 50%; background: rgba(255,255,255,.1); display: flex; align-items: center; justify-content: center; font-size: 16px; flex-shrink: 0; }
  .lma-enable b { display: block; font-size: 13.5px; }
  .lma-enable small { display: block; font-size: 11.5px; opacity: .65; margin-top: 2px; }
  .lma-enable-x { margin-left: 4px; width: 26px; height: 26px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 18px; opacity: .55; }
  .lma-enable-x:hover { opacity: 1; background: rgba(255,255,255,.1); }

  @media (max-width: 520px) {
    #lm-alert { align-items: flex-end; padding: 0; }
    .lma-card { max-width: none; border-radius: 28px 28px 0 0; padding-bottom: calc(20px + env(safe-area-inset-bottom)); animation-name: lmaUp; }
    @keyframes lmaUp { from { transform: translateY(40px); opacity: .5; } }
  }
  @media (prefers-reduced-motion: reduce) {
    .lma-card, .lma-ov, .lma-enable { animation: none; }
    .lma-dot { animation: none; }
  }
</style>

<script nonce="<%= csp_nonce %>">
(function () {
  if (window.LoovLM) return;
  var CSRF = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';
  var TTL = <%= Appointment::ACCEPTANCE_TTL.to_i %>;
  var CIRC = 2 * Math.PI * 52;
  var $ = function (id) { return document.getElementById(id); };
  var root = $('lm-alert');

  var st = { queue: [], cur: null, deadline: 0, acting: false, done: false, tick: null, chime: null, flash: null, seenIds: {}, closed: {} };
  var baseTitle = document.title;

  function brl(v) { return 'R$ ' + (Number(v) || 0).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
  function secsLeft() { return Math.max(0, Math.round((st.deadline - Date.now()) / 1000)); }

  // ── Som (Web Audio: sem arquivo, sem custo de carga) ──────────────────
  var actx = null;
  function unlockAudio() {
    try {
      if (!actx) actx = new (window.AudioContext || window.webkitAudioContext)();
      if (actx.state === 'suspended') actx.resume();
    } catch (e) {}
  }
  function chime() {
    if (!actx || actx.state !== 'running') return;
    var t = actx.currentTime;
    [[880, 0], [1318.5, .16], [1760, .32]].forEach(function (n) {
      var o = actx.createOscillator(), g = actx.createGain();
      o.type = 'sine'; o.frequency.value = n[0];
      g.gain.setValueAtTime(0, t + n[1]);
      g.gain.linearRampToValueAtTime(.22, t + n[1] + .02);
      g.gain.exponentialRampToValueAtTime(.001, t + n[1] + .45);
      o.connect(g); g.connect(actx.destination);
      o.start(t + n[1]); o.stop(t + n[1] + .5);
    });
  }
  ['pointerdown', 'keydown', 'touchstart'].forEach(function (ev) {
    window.addEventListener(ev, unlockAudio, { passive: true });
  });

  // ── Notificação do sistema (aba em segundo plano) ─────────────────────
  function systemNotify(a) {
    if (!('Notification' in window) || Notification.permission !== 'granted' || !document.hidden) return;
    try {
      var n = new Notification('Novo pedido Last Minute · ' + a.scheduled_at, {
        body: (a.client_name || 'Cliente') + ' quer ' + a.service_name + '. Você tem 3 min pra aceitar.',
        tag: 'lm-' + a.id, requireInteraction: true, icon: '/favicon.svg'
      });
      n.onclick = function () { window.focus(); n.close(); };
    } catch (e) {}
  }

  // ── Pílula "Ativar alertas" ───────────────────────────────────────────
  var DISMISS_KEY = 'loov_lm_alerts_dismissed';
  function maybeShowEnable() {
    var dismissed = false; try { dismissed = localStorage.getItem(DISMISS_KEY) === '1'; } catch (e) {}
    var need = ('Notification' in window) && Notification.permission === 'default';
    $('lma-enable').hidden = dismissed || !need;
  }
  $('lma-enable').addEventListener('click', function (e) {
    if (e.target.id === 'lma-enable-x') {
      try { localStorage.setItem(DISMISS_KEY, '1'); } catch (x) {}
      $('lma-enable').hidden = true; return;
    }
    unlockAudio(); chime();
    if ('Notification' in window) Notification.requestPermission().then(maybeShowEnable, maybeShowEnable);
    $('lma-enable').hidden = true;
  });

  // ── Exibição ──────────────────────────────────────────────────────────
  function fill(a) {
    $('lma-svc').textContent = a.service_name || 'Serviço';
    $('lma-when').textContent = 'Hoje às ' + a.scheduled_at + (a.car_wash_name ? ' · ' + a.car_wash_name : '');
    var name = a.client_name || 'Cliente';
    $('lma-av').textContent = name.trim().charAt(0).toUpperCase() || '?';
    $('lma-name').textContent = name;
    var car = $('lma-car'); car.innerHTML = '';
    if (a.vehicle_model) { var m = document.createElement('span'); m.textContent = a.vehicle_model; car.appendChild(m); }
    if (a.vehicle_plate) { var p = document.createElement('span'); p.className = 'lma-plate'; p.textContent = a.vehicle_plate; car.appendChild(p); }
    if (!a.vehicle_model && !a.vehicle_plate) car.textContent = 'Veículo não informado';
    var total = Number(a.service_price) || 0, pre = Number(a.prepayment) || 0;
    $('lma-total').textContent = brl(total);
    $('lma-pre').textContent = pre ? brl(pre) : '—';
    $('lma-rest').textContent = brl(Math.max(0, total - pre));
  }

  function renderQueue() {
    var extra = st.queue.filter(function (q) { return !st.cur || q.id !== st.cur.id; }).length;
    $('lma-queue').hidden = extra < 1;
    $('lma-queue').textContent = '+' + extra + ' na fila';
  }

  function show(a) {
    st.cur = a; st.acting = false; st.done = false;
    st.deadline = Date.now() + Math.max(0, a.seconds_left || TTL) * 1000;
    fill(a);
    $('lma-actions').hidden = false; $('lma-result').hidden = true;
    $('lma-yes').disabled = $('lma-no').disabled = false;
    $('lma-yes').textContent = 'Aceitar pedido'; $('lma-no').textContent = 'Recusar';
    $('lma-eyebrow-txt').textContent = 'Last Minute · novo pedido';
    root.hidden = false; renderQueue();
    document.documentElement.style.overflow = 'hidden';
    updateTick();
    clearInterval(st.tick); st.tick = setInterval(updateTick, 1000);

    if (!st.seenIds[a.id]) {
      st.seenIds[a.id] = true;
      chime(); systemNotify(a);
    }
    clearInterval(st.chime); st.chime = setInterval(function () { if (!st.done && !st.acting) chime(); }, 15000);
    clearInterval(st.flash);
    var on = false;
    st.flash = setInterval(function () { on = !on; document.title = on ? '⚡ Novo pedido Last Minute' : baseTitle; }, 1000);
    setTimeout(function () { var y = $('lma-yes'); if (y) y.focus(); }, 60);
  }

  function updateTick() {
    var s = secsLeft();
    $('lma-count').textContent = Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0');
    $('lma-ring').style.strokeDashoffset = String(CIRC * (1 - s / TTL));
    root.classList.toggle('urgent', s <= 30 && !st.done);
    if (s <= 0 && !st.done && !st.acting) finish('no', 'Tempo esgotado. O pedido foi liberado e o cliente não foi cobrado.');
  }

  function stopSignals() {
    clearInterval(st.chime); clearInterval(st.flash);
    document.title = baseTitle;
  }

  function hide() {
    clearInterval(st.tick); stopSignals();
    root.hidden = true; st.cur = null;
    document.documentElement.style.overflow = '';
    next();
  }

  function finish(kind, text) {
    st.done = true; stopSignals(); clearInterval(st.tick);
    root.classList.remove('urgent');
    $('lma-actions').hidden = true;
    var r = $('lma-result'); r.hidden = false; r.className = 'lma-result ' + kind; r.textContent = text;
    var id = st.cur && st.cur.id;
    if (id) st.closed[id] = true;
    st.queue = st.queue.filter(function (q) { return q.id !== id; });
    setTimeout(hide, kind === 'ok' ? 2200 : 2600);
  }

  function next() {
    if (st.cur) return;
    var a = st.queue[0];
    if (a) show(a);
  }

  function act(action) {
    if (st.acting || st.done || !st.cur) return;
    st.acting = true;
    var btn = action === 'accept' ? $('lma-yes') : $('lma-no');
    $('lma-yes').disabled = $('lma-no').disabled = true;
    btn.textContent = action === 'accept' ? 'Aceitando…' : 'Recusando…';
    fetch('/owner/disponivel_acceptance/' + st.cur.id + '/' + action, {
      method: 'PATCH', credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json', 'X-CSRF-Token': CSRF }
    }).then(function (r) { return r.json().catch(function () { return {}; }).then(function (d) { return { ok: r.ok && d.ok, d: d }; }); })
      .then(function (x) {
        if (x.ok) {
          finish(action === 'accept' ? 'ok' : 'no', action === 'accept'
            ? 'Aceito. O cliente já foi avisado e está a caminho.'
            : 'Recusado. O cliente não é cobrado.');
          document.dispatchEvent(new CustomEvent('loov:lm-decided', { detail: { action: action } }));
        } else {
          st.acting = false;
          $('lma-yes').disabled = $('lma-no').disabled = false;
          $('lma-yes').textContent = 'Aceitar pedido'; $('lma-no').textContent = 'Recusar';
          var r = $('lma-result'); r.hidden = false; r.className = 'lma-result err';
          r.textContent = (x.d && x.d.error) || 'Não foi possível concluir. Tente de novo.';
        }
      })
      .catch(function () {
        st.acting = false;
        $('lma-yes').disabled = $('lma-no').disabled = false;
        $('lma-yes').textContent = 'Aceitar pedido'; $('lma-no').textContent = 'Recusar';
        var r = $('lma-result'); r.hidden = false; r.className = 'lma-result err'; r.textContent = 'Sem conexão. Tente de novo.';
      });
  }
  $('lma-yes').addEventListener('click', function () { act('accept'); });
  $('lma-no').addEventListener('click', function () { act('reject'); });

  // ── Polling ───────────────────────────────────────────────────────────
  // 3s com a aba à vista; 6s em segundo plano (o navegador já espaça timers
  // de abas ocultas, e a notificação do sistema cobre o resto).
  var pollT = null;
  function poll() {
    fetch('/owner/disponivel_acceptance', { headers: { Accept: 'application/json' }, credentials: 'same-origin' })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (list) {
        if (!Array.isArray(list)) return;
        // Fechado aqui não volta: o servidor pode levar um poll pra refletir.
        st.queue = list.filter(function (q) { return !st.closed[q.id]; });
        document.dispatchEvent(new CustomEvent('loov:lm-pending', { detail: { count: st.queue.length } }));
        if (st.cur && !st.done && !st.acting && !list.some(function (q) { return q.id === st.cur.id; })) {
          // Sumiu do servidor sem decisão daqui: decidido em outro aparelho
          // (app ou outra aba) ou expirou.
          finish('no', 'Este pedido já foi respondido ou expirou.');
        }
        if (st.cur) renderQueue(); else next();
      })
      .catch(function () {})
      .then(function () { pollT = setTimeout(poll, document.hidden ? 6000 : 3000); });
  }

  window.LoovLM = {
    // O sino do painel abre o pedido pendente, se houver.
    open: function () { if (st.cur) return true; if (st.queue.length) { next(); return true; } return false; },
    pending: function () { return st.queue.length; }
  };

  maybeShowEnable();
  poll();
})();
</script>
