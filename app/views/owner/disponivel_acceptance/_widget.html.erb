<%#
  Alerta de pedido do Last Minute — em TODAS as páginas do dono e do
  atendente (renderizado pelo layout), não só no painel.

  O pedido vive 3 minutos. Antes este alerta só existia no dashboard: o dono
  que estava no Financeiro ou no Gerenciar não via nada, o tempo acabava e o
  cliente recebia uma recusa que ninguém decidiu. Agora:

  - Toma a tela, como o pedido de corrida do motorista no Uber: um pedido com
    prazo não pode ser um sino discreto num canto.
  - Anel de contagem regressiva (o comprimento é o tempo, coral → rosa nos
    últimos 30s), mesmo vocabulário do painel e do app.
  - Som da Loov ao chegar e a cada 10s enquanto ninguém decide.
  - Título da aba piscando e notificação do sistema quando a aba está em
    segundo plano — o dono pode estar em outra aba ou outro programa.

  Navegador só toca som depois de um clique na página e só mostra
  notificação com permissão. A pílula no canto pede as duas coisas; enquanto
  o som estiver bloqueado ela fica visível (e o alerta mostra "Som
  bloqueado"), pra o dono nunca achar que tem som quando não tem. O primeiro
  clique em qualquer lugar libera o som e, se houver pedido na tela, toca na
  hora.
%>
<div id="lm-alert" hidden>
  <div class="lma-ov"></div>
  <div class="lma-card" role="alertdialog" aria-modal="true" aria-labelledby="lma-svc" aria-describedby="lma-when">
    <%# Compacto, o mesmo cartão escuro do app (OwnerDisponivelScreen): o tempo
        com a barra que drena, o quê e quanto entra no balcão, quem e qual carro. %>
    <div class="lma-head">
      <span class="lma-eyebrow"><i class="lma-dot"></i><span id="lma-eyebrow-txt">Novo pedido · Last Minute</span></span>
      <span class="lma-headr"><span class="lma-queue" id="lma-queue" hidden></span><b class="lma-count" id="lma-count">3:00</b></span>
    </div>
    <div class="lma-track"><i id="lma-bar"></i></div>

    <div class="lma-main">
      <div class="lma-mtxt">
        <h3 class="lma-svc" id="lma-svc">—</h3>
        <div class="lma-when" id="lma-when">—</div>
      </div>
      <div class="lma-mval"><b id="lma-rest">—</b><span>No balcão</span></div>
    </div>

    <div class="lma-client">
      <span class="lma-av" id="lma-av">?</span>
      <span class="lma-name" id="lma-name">—</span>
      <span class="lma-car" id="lma-car"></span>
    </div>
    <div class="lma-vals">Serviço <span id="lma-total">—</span> · <span id="lma-pre">—</span> já no cartão</div>

    <button type="button" class="lma-mute" id="lma-mute" hidden>Som bloqueado pelo navegador · toque pra ouvir</button>

    <div class="lma-actions" id="lma-actions">
      <button type="button" class="lma-btn lma-no" id="lma-no">Recusar</button>
      <button type="button" class="lma-btn lma-yes" id="lma-yes">Aceitar pedido</button>
    </div>
    <div class="lma-result" id="lma-result" hidden></div>
  </div>
</div>

<button type="button" class="lma-enable" id="lma-enable" hidden>
  <span class="lma-enable-ic">🔔</span>
  <span><b id="lma-enable-t">Ativar alertas do Last Minute</b><small id="lma-enable-s">Som e aviso do navegador quando chegar pedido</small></span>
  <span class="lma-enable-x" id="lma-enable-x" aria-label="Agora não">×</span>
</button>

<style>
  #lm-alert[hidden], .lma-enable[hidden], #lm-alert [hidden] { display: none !important; }
  #lm-alert { position: fixed; inset: 0; z-index: 2000; display: flex; align-items: center; justify-content: center; padding: 16px; }
  .lma-ov { position: absolute; inset: 0; background: rgba(25,20,15,.62); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); animation: lmaFade .25s ease both; }
  .lma-card {
    position: relative; width: 100%; max-width: 400px; max-height: calc(100vh - 32px); overflow-y: auto;
    background: var(--ink, #28231c); color: var(--cream, #fafaf6); border-radius: 24px; padding: 18px;
    box-shadow: 0 30px 80px rgba(25,20,15,.5); animation: lmaIn .38s cubic-bezier(.16,1,.3,1) both;
    font-family: 'Inter', sans-serif;
  }
  @keyframes lmaFade { from { opacity: 0; } }
  @keyframes lmaIn { from { opacity: 0; transform: translateY(24px) scale(.96); } }
  .lma-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .lma-eyebrow { display: inline-flex; align-items: center; gap: 8px; font-family: 'JetBrains Mono', monospace; font-size: 10.5px; letter-spacing: 1.6px; text-transform: uppercase; color: var(--coral-500, #dd7852); }
  #lm-alert.urgent .lma-eyebrow { color: var(--rose-500, #d05a5a); }
  .lma-dot { width: 8px; height: 8px; border-radius: 50%; background: currentColor; animation: lmaPulse 1s ease-in-out infinite; }
  @keyframes lmaPulse { 50% { opacity: .3; transform: scale(.7); } }
  .lma-headr { display: inline-flex; align-items: center; gap: 10px; }
  .lma-queue { font-size: 11px; font-weight: 600; color: var(--cream, #fafaf6); background: rgba(250,250,246,.1); border-radius: 999px; padding: 3px 9px; }
  .lma-count { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 30px; line-height: 1; letter-spacing: -.8px; font-variant-numeric: tabular-nums; color: var(--cream, #fafaf6); }
  #lm-alert.urgent .lma-count { color: var(--rose-500, #d05a5a); }
  .lma-track { height: 4px; margin-top: 10px; border-radius: 2px; background: rgba(250,250,246,.12); overflow: hidden; }
  .lma-track i { display: block; height: 100%; width: 100%; border-radius: 2px; background: var(--coral-500, #dd7852); transition: width .95s linear, background .3s; }
  #lm-alert.urgent .lma-track i { background: var(--rose-500, #d05a5a); }

  .lma-main { display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; margin-top: 14px; }
  .lma-mtxt { min-width: 0; }
  .lma-svc { margin: 0 !important; font-family: 'Space Grotesk', sans-serif !important; font-weight: 600; font-size: 17px !important; letter-spacing: -.3px; color: var(--cream, #fafaf6) !important; line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lma-when { margin-top: 2px; font-size: 12.5px; color: var(--ash, #ada699); }
  .lma-mval { text-align: right; flex-shrink: 0; }
  .lma-mval b { display: block; font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 24px; line-height: 1.1; letter-spacing: -.6px; font-variant-numeric: tabular-nums; }
  .lma-mval span { font-family: 'JetBrains Mono', monospace; font-size: 9.5px; letter-spacing: 1px; text-transform: uppercase; color: var(--ash, #ada699); }

  .lma-client { display: flex; align-items: center; gap: 8px; margin-top: 12px; padding-top: 12px; border-top: 1px solid rgba(250,250,246,.1); min-width: 0; }
  .lma-av { width: 28px; height: 28px; border-radius: 50%; flex-shrink: 0; display: flex; align-items: center; justify-content: center; background: rgba(221,120,82,.2); color: #e8a48a; font-weight: 600; font-size: 12.5px; }
  .lma-name { font-weight: 600; font-size: 13.5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
  .lma-car { display: inline-flex; align-items: center; gap: 8px; color: var(--ash, #ada699); font-size: 12px; white-space: nowrap; }
  .lma-plate { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 1.4px; background: var(--cream, #fafaf6); color: var(--ink, #28231c); border-radius: 5px; padding: 1px 6px; }
  .lma-vals { margin-top: 6px; font-size: 11.5px; color: var(--ash, #ada699); }

  .lma-actions { display: grid; grid-template-columns: 1fr 2fr; gap: 8px; margin-top: 14px; }
  .lma-btn { height: 48px; border-radius: 999px; font-size: 14.5px; font-weight: 600; cursor: pointer; font-family: inherit; transition: background .15s, border-color .15s, opacity .15s, transform .15s; }
  .lma-yes { background: var(--coral-500, #dd7852) !important; color: var(--cream, #fafaf6) !important; border: none !important; }
  .lma-yes:hover:not(:disabled) { background: var(--coral-700, #9c4930) !important; transform: translateY(-1px); }
  .lma-no { background: transparent; color: var(--cream, #fafaf6); border: 1px solid rgba(250,250,246,.22); font-weight: 500; }
  .lma-no:hover:not(:disabled) { border-color: var(--rose-500, #d05a5a); color: #f0a3a3; }
  .lma-btn:disabled { opacity: .55; cursor: wait; transform: none; }
  .lma-result { margin-top: 14px; padding: 12px; border-radius: 14px; text-align: center; font-weight: 600; font-size: 13.5px; line-height: 1.4; }
  .lma-result.ok  { background: rgba(110,190,150,.16); color: #9fdcbb; }
  .lma-result.no  { background: rgba(250,250,246,.08); color: var(--stone, #e0dbd0); }
  .lma-result.err { background: rgba(208,90,90,.18); color: #f0a3a3; }

  .lma-mute { display: block; width: 100%; margin-top: 12px; padding: 9px 12px; border: 1px dashed rgba(221,120,82,.55); border-radius: 12px; background: rgba(221,120,82,.1); color: #e8a48a; font: 600 13px 'Inter', sans-serif; cursor: pointer; }

  .lma-enable {
    position: fixed; left: 16px; bottom: calc(16px + env(safe-area-inset-bottom)); z-index: 1500;
    display: flex; align-items: center; gap: 12px; max-width: calc(100vw - 32px);
    padding: 12px 14px 12px 12px; border-radius: 18px; cursor: pointer; text-align: left; font-family: 'Inter', sans-serif;
    background: var(--ink, #28231c); color: var(--cream, #fafaf6); border: none;
    box-shadow: 0 14px 34px rgba(25,20,15,.3); animation: lmaIn .4s cubic-bezier(.16,1,.3,1) both;
  }
  .lma-enable-ic { width: 34px; height: 34px; border-radius: 50%; background: rgba(255,255,255,.1); display: flex; align-items: center; justify-content: center; font-size: 16px; flex-shrink: 0; }
  .lma-enable b { display: block; font-size: 13.5px; }
  .lma-enable small { display: block; font-size: 11.5px; opacity: .65; margin-top: 2px; }
  .lma-enable-x { margin-left: 4px; width: 26px; height: 26px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 18px; opacity: .55; }
  .lma-enable-x:hover { opacity: 1; background: rgba(255,255,255,.1); }

  @media (max-width: 520px) {
    #lm-alert { align-items: flex-end; padding: 0; }
    .lma-card { max-width: none; border-radius: 28px 28px 0 0; padding-bottom: calc(20px + env(safe-area-inset-bottom)); animation-name: lmaUp; }
    @keyframes lmaUp { from { transform: translateY(40px); opacity: .5; } }
  }
  @media (prefers-reduced-motion: reduce) {
    .lma-card, .lma-ov, .lma-enable { animation: none; }
    .lma-dot { animation: none; }
  }
</style>

<script nonce="<%= csp_nonce %>">
(function () {
  if (window.LoovLM) return;
  var CSRF = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';
  var TTL = <%= Appointment::ACCEPTANCE_TTL.to_i %>;
  var $ = function (id) { return document.getElementById(id); };
  var root = $('lm-alert');

  var st = { queue: [], cur: null, deadline: 0, acting: false, done: false, tick: null, chime: null, flash: null, seenIds: {}, heard: {}, closed: {} };
  var baseTitle = document.title;

  function brl(v) { return 'R$ ' + (Number(v) || 0).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
  function secsLeft() { return Math.max(0, Math.round((st.deadline - Date.now()) / 1000)); }

  // ── Som (Web Audio: sem arquivo, sem custo de carga) ──────────────────
  var actx = null;
  function audioOn() { return !!actx && actx.state === 'running'; }
  function unlockAudio() {
    try {
      if (!actx) {
        actx = new (window.AudioContext || window.webkitAudioContext)();
        actx.onstatechange = audioChanged;
      }
      if (actx.state === 'suspended') actx.resume().then(audioChanged, function () {});
    } catch (e) {}
  }
  // Som acabou de liberar: some o aviso de bloqueado e, se tem pedido na
  // tela que ainda não foi ouvido, toca agora em vez de esperar os 10s.
  function audioChanged() {
    $('lma-mute').hidden = audioOn() || !st.cur || st.done;
    maybeShowEnable();
    if (audioOn() && st.cur && !st.done && !st.acting && !downOnAction && !st.heard[st.cur.id]) chime();
  }
  // Assinatura da Loov: arpejo de Dó maior que sobe (sol-dó-mi → SOL) e uma
  // resposta curta (mi → DÓ agudo), em timbre de marimba/sino. Alegre e
  // reconhecível, como o "pedido chegando" do Uber: o dono aprende que
  // aquele som é cliente na porta. [freq, início, duração, volume]
  var LOOV_TUNE = [
    [784, 0, .16, 1], [1046.5, .10, .16, 1], [1318.5, .20, .16, 1],
    [1568, .30, .9, 1], [1046.5, .30, .9, .45], [2093, .44, .5, .3],
    [1318.5, 1.20, .16, 1], [2093, 1.32, 1, 1], [1568, 1.32, 1, .45]
  ];
  function chime() {
    if (!audioOn()) return;
    if (st.cur) st.heard[st.cur.id] = true;
    var t = actx.currentTime + .02, out = actx.createDynamicsCompressor(), master = actx.createGain();
    master.gain.value = .5;
    master.connect(out); out.connect(actx.destination);
    LOOV_TUNE.forEach(function (n) {
      // Fundamental com decaimento longo + 2º e 3º harmônicos que somem
      // rápido: o "toc" brilhante da marimba no começo de cada nota.
      [[1, 1, n[2]], [2, .35, .15], [3, .12, .08]].forEach(function (h) {
        var o = actx.createOscillator(), g = actx.createGain(), s = t + n[1], v = .3 * n[3] * h[1];
        o.type = 'sine'; o.frequency.value = n[0] * h[0];
        g.gain.setValueAtTime(0, s);
        g.gain.linearRampToValueAtTime(v, s + .005);
        g.gain.exponentialRampToValueAtTime(.0001, s + h[2]);
        o.connect(g); g.connect(master);
        o.start(s); o.stop(s + h[2] + .05);
      });
    });
  }
  // O clique que libera o som pode ser o próprio Aceitar/Recusar: aí não
  // toca o som atrasado em cima da decisão.
  var downOnAction = false;
  ['pointerdown', 'keydown', 'touchstart'].forEach(function (ev) {
    window.addEventListener(ev, function (e) {
      downOnAction = !!(e.target && e.target.closest && e.target.closest('#lma-actions'));
      unlockAudio();
    }, { passive: true });
  });

  // ── Notificação do sistema (aba em segundo plano) ─────────────────────
  function systemNotify(a) {
    if (!('Notification' in window) || Notification.permission !== 'granted' || !document.hidden) return;
    try {
      var n = new Notification('Novo pedido Last Minute · ' + a.scheduled_at, {
        body: (a.client_name || 'Cliente') + ' quer ' + a.service_name + '. Você tem 3 min pra aceitar.',
        tag: 'lm-' + a.id, requireInteraction: true, icon: '/favicon.svg'
      });
      n.onclick = function () { window.focus(); n.close(); };
    } catch (e) {}
  }

  // ── Pílula "Ativar alertas" ───────────────────────────────────────────
  var DISMISS_KEY = 'loov_lm_alerts_dismissed';
  // Duas versões da pílula: pedir a permissão de notificação (dispensável
  // pra sempre no ×) ou só avisar que o som está bloqueado nesta página
  // (o × esconde até recarregar; qualquer clique já resolve).
  var muteClosed = false;
  function maybeShowEnable() {
    var dismissed = false; try { dismissed = localStorage.getItem(DISMISS_KEY) === '1'; } catch (e) {}
    var needNotif = !dismissed && ('Notification' in window) && Notification.permission === 'default';
    var needSound = !muteClosed && !audioOn();
    $('lma-enable-t').textContent = needNotif ? 'Ativar alertas do Last Minute' : 'Ativar som do Last Minute';
    $('lma-enable-s').textContent = needNotif ? 'Som e aviso do navegador quando chegar pedido' : 'O navegador só toca depois de um clique na página';
    $('lma-enable').hidden = !(needNotif || needSound);
  }
  $('lma-mute').addEventListener('click', function () { unlockAudio(); });
  $('lma-enable').addEventListener('click', function (e) {
    if (e.target.id === 'lma-enable-x') {
      if (('Notification' in window) && Notification.permission === 'default') {
        try { localStorage.setItem(DISMISS_KEY, '1'); } catch (x) {}
      }
      muteClosed = true;
      $('lma-enable').hidden = true; return;
    }
    unlockAudio(); chime();
    if ('Notification' in window) Notification.requestPermission().then(maybeShowEnable, maybeShowEnable);
    $('lma-enable').hidden = true;
  });

  // ── Exibição ──────────────────────────────────────────────────────────
  function fill(a) {
    $('lma-svc').textContent = a.service_name || 'Serviço';
    $('lma-when').textContent = 'Hoje às ' + a.scheduled_at + (a.car_wash_name ? ' · ' + a.car_wash_name : '');
    var name = a.client_name || 'Cliente';
    $('lma-av').textContent = name.trim().charAt(0).toUpperCase() || '?';
    $('lma-name').textContent = name;
    var car = $('lma-car'); car.innerHTML = '';
    if (a.vehicle_plate) { var p = document.createElement('span'); p.className = 'lma-plate'; p.textContent = a.vehicle_plate; car.appendChild(p); }
    if (a.vehicle_model) { var m = document.createElement('span'); m.textContent = a.vehicle_model; car.appendChild(m); }
    if (!a.vehicle_model && !a.vehicle_plate) car.textContent = 'Veículo não informado';
    var total = Number(a.service_price) || 0, pre = Number(a.prepayment) || 0;
    $('lma-total').textContent = brl(total);
    $('lma-pre').textContent = brl(pre);
    $('lma-rest').textContent = brl(a.on_arrival != null ? a.on_arrival : Math.max(0, total - pre));
  }

  function renderQueue() {
    var extra = st.queue.filter(function (q) { return !st.cur || q.id !== st.cur.id; }).length;
    $('lma-queue').hidden = extra < 1;
    $('lma-queue').textContent = '+' + extra + ' na fila';
  }

  function show(a) {
    st.cur = a; st.acting = false; st.done = false;
    st.deadline = Date.now() + Math.max(0, a.seconds_left || TTL) * 1000;
    fill(a);
    $('lma-actions').hidden = false; $('lma-result').hidden = true;
    $('lma-yes').disabled = $('lma-no').disabled = false;
    $('lma-yes').textContent = 'Aceitar pedido'; $('lma-no').textContent = 'Recusar';
    $('lma-eyebrow-txt').textContent = 'Novo pedido · Last Minute';
    root.hidden = false; renderQueue();
    document.documentElement.style.overflow = 'hidden';
    updateTick();
    clearInterval(st.tick); st.tick = setInterval(updateTick, 1000);

    if (!st.seenIds[a.id]) {
      st.seenIds[a.id] = true;
      unlockAudio(); chime(); systemNotify(a);
    }
    $('lma-mute').hidden = audioOn();
    clearInterval(st.chime); st.chime = setInterval(function () { if (!st.done && !st.acting) chime(); }, 10000);
    clearInterval(st.flash);
    var on = false;
    st.flash = setInterval(function () { on = !on; document.title = on ? '⚡ Novo pedido Last Minute' : baseTitle; }, 1000);
    setTimeout(function () { var y = $('lma-yes'); if (y) y.focus(); }, 60);
  }

  function updateTick() {
    var s = secsLeft();
    $('lma-count').textContent = Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0');
    $('lma-bar').style.width = Math.max(0, Math.min(100, s / TTL * 100)) + '%';
    var urgente = s <= 30 && !st.done;
    root.classList.toggle('urgent', urgente);
    if (!st.done) $('lma-eyebrow-txt').textContent = urgente ? 'Últimos segundos' : 'Novo pedido · Last Minute';
    if (s <= 0 && !st.done && !st.acting) finish('no', 'Tempo esgotado. O pedido foi liberado e o cliente não foi cobrado.');
  }

  function stopSignals() {
    clearInterval(st.chime); clearInterval(st.flash);
    document.title = baseTitle;
  }

  function hide() {
    clearInterval(st.tick); stopSignals();
    root.hidden = true; st.cur = null;
    document.documentElement.style.overflow = '';
    next();
  }

  function finish(kind, text) {
    st.done = true; stopSignals(); clearInterval(st.tick);
    root.classList.remove('urgent'); $('lma-mute').hidden = true;
    $('lma-actions').hidden = true;
    var r = $('lma-result'); r.hidden = false; r.className = 'lma-result ' + kind; r.textContent = text;
    var id = st.cur && st.cur.id;
    if (id) st.closed[id] = true;
    st.queue = st.queue.filter(function (q) { return q.id !== id; });
    setTimeout(hide, kind === 'ok' ? 2200 : 2600);
  }

  function next() {
    if (st.cur) return;
    var a = st.queue[0];
    if (a) show(a);
  }

  function act(action) {
    if (st.acting || st.done || !st.cur) return;
    st.acting = true;
    var btn = action === 'accept' ? $('lma-yes') : $('lma-no');
    $('lma-yes').disabled = $('lma-no').disabled = true;
    btn.textContent = action === 'accept' ? 'Aceitando…' : 'Recusando…';
    fetch('/owner/disponivel_acceptance/' + st.cur.id + '/' + action, {
      method: 'PATCH', credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json', 'X-CSRF-Token': CSRF }
    }).then(function (r) { return r.json().catch(function () { return {}; }).then(function (d) { return { ok: r.ok && d.ok, d: d }; }); })
      .then(function (x) {
        if (x.ok) {
          finish(action === 'accept' ? 'ok' : 'no', action === 'accept'
            ? 'Aceito. O cliente já foi avisado e está a caminho.'
            : 'Recusado. O cliente não é cobrado.');
          document.dispatchEvent(new CustomEvent('loov:lm-decided', { detail: { action: action } }));
        } else {
          st.acting = false;
          $('lma-yes').disabled = $('lma-no').disabled = false;
          $('lma-yes').textContent = 'Aceitar pedido'; $('lma-no').textContent = 'Recusar';
          var r = $('lma-result'); r.hidden = false; r.className = 'lma-result err';
          r.textContent = (x.d && x.d.error) || 'Não foi possível concluir. Tente de novo.';
        }
      })
      .catch(function () {
        st.acting = false;
        $('lma-yes').disabled = $('lma-no').disabled = false;
        $('lma-yes').textContent = 'Aceitar pedido'; $('lma-no').textContent = 'Recusar';
        var r = $('lma-result'); r.hidden = false; r.className = 'lma-result err'; r.textContent = 'Sem conexão. Tente de novo.';
      });
  }
  $('lma-yes').addEventListener('click', function () { act('accept'); });
  $('lma-no').addEventListener('click', function () { act('reject'); });

  // ── Polling ───────────────────────────────────────────────────────────
  // 3s com a aba à vista; 6s em segundo plano (o navegador já espaça timers
  // de abas ocultas, e a notificação do sistema cobre o resto).
  var pollT = null;
  function poll() {
    fetch('/owner/disponivel_acceptance', { headers: { Accept: 'application/json' }, credentials: 'same-origin' })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (list) {
        if (!Array.isArray(list)) return;
        // Fechado aqui não volta: o servidor pode levar um poll pra refletir.
        st.queue = list.filter(function (q) { return !st.closed[q.id]; });
        document.dispatchEvent(new CustomEvent('loov:lm-pending', { detail: { count: st.queue.length } }));
        if (st.cur && !st.done && !st.acting && !list.some(function (q) { return q.id === st.cur.id; })) {
          // Sumiu do servidor sem decisão daqui: decidido em outro aparelho
          // (app ou outra aba) ou expirou.
          finish('no', 'Este pedido já foi respondido ou expirou.');
        }
        if (st.cur) renderQueue(); else next();
      })
      .catch(function () {})
      .then(function () { pollT = setTimeout(poll, document.hidden ? 6000 : 3000); });
  }

  window.LoovLM = {
    // O sino do painel abre o pedido pendente, se houver.
    open: function () { if (st.cur) return true; if (st.queue.length) { next(); return true; } return false; },
    pending: function () { return st.queue.length; }
  };

  // Tenta abrir o som já no carregamento: alguns navegadores liberam sem
  // clique em sites que a pessoa usa muito (Chrome: Media Engagement).
  unlockAudio();
  maybeShowEnable();
  poll();
})();
</script>
