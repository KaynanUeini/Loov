<%#
  Alerta de pedido do Last Minute — em TODAS as páginas do dono e do
  atendente (renderizado pelo layout), não só no painel.

  O pedido vive 3 minutos. Antes este alerta só existia no dashboard: o dono
  que estava no Financeiro ou no Gerenciar não via nada, o tempo acabava e o
  cliente recebia uma recusa que ninguém decidiu. Agora:

  - Toma a tela inteira no modelo "Placar" (o mesmo do app): sobe de baixo
    em coral com um clarão, o relógio dos 3 minutos é o número gigante e
    "Fulano quer agora." leva a palavra de destaque. Aceitar é o botão
    enorme embaixo; recusar pede confirmação ali mesmo. Nos últimos 30 s o
    coral vira vermelho; a barra no topo é o tempo que sobra.
  - Som da Loov ao chegar e a cada 10s enquanto ninguém decide.
  - Título da aba piscando e notificação do sistema quando a aba está em
    segundo plano — o dono pode estar em outra aba ou outro programa.

  Navegador só toca som depois de um clique na página e só mostra
  notificação com permissão. A pílula no canto pede as duas coisas; enquanto
  o som estiver bloqueado ela fica visível (e o alerta mostra "Som
  bloqueado"), pra o dono nunca achar que tem som quando não tem. O primeiro
  clique em qualquer lugar libera o som e, se houver pedido na tela, toca na
  hora.
%>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@1,9..144,600,100,1&display=swap">
<div id="lm-alert" hidden>
  <div class="lma-card" role="alertdialog" aria-modal="true" aria-labelledby="lma-quer" aria-describedby="lma-svc">
    <div class="lma-track" aria-hidden="true"><i id="lma-bar"></i></div>
    <div class="lma-in">
      <div class="lma-head">
        <span class="lma-eyebrow"><span id="lma-eyebrow-txt">Novo pedido · Last Minute</span></span>
        <span class="lma-headr"><span class="lma-queue" id="lma-queue" hidden></span><span id="lma-hora">--:--</span> · HOJE</span>
      </div>
      <b class="lma-count" id="lma-count" role="timer" aria-label="Tempo para aceitar">3:00</b>
      <h3 class="lma-quer" id="lma-quer"><span id="lma-name">Cliente</span> quer <em>agora.</em></h3>
      <dl class="lma-rows">
        <div><dt>Carro</dt><dd id="lma-car"></dd></div>
        <div><dt>Serviço</dt><dd><span id="lma-svc">—</span> · <span id="lma-total">—</span></dd></div>
        <div><dt>Já no cartão</dt><dd id="lma-pre">—</dd></div>
      </dl>
      <span id="lma-when" hidden></span><span id="lma-av" hidden></span>
      <button type="button" class="lma-mute" id="lma-mute" hidden>Som bloqueado pelo navegador · clique pra ouvir</button>
    </div>
    <div class="lma-foot">
      <div class="lma-actions" id="lma-actions">
        <button type="button" class="lma-yes" id="lma-yes">
          <span class="lma-yes-t"><b id="lma-yes-txt">Aceitar</b><small><span id="lma-rest">—</span> no balcão</small></span>
          <span class="lma-yes-ic" aria-hidden="true"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"/></svg></span>
        </button>
        <button type="button" class="lma-no" id="lma-no">Recusar</button>
      </div>
      <div class="lma-confirm" id="lma-confirm" hidden>
        <p id="lma-confirm-txt">Recusar o pedido? O cliente é avisado na hora e não é cobrado. Não dá pra desfazer.</p>
        <div><button type="button" class="lma-c-back" id="lma-c-back">Voltar</button><button type="button" class="lma-c-ok" id="lma-c-ok">Recusar</button></div>
      </div>
      <div class="lma-result" id="lma-result" hidden><span class="lma-r-hora" id="lma-r-hora"></span><b id="lma-result-t"></b><span id="lma-result-s"></span></div>
    </div>
  </div>
</div>

<button type="button" class="lma-enable" id="lma-enable" hidden>
  <span class="lma-enable-ic">🔔</span>
  <span><b id="lma-enable-t">Ativar alertas do Last Minute</b><small id="lma-enable-s">Som e aviso do navegador quando chegar pedido</small></span>
  <span class="lma-enable-x" id="lma-enable-x" aria-label="Agora não">×</span>
</button>

<style>
  #lm-alert[hidden], .lma-enable[hidden], #lm-alert [hidden] { display: none !important; }
  /* Placar: a tela inteira em coral (vermelho nos últimos 30 s), tinta por cima. */
  /* As cores moram no cartão: no celular ele é a tela inteira; no
     computador, um cartão no centro sobre o fundo escurecido (como antes). */
  #lm-alert { position: fixed; inset: 0; z-index: 2000; display: flex; justify-content: center; color: #28231c; font-family: 'Inter', sans-serif; }
  .lma-card { position: relative; width: 100%; height: 100%; display: flex; flex-direction: column; overflow-x: hidden; overflow-y: auto; background: #dd7852; transition: background .4s, color .4s; }
  #lm-alert.urgent .lma-card { background: #c85050; }
  #lm-alert.is-ok .lma-card { background: #28231c; color: #fafaf6; }
  #lm-alert.is-no .lma-card { background: #fafaf6; }
  #lm-alert.entra .lma-card { animation: lmaSobe .55s cubic-bezier(.16,1,.3,1) both; }
  #lm-alert.entra .lma-card::after { content: ""; position: absolute; inset: 0; background: #fafaf6; pointer-events: none; animation: lmaClarao .5s .25s ease-out both; }
  @keyframes lmaSobe { from { transform: translateY(100%); } }
  @keyframes lmaClarao { from { opacity: .85; } to { opacity: 0; } }
  .lma-track { position: absolute; top: 0; left: 0; right: 0; height: 6px; z-index: 1; }
  .lma-track i { display: block; height: 100%; width: 100%; background: #28231c; transition: width .95s linear; }
  #lm-alert.is-ok .lma-track, #lm-alert.is-no .lma-track { display: none; }
  .lma-in { padding: max(48px, env(safe-area-inset-top, 0px)) 20px 0; }
  .lma-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 1.6px; text-transform: uppercase; }
  .lma-eyebrow { color: inherit !important; }
  .lma-headr { display: inline-flex; align-items: center; gap: 10px; }
  /* Decidido: sai o pedido, fica o horário grande e o resultado. */
  #lm-alert.is-ok .lma-in, #lm-alert.is-no .lma-in { display: none; }
  #lm-alert.is-ok .lma-foot, #lm-alert.is-no .lma-foot { margin: auto 0; }
  .lma-result .lma-r-hora { display: block; margin: 0 0 6px -4px; font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: clamp(110px, 28vw, 170px); line-height: .84; letter-spacing: -.06em; }
  .lma-queue { padding: 3px 8px; border-radius: 999px; background: #28231c; color: #fafaf6; letter-spacing: .6px; }
  .lma-count { display: block; margin: 14px 0 0 -6px; font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: clamp(120px, 30vw, 190px); line-height: .84; letter-spacing: -.06em; font-variant-numeric: tabular-nums; }
  .lma-quer { margin: 12px 0 0 !important; font-family: 'Space Grotesk', sans-serif !important; font-weight: 700; font-size: clamp(34px, 8vw, 46px) !important; line-height: 1 !important; letter-spacing: -.04em; color: inherit !important; }
  .lma-quer em { font-family: 'Fraunces', Georgia, serif; font-style: italic; font-weight: 600; font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 144; letter-spacing: -.02em; color: #fafaf6; }
  .lma-rows { margin: 22px 0 0; padding: 0; }
  .lma-rows > div { display: flex; justify-content: space-between; align-items: center; gap: 12px; border-top: 2px solid #28231c; padding: 12px 0; }
  .lma-rows > div:last-child { border-bottom: 2px solid #28231c; }
  .lma-rows dt { font-family: 'JetBrains Mono', monospace; font-size: 10.5px; letter-spacing: 1.4px; text-transform: uppercase; }
  .lma-rows dd { margin: 0; display: flex; align-items: center; gap: 8px; min-width: 0; font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 16px; text-align: right; }
  .lma-plate { font-family: 'JetBrains Mono', monospace; font-weight: 500; font-size: 12px; letter-spacing: 1.4px; background: #fafaf6; color: #28231c; border: 1.5px solid #28231c; border-radius: 5px; padding: 1px 7px; }
  .lma-mute { display: block; width: 100%; margin-top: 14px; padding: 10px 12px; border: 1.5px dashed #28231c; border-radius: 12px; background: transparent; color: #28231c; font: 600 13px 'Inter', sans-serif; cursor: pointer; }
  .lma-foot { margin-top: auto; padding-top: 24px; }
  .lma-yes { width: 100%; height: 128px; border: 0; background: #28231c; color: #fafaf6; display: flex; align-items: center; justify-content: space-between; padding: 0 22px; cursor: pointer; font-family: 'Space Grotesk', sans-serif; text-align: left; }
  .lma-yes-t b { display: block; font-weight: 700; font-size: 48px; line-height: .9; letter-spacing: -.04em; }
  .lma-yes-t small { display: block; margin-top: 8px; font-family: 'JetBrains Mono', monospace; font-size: 10.5px; letter-spacing: 1.4px; text-transform: uppercase; color: #e8a48a; }
  .lma-yes-ic { flex: 0 0 64px; height: 64px; border-radius: 50%; background: #dd7852; color: #28231c; display: flex; align-items: center; justify-content: center; transition: transform .2s; }
  .lma-yes:hover:not(:disabled) .lma-yes-ic { transform: scale(1.06); }
  .lma-no { width: 100%; height: 60px; border: 0; border-top: 1px solid #575148; background: #28231c; color: #ada699; font: 600 14px 'Inter', sans-serif; cursor: pointer; padding-bottom: env(safe-area-inset-bottom, 0px); }
  .lma-no:hover:not(:disabled) { color: #fafaf6; }
  .lma-yes:disabled, .lma-no:disabled { opacity: .6; cursor: wait; }
  .lma-confirm { background: #28231c; color: #fafaf6; padding: 20px 20px calc(24px + env(safe-area-inset-bottom, 0px)); }
  .lma-confirm p { margin: 0 0 14px; font-size: 14px; line-height: 20px; }
  .lma-confirm div { display: flex; gap: 10px; }
  .lma-confirm button { flex: 1; height: 52px; border-radius: 999px; font: 600 14px 'Inter', sans-serif; cursor: pointer; }
  .lma-c-back { border: 1.5px solid #fafaf6; background: transparent; color: #fafaf6; }
  .lma-c-ok { border: 0; background: #c85050; color: #fafaf6; }
  .lma-result { padding: 0 20px calc(40px + env(safe-area-inset-bottom, 0px)); }
  .lma-result b { display: block; font-family: 'Fraunces', Georgia, serif; font-style: italic; font-weight: 600; font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 144; font-size: 56px; line-height: 1; color: #dd7852; }
  .lma-result span { display: block; margin-top: 10px; font-size: 15px; line-height: 22px; }
  #lm-alert.is-ok .lma-result span { color: #e0dbd0; }
  #lm-alert.is-err .lma-result b { font-size: 28px; color: #28231c; }

  .lma-enable {
    position: fixed; left: 16px; bottom: calc(16px + env(safe-area-inset-bottom)); z-index: 1500;
    display: flex; align-items: center; gap: 12px; max-width: calc(100vw - 32px);
    padding: 12px 14px 12px 12px; border-radius: 18px; cursor: pointer; text-align: left; font-family: 'Inter', sans-serif;
    background: var(--ink, #28231c); color: var(--cream, #fafaf6); border: none;
    box-shadow: 0 14px 34px rgba(25,20,15,.3); animation: lmaIn .4s cubic-bezier(.16,1,.3,1) both;
  }
  .lma-enable-ic { width: 34px; height: 34px; border-radius: 50%; background: rgba(255,255,255,.1); display: flex; align-items: center; justify-content: center; font-size: 16px; flex-shrink: 0; }
  .lma-enable b { display: block; font-size: 13.5px; }
  .lma-enable small { display: block; font-size: 11.5px; opacity: .65; margin-top: 2px; }
  .lma-enable-x { margin-left: 4px; width: 26px; height: 26px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 18px; opacity: .55; }
  .lma-enable-x:hover { opacity: 1; background: rgba(255,255,255,.1); }

  /* Computador: o cartão no centro, sobre o fundo escurecido e desfocado. */
  @media (min-width: 768px) {
    #lm-alert { align-items: center; padding: 24px; background: rgba(25,20,15,.62); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); }
    #lm-alert.entra { animation: lmaFundo .3s ease both; }
    @keyframes lmaFundo { from { background: rgba(25,20,15,0); } }
    .lma-card { max-width: 420px; height: auto; max-height: calc(100vh - 48px); border-radius: 28px; box-shadow: 0 30px 80px rgba(25,20,15,.5); }
    #lm-alert.entra .lma-card { animation-name: lmaSobeCartao; }
    @keyframes lmaSobeCartao { from { opacity: 0; transform: translateY(60px) scale(.96); } }
    .lma-in { padding: 30px 24px 0; }
    .lma-count { font-size: 112px; margin-top: 10px; }
    .lma-quer { font-size: 34px !important; }
    .lma-foot { padding-top: 22px; }
    .lma-yes { height: 104px; }
    .lma-yes-t b { font-size: 40px; }
    .lma-result { padding: 28px 24px 30px; }
    .lma-result .lma-r-hora { font-size: 96px; }
    #lm-alert.is-ok .lma-foot, #lm-alert.is-no .lma-foot { margin: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .lma-enable { animation: none; }
    #lm-alert.entra, #lm-alert.entra .lma-card, #lm-alert.entra .lma-card::after { animation: none; }
  }
</style>

<script nonce="<%= csp_nonce %>">
(function () {
  if (window.LoovLM) return;
  var CSRF = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';
  var TTL = <%= Appointment::ACCEPTANCE_TTL.to_i %>;
  var $ = function (id) { return document.getElementById(id); };
  var root = $('lm-alert');

  var st = { queue: [], cur: null, deadline: 0, acting: false, done: false, tick: null, chime: null, flash: null, seenIds: {}, heard: {}, closed: {} };
  var baseTitle = document.title;

  function brl(v) { return 'R$ ' + (Number(v) || 0).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
  function secsLeft() { return Math.max(0, Math.round((st.deadline - Date.now()) / 1000)); }

  // ── Som (Web Audio: sem arquivo, sem custo de carga) ──────────────────
  var actx = null;
  function audioOn() { return !!actx && actx.state === 'running'; }
  function unlockAudio() {
    try {
      if (!actx) {
        actx = new (window.AudioContext || window.webkitAudioContext)();
        actx.onstatechange = audioChanged;
      }
      if (actx.state === 'suspended') actx.resume().then(audioChanged, function () {});
    } catch (e) {}
  }
  // Som acabou de liberar: some o aviso de bloqueado e, se tem pedido na
  // tela que ainda não foi ouvido, toca agora em vez de esperar os 10s.
  function audioChanged() {
    $('lma-mute').hidden = audioOn() || !st.cur || st.done;
    maybeShowEnable();
    if (audioOn() && st.cur && !st.done && !st.acting && !downOnAction && !st.heard[st.cur.id]) chime();
  }
  // Assinatura da Loov: arpejo de Dó maior que sobe (sol-dó-mi → SOL) e uma
  // resposta curta (mi → DÓ agudo), em timbre de marimba/sino. Alegre e
  // reconhecível, como o "pedido chegando" do Uber: o dono aprende que
  // aquele som é cliente na porta. [freq, início, duração, volume]
  var LOOV_TUNE = [
    [784, 0, .16, 1], [1046.5, .10, .16, 1], [1318.5, .20, .16, 1],
    [1568, .30, .9, 1], [1046.5, .30, .9, .45], [2093, .44, .5, .3],
    [1318.5, 1.20, .16, 1], [2093, 1.32, 1, 1], [1568, 1.32, 1, .45]
  ];
  function chime() {
    if (!audioOn()) return;
    if (st.cur) st.heard[st.cur.id] = true;
    var t = actx.currentTime + .02, out = actx.createDynamicsCompressor(), master = actx.createGain();
    master.gain.value = .5;
    master.connect(out); out.connect(actx.destination);
    LOOV_TUNE.forEach(function (n) {
      // Fundamental com decaimento longo + 2º e 3º harmônicos que somem
      // rápido: o "toc" brilhante da marimba no começo de cada nota.
      [[1, 1, n[2]], [2, .35, .15], [3, .12, .08]].forEach(function (h) {
        var o = actx.createOscillator(), g = actx.createGain(), s = t + n[1], v = .3 * n[3] * h[1];
        o.type = 'sine'; o.frequency.value = n[0] * h[0];
        g.gain.setValueAtTime(0, s);
        g.gain.linearRampToValueAtTime(v, s + .005);
        g.gain.exponentialRampToValueAtTime(.0001, s + h[2]);
        o.connect(g); g.connect(master);
        o.start(s); o.stop(s + h[2] + .05);
      });
    });
  }
  // O clique que libera o som pode ser o próprio Aceitar/Recusar: aí não
  // toca o som atrasado em cima da decisão.
  var downOnAction = false;
  ['pointerdown', 'keydown', 'touchstart'].forEach(function (ev) {
    window.addEventListener(ev, function (e) {
      downOnAction = !!(e.target && e.target.closest && e.target.closest('#lma-actions'));
      unlockAudio();
    }, { passive: true });
  });

  // ── Notificação do sistema (aba em segundo plano) ─────────────────────
  function systemNotify(a) {
    if (!('Notification' in window) || Notification.permission !== 'granted' || !document.hidden) return;
    try {
      var n = new Notification('Novo pedido Last Minute · ' + a.scheduled_at, {
        body: (a.client_name || 'Cliente') + ' quer ' + a.service_name + '. Você tem 3 min pra aceitar.',
        tag: 'lm-' + a.id, requireInteraction: true, icon: '/favicon.svg'
      });
      n.onclick = function () { window.focus(); n.close(); };
    } catch (e) {}
  }

  // ── Pílula "Ativar alertas" ───────────────────────────────────────────
  var DISMISS_KEY = 'loov_lm_alerts_dismissed';
  // Duas versões da pílula: pedir a permissão de notificação (dispensável
  // pra sempre no ×) ou só avisar que o som está bloqueado nesta página
  // (o × esconde até recarregar; qualquer clique já resolve).
  var muteClosed = false;
  function maybeShowEnable() {
    var dismissed = false; try { dismissed = localStorage.getItem(DISMISS_KEY) === '1'; } catch (e) {}
    var needNotif = !dismissed && ('Notification' in window) && Notification.permission === 'default';
    var needSound = !muteClosed && !audioOn();
    $('lma-enable-t').textContent = needNotif ? 'Ativar alertas do Last Minute' : 'Ativar som do Last Minute';
    $('lma-enable-s').textContent = needNotif ? 'Som e aviso do navegador quando chegar pedido' : 'O navegador só toca depois de um clique na página';
    $('lma-enable').hidden = !(needNotif || needSound);
  }
  $('lma-mute').addEventListener('click', function () { unlockAudio(); });
  $('lma-enable').addEventListener('click', function (e) {
    if (e.target.id === 'lma-enable-x') {
      if (('Notification' in window) && Notification.permission === 'default') {
        try { localStorage.setItem(DISMISS_KEY, '1'); } catch (x) {}
      }
      muteClosed = true;
      $('lma-enable').hidden = true; return;
    }
    unlockAudio(); chime();
    if ('Notification' in window) Notification.requestPermission().then(maybeShowEnable, maybeShowEnable);
    $('lma-enable').hidden = true;
  });

  // ── Exibição ──────────────────────────────────────────────────────────
  function fill(a) {
    $('lma-svc').textContent = a.service_name || 'Serviço';
    $('lma-when').textContent = 'Hoje às ' + a.scheduled_at + (a.car_wash_name ? ' · ' + a.car_wash_name : '');
    var name = a.client_name || 'Cliente';
    $('lma-av').textContent = name.trim().charAt(0).toUpperCase() || '?';
    $('lma-name').textContent = name.trim().split(/\s+/)[0];
    $('lma-hora').textContent = a.scheduled_at || '--:--';
    $('lma-r-hora').textContent = a.scheduled_at || '';
    $('lma-confirm-txt').textContent = 'Recusar o pedido de ' + name.trim().split(/\s+/)[0] + '? Ele é avisado na hora e não é cobrado. Não dá pra desfazer.';
    var car = $('lma-car'); car.innerHTML = '';
    if (a.vehicle_model) { var m = document.createElement('span'); m.textContent = a.vehicle_model; car.appendChild(m); }
    if (a.vehicle_plate) { var p = document.createElement('span'); p.className = 'lma-plate'; p.textContent = a.vehicle_plate; car.appendChild(p); }
    if (!a.vehicle_model && !a.vehicle_plate) car.textContent = 'não informado';
    var total = Number(a.service_price) || 0, pre = Number(a.prepayment) || 0;
    $('lma-total').textContent = brl(total);
    $('lma-pre').textContent = brl(pre);
    $('lma-rest').textContent = brl(a.on_arrival != null ? a.on_arrival : Math.max(0, total - pre));
  }

  function renderQueue() {
    var extra = st.queue.filter(function (q) { return !st.cur || q.id !== st.cur.id; }).length;
    $('lma-queue').hidden = extra < 1;
    $('lma-queue').textContent = '+' + extra + ' na fila';
  }

  function show(a) {
    st.cur = a; st.acting = false; st.done = false;
    st.deadline = Date.now() + Math.max(0, a.seconds_left || TTL) * 1000;
    fill(a);
    $('lma-actions').hidden = false; $('lma-result').hidden = true; $('lma-confirm').hidden = true;
    $('lma-yes').disabled = $('lma-no').disabled = false;
    $('lma-yes-txt').textContent = 'Aceitar'; $('lma-no').textContent = 'Recusar';
    $('lma-eyebrow-txt').textContent = 'Novo pedido · Last Minute';
    root.classList.remove('is-ok', 'is-no', 'is-err', 'entra');
    root.hidden = false; renderQueue();
    // Sobe de baixo com o clarão, como no app.
    void root.offsetWidth; root.classList.add('entra');
    document.documentElement.style.overflow = 'hidden';
    updateTick();
    clearInterval(st.tick); st.tick = setInterval(updateTick, 1000);

    if (!st.seenIds[a.id]) {
      st.seenIds[a.id] = true;
      unlockAudio(); chime(); systemNotify(a);
    }
    $('lma-mute').hidden = audioOn();
    clearInterval(st.chime); st.chime = setInterval(function () { if (!st.done && !st.acting) chime(); }, 10000);
    clearInterval(st.flash);
    var on = false;
    st.flash = setInterval(function () { on = !on; document.title = on ? '⚡ Novo pedido Last Minute' : baseTitle; }, 1000);
    setTimeout(function () { var y = $('lma-yes'); if (y) y.focus(); }, 60);
  }

  function updateTick() {
    var s = secsLeft();
    $('lma-count').textContent = Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0');
    $('lma-bar').style.width = Math.max(0, Math.min(100, s / TTL * 100)) + '%';
    var urgente = s <= 30 && !st.done;
    root.classList.toggle('urgent', urgente);
    if (!st.done) $('lma-eyebrow-txt').textContent = urgente ? 'Últimos segundos' : 'Novo pedido · Last Minute';
    if (s <= 0 && !st.done && !st.acting) finish('no', 'Passou.', 'Os 3 minutos acabaram. O cliente não foi cobrado e o horário voltou pra vitrine.');
  }

  function stopSignals() {
    clearInterval(st.chime); clearInterval(st.flash);
    document.title = baseTitle;
  }

  function hide() {
    clearInterval(st.tick); stopSignals();
    root.hidden = true; st.cur = null;
    document.documentElement.style.overflow = '';
    next();
  }

  function finish(kind, titulo, text) {
    st.done = true; stopSignals(); clearInterval(st.tick);
    root.classList.remove('urgent'); $('lma-mute').hidden = true;
    $('lma-actions').hidden = true; $('lma-confirm').hidden = true;
    root.classList.remove('is-err'); $('lma-r-hora').hidden = false;
    root.classList.add(kind === 'ok' ? 'is-ok' : 'is-no');
    $('lma-result').hidden = false; $('lma-result-t').textContent = titulo; $('lma-result-s').textContent = text;
    var id = st.cur && st.cur.id;
    if (id) st.closed[id] = true;
    st.queue = st.queue.filter(function (q) { return q.id !== id; });
    setTimeout(hide, kind === 'ok' ? 2600 : 3000);
  }

  function next() {
    if (st.cur) return;
    var a = st.queue[0];
    if (a) show(a);
  }

  function act(action) {
    if (st.acting || st.done || !st.cur) return;
    st.acting = true;
    $('lma-yes').disabled = $('lma-no').disabled = $('lma-c-ok').disabled = $('lma-c-back').disabled = true;
    if (action === 'accept') $('lma-yes-txt').textContent = 'Aceitando…'; else $('lma-c-ok').textContent = 'Recusando…';
    fetch('/owner/disponivel_acceptance/' + st.cur.id + '/' + action, {
      method: 'PATCH', credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json', 'X-CSRF-Token': CSRF }
    }).then(function (r) { return r.json().catch(function () { return {}; }).then(function (d) { return { ok: r.ok && d.ok, d: d }; }); })
      .then(function (x) {
        if (x.ok) {
          var nome = $('lma-name').textContent;
          if (action === 'accept') finish('ok', 'preenchido.', nome + ' foi avisado e está a caminho. O horário saiu da vitrine e entrou na agenda do dia.');
          else finish('no', 'Recusado.', nome + ' foi avisado e não é cobrado. O horário continua na vitrine.');
          document.dispatchEvent(new CustomEvent('loov:lm-decided', { detail: { action: action } }));
        } else {
          falhou((x.d && x.d.error) || 'Não foi possível concluir. Tente de novo.');
        }
      })
      .catch(function () {
        falhou('Sem conexão. Tente de novo.');
      });
  }
  function falhou(msg) {
    st.acting = false;
    $('lma-yes').disabled = $('lma-no').disabled = $('lma-c-ok').disabled = $('lma-c-back').disabled = false;
    $('lma-yes-txt').textContent = 'Aceitar'; $('lma-c-ok').textContent = 'Recusar';
    $('lma-confirm').hidden = true; $('lma-actions').hidden = false;
    root.classList.add('is-err');
    $('lma-result').hidden = false; $('lma-r-hora').hidden = true; $('lma-result-t').textContent = msg; $('lma-result-s').textContent = '';
  }
  $('lma-yes').addEventListener('click', function () { act('accept'); });
  // Recusar pede confirmação ali mesmo (não dá pra desfazer).
  $('lma-no').addEventListener('click', function () { if (st.acting || st.done) return; $('lma-actions').hidden = true; $('lma-confirm').hidden = false; $('lma-result').hidden = true; });
  $('lma-c-back').addEventListener('click', function () { $('lma-confirm').hidden = true; $('lma-actions').hidden = false; });
  $('lma-c-ok').addEventListener('click', function () { act('reject'); });

  // ── Polling ───────────────────────────────────────────────────────────
  // 3s com a aba à vista; 6s em segundo plano (o navegador já espaça timers
  // de abas ocultas, e a notificação do sistema cobre o resto).
  var pollT = null;
  function poll() {
    fetch('/owner/disponivel_acceptance', { headers: { Accept: 'application/json' }, credentials: 'same-origin' })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (list) {
        if (!Array.isArray(list)) return;
        // Fechado aqui não volta: o servidor pode levar um poll pra refletir.
        st.queue = list.filter(function (q) { return !st.closed[q.id]; });
        document.dispatchEvent(new CustomEvent('loov:lm-pending', { detail: { count: st.queue.length } }));
        if (st.cur && !st.done && !st.acting && !list.some(function (q) { return q.id === st.cur.id; })) {
          // Sumiu do servidor sem decisão daqui: decidido em outro aparelho
          // (app ou outra aba) ou expirou.
          finish('no', 'Respondido.', 'Este pedido já foi respondido em outro aparelho ou expirou.');
        }
        if (st.cur) renderQueue(); else next();
      })
      .catch(function () {})
      .then(function () { pollT = setTimeout(poll, document.hidden ? 6000 : 3000); });
  }

  window.LoovLM = {
    // O sino do painel abre o pedido pendente, se houver.
    open: function () { if (st.cur) return true; if (st.queue.length) { next(); return true; } return false; },
    pending: function () { return st.queue.length; }
  };

  // Tenta abrir o som já no carregamento: alguns navegadores liberam sem
  // clique em sites que a pessoa usa muito (Chrome: Media Engagement).
  unlockAudio();
  maybeShowEnable();
  poll();
})();
</script>
