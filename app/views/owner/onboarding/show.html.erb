<style>
  .wiz-progress { display: flex; align-items: center; margin-bottom: 40px; }
  .wiz-step { display: flex; flex-direction: column; align-items: center; gap: 6px; flex: 1; }
  .wiz-step-circle {
    width: 40px; height: 40px; border-radius: 50%;
    border: 1.5px solid var(--stone); background: var(--paper);
    display: flex; align-items: center; justify-content: center;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14px; font-weight: 700; color: var(--ash);
    transition: all 0.3s ease; z-index: 1;
  }
  .wiz-step.active .wiz-step-circle {
    border-color: var(--coral-500);
    background: var(--coral-50);
    color: var(--coral-700);
  }
  .wiz-step.done .wiz-step-circle {
    border-color: var(--coral-500);
    background: var(--coral-500);
    color: var(--cream);
  }
  .wiz-step-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px; text-transform: uppercase; letter-spacing: 1.4px;
    color: var(--ash); white-space: nowrap;
  }
  .wiz-step.active .wiz-step-label { color: var(--coral-500); }
  .wiz-step.done .wiz-step-label { color: var(--ink); }
  .wiz-connector { flex: 1; height: 1px; background: var(--stone); margin-top: -22px; transition: background 0.3s ease; }
  .wiz-connector.done { background: var(--coral-500); }

  .wiz-form-row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .wiz-form-row-cep { display: grid; grid-template-columns: 140px 1fr 100px; gap: 14px; }
  .wiz-form-row-uf { display: grid; grid-template-columns: 80px 1fr 1fr; gap: 14px; }

  .wiz-day-buttons {
    display: grid; grid-template-columns: repeat(7, 1fr);
    gap: 8px; margin-bottom: 20px;
  }
  .wiz-day-btn {
    background: var(--paper); border: 1px solid var(--stone);
    border-radius: 10px; padding: 10px 4px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; font-weight: 600; letter-spacing: 1.2px;
    color: var(--graphite); cursor: pointer;
    transition: all 0.2s ease;
    text-align: center; text-transform: uppercase; user-select: none;
  }
  .wiz-day-btn:hover { border-color: var(--coral-300); color: var(--ink); }
  .wiz-day-btn.active {
    background: var(--coral-50); border-color: var(--coral-500); color: var(--coral-700);
  }

  .wiz-day-time-rows { display: flex; flex-direction: column; gap: 10px; }
  .wiz-day-time-row {
    display: none; align-items: center; gap: 14px;
    background: var(--sand); border: 1px solid var(--stone);
    border-radius: 12px; padding: 14px 16px;
  }
  .wiz-day-time-row.visible { display: flex; }
  .wiz-day-time-label {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 16px; font-weight: 700;
    color: var(--coral-500); min-width: 36px;
  }
  .wiz-time-select-wrap { display: flex; align-items: center; gap: 8px; flex: 1; }
  .wiz-time-label-small {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px; color: var(--ash);
    text-transform: uppercase; letter-spacing: 1.2px;
    white-space: nowrap;
  }
  .wiz-time-select {
    background: var(--paper); border: 1px solid var(--stone);
    border-radius: 8px; padding: 6px 10px;
    font-family: 'Inter', sans-serif; font-size: 13px;
    color: var(--ink); outline: none; cursor: pointer;
    appearance: none; text-align: center;
    transition: border-color 0.2s;
  }
  .wiz-time-select:focus { border-color: var(--coral-500); }
  .wiz-time-sep {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 16px; color: var(--ash);
  }

  .wiz-service-card {
    background: var(--sand); border: 1px solid var(--stone);
    border-radius: 14px; padding: 18px;
    margin-bottom: 12px; position: relative;
  }
  .wiz-service-remove {
    position: absolute; top: 14px; right: 14px;
    background: none; border: none;
    color: var(--ash); cursor: pointer;
    font-size: 14px; transition: color 0.2s;
    padding: 0;
  }
  .wiz-service-remove:hover { color: var(--rose-500); }

  .wiz-btn-add {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    background: transparent; color: var(--coral-700);
    border: 1.5px dashed var(--coral-300); border-radius: 12px;
    padding: 12px 16px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; font-weight: 600; letter-spacing: 1.4px;
    cursor: pointer; transition: all 0.2s;
    width: 100%; margin-top: 12px;
    text-transform: uppercase;
  }
  .wiz-btn-add:hover { border-color: var(--coral-500); background: var(--coral-50); }

  .wiz-actions { display: flex; gap: 12px; margin-top: 22px; }
  .wiz-actions .loov-btn-primary { flex: 1; justify-content: center; }

  .wiz-cep-error { font-size: 12.5px; color: var(--rose-500); display: none; margin-top: 4px; font-weight: 500; }
  .wiz-days-hint { font-size: 13px; color: var(--ash); margin: 12px 0 0; }

  .wiz-success-icon {
    width: 80px; height: 80px; border-radius: 50%;
    background: var(--coral-50); border: 2px solid var(--coral-500);
    display: flex; align-items: center; justify-content: center;
    font-size: 28px; color: var(--coral-700);
    margin: 0 auto 22px;
  }

  .wiz-input-with-icon { position: relative; }
  .wiz-input-spinner {
    display: none; position: absolute; right: 14px;
    top: 50%; transform: translateY(-50%);
    color: var(--coral-500);
  }

  @media (max-width: 580px) {
    .wiz-day-buttons { grid-template-columns: repeat(4, 1fr); }
    .wiz-form-row-2, .wiz-form-row-cep, .wiz-form-row-uf { grid-template-columns: 1fr; }
    .wiz-day-time-row { flex-direction: column; align-items: flex-start; }
    .wiz-time-select-wrap { width: 100%; }
  }
</style>

<div class="loov-page loov-page--narrow">

  <div class="wiz-progress">
    <div class="wiz-step active" id="step-ind-1">
      <div class="wiz-step-circle" id="circle-1">1</div>
      <span class="wiz-step-label">Lava-rápido</span>
    </div>
    <div class="wiz-connector" id="conn-1"></div>
    <div class="wiz-step" id="step-ind-2">
      <div class="wiz-step-circle" id="circle-2">2</div>
      <span class="wiz-step-label">Horários</span>
    </div>
    <div class="wiz-connector" id="conn-2"></div>
    <div class="wiz-step" id="step-ind-3">
      <div class="wiz-step-circle" id="circle-3">3</div>
      <span class="wiz-step-label">Serviços</span>
    </div>
    <div class="wiz-connector" id="conn-3"></div>
    <div class="wiz-step" id="step-ind-4">
      <div class="wiz-step-circle" id="circle-4"><i class="fas fa-check" style="font-size:11px;"></i></div>
      <span class="wiz-step-label">Pronto!</span>
    </div>
  </div>

  <!-- PASSO 1 -->
  <div id="step-1">
    <div class="loov-hero">
      <div class="loov-eyebrow"><span class="dot"></span>Passo 1 de 3</div>
      <h1 class="loov-h1">Seu <span class="accent">lava-rápido</span>.</h1>
      <p class="loov-lead">Comece com as informações básicas do seu estabelecimento.</p>
    </div>

    <div class="loov-card">
      <div class="loov-field">
        <label class="loov-label">Nome do lava-rápido</label>
        <input type="text" class="loov-input" id="s1-name" placeholder="Ex.: Lava Car Premium">
      </div>

      <div class="wiz-form-row-cep">
        <div class="loov-field">
          <label class="loov-label">CEP</label>
          <div class="wiz-input-with-icon">
            <input type="text" class="loov-input" id="s1-cep" placeholder="00000-000" maxlength="9" style="padding-right: 40px;">
            <div id="cep-spinner" class="wiz-input-spinner">
              <i class="fas fa-circle-notch fa-spin"></i>
            </div>
          </div>
          <span class="wiz-cep-error" id="cep-error">CEP não encontrado.</span>
        </div>
        <div class="loov-field">
          <label class="loov-label">Logradouro</label>
          <input type="text" class="loov-input" id="s1-logradouro" placeholder="Rua / Avenida">
        </div>
        <div class="loov-field">
          <label class="loov-label">Número</label>
          <input type="text" class="loov-input" id="s1-numero" placeholder="123">
        </div>
      </div>

      <div class="wiz-form-row-2">
        <div class="loov-field">
          <label class="loov-label">Bairro</label>
          <input type="text" class="loov-input" id="s1-bairro" placeholder="Bairro">
        </div>
        <div class="loov-field">
          <label class="loov-label">Cidade</label>
          <input type="text" class="loov-input" id="s1-cidade" placeholder="Cidade">
        </div>
      </div>

      <div class="wiz-form-row-uf">
        <div class="loov-field">
          <label class="loov-label">UF</label>
          <input type="text" class="loov-input" id="s1-uf" placeholder="SP" maxlength="2">
        </div>
        <div class="loov-field">
          <label class="loov-label">Capacidade simultânea</label>
          <input type="number" class="loov-input" id="s1-capacity" placeholder="2" min="1" value="1">
          <span class="loov-help">Atendimentos ao mesmo tempo</span>
        </div>
        <div class="loov-field">
          <label class="loov-label">Nº de funcionários</label>
          <input type="number" class="loov-input" id="s1-employees" placeholder="3" min="1" value="1">
        </div>
      </div>
    </div>

    <div class="wiz-actions">
      <button class="loov-btn-primary" id="btn-next-1" onclick="saveStep1()">
        Continuar <i class="fas fa-arrow-right"></i>
      </button>
    </div>
  </div>

  <!-- PASSO 2 -->
  <div id="step-2" style="display:none;">
    <div class="loov-hero">
      <div class="loov-eyebrow"><span class="dot"></span>Passo 2 de 3</div>
      <h1 class="loov-h1">Horários de <span class="accent">funcionamento</span>.</h1>
      <p class="loov-lead">Selecione os dias e configure o horário de cada um.</p>
    </div>

    <div class="loov-card">
      <div class="wiz-day-buttons">
        <% [["Dom",0],["Seg",1],["Ter",2],["Qua",3],["Qui",4],["Sex",5],["Sáb",6]].each do |label, val| %>
        <div class="wiz-day-btn" data-day="<%= val %>" onclick="toggleDay(<%= val %>, '<%= label %>')"><%= label %></div>
        <% end %>
      </div>
      <div class="wiz-day-time-rows" id="day-time-rows"></div>
      <p class="wiz-days-hint" id="days-hint">Selecione pelo menos um dia.</p>
    </div>

    <div class="wiz-actions">
      <button class="loov-btn-secondary" onclick="goToStep(1)"><i class="fas fa-arrow-left"></i></button>
      <button class="loov-btn-primary" onclick="saveStep2()">
        Continuar <i class="fas fa-arrow-right"></i>
      </button>
    </div>
  </div>

  <!-- PASSO 3 -->
  <div id="step-3" style="display:none;">
    <div class="loov-hero">
      <div class="loov-eyebrow"><span class="dot"></span>Passo 3 de 3</div>
      <h1 class="loov-h1">Seus <span class="accent">serviços</span>.</h1>
      <p class="loov-lead">Adicione pelo menos um serviço com preço e duração.</p>
    </div>

    <div class="loov-card">
      <div id="services-list"></div>
      <button class="wiz-btn-add" onclick="addService()">
        <i class="fas fa-plus"></i> Adicionar serviço
      </button>
    </div>

    <div class="wiz-actions">
      <button class="loov-btn-secondary" onclick="goToStep(2)"><i class="fas fa-arrow-left"></i></button>
      <button class="loov-btn-primary" id="btn-finish" onclick="saveStep3()">
        Finalizar <i class="fas fa-check"></i>
      </button>
    </div>
  </div>

  <!-- PASSO 4 -->
  <div id="step-4" style="display:none;">
    <div class="loov-card loov-card--lg" style="text-align: center;">
      <div class="wiz-success-icon"><i class="fas fa-check"></i></div>
      <h2 class="loov-h2" style="margin-bottom: 10px;">Tudo <span style="color: var(--coral-500);">pronto!</span></h2>
      <p class="loov-lead" style="margin-bottom: 24px;">Seu lava-rápido está cadastrado e pronto para receber agendamentos.</p>
      <a href="/" class="loov-btn-primary">
        <i class="fas fa-gauge-high"></i> Ir para o painel
      </a>
    </div>
  </div>

</div>

<script>
  var carWashId = null;
  var activeDays = {};
  var serviceCount = 0;

  var ALL_CATEGORIES = [
    "Lavagem", "Polimento", "Higienização", "Cristalização", "Vitrificação",
    "Enceramento", "Hidratação de Couro", "Limpeza de Motor",
    "Revitalização de Plásticos", "Polimento de Faróis",
    "Impermeabilização", "Oxi-sanitização", "Outros"
  ];

  function toTitleCase(str) {
    return str.replace(/\w\S*/g, function(word) {
      return word.charAt(0).toUpperCase() + word.slice(1).toLowerCase();
    });
  }

  function applyTitleCase(input) {
    input.addEventListener('blur', function() {
      if (this.value.trim()) this.value = toTitleCase(this.value.trim());
    });
  }

  function goToStep(n) {
    [1,2,3,4].forEach(function(i) {
      document.getElementById('step-' + i).style.display = i === n ? 'block' : 'none';
    });
    updateProgress(n);
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function updateProgress(current) {
    [1,2,3,4].forEach(function(i) {
      var ind = document.getElementById('step-ind-' + i);
      var circle = document.getElementById('circle-' + i);
      ind.className = 'wiz-step';
      if (i < current) {
        ind.classList.add('done');
        circle.innerHTML = '<i class="fas fa-check" style="font-size:11px;"></i>';
      } else if (i === current) {
        ind.classList.add('active');
        if (i < 4) circle.innerHTML = i;
      } else {
        if (i < 4) circle.innerHTML = i;
      }
      if (i < 4) {
        var conn = document.getElementById('conn-' + i);
        conn.className = 'wiz-connector' + (i < current ? ' done' : '');
      }
    });
  }

  document.addEventListener('DOMContentLoaded', function() {
    var cep = document.getElementById('s1-cep');
    cep.addEventListener('input', function() {
      var raw = this.value.replace(/\D/g, '');
      this.value = raw.length > 5 ? raw.slice(0,5) + '-' + raw.slice(5,8) : raw;
    });
    cep.addEventListener('blur', function() {
      var raw = this.value.replace(/\D/g, '');
      if (raw.length !== 8) return;
      document.getElementById('cep-spinner').style.display = 'block';
      document.getElementById('cep-error').style.display = 'none';
      fetch('https://viacep.com.br/ws/' + raw + '/json/')
        .then(function(r) { return r.json(); })
        .then(function(data) {
          document.getElementById('cep-spinner').style.display = 'none';
          if (data.erro) { document.getElementById('cep-error').style.display = 'block'; return; }
          document.getElementById('s1-logradouro').value = data.logradouro || '';
          document.getElementById('s1-bairro').value = data.bairro || '';
          document.getElementById('s1-cidade').value = data.localidade || '';
          document.getElementById('s1-uf').value = data.uf || '';
          document.getElementById('s1-numero').focus();
        })
        .catch(function() {
          document.getElementById('cep-spinner').style.display = 'none';
          document.getElementById('cep-error').style.display = 'block';
        });
    });

    addService();
  });

  function saveStep1() {
    var name = document.getElementById('s1-name').value.trim();
    var logradouro = document.getElementById('s1-logradouro').value.trim();
    var cidade = document.getElementById('s1-cidade').value.trim();
    if (!name || !logradouro || !cidade) {
      alert('Preencha nome, logradouro e cidade para continuar.');
      return;
    }
    var btn = document.getElementById('btn-next-1');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> Salvando...';
    fetch('<%= owner_onboarding_car_wash_path %>', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content },
      body: JSON.stringify({ car_wash: {
        name: name,
        cep: document.getElementById('s1-cep').value.trim(),
        logradouro: logradouro,
        numero: document.getElementById('s1-numero').value.trim(),
        bairro: document.getElementById('s1-bairro').value.trim(),
        cidade: cidade,
        uf: document.getElementById('s1-uf').value.trim(),
        capacity_per_slot: document.getElementById('s1-capacity').value || 1,
        num_employees: document.getElementById('s1-employees').value || 1
      }})
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      btn.disabled = false;
      btn.innerHTML = 'Continuar <i class="fas fa-arrow-right"></i>';
      if (data.success) { carWashId = data.car_wash_id; goToStep(2); }
      else { alert('Erro: ' + (data.errors || []).join(', ')); }
    })
    .catch(function() {
      btn.disabled = false;
      btn.innerHTML = 'Continuar <i class="fas fa-arrow-right"></i>';
      alert('Erro ao salvar. Tente novamente.');
    });
  }

  function buildHourOptions(sel) {
    var o = '';
    for (var h = 0; h < 24; h++) { var v = (h<10?'0':'')+h; o += '<option value="'+v+'"'+(sel===v?' selected':'')+'>'+v+'</option>'; }
    return o;
  }
  function buildMinOptions(sel) {
    var o = '';
    ['00','15','30','45'].forEach(function(m) { o += '<option value="'+m+'"'+(sel===m?' selected':'')+'>'+m+'</option>'; });
    return o;
  }

  function toggleDay(day, label) {
    var btn = document.querySelector('.wiz-day-btn[data-day="'+day+'"]');
    if (activeDays[day]) {
      delete activeDays[day];
      btn.classList.remove('active');
      var row = document.getElementById('day-row-'+day);
      if (row) row.remove();
    } else {
      activeDays[day] = { oh: '08', om: '00', ch: '18', cm: '00' };
      btn.classList.add('active');
      var html = '<div class="wiz-day-time-row visible" id="day-row-'+day+'">'+
        '<div class="wiz-day-time-label">'+label+'</div>'+
        '<div class="wiz-time-select-wrap"><span class="wiz-time-label-small">Abre</span>'+
        '<select class="wiz-time-select" onchange="updateTime('+day+',\'oh\',this.value)">'+buildHourOptions('08')+'</select>'+
        '<span class="wiz-time-sep">:</span>'+
        '<select class="wiz-time-select" onchange="updateTime('+day+',\'om\',this.value)">'+buildMinOptions('00')+'</select></div>'+
        '<div class="wiz-time-select-wrap"><span class="wiz-time-label-small">Fecha</span>'+
        '<select class="wiz-time-select" onchange="updateTime('+day+',\'ch\',this.value)">'+buildHourOptions('18')+'</select>'+
        '<span class="wiz-time-sep">:</span>'+
        '<select class="wiz-time-select" onchange="updateTime('+day+',\'cm\',this.value)">'+buildMinOptions('00')+'</select></div>'+
        '</div>';
      var rows = document.getElementById('day-time-rows');
      var existing = rows.querySelectorAll('.wiz-day-time-row');
      var inserted = false;
      for (var i = 0; i < existing.length; i++) {
        if (day < parseInt(existing[i].id.replace('day-row-',''))) {
          var tmp = document.createElement('div'); tmp.innerHTML = html;
          rows.insertBefore(tmp.firstElementChild, existing[i]);
          inserted = true; break;
        }
      }
      if (!inserted) rows.insertAdjacentHTML('beforeend', html);
    }
    document.getElementById('days-hint').style.display = Object.keys(activeDays).length > 0 ? 'none' : 'block';
  }

  function updateTime(day, key, value) {
    if (activeDays[day]) activeDays[day][key] = value;
  }

  function saveStep2() {
    if (Object.keys(activeDays).length === 0) {
      alert('Selecione pelo menos um dia de funcionamento.');
      return;
    }
    var hoursData = {};
    Object.keys(activeDays).forEach(function(day) {
      var d = activeDays[day];
      hoursData[day] = { enabled: '1', opens_at: d.oh+':'+d.om, closes_at: d.ch+':'+d.cm };
    });
    fetch('<%= owner_onboarding_hours_path %>', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content },
      body: JSON.stringify({ car_wash_id: carWashId, hours: hoursData })
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (data.success) { goToStep(3); }
      else { alert('Erro: ' + (data.errors || []).join(', ')); }
    });
  }

  function addService() {
    var idx = serviceCount++;
    var categoryOptions = ALL_CATEGORIES.map(function(c) {
      return '<option value="'+c+'">'+c+'</option>';
    }).join('');

    var html = '<div class="wiz-service-card" id="service-'+idx+'">'+
      '<button class="wiz-service-remove" onclick="removeService('+idx+')" title="Remover"><i class="fas fa-times"></i></button>'+
      '<div class="wiz-form-row-2" style="margin-bottom: 12px;">'+
        '<div class="loov-field" style="margin-bottom: 0;">'+
          '<label class="loov-label">Categoria</label>'+
          '<select class="loov-input service-category" data-idx="'+idx+'">'+
            '<option value="">Selecione</option>'+categoryOptions+
          '</select>'+
        '</div>'+
        '<div class="loov-field" style="margin-bottom: 0;">'+
          '<label class="loov-label">Serviço</label>'+
          '<input type="text" class="loov-input service-title" placeholder="Ex.: Lavagem Simples" data-idx="'+idx+'">'+
        '</div>'+
      '</div>'+
      '<div class="wiz-form-row-2">'+
        '<div class="loov-field" style="margin-bottom: 0;">'+
          '<label class="loov-label">Preço (R$)</label>'+
          '<input type="number" step="0.01" min="0" class="loov-input service-price" placeholder="0,00" data-idx="'+idx+'">'+
        '</div>'+
        '<div class="loov-field" style="margin-bottom: 0;">'+
          '<label class="loov-label">Duração (min)</label>'+
          '<input type="number" min="1" class="loov-input service-duration" placeholder="60" data-idx="'+idx+'">'+
        '</div>'+
      '</div>'+
      '</div>';

    document.getElementById('services-list').insertAdjacentHTML('beforeend', html);

    var titleInput = document.querySelector('#service-'+idx+' .service-title');
    if (titleInput) applyTitleCase(titleInput);
  }

  function removeService(idx) {
    var el = document.getElementById('service-'+idx);
    if (el) el.remove();
  }

  function saveStep3() {
    var cards = document.querySelectorAll('.wiz-service-card');
    var services = {};
    var valid = true;

    cards.forEach(function(card) {
      var idx = card.id.replace('service-', '');
      var category = card.querySelector('.service-category').value;
      var title = card.querySelector('.service-title').value.trim();
      var price = card.querySelector('.service-price').value;
      var duration = card.querySelector('.service-duration').value;
      if (!category || !title || !price || !duration) { valid = false; return; }
      services[idx] = { title: toTitleCase(title), category: category, price: price, duration: duration };
    });

    if (!valid || Object.keys(services).length === 0) {
      alert('Preencha categoria, serviço, preço e duração de todos os itens.');
      return;
    }

    var btn = document.getElementById('btn-finish');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> Salvando...';

    fetch('<%= owner_onboarding_services_path %>', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content },
      body: JSON.stringify({ car_wash_id: carWashId, services: services })
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      btn.disabled = false;
      btn.innerHTML = 'Finalizar <i class="fas fa-check"></i>';
      if (data.success) { goToStep(4); }
      else { alert('Erro: ' + (data.errors || []).join(', ')); }
    });
  }
</script>
