          <% end %>
        </tbody>
      </table>
    </div>
    <% if @transactions.count > 5 %>
    <button class="btn-ver-mais" id="btn-ver-mais-txn" onclick="verMais('txn')">
      <i class="fas fa-chevron-down"></i> Ver mais <%= @transactions.count - 5 %> transações
    </button>
    <% end %>
    <% else %>
    <div style="padding: 28px; text-align: center; color: var(--graphite); font-size: 14px;">Nenhuma transação encontrada.</div>
    <% end %>
  </div>

  <!-- TABELA AGRUPADA -->
  <div class="fin-section">
    <div class="fin-section-header">
      <div class="card-title" style="margin-bottom: 0;">
        <i class="fas fa-table-list"></i>
        <% if @is_all_filter %>Vendas por ano<% elsif @is_year_filter || @is_custom_filter %>Vendas por mês<% else %>Vendas por dia<% end %>
      </div>
    </div>
    <table class="fin-table">
      <thead>
        <tr>
          <th><% if @is_all_filter %>Ano<% elsif @is_year_filter || @is_custom_filter %>Mês<% else %>Data<% end %></th>
          <th>Atendimentos</th><th>Faturamento</th>
        </tr>
      </thead>
      <tbody>
        <% if @is_all_filter %>
          <% @sales_by_year.each do |e| %><tr><td><%= e.period_start.strftime("%Y") %></td><td><%= e.appointment_count %></td><td class="td-value">R$ <%= number_with_precision(e.total_value, precision: 2) %></td></tr><% end %>
        <% elsif @is_year_filter || @is_custom_filter %>
          <% @sales_by_month.each do |e| %><tr><td><%= I18n.l(e.period_start, format: "%B/%Y", locale: :"pt-BR") rescue e.period_start.strftime("%m/%Y") %></td><td><%= e.appointment_count %></td><td class="td-value">R$ <%= number_with_precision(e.total_value, precision: 2) %></td></tr><% end %>
        <% else %>
