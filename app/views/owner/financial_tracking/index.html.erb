<% content_for :page_title, "IA insights" %>
<%#
  IA insights — porte da OwnerAiInsightsScreen do app (mesmos endpoints:
  /owner/ai_insights, /status, /input). A tela responde uma pergunta: o que
  eu faço esta semana. Por isso a ordem é a do app — a decisão primeiro, em
  manchete sobre a única superfície escura; o porquê logo abaixo, em texto
  corrido; o panorama das áreas (quantas subindo, estáveis, caindo) antes do
  detalhe; e a configuração da PRÓXIMA análise por último, que é onde
  configuração pertence. A versão anterior abria com um formulário e cartões
  que viravam, e o dono passava por duas coisas administrativas antes de
  achar a única frase que dizia o que fazer.

  Tela grande (referência wiemer.store + Apple): a leitura ocupa a coluna
  principal com largura de texto confortável, e "Orientar a próxima análise"
  vira uma coluna lateral fixa — fica à mão sem interromper a leitura.
%>
<script src="/vendor/feather-4.29.2.min.js"></script>

<style>
  .ia { background: var(--cream); color: var(--ink); min-height: 100vh; }
  .ia *, .ia *::before, .ia *::after { box-sizing: border-box; }
  .ia [hidden] { display: none !important; }
  .ia button { font-family: inherit; cursor: pointer; }
  .ia svg.feather { display: block; flex-shrink: 0; }
  .ia-wrap { max-width: 1180px; margin: 0 auto; padding: 60px 20px 96px; }

  /* Cabeçalho */
  .ia-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; margin-bottom: 28px; }
  .ia-refresh { display: inline-flex; align-items: center; gap: 8px; padding: 11px 18px; border: 1px solid var(--stone); border-radius: 100px; background: var(--paper); color: var(--ink); font-size: 14px; font-weight: 600; transition: background .15s, border-color .15s; white-space: nowrap; }
  .ia-refresh:hover { background: var(--sand); }

  .ia-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 28px; }

  /* Avisos */
  .ia-banner { display: flex; gap: 12px; padding: 16px 18px; border-radius: 16px; margin-bottom: 20px; font-size: 14px; line-height: 1.5; }
  .ia-banner b { display: block; margin-bottom: 2px; }
  .ia-banner a { display: inline-block; margin-top: 8px; font-weight: 600; color: inherit; text-decoration: underline; }
  .ia-banner--rose { background: #fdecec; border: 1px solid #f5cccc; color: #8a2f2f; }
  .ia-banner--err { background: #fdecec; border: 1px solid #f5cccc; color: #8a2f2f; }

  /* Decisão — a única superfície escura */
  .ia-decision { position: relative; overflow: hidden; background: var(--ink); color: var(--cream); border-radius: 28px; padding: 28px 26px 22px; }
  .ia-dec-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px; }
  .ia-dec-eyebrow { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 2px; color: var(--coral-300, #f0a888); }
  .ia-fresh { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 100px; background: rgba(93,195,159,.16); color: #8fe0c2; font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 1.4px; }
  .ia-fresh i { width: 6px; height: 6px; border-radius: 50%; background: #5dc39f; }
  .ia-dec-text { position: relative; margin: 0; font-family: 'Space Grotesk', sans-serif; font-weight: 500; letter-spacing: -.3px; color: var(--cream); }
  .ia-dec-text strong { color: #fff; font-weight: 700; }
  .ia-dec-text.s1 { font-size: 27px; line-height: 1.32; }
  .ia-dec-text.s2 { font-size: 21px; line-height: 1.45; }
  .ia-dec-text.s3 { font-size: 17px; line-height: 1.6; }
  .ia-alert { display: flex; gap: 10px; margin-top: 18px; padding: 14px 16px; border-radius: 16px; background: rgba(214,177,74,.10); border: 1px solid rgba(214,177,74,.28); color: var(--amber-500, #d6b14a); }
  .ia-alert b { display: block; font-size: 12px; letter-spacing: .4px; margin-bottom: 3px; }
  .ia-alert p { margin: 0; color: var(--sand); font-size: 14px; line-height: 1.5; }
  .ia-alert p strong { color: #fff; }
  .ia-dec-rule { height: 1px; background: rgba(250,250,246,.12); margin: 20px 0 12px; }
  .ia-dec-meta { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: .6px; color: rgba(250,250,246,.55); }

  /* Por quê */
  .ia-why { padding: 4px 4px 0; }
  .ia-why-eyebrow, .ia-label { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 1.6px; color: var(--ash); text-transform: uppercase; }
  .ia-why p { margin: 10px 0 0; font-size: 16px; line-height: 1.65; color: var(--graphite); max-width: 68ch; }
  .ia-why p strong { color: var(--ink); }

  /* Áreas */
  .ia-block-head { display: flex; align-items: baseline; justify-content: space-between; margin: 6px 4px 12px; }
  .ia-block-title { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 20px; letter-spacing: -.4px; }
  .ia-block-hint { font-size: 12px; color: var(--ash); }
  .ia-pulse { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 14px; }
  .ia-pulse-item { display: flex; align-items: baseline; gap: 8px; padding: 12px 16px; border-radius: 16px; background: var(--paper); border: 1px solid var(--stone); }
  .ia-pulse-item b { font-family: 'Space Grotesk', sans-serif; font-size: 26px; line-height: 1; letter-spacing: -.5px; }
  .ia-pulse-item span { font-size: 13px; color: var(--graphite); }
  .ia-dims { display: grid; gap: 10px; }
  .ia-dim { background: var(--paper); border: 1px solid var(--stone); border-radius: 18px; overflow: hidden; transition: border-color .15s, box-shadow .15s; }
  .ia-dim.is-open { border-color: var(--coral-100); box-shadow: 0 6px 24px rgba(40,30,20,.06); }
  .ia-dim-head { display: flex; align-items: center; gap: 12px; width: 100%; padding: 16px 18px; border: 0; background: transparent; text-align: left; color: var(--ink); }
  .ia-dim-head:hover { background: rgba(0,0,0,.015); }
  .ia-dim-arrow { width: 30px; height: 30px; border-radius: 10px; display: flex; align-items: center; justify-content: center; }
  .ia-dim-name { flex: 1; font-size: 15px; font-weight: 600; }
  .ia-dim-status { font-family: 'JetBrains Mono', monospace; font-size: 10.5px; letter-spacing: 1.2px; }
  .ia-dim-chev { color: var(--ash); transition: transform .2s; }
  .ia-dim.is-open .ia-dim-chev { transform: rotate(180deg); }
  .ia-dim-body { padding: 0 18px 18px 60px; }
  .ia-dim-body p { margin: 0; font-size: 15px; line-height: 1.65; color: var(--graphite); }
  .ia-dim-body p strong { color: var(--ink); }

  /* Estados (gerando, vazio, carregando) */
  .ia-state { text-align: center; padding: 48px 24px; border-radius: 28px; background: var(--paper); border: 1px solid var(--stone); }
  .ia-state-ic { width: 64px; height: 64px; margin: 0 auto 16px; border-radius: 50%; background: var(--coral-50); border: 1px solid var(--coral-100); color: var(--coral-500); display: flex; align-items: center; justify-content: center; }
  .ia-state-ic.is-pulse { animation: ia-pulse 1.8s ease-in-out infinite; }
  @keyframes ia-pulse { 0%, 100% { opacity: .45; transform: scale(.96); } 50% { opacity: 1; transform: scale(1); } }
  .ia-state h2 { margin: 0; font-family: 'Space Grotesk', sans-serif; font-size: 22px; letter-spacing: -.4px; }
  .ia-state p { margin: 10px auto 0; max-width: 440px; font-size: 15px; line-height: 1.55; color: var(--graphite); }
  .ia-primary { display: inline-flex; align-items: center; justify-content: center; gap: 8px; margin-top: 22px; padding: 14px 24px; border: 0; border-radius: 100px; background: var(--coral-500); color: var(--cream); font-size: 15px; font-weight: 600; transition: transform .15s, background .15s; }
  .ia-primary:hover { background: var(--coral-700); }
  .ia-primary:active { transform: scale(.98); }
  .ia-primary[disabled] { opacity: .55; cursor: default; }
  .ia-skel { border-radius: 28px; height: 220px; background: linear-gradient(90deg, var(--sand) 25%, var(--paper) 50%, var(--sand) 75%); background-size: 200% 100%; animation: ia-shimmer 1.4s infinite; }
  .ia-skel.sm { height: 64px; border-radius: 18px; margin-top: 12px; }
  @keyframes ia-shimmer { from { background-position: 200% 0; } to { background-position: -200% 0; } }

  /* Orientar a próxima análise */
  .ia-foco { background: var(--paper); border: 1px solid var(--stone); border-radius: 22px; padding: 18px; }
  .ia-foco-head { display: flex; align-items: center; gap: 10px; color: var(--graphite); }
  .ia-foco-head b { flex: 1; color: var(--ink); font-size: 15px; }
  .ia-saved { display: inline-flex; align-items: center; gap: 4px; padding: 3px 9px; border-radius: 100px; background: var(--sand); font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 1px; color: var(--graphite); }
  .ia-foco p { margin: 12px 0; font-size: 13.5px; line-height: 1.55; color: var(--graphite); }
  .ia-foco textarea { width: 100%; min-height: 96px; padding: 12px 14px; border: 1px solid var(--stone); border-radius: 14px; background: var(--cream); color: var(--ink); font: 14px/1.5 Inter, sans-serif; resize: vertical; }
  .ia-foco textarea:focus { outline: none; border-color: var(--coral-500); }
  .ia-foco-meta { display: flex; align-items: center; justify-content: space-between; margin-top: 8px; }
  .ia-count { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--ash); }
  .ia-ghost { padding: 8px 14px; border: 1px solid var(--stone); border-radius: 100px; background: transparent; color: var(--graphite); font-size: 13px; font-weight: 600; }
  .ia-ghost:hover { background: var(--sand); }
  .ia-foco .ia-primary { width: 100%; margin-top: 16px; }
  .ia-howto { margin-top: 14px; padding: 0 4px; font-size: 12.5px; line-height: 1.55; color: var(--ash); }

  @media (min-width: 980px) {
    .ia-wrap { padding: 60px 32px 112px; }
    .ia-grid { grid-template-columns: minmax(0, 1fr) 340px; gap: 40px; align-items: start; }
    .ia-side { position: sticky; top: 96px; }
    /* No computador o botão já está na coluna lateral, sempre à vista. */
    .ia-refresh { display: none; }
    .ia-decision { padding: 40px 40px 28px; }
    .ia-dec-text.s1 { font-size: 34px; }
    .ia-dec-text.s2 { font-size: 25px; }
    .ia-dec-text.s3 { font-size: 19px; }
    .ia-dims { grid-template-columns: 1fr 1fr; align-items: start; }
  }
  @media (max-width: 560px) {
    .ia-head { flex-direction: column; align-items: flex-start; }
    .ia-dim-body { padding-left: 18px; }
  }
</style>

<div class="ia">
  <div class="ia-wrap">
    <div class="ia-head">
      <div>
        <%= render "shared/page_head", back_href: root_path, back_id: "ia-back", eyebrow: "Análise", title: "IA insights",
                   lead: "O que fazer esta semana no seu lava-rápido, a partir das vendas, serviços, clientes e agenda." %>
      </div>
      <button type="button" class="ia-refresh" id="ia-refresh" hidden><i data-feather="refresh-cw" style="width:15px;height:15px"></i>Gerar nova análise</button>
    </div>

    <div class="ia-banner ia-banner--rose" id="ia-unresolved" hidden>
      <i data-feather="alert-triangle" style="width:18px;height:18px"></i>
      <div><b>Resolva as pendências antes de gerar a análise</b><span id="ia-unresolved-text"></span><br><a href="/">Ir pro painel →</a></div>
    </div>
    <div class="ia-banner ia-banner--err" id="ia-error" hidden>
      <i data-feather="alert-circle" style="width:18px;height:18px"></i>
      <div><b>Não deu certo</b><span id="ia-error-text"></span></div>
    </div>

    <div class="ia-grid">
      <main>
        <div id="ia-loading"><div class="ia-skel"></div><div class="ia-skel sm"></div><div class="ia-skel sm"></div></div>

        <div class="ia-state" id="ia-generating" hidden>
          <div class="ia-state-ic is-pulse"><i data-feather="cpu" style="width:26px;height:26px"></i></div>
          <h2>Lendo seu negócio</h2>
          <p>Cruzando vendas, serviços, clientes e agenda. Leva até um minuto e você pode sair desta página.</p>
        </div>

        <div class="ia-state" id="ia-empty" hidden>
          <div class="ia-state-ic"><i data-feather="cpu" style="width:24px;height:24px"></i></div>
          <h2>Diagnóstico do seu negócio</h2>
          <p>A IA cruza vendas, serviços, clientes e agenda e devolve uma decisão concreta pra semana, com o porquê e a leitura de cada área.</p>
          <button type="button" class="ia-primary" data-generate><i data-feather="cpu" style="width:16px;height:16px"></i>Gerar análise</button>
        </div>

        <div id="ia-result" hidden>
          <section class="ia-decision" aria-labelledby="ia-dec-eyebrow">
            <div class="ia-dec-top">
              <span class="ia-dec-eyebrow" id="ia-dec-eyebrow">A DECISÃO DESTA SEMANA</span>
              <span class="ia-fresh" id="ia-fresh" hidden><i></i>NOVA</span>
            </div>
            <p class="ia-dec-text" id="ia-dec-text"></p>
            <div class="ia-alert" id="ia-alert" hidden>
              <i data-feather="alert-triangle" style="width:15px;height:15px"></i>
              <div><b>Atenção paralela</b><p id="ia-alert-text"></p></div>
            </div>
            <div class="ia-dec-rule"></div>
            <div class="ia-dec-meta" id="ia-dec-meta"></div>
          </section>

          <section class="ia-why" id="ia-why" hidden style="margin-top:28px">
            <div class="ia-why-eyebrow">Por quê</div>
            <p id="ia-why-text"></p>
          </section>

          <section style="margin-top:32px">
            <div class="ia-block-head">
              <span class="ia-block-title">Como cada área está</span>
              <span class="ia-block-hint">clique pra ler</span>
            </div>
            <div class="ia-pulse" id="ia-pulse"></div>
            <div class="ia-dims" id="ia-dims"></div>
          </section>
        </div>
      </main>

      <aside class="ia-side">
        <div class="ia-foco" id="ia-foco">
          <div class="ia-foco-head">
            <i data-feather="target" style="width:15px;height:15px"></i>
            <b>Orientar a próxima análise</b>
            <span class="ia-saved" id="ia-saved" hidden><i data-feather="check" style="width:10px;height:10px"></i>salvo</span>
          </div>
          <p>Conte o que está te incomodando e a próxima análise olha pra isso primeiro.</p>
          <textarea id="ia-foco-input" maxlength="300" placeholder="Ex: preciso reduzir custos, estou com muita ociosidade…"></textarea>
          <div class="ia-foco-meta">
            <span class="ia-count"><span id="ia-count">0</span>/300</span>
            <button type="button" class="ia-ghost" id="ia-save" hidden>Salvar foco</button>
          </div>
          <button type="button" class="ia-primary" data-generate id="ia-gen-side"><i data-feather="refresh-cw" style="width:15px;height:15px"></i><span>Gerar nova análise</span></button>
        </div>
        <p class="ia-howto">A análise é refeita a cada ciclo. Gerar uma nova agora troca a atual pela leitura mais recente dos seus números.</p>
      </aside>
    </div>
  </div>
</div>

<script nonce="<%= csp_nonce %>">
(function () {
  var SECTIONS = [
    { key: 'sales', label: 'Faturamento' }, { key: 'services', label: 'Serviços' },
    { key: 'clients', label: 'Clientes' }, { key: 'demand', label: 'Demanda' },
    { key: 'retention', label: 'Retenção' }, { key: 'growth', label: 'Crescimento' }
  ];
  // A cor significa DIREÇÃO (igual ao app), e a seta repete a informação pra
  // quem não distingue verde de vermelho.
  var STATUS = {
    up:     { icon: 'arrow-up',   color: '#2d8a64', bg: 'rgba(93,195,159,.14)', label: 'SUBINDO' },
    down:   { icon: 'arrow-down', color: '#c85050', bg: 'rgba(200,80,80,.10)', label: 'CAINDO' },
    stable: { icon: 'minus',      color: '#8b857b', bg: 'rgba(0,0,0,.05)',      label: 'ESTÁVEL' }
  };
  var CSRF = (document.querySelector('meta[name="csrf-token"]') || {}).content;
  var st = { analysis: null, generating: false, openDim: null, savedInput: false, dirty: false };
  function $(id) { return document.getElementById(id); }
  function icon(n, s) { return window.feather && feather.icons[n] ? feather.icons[n].toSvg({ width: s, height: s }) : ''; }
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
  // Valores em R$ e % em negrito, como no app.
  function bold(t) { return esc(t).replace(/(R\$\s*[\d.,]+|[\d.,]+\s*%)/g, '<strong>$1</strong>'); }
  function api(url, opts) {
    opts = opts || {};
    return fetch(url, Object.assign({ credentials: 'same-origin' }, opts, {
      headers: Object.assign({ Accept: 'application/json', 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF }, opts.headers || {})
    }));
  }

  // Legado: cache antigo trazia o alerta embutido no texto da decisão.
  var ALERTA = /Aten[çc][ãa]o paralela\s*:/i;
  function splitDecisao(t) {
    t = String(t || '').trim();
    var m = t.match(ALERTA);
    if (!m || m.index === 0) return { principal: t, alerta: null };
    return { principal: t.slice(0, m.index).trim(), alerta: t.slice(m.index + m[0].length).trim() };
  }
  // A fonte acompanha o comprimento: curta é manchete, longa é leitura.
  function escala(len) { return len <= 110 ? 's1' : len <= 240 ? 's2' : 's3'; }

  function view(name) {
    $('ia-loading').hidden    = name !== 'loading';
    $('ia-generating').hidden = name !== 'generating';
    $('ia-empty').hidden      = name !== 'empty';
    $('ia-result').hidden     = name !== 'result';
    $('ia-refresh').hidden    = name !== 'result';
    $('ia-gen-side').hidden   = name !== 'result';
    $('ia-gen-side').disabled = st.generating;
  }
  function erro(msg) { $('ia-error').hidden = !msg; $('ia-error-text').textContent = msg ? ' ' + msg : ''; }

  function render() {
    var a = st.analysis;
    var d = splitDecisao(a.decisao_prioritaria);
    var dec = $('ia-dec-text');
    dec.className = 'ia-dec-text ' + escala(d.principal.length);
    dec.innerHTML = bold(d.principal);
    var alerta = (a.alerta_pipeline && a.alerta_pipeline.mensagem) || d.alerta;
    $('ia-alert').hidden = !alerta;
    $('ia-alert-text').innerHTML = alerta ? bold(alerta) : '';
    $('ia-fresh').hidden = a.cached !== false;
    $('ia-dec-meta').textContent = 'Gerada em ' + (a.generated_at || '—') +
      (a.next_refresh ? '  ·  próxima ' + a.next_refresh : '') + (a.days_remaining > 0 ? ' (' + a.days_remaining + 'd)' : '');
    $('ia-why').hidden = !a.cycle_summary;
    $('ia-why-text').innerHTML = bold(a.cycle_summary || '');

    // Panorama antes do detalhe.
    var vals = SECTIONS.map(function (s) { return ((a.sections || {})[s.key] || {}).status || 'stable'; });
    var up = vals.filter(function (v) { return v === 'up'; }).length;
    var down = vals.filter(function (v) { return v === 'down'; }).length;
    var flat = vals.length - up - down;
    var partes = [];
    if (up)   partes.push([up, up === 1 ? 'área subindo' : 'áreas subindo', STATUS.up.color]);
    if (down) partes.push([down, 'caindo', STATUS.down.color]);
    if (flat) partes.push([flat, flat === 1 ? 'estável' : 'estáveis', STATUS.stable.color]);
    $('ia-pulse').innerHTML = partes.map(function (p) {
      return '<div class="ia-pulse-item"><b style="color:' + p[2] + '">' + p[0] + '</b><span>' + p[1] + '</span></div>';
    }).join('');
    renderDims();
  }

  function renderDims() {
    var a = st.analysis;
    $('ia-dims').innerHTML = SECTIONS.map(function (s) {
      var sec = (a.sections || {})[s.key] || {};
      var cfg = STATUS[sec.status] || STATUS.stable;
      var open = st.openDim === s.key;
      return '<div class="ia-dim' + (open ? ' is-open' : '') + '">' +
        '<button type="button" class="ia-dim-head" data-dim="' + s.key + '" aria-expanded="' + open + '">' +
          '<span class="ia-dim-arrow" style="background:' + cfg.bg + ';color:' + cfg.color + '">' + icon(cfg.icon, 14) + '</span>' +
          '<span class="ia-dim-name">' + s.label + '</span>' +
          '<span class="ia-dim-status" style="color:' + cfg.color + '">' + cfg.label + '</span>' +
          '<span class="ia-dim-chev">' + icon('chevron-down', 16) + '</span>' +
        '</button>' +
        (open ? '<div class="ia-dim-body"><p>' + bold(sec.text || 'Sem dados para esta área.') + '</p></div>' : '') +
      '</div>';
    }).join('');
  }
  $('ia-dims').addEventListener('click', function (e) {
    var b = e.target.closest('[data-dim]'); if (!b) return;
    // Uma área aberta por vez: seis abertas viram parede de texto.
    st.openDim = st.openDim === b.dataset.dim ? null : b.dataset.dim;
    renderDims();
  });

  function aplicar(data) {
    st.analysis = data;
    st.savedInput = !!data.has_input;
    $('ia-saved').hidden = !st.savedInput;
    view('result');
    render();
  }

  function carregar() {
    view('loading');
    // /ai_insights (e não /status) na abertura: marca a análise como já vista,
    // então o selo "NOVA" só aparece logo depois de gerar.
    api('/owner/ai_insights').then(function (r) {
      if (!r.ok) throw new Error('http');
      return r.json();
    }).then(function (d) {
      if (d.status === 'ready') return aplicar(d);
      if (d.status === 'processing') { gerando(); return poll(); }
      if (d.status === 'error') erro(d.message || 'Não foi possível gerar a análise.');
      view('empty');
    }).catch(function () {
      erro('Não foi possível carregar a análise. Confira a conexão e recarregue a página.');
      view('empty');
    });
  }

  function gerando() { st.generating = true; view('generating'); }

  // O servidor gera em segundo plano e responde "processing" na hora.
  function poll() {
    var limite = Date.now() + 120000;
    (function passo() {
      setTimeout(function () {
        api('/owner/ai_insights/status').then(function (r) { return r.ok ? r.json() : { status: 'processing' }; })
          .catch(function () { return { status: 'processing' }; })
          .then(function (d) {
            if (d.status === 'ready') { st.generating = false; return aplicar(d); }
            if (d.status === 'error') { st.generating = false; erro(d.message || 'Não foi possível gerar a análise.'); return view(st.analysis ? 'result' : 'empty'); }
            if (Date.now() > limite) { st.generating = false; erro('Está demorando mais que o normal. Recarregue a página em instantes.'); return view(st.analysis ? 'result' : 'empty'); }
            passo();
          });
      }, 3000);
    })();
  }

  function salvarFoco() {
    var t = $('ia-foco-input').value.trim();
    if (!t) return Promise.resolve();
    return api('/owner/ai_insights/input', { method: 'POST', body: JSON.stringify({ input: t }) }).then(function (r) {
      if (r.ok) { st.savedInput = true; st.dirty = false; $('ia-saved').hidden = false; $('ia-save').hidden = true; }
    }).catch(function () {});
  }

  function gerar() {
    if (st.generating) return;
    erro(null);
    $('ia-unresolved').hidden = true;
    var pre = st.dirty ? salvarFoco() : Promise.resolve();
    pre.then(function () {
      gerando();
      return api('/owner/ai_insights?force=true', { method: 'POST' });
    }).then(function (r) {
      return r.json().catch(function () { return {}; }).then(function (d) { return { ok: r.ok, d: d }; });
    }).then(function (x) {
      if (!x.ok) {
        st.generating = false;
        if (x.d.code === 'unresolved_past') {
          $('ia-unresolved').hidden = false;
          $('ia-unresolved-text').textContent = ' ' + (x.d.error || '');
        } else {
          erro(x.d.error || 'Não foi possível gerar a análise.');
        }
        return view(st.analysis ? 'result' : 'empty');
      }
      if (x.d.status === 'ready') { st.generating = false; return aplicar(x.d); }
      if (x.d.status === 'error') { st.generating = false; erro(x.d.message || 'Não foi possível gerar a análise.'); return view(st.analysis ? 'result' : 'empty'); }
      poll();
    }).catch(function () {
      st.generating = false;
      erro('Falha de conexão. Tente novamente.');
      view(st.analysis ? 'result' : 'empty');
    });
  }

  document.querySelectorAll('[data-generate]').forEach(function (b) { b.addEventListener('click', gerar); });
  $('ia-refresh').addEventListener('click', gerar);
  $('ia-foco-input').addEventListener('input', function () {
    var t = this.value;
    $('ia-count').textContent = t.length;
    st.dirty = true;
    $('ia-saved').hidden = true;
    // Salvar só faz sentido quando já existe uma análise (o servidor guarda o
    // foco nela); antes disso o foco vai junto com o "Gerar análise".
    $('ia-save').hidden = !(t.trim() && st.analysis);
  });
  $('ia-save').addEventListener('click', salvarFoco);

  // Voltar: volta pra onde veio dentro do site; sem histórico, painel.
  document.getElementById('ia-back').addEventListener('click', function (e) {
    if (document.referrer && document.referrer.indexOf(location.origin) === 0 && history.length > 1) { e.preventDefault(); history.back(); }
  });
  if (window.feather) feather.replace();
  carregar();
})();
</script>
