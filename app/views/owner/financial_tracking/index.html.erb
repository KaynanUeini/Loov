<% Rails.logger.info("Renderizando owner/financial_tracking/index.html.erb") %>

<style>
  /* ── PERIOD PILLS ───────────────────────────────────── */
  .period-pills {
    display: flex; gap: 8px; flex-wrap: wrap;
    margin-bottom: 18px;
  }
  .period-pill {
    padding: 8px 16px; border-radius: 100px;
    background: var(--paper); border: 1px solid var(--stone);
    color: var(--graphite); cursor: pointer;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; font-weight: 700; letter-spacing: 1.2px;
    text-transform: uppercase; text-decoration: none;
    transition: all .15s ease;
  }
  .period-pill:hover {
    border-color: var(--coral-500);
    color: var(--coral-700);
  }
  .period-pill.active {
    background: var(--ink); color: var(--cream);
    border-color: var(--ink);
  }

  /* ── HERO RECEITA (escuro, ink) ─────────────────────── */
  .hero-revenue-card {
    background: var(--ink);
    border-radius: 22px;
    padding: 28px 30px;
    margin-bottom: 18px;
    color: var(--cream);
    position: relative; overflow: hidden;
  }
  .hero-revenue-card::after {
    content: ''; position: absolute;
    right: -120px; top: -80px;
    width: 320px; height: 320px;
    background: radial-gradient(circle, var(--coral-500) 0%, transparent 65%);
    opacity: 0.18; pointer-events: none;
  }
  .hero-revenue-top {
    display: flex; align-items: center; justify-content: space-between;
    gap: 10px; margin-bottom: 12px; flex-wrap: wrap;
  }
  .hero-revenue-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px; letter-spacing: 1.6px;
    color: var(--ash); text-transform: uppercase; font-weight: 600;
  }
  .hero-revenue-value {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(36px, 5vw, 50px);
    font-weight: 700; letter-spacing: -1.2px;
    color: var(--cream); line-height: 1;
  }
  .hero-revenue-sub {
    font-size: 13px; color: var(--ash);
    margin-top: 10px;
  }
  .hero-revenue-sub strong { color: #f1c0a8; font-weight: 600; }

  /* ── STAT TRIO (Realizado / Em aberto / Custos) ─────── */
  .stat-trio {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 10px; margin-bottom: 20px;
  }
  .stat-trio-card {
    background: var(--paper); border: 1px solid var(--stone);
    border-radius: 14px; padding: 14px;
    box-shadow: 0 2px 6px rgba(25,20,15,0.04);
  }
  .stat-trio-icon {
    color: var(--coral-500); font-size: 12px;
    margin-bottom: 6px;
  }
  .stat-trio-icon.amber { color: var(--amber-500); }
  .stat-trio-icon.graphite { color: var(--graphite); }
  .stat-trio-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9.5px; letter-spacing: 1.2px;
    color: var(--ash); text-transform: uppercase;
    font-weight: 600; margin-bottom: 5px;
  }
  .stat-trio-value {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 17px; font-weight: 700;
    color: var(--ink); letter-spacing: -0.4px;
    line-height: 1;
  }

  /* ── SECTION EYEBROW ────────────────────────────────── */
  .section-eyebrow {
    display: flex; align-items: center; justify-content: space-between;
    margin: 22px 0 12px; gap: 10px; flex-wrap: wrap;
  }
  .section-eyebrow-title {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px; letter-spacing: 1.6px;
    color: var(--ink); text-transform: uppercase; font-weight: 700;
  }
  .section-eyebrow-meta {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px; letter-spacing: 1.2px;
    color: var(--ash); text-transform: uppercase;
  }

  /* ── LANÇAR CUSTOS PRIMARY CTA ──────────────────────── */
  .launch-cta {
    display: flex; align-items: center; justify-content: center;
    gap: 10px; width: 100%;
    background: var(--coral-500); color: var(--cream) !important;
    border: none; border-radius: 16px;
    padding: 16px 24px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px; font-weight: 700; letter-spacing: 1.6px;
    text-transform: uppercase;
    cursor: pointer; text-decoration: none;
    box-shadow: 0 8px 22px rgba(220,120,82,0.22);
    transition: all .2s ease;
    margin-bottom: 14px;
  }
  .launch-cta:hover {
    background: var(--coral-700);
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(156,73,48,0.28);
    color: var(--cream) !important;
  }

  /* ── CHART CARD ─────────────────────────────────────── */
  .chart-card {
    background: var(--paper); border: 1px solid var(--stone);
    border-radius: 18px; padding: 18px 20px 14px;
    margin-bottom: 16px;
    box-shadow: 0 2px 6px rgba(25,20,15,0.04);
  }
  .chart-card-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 16px; font-weight: 700;
    color: var(--ink); letter-spacing: -0.2px;
    margin-bottom: 12px;
    display: flex; align-items: center; gap: 8px;
  }
  .chart-card-title i { color: var(--coral-500); font-size: 13px; }
  .chart-legend-row {
    display: flex; gap: 14px; flex-wrap: wrap;
    margin-bottom: 10px;
  }
  .chart-legend-item {
    display: flex; align-items: center; gap: 6px;
    font-size: 11.5px; color: var(--graphite);
  }
  .chart-legend-swatch { width: 12px; height: 8px; border-radius: 2px; }
  .chart-legend-line-wrap { width: 18px; height: 8px; position: relative; }
  .chart-legend-line {
    position: absolute; left: 0; right: 0; top: 50%;
    height: 2px; transform: translateY(-50%);
  }
  .chart-legend-line-dot {
    position: absolute; left: 5px; top: 0;
    width: 8px; height: 8px; border-radius: 50%;
    border: 2px solid var(--ink); background: var(--cream);
  }
  .chart-inner { position: relative; height: 280px; }
  .chart-inner-sm { position: relative; height: 200px; }

  /* ── DRE LIST EXPANSÍVEL ────────────────────────────── */
  .dre-list { display: flex; flex-direction: column; gap: 10px; }
  .dre-row {
    background: var(--paper); border: 1px solid var(--stone);
    border-radius: 16px; overflow: hidden;
    transition: border-color .15s ease;
  }
  .dre-row.is-current { border-color: var(--coral-100); }

  .dre-row-header {
    display: flex; align-items: center; gap: 12px;
    padding: 14px 18px;
    cursor: pointer; user-select: none;
    transition: background .15s ease;
  }
  .dre-row-header:hover { background: var(--sand); }

  .dre-row-main { flex: 1; min-width: 0; }
  .dre-row-month {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 15px; font-weight: 700;
    color: var(--ink); letter-spacing: -0.2px;
    margin-bottom: 3px;
  }
  .dre-row-month .current-dot {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9.5px; letter-spacing: 1.2px;
    color: var(--coral-500); margin-left: 8px;
    text-transform: uppercase;
  }
  .dre-row-summary { font-size: 12px; color: var(--graphite); }
  .dre-row-summary strong {
    color: var(--ink); font-weight: 600;
    font-family: 'JetBrains Mono', monospace;
  }
  .dre-row-summary strong.profit-neg { color: var(--rose-500); }

  .dre-row-add {
    display: inline-flex; align-items: center; justify-content: center;
    width: 30px; height: 30px; border-radius: 100px;
    background: var(--coral-50); border: 1px solid var(--coral-100);
    color: var(--coral-700); cursor: pointer;
    text-decoration: none; transition: all .15s ease;
    flex-shrink: 0;
  }
  .dre-row-add:hover {
    background: var(--coral-500); color: var(--cream);
    border-color: var(--coral-500);
  }
  .dre-row-chevron {
    color: var(--graphite); font-size: 12px;
    transition: transform .25s ease; flex-shrink: 0;
  }
  .dre-row-chevron.open { transform: rotate(180deg); }

  .dre-row-body {
    max-height: 0; overflow: hidden;
    transition: max-height .35s ease;
    border-top: 1px solid transparent;
  }
  .dre-row-body.open {
    max-height: 600px; border-top-color: var(--stone);
  }
  .dre-row-body-inner { padding: 12px 18px 16px; }

  .dre-line {
    display: flex; align-items: center; justify-content: space-between;
    padding: 5px 0; gap: 10px;
  }
  .dre-line-label { font-size: 13px; color: var(--graphite); }
  .dre-line-amount {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px; color: var(--ink);
  }
  .dre-line.muted .dre-line-label,
  .dre-line.muted .dre-line-amount { color: var(--ash); }
  .dre-line.bold .dre-line-amount { font-weight: 700; }
  .dre-line.big .dre-line-amount { font-size: 15px; }
  .dre-line.negative .dre-line-amount { color: var(--rose-500); }
  .dre-divider { height: 1px; background: var(--stone); margin: 6px 0; }

  .dre-add-cost-inline {
    display: flex; align-items: center; justify-content: center;
    gap: 8px; background: var(--coral-50); color: var(--coral-700);
    border: 1px dashed var(--coral-100); border-radius: 12px;
    padding: 11px 14px; margin-top: 10px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px; font-weight: 700; letter-spacing: 1.2px;
    text-decoration: none; text-transform: uppercase;
    transition: all .15s ease;
  }
  .dre-add-cost-inline:hover {
    background: var(--coral-500); color: var(--cream);
    border-color: var(--coral-500); border-style: solid;
  }

  /* ── FILTER BAR ─────────────────────────────────────── */
  .filter-bar {
    display: flex; gap: 12px; align-items: end;
    flex-wrap: wrap; margin-bottom: 18px;
  }
  .filter-bar .loov-field { margin-bottom: 0; min-width: 180px; flex: 1; }
  .custom-dates {
    display: none; gap: 12px; width: 100%;
    margin-top: 8px;
  }
  .custom-dates.visible { display: flex; }

  /* ── ACTION BANNER (AI insights) ────────────────────── */
  .action-banner {
    background: var(--coral-50); border: 1px solid var(--coral-100);
    border-radius: 16px; padding: 14px 18px;
    margin-bottom: 16px; display: none;
  }
  .action-banner-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px; font-weight: 700; letter-spacing: 1.6px;
    color: var(--coral-700); text-transform: uppercase;
    margin-bottom: 6px;
    display: flex; align-items: center; gap: 6px;
  }
  .action-banner-text { font-size: 13.5px; color: var(--ink); line-height: 1.55; }

  .cycle-banner {
    background: var(--paper); border: 1px solid var(--stone);
    border-radius: 14px; padding: 14px 18px;
    margin-bottom: 14px;
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 10px;
  }
  .cycle-banner-info { display: flex; flex-direction: column; gap: 2px; }
  .cycle-banner-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9.5px; font-weight: 600; letter-spacing: 1.4px;
    color: var(--ash); text-transform: uppercase;
  }
  .cycle-banner-value {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14px; font-weight: 700;
    color: var(--ink); letter-spacing: -0.2px;
  }
  .cycle-banner-summary {
    font-size: 12.5px; color: var(--graphite);
    line-height: 1.5; max-width: 540px;
  }
  .btn-input {
    display: inline-flex; align-items: center; gap: 6px;
    background: var(--coral-50); color: var(--coral-700);
    border: 1px solid var(--coral-100); border-radius: 100px;
    padding: 7px 14px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px; font-weight: 700; letter-spacing: 1.2px;
    cursor: pointer; transition: all 0.2s ease;
    white-space: nowrap; text-transform: uppercase;
  }
  .btn-input:hover { background: var(--coral-500); color: var(--cream); border-color: var(--coral-500); }
  .btn-input.saved { color: var(--ash); border-color: var(--stone); background: transparent; }

  /* ── COSTS MODAL (overlay) ──────────────────────────── */
  .costs-modal-overlay {
    position: fixed; inset: 0;
    background: rgba(40, 35, 28, 0.55);
    backdrop-filter: blur(4px);
    z-index: 1000;
    display: flex; align-items: flex-end; justify-content: center;
    opacity: 0; pointer-events: none;
    transition: opacity .25s ease;
  }
  @media (min-width: 720px) {
    .costs-modal-overlay { align-items: center; padding: 20px; }
  }
  .costs-modal-overlay.open { opacity: 1; pointer-events: all; }

  .costs-modal-sheet {
    background: var(--cream);
    width: 100%; max-width: 560px;
    max-height: 85vh; overflow-y: auto;
    border-radius: 24px 24px 0 0;
    padding: 12px 22px 22px;
    transform: translateY(40px);
    transition: transform .3s cubic-bezier(.16,1,.3,1);
    box-shadow: 0 -10px 40px rgba(40, 35, 28, 0.25);
  }
  @media (min-width: 720px) {
    .costs-modal-sheet { border-radius: 24px; transform: translateY(20px); }
  }
  .costs-modal-overlay.open .costs-modal-sheet { transform: translateY(0); }

  .costs-modal-handle {
    width: 40px; height: 4px; border-radius: 2px;
    background: var(--stone);
    margin: 4px auto 14px;
  }
  @media (min-width: 720px) {
    .costs-modal-handle { display: none; }
  }
  .costs-modal-title {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px; letter-spacing: 1.8px;
    color: var(--ink); text-transform: uppercase; font-weight: 700;
    margin-bottom: 4px;
  }
  .costs-modal-subtitle {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 17px; font-weight: 700;
    color: var(--graphite); margin-bottom: 16px;
  }
  .costs-modal-loading {
    padding: 60px 0; text-align: center; color: var(--ash);
  }
  .costs-modal-content { padding-bottom: 4px; }
  .costs-modal-actions {
    display: flex; gap: 10px; margin-top: 16px;
    padding-top: 14px; border-top: 1px solid var(--stone);
  }
  .costs-modal-cancel {
    flex: 1; padding: 12px;
    border-radius: 12px; border: 1px solid var(--stone);
    background: var(--paper); color: var(--graphite);
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; font-weight: 700; letter-spacing: 1.2px;
    cursor: pointer; text-transform: uppercase;
  }
  .costs-modal-confirm {
    flex: 2; padding: 12px;
    border-radius: 12px; border: none;
    background: var(--coral-500); color: var(--cream);
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; font-weight: 700; letter-spacing: 1.2px;
    cursor: pointer; text-transform: uppercase;
  }
  .costs-modal-confirm:hover { background: var(--coral-700); }

  .costs-modal-group-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px; letter-spacing: 1.5px;
    color: var(--coral-700); text-transform: uppercase; font-weight: 700;
    margin: 14px 0 8px;
  }
  .modal-money-row {
    display: flex; align-items: center; gap: 10px;
    padding: 6px 0;
  }
  .modal-money-label-col { flex: 1; }
  .modal-money-label {
    font-size: 13px; color: var(--graphite);
  }
  .modal-money-input-wrap {
    display: inline-flex; align-items: center;
    background: var(--paper); border: 1px solid var(--stone);
    border-radius: 10px; padding: 0 10px;
    width: 140px;
  }
  .modal-money-input-wrap.pending { border-color: var(--coral-500); background: var(--coral-50); }
  .modal-money-prefix {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px; color: var(--ash); margin-right: 4px;
  }
  .modal-money-input {
    flex: 1; min-width: 0; border: none; outline: none; background: transparent;
    padding: 9px 0;
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px; color: var(--ink); text-align: right;
  }
  .modal-add-line-btn {
    display: flex; align-items: center; justify-content: center;
    gap: 6px; width: 100%;
    background: var(--coral-50); color: var(--coral-700);
    border: 1px dashed var(--coral-100); border-radius: 10px;
    padding: 9px; margin-top: 6px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px; font-weight: 700; letter-spacing: 1px;
    cursor: pointer; text-transform: uppercase;
  }

  /* ── LEGACY: Tabs (transações + tabelas) ────────────── */
  .fin-section {
    background: var(--paper); border: 1px solid var(--stone);
    border-radius: 18px; margin-bottom: 16px; overflow: hidden;
    box-shadow: 0 2px 6px rgba(25,20,15,0.04);
  }
  .fin-section-header {
    padding: 16px 20px;
    border-bottom: 1px solid var(--stone);
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 12px;
  }
  .fin-section-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 16px; font-weight: 700;
    color: var(--ink); letter-spacing: -0.2px;
    display: flex; align-items: center; gap: 8px; margin: 0;
  }
  .fin-section-title i { color: var(--coral-500); font-size: 13px; }

  .fin-table { width: 100%; border-collapse: collapse; }
  .fin-table thead th {
    padding: 11px 16px; text-align: left;
    font-family: 'JetBrains Mono', monospace;
    font-size: 9.5px; font-weight: 600; letter-spacing: 1.4px;
    color: var(--graphite); text-transform: uppercase;
    border-bottom: 1px solid var(--stone);
    background: var(--sand);
  }
  .fin-table tbody td {
    padding: 12px 16px; font-size: 13px;
    color: var(--ink); border-bottom: 1px solid var(--stone);
  }
  .fin-table tbody tr:last-child td { border-bottom: none; }
  .fin-table tbody tr:hover td { background: var(--sand); }
  .fin-table tbody tr.hidden-row { display: none; }
  .td-value {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px; font-weight: 600;
    color: var(--coral-500);
  }
  .td-muted { color: var(--ash); font-size: 12.5px; }

  .btn-csv {
    display: inline-flex; align-items: center; gap: 6px;
    background: var(--coral-50); color: var(--coral-700);
    border: 1px solid var(--coral-100); border-radius: 100px;
    padding: 7px 14px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px; font-weight: 700; letter-spacing: 1.2px;
    cursor: pointer; transition: all .2s ease;
    text-decoration: none; white-space: nowrap; text-transform: uppercase;
  }
  .btn-csv:hover { background: var(--coral-500); color: var(--cream); border-color: var(--coral-500); }

  .btn-ver-mais {
    display: flex; align-items: center; justify-content: center; gap: 6px;
    width: 100%; padding: 12px;
    background: transparent; color: var(--graphite);
    border: none; border-top: 1px solid var(--stone);
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px; font-weight: 700; letter-spacing: 1.2px;
    cursor: pointer; transition: all .2s ease;
    text-transform: uppercase;
  }
  .btn-ver-mais:hover { background: var(--sand); color: var(--coral-700); }

  /* ── FLIP CARDS (AI insights) ───────────────────────── */
  .flip-wrap { perspective: 1200px; margin-bottom: 16px; }
  .flip-inner {
    position: relative; transform-style: preserve-3d;
    transition: transform .55s cubic-bezier(.4, 0, .2, 1);
  }
  .flip-inner.flipped { transform: rotateY(180deg); }
  .flip-front, .flip-back {
    background: var(--paper); border: 1px solid var(--stone);
    border-radius: 18px; padding: 22px;
    backface-visibility: hidden; -webkit-backface-visibility: hidden;
    box-shadow: 0 2px 6px rgba(25,20,15,0.04);
  }
  .flip-back {
    position: absolute; top: 0; left: 0;
    width: 100%; height: 100%;
    transform: rotateY(180deg);
    background: var(--sand); border-color: var(--coral-100);
    display: flex; flex-direction: column;
    overflow-y: auto;
    box-sizing: border-box; padding-bottom: 28px;
  }
  .flip-btn {
    position: absolute; top: 16px; right: 16px;
    width: 30px; height: 30px; border-radius: 50%;
    background: var(--coral-50); border: 1px solid var(--coral-100);
    color: var(--coral-700); font-size: 16px; font-weight: 700;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; transition: all .2s ease; z-index: 2;
  }
  .flip-btn:hover { background: var(--coral-500); color: var(--cream); border-color: var(--coral-500); }

  .insight-eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px; font-weight: 700; letter-spacing: 1.6px;
    text-transform: uppercase; color: var(--coral-700);
    margin-bottom: 10px;
    display: flex; align-items: center; gap: 6px;
  }
  .insight-meta {
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 8px;
    margin-bottom: 12px; padding-bottom: 10px;
    border-bottom: 1px solid var(--stone);
  }
  .insight-meta-left { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .insight-meta-date { font-size: 11.5px; color: var(--graphite); }
  .insight-meta-date strong { color: var(--ink); }
  .btn-refresh {
    display: inline-flex; align-items: center; gap: 5px;
    background: transparent; color: var(--graphite);
    border: 1px solid var(--stone); border-radius: 100px;
    padding: 4px 11px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 9.5px; font-weight: 700; letter-spacing: 1.2px;
    cursor: pointer; transition: all .2s ease;
    text-transform: uppercase;
  }
  .btn-refresh:hover { border-color: var(--coral-500); color: var(--coral-700); }
