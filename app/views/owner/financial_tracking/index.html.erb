<% content_for :page_title, "IA insights" %>

<style>
  .ai-page { max-width: 1100px; margin: 0 auto; padding: 56px 24px 96px; }

  .ai-hero { text-align: left; margin-bottom: 36px; }
  .ai-hero .loov-h1 { margin-bottom: 14px !important; }
  .ai-hero .loov-lead { margin: 0; max-width: 640px; }

  .ai-toolbar {
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 14px; margin-bottom: 20px;
  }
  .ai-toolbar-left { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .ai-toolbar-right { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }

  .ai-status-badge {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 5px 12px; border-radius: 100px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px; font-weight: 700; letter-spacing: 1.4px;
    text-transform: uppercase;
    border: 1px solid var(--stone);
    background: var(--paper); color: var(--graphite);
  }
  .ai-status-badge .dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--ash);
  }
  .ai-status-badge[data-state="processing"] {
    background: var(--coral-50); color: var(--coral-700); border-color: var(--coral-100);
  }
  .ai-status-badge[data-state="processing"] .dot {
    background: var(--coral-500);
    animation: ai-pulse 1.2s ease-in-out infinite;
  }
  .ai-status-badge[data-state="ready"] {
    background: #d6ecde; color: #2d6b42; border-color: #b5d8c1;
  }
  .ai-status-badge[data-state="ready"] .dot { background: #2d6b42; }
  .ai-status-badge[data-state="error"] {
    background: #fdecec; color: var(--rose-500); border-color: #f5cccc;
  }
  .ai-status-badge[data-state="error"] .dot { background: var(--rose-500); }
  @keyframes ai-pulse {
    0%,100% { opacity: 1; transform: scale(1); }
    50%     { opacity: .35; transform: scale(.65); }
  }

  .ai-cycle-meta {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; letter-spacing: 1.2px;
    color: var(--graphite); text-transform: uppercase;
  }
  .ai-cycle-meta strong { color: var(--ink); font-weight: 700; }

  .ai-banner {
    border-radius: 16px; padding: 16px 20px;
    display: flex; align-items: flex-start; gap: 14px;
    margin-bottom: 20px;
  }
  .ai-banner--rose {
    background: #fdecec; border: 1px solid #f5cccc;
    color: #6e2828;
  }
  .ai-banner--rose .ai-banner-icon { color: var(--rose-500); }
  .ai-banner-icon {
    flex: 0 0 auto; width: 36px; height: 36px; border-radius: 12px;
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 16px; background: rgba(200,80,80,0.12);
  }
  .ai-banner-body { flex: 1; min-width: 0; }
  .ai-banner-title {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700; font-size: 15px;
    margin: 0 0 4px;
  }
  .ai-banner-text { font-size: 13.5px; line-height: 1.5; margin: 0; }
  .ai-banner-link {
    display: inline-flex; align-items: center; gap: 6px;
    margin-top: 10px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; font-weight: 700; letter-spacing: 1.2px;
    text-transform: uppercase; text-decoration: none;
    color: var(--rose-500);
  }
  .ai-banner-link:hover { color: #6e2828; }

  .ai-input-card {
    background: var(--paper);
    border: 1px solid var(--stone);
    border-radius: 18px;
    padding: 22px;
    margin-bottom: 24px;
  }
  .ai-input-head {
    display: flex; align-items: center; gap: 10px; margin-bottom: 12px;
  }
  .ai-input-icon {
    width: 28px; height: 28px; border-radius: 9px;
    background: var(--coral-50); border: 1px solid var(--coral-100);
    color: var(--coral-700);
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 13px;
  }
  .ai-input-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; font-weight: 700; letter-spacing: 1.4px;
    color: var(--ink); text-transform: uppercase;
  }
  .ai-input-optional {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px; letter-spacing: 0.8px;
    color: var(--ash); text-transform: uppercase;
  }
  .ai-input-saved {
    margin-left: auto;
    background: var(--coral-50); color: var(--coral-700);
    border: 1px solid var(--coral-100);
    padding: 3px 10px; border-radius: 100px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 9.5px; font-weight: 700; letter-spacing: 1.2px;
    text-transform: uppercase;
    display: none;
  }
  .ai-input-saved[data-shown="true"] { display: inline-flex; align-items: center; gap: 4px; }

  .ai-input-textarea {
    width: 100%; resize: vertical;
    background: var(--cream);
    border: 1px solid var(--stone);
    border-radius: 12px;
    padding: 12px 14px;
    font-family: 'Inter', sans-serif;
    font-size: 14px; line-height: 1.55;
    color: var(--ink);
    min-height: 88px; outline: none;
    transition: border-color .15s ease, box-shadow .15s ease;
  }
  .ai-input-textarea:focus {
    border-color: var(--coral-500);
    box-shadow: 0 0 0 3px rgba(220,120,82,0.08);
  }
  .ai-input-textarea::placeholder { color: var(--ash); }

  .ai-input-foot {
    display: flex; align-items: center; justify-content: space-between;
    margin-top: 10px; gap: 10px; flex-wrap: wrap;
  }
  .ai-input-count {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; color: var(--ash);
  }

  .ai-section-eyebrow {
    display: flex; align-items: center; justify-content: space-between;
    gap: 12px; flex-wrap: wrap;
    margin: 32px 0 14px;
  }
  .ai-section-title {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px; letter-spacing: 1.6px; font-weight: 700;
    color: var(--ink); text-transform: uppercase;
  }
  .ai-section-meta {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px; letter-spacing: 1.2px;
    color: var(--ash); text-transform: uppercase;
  }

  .ai-flip-grid {
    display: grid; gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }

  .ai-flip-card {
    perspective: 1200px;
    min-height: 240px;
    cursor: pointer;
    background: transparent;
    border: none;
    padding: 0;
    text-align: left;
    width: 100%;
    font-family: inherit;
  }
  .ai-flip-inner {
    position: relative; width: 100%; min-height: 240px; height: 100%;
    transition: transform .55s cubic-bezier(.4,.0,.2,1);
    transform-style: preserve-3d;
  }
  .ai-flip-card.flipped .ai-flip-inner { transform: rotateY(180deg); }

  .ai-flip-face {
    position: absolute; inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    background: var(--paper);
    border: 1px solid var(--stone);
    border-radius: 18px;
    padding: 20px;
    box-shadow: 0 2px 6px rgba(25,20,15,0.04);
    display: flex; flex-direction: column;
    overflow: hidden;
  }
  .ai-flip-face--back {
    transform: rotateY(180deg);
    background: var(--ink);
    color: var(--cream);
    border-color: var(--ink);
  }

  .ai-flip-front-head {
    display: flex; align-items: center; gap: 10px; margin-bottom: 14px;
  }
  .ai-flip-icon {
    width: 32px; height: 32px; border-radius: 10px;
    border: 1px solid;
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 14px;
  }
  .ai-flip-front-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px; letter-spacing: 1.4px; font-weight: 700;
    color: var(--ink); text-transform: uppercase;
  }
  /* Tamanho ajustado pra cada card poder mostrar números OU frases curtas
     da análise sem cortar. Antes 28px estava grande pra textos. */
  .ai-flip-front-value {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 16px; font-weight: 600; letter-spacing: -0.2px;
    color: var(--ink); line-height: 1.4;
    margin: 4px 0 10px;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 6;
    -webkit-box-orient: vertical;
    word-break: normal;
    overflow-wrap: anywhere;
  }
  /* Quando o conteúdo é curto (≤20 chars, número), volta pro display grande */
  .ai-flip-front-value.is-numeric {
    font-size: 26px; font-weight: 700; letter-spacing: -0.5px;
    line-height: 1.05;
    -webkit-line-clamp: unset;
    display: block;
  }
  .ai-flip-front-foot {
    margin-top: auto;
    display: flex; align-items: center; gap: 8px;
    flex-wrap: wrap;
  }
  .ai-flip-delta {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 3px 10px; border-radius: 100px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px; font-weight: 700; letter-spacing: 1px;
    border: 1px solid;
  }
  .ai-flip-delta--up { color: #2d6b42; background: #d6ecde; border-color: #b5d8c1; }
  .ai-flip-delta--down { color: var(--rose-500); background: #fdecec; border-color: #f5cccc; }
  .ai-flip-delta--flat { color: var(--graphite); background: var(--sand); border-color: var(--stone); }

  .ai-flip-hint {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9.5px; letter-spacing: 1px;
    color: var(--ash); text-transform: uppercase;
    margin-left: auto;
  }

  .ai-flip-back-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px; letter-spacing: 1.4px; font-weight: 700;
    color: var(--coral-500); text-transform: uppercase;
    margin-bottom: 10px;
  }
  .ai-flip-back-text {
    font-family: 'Inter', sans-serif;
    font-size: 13.5px; line-height: 1.6;
    color: var(--cream);
    overflow: auto;
    flex: 1;
  }
  .ai-flip-back-text strong { color: #f1c0a8; font-weight: 600; }
  .ai-flip-back-foot {
    margin-top: 12px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 9.5px; letter-spacing: 1px;
    color: var(--ash); text-transform: uppercase;
  }

  .ai-insight-list {
    display: flex; flex-direction: column; gap: 12px;
  }
  .ai-insight-item {
    background: var(--paper);
    border: 1px solid var(--stone);
    border-radius: 14px;
    padding: 18px 20px;
  }
  .ai-insight-item-title {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700; font-size: 15.5px;
    color: var(--ink); margin: 0 0 6px;
    letter-spacing: -0.2px;
  }
  .ai-insight-item-body {
    font-size: 13.5px; line-height: 1.6;
    color: var(--graphite); margin: 0;
  }
  .ai-insight-item-body strong { color: var(--ink); font-weight: 600; }
  .ai-insight-item-tags {
    display: flex; flex-wrap: wrap; gap: 6px;
    margin-top: 10px;
  }

  .ai-decision-card {
    background: var(--ink);
    border-radius: 18px;
    padding: 22px 24px;
    color: var(--cream);
    margin-bottom: 16px;
    position: relative; overflow: hidden;
  }
  .ai-decision-card::after {
    content: ''; position: absolute;
    right: -100px; top: -60px;
    width: 280px; height: 280px;
    background: radial-gradient(circle, var(--coral-500) 0%, transparent 60%);
    opacity: 0.2; pointer-events: none;
  }
  .ai-decision-head {
    display: flex; align-items: center; gap: 10px; margin-bottom: 12px;
    position: relative;
  }
  .ai-decision-icon {
    width: 28px; height: 28px; border-radius: 9px;
    background: rgba(220,120,82,0.18);
    border: 1px solid rgba(220,120,82,0.42);
    color: var(--coral-500);
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 13px;
  }
  .ai-decision-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px; letter-spacing: 1.6px; font-weight: 700;
    color: var(--coral-500); text-transform: uppercase;
  }
  .ai-decision-text {
    font-size: 14.5px; line-height: 1.6;
    color: var(--cream); margin: 0;
    position: relative;
  }
  .ai-decision-text strong { color: #f1c0a8; font-weight: 600; }

  .ai-empty {
    background: var(--paper);
    border: 1px dashed var(--stone);
    border-radius: 22px;
    padding: 56px 32px;
    text-align: center;
  }
  .ai-empty-icon {
    width: 64px; height: 64px;
    margin: 0 auto 18px;
    border-radius: 18px;
    background: var(--coral-50);
    border: 1px solid var(--coral-100);
    color: var(--coral-700);
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 28px;
  }
  .ai-empty-title {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700; font-size: 22px;
    color: var(--ink); margin: 0 0 8px;
    letter-spacing: -0.4px;
  }
  .ai-empty-text {
    font-size: 14px; color: var(--graphite);
    margin: 0 auto 24px; max-width: 440px; line-height: 1.55;
  }

  .ai-skeleton-grid {
    display: grid; gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }
  .ai-skeleton-card {
    background: var(--paper);
    border: 1px solid var(--stone);
    border-radius: 18px;
    padding: 20px;
    min-height: 200px;
    display: flex; flex-direction: column; gap: 12px;
  }
  .ai-skeleton-line {
    height: 14px; border-radius: 7px;
    background: linear-gradient(90deg, var(--sand) 0%, var(--stone) 50%, var(--sand) 100%);
    background-size: 200% 100%;
    animation: ai-shimmer 1.4s ease-in-out infinite;
  }
  .ai-skeleton-line.lg { height: 28px; width: 60%; }
  .ai-skeleton-line.sm { height: 10px; width: 40%; }
  @keyframes ai-shimmer {
    0%   { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  .ai-error-card {
    background: #fdecec;
    border: 1px solid #f5cccc;
    border-radius: 18px;
    padding: 22px 24px;
    color: #6e2828;
    margin-bottom: 20px;
  }
  .ai-error-head {
    display: flex; align-items: center; gap: 10px; margin-bottom: 8px;
  }
  .ai-error-icon {
    width: 28px; height: 28px; border-radius: 9px;
    background: rgba(200,80,80,0.18);
    color: var(--rose-500);
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 14px;
  }
  .ai-error-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px; letter-spacing: 1.4px; font-weight: 700;
    color: var(--rose-500); text-transform: uppercase;
  }
  .ai-error-text { font-size: 13.5px; line-height: 1.55; margin: 0; }

  .ai-hidden { display: none !important; }

  .ai-btn-disabled {
    opacity: 0.55; pointer-events: none; cursor: not-allowed;
  }

  .ai-footer-note {
    text-align: center; margin-top: 32px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px; letter-spacing: 0.8px;
    color: var(--ash); text-transform: uppercase;
  }

  @media (max-width: 720px) {
    .ai-page { padding: 40px 16px 64px; }
    .ai-flip-front-value { font-size: 14.5px; }
    .ai-flip-front-value.is-numeric { font-size: 24px; }
    .ai-decision-card { padding: 18px; }
  }
</style>

<div class="ai-page">
  <div class="ai-hero loov-hero loov-hero--left">
    <div class="loov-eyebrow"><span class="dot"></span>IA INSIGHTS</div>
    <h1 class="loov-h1">Seu negócio, <span class="accent">analisado</span>.</h1>
    <p class="loov-lead">Análise gerada por IA do faturamento, retenção e crescimento — com decisões concretas para o ciclo atual.</p>
  </div>

  <div id="ai-unresolved-banner" class="ai-banner ai-banner--rose ai-hidden">
    <div class="ai-banner-icon">!</div>
    <div class="ai-banner-body">
      <p class="ai-banner-title">Resolva pendências antes de gerar a análise</p>
      <p class="ai-banner-text" id="ai-unresolved-text">Há atendimentos de dias anteriores aguardando confirmação. Sem isso os números ficam imprecisos.</p>
      <a href="/" class="ai-banner-link">Ir pro Dashboard &rarr;</a>
    </div>
  </div>

  <div class="ai-toolbar">
    <div class="ai-toolbar-left">
      <span id="ai-status-badge" class="ai-status-badge" data-state="idle">
        <span class="dot"></span><span id="ai-status-label">Carregando</span>
      </span>
      <span id="ai-cycle-label" class="ai-cycle-meta"></span>
    </div>
    <div class="ai-toolbar-right">
      <button id="ai-generate-btn" type="button" class="loov-btn-primary loov-btn-sm">
        <span id="ai-generate-btn-label">Gerar análise</span>
      </button>
    </div>
  </div>

  <div id="ai-error-banner" class="ai-error-card ai-hidden">
    <div class="ai-error-head">
      <div class="ai-error-icon">!</div>
      <div class="ai-error-label">Erro</div>
    </div>
    <p class="ai-error-text" id="ai-error-message">Não foi possível gerar a análise.</p>
  </div>

  <div class="ai-input-card">
    <div class="ai-input-head">
      <div class="ai-input-icon">&#9678;</div>
      <span class="ai-input-label">Foco desta análise</span>
      <span class="ai-input-optional">opcional</span>
      <span id="ai-input-saved-pill" class="ai-input-saved">SALVO</span>
    </div>
    <textarea id="ai-owner-input" class="ai-input-textarea"
              maxlength="300"
              placeholder="Ex: preciso reduzir custos, estou com muita ociosidade, quero entender por que clientes somem..."></textarea>
    <div class="ai-input-foot">
      <span class="ai-input-count"><span id="ai-input-count">0</span>/300</span>
      <button id="ai-input-save-btn" type="button" class="loov-btn-secondary loov-btn-sm" disabled>
        Salvar foco
      </button>
    </div>
  </div>

  <div id="ai-decision-card" class="ai-decision-card ai-hidden">
    <div class="ai-decision-head">
      <div class="ai-decision-icon">&#9889;</div>
      <span class="ai-decision-label">Decisão prioritária</span>
    </div>
    <p class="ai-decision-text" id="ai-decision-text"></p>
  </div>

  <div id="ai-loading-skeleton" class="ai-hidden">
    <div class="ai-section-eyebrow">
      <span class="ai-section-title">Processando análise</span>
      <span class="ai-section-meta">isso pode levar até 1 minuto</span>
    </div>
    <div class="ai-skeleton-grid">
      <div class="ai-skeleton-card">
        <div class="ai-skeleton-line sm"></div>
        <div class="ai-skeleton-line lg"></div>
        <div class="ai-skeleton-line"></div>
        <div class="ai-skeleton-line" style="width: 75%;"></div>
      </div>
      <div class="ai-skeleton-card">
        <div class="ai-skeleton-line sm"></div>
        <div class="ai-skeleton-line lg"></div>
        <div class="ai-skeleton-line"></div>
        <div class="ai-skeleton-line" style="width: 60%;"></div>
      </div>
      <div class="ai-skeleton-card">
        <div class="ai-skeleton-line sm"></div>
        <div class="ai-skeleton-line lg"></div>
        <div class="ai-skeleton-line"></div>
        <div class="ai-skeleton-line" style="width: 80%;"></div>
      </div>
    </div>
  </div>

  <div id="ai-empty-state" class="ai-empty ai-hidden">
    <div class="ai-empty-icon">&#9881;</div>
    <h2 class="ai-empty-title">Sem análise ainda</h2>
    <p class="ai-empty-text">A IA cruza vendas, serviços, clientes e agenda e traz decisões concretas pra você aplicar. Leva cerca de 1 minuto.</p>
    <button type="button" class="loov-btn-primary loov-btn-lg" data-ai-action="generate">
      Gerar análise
    </button>
  </div>

  <div id="ai-flip-section" class="ai-hidden">
    <div class="ai-section-eyebrow">
      <span class="ai-section-title">Análise detalhada</span>
      <span class="ai-section-meta">toque para virar</span>
    </div>
    <div id="ai-flip-grid" class="ai-flip-grid"></div>
  </div>

  <div id="ai-insights-section" class="ai-hidden">
    <div class="ai-section-eyebrow">
      <span class="ai-section-title">Insights</span>
      <span class="ai-section-meta" id="ai-insights-count"></span>
    </div>
    <div id="ai-insights-list" class="ai-insight-list"></div>
  </div>

  <div id="ai-footer-note" class="ai-footer-note ai-hidden"></div>
</div>

<script>
(function () {
  var endpoints = {
    show:   '/owner/ai_insights',
    status: '/owner/ai_insights/status',
    create: '/owner/ai_insights',
    input:  '/owner/ai_insights/input'
  };

  var state = {
    status:     'loading',
    data:       null,
    polling:    false,
    pollTimer:  null,
    inputDirty: false,
    saving:     false,
    flipped:    {}
  };

  function csrfToken() {
    var m = document.querySelector('meta[name="csrf-token"]');
    return m ? m.content : '';
  }

  function jsonFetch(url, opts) {
    opts = opts || {};
    var headers = Object.assign({
      'Accept':       'application/json',
      'Content-Type': 'application/json',
      'X-CSRF-Token': csrfToken()
    }, opts.headers || {});
    return fetch(url, Object.assign({}, opts, { headers: headers, credentials: 'same-origin' }));
  }

  function $(id) { return document.getElementById(id); }
  function show(el) { if (el) el.classList.remove('ai-hidden'); }
  function hide(el) { if (el) el.classList.add('ai-hidden'); }
  function setText(id, txt) { var el = $(id); if (el) el.textContent = txt == null ? '' : String(txt); }

  function escapeHtml(s) {
    return String(s == null ? '' : s)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;')
      .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function boldifyNumbers(text) {
    var safe = escapeHtml(text);
    return safe.replace(/(R\$\s*[\d.,]+|[\d.,]+\s*%)/g, '<strong>$1</strong>');
  }

  function setStatusBadge(stateName, label) {
    var badge = $('ai-status-badge');
    if (!badge) return;
    badge.setAttribute('data-state', stateName);
    setText('ai-status-label', label);
  }

  function setGenerateButton(mode, opts) {
    opts = opts || {};
    var btn = $('ai-generate-btn');
    var lbl = $('ai-generate-btn-label');
    if (!btn || !lbl) return;
    btn.classList.remove('ai-btn-disabled');
    btn.disabled = false;
    if (mode === 'processing') {
      lbl.textContent = 'Gerando...';
      btn.disabled = true;
      btn.classList.add('ai-btn-disabled');
    } else if (mode === 'update') {
      lbl.textContent = 'Atualizar';
    } else if (mode === 'locked') {
      lbl.textContent = 'Resolver pendências';
      btn.disabled = true;
      btn.classList.add('ai-btn-disabled');
    } else {
      lbl.textContent = 'Gerar análise';
    }
  }

  // ── Section / metric configuration ────────────────────────────────────────

  var SECTION_CFG = {
    sales:     { label: 'Faturamento',  icon: '↗', color: 'var(--coral-500)', tint: 'rgba(220,120,82,0.12)', border: 'rgba(220,120,82,0.42)' },
    services:  { label: 'Servicos',     icon: '⚒', color: 'var(--pool-500)',  tint: 'rgba(75,142,192,0.14)', border: 'rgba(75,142,192,0.42)' },
    clients:   { label: 'Clientes',     icon: '☆', color: 'var(--graphite)',  tint: 'rgba(87,81,72,0.12)',   border: 'rgba(87,81,72,0.30)' },
    demand:    { label: 'Demanda',      icon: '⏱', color: 'var(--amber-500)', tint: 'rgba(214,177,74,0.18)', border: 'rgba(214,177,74,0.50)' },
    retention: { label: 'Retencao',     icon: '↻', color: 'var(--mint-500)',  tint: 'rgba(93,195,159,0.18)', border: 'rgba(93,195,159,0.45)' },
    growth:    { label: 'Crescimento',  icon: '↗', color: 'var(--pool-500)',  tint: 'rgba(75,142,192,0.14)', border: 'rgba(75,142,192,0.42)' }
  };

  function statusToDelta(status) {
    if (status === 'up')   return { cls: 'up',   icon: '↑', label: 'Subindo' };
    if (status === 'down') return { cls: 'down', icon: '↓', label: 'Caindo' };
    return { cls: 'flat', icon: '=',  label: 'Estavel' };
  }

  function buildFlipCards(data) {
    var grid = $('ai-flip-grid');
    if (!grid) return;
    grid.innerHTML = '';

    var sections = (data && data.sections) || {};
    var keys = Object.keys(SECTION_CFG);
    var anyContent = keys.some(function (k) {
      var s = sections[k];
      return s && (typeof s === 'string' ? s.trim() : (s.text || '').trim());
    });

    if (!anyContent) {
      hide($('ai-flip-section'));
      return;
    }

    keys.forEach(function (key) {
      var cfg = SECTION_CFG[key];
      var section = sections[key] || {};
      var text = typeof section === 'string' ? section : (section.text || '');
      var status = (typeof section === 'object' && section.status) || 'stable';
      if (!text || !text.trim()) return;

      var delta = statusToDelta(status);
      var preview = text.split(/(?<=[.!?])\s/)[0] || text;
      if (preview.length > 110) preview = preview.slice(0, 107) + '...';
      // Numérico/curto vira display grande; texto longo fica em formato legível
      var isNumericPreview = preview.length <= 20 && /^[\sR$0-9.,%+\-]+$/.test(preview);
      var frontValueClass = isNumericPreview ? 'ai-flip-front-value is-numeric' : 'ai-flip-front-value';

      var card = document.createElement('button');
      card.type = 'button';
      card.className = 'ai-flip-card';
      card.setAttribute('data-key', key);
      card.setAttribute('aria-label', cfg.label);

      card.innerHTML =
        '<div class="ai-flip-inner">' +
          '<div class="ai-flip-face ai-flip-face--front">' +
            '<div class="ai-flip-front-head">' +
              '<span class="ai-flip-icon" style="background:' + cfg.tint + ';border-color:' + cfg.border + ';color:' + cfg.color + ';">' + cfg.icon + '</span>' +
              '<span class="ai-flip-front-label">' + escapeHtml(cfg.label.toUpperCase()) + '</span>' +
            '</div>' +
            '<div class="' + frontValueClass + '">' + boldifyNumbers(preview) + '</div>' +
            '<div class="ai-flip-front-foot">' +
              '<span class="ai-flip-delta ai-flip-delta--' + delta.cls + '">' + delta.icon + ' ' + escapeHtml(delta.label) + '</span>' +
              '<span class="ai-flip-hint">virar</span>' +
            '</div>' +
          '</div>' +
          '<div class="ai-flip-face ai-flip-face--back">' +
            '<div class="ai-flip-back-label">' + escapeHtml(cfg.label.toUpperCase()) + ' &middot; ANALISE</div>' +
            '<div class="ai-flip-back-text">' + boldifyNumbers(text) + '</div>' +
            '<div class="ai-flip-back-foot">toque para voltar</div>' +
          '</div>' +
        '</div>';

      card.addEventListener('click', function () {
        card.classList.toggle('flipped');
      });

      grid.appendChild(card);
    });

    show($('ai-flip-section'));
  }

  function buildInsightsList(data) {
    var list = $('ai-insights-list');
    if (!list) return;
    list.innerHTML = '';

    var items = [];
    if (data && Array.isArray(data.insights)) {
      items = data.insights;
    } else {
      if (data && data.cycle_summary) {
        items.push({ title: 'Resumo do ciclo', body: data.cycle_summary, tags: ['ciclo'] });
      }
    }

    if (!items.length) {
      hide($('ai-insights-section'));
      return;
    }

    items.forEach(function (raw) {
      var item;
      if (typeof raw === 'string') {
        item = { title: '', body: raw, tags: [] };
      } else {
        item = {
          title: raw.title || '',
          body:  raw.body  || raw.text || '',
          tags:  Array.isArray(raw.tags) ? raw.tags : []
        };
      }

      var node = document.createElement('div');
      node.className = 'ai-insight-item';
      var tagsHtml = item.tags.map(function (t) {
        return '<span class="loov-pill loov-pill--neutral">' + escapeHtml(t) + '</span>';
      }).join('');

      node.innerHTML =
        (item.title ? '<h3 class="ai-insight-item-title">' + escapeHtml(item.title) + '</h3>' : '') +
        '<p class="ai-insight-item-body">' + boldifyNumbers(item.body) + '</p>' +
        (tagsHtml ? '<div class="ai-insight-item-tags">' + tagsHtml + '</div>' : '');

      list.appendChild(node);
    });

    setText('ai-insights-count', items.length + ' INSIGHT' + (items.length === 1 ? '' : 'S'));
    show($('ai-insights-section'));
  }

  function applyDecision(data) {
    var card = $('ai-decision-card');
    var text = data && (data.decisao_prioritaria || (data.metrics && data.metrics.decision));
    if (text) {
      $('ai-decision-text').innerHTML = boldifyNumbers(text);
      show(card);
    } else {
      hide(card);
    }
  }

  function applyCycleLabel(data) {
    if (!data) { setText('ai-cycle-label', ''); return; }
    var bits = [];
    if (data.cycle_label)   bits.push(data.cycle_label);
    if (data.generated_at)  bits.push('Gerado em ' + data.generated_at);
    if (data.next_refresh)  bits.push('Proximo: ' + data.next_refresh + (data.days_remaining ? ' (' + data.days_remaining + 'd)' : ''));
    var el = $('ai-cycle-label');
    if (el) el.innerHTML = bits.map(function (b, i) {
      return (i === 0 ? '<strong>' + escapeHtml(b) + '</strong>' : escapeHtml(b));
    }).join(' &middot; ');
  }

  function applyOwnerInput(data) {
    var ta = $('ai-owner-input');
    var hasSaved = !!(data && (data.has_input || data.owner_input));
    if (ta && !state.inputDirty) {
      ta.value = (data && data.owner_input) || '';
      updateInputCount();
    }
    var pill = $('ai-input-saved-pill');
    if (pill) pill.setAttribute('data-shown', hasSaved ? 'true' : 'false');
    var btn = $('ai-input-save-btn');
    if (btn) {
      var len = ta ? ta.value.trim().length : 0;
      btn.disabled = (len === 0) || (!state.inputDirty && hasSaved);
    }
  }

  function updateInputCount() {
    var ta = $('ai-owner-input');
    var cnt = $('ai-input-count');
    if (!ta || !cnt) return;
    cnt.textContent = String(ta.value.length);
  }

  // ── Render orchestration ──────────────────────────────────────────────────

  function renderState() {
    var s = state.status;
    var data = state.data;

    if (s === 'unresolved') {
      show($('ai-unresolved-banner'));
      setGenerateButton('locked');
      setStatusBadge('error', 'Bloqueado');
    } else {
      hide($('ai-unresolved-banner'));
    }

    if (s === 'loading') {
      setStatusBadge('idle', 'Carregando');
      setGenerateButton('processing');
      hide($('ai-empty-state'));
      hide($('ai-flip-section'));
      hide($('ai-insights-section'));
      hide($('ai-decision-card'));
      hide($('ai-error-banner'));
      hide($('ai-footer-note'));
      hide($('ai-loading-skeleton'));
      return;
    }

    if (s === 'processing') {
      setStatusBadge('processing', 'Processando');
      setGenerateButton('processing');
      show($('ai-loading-skeleton'));
      hide($('ai-empty-state'));
      hide($('ai-flip-section'));
      hide($('ai-insights-section'));
      hide($('ai-decision-card'));
      hide($('ai-error-banner'));
      hide($('ai-footer-note'));
      return;
    }

    if (s === 'error') {
      setStatusBadge('error', 'Erro');
      setGenerateButton(data && (data.sections || data.metrics) ? 'update' : 'idle');
      show($('ai-error-banner'));
      hide($('ai-loading-skeleton'));
      hide($('ai-empty-state'));
      return;
    }

    if (s === 'idle' || s === 'needs_generation' || s === 'unresolved') {
      hide($('ai-loading-skeleton'));
      hide($('ai-flip-section'));
      hide($('ai-insights-section'));
      hide($('ai-decision-card'));
      hide($('ai-footer-note'));
      if (s === 'unresolved') return;
      setStatusBadge('idle', 'Sem analise');
      setGenerateButton('idle');
      show($('ai-empty-state'));
      hide($('ai-error-banner'));
      return;
    }

    if (s === 'ready') {
      setStatusBadge('ready', 'Pronto');
      setGenerateButton('update');
      hide($('ai-loading-skeleton'));
      hide($('ai-empty-state'));
      hide($('ai-error-banner'));
      applyDecision(data);
      buildFlipCards(data);
      buildInsightsList(data);
      applyCycleLabel(data);
      applyOwnerInput(data);
      var note = $('ai-footer-note');
      if (note && data && data.generated_at) {
        note.textContent = 'Analise gerada em ' + data.generated_at;
        show(note);
      } else {
        hide(note);
      }
      return;
    }
  }

  function applyResponse(json) {
    var s = json && json.status;
    if (s === 'ready') {
      state.status = 'ready';
      state.data   = json;
    } else if (s === 'processing') {
      state.status = 'processing';
      startPolling();
    } else if (s === 'error') {
      state.status = 'error';
      state.data   = json;
      var msg = json.message || json.error_message || 'Nao foi possivel gerar a analise.';
      setText('ai-error-message', msg);
    } else {
      state.status = 'idle';
      state.data   = null;
    }
    applyCycleLabel(json);
    applyOwnerInput(json);
    renderState();
  }

  // ── Polling ───────────────────────────────────────────────────────────────

  function startPolling() {
    if (state.polling) return;
    state.polling = true;
    var tick = function () {
      jsonFetch(endpoints.status)
        .then(function (r) { return r.json(); })
        .then(function (json) {
          if (json.status === 'processing') {
            state.pollTimer = setTimeout(tick, 4000);
          } else {
            state.polling = false;
            state.pollTimer = null;
            applyResponse(json);
          }
        })
        .catch(function () {
          state.pollTimer = setTimeout(tick, 4000);
        });
    };
    state.pollTimer = setTimeout(tick, 4000);
    renderState();
  }

  function stopPolling() {
    state.polling = false;
    if (state.pollTimer) { clearTimeout(state.pollTimer); state.pollTimer = null; }
  }

  // ── Actions ───────────────────────────────────────────────────────────────

  function loadInitial() {
    state.status = 'loading';
    renderState();
    jsonFetch(endpoints.show)
      .then(function (r) { return r.json(); })
      .then(applyResponse)
      .catch(function () {
        state.status = 'error';
        setText('ai-error-message', 'Falha ao carregar a analise. Verifique sua conexao.');
        renderState();
      });
  }

  function generate(force) {
    var ta = $('ai-owner-input');
    var inputText = ta ? ta.value.trim() : '';
    var preflight = (state.inputDirty && inputText)
      ? saveInput(inputText, true)
      : Promise.resolve();

    preflight.then(function () {
      stopPolling();
      state.status = 'processing';
      hide($('ai-error-banner'));
      renderState();

      var url = endpoints.create + (force ? '?force=true' : '');
      return jsonFetch(url, { method: 'POST' });
    }).then(function (res) {
      return res.json().then(function (json) { return { ok: res.ok, status: res.status, json: json }; });
    }).then(function (out) {
      if (!out.ok) {
        if (out.json && out.json.code === 'unresolved_past') {
          state.status = 'unresolved';
          state.data = null;
          setText('ai-unresolved-text', out.json.error || 'Resolva pendencias no Dashboard antes de gerar a analise.');
          renderState();
          return;
        }
        state.status = 'error';
        setText('ai-error-message', (out.json && (out.json.error || out.json.message)) || 'Nao foi possivel gerar a analise.');
        renderState();
        return;
      }
      applyResponse(out.json);
    }).catch(function () {
      state.status = 'error';
      setText('ai-error-message', 'Falha de conexao. Tente novamente.');
      renderState();
    });
  }

  function saveInput(text, silent) {
    state.saving = true;
    var btn = $('ai-input-save-btn');
    if (btn) { btn.disabled = true; btn.textContent = 'Salvando...'; }
    return jsonFetch(endpoints.input, {
      method: 'POST',
      body:   JSON.stringify({ input: text })
    }).then(function (r) {
      if (!r.ok) throw new Error('save failed');
      return r.json();
    }).then(function () {
      state.saving = false;
      state.inputDirty = false;
      var pill = $('ai-input-saved-pill');
      if (pill) pill.setAttribute('data-shown', 'true');
      if (btn) { btn.textContent = 'Salvar foco'; btn.disabled = true; }
    }).catch(function () {
      state.saving = false;
      if (btn) { btn.textContent = 'Salvar foco'; btn.disabled = false; }
      if (!silent) {
        state.status = 'error';
        setText('ai-error-message', 'Nao foi possivel salvar o foco. Tente novamente.');
        renderState();
      }
    });
  }

  // ── Wiring ────────────────────────────────────────────────────────────────

  document.addEventListener('DOMContentLoaded', function () {
    var genBtn = $('ai-generate-btn');
    if (genBtn) {
      genBtn.addEventListener('click', function () {
        var hasData = state.data && (state.data.sections || state.data.metrics);
        generate(!!hasData);
      });
    }

    document.querySelectorAll('[data-ai-action="generate"]').forEach(function (el) {
      el.addEventListener('click', function () { generate(false); });
    });

    var ta = $('ai-owner-input');
    if (ta) {
      ta.addEventListener('input', function () {
        state.inputDirty = true;
        updateInputCount();
        var btn = $('ai-input-save-btn');
        if (btn) btn.disabled = ta.value.trim().length === 0;
        var pill = $('ai-input-saved-pill');
        if (pill) pill.setAttribute('data-shown', 'false');
      });
    }

    var saveBtn = $('ai-input-save-btn');
    if (saveBtn) {
      saveBtn.addEventListener('click', function () {
        var text = ta ? ta.value.trim() : '';
        if (!text) return;
        saveInput(text, false);
      });
    }

    loadInitial();
  });

  window.addEventListener('beforeunload', stopPolling);
})();
</script>
