        <div class="chart-wrap-sm"><canvas id="demandChart"></canvas></div>
      </div>
      <div class="flip-back">
        <div class="insight-eyebrow"><i class="fas fa-microchip"></i> Análise de IA</div>
        <div class="insight-meta" id="insight-meta-demand" style="display:none;"></div>
        <div class="insight-title">Demanda & Horários</div>
        <div class="insight-body" id="insight-body-demand"><div class="ai-loading"><span></span><span></span><span></span> Aguardando análise...</div></div>
        <button class="btn-flip-back" onclick="doFlip('demand')"><i class="fas fa-arrow-left"></i> Voltar</button>
      </div>
    </div>
  </div>

  <div class="two-col">
    <div class="flip-wrap" id="flip-retention" style="margin-bottom: 0;">
      <div class="flip-inner" id="flip-inner-retention">
        <div class="flip-front">
          <button class="flip-btn" onclick="doFlip('retention')" title="Análise com IA">+</button>
          <div class="card-title"><i class="fas fa-user-clock"></i> Retenção</div>
          <% if @at_risk_clients.any? %>
          <div style="font-size: 12.5px; color: var(--graphite); margin-bottom: 10px;">Clientes sem visita há 30–90 dias</div>
          <table class="risk-table">
            <thead><tr><th>Cliente</th><th>Última visita</th><th>Ausente</th></tr></thead>
            <tbody>
              <% @at_risk_clients.first(5).each do |c| %>
              <tr>
                <td><%= c[:cliente] %></td>
                <td style="color: var(--ash); font-size: 12px;"><%= c[:ultima_visita] %></td>
                <td><span class="risk-days <%= c[:dias_ausente] > 60 ? 'high' : c[:dias_ausente] > 45 ? 'medium' : 'low' %>"><%= c[:dias_ausente] %>d</span></td>
              </tr>
              <% end %>
            </tbody>
          </table>
          <% if @lost_clients > 0 %>
          <div style="margin-top: 14px; padding-top: 10px; border-top: 1px solid var(--stone); font-size: 12.5px; color: var(--graphite);">
            + <strong style="color: var(--rose-500);"><%= @lost_clients %></strong> clientes perdidos (90+ dias)
          </div>
          <% end %>
          <% else %>
          <div style="padding: 28px 0; text-align: center; color: var(--graphite); font-size: 14px;">
            <i class="fas fa-check-circle" style="color: #2d6b42; font-size: 24px; display: block; margin-bottom: 8px;"></i>
            Nenhum cliente em risco
          </div>
          <% end %>
        </div>
        <div class="flip-back">
          <div class="insight-eyebrow"><i class="fas fa-microchip"></i> Análise de IA</div>
          <div class="insight-meta" id="insight-meta-retention" style="display:none;"></div>
          <div class="insight-title">Clientes em risco</div>
          <div class="insight-body" id="insight-body-retention"><div class="ai-loading"><span></span><span></span><span></span> Aguardando análise...</div></div>
          <button class="btn-flip-back" onclick="doFlip('retention')"><i class="fas fa-arrow-left"></i> Voltar</button>
        </div>
      </div>
    </div>

    <div class="flip-wrap" id="flip-growth" style="margin-bottom: 0;">
      <div class="flip-inner" id="flip-inner-growth">
        <div class="flip-front">
          <button class="flip-btn" onclick="doFlip('growth')" title="Análise com IA">+</button>
          <div class="card-title"><i class="fas fa-seedling"></i> Crescimento</div>
          <% if @new_clients_by_month.any? %>
          <% max_new=@new_clients_by_month.map{|e|e[:novos_clientes]}.max.to_f; max_new=1 if max_new.zero?; month_names={"01"=>"Jan","02"=>"Fev","03"=>"Mar","04"=>"Abr","05"=>"Mai","06"=>"Jun","07"=>"Jul","08"=>"Ago","09"=>"Set","10"=>"Out","11"=>"Nov","12"=>"Dez"} %>
          <div class="growth-bars">
            <% @new_clients_by_month.each_with_index do |e,i| %>
            <% pct=[(e[:novos_clientes].to_f/max_new*100).round,4].max;label=month_names[e[:mes].split("-").last]||e[:mes].split("-").last;is_cur=(i==@new_clients_by_month.length-1) %>
            <div class="growth-bar-wrap">
              <div class="growth-bar-value"><%= e[:novos_clientes] %></div>
              <div class="growth-bar <%= is_cur ? 'current' : '' %>" style="height: <%= pct %>%;"></div>
              <div class="growth-bar-label"><%= label %></div>
            </div>
            <% end %>
          </div>
          <div class="growth-kpis">
            <div class="growth-kpi"><div class="growth-kpi-label">Este mês</div><div class="growth-kpi-value"><%= @this_month_new %></div></div>
            <div class="growth-kpi"><div class="growth-kpi-label">Mês anterior</div><div class="growth-kpi-value"><%= @prev_month_new %></div></div>
            <div class="growth-kpi"><div class="growth-kpi-label">Variação</div><div class="growth-kpi-value" style="color: <%= @growth_rate && @growth_rate >= 0 ? 'var(--coral-500)' : 'var(--rose-500)' %>;"><%= @growth_rate ? "#{@growth_rate > 0 ? '+' : ''}#{@growth_rate}%" : "—" %></div></div>
          </div>
          <% else %>
          <div style="padding: 28px 0; text-align: center; color: var(--graphite); font-size: 14px;">Dados insuficientes</div>
          <% end %>
        </div>
        <div class="flip-back">
          <div class="insight-eyebrow"><i class="fas fa-microchip"></i> Análise de IA</div>
          <div class="insight-meta" id="insight-meta-growth" style="display:none;"></div>
          <div class="insight-title">Novos clientes</div>
          <div class="insight-body" id="insight-body-growth"><div class="ai-loading"><span></span><span></span><span></span> Aguardando análise...</div></div>
          <button class="btn-flip-back" onclick="doFlip('growth')"><i class="fas fa-arrow-left"></i> Voltar</button>
        </div>
      </div>
    </div>
  </div>

  <!-- TRANSAÇÕES -->
  <div class="fin-section">
    <div class="fin-section-header">
      <div class="card-title" style="margin-bottom: 0;"><i class="fas fa-list-ul"></i> Transações</div>
      <%= link_to owner_financial_tracking_path(request.query_parameters.merge(format: "csv")), class: "btn-csv" do %>
        <i class="fas fa-download"></i> Exportar CSV
      <% end %>
    </div>
    <% if @transactions.any? %>
    <div style="overflow-x: auto;">
      <table class="fin-table">
        <thead><tr><th>Data</th><th>Horário</th><th>Cliente</th><th>Serviço</th><th>Valor</th></tr></thead>
        <tbody>
          <% @transactions.each_with_index do |t, i| %>
          <tr class="<%= i >= 5 ? 'hidden-row txn-extra' : '' %>">
            <td class="td-muted"><%= t.scheduled_at.strftime("%d/%m/%Y") %></td>
            <td><span class="badge badge-lime"><%= t.scheduled_at.strftime("%H:%M") %></span></td>
            <td><%= t.user_email %></td>
            <td><%= t.service_title %></td>
