  <% end %>

  <div style="margin-top: 28px;">
    <%= link_to owner_car_wash_appointments_path, class: "loov-btn-secondary" do %>
      <i class="fas fa-arrow-left"></i> Agendamentos
    <% end %>
  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
  var periodSelect=document.getElementById('period_select'),customDates=document.getElementById('custom-dates');
  if(periodSelect){periodSelect.addEventListener('change',function(){customDates.classList.toggle('visible',this.value==='custom');});}

  var chartDefaults={color:'#ada699',font:{family:'Inter',size:11}};
  var salesLabels=<%= raw json_escape(@chart_data.map{|d|d[:date]}.to_json) %>;
  var salesValues=<%= raw json_escape(@chart_data.map{|d|d[:value]}.to_json) %>;
  var confirmedValues=<%= raw json_escape(@confirmed_chart_data.map{|d|d[:value]}.to_json) %>;
  var svcData=<%= raw json_escape(@services_performance.to_json) %>;
  var demandData=<%= raw json_escape(@demand_by_dow.to_json) %>;
  var heatmapData=<%= raw json_escape(@heatmap.to_json) %>;

  function fmtBRL(v){return'R$ '+v.toLocaleString('pt-BR',{minimumFractionDigits:0,maximumFractionDigits:0});}

  function peakHoursForDow(dow){var hours=heatmapData.filter(function(d){return d.dow===dow;}).sort(function(a,b){return b.count-a.count;});if(!hours.length)return null;var topCount=hours[0].count;var top=hours.filter(function(h){return h.count>=topCount*0.7;}).map(function(h){return h.hour;}).sort(function(a,b){return a-b;});if(!top.length)return null;var min=top[0],max=top[top.length-1];return min===max?min+'h':min+'h–'+(max+1)+'h';}

  var salesCtx=document.getElementById('salesChart');
  if(salesCtx){var hasConfirmed=confirmedValues.some(function(v){return v>0;});var datasets=[{label:'Efetivados (R$)',data:salesValues,borderColor:'#dd7852',backgroundColor:'rgba(221, 120, 82,0.08)',borderWidth:2.5,fill:true,tension:0.4,pointBackgroundColor:'#dd7852',pointBorderColor:'#fefefd',pointBorderWidth:2,pointRadius:4,pointHoverRadius:6,order:1}];if(hasConfirmed){datasets.push({label:'Agendados (R$)',data:confirmedValues,borderColor:'#d6b14a',backgroundColor:'rgba(214,177,74,0.06)',borderWidth:2,borderDash:[5,4],fill:false,tension:0.4,pointBackgroundColor:'#d6b14a',pointBorderColor:'#fefefd',pointBorderWidth:2,pointRadius:3,pointHoverRadius:5,order:2});}new Chart(salesCtx,{type:'line',data:{labels:salesLabels,datasets:datasets},options:{responsive:true,maintainAspectRatio:false,interaction:{intersect:false,mode:'index'},plugins:{legend:{display:hasConfirmed,labels:{color:'#575148',font:{family:'Inter',size:12},boxWidth:12}},tooltip:{backgroundColor:'#fefefd',borderColor:'#e0dbd0',borderWidth:1,titleColor:'#dd7852',bodyColor:'#28231c',padding:12,callbacks:{label:function(c){return' '+c.dataset.label+': R$ '+c.parsed.y.toFixed(2);}}}},scales:{x:{grid:{color:'rgba(40, 35, 28,0.04)'},ticks:chartDefaults},y:{beginAtZero:true,grid:{color:'rgba(40, 35, 28,0.04)'},ticks:{...chartDefaults,callback:function(v){return fmtBRL(v);}}}}}}); }

  var servicesCtx=document.getElementById('servicesChart');
  if(servicesCtx&&svcData.length>0){new Chart(servicesCtx,{type:'bar',data:{labels:svcData.map(function(s){return s.title;}),datasets:[{label:'Receita (R$)',data:svcData.map(function(s){return s.revenue;}),backgroundColor:'rgba(221, 120, 82,0.75)',borderRadius:6,yAxisID:'y'},{label:'Volume',data:svcData.map(function(s){return s.count;}),backgroundColor:'rgba(221, 120, 82,0.25)',borderRadius:6,yAxisID:'y1'}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{labels:{color:'#575148',font:{family:'Inter',size:12}}},tooltip:{backgroundColor:'#fefefd',borderColor:'#e0dbd0',borderWidth:1,titleColor:'#dd7852',bodyColor:'#28231c',padding:10,callbacks:{label:function(c){return c.dataset.yAxisID==='y'?' Receita: '+fmtBRL(c.parsed.y):' Volume: '+c.parsed.y+' serviços';}}}},scales:{x:{grid:{display:false},ticks:chartDefaults},y:{beginAtZero:true,grid:{color:'rgba(40, 35, 28,0.04)'},ticks:{...chartDefaults,callback:function(v){return fmtBRL(v);}}},y1:{beginAtZero:true,position:'right',grid:{display:false},ticks:chartDefaults}}}});}

  var clientsCtx=document.getElementById('clientsChart');
  if(clientsCtx){new Chart(clientsCtx,{type:'doughnut',data:{labels:['Recorrentes','Novos'],datasets:[{data:[<%= @recurring_clients %>,<%= @new_clients %>],backgroundColor:['#dd7852','#ada699'],borderColor:['#dd7852','#575148'],borderWidth:1}]},options:{responsive:true,maintainAspectRatio:false,cutout:'72%',plugins:{legend:{display:false},tooltip:{backgroundColor:'#fefefd',borderColor:'#e0dbd0',borderWidth:1,titleColor:'#dd7852',bodyColor:'#28231c',padding:10}}}});}

  var demandCtx=document.getElementById('demandChart');
  if(demandCtx&&demandData.length>0){var dayNames=['Dom','Seg','Ter','Qua','Qui','Sex','Sáb'];var demandCounts=[0,0,0,0,0,0,0];demandData.forEach(function(d){demandCounts[d.dow]=d.count;});var maxVal=Math.max.apply(null,demandCounts);new Chart(demandCtx,{type:'bar',data:{labels:dayNames,datasets:[{label:'Atendimentos',data:demandCounts,backgroundColor:demandCounts.map(function(v){return v===maxVal&&maxVal>0?'#dd7852':'rgba(221, 120, 82,0.25)';}),borderRadius:6}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{backgroundColor:'#fefefd',borderColor:'#e0dbd0',borderWidth:1,titleColor:'#dd7852',bodyColor:'#28231c',padding:12,callbacks:{title:function(items){return dayNames[items[0].dataIndex];},label:function(c){var lines=[' '+c.parsed.y+' atendimentos'];var peak=peakHoursForDow(c.dataIndex);if(peak)lines.push(' ⏰ Pico: '+peak);return lines;}}}},scales:{x:{grid:{display:false},ticks:chartDefaults},y:{beginAtZero:true,grid:{color:'rgba(40, 35, 28,0.04)'},ticks:chartDefaults}}}});}

  loadCycleStatus();
});

var insightCache={},cycleData=null;

function loadCycleStatus(){fetch('/owner/ai_insights?type=sales',{headers:{'X-CSRF-Token':document.querySelector('meta[name="csrf-token"]').getAttribute('content')}}).then(function(r){return r.json();}).then(function(data){if(data.cached||data.insight){cycleData=data;showCycleBanner(data);if(data.action_of_the_week)showActionBanner(data.action_of_the_week);}}).catch(function(){});}

function showCycleBanner(data){var banner=document.getElementById('cycleBanner'),dates=document.getElementById('cycleDates'),summary=document.getElementById('cycleSummary'),btnLabel=document.getElementById('btnInputLabel'),btn=document.getElementById('btnInput');if(!data.generated_at)return;dates.textContent='Gerado em '+data.generated_at+' · próxima em '+data.next_refresh;if(data.cycle_summary)summary.textContent=data.cycle_summary;if(data.days_remaining<=0){btnLabel.textContent='Fechar ciclo';btn.className='btn-input';}else if(data.has_input){btnLabel.textContent='Input salvo ✓';btn.className='btn-input saved';btn.onclick=null;}else{btnLabel.textContent='Registrar resultado';btn.className='btn-input';}banner.style.display='flex';}

function showActionBanner(text){var banner=document.getElementById('actionBanner'),el=document.getElementById('actionText');if(!text||!banner)return;el.textContent=text;banner.style.display='block';}

function openInputModal(){document.getElementById('inputModal').classList.add('open');}
function closeInputModal(){document.getElementById('inputModal').classList.remove('open');}

function saveOwnerInput(){var text=document.getElementById('ownerInputText').value.trim();if(!text)return;fetch('/owner/ai_insights/input',{method:'POST',headers:{'Content-Type':'application/json','X-CSRF-Token':document.querySelector('meta[name="csrf-token"]').getAttribute('content')},body:JSON.stringify({input:text})}).then(function(r){return r.json();}).then(function(data){if(data.ok){closeInputModal();document.getElementById('btnInputLabel').textContent='Input salvo ✓';document.getElementById('btnInput').className='btn-input saved';document.getElementById('btnInput').onclick=null;}}).catch(function(){});}

function doFlip(id){var inner=document.getElementById('flip-inner-'+id),wrap=document.getElementById('flip-'+id),isFlipped=inner.classList.toggle('flipped');if(isFlipped){var frontH=inner.querySelector('.flip-front').offsetHeight,back=inner.querySelector('.flip-back');back.style.height=frontH+'px';wrap.style.height=frontH+'px';loadInsight(id,false);}else{wrap.style.height='';inner.querySelector('.flip-back').scrollTop=0;}}

function loadInsight(type,force){var bodyEl=document.getElementById('insight-body-'+type),metaEl=document.getElementById('insight-meta-'+type);if(insightCache[type]&&!force){renderInsight(type,insightCache[type]);return;}bodyEl.innerHTML='<div class="ai-loading"><span></span><span></span><span></span> Analisando '+getLabel(type)+'...</div>';metaEl.style.display='none';fetch('/owner/ai_insights',{method:'POST',headers:{'Content-Type':'application/json','X-CSRF-Token':document.querySelector('meta[name="csrf-token"]').getAttribute('content')},body:JSON.stringify({type:type,force:force?'true':'false'})}).then(function(r){return r.json();}).then(function(data){if(data.insight){insightCache[type]=data;if(!cycleData){cycleData=data;showCycleBanner(data);}if(data.action_of_the_week)showActionBanner(data.action_of_the_week);renderInsight(type,data);}else{bodyEl.innerHTML='<p>Não foi possível gerar o insight agora.</p>';}}).catch(function(){bodyEl.innerHTML='<p>Erro de conexão. Tente novamente.</p>';});}

function renderInsight(type,data){var bodyEl=document.getElementById('insight-body-'+type),metaEl=document.getElementById('insight-meta-'+type),text=data.insight||'',status=data.status||'stable',genDate=data.generated_at||null,nextDate=data.next_refresh||null,daysLeft=data.days_remaining!==undefined?data.days_remaining:null;var statusMap={up:'<span class="status-badge status-up"><i class="fas fa-arrow-up"></i> Subindo</span>',down:'<span class="status-badge status-down"><i class="fas fa-arrow-down"></i> Queda</span>',stable:'<span class="status-badge status-stable"><i class="fas fa-minus"></i> Estável</span>'};var paragraphs=text.split('\n').filter(function(p){return p.trim().length>0;});bodyEl.innerHTML=paragraphs.map(function(p){var h=p.replace(/R\$\s?[\d.,]+/g,'<strong>$&</strong>').replace(/\d+[\.,]\d+%/g,'<strong>$&</strong>').replace(/\d+%/g,'<strong>$&</strong>');return'<p>'+h+'</p>';}).join('');if(genDate&&nextDate){var refreshBtn=(daysLeft!==null&&daysLeft>0)?'<button class="btn-refresh" disabled>⏳ Nova em '+daysLeft+' dias</button>':'<button class="btn-refresh" onclick="forceRefresh(\''+type+'\')">↻ Gerar nova</button>';metaEl.innerHTML='<div class="insight-meta-left"><span class="insight-meta-date">Gerado em <strong>'+genDate+'</strong> &middot; próxima em <strong>'+nextDate+'</strong></span>'+(statusMap[status]||statusMap['stable'])+'</div>'+refreshBtn;metaEl.style.display='flex';}setTimeout(function(){var inner=document.getElementById('flip-inner-'+type),wrap=document.getElementById('flip-'+type);if(!inner||!wrap)return;var frontH=inner.querySelector('.flip-front').offsetHeight,back=inner.querySelector('.flip-back');back.style.height=frontH+'px';wrap.style.height=frontH+'px';back.scrollTop=0;},60);}

function forceRefresh(type){insightCache={};loadInsight(type,true);}
function getLabel(type){return{sales:'vendas',services:'serviços',clients:'clientes',demand:'demanda',retention:'retenção',growth:'crescimento'}[type]||'dados';}

function verMais(type){var rows=document.querySelectorAll(type==='txn'?'.txn-extra':'.day-extra'),btn=document.getElementById('btn-ver-mais-'+type),isOpen=btn&&btn.dataset.open==='1';rows.forEach(function(r){r.classList.toggle('hidden-row',isOpen);});if(btn){if(isOpen){btn.dataset.open='0';btn.innerHTML='<i class="fas fa-chevron-down"></i> Ver mais '+rows.length+(type==='txn'?' transações':' dias');}else{btn.dataset.open='1';btn.innerHTML='<i class="fas fa-chevron-up"></i> Ver menos';}}}
</script>

