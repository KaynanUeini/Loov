<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
// ─── CSRF helper ────────────────────────────────────────
function csrfToken() {
  var m = document.querySelector('meta[name="csrf-token"]');
  return m ? m.getAttribute('content') : '';
}
function authedFetch(url, opts) {
  opts = opts || {};
  opts.headers = Object.assign({
    'Accept': 'application/json',
    'Content-Type': 'application/json',
    'X-CSRF-Token': csrfToken()
  }, opts.headers || {});
  return fetch(url, opts);
}

// ─── Period select toggle ───────────────────────────────
document.addEventListener('DOMContentLoaded', function() {
  var periodSelect = document.getElementById('period_select');
  var customDates  = document.getElementById('custom-dates');
  if (periodSelect) {
    periodSelect.addEventListener('change', function() {
      customDates.classList.toggle('visible', this.value === 'custom');
    });
  }

  // ── Charts ────────────────────────────────────────────
  var chartDefaults = { color: '#ada699', font: { family: 'Inter', size: 11 } };
  var salesLabels = <%= raw json_escape(@chart_data.map { |d| d[:date] }.to_json) %>;
  var salesValues = <%= raw json_escape(@chart_data.map { |d| d[:value] }.to_json) %>;
  var confirmedValues = <%= raw json_escape(@confirmed_chart_data.map { |d| d[:value] }.to_json) %>;
  var svcData = <%= raw json_escape(@services_performance.to_json) %>;
  var demandData = <%= raw json_escape(@demand_by_dow.to_json) %>;
  var heatmapData = <%= raw json_escape(@heatmap.to_json) %>;

  function fmtBRL(v) { return 'R$ ' + v.toLocaleString('pt-BR', { minimumFractionDigits: 0, maximumFractionDigits: 0 }); }

  function peakHoursForDow(dow) {
    var hours = heatmapData.filter(function(d) { return d.dow === dow; })
      .sort(function(a, b) { return b.count - a.count; });
    if (!hours.length) return null;
    var topCount = hours[0].count;
    var top = hours.filter(function(h) { return h.count >= topCount * 0.7; })
      .map(function(h) { return h.hour; })
      .sort(function(a, b) { return a - b; });
    if (!top.length) return null;
    var min = top[0], max = top[top.length - 1];
    return min === max ? min + 'h' : min + 'h–' + (max + 1) + 'h';
  }

  var salesCtx = document.getElementById('salesChart');
  if (salesCtx) {
    var hasConfirmed = confirmedValues.some(function(v) { return v > 0; });
    var datasets = [{
      label: 'Efetivados', data: salesValues,
      borderColor: '#dd7852', backgroundColor: 'rgba(221, 120, 82, 0.10)',
      borderWidth: 2.5, fill: true, tension: 0.4,
      pointBackgroundColor: '#dd7852', pointBorderColor: '#fefefd',
      pointBorderWidth: 2, pointRadius: 4, pointHoverRadius: 6, order: 1
    }];
    if (hasConfirmed) {
      datasets.push({
        label: 'Em aberto', data: confirmedValues,
        borderColor: '#d6b14a', backgroundColor: 'rgba(214, 177, 74, 0.06)',
        borderWidth: 2, borderDash: [5, 4], fill: false, tension: 0.4,
        pointBackgroundColor: '#d6b14a', pointBorderColor: '#fefefd',
        pointBorderWidth: 2, pointRadius: 3, pointHoverRadius: 5, order: 2
      });
    }
    new Chart(salesCtx, {
      type: 'line',
      data: { labels: salesLabels, datasets: datasets },
      options: {
        responsive: true, maintainAspectRatio: false,
        interaction: { intersect: false, mode: 'index' },
        plugins: {
          legend: { display: false },
          tooltip: {
            backgroundColor: '#fefefd', borderColor: '#e0dbd0', borderWidth: 1,
            titleColor: '#28231c', bodyColor: '#28231c', padding: 12,
            callbacks: { label: function(c) { return ' ' + c.dataset.label + ': R$ ' + c.parsed.y.toFixed(2); } }
          }
        },
        scales: {
          x: { grid: { color: 'rgba(40, 35, 28, 0.04)' }, ticks: chartDefaults },
          y: { beginAtZero: true, grid: { color: 'rgba(40, 35, 28, 0.04)' },
               ticks: Object.assign({}, chartDefaults, { callback: function(v) { return fmtBRL(v); } }) }
        }
      }
    });
  }

  var servicesCtx = document.getElementById('servicesChart');
  if (servicesCtx && svcData.length > 0) {
    new Chart(servicesCtx, {
      type: 'bar',
      data: {
        labels: svcData.map(function(s) { return s.title; }),
        datasets: [
          { label: 'Receita', data: svcData.map(function(s) { return s.revenue; }), backgroundColor: 'rgba(221, 120, 82, 0.85)', borderRadius: 6, yAxisID: 'y' },
          { label: 'Volume',  data: svcData.map(function(s) { return s.count;   }), backgroundColor: 'rgba(173, 166, 153, 0.65)', borderRadius: 6, yAxisID: 'y1' }
        ]
      },
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: {
          legend: { labels: { color: '#575148', font: { family: 'Inter', size: 11 } } },
          tooltip: {
            backgroundColor: '#fefefd', borderColor: '#e0dbd0', borderWidth: 1,
            titleColor: '#28231c', bodyColor: '#28231c', padding: 10,
            callbacks: { label: function(c) { return c.dataset.yAxisID === 'y' ? ' Receita: ' + fmtBRL(c.parsed.y) : ' Volume: ' + c.parsed.y + ' serviços'; } }
          }
        },
        scales: {
          x: { grid: { display: false }, ticks: chartDefaults },
          y: { beginAtZero: true, grid: { color: 'rgba(40, 35, 28, 0.04)' },
               ticks: Object.assign({}, chartDefaults, { callback: function(v) { return fmtBRL(v); } }) },
          y1:{ beginAtZero: true, position: 'right', grid: { display: false }, ticks: chartDefaults }
        }
      }
    });
  }

  var clientsCtx = document.getElementById('clientsChart');
  if (clientsCtx) {
    new Chart(clientsCtx, {
      type: 'doughnut',
      data: {
        labels: ['Recorrentes', 'Novos'],
        datasets: [{
          data: [<%= @recurring_clients %>, <%= @new_clients %>],
          backgroundColor: ['#dd7852', '#ada699'],
          borderColor: ['#dd7852', '#575148'], borderWidth: 1
        }]
      },
      options: {
        responsive: true, maintainAspectRatio: false, cutout: '72%',
        plugins: { legend: { display: false }, tooltip: {
          backgroundColor: '#fefefd', borderColor: '#e0dbd0', borderWidth: 1,
          titleColor: '#28231c', bodyColor: '#28231c', padding: 10
        }}
      }
    });
  }

  var demandCtx = document.getElementById('demandChart');
  if (demandCtx && demandData.length > 0) {
    var dayNames = ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb'];
    var demandCounts = [0, 0, 0, 0, 0, 0, 0];
    demandData.forEach(function(d) { demandCounts[d.dow] = d.count; });
    var maxVal = Math.max.apply(null, demandCounts);
    new Chart(demandCtx, {
      type: 'bar',
      data: {
        labels: dayNames,
        datasets: [{
          label: 'Atendimentos', data: demandCounts,
          backgroundColor: demandCounts.map(function(v) { return v === maxVal && maxVal > 0 ? '#dd7852' : 'rgba(221, 120, 82, 0.25)'; }),
          borderRadius: 6
        }]
      },
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            backgroundColor: '#fefefd', borderColor: '#e0dbd0', borderWidth: 1,
            titleColor: '#28231c', bodyColor: '#28231c', padding: 12,
            callbacks: {
              title: function(items) { return dayNames[items[0].dataIndex]; },
              label: function(c) {
                var lines = [' ' + c.parsed.y + ' atendimentos'];
                var peak = peakHoursForDow(c.dataIndex);
                if (peak) lines.push(' Pico: ' + peak);
                return lines;
              }
            }
          }
        },
        scales: {
          x: { grid: { display: false }, ticks: chartDefaults },
          y: { beginAtZero: true, grid: { color: 'rgba(40, 35, 28, 0.04)' }, ticks: chartDefaults }
        }
      }
    });
  }

  loadCycleStatus();
});

// ─── DRE row toggle ─────────────────────────────────────
function toggleDreRow(rowId) {
  var body = document.getElementById(rowId);
  var chev = document.getElementById(rowId + '-chev');
  if (!body) return;
  body.classList.toggle('open');
  if (chev) chev.classList.toggle('open');
}

// ─── AI insights cycle banner ───────────────────────────
var insightCache = {}, cycleData = null;
function loadCycleStatus() {
  authedFetch('/owner/ai_insights?type=sales')
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (data.cached || data.insight) {
        cycleData = data;
        showCycleBanner(data);
        if (data.action_of_the_week) showActionBanner(data.action_of_the_week);
      }
    }).catch(function() {});
}
function showCycleBanner(data) {
  var banner   = document.getElementById('cycleBanner');
  var dates    = document.getElementById('cycleDates');
  var summary  = document.getElementById('cycleSummary');
  var btnLabel = document.getElementById('btnInputLabel');
  var btn      = document.getElementById('btnInput');
  if (!data.generated_at) return;
  dates.textContent = 'Gerado em ' + data.generated_at + ' · próxima em ' + data.next_refresh;
  if (data.cycle_summary) summary.textContent = data.cycle_summary;
  if (data.days_remaining <= 0) {
    btnLabel.textContent = 'Fechar ciclo'; btn.className = 'btn-input';
  } else if (data.has_input) {
    btnLabel.textContent = 'Input salvo ✓'; btn.className = 'btn-input saved'; btn.onclick = null;
  } else {
    btnLabel.textContent = 'Registrar resultado'; btn.className = 'btn-input';
  }
  banner.style.display = 'flex';
}
function showActionBanner(text) {
  var banner = document.getElementById('actionBanner');
  var el     = document.getElementById('actionText');
  if (!text || !banner) return;
  el.textContent = text; banner.style.display = 'block';
}
function openInputModal() { document.getElementById('inputModal').classList.add('open'); }
function closeInputModal() { document.getElementById('inputModal').classList.remove('open'); }
function saveOwnerInput() {
  var text = document.getElementById('ownerInputText').value.trim();
  if (!text) return;
  authedFetch('/owner/ai_insights/input', { method: 'POST', body: JSON.stringify({ input: text }) })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (data.ok) {
        closeInputModal();
        document.getElementById('btnInputLabel').textContent = 'Input salvo ✓';
        document.getElementById('btnInput').className = 'btn-input saved';
        document.getElementById('btnInput').onclick = null;
      }
    }).catch(function() {});
}

// ─── Flip cards ─────────────────────────────────────────
function doFlip(id) {
  var inner = document.getElementById('flip-inner-' + id);
  var wrap  = document.getElementById('flip-' + id);
  var isFlipped = inner.classList.toggle('flipped');
  if (isFlipped) {
    var frontH = inner.querySelector('.flip-front').offsetHeight;
    var back   = inner.querySelector('.flip-back');
    back.style.height = frontH + 'px';
    wrap.style.height = frontH + 'px';
    loadInsight(id, false);
  } else {
    wrap.style.height = '';
    inner.querySelector('.flip-back').scrollTop = 0;
  }
}
function loadInsight(type, force) {
  var bodyEl = document.getElementById('insight-body-' + type);
  var metaEl = document.getElementById('insight-meta-' + type);
  if (insightCache[type] && !force) { renderInsight(type, insightCache[type]); return; }
  bodyEl.innerHTML = '<div class="ai-loading"><span></span><span></span><span></span> Analisando ' + getLabel(type) + '...</div>';
  metaEl.style.display = 'none';
  authedFetch('/owner/ai_insights', { method: 'POST', body: JSON.stringify({ type: type, force: force ? 'true' : 'false' }) })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (data.insight) {
        insightCache[type] = data;
        if (!cycleData) { cycleData = data; showCycleBanner(data); }
        if (data.action_of_the_week) showActionBanner(data.action_of_the_week);
        renderInsight(type, data);
      } else {
        bodyEl.innerHTML = '<p>Não foi possível gerar o insight agora.</p>';
      }
    }).catch(function() { bodyEl.innerHTML = '<p>Erro de conexão. Tente novamente.</p>'; });
}
function renderInsight(type, data) {
  var bodyEl = document.getElementById('insight-body-' + type);
  var metaEl = document.getElementById('insight-meta-' + type);
  var text   = data.insight || '';
  var status = data.status || 'stable';
  var genDate = data.generated_at || null;
  var nextDate = data.next_refresh || null;
  var daysLeft = data.days_remaining !== undefined ? data.days_remaining : null;
  var statusMap = {
    up:     '<span class="status-badge status-up"><i class="fas fa-arrow-up"></i> Subindo</span>',
    down:   '<span class="status-badge status-down"><i class="fas fa-arrow-down"></i> Queda</span>',
    stable: '<span class="status-badge status-stable"><i class="fas fa-minus"></i> Estável</span>'
  };
  var paragraphs = text.split('\n').filter(function(p) { return p.trim().length > 0; });
  bodyEl.innerHTML = paragraphs.map(function(p) {
    var h = p.replace(/R\$\s?[\d.,]+/g, '<strong>$&</strong>')
             .replace(/\d+[\.,]\d+%/g, '<strong>$&</strong>')
             .replace(/\d+%/g, '<strong>$&</strong>');
    return '<p>' + h + '</p>';
  }).join('');
  if (genDate && nextDate) {
    var refreshBtn = (daysLeft !== null && daysLeft > 0)
      ? '<button class="btn-refresh" disabled>Nova em ' + daysLeft + ' dias</button>'
      : '<button class="btn-refresh" onclick="forceRefresh(\'' + type + '\')">Gerar nova</button>';
    metaEl.innerHTML = '<div class="insight-meta-left"><span class="insight-meta-date">Gerado em <strong>' + genDate + '</strong> &middot; próxima em <strong>' + nextDate + '</strong></span>' + (statusMap[status] || statusMap['stable']) + '</div>' + refreshBtn;
    metaEl.style.display = 'flex';
  }
  setTimeout(function() {
    var inner = document.getElementById('flip-inner-' + type);
    var wrap  = document.getElementById('flip-' + type);
    if (!inner || !wrap) return;
    var frontH = inner.querySelector('.flip-front').offsetHeight;
    var back   = inner.querySelector('.flip-back');
    back.style.height = frontH + 'px';
    wrap.style.height = frontH + 'px';
    back.scrollTop = 0;
  }, 60);
}
function forceRefresh(type) { insightCache = {}; loadInsight(type, true); }
function getLabel(type) {
  return { sales: 'vendas', services: 'serviços', clients: 'clientes',
           demand: 'demanda', retention: 'retenção', growth: 'crescimento' }[type] || 'dados';
}

// ─── Ver mais (transações + vendas-por-dia) ─────────────
function verMais(type) {
  var rows = document.querySelectorAll(type === 'txn' ? '.txn-extra' : '.day-extra');
  var btn  = document.getElementById('btn-ver-mais-' + type);
  var isOpen = btn && btn.dataset.open === '1';
  rows.forEach(function(r) { r.classList.toggle('hidden-row', isOpen); });
  if (btn) {
    if (isOpen) {
      btn.dataset.open = '0';
      btn.innerHTML = '<i class="fas fa-chevron-down"></i> Ver mais ' + rows.length + (type === 'txn' ? ' transações' : ' dias');
    } else {
      btn.dataset.open = '1';
      btn.innerHTML = '<i class="fas fa-chevron-up"></i> Ver menos';
    }
  }
}

// ─── COSTS MODAL (lança custos inline) ──────────────────
var costsModalState = { year: null, month: null, data: null };
var MES_NOMES = ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];

function abrirCustosDoMes(year, month) {
  costsModalState.year  = year;
  costsModalState.month = month;
  document.getElementById('costs-modal-subtitle').textContent = MES_NOMES[month - 1] + ' ' + year;
  document.getElementById('costs-modal-content').innerHTML =
    '<div class="costs-modal-loading"><i class="fas fa-circle-notch fa-spin" style="color: var(--coral-500); font-size: 22px;"></i><div style="margin-top: 8px; font-size: 13px;">Carregando…</div></div>';
  document.getElementById('costsModal').classList.add('open');

  authedFetch('/owner/monthly_costs/edit?year=' + year + '&month=' + month)
    .then(function(r) { return r.json(); })
    .then(function(data) {
      costsModalState.data = data;
      renderCostsModal(data);
    }).catch(function() {
      document.getElementById('costs-modal-content').innerHTML =
        '<div style="padding: 20px; text-align: center; color: var(--rose-500);">Falha ao carregar.</div>';
    });
}

function closeCostsModal() {
  document.getElementById('costsModal').classList.remove('open');
}

// ESC + click-on-overlay closes
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') closeCostsModal();
});
document.getElementById('costsModal').addEventListener('click', function(e) {
  if (e.target === this) closeCostsModal();
});

// ─── Cash-register mask (igual edit.html.erb) ───────────
function digitsToBRL(d) {
  if (!d) return '0,00';
  d = d.toString().replace(/\D/g, '').slice(0, 12) || '0';
  var c = parseInt(d, 10);
  var r = (c / 100).toFixed(2);
  var p = r.split('.');
  return p[0].replace(/\B(?=(\d{3})+(?!\d))/g, '.') + ',' + p[1];
}
function brlToFloat(s) {
  s = (s || '0,00').toString().replace(/\./g, '').replace(',', '.');
  return parseFloat(s) || 0;
}
function brlToDigits(s) {
  s = (s || '').toString().replace(/\D/g, '');
  return s;
}

function moneyFieldHTML(opts) {
  var pending = opts.pending ? ' pending' : '';
  var dis = opts.pending ? ' disabled' : '';
  var pendingTag = opts.pending
    ? '<div style="margin-top:4px;"><span style="display:inline-flex; align-items:center; gap:5px; font-family:\'JetBrains Mono\',monospace; font-size:9.5px; font-weight:700; letter-spacing:1.2px; color:var(--coral-700); background:var(--coral-50); border:1px solid var(--coral-100); border-radius:100px; padding:3px 9px; text-transform:uppercase;"><span style="width:6px; height:6px; border-radius:50%; background:var(--coral-500);"></span>AGUARDANDO APROVAÇÃO</span></div>'
    : '';
  return '' +
    '<div class="modal-money-row">' +
      '<div class="modal-money-label-col">' +
        '<span class="modal-money-label">' + opts.label + '</span>' +
        pendingTag +
      '</div>' +
      '<label class="modal-money-input-wrap' + pending + '">' +
        '<span class="modal-money-prefix">R$</span>' +
        '<input type="text" class="modal-money-input cost-input" inputmode="numeric" data-key="' + opts.key + '" value="' + digitsToBRL(brlToDigits(opts.value)) + '"' + dis + '>' +
      '</label>' +
    '</div>';
}

function customLineHTML(line, idx) {
  var pending = line.pending ? ' pending' : '';
  var dis = line.pending ? ' disabled' : '';
  var idAttr = line.id != null ? ' data-id="' + line.id + '"' : '';
  var amount = digitsToBRL(brlToDigits(line.amount));
  return '' +
    '<div class="modal-money-row" data-line-row="1" data-cost-type="' + line.cost_type + '"' + idAttr + '>' +
      '<input type="text" class="modal-line-name" placeholder="Nome" value="' + (line.name || '').replace(/"/g, '&quot;') + '" maxlength="60"' + dis +
        ' style="flex:1; min-width:0; background:var(--paper); border:1px solid var(--stone); border-radius:10px; padding:9px 10px; font-family:Inter; font-size:13px; color:var(--ink); outline:none;">' +
      '<label class="modal-money-input-wrap' + pending + '" style="width:120px;">' +
        '<span class="modal-money-prefix">R$</span>' +
        '<input type="text" class="modal-money-input modal-line-amount cost-input" inputmode="numeric" value="' + amount + '"' + dis + '>' +
      '</label>' +
      '<button type="button" onclick="removeModalLine(this)" style="width:30px; height:30px; border-radius:8px; background:var(--sand); border:1px solid var(--stone); color:var(--graphite); cursor:pointer;"><i class="fas fa-xmark"></i></button>' +
    '</div>';
}

function renderCostsModal(data) {
  var pendingFields = data.pending_fields || [];
  var pendingLineKeys = (data.pending_line_keys || []).map(String);
  var customLines = data.custom_lines || [];
  // Aplica `pending` flag em cada linha
  customLines = customLines.map(function(l) {
    var k = l.id != null ? String(l.id) : '';
    return Object.assign({}, l, { pending: l.pending || pendingLineKeys.indexOf(k) !== -1 });
  });

  // Legacy migration (se modal SEM pending, e other_fixed/other_variable existem)
  var legacyLines = [];
  if (!data.has_pending) {
    if (Number(data.other_fixed || 0) > 0) {
      legacyLines.push({ id: null, name: 'Outros fixos', amount: data.other_fixed, cost_type: 'fixed', pending: false, _legacy: true });
    }
    if (Number(data.other_variable || 0) > 0) {
      legacyLines.push({ id: null, name: 'Outros variáveis', amount: data.other_variable, cost_type: 'variable', pending: false, _legacy: true });
    }
  }
  customLines = customLines.concat(legacyLines);

  var fixed    = customLines.filter(function(l) { return l.cost_type === 'fixed'; });
  var variable = customLines.filter(function(l) { return l.cost_type === 'variable'; });

  // Migra `utilities` legado → electricity quando water/electricity == 0
  var hasNewUtils = Number(data.water || 0) > 0 || Number(data.electricity || 0) > 0;
  var electricityValue = data.electricity;
  if (!hasNewUtils && Number(data.utilities || 0) > 0) {
    electricityValue = data.utilities;
  }

  var bannerHtml = '';
  if (data.has_pending) {
    bannerHtml = '<div style="display:flex; align-items:center; gap:8px; background:var(--coral-50); border:1px solid var(--coral-100); border-radius:12px; padding:10px 12px; margin-bottom:10px;">' +
      '<span style="width:6px; height:6px; border-radius:50%; background:var(--coral-500);"></span>' +
      '<span style="font-size:12px; color:var(--coral-700);">Você tem alterações aguardando aprovação do dono nesse mês.</span>' +
      '</div>';
  }

  var html = bannerHtml +
    '<div class="costs-modal-group-label">FIXOS</div>' +
    moneyFieldHTML({ key: 'rent',        label: 'Aluguel',  value: data.rent,        pending: pendingFields.indexOf('rent') !== -1 }) +
    moneyFieldHTML({ key: 'salaries',    label: 'Salários', value: data.salaries,    pending: pendingFields.indexOf('salaries') !== -1 }) +
    moneyFieldHTML({ key: 'water',       label: 'Água',     value: data.water,       pending: pendingFields.indexOf('water') !== -1 }) +
    moneyFieldHTML({ key: 'electricity', label: 'Luz',      value: electricityValue, pending: pendingFields.indexOf('electricity') !== -1 }) +
    '<div id="modal-fixed-list">' + fixed.map(customLineHTML).join('') + '</div>' +
    '<button type="button" class="modal-add-line-btn" onclick="addModalLine(\'fixed\')"><i class="fas fa-plus"></i> Adicionar custo fixo</button>' +
    '<div class="costs-modal-group-label" style="margin-top:14px;">VARIÁVEIS</div>' +
    moneyFieldHTML({ key: 'products',    label: 'Produtos',    value: data.products,    pending: pendingFields.indexOf('products') !== -1 }) +
    moneyFieldHTML({ key: 'maintenance', label: 'Manutenção',  value: data.maintenance, pending: pendingFields.indexOf('maintenance') !== -1 }) +
    '<div id="modal-variable-list">' + variable.map(customLineHTML).join('') + '</div>' +
    '<button type="button" class="modal-add-line-btn" onclick="addModalLine(\'variable\')"><i class="fas fa-plus"></i> Adicionar custo variável</button>' +
    '<div class="costs-modal-group-label" style="margin-top:14px;">OBSERVAÇÕES</div>' +
    '<textarea id="modal-notes" placeholder="Opcional" style="width:100%; min-height:60px; background:var(--paper); border:1px solid var(--stone); border-radius:10px; padding:10px 12px; font-family:Inter; font-size:13px; color:var(--ink); resize:vertical; outline:none;"' +
    (pendingFields.indexOf('notes') !== -1 ? ' disabled' : '') + '>' + (data.notes || '') + '</textarea>';

  document.getElementById('costs-modal-content').innerHTML = html;

  // attach mask to all .cost-input
  document.querySelectorAll('#costs-modal-content .cost-input').forEach(function(el) {
    el.addEventListener('input', function() {
      this.value = digitsToBRL(this.value);
    });
  });
}

function addModalLine(type) {
  var listId = type === 'fixed' ? 'modal-fixed-list' : 'modal-variable-list';
  var list = document.getElementById(listId);
  var div = document.createElement('div');
  div.innerHTML = customLineHTML({ id: null, name: '', amount: '', cost_type: type, pending: false });
  var row = div.firstElementChild;
  list.appendChild(row);
  var input = row.querySelector('.modal-line-amount');
  if (input) input.addEventListener('input', function() { this.value = digitsToBRL(this.value); });
  var name = row.querySelector('.modal-line-name');
  if (name) name.focus();
}

function removeModalLine(btn) {
  var row = btn.closest('[data-line-row="1"]');
  if (row) row.remove();
}

function saveCostsModal() {
  var year = costsModalState.year, month = costsModalState.month;
  var content = document.getElementById('costs-modal-content');

  function val(key) {
    var el = content.querySelector('[data-key="' + key + '"]');
    if (!el || el.disabled) return null; // pending → não envia
    return brlToFloat(el.value);
  }

  var lines = [];
  content.querySelectorAll('[data-line-row="1"]').forEach(function(row) {
    if (row.querySelector('.modal-line-amount').disabled) return;
    var name = row.querySelector('.modal-line-name').value.trim();
    var amt  = brlToFloat(row.querySelector('.modal-line-amount').value);
    if (!name || amt <= 0) return;
    var idAttr = row.getAttribute('data-id');
    var line = {
      name: name.slice(0, 80),
      amount: amt,
      cost_type: row.getAttribute('data-cost-type')
    };
    if (idAttr) line.id = idAttr;
    lines.push(line);
  });

  // Notes
  var notesEl = document.getElementById('modal-notes');
  var notes   = notesEl && !notesEl.disabled ? notesEl.value : (costsModalState.data && costsModalState.data.notes) || '';

  var payload = {
    monthly_cost: {
      rent:           val('rent')        != null ? val('rent')        : (costsModalState.data.rent || 0),
      salaries:       val('salaries')    != null ? val('salaries')    : (costsModalState.data.salaries || 0),
      water:          val('water')       != null ? val('water')       : (costsModalState.data.water || 0),
      electricity:    val('electricity') != null ? val('electricity') : (costsModalState.data.electricity || 0),
      utilities:      0,
      other_fixed:    0,
      products:       val('products')    != null ? val('products')    : (costsModalState.data.products || 0),
      maintenance:    val('maintenance') != null ? val('maintenance') : (costsModalState.data.maintenance || 0),
      other_variable: 0,
      notes:          notes
    },
    custom_lines: lines
  };

  var btn = document.getElementById('costs-modal-confirm');
  btn.disabled = true;
  btn.textContent = 'Salvando…';

  authedFetch('/owner/monthly_costs/upsert?year=' + year + '&month=' + month, {
    method: 'POST', body: JSON.stringify(payload)
  })
    .then(function(r) { return r.json().catch(function() { return {}; }); })
    .then(function(data) {
      btn.disabled = false; btn.textContent = 'Salvar';
      if (data.ok || data.pending) {
        closeCostsModal();
        // recarrega a página pra refletir DRE
        window.location.reload();
      } else {
        alert(data.message || data.error || 'Falha ao salvar.');
      }
    }).catch(function() {
      btn.disabled = false; btn.textContent = 'Salvar';
      alert('Falha de conexão.');
    });
}
</script>

