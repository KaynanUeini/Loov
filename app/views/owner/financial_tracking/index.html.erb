          <tr><td colspan="3" style="padding: 0;"><button class="btn-ver-mais" id="btn-ver-mais-day" onclick="verMais('day')"><i class="fas fa-chevron-down"></i> Ver mais <%= @sales_by_day.count - 5 %> dias</button></td></tr>
