          <button class="flip-btn" onclick="doFlip('clients')" title="Análise com IA">+</button>
          <div class="card-title"><i class="fas fa-users"></i> Clientes</div>
          <div class="donut-wrap">
            <div class="donut-chart"><canvas id="clientsChart"></canvas></div>
            <div class="donut-legend">
              <div class="legend-item-row"><div class="legend-dot" style="background: #dd7852;"></div><div><div class="legend-text">Recorrentes</div><div class="legend-sub"><%= @recurring_clients %> (<%= @total_clients > 0 ? ((@recurring_clients.to_f / @total_clients) * 100).round : 0 %>%)</div></div></div>
              <div class="legend-item-row"><div class="legend-dot" style="background: #ada699;"></div><div><div class="legend-text">Novos</div><div class="legend-sub"><%= @new_clients %> (<%= @total_clients > 0 ? ((@new_clients.to_f / @total_clients) * 100).round : 0 %>%)</div></div></div>
            </div>
          </div>
          <% if @top_clients.any? %>
          <div class="top-clients-section">
            <div class="top-clients-label">Top clientes</div>
            <% @top_clients.each do |c| %>
            <div class="client-row"><span class="client-name"><%= c[:email] %></span><span class="client-count"><%= c[:count] %>x</span></div>
            <% end %>
          </div>
          <% end %>
        </div>
        <div class="flip-back">
          <div class="insight-eyebrow"><i class="fas fa-microchip"></i> Análise de IA</div>
          <div class="insight-meta" id="insight-meta-clients" style="display:none;"></div>
          <div class="insight-title">Retenção & Fidelização</div>
          <div class="insight-body" id="insight-body-clients"><div class="ai-loading"><span></span><span></span><span></span> Aguardando análise...</div></div>
          <button class="btn-flip-back" onclick="doFlip('clients')"><i class="fas fa-arrow-left"></i> Voltar</button>
        </div>
      </div>
    </div>
  </div>

