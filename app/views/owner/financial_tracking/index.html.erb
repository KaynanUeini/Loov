<% Rails.logger.info("Renderizando owner/financial_tracking/index.html.erb") %>

<style>
  /* ── CYCLE BANNER ────────────────────────────────────── */
  .cycle-banner {
    background: var(--paper); border: 1px solid var(--stone);
    border-radius: 16px; padding: 16px 22px;
    margin-bottom: 14px;
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 12px;
    box-shadow: 0 2px 6px rgba(25,20,15,0.04);
  }
  .cycle-banner-info { display: flex; flex-direction: column; gap: 3px; }
  .cycle-banner-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px; font-weight: 600; letter-spacing: 1.4px;
    color: var(--ash); text-transform: uppercase;
  }
  .cycle-banner-value {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 15px; font-weight: 700;
    color: var(--ink); letter-spacing: -0.2px;
  }
  .cycle-banner-summary {
    font-size: 13px; color: var(--graphite);
    line-height: 1.5; max-width: 540px;
  }

  /* ── ACTION BANNER ───────────────────────────────────── */
  .action-banner {
    background: var(--coral-50); border: 1px solid var(--coral-100);
    border-radius: 16px; padding: 16px 22px;
    margin-bottom: 22px; display: none;
  }
  .action-banner-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px; font-weight: 700; letter-spacing: 1.6px;
    color: var(--coral-700); text-transform: uppercase;
    margin-bottom: 6px;
    display: flex; align-items: center; gap: 6px;
  }
  .action-banner-text {
    font-size: 14px; color: var(--ink); line-height: 1.6;
  }

  .btn-input {
    display: inline-flex; align-items: center; gap: 6px;
    background: var(--coral-50); color: var(--coral-700);
    border: 1px solid var(--coral-100); border-radius: 100px;
    padding: 8px 16px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; font-weight: 700; letter-spacing: 1.2px;
    cursor: pointer; transition: all 0.2s ease;
    white-space: nowrap; text-transform: uppercase;
  }
  .btn-input:hover { background: var(--coral-500); color: var(--cream); border-color: var(--coral-500); }
  .btn-input.saved {
    color: var(--ash); border-color: var(--stone);
    background: transparent;
  }

  /* ── MODAL ───────────────────────────────────────────── */
  .modal-overlay {
    position: fixed; inset: 0;
    background: rgba(40, 35, 28, 0.45);
    backdrop-filter: blur(6px);
    z-index: 1000;
    display: flex; align-items: center; justify-content: center;
    padding: 22px; opacity: 0; pointer-events: none;
    transition: opacity 0.25s ease;
  }
  .modal-overlay.open { opacity: 1; pointer-events: all; }
  .modal-box {
    background: var(--paper); border: 1px solid var(--stone);
    border-radius: 22px; padding: 28px;
    width: 100%; max-width: 560px;
    display: flex; flex-direction: column; gap: 18px;
    transform: translateY(16px);
    transition: transform 0.25s cubic-bezier(.16,1,.3,1);
    box-shadow: 0 20px 60px rgba(25, 20, 15, 0.18);
  }
  .modal-overlay.open .modal-box { transform: translateY(0); }
  .modal-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 22px; font-weight: 700;
    color: var(--ink); letter-spacing: -0.4px;
  }
  .modal-sub {
    font-size: 13.5px; color: var(--graphite);
    line-height: 1.55; margin-top: -10px;
  }
  .modal-textarea {
    background: var(--paper); border: 1px solid var(--stone);
    border-radius: 12px; padding: 14px;
    font-family: 'Inter', sans-serif; font-size: 14px;
    color: var(--ink); resize: vertical; min-height: 140px;
    outline: none; transition: border-color 0.2s, box-shadow 0.2s;
  }
  .modal-textarea:focus {
    border-color: var(--coral-500);
    box-shadow: 0 0 0 3px rgba(220, 120, 82, 0.08);
  }
  .modal-textarea::placeholder { color: var(--ash); }
  .modal-actions { display: flex; gap: 10px; justify-content: flex-end; flex-wrap: wrap; }

  /* ── FILTER ──────────────────────────────────────────── */
  .filter-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 14px; align-items: end;
  }
  .custom-dates {
    display: none; grid-template-columns: 1fr 1fr;
    gap: 14px; margin-top: 14px; padding-top: 14px;
    border-top: 1px solid var(--stone);
  }
  .custom-dates.visible { display: grid; }

  /* ── KPI GRID ────────────────────────────────────────── */
  .kpi-grid {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 14px; margin-bottom: 18px;
  }
  .kpi-card-mini {
    background: var(--paper); border: 1px solid var(--stone);
    border-radius: 16px; padding: 18px;
    display: flex; flex-direction: column; gap: 6px;
    box-shadow: 0 2px 6px rgba(25, 20, 15, 0.04);
    position: relative; overflow: hidden;
  }
  .kpi-card-mini.accent::before {
    content: ''; position: absolute;
    left: 0; top: 0; bottom: 0; width: 3px;
    background: var(--coral-500);
  }
  .kpi-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px; font-weight: 600; letter-spacing: 1.4px;
    color: var(--ash); text-transform: uppercase;
  }
  .kpi-value {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 26px; font-weight: 700;
    color: var(--ink); line-height: 1; letter-spacing: -0.4px;
  }
  .kpi-value.lime { color: var(--coral-500); }
  .kpi-sub { font-size: 12px; color: var(--ash); }

  /* ── STATUS BADGES ───────────────────────────────────── */
  .status-badge {
    display: inline-flex; align-items: center; gap: 4px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px; font-weight: 700; letter-spacing: 1.2px;
    text-transform: uppercase;
    padding: 3px 10px; border-radius: 100px;
    border: 1px solid;
  }
  .status-up     { background: #d6ecde; color: #2d6b42; border-color: #b5d8c1; }
  .status-down   { background: #fdecec; color: var(--rose-500); border-color: #f5cccc; }
  .status-stable { background: #fbe2c0; color: #7a4814; border-color: #f0d0a0; }

  /* ── CHART LEGEND ────────────────────────────────────── */
  .chart-legend { display: flex; gap: 18px; margin-bottom: 12px; flex-wrap: wrap; }
  .chart-legend-item {
    display: flex; align-items: center; gap: 6px;
    font-size: 12.5px; color: var(--graphite);
  }
  .chart-legend-dot {
    width: 12px; height: 3px; border-radius: 2px;
  }

  /* ── FLIP CARDS ──────────────────────────────────────── */
  .flip-wrap { perspective: 1200px; margin-bottom: 16px; }

  .flip-inner {
    position: relative; transform-style: preserve-3d;
    transition: transform 0.55s cubic-bezier(.4, 0, .2, 1);
  }
  .flip-inner.flipped { transform: rotateY(180deg); }

  .flip-front, .flip-back {
    background: var(--paper); border: 1px solid var(--stone);
    border-radius: 20px; padding: 24px;
    backface-visibility: hidden; -webkit-backface-visibility: hidden;
    box-shadow: 0 2px 6px rgba(25, 20, 15, 0.04);
  }

  .flip-back {
    position: absolute; top: 0; left: 0;
    width: 100%; height: 100%;
    transform: rotateY(180deg);
    background: var(--sand); border-color: var(--coral-100);
    display: flex; flex-direction: column;
    justify-content: flex-start;
    box-sizing: border-box;
    overflow-y: auto;
    scrollbar-width: thin; scrollbar-color: var(--coral-300) transparent;
    padding-bottom: 28px;
  }
  .flip-back::-webkit-scrollbar { width: 4px; }
  .flip-back::-webkit-scrollbar-thumb { background: var(--coral-300); border-radius: 2px; }

  .flip-btn {
    position: absolute; top: 18px; right: 18px;
    width: 30px; height: 30px; border-radius: 50%;
    background: var(--coral-50); border: 1px solid var(--coral-100);
    color: var(--coral-700); font-size: 16px; font-weight: 700;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; transition: all 0.2s ease;
    line-height: 1; z-index: 2;
  }
  .flip-btn:hover {
    background: var(--coral-500); color: var(--cream);
    border-color: var(--coral-500);
    transform: scale(1.08);
  }

  .insight-eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px; font-weight: 700; letter-spacing: 1.6px;
    text-transform: uppercase; color: var(--coral-700);
    margin-bottom: 10px;
    display: flex; align-items: center; gap: 6px;
    flex-shrink: 0;
  }
  .insight-meta {
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 8px;
    margin-bottom: 14px; padding-bottom: 12px;
    border-bottom: 1px solid var(--stone);
    flex-shrink: 0;
  }
  .insight-meta-left {
    display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
  }
  .insight-meta-date {
    font-size: 11.5px; color: var(--graphite);
    letter-spacing: 0;
  }
  .insight-meta-date strong { color: var(--ink); }

  .btn-refresh {
    display: inline-flex; align-items: center; gap: 5px;
    background: transparent; color: var(--graphite);
    border: 1px solid var(--stone); border-radius: 100px;
    padding: 4px 11px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px; font-weight: 700; letter-spacing: 1.2px;
    cursor: pointer; transition: all 0.2s ease;
    text-transform: uppercase;
  }
  .btn-refresh:hover { border-color: var(--coral-500); color: var(--coral-700); }
  .btn-refresh:disabled { opacity: 0.45; cursor: not-allowed; }

  .insight-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 22px; font-weight: 700;
    color: var(--ink); line-height: 1.15;
    margin-bottom: 14px; letter-spacing: -0.4px;
    flex-shrink: 0;
  }
  .insight-body {
    font-size: 14px; color: var(--graphite);
    line-height: 1.65; margin-bottom: 18px;
  }
  .insight-body p { margin-bottom: 10px; }
  .insight-body p:last-child { margin-bottom: 0; }
  .insight-body strong { color: var(--ink); font-weight: 700; }

  .btn-flip-back {
    display: inline-flex; align-items: center; gap: 6px;
    background: var(--paper); color: var(--graphite);
    border: 1px solid var(--stone); border-radius: 100px;
    padding: 7px 14px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; font-weight: 600; letter-spacing: 1.2px;
    cursor: pointer; transition: all 0.2s ease;
    align-self: flex-start; flex-shrink: 0;
    text-transform: uppercase;
  }
  .btn-flip-back:hover { border-color: var(--coral-500); color: var(--coral-700); }

  .ai-loading {
    display: flex; align-items: center; gap: 6px;
    color: var(--graphite); font-size: 14px;
    padding: 14px 0;
  }
  .ai-loading span {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--coral-500);
    animation: aiPulse 1.2s ease-in-out infinite;
  }
  .ai-loading span:nth-child(1) { animation-delay: 0s; }
  .ai-loading span:nth-child(2) { animation-delay: 0.2s; }
  .ai-loading span:nth-child(3) { animation-delay: 0.4s; }
  @keyframes aiPulse {
    0%,80%,100% { opacity: 0.25; transform: scale(0.8); }
    40%         { opacity: 1; transform: scale(1); }
  }

  /* ── SECTION CARD ────────────────────────────────────── */
  .card-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 17px; font-weight: 700;
    color: var(--ink); letter-spacing: -0.2px;
    margin-bottom: 18px;
    display: flex; align-items: center; gap: 8px;
  }
  .card-title i { color: var(--coral-500); font-size: 14px; }

  .chart-wrap { position: relative; height: 280px; }
  .chart-wrap-sm { position: relative; height: 200px; }
  .two-col {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 16px; margin-bottom: 16px;
  }

  /* ── RETENÇÃO ────────────────────────────────────────── */
  .risk-table { width: 100%; border-collapse: collapse; margin-top: 6px; }
  .risk-table th {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px; font-weight: 700; letter-spacing: 1.2px;
    color: var(--graphite); text-transform: uppercase;
    padding: 8px 10px;
    border-bottom: 1px solid var(--stone);
    text-align: left;
  }
  .risk-table td {
    font-size: 13px; color: var(--ink);
    padding: 10px 10px;
    border-bottom: 1px solid var(--stone);
  }
  .risk-table tr:last-child td { border-bottom: none; }
  .risk-days {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14px; font-weight: 700;
    letter-spacing: -0.2px;
  }
  .risk-days.high   { color: var(--rose-500); }
  .risk-days.medium { color: #7a4814; }
  .risk-days.low    { color: #2d6b42; }

  /* ── CRESCIMENTO ─────────────────────────────────────── */
  .growth-bars {
    display: flex; align-items: flex-end; gap: 6px;
    height: 84px; margin: 14px 0;
  }
  .growth-bar-wrap {
    flex: 1; display: flex; flex-direction: column;
    align-items: center; gap: 4px;
    height: 100%; justify-content: flex-end;
  }
  .growth-bar {
    width: 100%; border-radius: 4px 4px 0 0;
    background: var(--coral-100);
    transition: height 0.5s ease; min-height: 4px;
  }
  .growth-bar.current { background: var(--coral-500); }
  .growth-bar-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9px; letter-spacing: 1px;
    color: var(--ash); text-align: center;
    white-space: nowrap; text-transform: uppercase;
  }
  .growth-bar-value {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 12px; font-weight: 700;
    color: var(--ink);
  }
  .growth-kpis {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 1px; background: var(--stone);
    border: 1px solid var(--stone);
    border-radius: 12px; overflow: hidden;
    margin-top: 14px;
  }
  .growth-kpi {
    background: var(--paper); padding: 12px 14px;
    display: flex; flex-direction: column; gap: 3px;
  }
  .growth-kpi-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9.5px; letter-spacing: 1.2px;
    color: var(--ash); text-transform: uppercase;
  }
  .growth-kpi-value {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 18px; font-weight: 700;
    color: var(--coral-500); letter-spacing: -0.3px;
  }

  /* ── DONUT + CLIENTES ────────────────────────────────── */
  .donut-wrap { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; }
  .donut-chart { position: relative; width: 140px; height: 140px; flex-shrink: 0; }
  .donut-legend { flex: 1; display: flex; flex-direction: column; gap: 10px; min-width: 130px; }
  .legend-item-row { display: flex; align-items: center; gap: 8px; }
  .legend-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
  .legend-text { font-size: 14px; color: var(--ink); font-weight: 500; }
  .legend-sub { font-size: 12px; color: var(--ash); }

  .client-row {
    display: flex; align-items: center; justify-content: space-between;
    padding: 10px 0;
    border-bottom: 1px solid var(--stone);
  }
  .client-row:last-child { border-bottom: none; }
  .client-name { font-size: 14px; color: var(--ink); font-weight: 500; }
  .client-count {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 15px; font-weight: 700;
    color: var(--coral-500); letter-spacing: -0.2px;
  }

  .top-clients-section {
    margin-top: 18px; padding-top: 14px;
    border-top: 1px solid var(--stone);
  }
  .top-clients-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px; font-weight: 600; letter-spacing: 1.4px;
    color: var(--ash); text-transform: uppercase;
    margin-bottom: 10px;
  }

  /* ── TABELA / TRANSAÇÕES ─────────────────────────────── */
  .fin-section {
    background: var(--paper); border: 1px solid var(--stone);
    border-radius: 20px; margin-bottom: 16px;
    overflow: hidden;
    box-shadow: 0 2px 6px rgba(25, 20, 15, 0.04);
  }
  .fin-section-header {
    padding: 18px 22px;
    border-bottom: 1px solid var(--stone);
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 12px;
  }

  .fin-table { width: 100%; border-collapse: collapse; }
  .fin-table thead th {
    padding: 12px 16px; text-align: left;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px; font-weight: 600; letter-spacing: 1.4px;
    color: var(--graphite); text-transform: uppercase;
    border-bottom: 1px solid var(--stone);
    background: var(--sand);
  }
  .fin-table tbody td {
    padding: 14px 16px; font-size: 13.5px;
    color: var(--ink);
    border-bottom: 1px solid var(--stone);
  }
  .fin-table tbody tr:last-child td { border-bottom: none; }
  .fin-table tbody tr:hover td { background: var(--sand); }
  .fin-table tbody tr.hidden-row { display: none; }

  .td-value {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14.5px; font-weight: 700;
    color: var(--coral-500); letter-spacing: -0.2px;
  }
  .td-muted { color: var(--ash); font-size: 12.5px; }

  .badge {
    display: inline-flex; align-items: center;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px; font-weight: 700; letter-spacing: 1px;
    padding: 3px 9px; border-radius: 100px;
    white-space: nowrap; text-transform: uppercase;
    border: 1px solid;
  }
  .badge-lime {
    background: var(--coral-50); color: var(--coral-700);
    border-color: var(--coral-100);
  }

  .btn-ver-mais {
    display: flex; align-items: center; justify-content: center; gap: 6px;
    width: 100%; padding: 14px;
    background: transparent; color: var(--graphite);
    border: none; border-top: 1px solid var(--stone);
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; font-weight: 600; letter-spacing: 1.2px;
    cursor: pointer; transition: all 0.2s ease;
    text-transform: uppercase;
  }
  .btn-ver-mais:hover { background: var(--sand); color: var(--coral-700); }

  .btn-csv {
    display: inline-flex; align-items: center; gap: 6px;
    background: var(--coral-50); color: var(--coral-700);
    border: 1px solid var(--coral-100); border-radius: 100px;
    padding: 8px 16px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; font-weight: 700; letter-spacing: 1.2px;
    cursor: pointer; transition: all 0.2s ease;
    text-decoration: none; white-space: nowrap;
    text-transform: uppercase;
  }
  .btn-csv:hover { background: var(--coral-500); color: var(--cream); border-color: var(--coral-500); }

  /* ── EMPTY ───────────────────────────────────────────── */
  .empty-state-card { text-align: center; padding: 60px 22px; }
  .empty-icon-lg { font-size: 38px; color: var(--stone); margin-bottom: 14px; }
  .empty-title-lg {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 22px; font-weight: 700;
    color: var(--ink); margin-bottom: 6px;
    letter-spacing: -0.3px;
  }
  .empty-text-lg { font-size: 14px; color: var(--graphite); margin-bottom: 22px; }

  @media (max-width: 768px) {
    .kpi-grid { grid-template-columns: repeat(2, 1fr); }
    .two-col { grid-template-columns: 1fr; }
    .filter-grid { grid-template-columns: 1fr 1fr; }
    .growth-kpis { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .kpi-grid { grid-template-columns: 1fr 1fr; }
    .filter-grid { grid-template-columns: 1fr; }
    .donut-wrap { flex-direction: column; }
  }
</style>

<!-- MODAL INPUT -->
<div class="modal-overlay" id="inputModal">
  <div class="modal-box">
    <div class="modal-title">Fechamento do ciclo</div>
    <div class="modal-sub">O que você tentou nas últimas 2 semanas? Pode ser algo que a análise sugeriu ou uma iniciativa própria. Qual foi o resultado? Esse registro orienta a próxima análise.</div>
    <textarea class="modal-textarea" id="ownerInputText" placeholder="Ex: Criei o combo Lavagem + Higienização por R$199, vendi 8 combos na primeira semana..."></textarea>
    <div class="modal-actions">
      <button class="loov-btn-ghost" onclick="closeInputModal()">Cancelar</button>
      <button class="loov-btn-primary" onclick="saveOwnerInput()">Salvar e fechar ciclo</button>
    </div>
  </div>
</div>

<div class="loov-page loov-page--wide">

  <div class="loov-hero">
    <div class="loov-eyebrow"><span class="dot"></span>Gestão Financeira</div>
    <h1 class="loov-h1">Análise <span class="accent">completa</span>.</h1>
    <p class="loov-lead">Acompanhe vendas, retenção, demanda e crescimento — com insights guiados por IA.</p>
  </div>

  <!-- CYCLE BANNER -->
  <div class="cycle-banner" id="cycleBanner" style="display:none;">
    <div class="cycle-banner-info">
      <div class="cycle-banner-label">Ciclo de análise</div>
      <div class="cycle-banner-value" id="cycleDates">—</div>
      <div class="cycle-banner-summary" id="cycleSummary"></div>
    </div>
    <button class="btn-input" id="btnInput" onclick="openInputModal()">
      <i class="fas fa-pen"></i> <span id="btnInputLabel">Fechar ciclo</span>
    </button>
  </div>

  <!-- AÇÃO DA SEMANA -->
  <div class="action-banner" id="actionBanner">
    <div class="action-banner-label"><i class="fas fa-bolt"></i> Ação desta semana</div>
    <div class="action-banner-text" id="actionText"></div>
  </div>

  <%= form_with url: owner_financial_tracking_path, method: :get, local: true do %>
  <div class="loov-card" style="margin-bottom: 22px;">
    <div class="filter-grid">
      <div class="loov-field" style="margin-bottom: 0;">
        <label class="loov-label">Período</label>
        <%= select_tag :period, options_for_select([["Hoje","day"],["Esta Semana","week"],["Este Mês","month"],["Este Ano","year"],["Tudo","all"],["Personalizado","custom"]], params[:period]), include_blank: "Selecione", class: "loov-input", id: "period_select" %>
      </div>
      <div class="loov-field" style="margin-bottom: 0;">
        <label class="loov-label">Serviço</label>
        <%= select_tag :service_filter, options_for_select(@service_options.map { |s| [s, s] }, params[:service_filter]), include_blank: "Todos", class: "loov-input" %>
      </div>
      <div class="loov-field" style="margin-bottom: 0;">
        <%= submit_tag "Filtrar", class: "loov-btn-primary loov-btn-block" %>
      </div>
    </div>
    <div class="custom-dates <%= params[:period] == 'custom' ? 'visible' : '' %>" id="custom-dates">
      <div class="loov-field" style="margin-bottom: 0;">
        <label class="loov-label">Data inicial</label>
        <%= date_field_tag :start_date, params[:start_date] || @start_date, class: "loov-input" %>
      </div>
      <div class="loov-field" style="margin-bottom: 0;">
        <label class="loov-label">Data final</label>
        <%= date_field_tag :end_date, params[:end_date] || @end_date, class: "loov-input" %>
      </div>
    </div>
  </div>
  <% end %>

  <%
    is_empty = (@sales_by_day.empty? && !@is_year_filter && !@is_all_filter && !@is_custom_filter) ||
               (@is_year_filter   && @sales_by_month.all? { |m| m.total_value.zero? }) ||
               (@is_all_filter    && @sales_by_year.all?  { |y| y.total_value.zero? }) ||
               (@is_custom_filter && @sales_by_month.all? { |m| m.total_value.zero? })
  %>

  <% if is_empty %>
  <div class="loov-card empty-state-card">
    <div class="empty-icon-lg"><i class="fas fa-chart-line"></i></div>
    <div class="empty-title-lg">Sem dados</div>
    <p class="empty-text-lg">Nenhum atendimento concluído encontrado para o período selecionado.</p>
    <%= link_to "Ver tudo", owner_financial_tracking_path, class: "loov-btn-secondary" %>
  </div>
  <% else %>

  <div class="kpi-grid">
    <div class="kpi-card-mini accent">
      <div class="kpi-label">Faturamento</div>
      <div class="kpi-value lime">R$ <%= number_with_precision(@total_sales, precision: 2) %></div>
      <div class="kpi-sub">clientes que compareceram</div>
    </div>
    <div class="kpi-card-mini">
      <div class="kpi-label">Atendimentos</div>
      <div class="kpi-value"><%= @total_appointments %></div>
      <div class="kpi-sub">concluídos no período</div>
    </div>
    <div class="kpi-card-mini">
      <div class="kpi-label">Ticket médio</div>
      <div class="kpi-value">R$ <%= number_with_precision(@total_appointments > 0 ? @total_sales / @total_appointments : 0, precision: 2) %></div>
      <div class="kpi-sub">por atendimento efetivado</div>
    </div>
    <div class="kpi-card-mini">
      <div class="kpi-label"><%= @average_label %></div>
      <div class="kpi-value">R$ <%= number_with_precision(@average_value, precision: 2) %></div>
      <div class="kpi-sub">média do período</div>
    </div>
  </div>

  <!-- FLIP: VENDAS -->
  <div class="flip-wrap" id="flip-sales">
    <div class="flip-inner" id="flip-inner-sales">
      <div class="flip-front">
        <button class="flip-btn" onclick="doFlip('sales')" title="Análise com IA">+</button>
        <div class="card-title"><i class="fas fa-chart-line"></i> Evolução de vendas</div>
        <div class="chart-legend">
          <div class="chart-legend-item"><div class="chart-legend-dot" style="background: #dd7852;"></div>Efetivados</div>
          <div class="chart-legend-item"><div class="chart-legend-dot" style="background: #d6b14a;"></div>Agendados</div>
        </div>
        <div class="chart-wrap"><canvas id="salesChart"></canvas></div>
      </div>
      <div class="flip-back">
        <div class="insight-eyebrow"><i class="fas fa-microchip"></i> Análise de IA</div>
        <div class="insight-meta" id="insight-meta-sales" style="display:none;"></div>
        <div class="insight-title">Vendas & Faturamento</div>
        <div class="insight-body" id="insight-body-sales"><div class="ai-loading"><span></span><span></span><span></span> Aguardando análise...</div></div>
        <button class="btn-flip-back" onclick="doFlip('sales')"><i class="fas fa-arrow-left"></i> Voltar</button>
      </div>
    </div>
  </div>

  <div class="two-col">
    <div class="flip-wrap" id="flip-services" style="margin-bottom: 0;">
      <div class="flip-inner" id="flip-inner-services">
        <div class="flip-front">
          <button class="flip-btn" onclick="doFlip('services')" title="Análise com IA">+</button>
          <div class="card-title"><i class="fas fa-spray-can-sparkles"></i> Serviços</div>
          <div class="chart-wrap-sm"><canvas id="servicesChart"></canvas></div>
        </div>
        <div class="flip-back">
          <div class="insight-eyebrow"><i class="fas fa-microchip"></i> Análise de IA</div>
          <div class="insight-meta" id="insight-meta-services" style="display:none;"></div>
          <div class="insight-title">Mix de serviços</div>
          <div class="insight-body" id="insight-body-services"><div class="ai-loading"><span></span><span></span><span></span> Aguardando análise...</div></div>
          <button class="btn-flip-back" onclick="doFlip('services')"><i class="fas fa-arrow-left"></i> Voltar</button>
        </div>
      </div>
    </div>

    <div class="flip-wrap" id="flip-clients" style="margin-bottom: 0;">
      <div class="flip-inner" id="flip-inner-clients">
