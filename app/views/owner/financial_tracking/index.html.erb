</style>

<%
  # ── Pré-cálculos derivados do controller (não muda ivars) ─────────
  car_wash = current_user.linked_car_wash

  # Custos do período (pro stat trio + lucro)
  total_costs_in_period = 0.0
  cur = @start_date.beginning_of_month
  while cur <= @end_date
    mc = car_wash&.monthly_costs&.find_by(year: cur.year, month: cur.month)
    if mc
      ms = [cur, @start_date].max
      me = [cur.end_of_month, @end_date].min
      days_overlap = (me - ms).to_i + 1
      days_in_month = Date.new(cur.year, cur.month, -1).day
      fraction = days_in_month > 0 ? (days_overlap.to_f / days_in_month) : 0
      total_costs_in_period += mc.total.to_f * fraction
    end
    cur = cur.next_month
  end

  # Em aberto (confirmados ainda não realizados) no período
  effective_from = [@start_date.beginning_of_day, Time.current].max
  open_revenue = 0.0
  if @end_date.end_of_day >= Time.current
    open_revenue = car_wash&.appointments
      &.where(status: "confirmed")
      &.where(scheduled_at: effective_from..@end_date.end_of_day)
      &.joins(:service)
      &.sum("services.price - COALESCE(appointments.commission_amount, 0)").to_f
  end

  period_profit = @total_sales - total_costs_in_period
  period_margin = @total_sales > 0 ? ((period_profit / @total_sales) * 100).round(1) : nil
  period_negative = period_profit < 0

  period_label =
    case params[:period]
    when "day"    then "Hoje · #{@start_date.strftime('%d/%m')}"
    when "week"   then "Semana · #{@start_date.strftime('%d/%m')} – #{@end_date.strftime('%d/%m')}"
    when "month"  then "#{MonthlyCost::MONTH_NAMES[@start_date.month - 1]} #{@start_date.year}"
    when "year"   then "Ano · #{@start_date.year}"
    when "all"    then "Desde #{@start_date.strftime('%d/%m/%Y')}"
    when "custom" then "#{@start_date.strftime('%d/%m/%y')} – #{@end_date.strftime('%d/%m/%y')}"
    else               "#{MonthlyCost::MONTH_NAMES[@start_date.month - 1]} #{@start_date.year}"
    end

  active_period = params[:period].presence || "month"

  # DRE últimos 12 meses (mesma fórmula do MonthlyCostsController#index, sem
  # mexer em ivars já existentes).
  dre_12m = (0..11).map do |i|
    d = i.months.ago
    yr  = d.year
    mn  = d.month
    cost = car_wash&.monthly_costs&.find_by(year: yr, month: mn)
    revenue = car_wash&.appointments
      &.where(status: "attended")
      &.joins(:service)
      &.where(scheduled_at: d.beginning_of_month..d.end_of_month)
      &.sum("services.price - COALESCE(appointments.commission_amount, 0)").to_f
    pending = car_wash&.appointments
      &.where(status: "confirmed")
      &.joins(:service)
      &.where(scheduled_at: Date.today..d.end_of_month)
      &.sum("services.price - COALESCE(appointments.commission_amount, 0)").to_f
    total_cost = cost&.total.to_f
    profit = revenue - total_cost
    margin = revenue > 0 ? ((profit / revenue) * 100).round(1) : nil
    {
      year: yr, month: mn,
      label: "#{MonthlyCost::MONTH_NAMES[mn - 1]} #{yr}",
      mes: d.strftime("%b/%y"),
      revenue: revenue, open_revenue: pending,
      fixed: cost&.total_fixed.to_f, variable: cost&.total_variable.to_f,
      total_cost: total_cost, profit: profit, margin: margin,
      has_cost: cost.present?,
      cost_record: cost,
    }
  end
%>

<!-- AI INPUT MODAL -->
<div class="modal-overlay" id="inputModal">
