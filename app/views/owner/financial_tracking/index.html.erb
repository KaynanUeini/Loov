<div class="loov-page loov-page--wide">

  <div class="loov-hero loov-hero--left">
    <div class="loov-eyebrow"><span class="dot"></span>Financeiro</div>
    <h1 class="loov-h1">
      Faturamento <span class="accent">do mês</span>.
    </h1>
    <p class="loov-lead" style="margin-bottom: 22px;">
      Acompanhe receita, custos e lucro do seu lava-rápido — DRE atualizada automaticamente.
    </p>
  </div>

  <!-- ─── PERIOD PILLS (filtro rápido) ─────────────────────────── -->
  <div class="period-pills">
    <% [
      ["day",   "Hoje"],
      ["week",  "Semana"],
      ["month", "Mês"],
      ["year",  "Ano"],
      ["all",   "Tudo"],
    ].each do |key, label| %>
      <%= link_to label,
          owner_financial_tracking_path(period: key),
          class: "period-pill #{'active' if active_period == key}" %>
    <% end %>
    <a href="#filtros" class="period-pill <%= 'active' if active_period == 'custom' %>">Intervalo</a>
  </div>

  <!-- ─── FILTRO (form) ─────────────────────────────────────────── -->
  <%= form_with url: owner_financial_tracking_path, method: :get, local: true, html: { id: "filtros" } do %>
    <div class="loov-card" style="margin-bottom: 18px;">
      <div class="filter-bar">
        <div class="loov-field">
          <label class="loov-label">Período</label>
          <%= select_tag :period,
              options_for_select([
                ["Hoje","day"],["Esta Semana","week"],["Este Mês","month"],
                ["Este Ano","year"],["Tudo","all"],["Personalizado","custom"]
              ], params[:period]),
              include_blank: "Selecione", class: "loov-input", id: "period_select" %>
        </div>
        <div class="loov-field">
          <label class="loov-label">Serviço</label>
          <%= select_tag :service_filter,
              options_for_select(@service_options.map { |s| [s, s] }, params[:service_filter]),
              include_blank: "Todos", class: "loov-input" %>
        </div>
        <div class="loov-field">
          <%= submit_tag "Filtrar", class: "loov-btn-primary loov-btn-block" %>
        </div>
      </div>
      <div class="custom-dates <%= 'visible' if params[:period] == 'custom' %>" id="custom-dates">
        <div class="loov-field" style="flex: 1;">
          <label class="loov-label">Data inicial</label>
          <%= date_field_tag :start_date, params[:start_date] || @start_date, class: "loov-input" %>
        </div>
        <div class="loov-field" style="flex: 1;">
          <label class="loov-label">Data final</label>
          <%= date_field_tag :end_date, params[:end_date] || @end_date, class: "loov-input" %>
        </div>
      </div>
    </div>
  <% end %>

  <%
    is_empty = (@sales_by_day.empty? && !@is_year_filter && !@is_all_filter && !@is_custom_filter) ||
               (@is_year_filter   && @sales_by_month.all? { |m| m.total_value.zero? }) ||
               (@is_all_filter    && @sales_by_year.all?  { |y| y.total_value.zero? }) ||
               (@is_custom_filter && @sales_by_month.all? { |m| m.total_value.zero? })
  %>

  <% unless is_empty %>

    <!-- ─── HERO RECEITA (escuro) ──────────────────────────────── -->
    <div class="hero-revenue-card">
      <div class="hero-revenue-top">
        <span class="hero-revenue-label">Faturamento · <%= period_label %></span>
        <% if period_margin %>
          <span class="hero-margin-badge <%= 'negative' if period_negative %>" style="display:inline-flex; align-items:center; gap:5px; padding:5px 12px; border-radius:100px; font-family:'JetBrains Mono', monospace; font-size:11px; font-weight:700; letter-spacing:1.1px; text-transform:uppercase; <%= period_negative ? 'background:rgba(200,80,80,0.15); border:1px solid rgba(200,80,80,0.45); color:#f4a8a8;' : 'background:rgba(220,120,82,0.18); border:1px solid rgba(220,120,82,0.42); color:#f1c0a8;' %>">
            <i class="fas fa-<%= period_negative ? 'arrow-trend-down' : 'arrow-trend-up' %>"></i>
            <%= period_margin %>% margem
          </span>
        <% end %>
      </div>
      <div class="hero-revenue-value">
        R$ <%= number_with_precision(@total_sales, precision: 2, delimiter: '.', separator: ',') %>
      </div>
      <div class="hero-revenue-sub">
        <%= @total_appointments %> atendimento<%= 's' if @total_appointments != 1 %> · ticket médio
        <strong>R$ <%= number_with_precision(@total_appointments > 0 ? @total_sales / @total_appointments : 0, precision: 2) %></strong>
      </div>
    </div>

    <!-- ─── STAT TRIO ──────────────────────────────────────────── -->
    <div class="stat-trio">
      <div class="stat-trio-card">
        <div class="stat-trio-icon"><i class="fas fa-circle-check"></i></div>
        <div class="stat-trio-label">Realizado</div>
        <div class="stat-trio-value">R$ <%= number_with_precision(@total_sales, precision: 0, delimiter: '.') %></div>
      </div>
      <div class="stat-trio-card">
        <div class="stat-trio-icon amber"><i class="fas fa-clock"></i></div>
        <div class="stat-trio-label">Em aberto</div>
        <div class="stat-trio-value">R$ <%= number_with_precision(open_revenue, precision: 0, delimiter: '.') %></div>
      </div>
      <div class="stat-trio-card">
        <div class="stat-trio-icon graphite"><i class="fas fa-circle-minus"></i></div>
        <div class="stat-trio-label">Custos</div>
        <div class="stat-trio-value">R$ <%= number_with_precision(total_costs_in_period, precision: 0, delimiter: '.') %></div>
      </div>
    </div>

    <!-- AÇÃO DA SEMANA + CYCLE -->
    <div class="cycle-banner" id="cycleBanner" style="display:none;">
      <div class="cycle-banner-info">
        <div class="cycle-banner-label">Ciclo de análise</div>
        <div class="cycle-banner-value" id="cycleDates">—</div>
        <div class="cycle-banner-summary" id="cycleSummary"></div>
      </div>
      <button class="btn-input" id="btnInput" onclick="openInputModal()">
        <i class="fas fa-pen"></i> <span id="btnInputLabel">Fechar ciclo</span>
      </button>
    </div>
    <div class="action-banner" id="actionBanner">
      <div class="action-banner-label"><i class="fas fa-bolt"></i> Ação desta semana</div>
      <div class="action-banner-text" id="actionText"></div>
    </div>

    <!-- ─── COMBO CHART (Faturamento Efetivado vs Em aberto) ─── -->
    <div class="section-eyebrow">
      <span class="section-eyebrow-title">Evolução · <%= period_label %></span>
    </div>
    <div class="chart-card">
      <div class="chart-card-title"><i class="fas fa-chart-line"></i> Vendas no período</div>
      <div class="chart-legend-row">
        <div class="chart-legend-item">
          <div class="chart-legend-swatch" style="background: #dd7852;"></div>Efetivados
        </div>
        <div class="chart-legend-item">
          <div class="chart-legend-swatch" style="background: #d6b14a;"></div>Em aberto / agendados
        </div>
      </div>
      <div class="chart-inner"><canvas id="salesChart"></canvas></div>
    </div>

    <!-- ─── DRE MENSAL EXPANSÍVEL + LANÇAR CUSTOS ──────────────── -->
    <div class="section-eyebrow">
      <span class="section-eyebrow-title">DRE mensal</span>
      <span class="section-eyebrow-meta">últimos 12 meses</span>
    </div>

    <button type="button" class="launch-cta" id="btn-lancar-custos"
            onclick="abrirCustosDoMes(<%= Date.current.year %>, <%= Date.current.month %>)">
      <i class="fas fa-plus"></i> Lançar custos do mês atual
    </button>

    <div class="dre-list">
      <% dre_12m.reverse.each do |d|
        is_current = d[:year] == Date.current.year && d[:month] == Date.current.month
        negative   = d[:profit] < 0
        row_id     = "dre-row-#{d[:year]}-#{d[:month]}"
      %>
        <div class="dre-row <%= 'is-current' if is_current %>">
          <div class="dre-row-header" onclick="toggleDreRow('<%= row_id %>')">
            <div class="dre-row-main">
              <div class="dre-row-month">
                <%= d[:label] %>
                <% if is_current %><span class="current-dot">● atual</span><% end %>
              </div>
              <div class="dre-row-summary">
                <% if d[:has_cost] %>
                  Lucro
                  <strong class="<%= 'profit-neg' if negative %>">
                    <%= negative ? '-' : '' %>R$ <%= number_with_precision(d[:profit].abs, precision: 0, delimiter: '.') %>
                  </strong>
                  <% if d[:margin] %>&nbsp;·&nbsp; <%= d[:margin] %>% margem<% end %>
                <% else %>
                  <span style="color: var(--ash);">Custos não lançados</span>
                  &nbsp;·&nbsp; Faturamento
                  <strong>R$ <%= number_with_precision(d[:revenue], precision: 0, delimiter: '.') %></strong>
                <% end %>
              </div>
            </div>
            <button type="button" class="dre-row-add" title="Lançar custos"
                    onclick="event.stopPropagation(); abrirCustosDoMes(<%= d[:year] %>, <%= d[:month] %>);">
              <i class="fas fa-plus" style="font-size: 11px;"></i>
            </button>
            <i class="fas fa-chevron-down dre-row-chevron" id="<%= row_id %>-chev"></i>
          </div>
          <div class="dre-row-body" id="<%= row_id %>">
            <div class="dre-row-body-inner">
              <div class="dre-line">
                <span class="dre-line-label">Faturamento real</span>
                <span class="dre-line-amount">R$ <%= number_with_precision(d[:revenue], precision: 2) %></span>
              </div>
              <div class="dre-line muted">
                <span class="dre-line-label">Em aberto</span>
                <span class="dre-line-amount">R$ <%= number_with_precision(d[:open_revenue], precision: 2) %></span>
              </div>
              <div class="dre-divider"></div>

              <% if d[:has_cost] %>
                <div class="dre-line negative">
                  <span class="dre-line-label">Custos fixos</span>
                  <span class="dre-line-amount">- R$ <%= number_with_precision(d[:fixed], precision: 2) %></span>
                </div>
                <div class="dre-line negative">
                  <span class="dre-line-label">Custos variáveis</span>
                  <span class="dre-line-amount">- R$ <%= number_with_precision(d[:variable], precision: 2) %></span>
                </div>
                <div class="dre-line negative bold">
                  <span class="dre-line-label" style="color: var(--ink);">Total custos</span>
                  <span class="dre-line-amount">- R$ <%= number_with_precision(d[:total_cost], precision: 2) %></span>
                </div>
                <div class="dre-divider"></div>
                <div class="dre-line bold big <%= 'negative' if negative %>">
                  <span class="dre-line-label" style="color: var(--ink); font-weight: 600;">Lucro líquido</span>
                  <span class="dre-line-amount">
                    <%= negative ? '-' : '' %>R$ <%= number_with_precision(d[:profit].abs, precision: 2) %>
                  </span>
                </div>
              <% else %>
                <button type="button" class="dre-add-cost-inline"
                        onclick="abrirCustosDoMes(<%= d[:year] %>, <%= d[:month] %>)">
                  <i class="fas fa-plus"></i> Lançar custos deste mês
                </button>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
