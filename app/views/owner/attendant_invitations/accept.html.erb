<div class="loov-center-page">
  <div class="loov-center-card" style="max-width:520px;">
    <div class="loov-eyebrow"><span class="dot"></span>CONVITE</div>
    <h1 class="loov-h1" style="font-size:clamp(28px,4.5vw,38px);">
      Aceitar <span class="accent">convite</span>.
    </h1>
    <p class="loov-lead">
      Você foi convidado(a) para ser atendente.
    </p>

    <div style="display:inline-flex;align-items:center;gap:8px;background:var(--coral-50);color:var(--coral-700);border:1px solid var(--coral-100);border-radius:100px;padding:8px 16px;font-size:13.5px;font-weight:600;margin-bottom:24px;">
      <i class="fas fa-store"></i>
      <%= @invitation.car_wash.name %>
    </div>

    <% if flash[:alert] %>
      <div style="background:#fdecec;border:1px solid #f5cccc;color:#7a3838;border-radius:14px;padding:12px 16px;font-size:13.5px;margin-bottom:18px;text-align:left;">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <% existing_user = User.find_by(email: @invitation.email) %>
    <% if existing_user %>
      <p style="font-size:14px;color:var(--graphite);margin-bottom:22px;line-height:1.55;">
        A conta <strong style="color:var(--ink);"><%= @invitation.email %></strong> já existe.<br>Clique abaixo para aceitar o convite.
      </p>
      <%= form_with url: do_accept_owner_attendant_invitations_path(token: @invitation.token), method: :post, local: true do %>
        <%= submit_tag "Aceitar e entrar", class: "loov-btn-primary loov-btn-block loov-btn-lg" %>
      <% end %>
    <% else %>
      <p style="font-size:14px;color:var(--graphite);margin-bottom:22px;line-height:1.55;">
        Crie sua conta para <strong style="color:var(--ink);"><%= @invitation.email %></strong>.
      </p>
      <%= form_with url: do_accept_owner_attendant_invitations_path(token: @invitation.token), method: :post, local: true, html: { style: "text-align:left;" } do %>
        <div class="loov-field">
          <label class="loov-label">Nome completo</label>
          <%= text_field_tag :full_name, nil, class: "loov-input", placeholder: "Seu nome", required: true %>
        </div>
        <div class="loov-field">
          <label class="loov-label">Senha</label>
          <%= password_field_tag :password, nil, class: "loov-input", placeholder: "Mínimo 6 caracteres", required: true %>
        </div>
        <div class="loov-field">
          <label class="loov-label">Confirmar senha</label>
          <%= password_field_tag :password_confirmation, nil, class: "loov-input", placeholder: "Repita a senha", required: true %>
        </div>
        <%= submit_tag "Criar conta e aceitar", class: "loov-btn-primary loov-btn-block loov-btn-lg", style: "margin-top:8px;" %>
      <% end %>
    <% end %>
  </div>
</div>
