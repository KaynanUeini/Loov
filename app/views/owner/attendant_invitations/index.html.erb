<style>
  .invite-form-row { display: flex; gap: 12px; align-items: stretch; flex-wrap: wrap; }
  .invite-form-row .loov-input { flex: 1; min-width: 220px; margin-bottom: 0; }
  .invite-list { display: flex; flex-direction: column; gap: 12px; }
  .invite-item {
    background: var(--paper); border: 1px solid var(--stone);
    border-radius: 14px; overflow: hidden;
    transition: border-color 0.2s ease;
  }
  .invite-item:hover { border-color: var(--coral-100); }
  .invite-item-main {
    display: flex; align-items: center; justify-content: space-between;
    gap: 14px; padding: 14px 18px;
  }
  .invite-item-left { flex: 1; min-width: 0; }
  .invite-email {
    font-family: 'Space Grotesk', sans-serif; font-size: 15px;
    color: var(--ink); font-weight: 600;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .invite-meta { font-size: 12.5px; color: var(--ash); margin-top: 2px; }
  .invite-item-right { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
  .invite-link-wrap {
    padding: 12px 18px;
    border-top: 1px solid var(--stone);
    background: var(--sand);
  }
  .invite-link-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px; font-weight: 600; letter-spacing: 1.4px;
    text-transform: uppercase; color: var(--graphite);
    margin-bottom: 6px;
  }
  .invite-link-url {
    font-size: 12px; color: var(--graphite);
    word-break: break-all; line-height: 1.5;
    display: flex; align-items: flex-start; gap: 8px;
    font-family: 'JetBrains Mono', monospace;
  }
  .btn-copy {
    background: var(--paper); border: 1px solid var(--stone);
    border-radius: 8px; padding: 5px 10px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px; font-weight: 600; letter-spacing: 1px;
    color: var(--graphite); cursor: pointer;
    transition: all 0.15s ease;
    white-space: nowrap; flex-shrink: 0;
    text-transform: uppercase;
  }
  .btn-copy:hover { border-color: var(--coral-500); color: var(--coral-700); }
  .btn-copy.copied { border-color: var(--coral-500); color: var(--coral-700); background: var(--coral-50); }
  .btn-danger-sm {
    background: transparent; color: var(--rose-500);
    border: 1px solid #f5cccc; border-radius: 8px;
    padding: 6px 12px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px; font-weight: 600; letter-spacing: 1.2px;
    cursor: pointer; transition: all 0.2s ease;
    text-transform: uppercase;
  }
  .btn-danger-sm:hover { background: #fdecec; border-color: var(--rose-500); }
  .empty-state {
    text-align: center; padding: 36px 16px;
    display: flex; flex-direction: column; align-items: center; gap: 10px;
  }
  .empty-state-icon {
    width: 52px; height: 52px; border-radius: 14px;
    background: var(--coral-50); border: 1px solid var(--coral-100);
    display: flex; align-items: center; justify-content: center;
    font-size: 18px; color: var(--coral-700);
  }
  .empty-state-text { font-size: 14px; color: var(--graphite); }
  .flash-msg {
    display: flex; align-items: center; gap: 10px;
    padding: 12px 18px; border-radius: 12px;
    font-size: 14px; margin-bottom: 22px;
  }
  .flash-success { background: #d6ecde; border: 1px solid #b5d8c1; color: #2d6b42; }
  .flash-error   { background: #fdecec; border: 1px solid #f5cccc; color: var(--rose-500); }
  .section-mini-title {
    display: flex; align-items: center; gap: 10px;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 18px; font-weight: 700; color: var(--ink);
    letter-spacing: -0.2px;
    margin: 0 0 18px;
  }
  .section-mini-title i { color: var(--coral-500); font-size: 14px; }
</style>

<div class="loov-page loov-page--narrow">

  <div class="loov-hero">
    <div class="loov-eyebrow"><span class="dot"></span>Equipe</div>
    <h1 class="loov-h1">Seus <span class="accent">atendentes</span>.</h1>
    <p class="loov-lead">Convide membros para a equipe e acompanhe os convites enviados.</p>
  </div>

  <% if flash[:notice] %>
  <div class="flash-msg flash-success"><i class="fas fa-circle-check"></i><span><%= flash[:notice] %></span></div>
  <% end %>
  <% if flash[:alert] %>
  <div class="flash-msg flash-error"><i class="fas fa-circle-exclamation"></i><span><%= flash[:alert] %></span></div>
  <% end %>

  <div class="loov-card" style="margin-bottom: 18px;">
    <div class="section-mini-title">
      <i class="fas fa-envelope"></i> Convidar atendente
    </div>
    <%= form_with url: owner_attendant_invitations_path, method: :post, local: true do %>
      <div class="invite-form-row">
        <%= text_field_tag :email, nil, placeholder: "email@atendente.com", class: "loov-input", type: "email", required: true %>
        <%= submit_tag "Enviar convite", class: "loov-btn-primary" %>
      </div>
    <% end %>
  </div>

  <div class="loov-card">
    <div class="section-mini-title">
      <i class="fas fa-users"></i> Convites
    </div>

    <% if @invitations.any? %>
    <div class="invite-list">
      <% @invitations.each do |inv| %>
      <div class="invite-item">
        <div class="invite-item-main">
          <div class="invite-item-left">
            <div class="invite-email"><%= inv.email %></div>
            <div class="invite-meta">
              Enviado <%= time_ago_in_words(inv.created_at) %> atrás
              <% if inv.accepted? && inv.attendant %>
                · <%= inv.attendant.display_name %>
              <% end %>
            </div>
          </div>
          <div class="invite-item-right">
            <span class="loov-pill <%= inv.accepted? ? 'loov-pill--success' : 'loov-pill--warn' %>">
              <i class="fas fa-circle" style="font-size: 4px;"></i>
              <%= inv.accepted? ? 'Aceito' : 'Pendente' %>
            </span>
            <% unless inv.accepted? %>
              <%= button_to "Remover", owner_attendant_invitation_path(inv), method: :delete, class: "btn-danger-sm", data: { confirm: "Remover este convite?" } %>
            <% end %>
          </div>
        </div>
        <% unless inv.accepted? %>
        <div class="invite-link-wrap">
          <div class="invite-link-label">Link do convite</div>
          <div class="invite-link-url">
            <span id="link-<%= inv.id %>"><%= accept_owner_attendant_invitations_url(token: inv.token) %></span>
            <button class="btn-copy" onclick="copyLink('<%= inv.id %>', '<%= accept_owner_attendant_invitations_url(token: inv.token) %>', this)">
              <i class="fas fa-copy"></i> Copiar
            </button>
          </div>
        </div>
        <% end %>
      </div>
      <% end %>
    </div>
    <% else %>
    <div class="empty-state">
      <div class="empty-state-icon"><i class="fas fa-user-plus"></i></div>
      <div class="empty-state-text">Nenhum convite enviado ainda.</div>
    </div>
    <% end %>
  </div>

</div>

<script>
function copyLink(id, url, btn) {
  navigator.clipboard.writeText(url).then(function() {
    btn.textContent = '✓ Copiado';
    btn.classList.add('copied');
    setTimeout(function() {
      btn.innerHTML = '<i class="fas fa-copy"></i> Copiar';
      btn.classList.remove('copied');
    }, 2500);
  });
}
</script>
