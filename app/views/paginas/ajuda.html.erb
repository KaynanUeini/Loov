<%#
  Central de Ajuda pública. Abas Clientes e Lava-rápidos (?p=lava abre a
  segunda), quatro temas por aba e a lista de perguntas. A busca procura nas
  duas abas, no título e no texto, sem ir ao servidor. Artigos em
  config/ajuda.yml.
%>
<%= render "paginas/estilo" %>
<% icones = {
     "raio"   => '<path d="M13 2 4 14h7l-1 8 9-12h-7z"/>',
     "cal"    => '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>',
     "cartao" => '<rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/>',
     "user"   => '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>',
     "barras" => '<path d="M5 20V5M10 20V9M15 20v-7M20 20v-4" stroke-width="3"/>',
     "loja"   => '<path d="M3 9l1.5-5h15L21 9M4 9v11h16V9M3 9h18"/>',
     "equipe" => '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0M16 4.5a3.5 3.5 0 0 1 0 7M18 14a6 6 0 0 1 3.5 6"/>'
   } %>
<% publicos = [["clientes", "Clientes"], ["lava", "Lava-rápidos"]] %>
<style>
  .aj-busca { display: flex; align-items: center; gap: 10px; height: 54px; padding: 0 18px; margin-top: 22px; max-width: 580px; border-radius: 999px; border: 1.5px solid var(--stone); background: var(--paper); transition: border-color .15s; }
  .aj-busca:focus-within { border-color: var(--ink); }
  .aj-busca svg { width: 19px; height: 19px; flex: none; color: var(--graphite); }
  .aj-busca input { flex: 1; min-width: 0; height: 100%; border: 0 !important; background: transparent !important; box-shadow: none !important; padding: 0 !important; font: 500 16px 'Inter', sans-serif; color: var(--ink); outline: none; }
  .aj-abas { display: inline-flex; gap: 4px; padding: 4px; border-radius: 999px; background: var(--sand); justify-self: start; }
  .aj-abas a { display: inline-flex; align-items: center; height: 42px; padding: 0 20px; border-radius: 999px; font-size: 14.5px; font-weight: 600; color: var(--graphite) !important; text-decoration: none; }
  .aj-abas a[aria-selected="true"] { background: var(--ink); color: var(--cream) !important; }
  .aj-temas { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  @media (min-width: 760px) { .aj-temas { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .aj-tema { display: grid; gap: 3px; align-content: start; padding: 16px; border-radius: 18px; border: 1px solid var(--stone); background: var(--paper); text-align: left; cursor: pointer; font: inherit; color: var(--ink); transition: border-color .15s, transform .15s; }
  .aj-tema:hover { border-color: var(--ink); }
  .aj-tema:active { transform: scale(.98); }
  .aj-tema[aria-pressed="true"] { border-color: var(--ink); box-shadow: inset 0 0 0 1px var(--ink); }
  .aj-tema i { width: 38px; height: 38px; border-radius: 11px; background: var(--sand); display: grid; place-items: center; margin-bottom: 8px; }
  .aj-tema.lm i { background: var(--coral-50); color: var(--coral-700); }
  .aj-tema svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .aj-tema b { font-family: 'Space Grotesk', sans-serif; font-size: 16px; font-weight: 700; }
  .aj-tema span { font-size: 13px; line-height: 1.4; color: var(--graphite); }
  .aj-lista-h { margin: 0 0 8px !important; font-family: 'Space Grotesk', sans-serif !important; font-weight: 700; font-size: 19px; color: var(--ink) !important; }
  .aj-lista { display: grid; border-top: 1px solid var(--stone); }
  .aj-perg { display: flex; align-items: center; gap: 12px; padding: 15px 6px; border-bottom: 1px solid var(--stone); color: var(--ink) !important; text-decoration: none; font-size: 15.5px; font-weight: 500; }
  .aj-perg:hover { background: var(--sand); }
  .aj-perg span { flex: 1; min-width: 0; }
  .aj-perg small { font-family: 'JetBrains Mono', monospace; font-size: 10.5px; letter-spacing: .8px; text-transform: uppercase; color: var(--graphite); white-space: nowrap; }
  .aj-perg svg { width: 16px; height: 16px; flex: none; color: var(--graphite); }
  .aj-vazio { padding: 18px 6px; color: var(--graphite); font-size: 14.5px; }
</style>

<section class="pp<%= ' embed' if @embed %>">
  <div class="pp-in">
    <header>
      <h1 class="pp-title">Como podemos ajudar?</h1>
      <label class="aj-busca">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
        <input id="aj-q" type="search" placeholder="Busque: reembolso, falta, cartão…" aria-label="Buscar na ajuda" autocomplete="off">
      </label>
    </header>

    <div id="aj-nav" style="display:grid;gap:16px">
      <nav class="aj-abas" role="tablist" aria-label="Para quem">
        <% publicos.each do |id, nome| %>
          <a role="tab" href="<%= pagina_path(id == 'lava' ? '/ajuda?p=lava' : '/ajuda') %>" data-p="<%= id %>" aria-selected="<%= @publico == id %>"><%= nome %></a>
        <% end %>
      </nav>
      <div class="aj-temas" id="aj-temas"></div>
    </div>

    <div>
      <h2 class="aj-lista-h" id="aj-lista-h">Perguntas frequentes</h2>
      <div class="aj-lista" id="aj-lista"></div>
    </div>

    <%= render "paginas/contato" %>
  </div>
</section>

<%= render "shared/site_footer", audience: (user_signed_in? && current_user.client? ? :client : :visitor) unless @embed %>

<script nonce="<%= csp_nonce %>">
(function () {
  var TEMAS = <%= raw json_escape(@ajuda[:temas].to_json) %>;
  var ICONES = <%= raw json_escape(icones.to_json) %>;
  var ARTS = <%= raw json_escape(@ajuda[:artigos].map { |a| { id: a[:id], p: a[:publico], tema: a[:tema], t: a[:titulo], txt: ActionController::Base.helpers.strip_tags(a[:corpo]).squish } }.to_json) %>;
  var APP = <%= @embed ? 'true' : 'false' %>;
  var st = { p: <%= raw @publico.to_json %>, tema: null, q: '' };
  var url = function (c) { return APP ? c + (c.indexOf('?') >= 0 ? '&' : '?') + 'app=1' : c; };
  var esc = function (s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); };
  var norm = function (s) { return String(s).normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase(); };
  var SETA = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>';

  function render() {
    var q = norm(st.q.trim());
    document.getElementById('aj-nav').hidden = !!q;
    document.querySelectorAll('.aj-abas a').forEach(function (a) { a.setAttribute('aria-selected', a.dataset.p === st.p); });
    document.getElementById('aj-temas').innerHTML = TEMAS[st.p].map(function (t) {
      return '<button type="button" class="aj-tema' + (t.lm ? ' lm' : '') + '" data-tema="' + t.id + '" aria-pressed="' + (st.tema === t.id) + '">' +
        '<i><svg viewBox="0 0 24 24" aria-hidden="true">' + ICONES[t.icone] + '</svg></i><b>' + esc(t.titulo) + '</b><span>' + esc(t.sub) + '</span></button>';
    }).join('');
    var lista = ARTS.filter(function (a) {
      if (q) return q.split(/\s+/).every(function (w) { return norm(a.t + ' ' + a.txt).indexOf(w) >= 0; });
      return a.p === st.p && (!st.tema || a.tema === st.tema);
    });
    var tema = st.tema && TEMAS[st.p].filter(function (t) { return t.id === st.tema; })[0];
    document.getElementById('aj-lista-h').textContent = q ? 'Resultados para “' + st.q.trim() + '”' : tema ? tema.titulo : 'Perguntas frequentes';
    document.getElementById('aj-lista').innerHTML = lista.length ? lista.map(function (a) {
      return '<a class="aj-perg" href="' + url('/ajuda/' + a.id) + '"><span>' + esc(a.t) + '</span>' +
        (q ? '<small>' + (a.p === 'lava' ? 'Lava-rápidos' : 'Clientes') + '</small>' : '') + SETA + '</a>';
    }).join('') : '<div class="aj-vazio">Nada encontrado. Tente outra palavra ou fale com o suporte.</div>';
  }

  document.getElementById('aj-temas').addEventListener('click', function (e) {
    var b = e.target.closest('[data-tema]'); if (!b) return;
    st.tema = st.tema === b.dataset.tema ? null : b.dataset.tema; render();
  });
  document.querySelector('.aj-abas').addEventListener('click', function (e) {
    var a = e.target.closest('[data-p]'); if (!a) return;
    e.preventDefault(); st.p = a.dataset.p; st.tema = null;
    history.replaceState(null, '', a.getAttribute('href')); render();
  });
  document.getElementById('aj-q').addEventListener('input', function (e) { st.q = e.target.value; render(); });
  render();
})();
</script>
