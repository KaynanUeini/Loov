<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Loov Admin</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500;600&family=Montserrat:wght@500;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    :root {
      --lime:#afff2d; --lime-dim:#8fcc24;
      --black:#000; --surface:#080808; --surface-2:#0d0d0d; --surface-3:#111;
      --border:#1a1a1a; --border-soft:#222;
      --text-muted:#444; --white:#fff;
      --red:#f87171; --yellow:#fbbf24; --blue:#60a5fa; --purple:#a78bfa; --orange:#fb923c;
    }
    *{box-sizing:border-box;margin:0;padding:0;}
    body{background:var(--black);color:var(--white);font-family:'DM Sans',sans-serif;min-height:100vh;display:flex;}

    /* SIDEBAR */
    .adm-sidebar{width:200px;flex-shrink:0;background:var(--surface-2);border-right:1px solid var(--border);display:flex;flex-direction:column;position:fixed;top:0;bottom:0;left:0;z-index:10;}
    .adm-sidebar-brand{padding:1.25rem 1.25rem 1rem;border-bottom:1px solid var(--border);}
    .adm-sidebar-logo{font-family:'Bebas Neue',sans-serif;font-size:1.5rem;color:var(--white);letter-spacing:.04em;}
    .adm-sidebar-logo span{color:var(--lime);}
    .adm-sidebar-role{font-size:.52rem;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:rgba(175,255,45,.3);margin-top:1px;}
    .adm-nav{display:flex;flex-direction:column;gap:2px;padding:.75rem;flex:1;}
    .adm-nav-item{display:flex;align-items:center;gap:.625rem;padding:.625rem .875rem;border-radius:10px;font-size:.78rem;font-weight:500;color:var(--text-muted);text-decoration:none;transition:all .15s;cursor:pointer;border:none;background:transparent;width:100%;text-align:left;}
    .adm-nav-item:hover{color:var(--white);background:rgba(255,255,255,.03);}
    .adm-nav-item.active{color:var(--lime);background:rgba(175,255,45,.06);}
    .adm-nav-item i{width:14px;text-align:center;font-size:.72rem;}
    .adm-nav-sep{height:1px;background:var(--border);margin:.5rem 0;}
    .adm-sidebar-footer{padding:.875rem 1.25rem;border-top:1px solid var(--border);}
    .adm-user-name{font-size:.75rem;font-weight:600;color:var(--white);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .adm-user-email{font-size:.6rem;color:var(--text-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:1px;}
    .adm-signout{display:flex;align-items:center;gap:.5rem;margin-top:.625rem;font-size:.72rem;color:#2a2a2a;text-decoration:none;transition:color .15s;}
    .adm-signout:hover{color:var(--red);}

    /* MAIN */
    .adm-main{margin-left:200px;flex:1;display:flex;flex-direction:column;min-height:100vh;}
    .adm-topbar{height:52px;background:rgba(0,0,0,.6);backdrop-filter:blur(20px);border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;padding:0 1.5rem;flex-shrink:0;position:sticky;top:0;z-index:5;}
    .adm-topbar-title{font-family:'Montserrat',sans-serif;font-size:.62rem;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--text-muted);}
    .adm-topbar-right{display:flex;align-items:center;gap:.75rem;}

    /* CEO ASSISTANT BUTTON */
    .ceo-btn{display:inline-flex;align-items:center;gap:.5rem;padding:.45rem 1rem;border-radius:100px;background:linear-gradient(135deg,rgba(167,139,250,.15),rgba(96,165,250,.1));border:1px solid rgba(167,139,250,.3);color:#a78bfa;font-family:'DM Sans',sans-serif;font-size:.75rem;font-weight:700;cursor:pointer;transition:all .2s;letter-spacing:.03em;}
    .ceo-btn:hover{background:linear-gradient(135deg,rgba(167,139,250,.25),rgba(96,165,250,.18));border-color:rgba(167,139,250,.5);box-shadow:0 0 20px rgba(167,139,250,.15);}
    .ceo-btn-dot{width:7px;height:7px;border-radius:50%;background:#a78bfa;animation:ceoPulse 2s ease-in-out infinite;}
    @keyframes ceoPulse{0%,100%{opacity:1;box-shadow:0 0 0 0 rgba(167,139,250,.4)}50%{opacity:.6;box-shadow:0 0 0 6px rgba(167,139,250,0)}}

    .adm-content{padding:1.5rem;flex:1;}

    /* KPI GRID */
    .adm-kpi-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin-bottom:1.5rem;}
    .adm-kpi{background:var(--surface-2);border:1px solid var(--border);border-radius:14px;padding:1.125rem 1.25rem;position:relative;overflow:hidden;}
    .adm-kpi::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(to right,transparent,rgba(255,255,255,.05),transparent);}
    .adm-kpi-label{font-size:.55rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--text-muted);margin-bottom:.5rem;}
    .adm-kpi-value{font-family:'Bebas Neue',sans-serif;font-size:2rem;line-height:1;letter-spacing:.02em;}
    .adm-kpi-value.lime{color:var(--lime);}
    .adm-kpi-value.blue{color:var(--blue);}
    .adm-kpi-value.yellow{color:var(--yellow);}
    .adm-kpi-value.red{color:var(--red);}
    .adm-kpi-sub{font-size:.62rem;color:var(--text-muted);margin-top:.25rem;}

    /* PANELS */
    .adm-panel{background:var(--surface-2);border:1px solid var(--border);border-radius:14px;overflow:hidden;margin-bottom:1rem;}
    .adm-panel-header{padding:.875rem 1.25rem;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;}
    .adm-panel-title{font-family:'Montserrat',sans-serif;font-size:.6rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--text-muted);}
    .adm-panel-body{padding:1rem 1.25rem;}

    /* TABS */
    .adm-tabs{display:flex;gap:2px;padding:.5rem;background:var(--surface-3);border-radius:10px;margin-bottom:1rem;}
    .adm-tab{flex:1;padding:.45rem .75rem;border-radius:7px;font-size:.72rem;font-weight:600;color:var(--text-muted);border:none;background:transparent;cursor:pointer;transition:all .15s;text-align:center;}
    .adm-tab.active{background:rgba(255,255,255,.06);color:var(--white);}

    /* TABLE */
    .adm-table{width:100%;border-collapse:collapse;font-size:.78rem;}
    .adm-table th{font-size:.55rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--text-muted);padding:.5rem .75rem;text-align:left;border-bottom:1px solid var(--border);}
    .adm-table td{padding:.625rem .75rem;border-bottom:1px solid rgba(255,255,255,.025);color:#bbb;vertical-align:middle;}
    .adm-table tr:last-child td{border-bottom:none;}
    .adm-table tr:hover td{background:rgba(255,255,255,.015);}

    /* BADGES */
    .badge{display:inline-flex;align-items:center;gap:.25rem;padding:.15rem .5rem;border-radius:100px;font-size:.58rem;font-weight:700;letter-spacing:.06em;}
    .badge-green{background:rgba(175,255,45,.08);border:1px solid rgba(175,255,45,.2);color:var(--lime);}
    .badge-blue{background:rgba(96,165,250,.08);border:1px solid rgba(96,165,250,.2);color:var(--blue);}
    .badge-yellow{background:rgba(251,191,36,.08);border:1px solid rgba(251,191,36,.2);color:var(--yellow);}
    .badge-red{background:rgba(248,113,113,.08);border:1px solid rgba(248,113,113,.2);color:var(--red);}
    .badge-purple{background:rgba(167,139,250,.08);border:1px solid rgba(167,139,250,.2);color:var(--purple);}

    /* ACTION BUTTONS */
    .tbl-btn{padding:.25rem .625rem;border-radius:6px;font-size:.62rem;font-weight:700;cursor:pointer;border:1px solid;transition:all .15s;}
    .tbl-btn-red{color:var(--red);border-color:rgba(248,113,113,.2);background:transparent;}
    .tbl-btn-red:hover{background:rgba(248,113,113,.08);}
    .tbl-btn-green{color:var(--lime);border-color:rgba(175,255,45,.2);background:transparent;}
    .tbl-btn-green:hover{background:rgba(175,255,45,.08);}
    .tbl-btn-blue{color:var(--blue);border-color:rgba(96,165,250,.2);background:transparent;}
    .tbl-btn-blue:hover{background:rgba(96,165,250,.08);}

    /* FILTERS */
    .adm-filters{display:flex;gap:.5rem;flex-wrap:wrap;margin-bottom:1rem;}
    .adm-filter-btn{padding:.35rem .75rem;border-radius:100px;font-size:.68rem;font-weight:600;cursor:pointer;border:1px solid var(--border);background:transparent;color:var(--text-muted);transition:all .15s;}
    .adm-filter-btn:hover,.adm-filter-btn.active{border-color:rgba(175,255,45,.3);color:var(--lime);background:rgba(175,255,45,.04);}
    .adm-search{background:var(--surface-3);border:1px solid var(--border);border-radius:8px;color:var(--white);font-family:'DM Sans',sans-serif;font-size:.78rem;padding:.4rem .75rem;outline:none;width:220px;}
    .adm-search:focus{border-color:rgba(175,255,45,.3);}

    /* SUPPORT THREAD */
    .support-thread{display:flex;flex-direction:column;gap:4px;max-height:240px;overflow-y:auto;padding:.5rem;background:rgba(0,0,0,.4);border-radius:8px;margin-bottom:.75rem;}
    .support-thread::-webkit-scrollbar{width:2px;}
    .support-thread::-webkit-scrollbar-thumb{background:#1a1a1a;border-radius:99px;}
    .msg-bubble{max-width:80%;padding:7px 11px;border-radius:9px;font-size:.75rem;line-height:1.5;}
    .msg-admin{align-self:flex-end;background:rgba(175,255,45,.07);border:1px solid rgba(175,255,45,.12);}
    .msg-owner{align-self:flex-start;background:rgba(96,165,250,.07);border:1px solid rgba(96,165,250,.12);}
    .msg-author{font-size:.55rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;margin-bottom:2px;}
    .msg-admin .msg-author{color:rgba(175,255,45,.45);}
    .msg-owner .msg-author{color:rgba(96,165,250,.45);}
    .msg-body{color:#ccc;white-space:pre-wrap;}
    .msg-time{font-size:.55rem;color:#2a2a2a;margin-top:2px;}

    /* AGENT DRAFT */
    .agent-draft-box{background:rgba(96,165,250,.04);border:1px solid rgba(96,165,250,.15);border-radius:10px;padding:.875rem 1rem;margin-bottom:.75rem;}
    .agent-draft-label{font-size:.55rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:rgba(96,165,250,.5);margin-bottom:.5rem;display:flex;align-items:center;gap:.4rem;}
    .agent-draft-body{font-size:.78rem;color:#ccc;line-height:1.6;white-space:pre-wrap;}
    .draft-actions{display:flex;gap:.5rem;margin-top:.75rem;}
    .draft-btn{padding:.35rem .875rem;border-radius:7px;font-size:.68rem;font-weight:700;cursor:pointer;border:none;transition:all .15s;}
    .draft-approve{background:rgba(175,255,45,.1);color:var(--lime);border:1px solid rgba(175,255,45,.25);}
    .draft-approve:hover{background:rgba(175,255,45,.18);}
    .draft-discard{background:transparent;color:var(--text-muted);border:1px solid var(--border);}
    .draft-discard:hover{color:var(--red);border-color:rgba(248,113,113,.3);}
    .draft-edit{background:transparent;color:var(--blue);border:1px solid rgba(96,165,250,.25);}
    .draft-edit:hover{background:rgba(96,165,250,.08);}

    /* REPLY AREA */
    .reply-area{display:flex;flex-direction:column;gap:.5rem;}
    .reply-textarea{width:100%;background:var(--surface-3);border:1px solid var(--border);border-radius:8px;color:var(--white);font-family:'DM Sans',sans-serif;font-size:.78rem;padding:.625rem .875rem;outline:none;resize:vertical;min-height:60px;transition:border-color .2s;}
    .reply-textarea:focus{border-color:rgba(175,255,45,.25);}
    .reply-actions{display:flex;gap:.5rem;align-items:center;}
    .reply-send{background:var(--lime);border:none;border-radius:7px;color:#000;font-family:'DM Sans',sans-serif;font-size:.72rem;font-weight:700;padding:.4rem .875rem;cursor:pointer;transition:background .15s;}
    .reply-send:hover{background:var(--lime-dim);}
    .reply-resolve{background:transparent;border:1px solid rgba(175,255,45,.2);border-radius:7px;color:rgba(175,255,45,.6);font-size:.68rem;font-weight:700;padding:.4rem .875rem;cursor:pointer;transition:all .15s;}
    .reply-resolve:hover{border-color:var(--lime);color:var(--lime);}
    .reply-reopen{background:transparent;border:1px solid rgba(96,165,250,.2);border-radius:7px;color:rgba(96,165,250,.6);font-size:.68rem;font-weight:700;padding:.4rem .875rem;cursor:pointer;transition:all .15s;}
    .reply-reopen:hover{border-color:var(--blue);color:var(--blue);}
    .run-agent-btn{background:transparent;border:1px solid rgba(167,139,250,.25);border-radius:7px;color:rgba(167,139,250,.7);font-size:.65rem;font-weight:700;padding:.35rem .75rem;cursor:pointer;transition:all .15s;margin-left:auto;}
    .run-agent-btn:hover{border-color:#a78bfa;color:#a78bfa;}

    /* CEO ASSISTANT MODAL */
    .ceo-modal-overlay{position:fixed;inset:0;z-index:500;background:rgba(0,0,0,.95);backdrop-filter:blur(12px);display:none;align-items:flex-start;justify-content:center;padding:1.5rem;overflow-y:auto;}
    .ceo-modal-overlay.open{display:flex;}
    .ceo-modal{background:var(--surface-2);border:1px solid rgba(167,139,250,.2);border-radius:20px;width:100%;max-width:780px;overflow:hidden;box-shadow:0 0 80px rgba(167,139,250,.08);}
    .ceo-modal-header{padding:1.25rem 1.5rem;border-bottom:1px solid rgba(167,139,250,.1);display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;}
    .ceo-modal-title-wrap{}
    .ceo-modal-eyebrow{font-size:.55rem;font-weight:700;letter-spacing:.25em;text-transform:uppercase;color:rgba(167,139,250,.5);margin-bottom:.25rem;}
    .ceo-modal-title{font-family:'Bebas Neue',sans-serif;font-size:1.625rem;color:var(--white);letter-spacing:.04em;}
    .ceo-modal-title span{color:#a78bfa;}
    .ceo-modal-close{background:none;border:1px solid var(--border);border-radius:8px;color:var(--text-muted);width:30px;height:30px;display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0;transition:all .15s;font-size:.78rem;}
    .ceo-modal-close:hover{border-color:var(--red);color:var(--red);}
    .ceo-modal-focus{padding:.875rem 1.5rem;border-bottom:1px solid var(--border);display:flex;gap:.625rem;align-items:center;}
    .ceo-focus-input{flex:1;background:var(--surface-3);border:1px solid var(--border);border-radius:8px;color:var(--white);font-family:'DM Sans',sans-serif;font-size:.8rem;padding:.5rem .875rem;outline:none;transition:border-color .2s;}
    .ceo-focus-input:focus{border-color:rgba(167,139,250,.35);}
    .ceo-focus-input::placeholder{color:#2a2a2a;}
    .ceo-run-btn{background:linear-gradient(135deg,#a78bfa,#60a5fa);border:none;border-radius:8px;color:#000;font-family:'DM Sans',sans-serif;font-size:.78rem;font-weight:800;padding:.5rem 1.125rem;cursor:pointer;white-space:nowrap;transition:opacity .15s;}
    .ceo-run-btn:hover:not(:disabled){opacity:.88;}
    .ceo-run-btn:disabled{opacity:.4;cursor:not-allowed;}
    .ceo-modal-body{padding:1.5rem;}
    .ceo-loading{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:4rem 2rem;gap:1.25rem;}
    .ceo-loading-orb{width:56px;height:56px;border-radius:50%;background:linear-gradient(135deg,rgba(167,139,250,.2),rgba(96,165,250,.1));border:1px solid rgba(167,139,250,.3);display:flex;align-items:center;justify-content:center;animation:ceoOrb 2s ease-in-out infinite;}
    @keyframes ceoOrb{0%,100%{box-shadow:0 0 0 0 rgba(167,139,250,.3)}50%{box-shadow:0 0 0 16px rgba(167,139,250,0)}}
    .ceo-loading-text{font-size:.78rem;color:rgba(167,139,250,.6);text-align:center;line-height:1.6;}
    .ceo-briefing{font-size:.85rem;line-height:1.75;color:#ccc;}
    .ceo-section{margin-bottom:1.75rem;}
    .ceo-section-title{font-family:'Montserrat',sans-serif;font-size:.58rem;font-weight:800;letter-spacing:.22em;text-transform:uppercase;padding:.35rem .75rem;border-radius:6px;display:inline-block;margin-bottom:.875rem;}
    .ceo-section-title.pulse{background:rgba(175,255,45,.08);border:1px solid rgba(175,255,45,.2);color:var(--lime);}
    .ceo-section-title.alert{background:rgba(248,113,113,.08);border:1px solid rgba(248,113,113,.2);color:var(--red);}
    .ceo-section-title.money{background:rgba(251,191,36,.08);border:1px solid rgba(251,191,36,.2);color:var(--yellow);}
    .ceo-section-title.opp{background:rgba(96,165,250,.08);border:1px solid rgba(96,165,250,.2);color:var(--blue);}
    .ceo-section-title.decision{background:rgba(167,139,250,.08);border:1px solid rgba(167,139,250,.2);color:#a78bfa;}
    .ceo-section-title.vision{background:rgba(251,191,36,.06);border:1px solid rgba(251,191,36,.15);color:var(--orange);}
    .ceo-section-body{color:#bbb;line-height:1.8;white-space:pre-wrap;}
    .ceo-footer{padding:.875rem 1.5rem;border-top:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;}
    .ceo-generated-at{font-size:.62rem;color:#2a2a2a;}
    .ceo-rerun-btn{background:transparent;border:1px solid rgba(167,139,250,.2);border-radius:7px;color:rgba(167,139,250,.6);font-size:.68rem;font-weight:700;padding:.35rem .875rem;cursor:pointer;transition:all .15s;}
    .ceo-rerun-btn:hover{border-color:#a78bfa;color:#a78bfa;}

    /* TOAST */
    .toast-wrap{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);z-index:600;display:flex;flex-direction:column;align-items:center;gap:6px;pointer-events:none;}
    .toast{display:inline-flex;align-items:center;gap:7px;padding:9px 16px;border-radius:100px;font-size:.68rem;font-weight:700;backdrop-filter:blur(16px);box-shadow:0 8px 24px rgba(0,0,0,.5);opacity:0;transform:translateY(10px);animation:toastIn .3s ease forwards;pointer-events:none;}
    .toast.ok{background:rgba(175,255,45,.1);border:1px solid rgba(175,255,45,.25);color:var(--lime);}
    .toast.err{background:rgba(248,113,113,.1);border:1px solid rgba(248,113,113,.25);color:var(--red);}
    .toast.out{animation:toastOut .3s ease forwards;}
    @keyframes toastIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
    @keyframes toastOut{from{opacity:1;transform:translateY(0)}to{opacity:0;transform:translateY(-8px)}}
    .spin{animation:spinA .7s linear infinite;display:inline-block;}
    @keyframes spinA{to{transform:rotate(360deg)}}
  </style>
</head>
<body>

<!-- CEO ASSISTANT MODAL -->
<div class="ceo-modal-overlay" id="ceo-overlay">
  <div class="ceo-modal">
    <div class="ceo-modal-header">
      <div class="ceo-modal-title-wrap">
        <div class="ceo-modal-eyebrow">Loov Intelligence</div>
        <div class="ceo-modal-title">CEO <span>Assistant</span></div>
      </div>
      <button class="ceo-modal-close" id="ceo-close"><i class="fas fa-xmark"></i></button>
    </div>
    <div class="ceo-modal-focus">
      <input class="ceo-focus-input" id="ceo-focus-input" type="text" placeholder="Foco específico (opcional) — ex: como aumentar receita nos próximos 30 dias">
      <button class="ceo-run-btn" id="ceo-run-btn"><i class="fas fa-brain"></i> Analisar</button>
    </div>
    <div class="ceo-modal-body" id="ceo-modal-body">
      <div style="text-align:center;padding:3rem 2rem;color:#1a1a1a;font-size:.8rem;">
        <i class="fas fa-brain" style="font-size:2rem;margin-bottom:1rem;display:block;color:#1e1e1e;"></i>
        Clique em "Analisar" para gerar seu briefing estratégico completo.<br>
        <span style="font-size:.7rem;color:#141414;">O assistente vai ler todos os dados da plataforma e entregar insights de nível board.</span>
      </div>
    </div>
    <div class="ceo-modal-footer" id="ceo-footer" style="display:none;">
      <span class="ceo-generated-at" id="ceo-gen-at"></span>
      <button class="ceo-rerun-btn" id="ceo-rerun"><i class="fas fa-rotate"></i> Nova análise</button>
    </div>
  </div>
</div>

<div class="toast-wrap" id="toast-wrap"></div>

<aside class="adm-sidebar">
  <div class="adm-sidebar-brand">
    <div class="adm-sidebar-logo">LOOV<span>.</span></div>
    <div class="adm-sidebar-role">Admin Panel</div>
  </div>
  <nav class="adm-nav">
    <button class="adm-nav-item active" onclick="showSection('overview')"><i class="fas fa-chart-line"></i> Visão Geral</button>
    <button class="adm-nav-item" onclick="showSection('users')"><i class="fas fa-users"></i> Usuários</button>
    <button class="adm-nav-item" onclick="showSection('carwashes')"><i class="fas fa-car-wash"></i> Lava-rápidos</button>
    <button class="adm-nav-item" onclick="showSection('appointments')"><i class="fas fa-calendar-days"></i> Agendamentos</button>
    <button class="adm-nav-item" onclick="showSection('financial')"><i class="fas fa-wallet"></i> Financeiro</button>
    <button class="adm-nav-item" onclick="showSection('support')"><i class="fas fa-headset"></i> Suporte</button>
    <div class="adm-nav-sep"></div>
    <button class="adm-nav-item" onclick="openCeoAssistant()" style="color:#a78bfa;"><i class="fas fa-brain"></i> CEO Assistant</button>
  </nav>
  <div class="adm-sidebar-footer">
    <div class="adm-user-name"><%= current_user.display_name %></div>
    <div class="adm-user-email"><%= current_user.email %></div>
    <%= link_to destroy_user_session_path, method: :delete, class: "adm-signout" do %>
      <i class="fas fa-arrow-right-from-bracket"></i> Sair
    <% end %>
  </div>
</aside>

<main class="adm-main">
  <div class="adm-topbar">
    <span class="adm-topbar-title" id="topbar-title">Painel Admin</span>
    <div class="adm-topbar-right">
      <button class="ceo-btn" onclick="openCeoAssistant()">
        <span class="ceo-btn-dot"></span>
        CEO Assistant
      </button>
    </div>
  </div>

  <div class="adm-content">

    <!-- KPI STRIP (sempre visível) -->
    <div class="adm-kpi-grid" id="kpi-strip">
      <div class="adm-kpi"><div class="adm-kpi-label">Usuários</div><div class="adm-kpi-value blue" id="kpi-users">—</div><div class="adm-kpi-sub" id="kpi-users-sub">—</div></div>
      <div class="adm-kpi"><div class="adm-kpi-label">Lava-rápidos ativos</div><div class="adm-kpi-value lime" id="kpi-cws">—</div><div class="adm-kpi-sub" id="kpi-cws-sub">—</div></div>
      <div class="adm-kpi"><div class="adm-kpi-label">Agendamentos hoje</div><div class="adm-kpi-value yellow" id="kpi-today">—</div><div class="adm-kpi-sub" id="kpi-today-sub">—</div></div>
      <div class="adm-kpi"><div class="adm-kpi-label">Comissão do mês</div><div class="adm-kpi-value lime" id="kpi-commission">—</div><div class="adm-kpi-sub" id="kpi-commission-sub">—</div></div>
    </div>

    <!-- OVERVIEW -->
    <div id="section-overview">
      <div class="adm-panel">
        <div class="adm-panel-header"><span class="adm-panel-title">Atividade recente</span><span style="font-size:.65rem;color:var(--text-muted);" id="activity-count">—</span></div>
        <div id="activity-list" style="overflow-x:auto;"><div style="padding:2rem;text-align:center;color:#1a1a1a;font-size:.78rem;">Carregando...</div></div>
      </div>
    </div>

    <!-- USERS -->
    <div id="section-users" style="display:none;">
      <div class="adm-filters">
        <input class="adm-search" id="user-search" placeholder="Buscar por nome ou e-mail...">
        <button class="adm-filter-btn active" onclick="filterUsers('')">Todos</button>
        <button class="adm-filter-btn" onclick="filterUsers('client')">Clientes</button>
        <button class="adm-filter-btn" onclick="filterUsers('owner')">Proprietários</button>
        <button class="adm-filter-btn" onclick="filterUsers('attendant')">Atendentes</button>
        <button class="adm-filter-btn" onclick="filterUsers('admin')">Admins</button>
      </div>
      <div class="adm-panel">
        <div class="adm-panel-header"><span class="adm-panel-title" id="users-panel-title">Usuários</span></div>
        <div style="overflow-x:auto;" id="users-table-wrap"><div style="padding:2rem;text-align:center;color:#1a1a1a;font-size:.78rem;">Carregando...</div></div>
      </div>
    </div>

    <!-- CAR WASHES -->
    <div id="section-carwashes" style="display:none;">
      <div class="adm-panel">
        <div class="adm-panel-header"><span class="adm-panel-title" id="cws-panel-title">Lava-rápidos</span></div>
        <div style="overflow-x:auto;" id="cws-table-wrap"><div style="padding:2rem;text-align:center;color:#1a1a1a;font-size:.78rem;">Carregando...</div></div>
      </div>
    </div>

    <!-- APPOINTMENTS -->
    <div id="section-appointments" style="display:none;">
      <div class="adm-filters">
        <button class="adm-filter-btn active" onclick="filterAppts('')">Todos os status</button>
        <button class="adm-filter-btn" onclick="filterAppts('confirmed')">Confirmado</button>
        <button class="adm-filter-btn" onclick="filterAppts('attended')">Compareceu</button>
        <button class="adm-filter-btn" onclick="filterAppts('no_show')">Não veio</button>
        <button class="adm-filter-btn" onclick="filterAppts('cancelled')">Cancelado</button>
        <button class="adm-filter-btn" onclick="filterAppts('pending_acceptance')">Aguard. aceite</button>
        <button class="adm-filter-btn" onclick="filterAppts2('disponivel')">Disponível</button>
      </div>
      <div class="adm-panel">
        <div class="adm-panel-header"><span class="adm-panel-title" id="appts-panel-title">Agendamentos</span></div>
        <div style="overflow-x:auto;" id="appts-table-wrap"><div style="padding:2rem;text-align:center;color:#1a1a1a;font-size:.78rem;">Carregando...</div></div>
      </div>
    </div>

    <!-- FINANCIAL -->
    <div id="section-financial" style="display:none;">
      <div class="adm-filters">
        <button class="adm-filter-btn active" onclick="filterFinancial(1)">Último mês</button>
        <button class="adm-filter-btn" onclick="filterFinancial(3)">Últimos 3 meses</button>
        <button class="adm-filter-btn" onclick="filterFinancial(6)">Últimos 6 meses</button>
        <button class="adm-filter-btn" onclick="filterFinancial(12)">Último ano</button>
        <button class="adm-filter-btn" onclick="exportFinancial()"><i class="fas fa-download" style="font-size:.6rem;"></i> Exportar CSV</button>
      </div>
      <div class="adm-kpi-grid" style="grid-template-columns:repeat(4,1fr);margin-bottom:1rem;">
        <div class="adm-kpi"><div class="adm-kpi-label">Volume Disponíveis</div><div class="adm-kpi-value lime" id="fin-volume">—</div></div>
        <div class="adm-kpi"><div class="adm-kpi-label">Comissão Total Loov</div><div class="adm-kpi-value yellow" id="fin-commission">—</div></div>
        <div class="adm-kpi"><div class="adm-kpi-label">Comissão do Período</div><div class="adm-kpi-value lime" id="fin-period">—</div></div>
        <div class="adm-kpi"><div class="adm-kpi-label">Transações</div><div class="adm-kpi-value blue" id="fin-count">—</div></div>
      </div>
      <div class="adm-panel">
        <div class="adm-panel-header"><span class="adm-panel-title" id="fin-panel-title">Transações Disponíveis</span></div>
        <div style="overflow-x:auto;" id="fin-table-wrap"><div style="padding:2rem;text-align:center;color:#1a1a1a;font-size:.78rem;">Carregando...</div></div>
      </div>
    </div>

    <!-- SUPPORT -->
    <div id="section-support" style="display:none;">
      <div class="adm-filters">
        <button class="adm-filter-btn active" onclick="filterSupport('')">Todos</button>
        <button class="adm-filter-btn" onclick="filterSupport('open')">Abertos</button>
        <button class="adm-filter-btn" onclick="filterSupport('in_progress')">Em andamento</button>
        <button class="adm-filter-btn" onclick="filterSupport('resolved')">Resolvidos</button>
      </div>
      <div class="adm-panel" id="support-panel">
        <div class="adm-panel-header"><span class="adm-panel-title" id="support-panel-title">Chamados de suporte</span></div>
        <div id="support-list"><div style="padding:2rem;text-align:center;color:#1a1a1a;font-size:.78rem;">Carregando...</div></div>
      </div>
    </div>

  </div>
</main>

<script>
(function() {
  const CSRF = document.querySelector('meta[name="csrf-token"]')?.content;
  let currentSection = 'overview';
  let allUsers = [], allAppts = [], allCws = [], allSupport = [];
  let currentApptStatus = '', currentApptType = '';

  // ── TOAST ─────────────────────────────────────────────────────────────
  function toast(msg, type='ok') {
    const w=document.getElementById('toast-wrap'), t=document.createElement('div');
    t.className=`toast ${type}`;
    t.innerHTML=`<i class="fas ${type==='ok'?'fa-check':'fa-times'}"></i> ${msg}`;
    w.appendChild(t);
    setTimeout(()=>{t.classList.add('out');setTimeout(()=>t.remove(),320);},3500);
  }

  // ── SECTIONS ──────────────────────────────────────────────────────────
  window.showSection = function(name) {
    ['overview','users','carwashes','appointments','financial','support'].forEach(s=>{
      document.getElementById('section-'+s).style.display = s===name?'':'none';
    });
    document.querySelectorAll('.adm-nav-item').forEach((el,i)=>{
      el.classList.toggle('active', el.onclick?.toString().includes("'"+name+"'"));
    });
    currentSection = name;
    const titles={overview:'Painel Admin',users:'Usuários',carwashes:'Lava-rápidos',appointments:'Agendamentos',financial:'Financeiro',support:'Suporte'};
    document.getElementById('topbar-title').textContent = titles[name]||'Admin';
    if(name==='users'&&!allUsers.length) loadUsers();
    if(name==='carwashes'&&!allCws.length) loadCarWashes();
    if(name==='appointments'&&!allAppts.length) loadAppts();
    if(name==='financial') loadFinancial(3);
    if(name==='support'&&!allSupport.length) loadSupport();
  };

  // ── STATS ─────────────────────────────────────────────────────────────
  function loadStats() {
    fetch('/admin/dashboard/stats',{headers:{Accept:'application/json'}})
      .then(r=>r.json()).then(d=>{
        document.getElementById('kpi-users').textContent = d.users.total.toLocaleString('pt-BR');
        document.getElementById('kpi-users-sub').textContent = `+${d.users.new_today} hoje · ${d.users.clients} clientes`;
        document.getElementById('kpi-cws').textContent = d.car_washes.active;
        document.getElementById('kpi-cws-sub').textContent = `${d.car_washes.total} cadastrados`;
        document.getElementById('kpi-today').textContent = d.appointments.today;
        document.getElementById('kpi-today-sub').textContent = `${d.appointments.attended_today} atendidos · ${d.support.pending} tickets`;
        document.getElementById('kpi-commission').textContent = 'R$'+d.financial.commission_month.toLocaleString('pt-BR',{minimumFractionDigits:2});
        document.getElementById('kpi-commission-sub').textContent = `R$${d.financial.commission_total.toLocaleString('pt-BR',{minimumFractionDigits:2})} total acumulado`;
      }).catch(()=>{});
  }

  // ── ACTIVITY ─────────────────────────────────────────────────────────
  function loadActivity() {
    fetch('/admin/dashboard/activity',{headers:{Accept:'application/json'}})
      .then(r=>r.json()).then(data=>{
        document.getElementById('activity-count').textContent = `${data.length} recentes`;
        const statColors={attended:'lime',confirmed:'yellow',cancelled:'red',no_show:'red',pending_acceptance:'blue'};
        const statLabels={attended:'Compareceu',confirmed:'Confirmado',cancelled:'Cancelado',no_show:'Não veio',pending_acceptance:'Aguard. aceite'};
        document.getElementById('activity-list').innerHTML = `<table class="adm-table">
          <thead><tr><th>#</th><th>Cliente</th><th>Serviço</th><th>Lava-rápido</th><th>Tipo</th><th>Status</th><th>Data</th><th>Comissão</th></tr></thead>
          <tbody>${data.map(a=>`<tr>
            <td style="color:var(--text-muted);">#${a.id}</td>
            <td>${a.client||'—'}</td>
            <td style="color:#888;">${a.service||'—'}</td>
            <td style="color:#888;">${a.car_wash||'—'}</td>
            <td><span class="badge ${a.type==='disponivel'?'badge-green':'badge-blue'}">${a.type==='disponivel'?'Disp.':'Regular'}</span></td>
            <td><span class="badge badge-${statColors[a.status]||'blue'}">${statLabels[a.status]||a.status}</span></td>
            <td style="color:var(--text-muted);">${a.scheduled_at||'—'}</td>
            <td style="color:${a.commission>0?'var(--lime)':'var(--text-muted)'};">${a.commission>0?'R$'+a.commission.toFixed(2):'—'}</td>
          </tr>`).join('')}</tbody>
        </table>`;
      }).catch(()=>{});
  }

  // ── USERS ────────────────────────────────────────────────────────────
  function loadUsers(role='') {
    const url = role ? `/admin/users?role=${role}` : '/admin/users';
    fetch(url,{headers:{Accept:'application/json'}}).then(r=>r.json()).then(data=>{
      allUsers=data; renderUsers(data);
    }).catch(()=>{});
  }
  function renderUsers(data) {
    document.getElementById('users-panel-title').textContent=`Usuários — ${data.length} registros`;
    const roleColors={client:'blue',owner:'lime',attendant:'yellow',admin:'purple'};
    document.getElementById('users-table-wrap').innerHTML=`<table class="adm-table">
      <thead><tr><th>Nome</th><th>E-mail</th><th>Role</th><th>Status</th><th>Agend.</th><th>Desde</th><th>Ações</th></tr></thead>
      <tbody>${data.map(u=>`<tr>
        <td style="font-weight:500;">${u.name}</td>
        <td style="color:var(--text-muted);">${u.email}</td>
        <td><span class="badge badge-${roleColors[u.role]||'blue'}">${u.role}</span></td>
        <td><span class="badge ${u.blocked?'badge-red':'badge-green'}">${u.blocked?'Bloqueado':'Ativo'}</span></td>
        <td style="color:var(--text-muted);">${u.appointments_count}</td>
        <td style="color:var(--text-muted);">${u.created_at}</td>
        <td>
          ${u.blocked
            ? `<button class="tbl-btn tbl-btn-green" onclick="unblockUser(${u.id},this)">Desbloquear</button>`
            : `<button class="tbl-btn tbl-btn-red" onclick="blockUser(${u.id},this)">Bloquear</button>`
          }
        </td>
      </tr>`).join('')}</tbody>
    </table>`;
  }
  window.filterUsers = function(role) {
    document.querySelectorAll('#section-users .adm-filter-btn').forEach(b=>b.classList.toggle('active', b.onclick?.toString().includes(`'${role}'`)));
    if(allUsers.length) renderUsers(role ? allUsers.filter(u=>u.role===role) : allUsers);
    else loadUsers(role);
  };
  document.getElementById('user-search').addEventListener('input', function() {
    const q=this.value.toLowerCase();
    renderUsers(allUsers.filter(u=>u.name.toLowerCase().includes(q)||u.email.toLowerCase().includes(q)));
  });
  window.blockUser = async function(id, btn) {
    btn.disabled=true; btn.textContent='...';
    const r=await fetch(`/admin/users/${id}/block`,{method:'PATCH',headers:{'X-CSRF-Token':CSRF}});
    const d=await r.json(); if(d.ok){loadUsers();toast('Usuário bloqueado.');}else{toast(d.error||'Erro','err');btn.disabled=false;btn.textContent='Bloquear';}
  };
  window.unblockUser = async function(id, btn) {
    btn.disabled=true; btn.textContent='...';
    const r=await fetch(`/admin/users/${id}/unblock`,{method:'PATCH',headers:{'X-CSRF-Token':CSRF}});
    const d=await r.json(); if(d.ok){loadUsers();toast('Usuário desbloqueado.');}else{toast(d.error||'Erro','err');btn.disabled=false;btn.textContent='Desbloquear';}
  };

  // ── CAR WASHES ────────────────────────────────────────────────────────
  function loadCarWashes() {
    fetch('/admin/car_washes',{headers:{Accept:'application/json'}}).then(r=>r.json()).then(data=>{
      allCws=data; renderCarWashes(data);
    }).catch(()=>{});
  }
  function renderCarWashes(data) {
    document.getElementById('cws-panel-title').textContent=`Lava-rápidos — ${data.length} lava-rápidos`;
    document.getElementById('cws-table-wrap').innerHTML=`<table class="adm-table">
      <thead><tr><th>Nome</th><th>Proprietário</th><th>Status</th><th>Serviços</th><th>Agend.</th><th>Receita</th><th>Ações</th></tr></thead>
      <tbody>${data.map(cw=>`<tr>
        <td style="font-weight:500;">${cw.name}</td>
        <td style="color:var(--text-muted);">${cw.owner||'—'}</td>
        <td><span class="badge ${cw.active?'badge-green':'badge-red'}">${cw.active?'Ativo':'Inativo'}</span></td>
        <td style="color:var(--text-muted);">${cw.services}</td>
        <td style="color:var(--text-muted);">${cw.appointments}</td>
        <td style="color:var(--lime);">R$${cw.revenue.toLocaleString('pt-BR',{minimumFractionDigits:2})}</td>
        <td>${cw.active
          ? `<button class="tbl-btn tbl-btn-red" onclick="deactivateCw(${cw.id},this)">Desativar</button>`
          : `<button class="tbl-btn tbl-btn-green" onclick="activateCw(${cw.id},this)">Ativar</button>`
        }</td>
      </tr>`).join('')}</tbody>
    </table>`;
  }
  window.deactivateCw = async function(id, btn) {
    btn.disabled=true; btn.textContent='...';
    const r=await fetch(`/admin/car_washes/${id}/deactivate`,{method:'PATCH',headers:{'X-CSRF-Token':CSRF}});
    const d=await r.json(); if(d.ok){allCws=[];loadCarWashes();toast('Desativado.');}else{toast(d.error||'Erro','err');btn.disabled=false;btn.textContent='Desativar';}
  };
  window.activateCw = async function(id, btn) {
    btn.disabled=true; btn.textContent='...';
    const r=await fetch(`/admin/car_washes/${id}/activate`,{method:'PATCH',headers:{'X-CSRF-Token':CSRF}});
    const d=await r.json(); if(d.ok){allCws=[];loadCarWashes();toast('Ativado.');}else{toast(d.error||'Erro','err');btn.disabled=false;btn.textContent='Ativar';}
  };

  // ── APPOINTMENTS ──────────────────────────────────────────────────────
  function loadAppts(status='', type='') {
    let url='/admin/appointments';
    const params=[]; if(status) params.push('status='+status); if(type) params.push('appointment_type='+type);
    if(params.length) url+='?'+params.join('&');
    fetch(url,{headers:{Accept:'application/json'}}).then(r=>r.json()).then(data=>{allAppts=data;renderAppts(data);}).catch(()=>{});
  }
  function renderAppts(data) {
    document.getElementById('appts-panel-title').textContent=`Agendamentos — ${data.length} registros`;
    const statColors={attended:'lime',confirmed:'yellow',cancelled:'red',no_show:'red',pending_acceptance:'blue'};
    const statLabels={attended:'Compareceu',confirmed:'Confirmado',cancelled:'Cancelado',no_show:'Não veio',pending_acceptance:'Aguard. aceite'};
    document.getElementById('appts-table-wrap').innerHTML=`<table class="adm-table">
      <thead><tr><th>#</th><th>Cliente</th><th>Serviço</th><th>Lava-rápido</th><th>Tipo</th><th>Status</th><th>Data</th><th>Valor</th><th>Ações</th></tr></thead>
      <tbody>${data.map(a=>`<tr>
        <td style="color:var(--text-muted);">#${a.id}</td>
        <td>${a.client||'—'}</td>
        <td style="color:#888;">${a.service||'—'}</td>
        <td style="color:#888;">${a.car_wash||'—'}</td>
        <td><span class="badge ${a.type==='disponivel'?'badge-green':'badge-blue'}">${a.type==='disponivel'?'Disp.':'Regular'}</span></td>
        <td><span class="badge badge-${statColors[a.status]||'blue'}">${statLabels[a.status]||a.status}</span></td>
        <td style="color:var(--text-muted);">${a.scheduled_at||'—'}</td>
        <td style="color:var(--white);">R$${a.price.toLocaleString('pt-BR',{minimumFractionDigits:2})}</td>
        <td>${a.status!=='cancelled'?`<button class="tbl-btn tbl-btn-red" onclick="cancelAppt(${a.id},this)">Cancelar</button>`:'—'}</td>
      </tr>`).join('')}</tbody>
    </table>`;
  }
  window.filterAppts = function(status) {
    currentApptStatus=status; currentApptType='';
    document.querySelectorAll('#section-appointments .adm-filter-btn').forEach(b=>b.classList.remove('active'));
    event.target.classList.add('active');
    loadAppts(status,'');
  };
  window.filterAppts2 = function(type) {
    currentApptType=type; currentApptStatus='';
    document.querySelectorAll('#section-appointments .adm-filter-btn').forEach(b=>b.classList.remove('active'));
    event.target.classList.add('active');
    loadAppts('',type);
  };
  window.cancelAppt = async function(id, btn) {
    if(!confirm('Cancelar agendamento #'+id+'?')) return;
    btn.disabled=true; btn.textContent='...';
    const r=await fetch(`/admin/appointments/${id}/cancel`,{method:'PATCH',headers:{'X-CSRF-Token':CSRF}});
    const d=await r.json(); if(d.ok){loadAppts(currentApptStatus,currentApptType);toast('Agendamento cancelado.');}else{toast(d.error||'Erro','err');btn.disabled=false;btn.textContent='Cancelar';}
  };

  // ── FINANCIAL ─────────────────────────────────────────────────────────
  window.loadFinancial = function(months) {
    document.querySelectorAll('#section-financial .adm-filter-btn:not(:last-child)').forEach(b=>b.classList.toggle('active',b.onclick?.toString().includes(months+')')));
    fetch(`/admin/financial?months=${months}`,{headers:{Accept:'application/json'}}).then(r=>r.json()).then(d=>{
      document.getElementById('fin-volume').textContent='R$'+(d.summary.total_volume||0).toLocaleString('pt-BR',{minimumFractionDigits:2});
      document.getElementById('fin-commission').textContent='R$'+(d.summary.total_commission||0).toLocaleString('pt-BR',{minimumFractionDigits:2});
      document.getElementById('fin-period').textContent='R$'+(d.summary.total_commission||0).toLocaleString('pt-BR',{minimumFractionDigits:2});
      document.getElementById('fin-count').textContent=d.summary.total_count||0;
      document.getElementById('fin-panel-title').textContent=`Transações Disponíveis — ${d.transactions?.length||0} transações`;
      document.getElementById('fin-table-wrap').innerHTML=`<table class="adm-table">
        <thead><tr><th>#</th><th>Data</th><th>Cliente</th><th>Serviço</th><th>Lava-rápido</th><th>Valor</th><th>Pré-pago</th><th>Comissão</th></tr></thead>
        <tbody>${(d.transactions||[]).map(t=>`<tr>
          <td style="color:var(--text-muted);">#${t.id}</td>
          <td style="color:var(--text-muted);">${t.scheduled_at}</td>
          <td>${t.client||'—'}</td>
          <td style="color:#888;">${t.service||'—'}</td>
          <td style="color:#888;">${t.car_wash||'—'}</td>
          <td>R$${t.price.toLocaleString('pt-BR',{minimumFractionDigits:2})}</td>
          <td style="color:var(--text-muted);">R$${t.prepayment.toLocaleString('pt-BR',{minimumFractionDigits:2})}</td>
          <td style="color:var(--lime);">R$${t.commission.toLocaleString('pt-BR',{minimumFractionDigits:2})}</td>
        </tr>`).join('')}</tbody>
      </table>`;
    }).catch(()=>{});
  };
  window.exportFinancial = function() { window.location.href='/admin/financial/export'; };

  // ── SUPPORT ───────────────────────────────────────────────────────────
  function loadSupport(status='') {
    const url = status ? `/admin/support_tickets?status=${status}` : '/admin/support_tickets';
    fetch(url,{headers:{Accept:'application/json'}}).then(r=>r.json()).then(data=>{
      allSupport=data; renderSupport(data);
    }).catch(()=>{});
  }
  window.filterSupport = function(status) {
    document.querySelectorAll('#section-support .adm-filter-btn').forEach(b=>b.classList.toggle('active',b.onclick?.toString().includes(`'${status}'`)));
    loadSupport(status);
  };

  function renderSupport(data) {
    document.getElementById('support-panel-title').textContent=`Chamados de suporte — ${data.length} registros`;
    if(!data.length){document.getElementById('support-list').innerHTML='<div style="padding:2rem;text-align:center;color:#1a1a1a;font-size:.78rem;">Nenhum chamado.</div>';return;}
    document.getElementById('support-list').innerHTML = data.map(t=>renderTicketCard(t)).join('');
  }

  function renderTicketCard(t) {
    const statusBadge = t.status==='resolved'
      ? '<span class="badge badge-green">Resolvido</span>'
      : t.status==='in_progress'
      ? '<span class="badge badge-blue">Em andamento</span>'
      : '<span class="badge badge-yellow">Aberto</span>';

    const agentDraftHtml = t.agent_draft && !t.agent_sent ? `
      <div class="agent-draft-box">
        <div class="agent-draft-label"><i class="fas fa-robot"></i> Rascunho IA — ${t.agent_drafted_at||''}</div>
        <div class="agent-draft-body">${t.agent_draft}</div>
        <div class="draft-actions">
          <button class="draft-btn draft-approve" onclick="approveDraft(${t.id},this)"><i class="fas fa-check"></i> Aprovar e enviar</button>
          <button class="draft-btn draft-edit" onclick="editDraft(${t.id})"><i class="fas fa-pen"></i> Editar</button>
          <button class="draft-btn draft-discard" onclick="discardDraft(${t.id},this)"><i class="fas fa-trash"></i> Descartar</button>
        </div>
      </div>` : '';

    const msgs = (t.messages||[]).map(m=>`
      <div class="msg-bubble ${m.from_admin?'msg-admin':'msg-owner'}">
        <div class="msg-author">${m.author}</div>
        <div class="msg-body">${m.body}</div>
        <div class="msg-time">${m.created_at}</div>
      </div>`).join('');

    const replyArea = t.status!=='resolved' ? `
      <div class="reply-area">
        <textarea class="reply-textarea" id="reply-${t.id}" placeholder="Escreva sua resposta..."></textarea>
        <div class="reply-actions">
          <button class="reply-send" onclick="sendReply(${t.id},this)"><i class="fas fa-paper-plane"></i> Responder</button>
          <button class="reply-resolve" onclick="resolveTicket(${t.id},this)"><i class="fas fa-check-double"></i> Resolver</button>
          <button class="run-agent-btn" onclick="runAgent(${t.id},this)"><i class="fas fa-robot"></i> IA</button>
        </div>
      </div>` : `
      <div style="display:flex;gap:.5rem;">
        <button class="reply-reopen" onclick="reopenTicket(${t.id},this)"><i class="fas fa-rotate-left"></i> Reabrir</button>
      </div>`;

    return `<div class="adm-panel" id="ticket-${t.id}" style="margin-bottom:.75rem;">
      <div class="adm-panel-header">
        <div style="display:flex;align-items:center;gap:.75rem;flex-wrap:wrap;">
          ${statusBadge}
          <span style="font-size:.72rem;color:#888;">#${t.id} · ${t.category}</span>
          <span style="font-size:.72rem;font-weight:600;color:var(--white);">${t.owner_name||t.owner_email||'—'}</span>
          <span style="font-size:.62rem;color:var(--text-muted);">${t.car_wash_name||'—'}</span>
        </div>
        <span style="font-size:.62rem;color:var(--text-muted);">${t.created_at}</span>
      </div>
      <div style="padding:.875rem 1.25rem;">
        ${agentDraftHtml}
        <div class="support-thread" id="thread-${t.id}">${msgs||'<div style="color:#1a1a1a;font-size:.72rem;padding:.5rem 0;">Nenhuma mensagem.</div>'}</div>
        ${replyArea}
      </div>
    </div>`;
  }

  window.sendReply = async function(id, btn) {
    const ta=document.getElementById('reply-'+id); const body=ta?.value.trim(); if(!body)return;
    btn.disabled=true; btn.innerHTML='<i class="fas fa-circle-notch spin"></i>';
    const r=await fetch(`/admin/support_tickets/${id}/message`,{method:'POST',headers:{'X-CSRF-Token':CSRF,'Content-Type':'application/json'},body:JSON.stringify({body})});
    const d=await r.json();
    if(d.ok){toast('Resposta enviada.');loadSupport();}
    else{toast(d.error||'Erro','err');btn.disabled=false;btn.innerHTML='<i class="fas fa-paper-plane"></i> Responder';}
  };
  window.resolveTicket = async function(id, btn) {
    btn.disabled=true; btn.innerHTML='<i class="fas fa-circle-notch spin"></i>';
    const r=await fetch(`/admin/support_tickets/${id}/resolve`,{method:'PATCH',headers:{'X-CSRF-Token':CSRF}});
    const d=await r.json(); if(d.ok){toast('Ticket resolvido.');loadSupport();}else{toast(d.error||'Erro','err');btn.disabled=false;btn.innerHTML='<i class="fas fa-check-double"></i> Resolver';}
  };
  window.reopenTicket = async function(id, btn) {
    btn.disabled=true; btn.innerHTML='...';
    const r=await fetch(`/admin/support_tickets/${id}/reopen`,{method:'PATCH',headers:{'X-CSRF-Token':CSRF}});
    const d=await r.json(); if(d.ok){toast('Ticket reaberto.');loadSupport();}else{toast(d.error||'Erro','err');btn.disabled=false;btn.innerHTML='Reabrir';}
  };
  window.approveDraft = async function(id, btn) {
    btn.disabled=true; btn.innerHTML='<i class="fas fa-circle-notch spin"></i>';
    const r=await fetch(`/admin/support_tickets/${id}/approve_draft`,{method:'POST',headers:{'X-CSRF-Token':CSRF}});
    const d=await r.json(); if(d.ok){toast('Rascunho enviado.');loadSupport();}else{toast(d.error||'Erro','err');btn.disabled=false;btn.innerHTML='<i class="fas fa-check"></i> Aprovar e enviar';}
  };
  window.discardDraft = async function(id, btn) {
    btn.disabled=true;
    const r=await fetch(`/admin/support_tickets/${id}/discard_draft`,{method:'DELETE',headers:{'X-CSRF-Token':CSRF}});
    const d=await r.json(); if(d.ok){toast('Rascunho descartado.');loadSupport();}else{toast('Erro','err');btn.disabled=false;}
  };
  window.editDraft = function(id) {
    const box=document.querySelector(`#ticket-${id} .agent-draft-body`);
    const ta=document.getElementById('reply-'+id);
    if(box&&ta){ta.value=box.textContent.trim();ta.focus();}
  };
  window.runAgent = async function(id, btn) {
    btn.disabled=true; btn.innerHTML='<i class="fas fa-circle-notch spin"></i>';
    const r=await fetch(`/admin/support_tickets/${id}/run_agent`,{method:'POST',headers:{'X-CSRF-Token':CSRF}});
    const d=await r.json();
    btn.disabled=false; btn.innerHTML='<i class="fas fa-robot"></i> IA';
    if(d.ok){toast('Rascunho gerado.');loadSupport();}
    else if(d.escalate){toast('Agente indica escalação: '+d.message,'err');}
    else{toast(d.message||'Agente não gerou rascunho.','err');}
  };

  // ── CEO ASSISTANT ─────────────────────────────────────────────────────
  window.openCeoAssistant = function() {
    document.getElementById('ceo-overlay').classList.add('open');
    document.body.style.overflow='hidden';
  };
  function closeCeoAssistant() {
    document.getElementById('ceo-overlay').classList.remove('open');
    document.body.style.overflow='';
  }
  document.getElementById('ceo-close').addEventListener('click', closeCeoAssistant);
  document.getElementById('ceo-overlay').addEventListener('click', e=>{if(e.target===document.getElementById('ceo-overlay'))closeCeoAssistant();});

  async function runCeoAssistant() {
    const focus = document.getElementById('ceo-focus-input').value.trim();
    const btn   = document.getElementById('ceo-run-btn');
    const body  = document.getElementById('ceo-modal-body');
    const footer= document.getElementById('ceo-footer');

    btn.disabled=true; btn.innerHTML='<i class="fas fa-circle-notch spin"></i> Analisando...';
    footer.style.display='none';

    body.innerHTML=`<div class="ceo-loading">
      <div class="ceo-loading-orb"><i class="fas fa-brain" style="color:#a78bfa;font-size:1.25rem;"></i></div>
      <div class="ceo-loading-text">
        Lendo todos os dados da plataforma...<br>
        <span style="font-size:.65rem;color:#1a1a1a;">Usuários · Lava-rápidos · Agendamentos · Financeiro · Suporte</span>
      </div>
    </div>`;

    try {
      const r = await fetch('/admin/ceo_assistant/analyze', {
        method: 'POST',
        headers: { 'X-CSRF-Token': CSRF, 'Content-Type': 'application/json' },
        body: JSON.stringify({ focus })
      });
      const d = await r.json();

      if (!d.ok) { throw new Error(d.error||'Erro desconhecido'); }

      renderBriefing(d.briefing, d.generated_at);
      footer.style.display='flex';
      document.getElementById('ceo-gen-at').textContent = 'Gerado em ' + d.generated_at;
    } catch(e) {
      body.innerHTML=`<div style="padding:2rem;text-align:center;color:var(--red);font-size:.8rem;"><i class="fas fa-triangle-exclamation" style="display:block;font-size:1.5rem;margin-bottom:.75rem;"></i>${e.message}</div>`;
    } finally {
      btn.disabled=false; btn.innerHTML='<i class="fas fa-brain"></i> Analisar';
    }
  }

  function renderBriefing(text, generatedAt) {
    const sectionMap = {
      'PULSO DA PLATAFORMA':        { key: 'pulse',    color: 'pulse',    icon: 'fa-heart-pulse' },
      'OPORTUNIDADES CRÍTICAS':     { key: 'opp',      color: 'opp',      icon: 'fa-rocket' },
      'ALERTAS VERMELHOS':          { key: 'alert',    color: 'alert',    icon: 'fa-triangle-exclamation' },
      'MONETIZAÇÃO':                { key: 'money',    color: 'money',    icon: 'fa-coins' },
      'DECISÃO DESTA SEMANA':       { key: 'decision', color: 'decision', icon: 'fa-bullseye' },
      'VISÃO 90 DIAS':              { key: 'vision',   color: 'vision',   icon: 'fa-chart-line' },
    };

    let html = '';
    let remaining = text;

    const sections = Object.keys(sectionMap);
    sections.forEach((title, idx) => {
      const nextTitle = sections[idx + 1];
      const start = remaining.indexOf(title);
      if (start === -1) return;
      const end = nextTitle ? remaining.indexOf(nextTitle, start + title.length) : remaining.length;
      const content = remaining.slice(start + title.length, end > -1 ? end : undefined).trim();
      const meta = sectionMap[title];

      html += `<div class="ceo-section">
        <div class="ceo-section-title ${meta.color}"><i class="fas ${meta.icon}" style="margin-right:.4rem;"></i>${title}</div>
        <div class="ceo-section-body">${content}</div>
      </div>`;
    });

    // fallback: se não parseou, mostra raw
    if (!html) {
      html = `<div class="ceo-briefing">${text}</div>`;
    }

    document.getElementById('ceo-modal-body').innerHTML = html;
  }

  document.getElementById('ceo-run-btn').addEventListener('click', runCeoAssistant);
  document.getElementById('ceo-rerun').addEventListener('click', runCeoAssistant);
  document.getElementById('ceo-focus-input').addEventListener('keydown', e=>{ if(e.key==='Enter') runCeoAssistant(); });

  // ── INIT ──────────────────────────────────────────────────────────────
  document.addEventListener('DOMContentLoaded', () => {
    loadStats();
    loadActivity();
  });
})();
</script>
</body>
</html>
