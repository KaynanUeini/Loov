<% Rails.logger.info("Iniciando renderização do template car_washes/edit.html.erb") %>

<style>
  .cwe-nested-card {
    background: var(--cream);
    border: 1px solid var(--stone);
    border-radius: 14px;
    padding: 18px;
    margin-bottom: 12px;
  }
  .cwe-destroy-row {
    display: flex; align-items: center; gap: 8px;
    margin-top: 8px; font-size: 13px; color: var(--rose-500);
  }
  .cwe-destroy-row input[type="checkbox"] { accent-color: var(--rose-500); }
</style>

<div class="loov-page loov-page--narrow">
  <div class="loov-hero">
    <div class="loov-eyebrow"><span class="dot"></span>EDITAR LAVA-RÁPIDO</div>
    <h1 class="loov-h1">
      Atualizar <span class="accent">dados</span>.
    </h1>
    <p class="loov-lead">
      Edite informações, horários de funcionamento e serviços do seu lava-rápido.
    </p>
  </div>

  <%= form_with model: @car_wash, local: true do |form| %>
    <% if @car_wash.errors.any? %>
      <div style="background:#fdecec;border:1px solid #f5cccc;border-radius:14px;padding:14px 18px;margin-bottom:18px;">
        <div style="font-family:'JetBrains Mono',monospace;font-size:11px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase;color:#c85050;margin-bottom:8px;">
          <i class="fas fa-circle-exclamation" style="margin-right:6px;"></i>Não foi possível salvar
        </div>
        <ul style="margin:0;padding-left:20px;font-size:13.5px;color:#7a3838;line-height:1.55;">
          <% @car_wash.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="loov-card loov-card--lg" style="margin-bottom:18px;">
      <div class="loov-section-label"><i class="fas fa-store" style="margin-right:6px;"></i>DADOS</div>
      <h2 class="loov-h2" style="font-size:20px;margin-bottom:18px;">Identificação</h2>

      <div class="loov-field">
        <%= form.label :name, "Nome do Lava-Rápido", class: "loov-label" %>
        <%= form.text_field :name, class: "loov-input", required: true %>
      </div>
      <div class="loov-field">
        <%= form.label :address, "Endereço", class: "loov-label" %>
        <%= form.text_field :address, class: "loov-input", required: true %>
      </div>
    </div>

    <div class="loov-card loov-card--lg" style="margin-bottom:18px;">
      <div class="loov-section-label"><i class="fas fa-clock" style="margin-right:6px;"></i>HORÁRIOS</div>
      <h2 class="loov-h2" style="font-size:20px;margin-bottom:18px;">Funcionamento</h2>

      <div id="operating_hours">
        <%= form.fields_for :operating_hours do |oh_form| %>
          <div class="cwe-nested-card operating-hour-fields">
            <div class="loov-field">
              <%= oh_form.label :day_of_week, "Dia da semana", class: "loov-label" %>
              <%= oh_form.select :day_of_week, [
                ["Domingo", 0], ["Segunda-feira", 1], ["Terça-feira", 2],
                ["Quarta-feira", 3], ["Quinta-feira", 4], ["Sexta-feira", 5], ["Sábado", 6]
              ], { prompt: "Selecione o dia" }, class: "loov-input", required: true %>
            </div>
            <div class="loov-grid-2">
              <div class="loov-field">
                <%= oh_form.label :opens_at, "Abertura", class: "loov-label" %>
                <%= oh_form.time_field :opens_at, class: "loov-input", required: true %>
              </div>
              <div class="loov-field">
                <%= oh_form.label :closes_at, "Fechamento", class: "loov-label" %>
                <%= oh_form.time_field :closes_at, class: "loov-input", required: true %>
              </div>
            </div>
            <label class="cwe-destroy-row">
              <%= oh_form.check_box :_destroy %>
              Remover este horário
            </label>
          </div>
        <% end %>
      </div>

      <%= link_to "Adicionar horário", "#", id: "add-operating-hour", class: "loov-btn-secondary loov-btn-sm" %>
    </div>

    <div class="loov-card loov-card--lg" style="margin-bottom:24px;">
      <div class="loov-section-label"><i class="fas fa-spray-can-sparkles" style="margin-right:6px;"></i>SERVIÇOS</div>
      <h2 class="loov-h2" style="font-size:20px;margin-bottom:18px;">Catálogo</h2>

      <div id="services">
        <%= form.fields_for :services do |service_form| %>
          <div class="cwe-nested-card service-fields">
            <div class="loov-field">
              <%= service_form.label :title, "Título", class: "loov-label" %>
              <%= service_form.text_field :title, class: "loov-input", required: true %>
            </div>
            <div class="loov-field">
              <%= service_form.label :description, "Descrição", class: "loov-label" %>
              <%= service_form.text_area :description, class: "loov-textarea", required: true %>
            </div>
            <div class="loov-grid-2">
              <div class="loov-field">
                <%= service_form.label :price, "Preço (R$)", class: "loov-label" %>
                <%= service_form.number_field :price, step: 0.01, min: 0, class: "loov-input", required: true %>
              </div>
              <div class="loov-field">
                <%= service_form.label :duration, "Duração (min)", class: "loov-label" %>
                <%= service_form.number_field :duration, min: 1, class: "loov-input", required: true %>
              </div>
            </div>
            <label class="cwe-destroy-row">
              <%= service_form.check_box :_destroy %>
              Remover este serviço
            </label>
          </div>
        <% end %>
      </div>

      <%= link_to "Adicionar serviço", "#", id: "add-service", class: "loov-btn-secondary loov-btn-sm" %>
    </div>

    <%= form.submit "Atualizar lava-rápido", class: "loov-btn-primary loov-btn-block loov-btn-lg" %>
  <% end %>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const addOH = document.getElementById('add-operating-hour');
  const ohContainer = document.getElementById('operating_hours');
  if (addOH && ohContainer) {
    addOH.addEventListener('click', e => {
      e.preventDefault();
      const t = Date.now();
      ohContainer.insertAdjacentHTML('beforeend', `
        <div class="cwe-nested-card operating-hour-fields">
          <div class="loov-field">
            <label class="loov-label">Dia da semana</label>
            <select name="car_wash[operating_hours_attributes][${t}][day_of_week]" class="loov-input" required>
              <option value="">Selecione o dia</option>
              <option value="0">Domingo</option><option value="1">Segunda-feira</option>
              <option value="2">Terça-feira</option><option value="3">Quarta-feira</option>
              <option value="4">Quinta-feira</option><option value="5">Sexta-feira</option>
              <option value="6">Sábado</option>
            </select>
          </div>
          <div class="loov-grid-2">
            <div class="loov-field">
              <label class="loov-label">Abertura</label>
              <input type="time" name="car_wash[operating_hours_attributes][${t}][opens_at]" class="loov-input" required>
            </div>
            <div class="loov-field">
              <label class="loov-label">Fechamento</label>
              <input type="time" name="car_wash[operating_hours_attributes][${t}][closes_at]" class="loov-input" required>
            </div>
          </div>
          <label class="cwe-destroy-row">
            <input type="checkbox" name="car_wash[operating_hours_attributes][${t}][_destroy]"> Remover este horário
          </label>
        </div>`);
    });
  }

  const addS = document.getElementById('add-service');
  const sContainer = document.getElementById('services');
  if (addS && sContainer) {
    addS.addEventListener('click', e => {
      e.preventDefault();
      const t = Date.now();
      sContainer.insertAdjacentHTML('beforeend', `
        <div class="cwe-nested-card service-fields">
          <div class="loov-field">
            <label class="loov-label">Título</label>
            <input type="text" name="car_wash[services_attributes][${t}][title]" class="loov-input" required>
          </div>
          <div class="loov-field">
            <label class="loov-label">Descrição</label>
            <textarea name="car_wash[services_attributes][${t}][description]" class="loov-textarea" required></textarea>
          </div>
          <div class="loov-grid-2">
            <div class="loov-field">
              <label class="loov-label">Preço (R$)</label>
              <input type="number" step="0.01" min="0" name="car_wash[services_attributes][${t}][price]" class="loov-input" required>
            </div>
            <div class="loov-field">
              <label class="loov-label">Duração (min)</label>
              <input type="number" min="1" name="car_wash[services_attributes][${t}][duration]" class="loov-input" required>
            </div>
          </div>
          <label class="cwe-destroy-row">
            <input type="checkbox" name="car_wash[services_attributes][${t}][_destroy]"> Remover este serviço
          </label>
        </div>`);
    });
  }
});
</script>
<% Rails.logger.info("Template car_washes/edit.html.erb renderizado com sucesso") %>
