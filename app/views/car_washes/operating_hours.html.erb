<div class="loov-page">
  <div class="loov-hero loov-hero--left">
    <div class="loov-eyebrow"><span class="dot"></span>HORÁRIOS</div>
    <h1 class="loov-h1">Horários de <span class="accent">funcionamento</span>.</h1>
    <p class="loov-lead">Adicione, edite ou remova os horários em que o lava-rápido está aberto.</p>
  </div>

  <div class="loov-section">
    <div class="loov-section-header">
      <div>
        <div class="loov-section-label">ADICIONAR</div>
        <h2 class="loov-h2">Novo horário</h2>
      </div>
    </div>

    <div class="loov-card">
      <%= form_with(model: [@car_wash, @operating_hour], url: create_operating_hour_car_wash_path(@car_wash), local: true) do |form| %>
        <% if @operating_hour.errors.any? %>
          <div class="loov-card loov-card--compact" style="background:#fdecec; border-color:#f5cccc; margin-bottom:18px;">
            <h4 style="font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:1.4px; text-transform:uppercase; color:var(--rose-500); margin:0 0 8px;">
              <% if @operating_hour.errors[:day_of_week].include?("já está na lista de horários de funcionamento") %>
                Não é possível adicionar um dia que já está na lista
              <% else %>
                <% if @operating_hour.errors.count == 1 %>
                  1 erro impediu a criação
                <% else %>
                  <%= @operating_hour.errors.count %> erros impediram a criação
                <% end %>
              <% end %>
            </h4>
            <% unless @operating_hour.errors[:day_of_week].include?("já está na lista de horários de funcionamento") %>
              <ul style="margin:0; padding-left:18px;">
                <% @operating_hour.errors.full_messages.each do |message| %>
                  <li style="font-size:13px; color:var(--rose-500);"><%= message %></li>
                <% end %>
              </ul>
            <% end %>
          </div>
        <% end %>

        <div class="loov-field">
          <%= form.label :day_of_week, "Dia da semana", class: "loov-label" %>
          <%= form.select :day_of_week, options_for_select([
            ["Domingo", 0],
            ["Segunda-feira", 1],
            ["Terça-feira", 2],
            ["Quarta-feira", 3],
            ["Quinta-feira", 4],
            ["Sexta-feira", 5],
            ["Sábado", 6]
          ], @operating_hour.day_of_week), {}, { class: "loov-select" } %>
        </div>

        <div class="loov-field">
          <%= form.label :opens_at, "Horário de abertura", class: "loov-label" %>
          <%= form.time_field :opens_at, class: "loov-input" %>
        </div>

        <div class="loov-field">
          <%= form.label :closes_at, "Horário de fechamento", class: "loov-label" %>
          <%= form.time_field :closes_at, class: "loov-input" %>
        </div>

        <div class="loov-cta-row" style="justify-content: flex-start; margin-top: 20px;">
          <%= form.submit "Adicionar horário", class: "loov-btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="loov-section">
    <div class="loov-section-header">
      <div>
        <div class="loov-section-label">CADASTRADOS</div>
        <h2 class="loov-h2">Horários existentes</h2>
      </div>
    </div>

    <% if @operating_hours.any? %>
      <div class="loov-card" style="padding: 0; overflow: hidden;">
        <table style="width:100%; border-collapse: collapse;">
          <thead>
            <tr>
              <th style="text-align:left; padding:14px 22px; font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:1.4px; text-transform:uppercase; color:var(--graphite); border-bottom:1px solid var(--stone);">Dia</th>
              <th style="text-align:left; padding:14px 22px; font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:1.4px; text-transform:uppercase; color:var(--graphite); border-bottom:1px solid var(--stone);">Abre</th>
              <th style="text-align:left; padding:14px 22px; font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:1.4px; text-transform:uppercase; color:var(--graphite); border-bottom:1px solid var(--stone);">Fecha</th>
              <th style="text-align:right; padding:14px 22px; font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:1.4px; text-transform:uppercase; color:var(--graphite); border-bottom:1px solid var(--stone);">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% @operating_hours.each do |hour| %>
              <% if hour.id.present? %>
                <tr>
                  <td style="padding:14px 22px; border-bottom:1px solid var(--stone); color:var(--ink);"><%= %w[Domingo Segunda-feira Terça-feira Quarta-feira Quinta-feira Sexta-feira Sábado][hour.day_of_week.to_i] %></td>
                  <td style="padding:14px 22px; border-bottom:1px solid var(--stone); color:var(--graphite);"><%= hour.opens_at ? hour.opens_at.strftime('%H:%M') : "Não definido" %></td>
                  <td style="padding:14px 22px; border-bottom:1px solid var(--stone); color:var(--graphite);"><%= hour.closes_at ? hour.closes_at.strftime('%H:%M') : "Não definido" %></td>
                  <td style="padding:14px 22px; border-bottom:1px solid var(--stone); text-align:right;">
                    <%= link_to 'Editar', edit_operating_hour_car_wash_path(@car_wash, hour), class: "loov-btn-ghost loov-btn-sm" %>
                    <%= link_to 'Excluir', destroy_operating_hour_car_wash_path(@car_wash, hour), method: :delete, data: { confirm: 'Tem certeza que deseja excluir este horário de funcionamento?' }, class: 'loov-btn-ghost loov-btn-sm', style: "color: var(--rose-500);" %>
                  </td>
                </tr>
              <% else %>
                <tr>
                  <td colspan="4" style="padding:14px 22px; border-bottom:1px solid var(--stone); color:var(--ash);">Horário inválido (ID ausente)</td>
                </tr>
              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="loov-card" style="text-align:center;">
        <p class="loov-card-text">Nenhum horário de funcionamento cadastrado.</p>
      </div>
    <% end %>
  </div>

  <div class="loov-cta-row" style="justify-content: flex-start;">
    <%= link_to 'Voltar', @car_wash, class: "loov-btn-secondary" %>
  </div>
</div>
