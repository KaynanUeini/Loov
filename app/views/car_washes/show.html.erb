<% Rails.logger.info("Iniciando renderização do template car_washes/show.html.erb") %>

<%
reviews          = @car_wash.reviews.includes(:user).order(created_at: :desc)
avg_rating       = reviews.any? ? reviews.average(:rating).to_f.round(1) : nil
review_count     = reviews.count
counts_by_star   = (1..5).map { |s| [s, reviews.where(rating: s).count] }.to_h
today_dow        = Date.current.wday
opens_today      = @car_wash.operating_hours.find_by(day_of_week: today_dow)
now_sp           = Time.current.in_time_zone("America/Sao_Paulo")
is_open_now      = opens_today.present? &&
                   now_sp.seconds_since_midnight >= opens_today.opens_at.seconds_since_midnight &&
                   now_sp.seconds_since_midnight < opens_today.closes_at.seconds_since_midnight &&
                   !@car_wash.closed_on?(now_sp.to_date)
min_price        = @car_wash.services.minimum(:price)
is_client        = user_signed_in? && current_user.client?
is_owner_manage  = user_signed_in? && current_user.owner? && @car_wash.user == current_user

# Categoria → ícone Font Awesome + paleta (espelha CATEGORY_MAP do app)
def cat_meta(category, idx)
  key = category.to_s.downcase.strip
  table = {
    'lavagem'                    => { icon: 'fa-droplet',       bg: '#d1e1ed', fg: '#2a5f8a' },
    'polimento'                  => { icon: 'fa-feather',       bg: '#f7e4a8', fg: '#7a5a10' },
    'higienização'               => { icon: 'fa-wind',          bg: '#d6ecde', fg: '#2a6840' },
    'higienizacao'               => { icon: 'fa-wind',          bg: '#d6ecde', fg: '#2a6840' },
    'cristalização'              => { icon: 'fa-gem',           bg: '#e0e0f5', fg: '#3d4180' },
    'cristalizacao'              => { icon: 'fa-gem',           bg: '#e0e0f5', fg: '#3d4180' },
    'vitrificação'               => { icon: 'fa-shield',        bg: '#cde7e8', fg: '#1f5b66' },
    'vitrificacao'               => { icon: 'fa-shield',        bg: '#cde7e8', fg: '#1f5b66' },
    'enceramento'                => { icon: 'fa-circle',        bg: '#f0d9c0', fg: '#7a4818' },
    'hidratação de couro'        => { icon: 'fa-layer-group',   bg: '#e8d4b8', fg: '#6b4818' },
    'hidratacao de couro'        => { icon: 'fa-layer-group',   bg: '#e8d4b8', fg: '#6b4818' },
    'hidratação couro'           => { icon: 'fa-layer-group',   bg: '#e8d4b8', fg: '#6b4818' },
    'hidratacao couro'           => { icon: 'fa-layer-group',   bg: '#e8d4b8', fg: '#6b4818' },
    'limpeza de motor'           => { icon: 'fa-microchip',     bg: '#dde0e3', fg: '#3a4148' },
    'motor'                      => { icon: 'fa-microchip',     bg: '#dde0e3', fg: '#3a4148' },
    'revitalização de plásticos' => { icon: 'fa-arrows-rotate', bg: '#e8d4ee', fg: '#5a2778' },
    'revitalizacao de plasticos' => { icon: 'fa-arrows-rotate', bg: '#e8d4ee', fg: '#5a2778' },
    'plásticos'                  => { icon: 'fa-arrows-rotate', bg: '#e8d4ee', fg: '#5a2778' },
    'plasticos'                  => { icon: 'fa-arrows-rotate', bg: '#e8d4ee', fg: '#5a2778' },
    'polimento de faróis'        => { icon: 'fa-sun',           bg: '#fbe2c0', fg: '#7a4814' },
    'polimento de farois'        => { icon: 'fa-sun',           bg: '#fbe2c0', fg: '#7a4814' },
    'faróis'                     => { icon: 'fa-sun',           bg: '#fbe2c0', fg: '#7a4814' },
    'farois'                     => { icon: 'fa-sun',           bg: '#fbe2c0', fg: '#7a4814' },
    'impermeabilização'          => { icon: 'fa-umbrella',      bg: '#cce4f5', fg: '#1f5078' },
    'impermeabilizacao'          => { icon: 'fa-umbrella',      bg: '#cce4f5', fg: '#1f5078' },
    'oxi-sanitização'            => { icon: 'fa-filter',        bg: '#d4ebd9', fg: '#286b48' },
    'oxi-sanitizacao'            => { icon: 'fa-filter',        bg: '#d4ebd9', fg: '#286b48' },
    'oxi'                        => { icon: 'fa-filter',        bg: '#d4ebd9', fg: '#286b48' },
    'outros'                     => { icon: 'fa-th-large',      bg: '#f5d3c3', fg: '#9c4930' },
  }
  fallback = [
    { icon: 'fa-droplet',       bg: '#d1e1ed', fg: '#2a5f8a' },
    { icon: 'fa-feather',       bg: '#f7e4a8', fg: '#7a5a10' },
    { icon: 'fa-sun',           bg: '#fbe2c0', fg: '#7a4814' },
    { icon: 'fa-star',          bg: '#d6ecde', fg: '#2a6840' },
    { icon: 'fa-gem',           bg: '#e0e0f5', fg: '#3d4180' },
    { icon: 'fa-shield',        bg: '#cde7e8', fg: '#1f5b66' },
    { icon: 'fa-circle',        bg: '#f0d9c0', fg: '#7a4818' },
    { icon: 'fa-wind',          bg: '#d4ebd9', fg: '#286b48' },
    { icon: 'fa-layer-group',   bg: '#e8d4b8', fg: '#6b4818' },
    { icon: 'fa-umbrella',      bg: '#cce4f5', fg: '#1f5078' },
    { icon: 'fa-arrows-rotate', bg: '#e8d4ee', fg: '#5a2778' },
    { icon: 'fa-microchip',     bg: '#dde0e3', fg: '#3a4148' },
  ]
  table[key] || fallback[idx % fallback.size]
end

def today_hours_short(opens_today)
  return '—' unless opens_today&.opens_at && opens_today&.closes_at
  fmt = ->(t) {
    h = t.hour
    m = t.min
    m == 0 ? h.to_s : sprintf('%d:%02d', h, m)
  }
  "#{fmt.call(opens_today.opens_at)}–#{fmt.call(opens_today.closes_at)}h"
end
