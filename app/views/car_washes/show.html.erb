<% if is_client %>
<div id="cart-pill" onclick="scrollToBooking()">
  <div id="cart-pill-icon"><i class="fas fa-calendar-check"></i></div>
  <span id="cart-pill-label">Agendar</span>
</div>
<% end %>

<div class="loov-page loov-page--wide">
  <div style="margin-bottom: 24px;">
    <%= link_to :back, class: "loov-btn-ghost loov-btn-sm" do %>
      <i class="fas fa-arrow-left"></i> Voltar
    <% end %>
  </div>

  <div class="cw-show-hero-row">
    <div>
      <div class="loov-eyebrow"><span class="dot"></span>LAVA-RÁPIDO</div>
      <div class="cw-show-avatar"><%= @car_wash.name.first(2).upcase %></div>
      <h1 class="loov-h1" style="margin-bottom: 18px;"><%= @car_wash.name %></h1>
      <div class="cw-show-meta">
        <div class="cw-show-meta-item">
          <i class="fas fa-location-dot"></i>
          <span><%= @car_wash.address || "Endereço não informado" %></span>
        </div>
        <% if avg_rating %>
        <div class="cw-show-meta-item">
          <i class="fas fa-star"></i>
          <strong><%= sprintf('%.1f', avg_rating) %></strong>
          <span>(<%= review_count %> <%= review_count == 1 ? 'avaliação' : 'avaliações' %>)</span>
        </div>
        <% end %>
        <div class="cw-show-meta-item">
          <% if is_open %>
          <i class="fas fa-circle" style="color: var(--coral-500); font-size: 8px;"></i>
          <strong style="color: var(--coral-700);">Aberto agora</strong>
          <% if opens_today %><span>· até <%= opens_today.closes_at.strftime("%H:%M") %></span><% end %>
          <% elsif opens_today %>
          <i class="fas fa-circle" style="color: var(--ash); font-size: 8px;"></i>
          <span>Abre às <%= opens_today.opens_at.strftime("%H:%M") %></span>
          <% else %>
          <i class="fas fa-circle" style="color: var(--ash); font-size: 8px;"></i>
          <span>Fechado hoje</span>
          <% end %>
        </div>
      </div>
    </div>
    <div style="display: flex; gap: 10px; flex-shrink: 0;">
      <% if is_owner_manage %>
      <%= link_to manage_car_wash_path(@car_wash), class: "loov-btn-secondary" do %>
        <i class="fas fa-gear"></i> Gerenciar
      <% end %>
      <% end %>
    </div>
  </div>

  <div class="cw-show-divider"></div>

  <div class="cw-show-layout">
    <div class="cw-show-left">
      <% if @car_wash.services.any? %>
      <div>
        <% if categories.any? %>
        <div class="cat-tabs">
          <button class="cat-tab active" data-cat="all">Todos</button>
          <% categories.each do |cat| %>
          <button class="cat-tab" data-cat="<%= cat %>"><%= cat %></button>
          <% end %>
        </div>
        <% end %>
        <div class="services-grid" id="services-grid">
          <% @car_wash.services.each do |service| %>
          <div class="svc-card"
            data-cat="<%= service.category %>"
            data-id="<%= service.id %>"
            data-title="<%= j service.title %>"
            data-price="<%= service.price.to_f %>"
            data-duration="<%= service.duration %>"
            onclick="selectService(this)">
            <div class="svc-card-left">
              <div class="svc-card-name"><%= service.title %></div>
              <% if service.description.present? %>
              <div class="svc-card-desc"><%= service.description %></div>
              <% end %>
              <% if service.category.present? %>
              <div class="svc-card-tags">
                <span class="svc-card-tag"><%= service.category %></span>
                <span class="svc-card-tag"><%= service.duration %> min</span>
              </div>
              <% end %>
            </div>
            <div class="svc-card-right">
              <div class="svc-card-price">R$ <%= number_with_precision(service.price, precision: 0) %></div>
              <div class="svc-card-duration"><%= service.duration %> min</div>
            </div>
            <div class="svc-card-select"><i class="fas fa-plus"></i></div>
          </div>
          <% end %>
        </div>
      </div>
      <% end %>

      <div class="cw-panel">
        <div class="cw-panel-header">
          <span class="cw-panel-title"><i class="fas fa-clock"></i> Horários de funcionamento</span>
        </div>
        <div class="hours-list">
          <% if @car_wash.operating_hours.any? %>
          <% @car_wash.operating_hours.order(Arel.sql("CASE day_of_week WHEN 0 THEN 7 ELSE day_of_week END")).each do |hour| %>
          <% day_name = %w[Domingo Segunda Terça Quarta Quinta Sexta Sábado][hour.day_of_week] %>
          <% is_today_h = hour.day_of_week == today_dow %>
          <div class="hour-item">
            <span class="hour-day" style="<%= is_today_h ? 'color: var(--coral-700);' : '' %>"><%= day_name %></span>
            <span class="hour-time" style="<%= is_today_h ? 'color: var(--ink); font-weight: 600;' : '' %>"><%= hour.opens_at.strftime("%H:%M") %> – <%= hour.closes_at.strftime("%H:%M") %></span>
          </div>
          <% end %>
          <% else %>
          <p style="font-size: 13.5px; color: var(--ash); padding: 10px 0;">Horários não informados.</p>
          <% end %>
        </div>
      </div>

      <div class="cw-panel">
        <div class="cw-panel-header">
          <span class="cw-panel-title"><i class="fas fa-star"></i> Avaliações</span>
          <% if avg_rating %>
          <div class="reviews-summary">
            <div>
              <div class="reviews-avg"><%= sprintf('%.1f', avg_rating) %></div>
              <div class="reviews-avg-meta">
                <div class="reviews-stars"><% 5.times do |i| %><%= i < avg_rating.round ? '★' : '☆' %><% end %></div>
                <div class="reviews-count"><%= review_count %> <%= review_count == 1 ? 'avaliação' : 'avaliações' %></div>
              </div>
            </div>
            <div class="rating-bars">
              <% [5,4,3,2,1].each do |star| %>
              <% count = counts_by_star[star] || 0 %>
              <% pct = review_count > 0 ? (count.to_f / review_count * 100).round : 0 %>
              <div class="rating-bar-row">
                <span><%= star %>★</span>
                <div class="rating-bar-track"><div class="rating-bar-fill" style="width: <%= pct %>%"></div></div>
                <span class="rating-bar-ct"><%= count %></span>
              </div>
              <% end %>
            </div>
          </div>
          <% end %>
        </div>
        <div class="reviews-body">
          <% if reviews.any? %>
          <div class="reviews-grid">
            <% reviews.each do |review| %>
            <div class="review-card">
              <div class="review-top">
                <div class="review-user">
                  <div class="review-avatar"><%= review.user.display_name.first.upcase %></div>
                  <div>
                    <div class="review-user-name"><%= review.user.display_name.split(' ').first %></div>
                    <div class="review-date"><%= review.created_at.strftime("%d/%m/%Y") %></div>
                  </div>
                </div>
                <div class="review-stars">
                  <% 5.times do |i| %><span class="review-star <%= i < review.rating ? 'filled' : '' %>">★</span><% end %>
                </div>
              </div>
              <% if review.tags_list.any? %>
              <div class="review-tags"><% review.tags_list.each do |tag| %><span class="review-tag"><%= tag %></span><% end %></div>
              <% end %>
              <% if review.comment.present? %>
              <div class="review-comment"><%= review.comment %></div>
              <% end %>
            </div>
            <% end %>
          </div>
          <% else %>
          <div class="reviews-empty">
            <div class="reviews-empty-icon"><i class="fas fa-star"></i></div>
            <div class="reviews-empty-title">Nenhuma avaliação ainda</div>
            <div class="reviews-empty-sub">Seja o primeiro a avaliar.</div>
          </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="cw-show-right" id="booking-panel-wrap">
      <div class="booking-panel" id="booking-panel">
        <div class="booking-panel-header">
          <i class="fas fa-calendar-check booking-panel-icon"></i>
          <span class="booking-panel-title">Agendar</span>
        </div>
        <div class="booking-panel-body">
          <% if is_client %>
          <div id="booking-empty" class="booking-empty">
            <div class="booking-empty-icon"><i class="fas fa-hand-pointer"></i></div>
            <div class="booking-empty-title">Selecione um serviço</div>
            <div class="booking-empty-sub">Clique em qualquer serviço ao lado para iniciar o agendamento.</div>
          </div>

          <div id="booking-selected" style="display: none;">
            <div class="booking-svc-row">
              <div>
                <div class="booking-svc-name" id="bk-svc-name">—</div>
                <div class="booking-svc-dur"  id="bk-svc-dur">—</div>
              </div>
              <div class="booking-svc-price" id="bk-svc-price">—</div>
            </div>

            <div class="booking-field">
              <label class="booking-label" for="bk-date-alt">Data</label>
              <input type="text" id="bk-date-alt" placeholder="DD/MM/AAAA" readonly />
            </div>

            <div class="booking-field">
              <label class="booking-label">Horário</label>
              <div id="time-loading" style="display: none; font-size: 12.5px; color: var(--graphite); padding: 4px 0;">
                <i class="fas fa-circle-notch fa-spin" style="color: var(--coral-500); margin-right: 5px;"></i> Carregando...
              </div>
              <div id="time-empty" style="display: none; font-size: 12.5px; color: var(--ash); padding: 4px 0;">
                Nenhum horário disponível para esta data.
              </div>
              <div class="disp-lock-banner" id="disp-lock-banner">
                <i class="fas fa-bolt"></i>
                <span>Horários em breve só pelo <a href="<%= disponivel_index_path(latitude: params[:latitude], longitude: params[:longitude]) %>">Disponível</a> — pagamento antecipado, entrada garantida.</span>
              </div>
              <div class="time-grid" id="time-grid"></div>
            </div>

            <div class="booking-summary" id="bk-summary" style="display: none;">
              <div class="booking-summary-row">
                <span class="booking-summary-label">Serviço</span>
                <span class="booking-summary-val" id="bk-sum-svc">—</span>
              </div>
              <div class="booking-summary-row">
                <span class="booking-summary-label">Data</span>
                <span class="booking-summary-val" id="bk-sum-date">—</span>
              </div>
              <div class="booking-summary-row">
                <span class="booking-summary-label">Horário</span>
                <span class="booking-summary-val" id="bk-sum-time">—</span>
              </div>
              <div style="height: 1px; background: var(--stone); margin: 4px 0;"></div>
              <div class="booking-total-row">
                <span class="booking-total-label">Total</span>
                <span class="booking-total-val" id="bk-sum-price">—</span>
              </div>
            </div>

            <%= form_with url: appointments_path, method: :post, local: true, id: "booking-form", data: { turbo: false } do |f| %>
            <input type="hidden" name="appointment[car_wash_id]" value="<%= @car_wash.id %>">
            <input type="hidden" name="appointment[service_id]"  id="bk-service-id">
            <input type="hidden" name="appointment[date]"        id="bk-date-val">
            <input type="hidden" name="appointment[time]"        id="bk-time-val">
            <button type="submit" class="btn-confirm" id="btn-confirm" disabled>
              <i class="fas fa-calendar-check"></i> Confirmar agendamento
            </button>
            <% end %>
            <p class="booking-note"><i class="fas fa-info-circle"></i> Sem cobrança antecipada. Pague no local.</p>
          </div>

          <% else %>
          <div class="booking-nudge">
            <div class="booking-empty-icon" style="margin: 0 auto 14px;"><i class="fas fa-lock"></i></div>
            <p class="booking-nudge-text">Faça <strong>login</strong> ou <strong>crie uma conta</strong> gratuita para agendar.</p>
            <%= link_to "Entrar", new_user_session_path, class: "loov-btn-primary loov-btn-block", style: "margin-bottom: 10px;" %>
            <%= link_to "Criar conta", new_user_registration_path, class: "loov-btn-secondary loov-btn-block" %>
          </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<% if is_client %>
<div class="mobile-cta">
  <div class="mobile-cta-inner">
    <div class="mobile-cta-info">
      <span class="mobile-cta-label">Agendar em</span>
      <span class="mobile-cta-name"><%= @car_wash.name %></span>
    </div>
    <button type="button" class="mobile-cta-btn" onclick="scrollToBooking()">
      <i class="fas fa-calendar-plus"></i> Agendar
    </button>
  </div>
</div>
<% end %>

<script>
  window.carWashId      = <%= @car_wash.id %>;
  window.operatingHours = <%= @car_wash.operating_hours.map { |oh| { day_of_week: oh.day_of_week, opens_at: oh.opens_at.hour * 60 + oh.opens_at.min, closes_at: oh.closes_at.hour * 60 + oh.closes_at.min } }.to_json.html_safe %>;
  window.capacityPerSlot = <%= @car_wash.capacity_per_slot %>;
  window.operatingDays  = <%= @car_wash.operating_hours.pluck(:day_of_week).to_json.html_safe %>;
  window.closureDates   = <%= @closures.flat_map { |c| (c.start_date..c.end_date).map { |d| d.strftime("%Y-%m-%d") } }.to_json.html_safe %>;
</script>

<script>
(function() {
  document.querySelectorAll('.cat-tab').forEach(tab=>{
    tab.addEventListener('click',()=>{
      document.querySelectorAll('.cat-tab').forEach(t=>t.classList.remove('active'));
      tab.classList.add('active');
      const cat=tab.dataset.cat;
      document.querySelectorAll('.svc-card').forEach(card=>{
        card.style.display=(cat==='all'||card.dataset.cat===cat)?'flex':'none';
      });
    });
  });

  let selectedService=null, selectedDate=null, selectedTime=null, fpInstance=null, submitLocked=false;
  const openDays=window.operatingDays||[], closureDates=window.closureDates||[];

  function dateToStr(d){var y=d.getFullYear(),m=String(d.getMonth()+1).padStart(2,'0'),day=String(d.getDate()).padStart(2,'0');return y+'-'+m+'-'+day;}

  function updateConfirmBtn(){const btn=document.getElementById('btn-confirm');if(btn)btn.disabled=!(selectedService&&selectedDate&&selectedTime);}

  function updateSummary(){
    if(!selectedService||!selectedDate||!selectedTime){document.getElementById('bk-summary').style.display='none';return;}
    const[y,m,d]=selectedDate.split('-');
    document.getElementById('bk-sum-svc').textContent=selectedService.title;
    document.getElementById('bk-sum-date').textContent=`${d}/${m}/${y}`;
    document.getElementById('bk-sum-time').textContent=selectedTime;
    document.getElementById('bk-sum-price').textContent='R$ '+selectedService.price.toFixed(0);
    document.getElementById('bk-summary').style.display='flex';
  }

  const bookingForm=document.getElementById('booking-form');
  if(bookingForm){bookingForm.addEventListener('submit',function(e){if(submitLocked){e.preventDefault();return false;}submitLocked=true;const btn=document.getElementById('btn-confirm');if(btn){btn.disabled=true;btn.innerHTML='<i class="fas fa-circle-notch fa-spin"></i> Confirmando...';}});}

  window.selectService=function(card){
    document.querySelectorAll('.svc-card').forEach(c=>{c.classList.remove('selected');const ico=c.querySelector('.svc-card-select i');if(ico)ico.className='fas fa-plus';});
    card.classList.add('selected');
    const ico=card.querySelector('.svc-card-select i');
    if(ico)ico.className='fas fa-check';
    selectedService={id:card.dataset.id,title:card.dataset.title,price:parseFloat(card.dataset.price),duration:parseInt(card.dataset.duration)};
    selectedTime=null; submitLocked=false;
    document.getElementById('booking-empty').style.display='none';
    document.getElementById('booking-selected').style.display='block';
    document.getElementById('bk-svc-name').textContent=selectedService.title;
    document.getElementById('bk-svc-dur').textContent=selectedService.duration+' min';
    document.getElementById('bk-svc-price').textContent='R$ '+selectedService.price.toFixed(0);
    document.getElementById('bk-service-id').value=selectedService.id;
    document.getElementById('time-grid').innerHTML='';
    document.getElementById('time-loading').style.display='none';
    document.getElementById('time-empty').style.display='none';
    document.getElementById('bk-summary').style.display='none';
    document.getElementById('bk-time-val').value='';
    document.getElementById('disp-lock-banner').style.display='none';
    const pill=document.getElementById('cart-pill');
    if(pill){document.getElementById('cart-pill-label').textContent=selectedService.title+' · R$ '+selectedService.price.toFixed(0);pill.classList.add('visible');}
    if(!fpInstance){
      fpInstance=flatpickr('#bk-date-alt',{
        locale:{weekdays:{shorthand:['Dom','Seg','Ter','Qua','Qui','Sex','Sáb'],longhand:['Domingo','Segunda','Terça','Quarta','Quinta','Sexta','Sábado']},months:{shorthand:['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'],longhand:['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro']},firstDayOfWeek:0,ordinal:()=>''},
        minDate:'today',dateFormat:'Y-m-d',altInput:true,altFormat:'d/m/Y',disableMobile:true,
        disable:[function(date){var dow=date.getDay();if(openDays.indexOf(dow)===-1)return true;var ds=dateToStr(date);if(closureDates.indexOf(ds)!==-1)return true;return false;}],
        onDayCreate:function(dObj,dStr,fp,dayElem){var date=dayElem.dateObj;if(!date)return;var dow=date.getDay(),ds=dateToStr(date);if(closureDates.indexOf(ds)!==-1){dayElem.classList.add('day-closed');}else if(openDays.indexOf(dow)===-1){dayElem.classList.add('day-no-hours');}},
        onChange:function(selectedDates,dateStr){selectedDate=dateStr;selectedTime=null;submitLocked=false;document.getElementById('bk-date-val').value=dateStr;document.getElementById('bk-time-val').value='';document.getElementById('bk-summary').style.display='none';document.getElementById('disp-lock-banner').style.display='none';fetchTimes(dateStr);updateConfirmBtn();}
      });
      const altEl=document.querySelector('#bk-date-alt+input.flatpickr-input');
      if(altEl){altEl.style.cssText='width:100%;background:#fefefd;border:1px solid #e0dbd0;border-radius:12px;padding:12px 16px;font-family:\'Inter\',sans-serif;font-size:14px;color:#28231c;outline:none;cursor:pointer;transition:border-color .15s;';altEl.addEventListener('focus',()=>altEl.style.borderColor='#dd7852');altEl.addEventListener('blur',()=>altEl.style.borderColor='#e0dbd0');}
    } else if(selectedDate){fetchTimes(selectedDate);}
    updateConfirmBtn();
    scrollToBooking();
  };

  function fetchTimes(dateStr){
    if(!selectedService||!dateStr)return;
    const grid=document.getElementById('time-grid');
    const loading=document.getElementById('time-loading');
    const empty=document.getElementById('time-empty');
    const banner=document.getElementById('disp-lock-banner');
    grid.innerHTML=''; loading.style.display='block';
    empty.style.display='none'; banner.style.display='none';

    const url=`/car_washes/${window.carWashId}/available_times?date=${dateStr}&service_id=${selectedService.id}&duration=${selectedService.duration}`;
    fetch(url)
    .then(r=>r.json())
    .then(slots=>{
      loading.style.display='none';
      if(!slots.length){empty.style.display='block';return;}

      let hasLocked=false;
      slots.forEach(slot=>{
        const btn=document.createElement('button');
        btn.type='button';
        const time   = typeof slot==='string' ? slot : slot.time;
        const locked = typeof slot==='object' && slot.disponivel_only;

        if(locked){
          hasLocked=true;
          btn.className='time-slot disponivel-only';
          btn.disabled=true;
          btn.innerHTML=`${time}<span class="disp-tag-mini"><i class="fas fa-bolt" style="font-size:.5rem;"></i>Disp.</span>`;
          btn.title='Reserve pelo Disponível — pagamento antecipado';
        } else {
          btn.className='time-slot';
          btn.textContent=time;
          btn.onclick=()=>selectTime(time,btn);
        }
        grid.appendChild(btn);
      });

      if(hasLocked) banner.style.display='flex';
    })
    .catch(()=>{loading.style.display='none';empty.style.display='block';});
  }

  function selectTime(time,btn){
    document.querySelectorAll('.time-slot').forEach(b=>b.classList.remove('selected'));
    btn.classList.add('selected');
    selectedTime=time; submitLocked=false;
    document.getElementById('bk-time-val').value=time;
    updateSummary();
    updateConfirmBtn();
  }

  window.scrollToBooking=function(){const panel=document.getElementById('booking-panel');if(panel)panel.scrollIntoView({behavior:'smooth',block:'start'});};
})();
</script>
<% Rails.logger.info("Template car_washes/show.html.erb renderizado com sucesso") %>
