  .booking-nudge { text-align: center; padding: 22px 12px; }

  /* Flatpickr theming Loov */
  .flatpickr-calendar { background: var(--paper) !important; border: 1px solid var(--stone) !important; border-radius: 16px !important; box-shadow: 0 16px 40px rgba(40,35,28,0.12) !important; font-family: 'Inter', sans-serif !important; }
  .flatpickr-day { color: var(--graphite) !important; border-radius: 10px !important; }
  .flatpickr-day.selected, .flatpickr-day.selected:hover { background: var(--coral-500) !important; border-color: var(--coral-500) !important; color: var(--cream) !important; }
  .flatpickr-day:hover:not(.flatpickr-disabled):not(.day-closed):not(.day-no-hours) { background: var(--coral-50) !important; color: var(--coral-700) !important; }
  .flatpickr-day.flatpickr-disabled { color: var(--stone) !important; pointer-events: none !important; }
  .flatpickr-day.prevMonthDay, .flatpickr-day.nextMonthDay { color: var(--ash) !important; pointer-events: none !important; }
  .flatpickr-months { background: var(--paper) !important; border-radius: 16px 16px 0 0 !important; }
  .flatpickr-current-month, .flatpickr-monthDropdown-months { color: var(--ink) !important; }
  .flatpickr-weekday { color: var(--ash) !important; }
  .flatpickr-prev-month svg, .flatpickr-next-month svg { fill: var(--graphite) !important; }
  .flatpickr-prev-month:hover svg, .flatpickr-next-month:hover svg { fill: var(--coral-500) !important; }
  .flatpickr-input { caret-color: transparent; }
  .flatpickr-day.day-no-hours { color: var(--stone) !important; pointer-events: none !important; cursor: not-allowed !important; }
  .flatpickr-day.day-closed { color: rgba(200,80,80,0.5) !important; background: rgba(200,80,80,0.06) !important; border-color: rgba(200,80,80,0.18) !important; text-decoration: line-through !important; pointer-events: none !important; cursor: not-allowed !important; }

  @media (max-width: 600px) {
    .cw-hero { height: 240px; }
    .cw-stats-card { padding: 18px 18px; }
    .cw-stats-shop { font-size: 19px; }
    .cw-stat-value { font-size: 13.5px; }
    .cw-stat-label { font-size: 9px; }
    .cw-tab-btn { font-size: 12.5px; }
  }
</style>

<div class="cw-page">

  <%# ── HERO ──────────────────────────────────────────── %>
  <div class="cw-hero">
    <div class="cw-hero-placeholder"><i class="fas fa-image"></i></div>
    <div class="cw-hero-overlay">
      <a href="<%= car_washes_path %>" class="glass-btn" aria-label="Voltar">
        <i class="fas fa-arrow-left"></i>
      </a>
      <% if is_client %>
        <% favorited = current_user.favorite_car_washes.exists?(car_wash_id: @car_wash.id) %>
        <button type="button" class="glass-btn <%= 'fav-active' if favorited %>" id="fav-btn"
                onclick="toggleFavorite(this)"
                data-cw-id="<%= @car_wash.id %>"
                data-favorited="<%= favorited %>"
                aria-label="Favoritar">
          <i class="<%= favorited ? 'fas' : 'far' %> fa-heart"></i>
        </button>
      <% else %>
        <% if is_owner_manage %>
          <a href="<%= manage_car_wash_path(@car_wash) %>" class="glass-btn" aria-label="Gerenciar">
            <i class="fas fa-gear"></i>
          </a>
        <% end %>
      <% end %>
    </div>
  </div>

  <%# ── STATS CARD overlapping hero ─────────────────── %>
  <div class="cw-stats-wrap">
    <div class="cw-stats-card">
      <div class="cw-stats-top">
        <div style="flex:1; min-width:0;">
          <h1 class="cw-stats-shop"><%= @car_wash.name %></h1>
          <div class="cw-stats-hood">
            <%= [@car_wash.try(:bairro), @car_wash.try(:cidade)].compact_blank.join(' · ').presence || @car_wash.address.to_s %>
          </div>
        </div>
        <% if is_open_now %>
          <span class="cw-status-badge is-open"><i class="fas fa-check"></i>Aberto</span>
        <% else %>
          <span class="cw-status-badge is-closed"><i class="fas fa-moon"></i>Fechado</span>
        <% end %>
      </div>

      <div class="cw-stats-row">
        <div class="cw-stat-col">
          <div class="cw-stat-top">
            <i class="fas fa-star" style="color: var(--coral-500);"></i>
            <span class="cw-stat-value"><%= avg_rating ? sprintf('%.1f', avg_rating) : '—' %></span>
          </div>
          <div class="cw-stat-label">
            <%= review_count > 0 ? "#{review_count} #{review_count == 1 ? 'AVALIAÇÃO' : 'AVALIAÇÕES'}" : "SEM AVALIAÇÕES" %>
          </div>
        </div>
        <div class="cw-stat-sep"></div>
        <div class="cw-stat-col">
          <div class="cw-stat-top">
            <i class="fas fa-clock" style="color: var(--graphite);"></i>
            <span class="cw-stat-value"><%= today_hours_short(opens_today) %></span>
          </div>
          <div class="cw-stat-label">HOJE</div>
        </div>
        <div class="cw-stat-sep"></div>
        <div class="cw-stat-col">
          <div class="cw-stat-top">
            <i class="fas fa-droplet" style="color: #4b8ec0;"></i>
            <span class="cw-stat-value">R$<%= min_price ? number_with_precision(min_price, precision: 0) : '—' %></span>
          </div>
          <div class="cw-stat-label">A PARTIR</div>
        </div>
      </div>
    </div>
  </div>

  <%# ── TABS ────────────────────────────────────────── %>
  <div class="cw-tabs-wrap">
    <div class="cw-tabs-bar">
      <button class="cw-tab-btn active" data-tab="servicos">Serviços</button>
      <button class="cw-tab-btn" data-tab="reviews">Reviews</button>
      <button class="cw-tab-btn" data-tab="sobre">Sobre</button>
    </div>
  </div>

  <%# ── CONTENT ─────────────────────────────────────── %>
  <div class="cw-content">

    <%# Tab Serviços %>
    <div class="cw-tab-content" id="tab-servicos">
      <% if @car_wash.services.any? %>
        <div class="svc-list" id="services-grid">
          <% @car_wash.services.each_with_index do |service, i| %>
            <% meta = cat_meta(service.category, i) %>
            <div class="svc-card"
                 data-cat="<%= service.category %>"
                 data-id="<%= service.id %>"
                 data-title="<%= j service.title %>"
                 data-price="<%= service.price.to_f %>"
                 data-duration="<%= service.duration %>"
                 onclick="selectService(this)">
              <div class="svc-icon-box" style="background:<%= meta[:bg] %>; color:<%= meta[:fg] %>;">
                <i class="fas <%= meta[:icon] %>"></i>
              </div>
              <div class="svc-info">
                <div class="svc-name"><%= service.title %></div>
                <% if service.description.present? %>
                  <div class="svc-desc"><%= service.description %></div>
                <% end %>
                <div class="svc-duration"><%= service.duration || 30 %> min</div>
              </div>
              <div class="svc-price">R$<%= number_with_precision(service.price, precision: 0) %></div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="svc-empty">Este lava-rápido ainda não cadastrou serviços.</div>
      <% end %>
    </div>

    <%# Tab Reviews %>
    <div class="cw-tab-content" id="tab-reviews" style="display:none;">
      <% if reviews.any? %>
        <% reviews.each do |review| %>
          <div class="review-card">
            <div class="review-header">
              <div class="review-avatar"><%= (review.user&.display_name || 'C').strip[0]&.upcase || 'C' %></div>
              <div style="flex:1; min-width:0;">
                <div class="review-author"><%= review.user&.display_name || 'Cliente' %></div>
                <div class="review-date"><%= review.created_at.strftime("%d/%m/%y") %></div>
              </div>
              <div class="review-stars">
                <% 5.times do |n| %>
                  <i class="fas fa-star" style="color:<%= n < review.rating ? 'var(--coral-500)' : 'var(--stone)' %>;"></i>
                <% end %>
              </div>
            </div>
            <% if review.comment.present? %>
              <div class="review-comment"><%= review.comment %></div>
            <% end %>
            <% if review.tags_list.any? %>
              <div class="review-tags">
                <% review.tags_list.each do |tag| %>
                  <span class="review-tag"><%= tag %></span>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <div class="reviews-empty">
          <i class="fas fa-message"></i>
          <div>Sem avaliações ainda</div>
        </div>
      <% end %>
    </div>

    <%# Tab Sobre %>
    <div class="cw-tab-content" id="tab-sobre" style="display:none;">
      <div class="info-card">
        <div class="info-label">Horário</div>
        <% if @car_wash.operating_hours.any? %>
          <% @car_wash.operating_hours.order(Arel.sql("CASE day_of_week WHEN 0 THEN 7 ELSE day_of_week END")).each do |hour| %>
            <% day_name = %w[Domingo Segunda Terça Quarta Quinta Sexta Sábado][hour.day_of_week] %>
            <% is_today_h = hour.day_of_week == today_dow %>
            <div class="hours-row <%= 'today' if is_today_h %>">
              <span class="day"><%= day_name %></span>
              <span class="time"><%= hour.opens_at.strftime("%H:%M") %> — <%= hour.closes_at.strftime("%H:%M") %></span>
            </div>
          <% end %>
        <% else %>
          <div class="info-body">Não informado</div>
        <% end %>
      </div>
      <div class="info-card">
        <div class="info-label">Endereço</div>
        <div class="info-body"><%= @car_wash.try(:logradouro) || @car_wash.address || '—' %></div>
        <div class="info-body" style="color: var(--graphite); font-size: 13px;">
          <%= [@car_wash.try(:bairro), @car_wash.try(:cidade), @car_wash.try(:uf)].compact_blank.join(' · ').presence || '' %>
        </div>
      </div>
    </div>

  </div>

  <%# ── BOOKING PANEL (preserva todos os IDs/JS) ─────── %>
  <% if @car_wash.services.any? %>
  <div class="booking-section" id="booking-section">
    <div class="booking-panel" id="booking-panel">
      <div class="booking-header">
        <i class="fas fa-calendar-check"></i>
        <span class="booking-title">Agendar</span>
      </div>
      <div class="booking-body">
        <% if is_client %>
          <div id="booking-empty" class="booking-empty">
            <div class="booking-empty-icon"><i class="fas fa-hand-pointer"></i></div>
            <div class="booking-empty-title">Selecione um serviço</div>
            <div class="booking-empty-sub">Toque em qualquer serviço acima para iniciar o agendamento.</div>
          </div>

          <div id="booking-selected" style="display: none;">
            <div class="booking-svc-row">
              <div>
                <div class="booking-svc-name" id="bk-svc-name">—</div>
                <div class="booking-svc-dur"  id="bk-svc-dur">—</div>
              </div>
              <div class="booking-svc-price" id="bk-svc-price">—</div>
            </div>

            <div class="booking-field">
              <label class="booking-label" for="bk-date-alt">Data</label>
              <input type="text" id="bk-date-alt" placeholder="DD/MM/AAAA" readonly>
            </div>

            <div class="booking-field">
              <label class="booking-label">Horário</label>
              <div id="time-loading" style="display: none; font-size: 12.5px; color: var(--graphite); padding: 4px 0;">
                <i class="fas fa-circle-notch fa-spin" style="color: var(--coral-500); margin-right: 5px;"></i> Carregando...
              </div>
              <div id="time-empty" style="display: none; font-size: 12.5px; color: var(--ash); padding: 4px 0;">
                Nenhum horário disponível para esta data.
              </div>
              <div class="disp-lock-banner" id="disp-lock-banner">
                <i class="fas fa-bolt"></i>
                <span>Horários em breve só pelo <a href="<%= disponivel_index_path(latitude: params[:latitude], longitude: params[:longitude]) %>">Disponível</a> — pagamento antecipado, entrada garantida.</span>
              </div>
              <div class="time-grid" id="time-grid"></div>
            </div>

            <div class="booking-summary" id="bk-summary" style="display: none;">
              <div class="summary-row">
                <span class="summary-label">Serviço</span>
                <span class="summary-val" id="bk-sum-svc">—</span>
              </div>
              <div class="summary-row">
                <span class="summary-label">Data</span>
                <span class="summary-val" id="bk-sum-date">—</span>
              </div>
              <div class="summary-row">
                <span class="summary-label">Horário</span>
                <span class="summary-val" id="bk-sum-time">—</span>
              </div>
              <div style="height:1px; background:var(--stone); margin:4px 0;"></div>
              <div class="summary-total-row">
                <span class="summary-total-label">Total</span>
                <span class="summary-total-val" id="bk-sum-price">—</span>
              </div>
            </div>

            <%= form_with url: appointments_path, method: :post, local: true, id: "booking-form", data: { turbo: false } do |f| %>
              <input type="hidden" name="appointment[car_wash_id]" value="<%= @car_wash.id %>">
              <input type="hidden" name="appointment[service_id]"  id="bk-service-id">
              <input type="hidden" name="appointment[date]"        id="bk-date-val">
              <input type="hidden" name="appointment[time]"        id="bk-time-val">
              <button type="submit" class="btn-confirm" id="btn-confirm" disabled>
                <i class="fas fa-calendar-check"></i> Confirmar agendamento
              </button>
            <% end %>
            <p class="booking-note"><i class="fas fa-info-circle"></i> Sem cobrança antecipada. Pague no local.</p>
          </div>
        <% else %>
          <div class="booking-nudge">
            <div class="booking-empty-icon"><i class="fas fa-lock"></i></div>
            <p style="font-size: 14px; color: var(--graphite); line-height: 1.55; margin-bottom: 16px;">
              Faça <strong style="color: var(--ink);">login</strong> ou <strong style="color: var(--ink);">crie uma conta</strong> gratuita para agendar.
            </p>
            <%= link_to "Entrar", new_user_session_path, class: "loov-btn-primary loov-btn-block", style: "margin-bottom: 10px;" %>
            <%= link_to "Criar conta", new_user_registration_path, class: "loov-btn-secondary loov-btn-block" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  <% end %>

</div>

<script>
  window.carWashId       = <%= @car_wash.id %>;
  window.operatingHours  = <%= @car_wash.operating_hours.map { |oh| { day_of_week: oh.day_of_week, opens_at: oh.opens_at.hour * 60 + oh.opens_at.min, closes_at: oh.closes_at.hour * 60 + oh.closes_at.min, capacity: oh.effective_capacity } }.to_json.html_safe %>;
  window.capacityPerSlot = <%= @car_wash.capacity_per_slot %>;
  window.operatingDays   = <%= @car_wash.operating_hours.pluck(:day_of_week).to_json.html_safe %>;
  window.closureDates    = <%= @closures.flat_map { |c| (c.start_date..c.end_date).map { |d| d.strftime("%Y-%m-%d") } }.to_json.html_safe %>;
</script>

<script>
(function() {
  // ── Tabs ────────────────────────────────────────────
  document.querySelectorAll('.cw-tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const t = btn.dataset.tab;
      document.querySelectorAll('.cw-tab-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      document.querySelectorAll('.cw-tab-content').forEach(c => c.style.display = 'none');
      document.getElementById('tab-' + t).style.display = '';
    });
  });

  // ── Favoritar ────────────────────────────────────────
  window.toggleFavorite = function(btn) {
    if (btn.dataset.busy === '1') return;
    btn.dataset.busy = '1';
    const cwId = btn.dataset.cwId;
    const wasFav = btn.dataset.favorited === 'true';
    const csrf = document.querySelector('meta[name="csrf-token"]')?.content;
    const url    = wasFav ? `/client/favorites/${cwId}` : '/client/favorites';
    const method = wasFav ? 'DELETE' : 'POST';
    const body   = wasFav ? null : JSON.stringify({ car_wash_id: cwId });

    // Optimistic
    btn.classList.toggle('fav-active', !wasFav);
    btn.dataset.favorited = (!wasFav).toString();
    const icon = btn.querySelector('i');
    if (icon) icon.className = (wasFav ? 'far' : 'fas') + ' fa-heart';

    fetch(url, {
      method,
      headers: { 'X-CSRF-Token': csrf, 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body
    }).catch(() => {
      // revert
      btn.classList.toggle('fav-active', wasFav);
      btn.dataset.favorited = wasFav.toString();
      if (icon) icon.className = (wasFav ? 'fas' : 'far') + ' fa-heart';
    }).finally(() => { btn.dataset.busy = '0'; });
  };

  // ── Booking flow (preservado do original) ────────────
  let selectedService = null, selectedDate = null, selectedTime = null;
  let fpInstance = null, submitLocked = false;
  const openDays     = window.operatingDays || [];
  const closureDates = window.closureDates  || [];

  function dateToStr(d){var y=d.getFullYear(),m=String(d.getMonth()+1).padStart(2,'0'),day=String(d.getDate()).padStart(2,'0');return y+'-'+m+'-'+day;}

  function updateConfirmBtn(){
    const btn = document.getElementById('btn-confirm');
    if (btn) btn.disabled = !(selectedService && selectedDate && selectedTime);
  }

  function updateSummary(){
    if (!selectedService || !selectedDate || !selectedTime) {
      const s = document.getElementById('bk-summary'); if (s) s.style.display = 'none'; return;
    }
    const [y,m,d] = selectedDate.split('-');
    document.getElementById('bk-sum-svc').textContent  = selectedService.title;
    document.getElementById('bk-sum-date').textContent = `${d}/${m}/${y}`;
    document.getElementById('bk-sum-time').textContent = selectedTime;
    document.getElementById('bk-sum-price').textContent = 'R$ ' + selectedService.price.toFixed(0);
    document.getElementById('bk-summary').style.display = 'flex';
  }

  const bookingForm = document.getElementById('booking-form');
  if (bookingForm) {
    bookingForm.addEventListener('submit', e => {
      if (submitLocked) { e.preventDefault(); return false; }
      submitLocked = true;
      const btn = document.getElementById('btn-confirm');
      if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> Confirmando...'; }
    });
  }

  window.selectService = function(card) {
    document.querySelectorAll('.svc-card').forEach(c => c.classList.remove('selected'));
    card.classList.add('selected');
    selectedService = {
      id: card.dataset.id,
      title: card.dataset.title,
      price: parseFloat(card.dataset.price),
      duration: parseInt(card.dataset.duration)
    };
    selectedTime = null; submitLocked = false;

    const empty = document.getElementById('booking-empty');
    const sel   = document.getElementById('booking-selected');
    if (empty) empty.style.display = 'none';
    if (sel)   sel.style.display = 'block';

    const nameEl  = document.getElementById('bk-svc-name');
    const durEl   = document.getElementById('bk-svc-dur');
    const priceEl = document.getElementById('bk-svc-price');
    const idEl    = document.getElementById('bk-service-id');
    if (nameEl)  nameEl.textContent  = selectedService.title;
    if (durEl)   durEl.textContent   = selectedService.duration + ' min';
    if (priceEl) priceEl.textContent = 'R$ ' + selectedService.price.toFixed(0);
    if (idEl)    idEl.value          = selectedService.id;

    const grid = document.getElementById('time-grid');
    if (grid) grid.innerHTML = '';
    const tl = document.getElementById('time-loading'); if (tl) tl.style.display = 'none';
    const te = document.getElementById('time-empty');   if (te) te.style.display = 'none';
    const su = document.getElementById('bk-summary');   if (su) su.style.display = 'none';
    const tv = document.getElementById('bk-time-val');  if (tv) tv.value = '';
    const lb = document.getElementById('disp-lock-banner'); if (lb) lb.style.display = 'none';

    if (!fpInstance && typeof flatpickr === 'function') {
      fpInstance = flatpickr('#bk-date-alt', {
        locale: { weekdays: { shorthand: ['Dom','Seg','Ter','Qua','Qui','Sex','Sáb'], longhand: ['Domingo','Segunda','Terça','Quarta','Quinta','Sexta','Sábado'] }, months: { shorthand: ['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'], longhand: ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'] }, firstDayOfWeek: 0, ordinal: () => '' },
        minDate: 'today', dateFormat: 'Y-m-d', altInput: true, altFormat: 'd/m/Y', disableMobile: true,
        disable: [function(date) {
          var dow = date.getDay();
          if (openDays.indexOf(dow) === -1) return true;
          var ds = dateToStr(date);
          if (closureDates.indexOf(ds) !== -1) return true;
          return false;
        }],
        onDayCreate: function(dObj, dStr, fp, dayElem) {
          var date = dayElem.dateObj; if (!date) return;
          var dow = date.getDay(), ds = dateToStr(date);
          if (closureDates.indexOf(ds) !== -1) dayElem.classList.add('day-closed');
          else if (openDays.indexOf(dow) === -1) dayElem.classList.add('day-no-hours');
        },
        onChange: function(selDates, dateStr) {
          selectedDate = dateStr; selectedTime = null; submitLocked = false;
          document.getElementById('bk-date-val').value = dateStr;
          document.getElementById('bk-time-val').value = '';
          document.getElementById('bk-summary').style.display = 'none';
          document.getElementById('disp-lock-banner').style.display = 'none';
          fetchTimes(dateStr);
          updateConfirmBtn();
        }
      });
      const altEl = document.querySelector('#bk-date-alt+input.flatpickr-input');
      if (altEl) {
        altEl.style.cssText = 'width:100%;background:#fafaf6;border:1px solid #e0dbd0;border-radius:12px;padding:12px 16px;font-family:Inter,sans-serif;font-size:14px;color:#28231c;outline:none;cursor:pointer;transition:border-color .15s;';
        altEl.addEventListener('focus', () => altEl.style.borderColor = '#dd7852');
        altEl.addEventListener('blur',  () => altEl.style.borderColor = '#e0dbd0');
      }
    } else if (selectedDate) {
      fetchTimes(selectedDate);
    }
    updateConfirmBtn();
    scrollToBooking();
  };

  function fetchTimes(dateStr) {
    if (!selectedService || !dateStr) return;
    const grid    = document.getElementById('time-grid');
    const loading = document.getElementById('time-loading');
    const empty   = document.getElementById('time-empty');
    const banner  = document.getElementById('disp-lock-banner');
    grid.innerHTML = ''; loading.style.display = 'block';
    empty.style.display = 'none'; banner.style.display = 'none';

    const url = `/car_washes/${window.carWashId}/available_times?date=${dateStr}&service_id=${selectedService.id}&duration=${selectedService.duration}`;
    fetch(url).then(r => r.json()).then(slots => {
      loading.style.display = 'none';
      if (!slots.length) { empty.style.display = 'block'; return; }
      let hasLocked = false;
      slots.forEach(slot => {
        const btn = document.createElement('button');
        btn.type = 'button';
        const time   = typeof slot === 'string' ? slot : slot.time;
        const locked = typeof slot === 'object' && slot.disponivel_only;
        if (locked) {
          hasLocked = true;
          btn.className = 'time-slot disponivel-only';
          btn.disabled = true;
          btn.innerHTML = `${time}<span class="disp-tag-mini"><i class="fas fa-bolt" style="font-size:.5rem;"></i>Disp.</span>`;
          btn.title = 'Reserve pelo Disponível — pagamento antecipado';
        } else {
          btn.className = 'time-slot';
          btn.textContent = time;
          btn.onclick = () => selectTime(time, btn);
        }
        grid.appendChild(btn);
      });
      if (hasLocked) banner.style.display = 'flex';
    }).catch(() => { loading.style.display = 'none'; empty.style.display = 'block'; });
  }

  function selectTime(time, btn) {
    document.querySelectorAll('.time-slot').forEach(b => b.classList.remove('selected'));
    btn.classList.add('selected');
    selectedTime = time; submitLocked = false;
    document.getElementById('bk-time-val').value = time;
    updateSummary();
    updateConfirmBtn();
  }

  window.scrollToBooking = function() {
    const panel = document.getElementById('booking-panel');
    if (panel) panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
  };
})();
</script>
