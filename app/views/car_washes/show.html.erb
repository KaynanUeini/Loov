<%#
  Lava-rápido — porte das telas do app (LoovApp/src/screens):
    CarWashDetailScreen  → capa escura, cartão de números sobreposto, abas
                           Serviços / Reviews / Sobre
    BookingScreen        → 1. dia e horário  2. resumo e pagamento
                           3. "Agendado. Seu carro te agradece."
  Os dados são o MESMO JSON do app (CarWashesController#detail_payload),
  embutido na página; horários vêm de /car_washes/:id/available_times e a
  reserva vai pra POST /car_washes/:id/appointments, como no app.

  Telas grandes usam a largura em vez de esticar o celular: no detalhe,
  "Sobre" sai da aba e fica fixo ao lado (horários e endereço sempre à vista);
  no agendamento, o resumo com o total e o botão viram uma coluna fixa à
  direita, como o checkout da Apple. No celular é igual ao app: abas e
  barra flutuante com total + botão.

  O agendamento é uma "tela" dentro da página (#agendar): o voltar do
  navegador volta um passo, como o voltar do app.
%>
<%
  is_client       = user_signed_in? && current_user.client?
  is_owner_manage = user_signed_in? && current_user.owner? && @car_wash.user_id == current_user.id
  closure_dates   = @closures.flat_map { |c| (c.start_date..c.end_date).map { |d| d.strftime("%Y-%m-%d") } }.uniq
  coords_qs       = params[:latitude].present? && params[:longitude].present? ? "?latitude=#{CGI.escape(params[:latitude].to_s)}&longitude=#{CGI.escape(params[:longitude].to_s)}" : ""
%>
<script src="/vendor/feather-4.29.2.min.js"></script>
<%= render "shared/loov_logos" %>
<link rel="stylesheet" href="/vendor/leaflet-1.9.4/leaflet.css">
<script src="/vendor/leaflet-1.9.4/leaflet.js"></script>

<style>
  .loov-nav { background: var(--cream) !important; }
  html, body { overflow-x: clip !important; }
  .cw { background: var(--cream); color: var(--ink); min-height: 100vh; padding-top: 60px; }
  .cw *, .cw *::before, .cw *::after { box-sizing: border-box; }
  .cw button { font-family: inherit; line-height: normal; cursor: pointer; }
  .cw svg.feather { display: block; }
  .cw a { text-decoration: none; }
  .cw-wrap { width: 100%; max-width: 1200px; margin: 0 auto; }
  .cw-view { display: none; }
  .cw-view.is-on { display: block; }
  .cw-disp { font-family: 'Space Grotesk', sans-serif !important; }
  .cw-mono { font-family: 'JetBrains Mono', monospace; }

  /* ── Capa ─────────────────────────────────────────────────────────────
     Sem foto ainda: fundo ink com a inicial gigante translúcida (o "cover
     desenhado" do app). Botões de vidro por cima, como no app. */
  .cw-hero { position: relative; height: 260px; background: var(--ink); overflow: hidden; }
  .cw-hero-bar { position: relative; display: flex; justify-content: space-between; padding: 16px; }
  .cw-glass { width: 42px; height: 42px; border-radius: 50%; border: 0; background: rgba(255,255,255,.92); color: var(--ink) !important; display: inline-flex; align-items: center; justify-content: center; box-shadow: 0 4px 14px rgba(0,0,0,.18); transition: transform .15s, background .15s; }
  .cw-glass:hover { transform: scale(1.06); }
  .cw-glass.is-fav { background: var(--coral-500); color: var(--cream) !important; }
  .cw-glass.is-fav svg { fill: currentColor; }

  /* ── Cartão de números ─────────────────────────────────────────────── */
  .cw-stats-wrap { padding: 0 16px; margin-top: -32px; position: relative; }
  .cw-stats { background: var(--paper); border: 1px solid var(--stone); border-radius: 20px; padding: 20px; box-shadow: 0 2px 4px rgba(40,35,28,.04), 0 14px 32px -20px rgba(40,35,28,.35); }
  .cw-stats-top { display: flex; align-items: flex-start; gap: 14px; }
  .cw-logo { flex: 0 0 52px; height: 52px; }
  .cw-logo svg { width: 100%; height: 100%; display: block; }
  .cw-title { margin: 0 !important; font-family: 'Space Grotesk', sans-serif !important; font-weight: 700; font-size: 22px; line-height: 1.15; letter-spacing: -0.5px; color: var(--ink) !important; }
  .cw-hood { margin-top: 4px; font-size: 13px; color: var(--graphite); }
  .cw-badge { flex-shrink: 0; display: inline-flex; align-items: center; gap: 4px; padding: 5px 10px; border-radius: 100px; font-size: 11px; font-weight: 600; }
  .cw-badge.is-open { background: #d1ebd6; color: #2d6b42; }
  .cw-badge.is-closed { background: var(--sand); border: 1px solid var(--stone); color: var(--graphite); }
  .cw-statrow { display: flex; gap: 16px; margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--stone); }
  .cw-stat { flex: 1; text-align: center; min-width: 0; }
  .cw-stat-top { display: flex; align-items: center; justify-content: center; gap: 4px; }
  .cw-stat-val { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 15px; letter-spacing: -0.2px; white-space: nowrap; }
  .cw-stat-lab { margin-top: 2px; font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: .5px; color: var(--ash); text-transform: uppercase; }
  .cw-stat-sep { width: 1px; background: var(--stone); }

  /* ── Abas (controle segmentado, fixa ao rolar) ─────────────────────── */
  .cw-tabs { position: sticky; top: 60px; z-index: 5; background: var(--cream); padding: 14px 16px; border-bottom: 1px solid var(--stone); }
  .cw-seg { display: flex; gap: 4px; padding: 4px; background: var(--sand); border-radius: 100px; }
  .cw-seg button { flex: 1; height: 38px; border: 0; border-radius: 100px; background: transparent; color: var(--graphite); font-size: 13px; font-weight: 600; transition: background .15s, color .15s; }
  .cw-seg button[aria-selected="true"] { background: var(--paper); color: var(--ink); box-shadow: 0 1px 3px rgba(40,35,28,.12); }
  .cw-pane { display: none; padding: 6px 16px 0; }
  .cw-pane.is-on { display: block; }

  /* Serviços */
  .cw-hint { margin: 4px 2px 10px; font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: .3px; color: var(--ash); }
  .cw-svcs { display: grid; gap: 10px; }
  .cw-svc { display: flex; align-items: center; gap: 14px; width: 100%; padding: 16px; text-align: left; background: var(--paper); border: 1px solid var(--stone); border-radius: 16px; color: var(--ink); transition: border-color .15s, transform .15s, box-shadow .2s; }
  .cw-svc:hover { border-color: var(--ink); box-shadow: 0 10px 24px -18px rgba(40,35,28,.5); }
  .cw-svc:active { transform: scale(.99); }
  .cw-svc.is-static { cursor: default; }
  .cw-svc.is-static:hover { border-color: var(--stone); box-shadow: none; }
  .cw-svc-ic { flex: 0 0 48px; height: 48px; border-radius: 14px; background: var(--sand); border: 1px solid var(--stone); display: flex; align-items: center; justify-content: center; }
  .cw-svc-txt { flex: 1; min-width: 0; }
  .cw-svc-name { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 15px; letter-spacing: -0.2px; }
  .cw-svc-desc { margin-top: 2px; font-size: 12px; line-height: 1.45; color: var(--graphite); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .cw-svc-dur { margin-top: 4px; font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--ash); }
  .cw-svc-pc { display: flex; flex-direction: column; align-items: flex-end; gap: 3px; }
  .cw-svc-price { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 20px; letter-spacing: -0.5px; white-space: nowrap; }
  .cw-svc-go { display: inline-flex; align-items: center; gap: 1px; font-size: 11px; font-weight: 600; color: var(--coral-500); }
  .cw-empty { padding: 40px 0; text-align: center; color: var(--graphite); font-size: 14px; }
  .cw-empty svg { margin: 0 auto 12px; color: var(--ash); }

  /* Reviews */
  .cw-revs { display: grid; gap: 10px; padding-top: 4px; }
  .cw-rev { background: var(--paper); border: 1px solid var(--stone); border-radius: 16px; padding: 14px; }
  .cw-rev-h { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
  .cw-rev-av { flex: 0 0 32px; height: 32px; border-radius: 50%; background: var(--coral-50); border: 1px solid var(--coral-100); color: var(--coral-700); font-size: 12px; font-weight: 600; display: flex; align-items: center; justify-content: center; }
  .cw-rev-who { flex: 1; min-width: 0; }
  .cw-rev-name { font-size: 13px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cw-rev-date { margin-top: 1px; font-family: 'JetBrains Mono', monospace; font-size: 10px; color: var(--ash); }
  .cw-stars { display: flex; gap: 2px; }
  .cw-rev-txt { font-size: 13px; line-height: 18px; color: var(--graphite); }
  .cw-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
  .cw-tag { padding: 4px 9px; border-radius: 100px; background: var(--sand); font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: .5px; color: var(--graphite); }

  /* Sobre */
  .cw-about { display: grid; gap: 12px; }
  .cw-info { background: var(--paper); border: 1px solid var(--stone); border-radius: 16px; padding: 16px; }
  .cw-info-lab { margin-bottom: 8px; font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 1px; color: var(--ash); text-transform: uppercase; }
  .cw-info-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
  .cw-info-head .cw-info-lab { margin: 0; }
  .cw-now { display: inline-flex; align-items: center; gap: 5px; padding: 4px 9px; border-radius: 100px; font-size: 11px; font-weight: 600; }
  .cw-now i { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  .cw-now.is-open { background: #d1ebd6; color: #2d6b42; }
  .cw-now.is-closed { background: var(--sand); border: 1px solid var(--stone); color: var(--graphite); }
  .cw-hrow { display: flex; align-items: center; justify-content: space-between; padding: 7px 0; }
  .cw-hday { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--graphite); }
  .cw-hrow.is-today .cw-hday { color: var(--ink); font-weight: 600; }
  .cw-today { padding: 1px 7px; border-radius: 100px; background: var(--coral-100); color: var(--coral-700); font-family: 'JetBrains Mono', monospace; font-size: 9px; letter-spacing: .5px; text-transform: uppercase; font-weight: 400; }
  .cw-hval { font-family: 'JetBrains Mono', monospace; font-size: 13px; letter-spacing: .3px; }
  .cw-hrow.is-today .cw-hval { font-weight: 600; }
  .cw-hval.is-closed { font-family: inherit; letter-spacing: 0; color: var(--ash); }
  .cw-addr { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 15px; letter-spacing: -0.2px; }
  .cw-addr-sub { margin-top: 4px; font-size: 13px; line-height: 19px; color: var(--graphite); }
  .cw-addr-dist { margin-top: 8px; font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: .3px; color: var(--coral-500); }
  .cw-minimap { height: 150px; margin-top: 14px; border-radius: 12px; overflow: hidden; border: 1px solid var(--stone); background: var(--sand); }
  .cw-minimap .leaflet-tile-pane { filter: grayscale(1) sepia(.18) contrast(.92) brightness(1.03); }
  .cw-minimap .leaflet-control-attribution { font-size: 9px; background: rgba(250,250,246,.8); }
  .cw-pin { width: 18px; height: 18px; border-radius: 50%; background: var(--coral-500); border: 3px solid var(--cream); box-shadow: 0 2px 8px rgba(0,0,0,.35); }
  .cw-mapbtn { display: inline-flex; align-items: center; gap: 8px; margin-top: 14px; padding: 12px 14px; border-radius: 100px; background: var(--sand); border: 1px solid var(--stone); color: var(--ink) !important; font-size: 13px; font-weight: 600; transition: background .15s; }
  .cw-mapbtn:hover { background: var(--stone); }
  .cw-mapbtn .feather:last-child { color: var(--graphite); }
  .cw-lrow { display: flex; align-items: center; gap: 12px; padding: 7px 0; }
  .cw-lic { flex: 0 0 34px; height: 34px; border-radius: 10px; background: var(--sand); color: var(--graphite); display: flex; align-items: center; justify-content: center; }
  .cw-lic.is-lm { background: var(--coral-100); color: var(--coral-500); }
  .cw-ltxt { flex: 1; font-size: 14px; line-height: 19px; }
  .cw-aside { display: none; }

  /* ── Agendamento ───────────────────────────────────────────────────── */
  .bk { padding-bottom: 140px; }
  .bk-head { display: flex; align-items: center; justify-content: space-between; padding: 8px 20px; }
  .bk-back { width: 40px; height: 40px; border-radius: 50%; border: 0; background: var(--sand); color: var(--ink); display: inline-flex; align-items: center; justify-content: center; transition: background .15s; }
  .bk-back:hover { background: var(--stone); }
  .bk-title { flex: 1; text-align: center; margin: 0 !important; font-family: 'Space Grotesk', sans-serif !important; font-weight: 600; font-size: 18px; letter-spacing: -0.3px; color: var(--ink) !important; }
  .bk-prog { display: flex; gap: 6px; padding: 8px 20px 20px; }
  .bk-prog i { flex: 1; height: 4px; border-radius: 2px; background: var(--sand); transition: background .3s; }
  .bk-prog i.is-on { background: var(--coral-500); }
  .bk-sum { display: flex; align-items: center; gap: 12px; padding: 14px; margin: 4px 20px 24px; background: var(--sand); border-radius: 14px; }
  .bk-sum-logo { flex: 0 0 44px; height: 44px; }
  /* Régua de agendamento (limite e faltas) — igual ao app */
  .bk-rule { display: flex; gap: 12px; padding: 16px; background: var(--coral-50); border: 1px solid var(--coral-100); border-radius: 16px; color: var(--coral-700); }
  .bk-rule b { display: block; color: var(--ink); font-size: 14px; margin-bottom: 4px; }
  .bk-rule p { margin: 0; color: var(--graphite); font-size: 13px; line-height: 1.4; }
  .bk-rule a { display: inline-block; margin-top: 10px; color: var(--coral-700); font-size: 13px; font-weight: 600; }
  .bk-rulenote { margin: 12px 0 0; color: var(--graphite); font-size: 12px; line-height: 1.45; }
  .bk-brow a { color: var(--coral-700); font-weight: 600; }
  .ok-deposit { margin: 0; color: var(--graphite); font-size: 13px; line-height: 1.45; }
  .bk-sum-logo svg { width: 100%; height: 100%; display: block; }
  .bk-sum-txt { flex: 1; min-width: 0; }
  .bk-sum-shop { font-size: 14px; font-weight: 600; letter-spacing: -0.2px; }
  .bk-sum-svc { margin-top: 2px; font-size: 12px; color: var(--graphite); }
  .bk-sum-price { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 18px; letter-spacing: -0.4px; white-space: nowrap; }
  .bk-lab { padding: 0 20px 12px; font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 1px; color: var(--ash); text-transform: uppercase; }
  .bk-days { display: flex; gap: 10px; padding: 0 20px 24px; overflow-x: auto; scrollbar-width: none; }
  .bk-days::-webkit-scrollbar { display: none; }
  .bk-day { flex: 0 0 64px; height: 76px; border-radius: 18px; border: 1px solid var(--stone); background: var(--paper); color: var(--ink); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; transition: background .15s, border-color .15s; }
  .bk-day:hover { border-color: var(--ink); }
  .bk-day small { font-family: 'JetBrains Mono', monospace; font-size: 10px; color: var(--graphite); opacity: .7; text-transform: uppercase; }
  .bk-day b { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 22px; letter-spacing: -0.5px; line-height: 1.1; }
  .bk-day.is-closed { background: var(--sand); opacity: .6; }
  .bk-day.is-closed small, .bk-day.is-closed b { color: var(--ash); }
  .bk-day.is-on { background: var(--ink); border-color: var(--ink); opacity: 1; }
  .bk-day.is-on small, .bk-day.is-on b { color: var(--cream); opacity: 1; }
  .bk-times { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; padding: 0 20px; }
  .bk-time { position: relative; height: 48px; border-radius: 14px; border: 1px solid var(--stone); background: var(--paper); color: var(--ink) !important; font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 16px; display: flex; align-items: center; justify-content: center; transition: background .15s, border-color .15s; }
  .bk-time:hover { border-color: var(--ink); }
  .bk-time.is-on { background: var(--coral-500); border-color: var(--coral-500); color: var(--cream) !important; }
  .bk-time.is-lm { background: var(--coral-50); border: 1px dashed var(--coral-500); color: var(--coral-700) !important; }
  .bk-time.is-off { background: var(--sand); color: var(--ash) !important; text-decoration: line-through; cursor: not-allowed; }
  .bk-time.is-off:hover { border-color: var(--stone); }
  .bk-time-zap { position: absolute; top: -6px; right: -6px; width: 18px; height: 18px; border-radius: 50%; background: var(--coral-500); border: 2px solid var(--cream); color: var(--cream); display: flex; align-items: center; justify-content: center; }
  .bk-lmnote { display: flex; align-items: center; gap: 8px; margin: 14px 20px 0; font-size: 12px; color: var(--graphite); }
  .bk-lmnote span { flex: 0 0 18px; height: 18px; border-radius: 50%; background: var(--coral-500); color: var(--cream); display: flex; align-items: center; justify-content: center; }
  .bk-closed { display: flex; align-items: center; gap: 10px; margin: 0 20px; padding: 14px; border-radius: 14px; background: var(--coral-50); border: 1px solid var(--coral-100); color: var(--coral-700); font-size: 13px; font-weight: 600; line-height: 18px; }
  .bk-msg { padding: 40px 20px; text-align: center; font-size: 13px; color: var(--graphite); }
  .bk-spin { width: 22px; height: 22px; margin: 40px auto; border-radius: 50%; border: 2.5px solid var(--coral-100); border-top-color: var(--coral-500); animation: bkspin .8s linear infinite; }
  @keyframes bkspin { to { transform: rotate(360deg); } }
  .bk-break { margin: 0 20px; padding: 18px; background: var(--paper); border: 1px solid var(--stone); border-radius: 20px; }
  .bk-brow { display: flex; justify-content: space-between; align-items: center; padding: 4px 0; font-size: 14px; }
  .bk-brow span { color: var(--graphite); }
  .bk-brow b { font-weight: 600; }
  .bk-bdiv { height: 1px; background: var(--stone); margin: 10px 0; }
  .bk-btot span { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 16px; color: var(--ink); }
  .bk-btot b { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 28px; letter-spacing: -0.8px; }
  .bk-when { display: flex; align-items: center; gap: 12px; margin: 0 20px 10px; padding: 16px; background: var(--paper); border: 1px solid var(--stone); border-radius: 16px; }
  .bk-when-ic { flex: 0 0 36px; height: 36px; border-radius: 10px; background: var(--sand); display: flex; align-items: center; justify-content: center; }
  .bk-when b { display: block; font-size: 14px; font-weight: 600; }
  .bk-when small { display: block; margin-top: 2px; font-size: 12px; color: var(--graphite); }
  .bk-when button { margin-left: auto; border: 0; background: transparent; color: var(--coral-500); font-size: 13px; font-weight: 600; padding: 8px 0; }
  .bk-method { display: flex; align-items: center; gap: 12px; margin: 0 20px; padding: 16px; background: var(--paper); border: 2px solid var(--ink); border-radius: 16px; }
  .bk-method-ic { flex: 0 0 36px; height: 36px; border-radius: 10px; background: var(--sand); display: flex; align-items: center; justify-content: center; }
  .bk-method b { display: block; font-size: 14px; font-weight: 600; }
  .bk-method small { display: block; margin-top: 2px; font-size: 12px; color: var(--graphite); }
  .bk-radio { margin-left: auto; flex: 0 0 22px; height: 22px; border-radius: 50%; background: var(--ink); color: var(--cream); display: flex; align-items: center; justify-content: center; }
  .bk-err { display: flex; align-items: center; gap: 8px; margin: 16px 20px 0; padding: 14px; border-radius: 12px; background: #f6d4d4; color: var(--rose-500, #c0392b); font-size: 13px; font-weight: 600; }
  .bk-err.is-off { display: none; }

  /* Barra flutuante: total + botão (celular). Em tela grande vira coluna. */
  .bk-bar { position: fixed; left: 12px; right: 12px; bottom: calc(18px + env(safe-area-inset-bottom, 0px)); z-index: 20; display: flex; align-items: center; gap: 10px; padding: 10px; background: var(--paper); border-radius: 32px; box-shadow: 0 2px 6px rgba(40,35,28,.08), 0 18px 40px -12px rgba(40,35,28,.4); }
  .bk-tot { flex: 1; padding-left: 14px; }
  .bk-tot small { display: block; font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 1px; color: var(--ash); }
  .bk-tot b { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 20px; letter-spacing: -0.4px; }
  .bk-cta { display: inline-flex; align-items: center; justify-content: center; gap: 8px; height: 52px; padding: 0 22px; border: 0; border-radius: 26px; background: var(--coral-500); color: var(--cream) !important; font-size: 16px; font-weight: 600; letter-spacing: -0.2px; transition: opacity .15s, transform .15s; }
  .bk-cta:hover:not([disabled]) { transform: translateY(-1px); }
  .bk-cta[disabled] { opacity: .5; cursor: default; }
  .bk-cta .bk-spin { width: 18px; height: 18px; margin: 0; border-color: rgba(250,250,246,.35); border-top-color: var(--cream); }
  .bk-aside-sum { display: none; }

  /* Confirmação */
  .ok { max-width: 560px; margin: 0 auto; padding: 40px 24px 48px; }
  .ok-check { width: 120px; height: 120px; margin: 0 auto 28px; border-radius: 50%; background: var(--coral-500); color: var(--cream); display: flex; align-items: center; justify-content: center; animation: okpop .5s cubic-bezier(.2,1.4,.4,1) both; }
  @keyframes okpop { from { transform: scale(.4); opacity: 0; } }
  .ok-title { margin: 0 !important; text-align: center; font-family: 'Space Grotesk', sans-serif !important; font-weight: 700; font-size: 40px; line-height: 42px; letter-spacing: -1.2px; color: var(--ink) !important; }
  .ok-title em { display: block; font-style: normal; color: var(--coral-500); }
  .ok-card { margin-top: 28px; padding: 20px; background: var(--paper); border: 1px solid var(--stone); border-radius: 20px; }
  .ok-top { display: flex; align-items: center; }
  .ok-lab { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 1px; color: var(--ash); }
  .ok-when { margin-top: 4px; font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 24px; letter-spacing: -0.5px; }
  .ok-cal { margin-left: auto; flex: 0 0 44px; height: 44px; border-radius: 12px; background: var(--sand); display: flex; align-items: center; justify-content: center; }
  .ok-div { height: 1px; background: var(--stone); margin: 16px 0; }
  .ok-shop { display: flex; align-items: center; gap: 10px; }
  .ok-logo { flex: 0 0 56px; height: 56px; }
  .ok-logo svg { width: 100%; height: 100%; display: block; }
  .ok-shop-t { flex: 1; min-width: 0; }
  .ok-shop-t b { display: block; font-size: 14px; font-weight: 600; }
  .ok-shop-t small { display: block; margin-top: 2px; font-size: 12px; color: var(--graphite); }
  .ok-price { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 20px; letter-spacing: -0.4px; }
  .ok-actions { display: grid; gap: 10px; margin-top: 32px; }
  .ok-primary { display: block; padding: 16px; border-radius: 28px; background: var(--coral-500); color: var(--cream) !important; text-align: center; font-size: 16px; font-weight: 600; }
  .ok-ghost { display: block; padding: 16px; border-radius: 28px; text-align: center; color: var(--ink) !important; font-size: 16px; font-weight: 500; }
  .ok-ghost:hover { background: var(--sand); }

  /* Visitante: folha "Entre para agendar" */
  .cw-sheet-bg { position: fixed; inset: 0; z-index: 60; background: rgba(26,22,18,.45); display: flex; align-items: flex-end; justify-content: center; opacity: 0; pointer-events: none; transition: opacity .2s; }
  .cw-sheet-bg.is-on { opacity: 1; pointer-events: auto; }
  .cw-sheet { width: 100%; max-width: 440px; background: var(--paper); border-radius: 24px 24px 0 0; padding: 26px 22px calc(22px + env(safe-area-inset-bottom, 0px)); transform: translateY(24px); transition: transform .25s; text-align: center; }
  .cw-sheet-bg.is-on .cw-sheet { transform: none; }
  .cw-sheet-ic { width: 52px; height: 52px; margin: 0 auto 14px; border-radius: 50%; background: var(--coral-100); color: var(--coral-500); display: flex; align-items: center; justify-content: center; }
  .cw-sheet h2 { margin: 0 0 6px !important; font-family: 'Space Grotesk', sans-serif !important; font-weight: 700; font-size: 22px; letter-spacing: -0.4px; color: var(--ink) !important; }
  .cw-sheet p { margin: 0 0 20px; font-size: 14px; line-height: 1.5; color: var(--graphite); }
  .cw-sheet a { display: block; padding: 15px; border-radius: 28px; font-size: 15px; font-weight: 600; margin-top: 10px; }
  .cw-sheet .is-primary { background: var(--coral-500); color: var(--cream) !important; }
  .cw-sheet .is-ghost { background: var(--sand); color: var(--ink) !important; }

  /* ── Telas grandes ─────────────────────────────────────────────────── */
  @media (min-width: 720px) {
    .cw-hero { height: 300px; }
    .cw-hero-bar, .cw-stats-wrap, .cw-tabs, .cw-pane { padding-left: 32px; padding-right: 32px; }
    .cw-stats { padding: 24px 28px; }
    .cw-title { font-size: 30px; letter-spacing: -0.8px; }
    .cw-logo { flex-basis: 64px; height: 64px; }
    .cw-stat-val { font-size: 18px; }
    .cw-svcs { grid-template-columns: 1fr 1fr; }
    .bk-times { grid-template-columns: repeat(5, 1fr); }
    .cw-sheet-bg { align-items: center; }
    .cw-sheet { border-radius: 24px; }
  }
  @media (min-width: 1024px) {
    .cw-hero-bar { max-width: 1200px; margin: 0 auto; }
    .cw-body { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 28px; align-items: start; padding: 0 32px; }
    .cw-body .cw-tabs, .cw-body .cw-pane { padding-left: 0; padding-right: 0; }
    .cw-seg { max-width: 360px; }
    .cw-seg [data-tab="sobre"] { display: none; }
    #cw-pane-sobre { display: none !important; }
    .cw-aside { display: block; padding-top: 14px; }
    .cw-svcs { grid-template-columns: 1fr; }

    .bk { padding-bottom: 40px; }
    .bk-grid { display: grid; grid-template-columns: minmax(0, 1fr) 380px; gap: 36px; align-items: start; padding: 0 32px; }
    .bk-main .bk-head, .bk-main .bk-prog, .bk-main .bk-lab, .bk-main .bk-days, .bk-main .bk-times { padding-left: 0; padding-right: 0; }
    .bk-main .bk-sum { display: none; }
    .bk-main .bk-closed, .bk-main .bk-break, .bk-main .bk-method, .bk-main .bk-when, .bk-main .bk-err, .bk-main .bk-lmnote { margin-left: 0; margin-right: 0; }
    .bk-days { display: grid; grid-template-columns: repeat(8, 1fr); overflow: visible; }
    .bk-day { width: auto; }
    .bk-times { grid-template-columns: repeat(6, 1fr); }
    .bk-aside { position: sticky; top: 84px; padding-top: 16px; }
    .bk-aside-sum { display: block; padding: 22px; background: var(--paper); border: 1px solid var(--stone); border-radius: 24px; box-shadow: 0 14px 36px -24px rgba(40,35,28,.45); }
    .bk-aside-sum .bk-sum { margin: 0 0 18px; }
    .bk-aside-line { display: flex; justify-content: space-between; padding: 6px 0; font-size: 14px; color: var(--graphite); }
    .bk-aside-line b { color: var(--ink); font-weight: 600; }
    .bk-bar { position: static; margin-top: 14px; padding: 0; box-shadow: none; background: transparent; border-radius: 0; flex-direction: column; align-items: stretch; gap: 14px; border-top: 1px solid var(--stone); padding-top: 16px; }
    .bk-tot { padding-left: 0; display: flex; justify-content: space-between; align-items: baseline; }
    .bk-tot b { font-size: 26px; }
    .bk-cta { width: 100%; }
  }
</style>

<div class="cw" id="cw">
  <%# ── Detalhe ─────────────────────────────────────────────────── %>
  <section class="cw-view is-on" id="cw-detail">
    <div class="cw-hero">
      <div class="cw-hero-bar">
        <a class="cw-glass" id="cw-back" href="/<%= coords_qs %>" aria-label="Voltar"><i data-feather="arrow-left" style="width:18px;height:18px"></i></a>
        <% if is_client %>
          <button type="button" class="cw-glass" id="cw-fav" aria-label="Favoritar" aria-pressed="false"></button>
        <% elsif is_owner_manage %>
          <a class="cw-glass" href="<%= manage_car_wash_path(@car_wash) %>" aria-label="Gerenciar"><i data-feather="settings" style="width:18px;height:18px"></i></a>
        <% end %>
      </div>
    </div>

    <div class="cw-wrap">
      <div class="cw-stats-wrap"><div class="cw-stats" id="cw-stats"></div></div>
      <div class="cw-body">
        <div class="cw-main">
          <div class="cw-tabs">
            <div class="cw-seg" role="tablist">
              <button type="button" role="tab" data-tab="servicos" aria-selected="true">Serviços</button>
              <button type="button" role="tab" data-tab="reviews" aria-selected="false">Reviews</button>
              <button type="button" role="tab" data-tab="sobre" aria-selected="false">Sobre</button>
            </div>
          </div>
          <div class="cw-pane is-on" id="cw-pane-servicos"></div>
          <div class="cw-pane" id="cw-pane-reviews"></div>
          <div class="cw-pane" id="cw-pane-sobre"></div>
        </div>
        <aside class="cw-aside" id="cw-aside" aria-label="Sobre o lava-rápido"></aside>
      </div>
    </div>
    <%= render "shared/site_footer", audience: (user_signed_in? ? :client : :visitor) %>
  </section>

  <%# ── Agendamento (passos 1 e 2) ──────────────────────────────── %>
  <section class="cw-view bk" id="cw-book">
    <div class="cw-wrap">
      <div class="bk-grid">
        <div class="bk-main">
          <div class="bk-head">
            <button type="button" class="bk-back" id="bk-back" aria-label="Voltar"><i data-feather="arrow-left" style="width:18px;height:18px"></i></button>
            <h1 class="bk-title" id="bk-title">Escolha um horário</h1>
            <span style="width:40px"></span>
          </div>
          <div class="bk-prog"><i class="is-on"></i><i id="bk-prog2"></i></div>
          <div class="bk-sum" id="bk-sum-mob"></div>
          <div id="bk-step"></div>
        </div>
        <aside class="bk-aside">
          <div class="bk-aside-sum" id="bk-aside-sum"></div>
          <div class="bk-bar" id="bk-bar">
            <div class="bk-tot"><small>TOTAL</small><b id="bk-total">—</b></div>
            <button type="button" class="bk-cta" id="bk-cta" disabled>Continuar <i data-feather="arrow-right" style="width:16px;height:16px"></i></button>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <%# ── Passo 3: confirmado ─────────────────────────────────────── %>
  <section class="cw-view" id="cw-done"></section>

  <div class="cw-sheet-bg" id="cw-login" aria-hidden="true">
    <div class="cw-sheet" role="dialog" aria-modal="true" aria-labelledby="cw-login-t">
      <div class="cw-sheet-ic"><i data-feather="calendar" style="width:22px;height:22px"></i></div>
      <h2 id="cw-login-t">Entre para agendar</h2>
      <p>Com a sua conta, o horário fica guardado e você recebe a confirmação por e-mail. Depois de entrar, você volta direto pra cá.</p>
      <a class="is-primary" href="<%= new_user_session_path %>">Entrar</a>
      <a class="is-ghost" href="<%= new_user_registration_path(role: 'client') %>">Criar conta grátis</a>
    </div>
  </div>
</div>

<script>
(function () {
  var CW       = <%= raw json_escape(@detail.to_json) %>;
  var CLOSURES = <%= raw json_escape(closure_dates.to_json) %>;
  var IS_CLIENT = <%= is_client ? 'true' : 'false' %>;
  var SIGNED_IN = <%= user_signed_in? ? 'true' : 'false' %>;
  var COORDS_QS = <%= raw json_escape(coords_qs.to_json) %>;
  var CSRF = (document.querySelector('meta[name="csrf-token"]') || {}).content;
  // Régua do cliente (limite e faltas, User#restricao_agendamento) e cartão:
  // o agendamento mostra antes de escolher horário se não pode agendar, e
  // cobra o sinal quando a régua pede. Mesmo dado que o app lê do perfil.
  <% regra = is_client ? current_user.restricao_agendamento : nil %>
  var RULES = <%= raw json_escape((is_client ? {
    restricao: regra&.dig(:tipo)&.to_s, ate: regra&.dig(:ate)&.in_time_zone("America/Sao_Paulo")&.strftime("%d/%m"),
    faltas: current_user.faltas_recentes.count, ativos: current_user.agendamentos_comuns_ativos.count,
    limite: User::LIMITE_AGENDAMENTOS, has_card: current_user.has_payment_method?, card: current_user.card_display
  } : {}).to_json) %>;
  var PCT = <%= Appointment::PREPAYMENT_PCT %>, PCT_LABEL = Math.round(PCT * 100) + '%';
  var STRIPE_PK = <%= raw json_escape(ENV['STRIPE_PUBLISHABLE_KEY'].to_s.to_json) %>;
  function comSinal() { return RULES.restricao === 'sinal'; }
  function bloqueado() { return RULES.restricao === 'bloqueio'; }
  function noLimite() { return RULES.limite && RULES.ativos >= RULES.limite; }
  function sinalDe(price) { return Math.round(Number(price) * PCT * 100) / 100; }
  function cardUrl() {
    return '/client/profile/edit?add_card=1&return_to=' + encodeURIComponent(location.pathname + location.search + '#agendar-' + (bk.service ? bk.service.id : ''));
  }

  var MONTHS = ['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];
  var WD_SHORT = ['dom','seg','ter','qua','qui','sex','sáb'];
  var WD_FULL = ['Domingo','Segunda','Terça','Quarta','Quinta','Sexta','Sábado'];
  var WD_LOWER = ['domingo','segunda','terça','quarta','quinta','sexta','sábado'];
  var WEEK_ORDER = [1, 2, 3, 4, 5, 6, 0];
  // Ícones de categoria — os mesmos do app (CATEGORY_MAP). `zap` é do Last Minute.
  var CAT_ICON = {
    'lavagem': 'droplet', 'polimento': 'feather', 'higienização': 'wind', 'higienizacao': 'wind',
    'cristalização': 'aperture', 'cristalizacao': 'aperture', 'vitrificação': 'shield', 'vitrificacao': 'shield',
    'enceramento': 'disc', 'hidratação de couro': 'layers', 'hidratacao de couro': 'layers',
    'limpeza de motor': 'cpu', 'revitalização de plásticos': 'refresh-cw', 'revitalizacao de plasticos': 'refresh-cw',
    'polimento de faróis': 'sun', 'polimento de farois': 'sun', 'impermeabilização': 'umbrella', 'impermeabilizacao': 'umbrella',
    'oxi-sanitização': 'filter', 'oxi-sanitizacao': 'filter', 'outros': 'grid'
  };
  var CAT_FALLBACK = ['droplet','feather','sun','star','aperture','shield','disc','wind','layers','umbrella','refresh-cw','cpu','filter'];

  function $(id) { return document.getElementById(id); }
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
  function icon(n, size, extra) { return window.feather && feather.icons[n] ? feather.icons[n].toSvg(Object.assign({ width: size, height: size }, extra || {})) : ''; }
  function money(v, dec) { var n = Number(v); return isFinite(n) ? n.toFixed(dec || 0).replace('.', ',') : '—'; }
  function catIcon(cat, i) { return CAT_ICON[String(cat || '').toLowerCase().trim()] || CAT_FALLBACK[i % CAT_FALLBACK.length]; }
  function ymd(d) { return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); }
  function ohOf(dow) { return (CW.operating_hours || []).filter(function (h) { return Number(h.day_of_week) === dow; })[0]; }
  function closedOn(d) {
    if (CLOSURES.indexOf(ymd(d)) !== -1) return true;
    if (!(CW.operating_hours || []).length) return false;
    var oh = ohOf(d.getDay());
    return !oh || !oh.opens_at || !oh.closes_at;
  }
  function todayHours() {
    if (!(CW.operating_hours || []).length) return '—';
    var oh = ohOf(new Date().getDay());
    if (!oh || !oh.opens_at || !oh.closes_at) return 'Fechado';
    function f(t) { var p = String(t).slice(0, 5).split(':'); var h = parseInt(p[0], 10); return p[1] === '00' ? String(h) : h + ':' + p[1]; }
    return f(oh.opens_at) + '–' + f(oh.closes_at) + 'h';
  }
  function reviewDate(iso) {
    if (!iso) return '';
    var then = new Date(iso), days = Math.floor((Date.now() - then) / 86400000);
    if (days < 1) return 'hoje';
    if (days < 2) return 'ontem';
    if (days < 7) return 'há ' + days + ' dias';
    if (days < 30) return 'há ' + Math.floor(days / 7) + ' sem';
    return then.toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit', year: '2-digit' });
  }
  var services = CW.services || [];
  var minPrice = services.length ? Math.min.apply(null, services.map(function (s) { return Number(s.price) || 999; })) : null;

  // ── Detalhe ─────────────────────────────────────────────────────────────
  function renderStats() {
    var open = !!CW.open_now, n = Number(CW.reviews_count) || 0;
    $('cw-stats').innerHTML =
      '<div class="cw-stats-top">' +
        '<div class="cw-logo">' + LoovLogos.logoOf(CW) + '</div>' +
        '<div style="flex:1;min-width:0"><h1 class="cw-title">' + esc(CW.name) + '</h1>' +
          '<div class="cw-hood">' + esc([CW.bairro, CW.cidade].filter(Boolean).join(' · ') || CW.address || '') + '</div></div>' +
        '<span class="cw-badge ' + (open ? 'is-open' : 'is-closed') + '">' + icon(open ? 'check' : 'moon', 11) + (open ? 'Aberto' : 'Fechado') + '</span>' +
      '</div>' +
      '<div class="cw-statrow">' +
        '<div class="cw-stat"><div class="cw-stat-top">' + icon('star', 13, { color: 'var(--coral-500)' }) + '<span class="cw-stat-val">' + (n > 0 ? Number(CW.rating_avg).toFixed(1).replace('.', ',') : '—') + '</span></div>' +
          '<div class="cw-stat-lab">' + (n > 0 ? n + (n === 1 ? ' avaliação' : ' avaliações') : 'sem avaliações') + '</div></div>' +
        '<div class="cw-stat-sep"></div>' +
        '<div class="cw-stat"><div class="cw-stat-top">' + icon('clock', 13, { color: 'var(--graphite)' }) + '<span class="cw-stat-val">' + todayHours() + '</span></div><div class="cw-stat-lab">hoje</div></div>' +
        '<div class="cw-stat-sep"></div>' +
        '<div class="cw-stat"><div class="cw-stat-top">' + icon('droplet', 13, { color: 'var(--pool-500)' }) + '<span class="cw-stat-val">' + (minPrice != null ? 'R$' + money(minPrice) : '—') + '</span></div><div class="cw-stat-lab">a partir</div></div>' +
      '</div>';
  }

  function renderServices() {
    var bookable = IS_CLIENT || !SIGNED_IN;
    if (!services.length) { $('cw-pane-servicos').innerHTML = '<div class="cw-empty">Este lava-rápido ainda não cadastrou serviços.</div>'; return; }
    $('cw-pane-servicos').innerHTML = (bookable ? '<div class="cw-hint">Toque num serviço para agendar</div>' : '') +
      '<div class="cw-svcs">' + services.map(function (s, i) {
        return '<' + (bookable ? 'button type="button" data-svc="' + s.id + '"' : 'div') + ' class="cw-svc' + (bookable ? '' : ' is-static') + '">' +
          '<span class="cw-svc-ic">' + icon(catIcon(s.category, i), 20) + '</span>' +
          '<span class="cw-svc-txt"><span class="cw-svc-name" style="display:block">' + esc(s.title) + '</span>' +
            (s.description ? '<span class="cw-svc-desc">' + esc(s.description) + '</span>' : '') +
            '<span class="cw-svc-dur" style="display:block">' + (s.duration || 30) + ' min</span></span>' +
          '<span class="cw-svc-pc"><span class="cw-svc-price">R$' + money(s.price) + '</span>' +
            (bookable ? '<span class="cw-svc-go">Agendar' + icon('chevron-right', 14) + '</span>' : '') + '</span>' +
        '</' + (bookable ? 'button' : 'div') + '>';
      }).join('') + '</div>';
  }

  function renderReviews() {
    var list = CW.reviews || [];
    if (!list.length) { $('cw-pane-reviews').innerHTML = '<div class="cw-empty">' + icon('message-square', 32) + 'Sem avaliações ainda</div>'; return; }
    $('cw-pane-reviews').innerHTML = '<div class="cw-revs">' + list.map(function (r) {
      var stars = '';
      for (var n = 1; n <= 5; n++) stars += icon('star', 11, { color: n <= Number(r.rating) ? 'var(--coral-500)' : 'var(--stone)' });
      return '<div class="cw-rev"><div class="cw-rev-h">' +
          '<div class="cw-rev-av">' + esc((String(r.author || 'C').trim()[0] || 'C').toUpperCase()) + '</div>' +
          '<div class="cw-rev-who"><div class="cw-rev-name">' + esc(r.author) + '</div><div class="cw-rev-date">' + reviewDate(r.created_at) + '</div></div>' +
          '<div class="cw-stars">' + stars + '</div></div>' +
        (r.comment ? '<div class="cw-rev-txt">' + esc(r.comment) + '</div>' : '') +
        ((r.tags || []).length ? '<div class="cw-tags">' + r.tags.map(function (t) { return '<span class="cw-tag">' + esc(t) + '</span>'; }).join('') + '</div>' : '') +
      '</div>';
    }).join('') + '</div>';
  }

  function aboutHtml(mapId) {
    var open = !!CW.open_now, list = CW.operating_hours || [], today = new Date().getDay();
    var hours = list.length ? WEEK_ORDER.map(function (dow) {
      var oh = ohOf(dow), closed = !oh || !oh.opens_at || !oh.closes_at, isT = dow === today;
      return '<div class="cw-hrow' + (isT ? ' is-today' : '') + '"><span class="cw-hday">' + WD_FULL[dow] + (isT ? '<span class="cw-today">hoje</span>' : '') + '</span>' +
        '<span class="cw-hval' + (closed ? ' is-closed' : '') + '">' + (closed ? 'Fechado' : oh.opens_at + ' – ' + oh.closes_at) + '</span></div>';
    }).join('') : '<div class="cw-ltxt">Horários não informados</div>';
    var sub = [CW.bairro, CW.cidade, CW.uf].filter(Boolean).join(' · ') + (CW.cep ? '  ·  ' + CW.cep : '');
    var hasCoords = CW.lat != null && CW.lng != null;
    var cap = Number(CW.capacity_per_slot) || 0;
    return '<div class="cw-about">' +
      '<div class="cw-info"><div class="cw-info-head"><span class="cw-info-lab">Horários</span>' +
        '<span class="cw-now ' + (open ? 'is-open' : 'is-closed') + '"><i></i>' + (open ? 'Aberto agora' : 'Fechado agora') + '</span></div>' + hours + '</div>' +
      '<div class="cw-info"><div class="cw-info-lab">Endereço</div>' +
        '<div class="cw-addr">' + esc(CW.logradouro || CW.address || '—') + '</div>' +
        (sub.trim() ? '<div class="cw-addr-sub">' + esc(sub) + '</div>' : '') +
        (CW.distance_km != null ? '<div class="cw-addr-dist">a ' + Number(CW.distance_km).toFixed(1).replace('.', ',') + ' km de você</div>' : '') +
        (hasCoords ? '<div class="cw-minimap" id="' + mapId + '"></div>' : '') +
        '<a class="cw-mapbtn" target="_blank" rel="noopener" href="' + mapsUrl() + '">' + icon('map-pin', 14) + 'Abrir no mapa' + icon('arrow-up-right', 14) + '</a>' +
      '</div>' +
      ((cap > 0 || CW.disponivel_eligible) ? '<div class="cw-info"><div class="cw-info-lab">O local</div>' +
        (cap > 0 ? '<div class="cw-lrow"><span class="cw-lic">' + icon('layers', 15) + '</span><span class="cw-ltxt">Atende até ' + cap + ' ' + (cap === 1 ? 'carro' : 'carros') + ' por horário</span></div>' : '') +
        (CW.disponivel_eligible ? '<div class="cw-lrow"><span class="cw-lic is-lm">' + icon('zap', 15) + '</span><span class="cw-ltxt">Aceita reservas last minute</span></div>' : '') +
      '</div>' : '') +
    '</div>';
  }
  function mapsUrl() {
    var q = CW.lat != null && CW.lng != null ? CW.lat + ',' + CW.lng : [CW.logradouro || CW.address, CW.bairro, CW.cidade].filter(Boolean).join(', ');
    return 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(q);
  }
  var maps = {};
  function mountMap(id) {
    var el = $(id);
    if (!el || maps[id] || !window.L || el.offsetParent === null) return;
    var m = L.map(el, { zoomControl: false, dragging: false, scrollWheelZoom: false, doubleClickZoom: false, boxZoom: false, keyboard: false, touchZoom: false })
      .setView([CW.lat, CW.lng], 15);
    m.attributionControl.setPrefix(false);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19, attribution: '© OpenStreetMap' }).addTo(m);
    L.marker([CW.lat, CW.lng], { icon: L.divIcon({ className: '', html: '<div class="cw-pin"></div>', iconSize: [18, 18], iconAnchor: [9, 9] }) }).addTo(m);
    maps[id] = m;
  }
  function renderAbout() {
    $('cw-pane-sobre').innerHTML = aboutHtml('cw-map-tab');
    $('cw-aside').innerHTML = aboutHtml('cw-map-aside');
    mountMap('cw-map-aside');
  }

  function setTab(t) {
    document.querySelectorAll('.cw-seg button').forEach(function (b) { b.setAttribute('aria-selected', b.dataset.tab === t ? 'true' : 'false'); });
    ['servicos', 'reviews', 'sobre'].forEach(function (k) { $('cw-pane-' + k).classList.toggle('is-on', k === t); });
    if (t === 'sobre') mountMap('cw-map-tab');
  }

  // Favoritar: otimista, volta atrás se o servidor recusar (igual ao app).
  function renderFav() {
    var b = $('cw-fav'); if (!b) return;
    b.classList.toggle('is-fav', !!CW.favorited);
    b.setAttribute('aria-pressed', CW.favorited ? 'true' : 'false');
    b.innerHTML = icon('heart', 19);
  }
  var favBusy = false;
  function toggleFav() {
    if (favBusy) return;
    var prev = !!CW.favorited;
    CW.favorited = !prev; renderFav(); favBusy = true;
    var req = prev
      ? fetch('/client/favorites/' + CW.id, { method: 'DELETE', credentials: 'same-origin', headers: { Accept: 'application/json', 'X-CSRF-Token': CSRF } })
      : fetch('/client/favorites', { method: 'POST', credentials: 'same-origin', headers: { Accept: 'application/json', 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF }, body: JSON.stringify({ car_wash_id: CW.id }) });
    req.then(function (r) { if (!r.ok) throw 0; })
      .catch(function () { CW.favorited = prev; renderFav(); })
      .then(function () { favBusy = false; });
  }

  // ── Agendamento ─────────────────────────────────────────────────────────
  var bk = { service: null, step: 1, dateIdx: 0, time: null, times: [], loading: false, submitting: false, error: null, seq: 0 };
  var dates = (function () { var b = new Date(), out = []; for (var i = 0; i < 15; i++) { var d = new Date(b); d.setDate(b.getDate() + i); out.push(d); } return out; })();
  function dayLabel(d) { return d.toDateString() === new Date().toDateString() ? 'hoje' : WD_SHORT[d.getDay()]; }
  function svcById(id) { return services.filter(function (s) { return String(s.id) === String(id); })[0]; }

  function showView(v) {
    ['detail', 'book', 'done'].forEach(function (k) { $('cw-' + k).classList.toggle('is-on', k === v); });
    window.scrollTo(0, 0);
  }

  function openBooking(svcId, push) {
    var s = svcById(svcId); if (!s) return;
    if (!IS_CLIENT) { openLogin(); return; }
    var same = bk.service && bk.service.id === s.id;
    bk.service = s; bk.step = 1; bk.error = null;
    if (!same) { bk.time = null; bk.dateIdx = 0; }
    if (push) history.pushState({ v: 'book', svc: s.id, step: 1 }, '', '#agendar-' + s.id);
    showView('book');
    renderBooking();
    if (!same || !bk.times.length) loadTimes();
  }

  function sumHtml() {
    var s = bk.service;
    return '<div class="bk-sum-logo">' + LoovLogos.logoOf(CW) + '</div>' +
      '<div class="bk-sum-txt"><div class="bk-sum-shop">' + esc(CW.name) + '</div><div class="bk-sum-svc">' + esc(s.title) + ' · ' + (s.duration || 30) + 'min</div></div>' +
      '<div class="bk-sum-price">R$' + money(s.price) + '</div>';
  }
  function whenText() {
    var d = dates[bk.dateIdx];
    return bk.time ? dayLabel(d) + ', ' + d.getDate() + ' ' + MONTHS[d.getMonth()] + ' · ' + bk.time : null;
  }

  function renderBooking() {
    var s = bk.service;
    $('bk-title').textContent = bk.step === 1 ? 'Escolha um horário' : 'Confirmação';
    $('bk-prog2').classList.toggle('is-on', bk.step >= 2);
    $('bk-sum-mob').innerHTML = sumHtml();
    var w = whenText();
    $('bk-aside-sum').innerHTML = '<div class="bk-sum">' + sumHtml() + '</div>' +
      '<div class="bk-aside-line"><span>Quando</span><b>' + (w ? esc(w) : 'Escolha dia e horário') + '</b></div>' +
      '<div class="bk-aside-line"><span>Pagamento</span><b>' + (comSinal() ? 'Sinal de ' + PCT_LABEL + ' no cartão' : 'No lava-rápido') + '</b></div>';
    $('bk-total').textContent = 'R$' + money(s.price);
    var cta = $('bk-cta'), travado = bloqueado() || noLimite();
    cta.disabled = (bk.step === 1 && (!bk.time || travado)) || bk.submitting;
    var rotulo = bk.step === 1 ? 'Continuar'
      : comSinal() ? (RULES.has_card ? 'Pagar sinal R$ ' + money(sinalDe(s.price), 2) : 'Cadastrar cartão')
      : 'Confirmar';
    cta.innerHTML = bk.submitting ? '<span class="bk-spin"></span>' : rotulo + ' ' + icon('arrow-right', 16);
    $('bk-step').innerHTML = bk.step === 1 ? step1Html() : step2Html();
    var on = document.querySelector('.bk-day.is-on');
    var row = on && on.parentNode;
    if (row && row.scrollWidth > row.clientWidth) {
      // Só rola se o dia escolhido estiver fora de vista.
      var rel = on.getBoundingClientRect().left - row.getBoundingClientRect().left;
      if (rel < 0 || rel + on.offsetWidth > row.clientWidth) row.scrollLeft = Math.max(0, rel + row.scrollLeft - 20);
    }
  }

  function step1Html() {
    var days = dates.map(function (d, i) {
      var on = i === bk.dateIdx, closed = closedOn(d);
      return '<button type="button" class="bk-day' + (on ? ' is-on' : '') + (closed && !on ? ' is-closed' : '') + '" data-day="' + i + '" aria-pressed="' + on + '">' +
        '<small>' + MONTHS[d.getMonth()] + '</small><b>' + d.getDate() + '</b><small>' + dayLabel(d) + '</small></button>';
    }).join('');
    var d = dates[bk.dateIdx], body;
    // Quem não pode agendar sabe antes de escolher horário, com a saída possível.
    if (bloqueado() || noLimite()) {
      body = '<div class="bk-rule">' + icon(bloqueado() ? 'slash' : 'calendar', 18) + '<div>' +
        '<b>' + (bloqueado() ? 'Agendamento bloqueado até ' + esc(RULES.ate) : 'Você já tem ' + RULES.limite + ' agendamentos marcados') + '</b>' +
        '<p>' + (bloqueado()
          ? 'Por causa de ' + RULES.faltas + ' faltas nos últimos 90 dias. O Last Minute continua liberado. Se alguma falta foi registrada por engano, fale com o Suporte.'
          : 'Pra marcar outro, cancele um deles ou espere um acontecer.') + '</p>' +
        '<a href="' + (bloqueado() ? '/disponivel' : '/appointments') + '">' + (bloqueado() ? 'Ver o Last Minute →' : 'Ver meus agendamentos →') + '</a>' +
        '</div></div>';
      return '<div class="bk-lab">Dia</div><div class="bk-days" id="bk-days">' + days + '</div><div class="bk-lab">Horário</div>' + body;
    }
    if (bk.loading) body = '<div class="bk-spin"></div>';
    else if (closedOn(d)) {
      var name = WD_LOWER[d.getDay()], label = ['segunda','terça','quarta','quinta','sexta'].indexOf(name) !== -1 ? name + '-feira' : name;
      body = CLOSURES.indexOf(ymd(d)) !== -1
        ? '<div class="bk-closed">' + icon('moon', 18) + '<span>O lava-rápido estará fechado neste dia. Escolha outro dia.</span></div>'
        : '<div class="bk-closed">' + icon('moon', 18) + '<span>O lava-rápido não atende ' + label + '. Escolha outro dia.</span></div>';
    }
    else if (!bk.times.length) body = '<div class="bk-msg">Sem horários disponíveis nesse dia.</div>';
    else {
      var anyLm = false;
      body = '<div class="bk-times">' + bk.times.map(function (t) {
        var ts = t.time || t, only = !!t.disponivel_only, lm = only && CW.disponivel_eligible, off = only && !CW.disponivel_eligible;
        if (lm) anyLm = true;
        var cls = 'bk-time' + (ts === bk.time ? ' is-on' : '') + (lm ? ' is-lm' : '') + (off ? ' is-off' : '');
        // Vaga de última hora: vai pro Disponível já com esta loja aberta.
        if (lm) return '<a class="' + cls + '" href="/disponivel' + (COORDS_QS ? COORDS_QS + '&' : '?') + 'car_wash_id=' + CW.id + '" title="Reservar pelo Last Minute">' + ts + '<span class="bk-time-zap">' + icon('zap', 9) + '</span></a>';
        return '<button type="button" class="' + cls + '" data-time="' + ts + '"' + (off ? ' disabled title="Só pelo Last Minute"' : '') + '>' + ts + '</button>';
      }).join('') + '</div>' +
      (anyLm ? '<div class="bk-lmnote"><span>' + icon('zap', 10) + '</span>Horário em cima da hora: reserva pelo Last Minute.</div>' : '');
    }
    return '<div class="bk-lab">Dia</div><div class="bk-days" id="bk-days">' + days + '</div><div class="bk-lab">Horário</div>' + body;
  }

  function step2Html() {
    var s = bk.service, d = dates[bk.dateIdx];
    return '<div class="bk-lab">Quando</div>' +
      '<div class="bk-when"><span class="bk-when-ic">' + icon('calendar', 18) + '</span><span><b>' + esc(whenText()) + '</b><small>' + esc(CW.name) + '</small></span>' +
        '<button type="button" data-edit-when>Alterar</button></div>' +
      '<div class="bk-lab" style="margin-top:24px">Resumo</div>' +
      '<div class="bk-break">' +
        '<div class="bk-brow"><span>' + esc(s.title) + '</span><b>R$ ' + money(s.price, 2) + '</b></div>' +
        '<div class="bk-bdiv"></div>' +
        '<div class="bk-brow bk-btot"><span>Total</span><b>R$ ' + money(s.price, 2) + '</b></div>' +
      '</div>' +
      '<div class="bk-lab" style="margin-top:24px">Pagamento</div>' +
      (comSinal()
        ? '<div class="bk-break">' +
            '<div class="bk-brow"><span>Sinal agora, no cartão ' + PCT_LABEL + '</span><b>R$ ' + money(sinalDe(s.price), 2) + '</b></div>' +
            '<div class="bk-bdiv"></div>' +
            '<div class="bk-brow"><span>Na chegada, no lava-rápido</span><b>R$ ' + money(Math.max(0, Number(s.price) - sinalDe(s.price)), 2) + '</b></div>' +
            '<div class="bk-bdiv"></div>' +
            '<div class="bk-brow"><span>' + icon('credit-card', 14) + ' ' + esc(RULES.has_card ? RULES.card : 'Nenhum cartão cadastrado') + '</span>' +
              '<a href="' + cardUrl() + '">' + (RULES.has_card ? 'Trocar' : 'Cadastrar') + '</a></div>' +
          '</div>' +
          '<p class="bk-rulenote">Por causa de 2 faltas nos últimos 90 dias, até ' + esc(RULES.ate) + ' o agendamento comum pede um sinal. ' +
            'Ele volta pro cartão se você cancelar até 2 horas antes; se faltar, não volta.</p>'
        : '<div class="bk-method"><span class="bk-method-ic">' + icon('dollar-sign', 18) + '</span><span><b>No lava-rápido</b><small>Dinheiro, PIX ou cartão no local</small></span>' +
            '<span class="bk-radio">' + icon('check', 12, { 'stroke-width': 3 }) + '</span></div>' +
          '<p class="bk-rulenote">Cancelamento grátis até 2 horas antes. Faltas sem cancelar contam: com 2 em 90 dias, o agendamento comum passa a pedir um sinal no cartão.</p>') +
      '<div class="bk-err' + (bk.error ? '' : ' is-off') + '">' + icon('alert-circle', 14) + '<span>' + esc(bk.error || '') + '</span></div>';
  }

  function loadTimes() {
    var s = bk.service, d = dates[bk.dateIdx], my = ++bk.seq;
    bk.time = null; bk.times = [];
    if (closedOn(d)) { bk.loading = false; renderBooking(); return; }
    bk.loading = true; renderBooking();
    fetch('/car_washes/' + CW.id + '/available_times?date=' + ymd(d) + '&service_id=' + s.id + '&duration=' + (s.duration || 30), { credentials: 'same-origin', headers: { Accept: 'application/json' } })
      .then(function (r) { return r.ok ? r.json() : []; })
      .catch(function () { return []; })
      .then(function (list) {
        if (my !== bk.seq) return; // trocou de dia no meio do caminho
        bk.times = Array.isArray(list) ? list : []; bk.loading = false; renderBooking();
      });
  }

  function cta() {
    if (bk.step === 1) {
      if (!bk.time) return;
      bk.step = 2; bk.error = null;
      history.pushState({ v: 'book', svc: bk.service.id, step: 2 }, '', '#agendar-' + bk.service.id);
      window.scrollTo(0, 0);
      renderBooking();
      return;
    }
    if (bk.submitting) return;
    if (comSinal() && !RULES.has_card) { location.href = cardUrl(); return; }
    bk.submitting = true; bk.error = null; renderBooking();
    fetch('/car_washes/' + CW.id + '/appointments', {
      method: 'POST', credentials: 'same-origin',
      headers: { Accept: 'application/json', 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
      body: JSON.stringify({ appointment: { car_wash_id: CW.id, service_id: bk.service.id, date: ymd(dates[bk.dateIdx]), time: bk.time } })
    }).then(function (r) { return r.json().catch(function () { return {}; }).then(function (data) { return { ok: r.ok, data: data }; }); })
      .then(function (res) {
        if (res.data.code === 'card_required') { location.href = cardUrl(); return; }
        if (res.data.requires_action) {
          return confirmarSinal(res.data).then(function (ok) {
            bk.submitting = false;
            if (ok) { renderDone(ok.deposit); return; }
            renderBooking();
          });
        }
        bk.submitting = false;
        if (res.ok) { renderDone(res.data.deposit); return; }
        bk.error = res.data.error || 'Não foi possível agendar.';
        renderBooking();
      })
      .catch(function () { bk.submitting = false; bk.error = 'Erro de conexão.'; renderBooking(); });
  }

  // Banco pediu confirmação do sinal (3DS): a janela do banco abre aqui mesmo;
  // depois o servidor confere com o Stripe — o navegador não é confiado.
  function confirmarSinal(dd) {
    if (!window.Stripe || !STRIPE_PK) { bk.error = 'Não foi possível abrir a confirmação do banco. Tente de novo.'; return Promise.resolve(null); }
    return Stripe(STRIPE_PK).handleNextAction({ clientSecret: dd.client_secret }).then(function (r) {
      if (r.error) { bk.error = 'O banco não confirmou o sinal. Nada foi cobrado.'; return null; }
      return fetch('/appointments/' + dd.appointment_id + '/authorized', {
        method: 'POST', credentials: 'same-origin', headers: { Accept: 'application/json', 'X-CSRF-Token': CSRF }
      }).then(function (x) { return x.json().catch(function () { return {}; }).then(function (b) {
        if (x.ok && b.ok) return b;
        bk.error = b.error || 'Não foi possível concluir o agendamento.'; return null;
      }); });
    }).catch(function () { bk.error = 'A confirmação do banco foi interrompida. Nada foi cobrado.'; return null; });
  }

  function renderDone(deposit) {
    var s = bk.service, d = dates[bk.dateIdx];
    $('cw-done').innerHTML = '<div class="ok">' +
      '<div class="ok-check">' + icon('check', 52, { 'stroke-width': 3 }) + '</div>' +
      '<h1 class="ok-title">Agendado.<em>Seu carro te agradece.</em></h1>' +
      '<div class="ok-card"><div class="ok-top"><div><div class="ok-lab">QUANDO</div><div class="ok-when">' + dayLabel(d) + ', ' + d.getDate() + ' ' + MONTHS[d.getMonth()] + ' · ' + esc(bk.time) + '</div></div>' +
        '<span class="ok-cal">' + icon('calendar', 22) + '</span></div>' +
        '<div class="ok-div"></div>' +
        '<div class="ok-shop"><div class="ok-logo">' + LoovLogos.logoOf(CW) + '</div>' +
          '<div class="ok-shop-t"><b>' + esc(CW.name) + '</b><small>' + esc(s.title) + ' · ' + (s.duration || 30) + 'min</small></div>' +
          '<div class="ok-price">R$' + money(s.price) + '</div></div>' +
        (deposit ? '<div class="ok-div"></div><p class="ok-deposit">Sinal de R$ ' + money(deposit, 2) + ' pago no cartão. O restante, R$ ' +
          money(Math.max(0, Number(s.price) - deposit), 2) + ', você paga no lava-rápido.</p>' : '') +
      '</div>' +
      '<div class="ok-actions"><a class="ok-primary" href="/appointments">Ver meus agendamentos</a><a class="ok-ghost" href="/' + COORDS_QS + '">Voltar pra home</a></div>' +
    '</div>';
    history.replaceState({ v: 'done' }, '', '#agendado');
    showView('done');
  }

  // Voltar: um passo de cada vez, como no app.
  window.addEventListener('popstate', function (e) {
    var st = e.state || {};
    if ($('cw-done').classList.contains('is-on') || st.v !== 'book') { bk.step = 1; showView('detail'); return; }
    bk.step = st.step || 1; bk.error = null;
    if (!$('cw-book').classList.contains('is-on')) showView('book');
    renderBooking();
  });

  function openLogin() { var s = $('cw-login'); s.classList.add('is-on'); s.setAttribute('aria-hidden', 'false'); }
  function closeLogin() { var s = $('cw-login'); s.classList.remove('is-on'); s.setAttribute('aria-hidden', 'true'); }

  document.addEventListener('click', function (e) {
    var t;
    if ((t = e.target.closest('.cw-seg button'))) { setTab(t.dataset.tab); return; }
    if ((t = e.target.closest('[data-svc]'))) { openBooking(t.dataset.svc, true); return; }
    if (e.target.closest('#cw-fav')) { toggleFav(); return; }
    if ((t = e.target.closest('[data-day]'))) { var i = Number(t.dataset.day); if (i !== bk.dateIdx) { bk.dateIdx = i; loadTimes(); } return; }
    if ((t = e.target.closest('button[data-time]'))) { bk.time = t.dataset.time; renderBooking(); return; }
    if (e.target.closest('[data-edit-when]') || e.target.closest('#bk-back')) { history.back(); return; }
    if (e.target.closest('#bk-cta')) { cta(); return; }
    if (e.target.id === 'cw-login') { closeLogin(); return; }
  });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeLogin(); });
  // Voltar da capa: se veio de dentro do site, volta de verdade (mantém a
  // rolagem da lista); senão vai pra home.
  $('cw-back').addEventListener('click', function (e) {
    if (document.referrer && document.referrer.indexOf(location.origin) === 0 && history.length > 1) { e.preventDefault(); history.back(); }
  });
  window.addEventListener('resize', function () { mountMap('cw-map-aside'); Object.keys(maps).forEach(function (k) { maps[k].invalidateSize(); }); });

  function boot() {
    if (window.feather) feather.replace();
    renderStats(); renderServices(); renderReviews(); renderAbout(); renderFav();
    // Link direto pra #agendar-ID (ou recarregar no meio do agendamento).
    var m = location.hash.match(/^#agendar-(\d+)/);
    history.replaceState({ v: 'detail' }, '', location.pathname + location.search);
    if (m && IS_CLIENT && svcById(m[1])) openBooking(m[1], true);
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot); else boot();
})();
</script>
