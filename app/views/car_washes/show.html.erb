<% Rails.logger.info("Iniciando renderização do template car_washes/show.html.erb") %>

<div id="loov-cursor"></div>
<div id="loov-cursor-trail"></div>
<div id="page-transition"></div>

<%
reviews          = @car_wash.reviews.includes(:user).order(created_at: :desc)
avg_rating       = reviews.any? ? reviews.average(:rating).to_f.round(1) : nil
review_count     = reviews.count
counts_by_star   = (1..5).map { |s| [s, reviews.where(rating: s).count] }.to_h
today_dow        = Date.current.wday
is_open          = @car_wash.operating_hours.exists?(day_of_week: today_dow)
opens_today      = @car_wash.operating_hours.find_by(day_of_week: today_dow)
categories       = @car_wash.services.where.not(category: [nil, '']).pluck(:category).uniq
is_client        = user_signed_in? && current_user.client?
is_owner_manage  = user_signed_in? && current_user.owner? && @car_wash.user == current_user
%>

<style>
  :root {
    --lime: #afff2d;
    --lime-dim: #8fcc24;
    --black: #000;
    --surface: #0a0a0a;
    --surface-2: #0d0d0d;
    --surface-3: #131313;
    --surface-4: #181818;
    --border: #1a1a1a;
    --border-soft: #222;
    --text-muted: #444;
    --text-secondary: #777;
    --white: #fff;
  }

  #loov-cursor { position:fixed;width:8px;height:8px;background:var(--lime);border-radius:50%;pointer-events:none;z-index:999999;transform:translate(-50%,-50%);transition:width .18s ease,height .18s ease;mix-blend-mode:difference; }
  #loov-cursor-trail { position:fixed;width:38px;height:38px;border:1px solid rgba(175,255,45,0.25);border-radius:50%;pointer-events:none;z-index:999998;transform:translate(-50%,-50%);transition:width .25s ease,height .25s ease,border-color .25s ease; }
  body.cursor-hover #loov-cursor { width:14px;height:14px; }
  body.cursor-hover #loov-cursor-trail { width:58px;height:58px;border-color:rgba(175,255,45,0.45); }
  @media(hover:none){#loov-cursor,#loov-cursor-trail{display:none;}}

  #page-transition { position:fixed;inset:0;z-index:10000;background:#000;transform:translateY(100%);pointer-events:none; }
  #page-transition.enter { animation:pgEnter .42s cubic-bezier(.76,0,.24,1) forwards; }
  #page-transition.exit  { animation:pgExit  .42s cubic-bezier(.76,0,.24,1) forwards; }
  @keyframes pgEnter { from{transform:translateY(100%)}to{transform:translateY(0)} }
  @keyframes pgExit  { from{transform:translateY(0)}to{transform:translateY(-100%)} }

  * { box-sizing: border-box; }
  body { cursor: none; }

  .show-wrap { min-height:100vh;background:var(--black);font-family:'DM Sans',sans-serif;padding-top:60px;padding-bottom:4rem; }

  #cart-pill {
    position: fixed; top: 68px; right: 1.5rem; z-index: 200;
    display: none; align-items: center; gap: .625rem;
    background: var(--lime); color: #000; border-radius: 100px;
    padding: .4rem .875rem .4rem .5rem;
    font-family: 'DM Sans', sans-serif; font-size: .8rem; font-weight: 700;
    box-shadow: 0 4px 20px rgba(175,255,45,0.3); cursor: pointer;
    animation: pillIn .35s cubic-bezier(.16,1,.3,1) forwards;
  }
  #cart-pill.visible { display: flex; }
  #cart-pill-icon { width:26px;height:26px;border-radius:50%;background:rgba(0,0,0,.15);display:flex;align-items:center;justify-content:center;font-size:.7rem; }
  @keyframes pillIn { from{opacity:0;transform:translateY(-8px) scale(.95)}to{opacity:1;transform:translateY(0) scale(1)} }

  .show-back { max-width:1440px;margin:0 auto;padding:1.75rem 1.5rem 0;opacity:0;animation:revealUp .6s cubic-bezier(.16,1,.3,1) forwards .05s; }
  .show-back a { display:inline-flex;align-items:center;gap:.45rem;font-size:.8rem;color:var(--text-muted);text-decoration:none;transition:color .2s;cursor:none; }
  .show-back a:hover { color:var(--lime); }

  .show-hero { max-width:1440px;margin:0 auto;padding:1.5rem 1.5rem 1.5rem;display:flex;align-items:flex-end;justify-content:space-between;gap:2rem;opacity:0;animation:revealUp .8s cubic-bezier(.16,1,.3,1) forwards .1s; }
  .show-hero-left { flex:1; }
  .show-eyebrow { display:inline-flex;align-items:center;gap:.5rem;font-size:.65rem;font-weight:500;letter-spacing:.22em;text-transform:uppercase;color:var(--lime);margin-bottom:.75rem; }
  .show-eyebrow::before { content:'';display:block;width:20px;height:1px;background:var(--lime); }
  .show-avatar { width:52px;height:52px;border-radius:12px;background:linear-gradient(135deg,#141414,#1e1e1e);border:1px solid rgba(175,255,45,0.15);display:flex;align-items:center;justify-content:center;font-family:'Bebas Neue',sans-serif;font-size:1.125rem;color:var(--lime);margin-bottom:1rem; }
  .show-name { font-family:'Bebas Neue',sans-serif;font-size:clamp(2rem,6vw,4rem);line-height:.92;color:var(--white);margin:0 0 .875rem; }
  .show-meta { display:flex;flex-direction:column;gap:.4rem; }
  .show-meta-item { display:flex;align-items:center;gap:.5rem;font-size:.875rem;color:var(--text-muted); }
  .show-meta-item i { color:var(--lime);font-size:.65rem;width:14px;flex-shrink:0; }
  .show-meta-item strong { color:var(--white); }

  .show-hero-actions { display:flex;gap:.625rem;flex-shrink:0;align-items:flex-start; }
  .btn-show { display:inline-flex;align-items:center;gap:.45rem;padding:.75rem 1.5rem;border-radius:100px;font-family:'DM Sans',sans-serif;font-size:.875rem;font-weight:500;text-decoration:none;transition:all .22s;border:none;cursor:none;white-space:nowrap; }
  .btn-lime { background:var(--lime);color:#000; }
  .btn-lime:hover { background:var(--lime-dim);transform:translateY(-2px);box-shadow:0 10px 28px rgba(175,255,45,.2); }
  .btn-ghost { background:transparent;color:var(--white);border:1px solid var(--border-soft); }
  .btn-ghost:hover { border-color:var(--lime);color:var(--lime);transform:translateY(-2px); }

  .show-divider { max-width:1440px;margin:0 auto;padding:0 1.5rem; }
  .show-divider-line { height:1px;background:var(--border); }

  .show-layout { max-width:1440px;margin:0 auto;padding:2rem 1.5rem 0;display:grid;grid-template-columns:1fr 380px;gap:2rem;align-items:start; }

  .show-left { display:flex;flex-direction:column;gap:1.5rem; }

  .cat-tabs { display:flex;gap:.375rem;flex-wrap:wrap; }
  .cat-tab { padding:.375rem .875rem;border-radius:100px;font-size:.775rem;font-weight:500;cursor:none;border:1px solid var(--border);background:var(--surface-3);color:var(--text-muted);transition:all .18s; }
  .cat-tab:hover { border-color:rgba(175,255,45,.25);color:var(--white); }
  .cat-tab.active { background:var(--lime);color:#000;border-color:var(--lime); }

  .services-grid { display:flex;flex-direction:column;gap:.625rem; }
  .svc-card { display:flex;align-items:center;padding:1.125rem 1.25rem;background:var(--surface-3);border:1px solid var(--border);border-radius:14px;cursor:none;transition:all .18s;gap:1rem;position:relative;overflow:hidden; }
  .svc-card::before { content:'';position:absolute;left:0;top:0;bottom:0;width:2px;background:var(--lime);transform:scaleY(0);transform-origin:bottom;transition:transform .25s cubic-bezier(.16,1,.3,1); }
  .svc-card:hover { border-color:rgba(175,255,45,.2);background:var(--surface-4); }
  .svc-card:hover::before { transform:scaleY(1); }
  .svc-card.selected { border-color:rgba(175,255,45,.4);background:rgba(175,255,45,.04); }
  .svc-card.selected::before { transform:scaleY(1); }
  .svc-card-left { flex:1;min-width:0; }
  .svc-card-name { font-size:.9375rem;font-weight:600;color:var(--white);margin-bottom:.2rem; }
  .svc-card-desc { font-size:.78rem;color:var(--text-muted);line-height:1.4; }
  .svc-card-tags { display:flex;gap:.3rem;margin-top:.375rem;flex-wrap:wrap; }
  .svc-card-tag { font-size:.62rem;font-weight:600;letter-spacing:.06em;color:var(--lime);background:rgba(175,255,45,.07);border:1px solid rgba(175,255,45,.15);border-radius:100px;padding:.15rem .5rem; }
  .svc-card-right { text-align:right;flex-shrink:0; }
  .svc-card-price { font-family:'Bebas Neue',sans-serif;font-size:1.375rem;color:var(--lime);letter-spacing:.02em;line-height:1; }
  .svc-card-duration { font-size:.72rem;color:var(--text-muted);margin-top:.2rem; }
  .svc-card-select { width:32px;height:32px;border-radius:50%;border:1.5px solid var(--border-soft);background:transparent;display:flex;align-items:center;justify-content:center;color:var(--text-muted);font-size:.7rem;flex-shrink:0;transition:all .18s; }
  .svc-card:hover .svc-card-select { border-color:rgba(175,255,45,.3);color:var(--lime); }
  .svc-card.selected .svc-card-select { background:var(--lime);border-color:var(--lime);color:#000; }

  .hours-panel { background:var(--surface-3);border:1px solid var(--border);border-radius:14px;overflow:hidden; }
  .hours-panel-header { padding:.875rem 1.125rem;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:.5rem; }
  .hours-panel-title { font-family:'Bebas Neue',sans-serif;font-size:1rem;letter-spacing:.06em;color:var(--white); }
  .hours-panel-icon { color:var(--lime);font-size:.75rem; }
  .hours-list { padding:.5rem 1.125rem; }
  .hour-item { display:flex;align-items:center;justify-content:space-between;padding:.5rem 0;border-bottom:1px solid var(--border); }
  .hour-item:last-child { border-bottom:none; }
  .hour-day { font-size:.8375rem;color:var(--white); }
  .hour-time { font-size:.78rem;color:var(--text-muted); }

  .reviews-panel { background:var(--surface-3);border:1px solid var(--border);border-radius:14px;overflow:hidden; }
  .reviews-panel-header { padding:.875rem 1.125rem;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.75rem; }
  .reviews-panel-title { font-family:'Bebas Neue',sans-serif;font-size:1rem;letter-spacing:.06em;color:var(--white);display:flex;align-items:center;gap:.5rem; }
  .reviews-panel-icon { color:var(--lime);font-size:.75rem; }
  .reviews-summary { display:flex;align-items:center;gap:1rem; }
  .reviews-avg { font-family:'Bebas Neue',sans-serif;font-size:2.25rem;color:var(--lime);line-height:1;letter-spacing:.02em; }
  .reviews-avg-meta { display:flex;flex-direction:column;gap:2px; }
  .reviews-stars { color:var(--lime);font-size:.75rem;letter-spacing:.04em; }
  .reviews-count { font-size:.7rem;color:var(--text-muted); }
  .rating-bars { display:flex;flex-direction:column;gap:4px;min-width:130px; }
  .rating-bar-row { display:flex;align-items:center;gap:6px;font-size:.65rem;color:var(--text-muted); }
  .rating-bar-track { flex:1;height:3px;background:var(--surface-2);border-radius:99px;overflow:hidden; }
  .rating-bar-fill { height:100%;background:var(--lime);border-radius:99px; }
  .rating-bar-ct { min-width:12px;text-align:right; }
  .reviews-body { padding:1rem 1.125rem; }
  .reviews-grid { display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:.875rem; }
  .review-card { background:var(--surface-4);border:1px solid var(--border);border-radius:12px;padding:1rem;display:flex;flex-direction:column;gap:.625rem; }
  .review-card:hover { border-color:var(--border-soft); }
  .review-top { display:flex;align-items:center;justify-content:space-between; }
  .review-user { display:flex;align-items:center;gap:.5rem; }
  .review-avatar { width:30px;height:30px;border-radius:50%;background:linear-gradient(135deg,#141414,#222);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-family:'Bebas Neue',sans-serif;font-size:.8rem;color:var(--lime);flex-shrink:0; }
  .review-user-name { font-size:.8375rem;font-weight:500;color:var(--white); }
  .review-date { font-size:.68rem;color:var(--text-muted); }
  .review-stars { display:flex;gap:2px; }
  .review-star { font-size:.7rem;color:var(--border); }
  .review-star.filled { color:var(--lime); }
  .review-tags { display:flex;flex-wrap:wrap;gap:.3rem; }
  .review-tag { font-size:.62rem;font-weight:500;color:var(--lime);background:rgba(175,255,45,.07);border:1px solid rgba(175,255,45,.15);border-radius:100px;padding:.15rem .5rem; }
  .review-comment { font-size:.8375rem;color:var(--text-secondary);line-height:1.6;font-style:italic; }
  .review-comment::before { content:'"';color:var(--lime);font-style:normal; }
  .review-comment::after  { content:'"';color:var(--lime);font-style:normal; }
  .reviews-empty { text-align:center;padding:2rem 0;display:flex;flex-direction:column;align-items:center;gap:.625rem; }
  .reviews-empty-icon { width:44px;height:44px;border-radius:12px;background:var(--surface-4);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:1rem;color:#222; }
  .reviews-empty-title { font-family:'Bebas Neue',sans-serif;font-size:1rem;color:var(--white); }
  .reviews-empty-sub { font-size:.78rem;color:var(--text-muted); }

  .booking-panel { position:sticky;top:76px;background:var(--surface-2);border:1px solid var(--border);border-radius:20px;overflow:hidden;opacity:0;animation:revealUp .8s cubic-bezier(.16,1,.3,1) forwards .2s; }
  .booking-panel-header { padding:1.25rem 1.5rem 1rem;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:.5rem; }
  .booking-panel-title { font-family:'Bebas Neue',sans-serif;font-size:1.125rem;letter-spacing:.06em;color:var(--white); }
  .booking-panel-icon { color:var(--lime);font-size:.8rem; }
  .booking-panel-body { padding:1.25rem 1.5rem; }

  .booking-empty { text-align:center;padding:2.5rem 1rem;display:flex;flex-direction:column;align-items:center;gap:.75rem; }
  .booking-empty-icon { width:52px;height:52px;border-radius:14px;background:var(--surface-3);border:2px dashed var(--border);display:flex;align-items:center;justify-content:center;font-size:1.25rem;color:#1e1e1e; }
  .booking-empty-title { font-family:'Bebas Neue',sans-serif;font-size:1rem;color:var(--white); }
  .booking-empty-sub { font-size:.78rem;color:var(--text-muted);line-height:1.5;max-width:200px; }

  .booking-svc-row { display:flex;align-items:flex-start;justify-content:space-between;gap:.75rem;padding:.875rem;background:var(--surface-3);border:1px solid rgba(175,255,45,.2);border-radius:12px;margin-bottom:1.25rem; }
  .booking-svc-name { font-size:.9375rem;font-weight:600;color:var(--white);margin-bottom:.15rem; }
  .booking-svc-dur  { font-size:.75rem;color:var(--text-muted); }
  .booking-svc-price { font-family:'Bebas Neue',sans-serif;font-size:1.5rem;color:var(--lime);letter-spacing:.02em;flex-shrink:0; }

  .booking-field { margin-bottom:1rem; }
  .booking-label { font-size:.65rem;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:rgba(175,255,45,.45);margin-bottom:.5rem;display:block; }

  .booking-input,
  .flatpickr-input.form-control.input { display:none; }
  .flatpickr-input.flatpickr-mobile { display:none; }

  #bk-date-alt {
    width: 100%; background: var(--surface-3); border: 1px solid var(--border);
    border-radius: 10px; padding: .75rem 1rem;
    font-family:'DM Sans',sans-serif; font-size:.875rem;
    color: var(--white); outline: none; transition: border-color .2s; cursor: none;
    appearance: none; -webkit-appearance: none;
  }
  #bk-date-alt:focus { border-color: var(--lime); }
  #bk-date-alt::placeholder { color:var(--text-muted); }

  .time-grid { display:grid;grid-template-columns:repeat(4,1fr);gap:.375rem;margin-bottom:1.25rem; }
  .time-slot { padding:.5rem .25rem;border-radius:8px;border:1px solid var(--border);background:var(--surface-3);font-family:'DM Sans',sans-serif;font-size:.78rem;color:var(--text-secondary);cursor:none;transition:all .15s;text-align:center; }
  .time-slot:hover:not(.disponivel-only) { border-color:rgba(175,255,45,.25);color:var(--white); }
  .time-slot.selected { background:var(--lime);border-color:var(--lime);color:#000;font-weight:600; }

  /* ── SLOT BLOQUEADO — só pelo Disponível ── */
  .time-slot.disponivel-only {
    background: transparent;
    border: 1px dashed rgba(175,255,45,.12);
    color: #2a2a2a;
    cursor: not-allowed;
    font-size: .68rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: .35rem .125rem;
  }
  .disp-tag-mini {
    display: flex;
    align-items: center;
    gap: 2px;
    font-size: .52rem;
    color: rgba(175,255,45,.35);
    font-weight: 700;
  }

  /* ── BANNER DISPONÍVEL ── */
  .disp-lock-banner {
    display: none;
    align-items: flex-start;
    gap: .625rem;
    background: rgba(175,255,45,.04);
    border: 1px solid rgba(175,255,45,.12);
    border-radius: 10px;
    padding: .625rem .875rem;
    font-size: .75rem;
    color: #666;
    line-height: 1.5;
    margin-bottom: .875rem;
  }
  .disp-lock-banner i { color: var(--lime); margin-top: 2px; flex-shrink: 0; }
  .disp-lock-banner a { color: var(--lime); font-weight: 700; text-decoration: none; }
  .disp-lock-banner a:hover { text-decoration: underline; }

  .booking-summary { border-top:1px solid var(--border);padding-top:1rem;margin-top:1rem;display:flex;flex-direction:column;gap:.5rem;margin-bottom:1rem; }
  .booking-summary-row { display:flex;justify-content:space-between;align-items:center;font-size:.8125rem; }
  .booking-summary-label { color:var(--text-muted); }
  .booking-summary-val { color:var(--white); }
  .booking-total-row { display:flex;justify-content:space-between;align-items:flex-end; }
  .booking-total-label { font-size:.72rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:.1em; }
  .booking-total-val { font-family:'Bebas Neue',sans-serif;font-size:2rem;color:var(--lime);letter-spacing:.02em;line-height:1; }

  .btn-confirm { width:100%;background:var(--lime);color:#000;border:none;border-radius:100px;padding:.9375rem;font-family:'DM Sans',sans-serif;font-size:.9375rem;font-weight:700;cursor:pointer;transition:all .22s;display:flex;align-items:center;justify-content:center;gap:.5rem; }
  .btn-confirm:hover:not(:disabled) { background:var(--lime-dim);transform:translateY(-2px);box-shadow:0 10px 28px rgba(175,255,45,.2); }
  .btn-confirm:disabled { opacity:.35;cursor:not-allowed;transform:none;box-shadow:none;pointer-events:none; }

  .booking-note { font-size:.72rem;color:var(--text-muted);text-align:center;line-height:1.5;margin-top:.75rem; }
  .booking-note i { color:var(--lime);font-size:.65rem; }

  .booking-nudge { text-align:center;padding:1.5rem 1rem; }
  .booking-nudge-text { font-size:.875rem;color:var(--text-muted);margin-bottom:1rem;line-height:1.55; }
  .booking-nudge-text strong { color:var(--white); }

  .flatpickr-calendar { background:#111!important;border:1px solid #222!important;border-radius:14px!important;box-shadow:0 16px 40px rgba(0,0,0,.8)!important;font-family:'DM Sans',sans-serif!important; }
  .flatpickr-day { color:#aaa!important;border-radius:8px!important; }
  .flatpickr-day.selected,.flatpickr-day.selected:hover { background:#afff2d!important;border-color:#afff2d!important;color:#000!important; }
  .flatpickr-day:hover:not(.flatpickr-disabled):not(.day-closed):not(.day-no-hours) { background:#1a1a1a!important;color:#fff!important; }
  .flatpickr-day.flatpickr-disabled { color:#1e1e1e!important;pointer-events:none!important; }
  .flatpickr-day.prevMonthDay,.flatpickr-day.nextMonthDay { color:#333!important;pointer-events:none!important; }
  .flatpickr-months { background:#111!important;border-radius:14px 14px 0 0!important; }
  .flatpickr-current-month,.flatpickr-monthDropdown-months { color:#fff!important; }
  .flatpickr-weekday { color:#555!important; }
  .flatpickr-prev-month svg,.flatpickr-next-month svg { fill:#555!important; }
  .flatpickr-prev-month:hover svg,.flatpickr-next-month:hover svg { fill:#afff2d!important; }
  .flatpickr-input { caret-color: transparent; }
  .flatpickr-day.day-no-hours { color:#1e1e1e!important;pointer-events:none!important;cursor:not-allowed!important; }
  .flatpickr-day.day-closed { color:rgba(248,113,113,0.4)!important;background:rgba(239,68,68,0.05)!important;border-color:rgba(239,68,68,0.15)!important;text-decoration:line-through!important;pointer-events:none!important;cursor:not-allowed!important; }

  .mobile-cta { display:none;position:fixed;bottom:0;left:0;right:0;z-index:50;padding:12px 20px;background:rgba(0,0,0,0.94);backdrop-filter:blur(20px);border-top:1px solid var(--border); }
  .mobile-cta-inner { display:flex;align-items:center;justify-content:space-between;gap:1rem;max-width:640px;margin:0 auto; }
  .mobile-cta-info { display:flex;flex-direction:column;gap:2px; }
  .mobile-cta-label { font-size:.62rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:.1em; }
  .mobile-cta-name { font-family:'Bebas Neue',sans-serif;font-size:1rem;color:var(--white);letter-spacing:.03em;line-height:1; }
  .mobile-cta-btn { display:inline-flex;align-items:center;gap:.5rem;background:var(--lime);color:#000;border:none;border-radius:100px;padding:.75rem 1.5rem;font-family:'DM Sans',sans-serif;font-size:.875rem;font-weight:600;text-decoration:none;cursor:none;transition:background .2s;white-space:nowrap;flex-shrink:0; }
  .mobile-cta-btn:hover { background:var(--lime-dim); }

  @keyframes revealUp { from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)} }

  @media(max-width:960px) {
    .show-layout { grid-template-columns:1fr; }
    .show-right { display:none; }
    .mobile-cta { display:block; }
    .show-wrap { padding-bottom:80px; }
    #cart-pill { display:none!important; }
    .rating-bars { display:none; }
    .reviews-grid { grid-template-columns:1fr; }
  }
  @media(max-width:640px) {
    .show-back,.show-hero,.show-divider,.show-layout { padding-left:1.125rem;padding-right:1.125rem; }
    .show-hero { flex-direction:column;gap:1rem; }
    .show-hero-actions { flex-direction:row;flex-wrap:wrap; }
  }
</style>

<% if is_client %>
<div id="cart-pill" onclick="scrollToBooking()">
  <div id="cart-pill-icon"><i class="fas fa-calendar-check"></i></div>
  <span id="cart-pill-label">Agendar</span>
</div>
<% end %>

<div class="show-wrap">
  <div class="show-back">
    <%= link_to :back do %><i class="fas fa-arrow-left"></i> Voltar<% end %>
  </div>

  <div class="show-hero">
    <div class="show-hero-left">
      <div class="show-eyebrow">Lava-rápido</div>
      <div class="show-avatar"><%= @car_wash.name.first(2).upcase %></div>
      <h1 class="show-name"><%= @car_wash.name %></h1>
      <div class="show-meta">
        <div class="show-meta-item">
          <i class="fas fa-location-dot"></i>
          <span><%= @car_wash.address || "Endereço não informado" %></span>
        </div>
        <% if avg_rating %>
        <div class="show-meta-item">
          <i class="fas fa-star"></i>
          <strong><%= sprintf('%.1f', avg_rating) %></strong>
          <span>(<%= review_count %> <%= review_count == 1 ? 'avaliação' : 'avaliações' %>)</span>
        </div>
        <% end %>
        <div class="show-meta-item">
          <% if is_open %>
          <i class="fas fa-circle" style="color:var(--lime);font-size:.5rem;"></i>
          <strong style="color:var(--lime);">Aberto agora</strong>
          <% if opens_today %><span>· até <%= opens_today.closes_at.strftime("%H:%M") %></span><% end %>
          <% elsif opens_today %>
          <i class="fas fa-circle" style="color:#333;font-size:.5rem;"></i>
          <span>Abre às <%= opens_today.opens_at.strftime("%H:%M") %></span>
          <% else %>
          <i class="fas fa-circle" style="color:#333;font-size:.5rem;"></i>
          <span>Fechado hoje</span>
          <% end %>
        </div>
      </div>
    </div>
    <div class="show-hero-actions">
      <% if is_owner_manage %>
      <%= link_to manage_car_wash_path(@car_wash), class: "btn-show btn-ghost" do %>
      <i class="fas fa-gear"></i> Gerenciar
      <% end %>
      <% end %>
    </div>
  </div>

  <div class="show-divider"><div class="show-divider-line"></div></div>

  <div class="show-layout">
    <div class="show-left">
      <% if @car_wash.services.any? %>
      <div>
        <% if categories.any? %>
        <div class="cat-tabs" style="margin-bottom:1rem;">
          <button class="cat-tab active" data-cat="all">Todos</button>
          <% categories.each do |cat| %>
          <button class="cat-tab" data-cat="<%= cat %>"><%= cat %></button>
          <% end %>
        </div>
        <% end %>
        <div class="services-grid" id="services-grid">
          <% @car_wash.services.each do |service| %>
          <div class="svc-card"
            data-cat="<%= service.category %>"
            data-id="<%= service.id %>"
            data-title="<%= j service.title %>"
            data-price="<%= service.price.to_f %>"
            data-duration="<%= service.duration %>"
            onclick="selectService(this)">
            <div class="svc-card-left">
              <div class="svc-card-name"><%= service.title %></div>
              <% if service.description.present? %>
              <div class="svc-card-desc"><%= service.description %></div>
              <% end %>
              <% if service.category.present? %>
              <div class="svc-card-tags">
                <span class="svc-card-tag"><%= service.category %></span>
                <span class="svc-card-tag"><%= service.duration %> min</span>
              </div>
              <% end %>
            </div>
            <div class="svc-card-right">
              <div class="svc-card-price">R$ <%= number_with_precision(service.price, precision: 0) %></div>
              <div class="svc-card-duration"><%= service.duration %> min</div>
            </div>
            <div class="svc-card-select"><i class="fas fa-plus"></i></div>
          </div>
          <% end %>
        </div>
      </div>
      <% end %>

      <div class="hours-panel">
        <div class="hours-panel-header">
          <i class="fas fa-clock hours-panel-icon"></i>
          <span class="hours-panel-title">Horários de Funcionamento</span>
        </div>
        <div class="hours-list">
          <% if @car_wash.operating_hours.any? %>
          <% @car_wash.operating_hours.order(Arel.sql("CASE day_of_week WHEN 0 THEN 7 ELSE day_of_week END")).each do |hour| %>
          <% day_name = %w[Domingo Segunda Terça Quarta Quinta Sexta Sábado][hour.day_of_week] %>
          <% is_today_h = hour.day_of_week == today_dow %>
          <div class="hour-item">
            <span class="hour-day" style="<%= is_today_h ? 'color:var(--lime);' : '' %>"><%= day_name %></span>
            <span class="hour-time" style="<%= is_today_h ? 'color:var(--white);' : '' %>"><%= hour.opens_at.strftime("%H:%M") %> – <%= hour.closes_at.strftime("%H:%M") %></span>
          </div>
          <% end %>
          <% else %>
          <p style="font-size:.875rem;color:var(--text-muted);padding:.5rem 0;">Horários não informados.</p>
          <% end %>
        </div>
      </div>

      <div class="reviews-panel">
        <div class="reviews-panel-header">
          <div class="reviews-panel-title">
            <i class="fas fa-star reviews-panel-icon"></i> Avaliações
          </div>
          <% if avg_rating %>
          <div class="reviews-summary">
            <div>
              <div class="reviews-avg"><%= sprintf('%.1f', avg_rating) %></div>
              <div class="reviews-avg-meta">
                <div class="reviews-stars"><% 5.times do |i| %><%= i < avg_rating.round ? '★' : '☆' %><% end %></div>
                <div class="reviews-count"><%= review_count %> <%= review_count == 1 ? 'avaliação' : 'avaliações' %></div>
              </div>
            </div>
            <div class="rating-bars">
              <% [5,4,3,2,1].each do |star| %>
              <% count = counts_by_star[star] || 0 %>
              <% pct = review_count > 0 ? (count.to_f / review_count * 100).round : 0 %>
              <div class="rating-bar-row">
                <span><%= star %>★</span>
                <div class="rating-bar-track"><div class="rating-bar-fill" style="width:<%= pct %>%"></div></div>
                <span class="rating-bar-ct"><%= count %></span>
              </div>
              <% end %>
            </div>
          </div>
          <% end %>
        </div>
        <div class="reviews-body">
          <% if reviews.any? %>
          <div class="reviews-grid">
            <% reviews.each do |review| %>
            <div class="review-card">
              <div class="review-top">
                <div class="review-user">
                  <div class="review-avatar"><%= review.user.display_name.first.upcase %></div>
                  <div>
                    <div class="review-user-name"><%= review.user.display_name.split(' ').first %></div>
                    <div class="review-date"><%= review.created_at.strftime("%d/%m/%Y") %></div>
                  </div>
                </div>
                <div class="review-stars">
                  <% 5.times do |i| %><span class="review-star <%= i < review.rating ? 'filled' : '' %>">★</span><% end %>
                </div>
              </div>
              <% if review.tags_list.any? %>
              <div class="review-tags"><% review.tags_list.each do |tag| %><span class="review-tag"><%= tag %></span><% end %></div>
              <% end %>
              <% if review.comment.present? %>
              <div class="review-comment"><%= review.comment %></div>
              <% end %>
            </div>
            <% end %>
          </div>
          <% else %>
          <div class="reviews-empty">
            <div class="reviews-empty-icon"><i class="fas fa-star"></i></div>
            <div class="reviews-empty-title">Nenhuma avaliação ainda</div>
            <div class="reviews-empty-sub">Seja o primeiro a avaliar.</div>
          </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="show-right" id="booking-panel-wrap">
      <div class="booking-panel" id="booking-panel">
        <div class="booking-panel-header">
          <i class="fas fa-calendar-check booking-panel-icon"></i>
          <span class="booking-panel-title">Agendar</span>
        </div>
        <div class="booking-panel-body">
          <% if is_client %>
          <div id="booking-empty" class="booking-empty">
            <div class="booking-empty-icon"><i class="fas fa-hand-pointer"></i></div>
            <div class="booking-empty-title">Selecione um serviço</div>
            <div class="booking-empty-sub">Clique em qualquer serviço ao lado para iniciar o agendamento.</div>
          </div>

          <div id="booking-selected" style="display:none;">
            <div class="booking-svc-row">
              <div>
                <div class="booking-svc-name" id="bk-svc-name">—</div>
                <div class="booking-svc-dur"  id="bk-svc-dur">—</div>
              </div>
              <div class="booking-svc-price" id="bk-svc-price">—</div>
            </div>

            <div class="booking-field">
              <label class="booking-label" for="bk-date-alt">Data</label>
              <input type="text" id="bk-date-alt" placeholder="DD/MM/AAAA" readonly />
            </div>

            <div class="booking-field">
              <label class="booking-label">Horário</label>
              <div id="time-loading" style="display:none;font-size:.78rem;color:var(--text-muted);padding:.25rem 0;">
                <i class="fas fa-circle-notch fa-spin" style="color:var(--lime);margin-right:.3rem;"></i> Carregando...
              </div>
              <div id="time-empty" style="display:none;font-size:.78rem;color:var(--text-muted);padding:.25rem 0;">
                Nenhum horário disponível para esta data.
              </div>
              <%# Banner aparece quando há slots bloqueados pela janela de 45min %>
              <div class="disp-lock-banner" id="disp-lock-banner">
                <i class="fas fa-bolt"></i>
                <span>Horários em breve só pelo <a href="<%= disponivel_index_path(latitude: params[:latitude], longitude: params[:longitude]) %>">Disponível</a> — pagamento antecipado, entrada garantida.</span>
              </div>
              <div class="time-grid" id="time-grid"></div>
            </div>

            <div class="booking-summary" id="bk-summary" style="display:none;">
              <div class="booking-summary-row">
                <span class="booking-summary-label">Serviço</span>
                <span class="booking-summary-val" id="bk-sum-svc">—</span>
              </div>
              <div class="booking-summary-row">
                <span class="booking-summary-label">Data</span>
                <span class="booking-summary-val" id="bk-sum-date">—</span>
              </div>
              <div class="booking-summary-row">
                <span class="booking-summary-label">Horário</span>
                <span class="booking-summary-val" id="bk-sum-time">—</span>
              </div>
              <div style="height:1px;background:var(--border);margin:.25rem 0;"></div>
              <div class="booking-total-row">
                <span class="booking-total-label">Total</span>
                <span class="booking-total-val" id="bk-sum-price">—</span>
              </div>
            </div>

            <%= form_with url: appointments_path, method: :post, local: true, id: "booking-form", data: { turbo: false } do |f| %>
            <input type="hidden" name="appointment[car_wash_id]" value="<%= @car_wash.id %>">
            <input type="hidden" name="appointment[service_id]"  id="bk-service-id">
            <input type="hidden" name="appointment[date]"        id="bk-date-val">
            <input type="hidden" name="appointment[time]"        id="bk-time-val">
            <button type="submit" class="btn-confirm" id="btn-confirm" disabled>
              <i class="fas fa-calendar-check"></i> Confirmar agendamento
            </button>
            <% end %>
            <p class="booking-note"><i class="fas fa-info-circle"></i> Sem cobrança antecipada. Pague no local.</p>
          </div>

          <% else %>
          <div class="booking-nudge">
            <div class="booking-empty-icon" style="margin:0 auto 1rem;"><i class="fas fa-lock"></i></div>
            <p class="booking-nudge-text">Faça <strong>login</strong> ou <strong>crie uma conta</strong> gratuita para agendar.</p>
            <%= link_to "Entrar", new_user_session_path, class: "btn-show btn-lime", style: "margin-bottom:.5rem;display:inline-flex;width:100%;justify-content:center;" %>
            <%= link_to "Criar conta", new_user_registration_path, class: "btn-show btn-ghost", style: "display:inline-flex;width:100%;justify-content:center;" %>
          </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<% if is_client %>
<div class="mobile-cta">
  <div class="mobile-cta-inner">
    <div class="mobile-cta-info">
      <span class="mobile-cta-label">Agendar em</span>
      <span class="mobile-cta-name"><%= @car_wash.name %></span>
    </div>
    <button type="button" class="mobile-cta-btn" onclick="scrollToBooking()">
      <i class="fas fa-calendar-plus"></i> Agendar
    </button>
  </div>
</div>
<% end %>

<script>
  window.carWashId      = <%= @car_wash.id %>;
  window.operatingHours = <%= @car_wash.operating_hours.map { |oh| { day_of_week: oh.day_of_week, opens_at: oh.opens_at.hour * 60 + oh.opens_at.min, closes_at: oh.closes_at.hour * 60 + oh.closes_at.min } }.to_json.html_safe %>;
  window.capacityPerSlot = <%= @car_wash.capacity_per_slot %>;
  window.operatingDays  = <%= @car_wash.operating_hours.pluck(:day_of_week).to_json.html_safe %>;
  window.closureDates   = <%= @closures.flat_map { |c| (c.start_date..c.end_date).map { |d| d.strftime("%Y-%m-%d") } }.to_json.html_safe %>;
</script>

<script>
(function() {
  const cursor=document.getElementById('loov-cursor'),trail=document.getElementById('loov-cursor-trail');
  if(cursor&&trail){let mx=-100,my=-100,tx=-100,ty=-100;document.addEventListener('mousemove',e=>{mx=e.clientX;my=e.clientY;cursor.style.left=mx+'px';cursor.style.top=my+'px';});(function anim(){tx+=(mx-tx)*0.12;ty+=(my-ty)*0.12;trail.style.left=tx+'px';trail.style.top=ty+'px';requestAnimationFrame(anim);})();document.addEventListener('mouseover',e=>{if(e.target.closest('a,button,input,select,textarea,.svc-card,.flatpickr-day'))document.body.classList.add('cursor-hover');});document.addEventListener('mouseout',e=>{if(e.target.closest('a,button,input,select,textarea,.svc-card,.flatpickr-day'))document.body.classList.remove('cursor-hover');});document.addEventListener('mouseleave',()=>{cursor.style.opacity='0';trail.style.opacity='0';});document.addEventListener('mouseenter',()=>{cursor.style.opacity='1';trail.style.opacity='1';});}

  const pt=document.getElementById('page-transition');
  if(pt){document.addEventListener('click',e=>{const link=e.target.closest('a[href]');if(!link)return;const href=link.getAttribute('href');if(!href||href.startsWith('#')||link.target==='_blank')return;if(href.startsWith('http')&&!href.includes(window.location.hostname))return;e.preventDefault();pt.classList.add('enter');setTimeout(()=>window.location.href=href,400);});window.addEventListener('pageshow',()=>{pt.classList.remove('enter');pt.classList.add('exit');setTimeout(()=>pt.classList.remove('exit'),440);});}

  document.querySelectorAll('.cat-tab').forEach(tab=>{
    tab.addEventListener('click',()=>{
      document.querySelectorAll('.cat-tab').forEach(t=>t.classList.remove('active'));
      tab.classList.add('active');
      const cat=tab.dataset.cat;
      document.querySelectorAll('.svc-card').forEach(card=>{
        card.style.display=(cat==='all'||card.dataset.cat===cat)?'flex':'none';
      });
    });
  });

  let selectedService=null, selectedDate=null, selectedTime=null, fpInstance=null, submitLocked=false;
  const openDays=window.operatingDays||[], closureDates=window.closureDates||[];

  function dateToStr(d){var y=d.getFullYear(),m=String(d.getMonth()+1).padStart(2,'0'),day=String(d.getDate()).padStart(2,'0');return y+'-'+m+'-'+day;}

  function updateConfirmBtn(){const btn=document.getElementById('btn-confirm');if(btn)btn.disabled=!(selectedService&&selectedDate&&selectedTime);}

  function updateSummary(){
    if(!selectedService||!selectedDate||!selectedTime){document.getElementById('bk-summary').style.display='none';return;}
    const[y,m,d]=selectedDate.split('-');
    document.getElementById('bk-sum-svc').textContent=selectedService.title;
    document.getElementById('bk-sum-date').textContent=`${d}/${m}/${y}`;
    document.getElementById('bk-sum-time').textContent=selectedTime;
    document.getElementById('bk-sum-price').textContent='R$ '+selectedService.price.toFixed(0);
    document.getElementById('bk-summary').style.display='flex';
  }

  const bookingForm=document.getElementById('booking-form');
  if(bookingForm){bookingForm.addEventListener('submit',function(e){if(submitLocked){e.preventDefault();return false;}submitLocked=true;const btn=document.getElementById('btn-confirm');if(btn){btn.disabled=true;btn.innerHTML='<i class="fas fa-circle-notch fa-spin"></i> Confirmando...';}});}

  window.selectService=function(card){
    document.querySelectorAll('.svc-card').forEach(c=>{c.classList.remove('selected');const ico=c.querySelector('.svc-card-select i');if(ico)ico.className='fas fa-plus';});
    card.classList.add('selected');
    const ico=card.querySelector('.svc-card-select i');
    if(ico)ico.className='fas fa-check';
    selectedService={id:card.dataset.id,title:card.dataset.title,price:parseFloat(card.dataset.price),duration:parseInt(card.dataset.duration)};
    selectedTime=null; submitLocked=false;
    document.getElementById('booking-empty').style.display='none';
    document.getElementById('booking-selected').style.display='block';
    document.getElementById('bk-svc-name').textContent=selectedService.title;
    document.getElementById('bk-svc-dur').textContent=selectedService.duration+' min';
    document.getElementById('bk-svc-price').textContent='R$ '+selectedService.price.toFixed(0);
    document.getElementById('bk-service-id').value=selectedService.id;
    document.getElementById('time-grid').innerHTML='';
    document.getElementById('time-loading').style.display='none';
    document.getElementById('time-empty').style.display='none';
    document.getElementById('bk-summary').style.display='none';
    document.getElementById('bk-time-val').value='';
    document.getElementById('disp-lock-banner').style.display='none';
    const pill=document.getElementById('cart-pill');
    if(pill){document.getElementById('cart-pill-label').textContent=selectedService.title+' · R$ '+selectedService.price.toFixed(0);pill.classList.add('visible');}
    if(!fpInstance){
      fpInstance=flatpickr('#bk-date-alt',{
        locale:{weekdays:{shorthand:['Dom','Seg','Ter','Qua','Qui','Sex','Sáb'],longhand:['Domingo','Segunda','Terça','Quarta','Quinta','Sexta','Sábado']},months:{shorthand:['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'],longhand:['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro']},firstDayOfWeek:0,ordinal:()=>''},
        minDate:'today',dateFormat:'Y-m-d',altInput:true,altFormat:'d/m/Y',disableMobile:true,
        disable:[function(date){var dow=date.getDay();if(openDays.indexOf(dow)===-1)return true;var ds=dateToStr(date);if(closureDates.indexOf(ds)!==-1)return true;return false;}],
        onDayCreate:function(dObj,dStr,fp,dayElem){var date=dayElem.dateObj;if(!date)return;var dow=date.getDay(),ds=dateToStr(date);if(closureDates.indexOf(ds)!==-1){dayElem.classList.add('day-closed');}else if(openDays.indexOf(dow)===-1){dayElem.classList.add('day-no-hours');}},
        onChange:function(selectedDates,dateStr){selectedDate=dateStr;selectedTime=null;submitLocked=false;document.getElementById('bk-date-val').value=dateStr;document.getElementById('bk-time-val').value='';document.getElementById('bk-summary').style.display='none';document.getElementById('disp-lock-banner').style.display='none';fetchTimes(dateStr);updateConfirmBtn();}
      });
      const altEl=document.querySelector('#bk-date-alt+input.flatpickr-input');
      if(altEl){altEl.style.cssText='width:100%;background:#131313;border:1px solid #1a1a1a;border-radius:10px;padding:.75rem 1rem;font-family:\'DM Sans\',sans-serif;font-size:.875rem;color:#fff;outline:none;cursor:pointer;transition:border-color .2s;';altEl.addEventListener('focus',()=>altEl.style.borderColor='#afff2d');altEl.addEventListener('blur',()=>altEl.style.borderColor='#1a1a1a');}
    } else if(selectedDate){fetchTimes(selectedDate);}
    updateConfirmBtn();
    scrollToBooking();
  };

  // ── BUSCAR HORÁRIOS — suporta o novo formato {time, disponivel_only} ─────
  function fetchTimes(dateStr){
    if(!selectedService||!dateStr)return;
    const grid=document.getElementById('time-grid');
    const loading=document.getElementById('time-loading');
    const empty=document.getElementById('time-empty');
    const banner=document.getElementById('disp-lock-banner');
    grid.innerHTML=''; loading.style.display='block';
    empty.style.display='none'; banner.style.display='none';

    const url=`/car_washes/${window.carWashId}/available_times?date=${dateStr}&service_id=${selectedService.id}&duration=${selectedService.duration}`;
    fetch(url)
    .then(r=>r.json())
    .then(slots=>{
      loading.style.display='none';
      if(!slots.length){empty.style.display='block';return;}

      let hasLocked=false;
      slots.forEach(slot=>{
        const btn=document.createElement('button');
        btn.type='button';
        // Suporta formato antigo (string) e novo (objeto)
        const time   = typeof slot==='string' ? slot : slot.time;
        const locked = typeof slot==='object' && slot.disponivel_only;

        if(locked){
          hasLocked=true;
          btn.className='time-slot disponivel-only';
          btn.disabled=true;
          btn.innerHTML=`${time}<span class="disp-tag-mini"><i class="fas fa-bolt" style="font-size:.45rem;"></i>Disp.</span>`;
          btn.title='Reserve pelo Disponível — pagamento antecipado';
        } else {
          btn.className='time-slot';
          btn.textContent=time;
          btn.onclick=()=>selectTime(time,btn);
        }
        grid.appendChild(btn);
      });

      if(hasLocked) banner.style.display='flex';
    })
    .catch(()=>{loading.style.display='none';empty.style.display='block';});
  }

  function selectTime(time,btn){
    document.querySelectorAll('.time-slot').forEach(b=>b.classList.remove('selected'));
    btn.classList.add('selected');
    selectedTime=time; submitLocked=false;
    document.getElementById('bk-time-val').value=time;
    updateSummary();
    updateConfirmBtn();
  }

  window.scrollToBooking=function(){const panel=document.getElementById('booking-panel');if(panel)panel.scrollIntoView({behavior:'smooth',block:'start'});};
})();
</script>
