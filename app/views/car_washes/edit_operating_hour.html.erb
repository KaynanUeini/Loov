<div class="loov-page loov-page--narrow">
  <div class="loov-hero loov-hero--left">
    <div class="loov-eyebrow"><span class="dot"></span>EDITAR HORÁRIO</div>
    <h1 class="loov-h1">Atualizar <span class="accent">horário</span>.</h1>
    <p class="loov-lead">Ajuste a abertura e o fechamento deste dia.</p>
  </div>

  <div class="loov-card">
    <%= form_with(model: [@car_wash, @operating_hour], url: update_operating_hour_car_wash_path(@car_wash, @operating_hour), local: true) do |form| %>
      <% if @operating_hour.errors.any? %>
        <div class="loov-card loov-card--compact" style="background: #fdecec; border-color: #f5cccc; margin-bottom: 18px;">
          <h4 style="font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:1.4px; text-transform:uppercase; color:var(--rose-500); margin:0 0 8px;">
            <%= pluralize(@operating_hour.errors.count, "erro") %> impediu a atualização
          </h4>
          <ul style="margin:0; padding-left:18px;">
            <% @operating_hour.errors.full_messages.each do |message| %>
              <li style="font-size:13px; color:var(--rose-500);"><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="loov-field">
        <%= form.label :day_of_week, "Dia da semana", class: "loov-label" %>
        <%= form.select :day_of_week, options_for_select([
          ["Domingo", 0],
          ["Segunda-feira", 1],
          ["Terça-feira", 2],
          ["Quarta-feira", 3],
          ["Quinta-feira", 4],
          ["Sexta-feira", 5],
          ["Sábado", 6]
        ], @operating_hour.day_of_week), { disabled: true }, { class: "loov-select" } %>
      </div>

      <div class="loov-field">
        <%= form.label :opens_at, "Horário de abertura", class: "loov-label" %>
        <%= form.time_field :opens_at, value: @operating_hour.opens_at.strftime('%H:%M'), class: "loov-input" %>
      </div>

      <div class="loov-field">
        <%= form.label :closes_at, "Horário de fechamento", class: "loov-label" %>
        <%= form.time_field :closes_at, value: @operating_hour.closes_at.strftime('%H:%M'), class: "loov-input" %>
      </div>

      <div class="loov-cta-row" style="justify-content: flex-start; margin-top: 20px;">
        <%= form.submit "Atualizar horário", class: "loov-btn-primary" %>
        <%= link_to "Voltar", operating_hours_car_wash_path(@car_wash), class: "loov-btn-secondary" %>
      </div>
    <% end %>
  </div>
</div>
