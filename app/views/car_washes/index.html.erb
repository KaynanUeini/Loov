<style>
  .cw-list-search {
    margin-bottom: 24px;
  }
  .cw-list-search-inner { position: relative; display: flex; align-items: center; }
  .cw-list-search-icon {
    position: absolute; left: 20px; color: var(--ash);
    font-size: 14px; pointer-events: none;
  }
  .cw-list-search-input {
    width: 100%;
    background: var(--paper) !important;
    border: 1px solid var(--stone) !important;
    border-radius: 100px !important;
    padding: 16px 60px 16px 48px !important;
    font-family: 'Inter', sans-serif !important;
    font-size: 15px !important;
    color: var(--ink) !important;
    outline: none;
    transition: border-color .18s, box-shadow .18s;
  }
  .cw-list-search-input::placeholder { color: var(--ash) !important; }
  .cw-list-search-input:focus {
    border-color: var(--coral-500) !important;
    box-shadow: 0 0 0 3px rgba(220,120,82,0.08) !important;
  }
  .cw-list-search-submit {
    position: absolute; right: 6px;
    background: var(--coral-500); color: var(--cream);
    border: none; border-radius: 100px;
    width: 44px; height: 44px;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; font-size: 13px;
    transition: background .15s, transform .15s;
    flex-shrink: 0;
  }
  .cw-list-search-submit:hover { background: var(--coral-700); transform: scale(1.04); }

  .cw-groups-wrap { margin-bottom: 18px; }
  .cw-groups-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; letter-spacing: 1.6px;
    text-transform: uppercase; color: var(--ash);
    margin-bottom: 10px;
  }
  .cw-groups-row { display: flex; gap: 8px; flex-wrap: wrap; }
  .cw-group-btn {
    display: inline-flex; align-items: center; gap: 7px;
    background: var(--paper); border: 1px solid var(--stone);
    border-radius: 12px; padding: 9px 16px;
    font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 500;
    color: var(--graphite); text-decoration: none;
    transition: all .18s ease;
  }
  .cw-group-btn i { font-size: 12px; }
  .cw-group-btn:hover { border-color: var(--coral-300); color: var(--coral-700); }
  .cw-group-btn.active {
    background: var(--coral-50); border-color: var(--coral-500);
    color: var(--coral-700);
  }

  .cw-subcats-wrap {
    margin-bottom: 26px; padding: 16px 20px;
    background: var(--sand); border: 1px solid var(--stone);
    border-radius: 16px;
  }
  .cw-subcats-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; letter-spacing: 1.6px;
    text-transform: uppercase; color: var(--ash);
    margin-bottom: 10px;
  }
  .cw-subcats-row { display: flex; gap: 6px; flex-wrap: wrap; }
  .cw-subcat-btn {
    background: var(--paper); border: 1px solid var(--stone);
    border-radius: 100px; padding: 6px 14px;
    font-family: 'Inter', sans-serif; font-size: 12.5px; font-weight: 500;
    color: var(--graphite); text-decoration: none;
    transition: all .18s ease;
  }
  .cw-subcat-btn:hover { border-color: var(--coral-300); color: var(--coral-700); }
  .cw-subcat-btn.active {
    background: var(--coral-50); border-color: var(--coral-500);
    color: var(--coral-700);
  }

  .cw-section-header {
    display: flex; align-items: flex-end; justify-content: space-between;
    gap: 16px; margin-bottom: 12px;
  }
  .cw-section-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(22px, 3.4vw, 28px); font-weight: 700;
    color: var(--ink); margin: 0; letter-spacing: -0.4px;
  }
  .cw-section-count {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; letter-spacing: 1.4px;
    color: var(--ash); white-space: nowrap;
    padding-bottom: 4px; text-transform: uppercase;
  }
  .cw-divider-line { height: 1px; background: var(--stone); margin-bottom: 32px; }

  .cw-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1px; background: var(--stone);
    border: 1px solid var(--stone); border-radius: 20px; overflow: hidden;
  }
  .cw-card-link {
    background: var(--paper);
    display: flex; flex-direction: column;
    text-decoration: none;
    position: relative; overflow: hidden;
    transition: background .18s ease;
  }
  .cw-card-link:hover { background: var(--sand); }
  .cw-card-link::before {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0;
    width: 3px; background: var(--coral-500);
    transform: scaleY(0); transform-origin: bottom;
    transition: transform .25s cubic-bezier(.16,1,.3,1);
  }
  .cw-card-link:hover::before { transform: scaleY(1); }
  .cw-card-link:hover .cw-card-arrow { transform: translate(4px, -4px); color: var(--coral-500); }

  .cw-card-body {
    padding: 24px 24px 18px; flex: 1;
    display: flex; flex-direction: column; gap: 12px;
  }
  .cw-card-avatar {
    width: 46px; height: 46px; border-radius: 12px;
    background: var(--coral-50);
    border: 1px solid var(--coral-100);
    display: flex; align-items: center; justify-content: center;
    font-family: 'Space Grotesk', sans-serif; font-size: 15px; font-weight: 700;
    color: var(--coral-700); letter-spacing: 0.5px; flex-shrink: 0;
  }
  .cw-card-top { display: flex; align-items: flex-start; justify-content: space-between; }
  .cw-card-arrow { color: var(--ash); font-size: 14px; transition: all .22s ease; margin-top: 2px; }

  .cw-card-name {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 22px; font-weight: 700;
    color: var(--ink); line-height: 1.05; margin: 0;
    letter-spacing: -0.3px;
  }

  .cw-card-meta { display: flex; flex-direction: column; gap: 6px; }
  .cw-card-meta-item {
    display: flex; align-items: center; gap: 8px;
    font-size: 13px; color: var(--graphite);
  }
  .cw-card-meta-item i {
    color: var(--coral-500); font-size: 11px;
    width: 14px; flex-shrink: 0;
  }

  .cw-card-footer {
    padding: 14px 24px;
    border-top: 1px solid var(--stone);
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
  }
  .cw-card-price {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 15px; color: var(--graphite);
  }
  .cw-card-price strong { color: var(--coral-500); font-weight: 700; }

  .cw-empty-state { padding: 80px 0; text-align: center; }
  .cw-empty-icon {
    width: 60px; height: 60px; margin: 0 auto 16px;
    border-radius: 16px; background: var(--sand);
    border: 1px solid var(--stone);
    display: flex; align-items: center; justify-content: center;
    color: var(--ash); font-size: 22px;
  }
  .cw-empty-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 22px; font-weight: 700;
    color: var(--ink); margin: 0 0 8px;
  }
  .cw-empty-text {
    font-size: 14px; color: var(--graphite);
    margin: 0 0 24px; line-height: 1.55;
  }
  .cw-empty-actions {
    display: flex; gap: 10px; justify-content: center; flex-wrap: wrap;
  }

  @media(max-width:640px) {
    .cw-cards-grid { grid-template-columns: 1fr; }
  }
  @media(min-width:768px)  { .cw-cards-grid { grid-template-columns: repeat(2,1fr); } }
  @media(min-width:1024px) { .cw-cards-grid { grid-template-columns: repeat(3,1fr); } }
</style>

<div class="loov-page loov-page--wide">
  <div style="margin-bottom: 28px;">
    <%= link_to root_path, class: "loov-btn-ghost loov-btn-sm" do %>
      <i class="fas fa-arrow-left"></i> Voltar
    <% end %>
  </div>

  <div class="loov-hero loov-hero--left">
    <div class="loov-eyebrow"><span class="dot"></span>LAVA-RÁPIDOS</div>
    <h1 class="loov-h1">Encontre o <span class="accent">seu</span>.</h1>
    <p class="loov-lead">Busque por nome, endereço ou serviço. Filtros, distância e horário em tempo real.</p>
  </div>

  <div class="cw-list-search">
    <%= form_with url: car_washes_path, method: :get, local: true do %>
      <%= hidden_field_tag :latitude,  params[:latitude]  if params[:latitude].present? %>
      <%= hidden_field_tag :longitude, params[:longitude] if params[:longitude].present? %>
      <div class="cw-list-search-inner">
        <i class="fas fa-magnifying-glass cw-list-search-icon"></i>
        <%= text_field_tag :search, params[:search], placeholder: "Buscar por nome ou endereço...", class: "cw-list-search-input", autocomplete: "off" %>
        <button type="submit" class="cw-list-search-submit"><i class="fas fa-arrow-right"></i></button>
      </div>
    <% end %>
  </div>

  <div class="cw-groups-wrap">
    <div class="cw-groups-label">O QUE VOCÊ PRECISA?</div>
    <div class="cw-groups-row">
      <%= link_to car_washes_path(search: params[:search], latitude: params[:latitude], longitude: params[:longitude]),
          class: "cw-group-btn #{@selected_group.blank? ? 'active' : ''}" do %>
        <i class="fas fa-border-all"></i> Todos
      <% end %>
      <% icons = { "Lavagem" => "fa-droplet", "Estética" => "fa-spray-can-sparkles", "Higiene" => "fa-pump-soap", "Especiais" => "fa-wrench", "Outros" => "fa-ellipsis" } %>
      <% @groups.each do |group, _cats| %>
        <%= link_to car_washes_path(group: group, search: params[:search], latitude: params[:latitude], longitude: params[:longitude]),
            class: "cw-group-btn #{@selected_group == group ? 'active' : ''}" do %>
          <i class="fas <%= icons[group] || 'fa-tag' %>"></i> <%= group %>
        <% end %>
      <% end %>
    </div>
  </div>

  <% if @selected_group.present? && @subcategories.any? %>
  <div class="cw-subcats-wrap">
    <div class="cw-subcats-label">
      <%= @selected_group == "Lavagem" ? "TIPO DE LAVAGEM" : "ESPECIALIDADE" %>
    </div>
    <div class="cw-subcats-row">
      <%= link_to car_washes_path(group: @selected_group, search: params[:search], latitude: params[:latitude], longitude: params[:longitude]),
          class: "cw-subcat-btn #{@selected_category.blank? && @selected_service_title.blank? ? 'active' : ''}" do %>
        Todos em <%= @selected_group %>
      <% end %>
      <% if @selected_group == "Lavagem" %>
        <% @subcategories.each do |title| %>
          <%= link_to car_washes_path(group: @selected_group, service_title: title, search: params[:search], latitude: params[:latitude], longitude: params[:longitude]),
              class: "cw-subcat-btn #{@selected_service_title == title ? 'active' : ''}" do %>
            <%= title %>
          <% end %>
        <% end %>
      <% else %>
        <% @subcategories.each do |cat| %>
          <%= link_to car_washes_path(group: @selected_group, category: cat, search: params[:search], latitude: params[:latitude], longitude: params[:longitude]),
              class: "cw-subcat-btn #{@selected_category == cat ? 'active' : ''}" do %>
            <%= cat %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
  <% end %>

  <div class="cw-section-header">
    <h2 class="cw-section-title">
      <% if @selected_service_title.present? %><%= @selected_service_title %>
      <% elsif @selected_category.present? %><%= @selected_category %>
      <% elsif @selected_group.present? %><%= @selected_group %>
      <% elsif params[:latitude].present? %>Próximos a você
      <% elsif params[:search].present? %>Resultados
      <% else %>Todos
      <% end %>
    </h2>
    <span class="cw-section-count"><%= @car_washes.count %> ENCONTRADO<%= @car_washes.count == 1 ? '' : 'S' %></span>
  </div>
  <div class="cw-divider-line"></div>

  <% if @car_washes.empty? %>
    <div class="cw-empty-state">
      <div class="cw-empty-icon"><i class="fas fa-car-wash"></i></div>
      <div class="cw-empty-title">Nenhum resultado</div>
      <p class="cw-empty-text">Nenhum lava-rápido encontrado com esse filtro.<br>Tente buscar por outro nome.</p>
      <div class="cw-empty-actions">
        <%= link_to "Limpar filtros", car_washes_path, class: "loov-btn-secondary" %>
        <%= link_to "Voltar ao início", root_path, class: "loov-btn-primary" %>
      </div>
    </div>
  <% else %>
    <div class="cw-cards-grid">
      <% @car_washes.each_with_index do |cw, i| %>
        <%
          min_price   = cw.services.minimum(:price)
          reviews     = cw.reviews
          avg_rating  = reviews.any? ? reviews.average(:rating).to_f : nil
          today_dow   = Date.current.wday
          is_open     = cw.operating_hours.exists?(day_of_week: today_dow)
          opens_today = cw.operating_hours.find_by(day_of_week: today_dow)
        %>
        <%= link_to car_wash_path(cw, latitude: params[:latitude], longitude: params[:longitude]),
            class: "cw-card-link car-wash-card", data: { index: i } do %>

          <div class="cw-card-body">
            <div class="cw-card-top">
              <div class="cw-card-avatar"><%= cw.name.first(2).upcase %></div>
              <i class="fas fa-arrow-up-right cw-card-arrow"></i>
            </div>

            <div class="cw-card-name"><%= cw.name %></div>

            <div class="cw-card-meta">
              <div class="cw-card-meta-item">
                <i class="fas fa-location-dot"></i>
                <span><%= [cw.bairro, cw.cidade].select(&:present?).join(", ").presence || cw.address || "Endereço não informado" %></span>
              </div>
              <% if params[:latitude].present? && params[:longitude].present? && cw.latitude && cw.longitude %>
                <% dist = cw.distance_to([params[:latitude].to_f, params[:longitude].to_f], :km) %>
                <div class="cw-card-meta-item">
                  <i class="fas fa-route"></i>
                  <span><%= number_with_precision(dist, precision: 1) %> km de você</span>
                </div>
              <% end %>
              <% if avg_rating %>
                <div class="cw-card-meta-item">
                  <i class="fas fa-star"></i>
                  <span style="color:var(--ink); font-weight: 600;"><%= sprintf('%.1f', avg_rating) %></span>
                  <span style="color: var(--ash);">(<%= reviews.count %>)</span>
                </div>
              <% else %>
                <div class="cw-card-meta-item">
                  <i class="fas fa-star"></i>
                  <span>Seja o primeiro a avaliar</span>
                </div>
              <% end %>
            </div>
          </div>

          <div class="cw-card-footer">
            <% if min_price %>
              <div class="cw-card-price">A partir de <strong>R$ <%= number_with_precision(min_price, precision: 0) %></strong></div>
            <% else %>
              <div class="cw-card-price" style="color: var(--ash);">Consulte serviços</div>
            <% end %>

            <% if is_open %>
              <span class="loov-pill loov-pill--success"><span style="width:5px;height:5px;border-radius:50%;background:currentColor;display:inline-block;"></span> Aberto agora</span>
            <% elsif opens_today %>
              <span class="loov-pill loov-pill--neutral">Abre às <%= opens_today.opens_at.strftime("%H:%M") %></span>
            <% else %>
              <span class="loov-pill loov-pill--neutral">Fechado hoje</span>
            <% end %>
          </div>

        <% end %>
      <% end %>
    </div>
  <% end %>
</div>

<script>
(function() {
  const cards = document.querySelectorAll('.car-wash-card');
  if (cards.length) {
    cards.forEach((c) => {
      c.style.opacity = '0';
      c.style.transform = 'translateY(18px)';
      c.style.transition = 'opacity .55s cubic-bezier(.16,1,.3,1), transform .55s cubic-bezier(.16,1,.3,1), background .18s ease';
    });
    const obs = new IntersectionObserver(entries=>{
      entries.forEach(e=>{
        if(e.isIntersecting){
          const idx=parseInt(e.target.dataset.index||0);
          setTimeout(()=>{ e.target.style.opacity='1'; e.target.style.transform='translateY(0)'; }, idx*55);
          obs.unobserve(e.target);
        }
      });
    },{threshold:.08,rootMargin:'0px 0px -32px 0px'});
    cards.forEach(c=>obs.observe(c));
  }
})();
</script>
