<% Rails.logger.info("Iniciando renderização do template car_washes/new.html.erb") %>

<style>
  .cw-new-section { margin-bottom: 18px; }
  .cw-new-section-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 18px; font-weight: 700;
    color: var(--ink);
    margin: 0 0 18px 0;
    display: flex; align-items: center; gap: 10px;
    letter-spacing: -0.2px;
  }
  .cw-new-section-title i { color: var(--coral-500); font-size: 14px; }

  .cw-new-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }

  .cw-new-day-buttons {
    display: grid; grid-template-columns: repeat(7, 1fr);
    gap: 8px; margin-bottom: 18px;
  }
  .cw-new-day-btn {
    background: var(--paper); border: 1px solid var(--stone);
    border-radius: 12px; padding: 10px 4px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; font-weight: 700; letter-spacing: 1.2px;
    color: var(--graphite); cursor: pointer;
    transition: all .18s ease;
    text-align: center; text-transform: uppercase; user-select: none;
  }
  .cw-new-day-btn:hover { border-color: var(--coral-300); color: var(--coral-700); }
  .cw-new-day-btn.active {
    background: var(--coral-50); border-color: var(--coral-500);
    color: var(--coral-700);
  }

  .day-time-rows { display: flex; flex-direction: column; gap: 10px; }
  .day-time-row {
    display: none; align-items: center; gap: 14px;
    background: var(--sand); border: 1px solid var(--stone);
    border-radius: 14px; padding: 14px 16px;
    animation: cwFadeUp .25s ease forwards;
  }
  .day-time-row.visible { display: flex; }
  .day-time-label {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 15px; font-weight: 700;
    color: var(--coral-500); min-width: 40px;
    letter-spacing: -0.2px;
  }
  .time-select-wrap { display: flex; align-items: center; gap: 8px; flex: 1; }
  .time-label-small {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px; font-weight: 600; letter-spacing: 1.4px;
    color: var(--graphite); text-transform: uppercase; white-space: nowrap;
  }
  .time-select {
    background: var(--paper); border: 1px solid var(--stone);
    border-radius: 8px; padding: 7px 10px;
    font-family: 'Inter', sans-serif; font-size: 13.5px;
    color: var(--ink); outline: none; cursor: pointer;
    appearance: none; text-align: center;
    transition: border-color .15s;
  }
  .time-select:focus { border-color: var(--coral-500); }
  .time-separator {
    font-family: 'Space Grotesk', sans-serif; font-size: 16px;
    color: var(--ash);
  }

  .sub-card {
    background: var(--sand); border: 1px solid var(--stone);
    border-radius: 16px; padding: 18px; margin-bottom: 12px;
  }
  .sub-card:last-of-type { margin-bottom: 0; }
  .sub-card-remove {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 12.5px; color: var(--rose-500); cursor: pointer;
    background: none; border: none; padding: 0;
    margin-top: 12px; transition: color .15s;
  }
  .sub-card-remove:hover { color: #a13838; }
  .sub-card-remove input[type="checkbox"] { accent-color: var(--rose-500); cursor: pointer; }

  .btn-add {
    display: inline-flex; align-items: center; gap: 8px;
    background: transparent; color: var(--coral-700);
    border: 1px dashed var(--coral-300); border-radius: 12px;
    padding: 12px 18px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; font-weight: 600; letter-spacing: 1.4px;
    text-transform: uppercase;
    cursor: pointer; transition: all .18s ease;
    width: 100%; justify-content: center; margin-top: 12px;
  }
  .btn-add:hover {
    border-color: var(--coral-500); background: var(--coral-50);
    color: var(--coral-700);
  }

  .form-errors-loov {
    background: #fdecec;
    border: 1px solid #f5cccc;
    border-radius: 14px;
    padding: 16px 20px;
    margin-bottom: 20px;
  }
  .form-errors-loov h2 {
    font-family: 'JetBrains Mono', monospace !important;
    font-size: 11px; letter-spacing: 1.4px;
    color: var(--rose-500) !important;
    margin: 0 0 8px 0; text-transform: uppercase;
    display: flex; align-items: center; gap: 8px;
  }
  .form-errors-loov ul { list-style: none; margin: 0; padding: 0; }
  .form-errors-loov ul li { font-size: 13.5px; color: var(--rose-500); padding: 3px 0; }
  .form-errors-loov ul li::before { content: '· '; }

  .cep-error-msg {
    display: none;
    font-size: 12.5px; color: var(--rose-500);
    margin-top: -8px;
  }

  @keyframes cwFadeUp { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

  @media (max-width: 540px) {
    .cw-new-day-buttons { grid-template-columns: repeat(4, 1fr); }
    .cw-new-row { grid-template-columns: 1fr; }
    .day-time-row { flex-direction: column; align-items: flex-start; }
    .time-select-wrap { width: 100%; }
  }
</style>

<div class="loov-page loov-page--narrow">
  <div class="loov-hero">
    <div class="loov-eyebrow"><span class="dot"></span>NOVO PARCEIRO</div>
    <h1 class="loov-h1">Cadastre seu <span class="accent">lava-rápido</span>.</h1>
    <p class="loov-lead">Preencha os dados, defina horários e adicione serviços. Você poderá editar tudo depois.</p>
  </div>

  <%= form_with model: @car_wash, local: true, id: "car-wash-form" do |form| %>

    <% if @car_wash.errors.any? %>
    <div class="form-errors-loov">
      <h2><i class="fas fa-circle-exclamation"></i> Corrija os erros abaixo</h2>
      <ul>
        <% @car_wash.errors.full_messages.each do |message| %>
        <li><%= message %></li>
        <% end %>
      </ul>
    </div>
    <% end %>

    <div class="loov-card cw-new-section">
      <h3 class="cw-new-section-title"><i class="fas fa-store"></i> Informações básicas</h3>

      <div class="loov-field">
        <%= form.label :name, "Nome do lava-rápido", class: "loov-label" %>
        <%= form.text_field :name, class: "loov-input", placeholder: "Ex: Lava Car Premium" %>
      </div>

      <div class="cw-new-row" style="grid-template-columns: 160px 1fr;">
        <div class="loov-field">
          <%= form.label :cep, "CEP", class: "loov-label" %>
          <div style="position:relative;">
            <%= form.text_field :cep, class: "loov-input", placeholder: "00000-000",
                id: "cep_field", maxlength: 9, style: "padding-right:2.5rem;" %>
            <div id="cep-spinner" style="display:none; position:absolute; right:12px; top:50%; transform:translateY(-50%); color:var(--coral-500);">
              <i class="fas fa-circle-notch fa-spin"></i>
            </div>
          </div>
        </div>
        <div class="loov-field">
          <%= form.label :logradouro, "Logradouro", class: "loov-label" %>
          <%= form.text_field :logradouro, class: "loov-input", placeholder: "Rua / Avenida / número", id: "logradouro_field" %>
        </div>
      </div>

      <div class="cw-new-row">
        <div class="loov-field">
          <%= form.label :bairro, "Bairro", class: "loov-label" %>
          <%= form.text_field :bairro, class: "loov-input", placeholder: "Bairro", id: "bairro_field" %>
        </div>
        <div class="loov-field">
          <%= form.label :cidade, "Cidade", class: "loov-label" %>
          <%= form.text_field :cidade, class: "loov-input", placeholder: "Cidade", id: "cidade_field" %>
        </div>
      </div>

      <div class="cw-new-row" style="grid-template-columns: 80px 1fr;">
        <div class="loov-field">
          <%= form.label :uf, "UF", class: "loov-label" %>
          <%= form.text_field :uf, class: "loov-input", placeholder: "SP", id: "uf_field", maxlength: 2 %>
        </div>
        <div class="loov-field">
          <%= form.label :address, "Endereço para mapa", class: "loov-label" %>
          <%= form.text_field :address, class: "loov-input", placeholder: "Preenchido automaticamente pelo CEP", id: "address_field" %>
        </div>
      </div>

      <div id="cep-error" class="cep-error-msg">
        CEP não encontrado. Preencha o endereço manualmente.
      </div>
    </div>

    <div class="loov-card cw-new-section">
      <h3 class="cw-new-section-title"><i class="fas fa-clock"></i> Horários de funcionamento</h3>
      <div class="cw-new-day-buttons">
        <% [["Dom",0],["Seg",1],["Ter",2],["Qua",3],["Qui",4],["Sex",5],["Sáb",6]].each do |label, val| %>
        <div class="cw-new-day-btn day-btn" data-day="<%= val %>" onclick="toggleDay(<%= val %>, '<%= label %>')">
          <%= label %>
        </div>
        <% end %>
      </div>
      <div class="day-time-rows" id="day-time-rows"></div>
      <div id="operating-hours-inputs"></div>
    </div>

    <div class="loov-card cw-new-section">
      <h3 class="cw-new-section-title"><i class="fas fa-spray-can-sparkles"></i> Serviços</h3>
      <div id="services">
        <%= form.fields_for :services do |service_form| %>
        <div class="sub-card service-fields">
          <div class="loov-field">
            <%= service_form.label :title, "Categoria do serviço", class: "loov-label" %>
            <%= service_form.select :title,
                Service::CATEGORIES.map { |c| [c, c] },
                { prompt: "Selecione uma categoria" },
                class: "loov-select" %>
          </div>
          <div class="loov-field">
            <%= service_form.label :description, "Descrição", class: "loov-label" %>
            <%= service_form.text_area :description, class: "loov-textarea", placeholder: "Descreva o serviço..." %>
          </div>
          <div class="cw-new-row">
            <div class="loov-field">
              <%= service_form.label :price, "Preço (R$)", class: "loov-label" %>
              <%= service_form.number_field :price, step: 0.01, min: 0, class: "loov-input", placeholder: "0,00" %>
            </div>
            <div class="loov-field">
              <%= service_form.label :duration, "Duração (min)", class: "loov-label" %>
              <%= service_form.number_field :duration, min: 1, class: "loov-input", placeholder: "60" %>
            </div>
          </div>
          <label class="sub-card-remove">
            <%= service_form.check_box :_destroy %>
            <i class="fas fa-trash-can"></i> Remover este serviço
          </label>
        </div>
        <% end %>
      </div>
      <button type="button" class="btn-add" id="add-service">
        <i class="fas fa-plus"></i> Adicionar serviço
      </button>
    </div>

    <div class="loov-cta-row" style="margin-top: 28px;">
      <%= form.submit "Criar lava-rápido", class: "loov-btn-primary loov-btn-block loov-btn-lg" %>
    </div>

  <% end %>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var cepField = document.getElementById('cep_field');
    if (cepField) {
      cepField.addEventListener('input', function() {
        var raw = this.value.replace(/\D/g, '');
        this.value = raw.length > 5 ? raw.slice(0,5) + '-' + raw.slice(5,8) : raw;
      });

      cepField.addEventListener('blur', function() {
        var cep = this.value.replace(/\D/g, '');
        if (cep.length !== 8) return;
        document.getElementById('cep-spinner').style.display = 'block';
        document.getElementById('cep-error').style.display   = 'none';
        fetch('https://viacep.com.br/ws/' + cep + '/json/')
          .then(function(r) { return r.json(); })
          .then(function(data) {
            document.getElementById('cep-spinner').style.display = 'none';
            if (data.erro) { document.getElementById('cep-error').style.display = 'block'; return; }
            document.getElementById('logradouro_field').value = data.logradouro || '';
            document.getElementById('bairro_field').value     = data.bairro     || '';
            document.getElementById('cidade_field').value     = data.localidade  || '';
            document.getElementById('uf_field').value         = data.uf          || '';
            var full = [data.logradouro, data.bairro, data.localidade, data.uf].filter(Boolean).join(', ');
            document.getElementById('address_field').value = full;
          })
          .catch(function() {
            document.getElementById('cep-spinner').style.display = 'none';
            document.getElementById('cep-error').style.display   = 'block';
          });
      });
    }

    document.getElementById('add-service').addEventListener('click', function(e) {
      e.preventDefault();
      var time = new Date().getTime();
      var html = '<div class="sub-card service-fields">' +
        '<div class="loov-field"><label class="loov-label">Categoria do serviço</label>' +
        '<select name="car_wash[services_attributes][' + time + '][title]" class="loov-select" required>' +
        '<option value="">Selecione uma categoria</option>' +
        '<option value="Lavagem">Lavagem</option>' +
        '<option value="Polimento">Polimento</option>' +
        '<option value="Higienização">Higienização</option>' +
        '<option value="Cristalização">Cristalização</option>' +
        '<option value="Outros">Outros</option>' +
        '</select></div>' +
        '<div class="loov-field"><label class="loov-label">Descrição</label>' +
        '<textarea name="car_wash[services_attributes][' + time + '][description]" class="loov-textarea" placeholder="Descreva o serviço..."></textarea></div>' +
        '<div class="cw-new-row">' +
          '<div class="loov-field"><label class="loov-label">Preço (R$)</label>' +
          '<input type="number" step="0.01" min="0" name="car_wash[services_attributes][' + time + '][price]" class="loov-input" placeholder="0,00" required></div>' +
          '<div class="loov-field"><label class="loov-label">Duração (min)</label>' +
          '<input type="number" min="1" name="car_wash[services_attributes][' + time + '][duration]" class="loov-input" placeholder="60" required></div>' +
        '</div>' +
        '<label class="sub-card-remove">' +
          '<input type="checkbox" name="car_wash[services_attributes][' + time + '][_destroy]">' +
          '<i class="fas fa-trash-can"></i> Remover este serviço' +
        '</label></div>';
      document.getElementById('services').insertAdjacentHTML('beforeend', html);
    });
  });

  var activeDays = {};

  function buildHourOptions(selectedVal) {
    var opts = '';
    for (var h = 0; h < 24; h++) {
      var val = (h < 10 ? '0' : '') + h;
      opts += '<option value="' + val + '"' + (selectedVal === val ? ' selected' : '') + '>' + val + '</option>';
    }
    return opts;
  }

  function buildMinOptions(selectedVal) {
    var opts = '';
    ['00','15','30','45'].forEach(function(m) {
      opts += '<option value="' + m + '"' + (selectedVal === m ? ' selected' : '') + '>' + m + '</option>';
    });
    return opts;
  }

  function toggleDay(day, label) {
    var btn = document.querySelector('.day-btn[data-day="' + day + '"]');
    if (activeDays[day]) {
      delete activeDays[day];
      btn.classList.remove('active');
      var row = document.getElementById('day-row-' + day);
      if (row) row.remove();
    } else {
      activeDays[day] = { opensH: '08', opensM: '00', closesH: '18', closesM: '00' };
      btn.classList.add('active');
      var rowHtml = '<div class="day-time-row visible" id="day-row-' + day + '">' +
        '<div class="day-time-label">' + label + '</div>' +
        '<div class="time-select-wrap">' +
          '<span class="time-label-small">Abre</span>' +
          '<select class="time-select" onchange="updateTime(' + day + ',\'opensH\',this.value)">' + buildHourOptions('08') + '</select>' +
          '<span class="time-separator">:</span>' +
          '<select class="time-select" onchange="updateTime(' + day + ',\'opensM\',this.value)">' + buildMinOptions('00') + '</select>' +
        '</div>' +
        '<div class="time-select-wrap">' +
          '<span class="time-label-small">Fecha</span>' +
          '<select class="time-select" onchange="updateTime(' + day + ',\'closesH\',this.value)">' + buildHourOptions('18') + '</select>' +
          '<span class="time-separator">:</span>' +
          '<select class="time-select" onchange="updateTime(' + day + ',\'closesM\',this.value)">' + buildMinOptions('00') + '</select>' +
        '</div>' +
      '</div>';
      var rows = document.getElementById('day-time-rows');
      var inserted = false;
      var existing = rows.querySelectorAll('.day-time-row');
      for (var i = 0; i < existing.length; i++) {
        if (day < parseInt(existing[i].id.replace('day-row-', ''))) {
          rows.insertBefore(createEl(rowHtml), existing[i]);
          inserted = true;
          break;
        }
      }
      if (!inserted) rows.insertAdjacentHTML('beforeend', rowHtml);
    }
    updateHiddenInputs();
  }

  function createEl(html) {
    var tmp = document.createElement('div');
    tmp.innerHTML = html;
    return tmp.firstElementChild;
  }

  function updateTime(day, key, value) {
    if (activeDays[day]) { activeDays[day][key] = value; updateHiddenInputs(); }
  }

  function updateHiddenInputs() {
    var container = document.getElementById('operating-hours-inputs');
    container.innerHTML = '';
    var idx = 0;
    Object.keys(activeDays).sort(function(a,b){ return a-b; }).forEach(function(day) {
      var d = activeDays[day];
      container.insertAdjacentHTML('beforeend',
        '<input type="hidden" name="car_wash[operating_hours_attributes][' + idx + '][day_of_week]" value="' + day + '">' +
        '<input type="hidden" name="car_wash[operating_hours_attributes][' + idx + '][opens_at]" value="' + d.opensH + ':' + d.opensM + ':00">' +
        '<input type="hidden" name="car_wash[operating_hours_attributes][' + idx + '][closes_at]" value="' + d.closesH + ':' + d.closesM + ':00">'
      );
      idx++;
    });
  }
</script>

<% Rails.logger.info("Template car_washes/new.html.erb renderizado com sucesso") %>
